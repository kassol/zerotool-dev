---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import { allTools } from '../../data/tools';

const toolCount = allTools.length;
---

<BaseLayout
  title="ZeroTool — 무료 온라인 개발자 도구"
  description={`JSON, Base64, UUID, URL, 텍스트, 보안, 이미지, API를 위한 무료·빠른 브라우저 기반 개발자 도구 ${toolCount}가지. 계정 없이 포맷, 변환, 해시, 인코딩, 검사를 실행할 수 있으며 로컬 처리 도구는 입력을 업로드하지 않습니다. 한국어·영어·중국어·일본어 UI를 지원하고 각 도구 페이지에 처리 위치·저장·통신 설명이 있습니다.`}
  lang="ko"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'ZeroTool',
      url: 'https://zerotool.dev/ko/',
      description: '무료·빠른·브라우저 기반 개발자 도구 모음.',
    })} />
  </Fragment>
  <ToolDirectory lang="ko" mode="home" />
</BaseLayout>
