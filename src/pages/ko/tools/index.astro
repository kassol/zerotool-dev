---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolDirectory from '../../../components/ToolDirectory.astro';
import { allTools } from '../../../data/tools';

const toolCount = allTools.length;
---

<BaseLayout
  title="전체 도구 — ZeroTool"
  description={`JSON 포맷, Base64, UUID, URL 인코딩, 정규식 테스트, 해시, JWT, QR 코드, 이미지 변환 등 ${toolCount}가지 무료 온라인 개발자 도구. 카테고리로 필터링하거나 이름으로 검색할 수 있으며 계정이 필요 없습니다. 각 도구 페이지에 처리 위치·저장·통신 설명이 있습니다.`}
  lang="ko"
>
  <ToolDirectory lang="ko" mode="tools" />
</BaseLayout>
