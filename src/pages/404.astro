---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/utils';

const isZh = Astro.url.pathname.startsWith('/zh');
const lang = isZh ? 'zh' : 'en';
const homeHref = isZh ? '/zh/' : '/';
---

<BaseLayout
  title={t(lang, 'error.title')}
  description={t(lang, 'error.description')}
  lang={lang}
  noindex={true}
>
  <div class="not-found">
    <h1>404</h1>
    <p>{t(lang, 'error.heading')}</p>
    <a href={homeHref}>{t(lang, 'error.backHome')}</a>
  </div>
  {/* Links copied from AI assistants and chat apps arrive with Unicode hyphens (U+2011 etc.)
       or trailing punctuation glued on. Retry once with the cleaned path; a still-missing
       path normalizes to itself, so there is no redirect loop. */}
  <script is:inline>
    /* ── engine:start ── */
    function normalizeNotFoundPath(path) {
      return path
        .replace(/[\u2010-\u2015\u2212\uFE58\uFE63\uFF0D]/g, '-')
        .replace(/[\s)\]）】」』；;，,。、：:！!？?"'“”‘’》>]+(\/?)$/, '$1');
    }
    /* ── engine:end ── */
    (function () {
      var current;
      try { current = decodeURIComponent(location.pathname); } catch (e) { return; }
      var next = normalizeNotFoundPath(current);
      if (next && next !== current) location.replace(encodeURI(next) + location.search + location.hash);
    })();
  </script>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    padding: 2rem 1rem;
  }

  .not-found h1 {
    font-size: 5rem;
    font-weight: 700;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
    line-height: 1;
  }

  .not-found p {
    font-size: 1.2rem;
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem;
  }

  .not-found a {
    display: inline-block;
    padding: 0.5rem 1.5rem;
    background: var(--color-primary);
    color: #fff;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    transition: background var(--transition-fast);
  }

  .not-found a:hover {
    background: var(--color-primary-hover);
    text-decoration: none;
  }
</style>
