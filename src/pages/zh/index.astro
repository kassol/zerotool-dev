---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import { allTools } from '../../data/tools';

const toolCount = allTools.length;
---

<BaseLayout
  title="ZeroTool — 免费在线开发者工具"
  description={`${toolCount} 款免费、快速、在浏览器中运行的开发者工具，覆盖 JSON 格式化与校验、Base64、UUID、URL 编码、正则测试、哈希与 HMAC、AES 加密、二维码、图片转换与 API 调试。打开即用，无需账号；本地处理的工具不上传输入。支持中文、英文、日文、韩文界面，可按分类筛选或搜索工具名，每个工具页写明处理位置、存储与联网情况。`}
  lang="zh"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'ZeroTool',
      url: 'https://zerotool.dev/zh/',
      description: '免费、快速、在浏览器中运行的开发者工具集。',
    })} />
  </Fragment>
  <ToolDirectory lang="zh" mode="home" />
</BaseLayout>
