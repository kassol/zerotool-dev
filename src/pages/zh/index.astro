---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import { allTools } from '../../data/tools';

const toolCount = allTools.length;
---

<BaseLayout
  title="ZeroTool — 免费在线开发者工具"
  description={`${toolCount} 款免费、快速、在浏览器中运行的开发者工具，覆盖 JSON、Base64、UUID、URL、编码、正则、哈希、加密、图片与 API 调试。打开即用，无需账号；本地处理的工具不上传输入，可按分类筛选或搜索工具名，每个工具页写明处理位置、存储与联网情况。结果可复制。全部在浏览器中处理。无需安装任何软件。`}
  lang="zh"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'ZeroTool',
      url: 'https://zerotool.dev/zh/',
      description: '免费、快速、在浏览器中运行的开发者工具集。',
    })} />
  </Fragment>
  <ToolDirectory lang="zh" mode="home" />
</BaseLayout>
