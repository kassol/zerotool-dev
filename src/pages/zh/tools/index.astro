---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolDirectory from '../../../components/ToolDirectory.astro';
import { allTools } from '../../../data/tools';

const toolCount = allTools.length;
---

<BaseLayout
  title="全部工具 — ZeroTool"
  description={`浏览 ${toolCount} 款免费在线开发者工具：JSON 格式化与校验、Base64、UUID 生成、URL 编码、正则测试、哈希与 HMAC、JWT、AES 加密、二维码、图片转换等。按分类筛选或搜索工具名；无需账号。每个工具页说明处理位置、存储与联网情况，本地处理的工具不上传输入，支持中英日韩界面，结果可复制或下载。`}
  lang="zh"
>
  <ToolDirectory lang="zh" mode="tools" />
</BaseLayout>
