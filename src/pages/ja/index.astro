---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import { allTools } from '../../data/tools';

const toolCount = allTools.length;
---

<BaseLayout
  title="ZeroTool — 無料オンライン開発者ツール"
  description={`JSON、Base64、UUID、URL、テキスト、セキュリティ、画像、API 向けの無料・高速なブラウザベース開発者ツール ${toolCount} 種類。整形、変換、ハッシュ、検査をアカウントなしで実行でき、ローカル処理のツールは入力をアップロードしません。各ツールのページには処理場所・保存・通信の説明もあります。`}
  lang="ja"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'ZeroTool',
      url: 'https://zerotool.dev/ja/',
      description: '無料・高速・ブラウザで動く開発者ツール集。',
    })} />
  </Fragment>
  <ToolDirectory lang="ja" mode="home" />
</BaseLayout>
