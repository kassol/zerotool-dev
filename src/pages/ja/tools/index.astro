---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolDirectory from '../../../components/ToolDirectory.astro';
import { allTools } from '../../../data/tools';

const toolCount = allTools.length;
---

<BaseLayout
  title="全ツール一覧 — ZeroTool"
  description={`JSON 整形、Base64、UUID、URL エンコード、正規表現テスト、ハッシュ、JWT、QR コード、画像変換など ${toolCount} 種類の無料オンライン開発者ツールを一覧できます。カテゴリで絞り込むか名前で検索でき、アカウントは不要です。各ツールのページに処理場所・保存・通信の説明があり、ローカル処理のツールは入力をアップロードしません。`}
  lang="ja"
>
  <ToolDirectory lang="ja" mode="tools" />
</BaseLayout>
