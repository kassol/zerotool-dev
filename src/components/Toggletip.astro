---
// Toggletip: a small "?" button next to a control that shows a short explanation.
// The text is in the HTML (no request when it opens). The panel is a native popover
// (light dismiss: a click or tap outside, or Esc, closes it; a second click on the
// button toggles it). Without popover support the script falls back to the hidden
// attribute. Used by the tool page redesign (src/data/tool-layouts.ts).
interface Props {
  label: string;   // accessible name of the button, e.g. "About Numbers"
  id: string;      // unique on the page
  wide?: boolean;  // wider panel for lists or several sentences
  text?: string;   // visible button text (a question such as "How to export a HAR"); icon only when absent
}
const { label, id, wide = false, text } = Astro.props;
---

<span class="zt-tip">
  <button type="button" class:list={['zt-tip-btn', { 'zt-tip-btn--text': text }]} popovertarget={id} aria-label={text ? undefined : label} aria-expanded="false" aria-controls={id} data-zt-tip={id}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.25"/><path d="M9.6 9.3a2.5 2.5 0 0 1 4.85.85c0 1.65-2.45 2.2-2.45 3.6"/><path d="M12 16.9h.01"/></svg>
    {text && <span class="zt-tip-text">{text}</span>}
  </button>
  <span class:list={['zt-tip-pop', { 'zt-tip-pop--wide': wide }]} id={id} popover="auto" role="note"><slot /></span>
</span>

<script>
  // One handler for every toggletip on the page. Positions the open panel under its
  // button (or above it when there is no room) and keeps aria-expanded in sync.
  const supported = typeof HTMLElement !== 'undefined' && Object.prototype.hasOwnProperty.call(HTMLElement.prototype, 'popover');
  const GAP = 8, EDGE = 8;
  function place(btn: HTMLElement, pop: HTMLElement) {
    const b = btn.getBoundingClientRect();
    pop.style.left = '0px'; pop.style.top = '0px';
    const p = pop.getBoundingClientRect();
    const vw = document.documentElement.clientWidth, vh = window.innerHeight;
    let left = b.left + b.width / 2 - p.width / 2;
    left = Math.max(EDGE, Math.min(left, vw - p.width - EDGE));
    let top = b.bottom + GAP;
    if (top + p.height > vh - EDGE && b.top - GAP - p.height > EDGE) top = b.top - GAP - p.height;
    pop.style.left = Math.round(left) + 'px';
    pop.style.top = Math.round(top) + 'px';
  }
  function buttonFor(pop: HTMLElement) { return document.querySelector<HTMLElement>('[data-zt-tip="' + pop.id + '"]'); }
  function openPops() { return Array.from(document.querySelectorAll<HTMLElement>('.zt-tip-pop')).filter((p) => (supported ? p.matches(':popover-open') : !p.hidden)); }
  if (supported) {
    document.querySelectorAll<HTMLElement>('.zt-tip-pop').forEach((pop) => {
      pop.addEventListener('toggle', (e: any) => {
        const btn = buttonFor(pop);
        if (!btn) return;
        const open = e.newState === 'open';
        btn.setAttribute('aria-expanded', String(open));
        if (open) place(btn, pop);
      });
    });
  } else {
    document.querySelectorAll<HTMLElement>('.zt-tip-pop').forEach((pop) => { pop.hidden = true; pop.classList.add('zt-tip-pop--fallback'); });
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-zt-tip]');
      openPops().forEach((p) => { if (!btn || p.id !== btn.dataset.ztTip) { p.hidden = true; buttonFor(p)?.setAttribute('aria-expanded', 'false'); } });
      if (!btn) return;
      const pop = document.getElementById(btn.dataset.ztTip || '');
      if (!pop) return;
      pop.hidden = !pop.hidden;
      btn.setAttribute('aria-expanded', String(!pop.hidden));
      if (!pop.hidden) place(btn, pop);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      openPops().forEach((p) => { p.hidden = true; const b = buttonFor(p); b?.setAttribute('aria-expanded', 'false'); b?.focus(); });
    });
  }
  const reposition = () => openPops().forEach((p) => { const b = buttonFor(p); if (b) place(b, p); });
  window.addEventListener('scroll', reposition, { passive: true, capture: true });
  window.addEventListener('resize', reposition);
</script>

<style>
  .zt-tip { display: inline-flex; vertical-align: middle; }
  .zt-tip-btn {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    flex: none;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }
  .zt-tip-btn--text {
    display: inline-flex;
    gap: 0.35rem;
    width: auto;
    min-height: 36px;
    padding: 0.3rem 0.75rem 0.3rem 0.55rem;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    font: inherit;
    font-size: 0.86rem;
    font-weight: 650;
  }
  .zt-tip-btn:hover, .zt-tip-btn[aria-expanded="true"] { color: var(--color-primary); background: var(--color-primary-light); }
  .zt-tip-btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 1px; }
  .zt-tip-pop {
    position: fixed;
    inset: auto;
    margin: 0;
    width: max-content;
    max-width: min(22rem, calc(100vw - 16px));
    padding: 0.7rem 0.85rem;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0;
    text-align: left;
    text-transform: none;
    white-space: normal;
    overflow-wrap: anywhere;
    box-shadow: 0 10px 28px -8px rgb(40 28 16 / 0.35), 0 2px 6px rgb(40 28 16 / 0.18);
  }
  .zt-tip-pop--wide { max-width: min(28rem, calc(100vw - 16px)); }
  .zt-tip-pop--fallback { z-index: 300; }
  .zt-tip-pop :global(code) {
    padding: 0.05rem 0.25rem;
    border-radius: 4px;
    background: color-mix(in oklch, var(--color-bg) 16%, transparent);
    color: inherit;
    font-family: var(--font-mono);
    font-size: 0.92em;
  }
  .zt-tip-pop :global(a) { color: inherit; text-decoration: underline; text-underline-offset: 0.18em; }
  .zt-tip-pop :global(ul), .zt-tip-pop :global(ol) { margin: 0.35rem 0 0; padding-left: 1.1rem; }
  .zt-tip-pop :global(li + li) { margin-top: 0.2rem; }
  .zt-tip-pop :global(b) { font-weight: 700; }
  @media (max-width: 640px) {
    /* WCAG 2.5.8: 24px target; the 24px circle does not overlap neighbors in any layout that uses it. */
    .zt-tip-btn { width: 28px; height: 28px; }
    .zt-tip-btn--text { width: auto; height: auto; min-height: 44px; }
  }
</style>
