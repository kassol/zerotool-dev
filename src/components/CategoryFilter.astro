---
import { t } from '../i18n/utils';

interface Props {
  lang: 'en' | 'zh' | 'ja' | 'ko';
}
const { lang } = Astro.props;

const categories = ['all', 'data', 'code', 'text', 'encoding', 'security', 'web', 'css', 'color', 'image', 'ids', 'devops'] as const;
const labels = Object.fromEntries(
  categories.map(c => [c, t(lang, `category.${c}`)])
);
const recentLabel = t(lang, 'category.recent');
---

<div class="category-filter" role="group" aria-label={t(lang, 'category.filterLabel')}>
  {/* Recently Used chip: hidden until localStorage has entries (JS unhides it) */}
  <button
    id="chip-recent"
    class="chip chip--recent"
    data-cat="recent"
    type="button"
    aria-pressed="false"
    hidden
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-1px"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    {recentLabel}
  </button>
  {categories.map(cat => (
    <button
      class={`chip${cat === 'all' ? ' chip--active' : ''}`}
      data-cat={cat}
      type="button"
      aria-pressed={cat === 'all' ? 'true' : 'false'}
    >
      {labels[cat]}
    </button>
  ))}
</div>

<script is:inline>
  (function () {
    window.__ztCat = window.__ztCat || 'all';

    // Filtering and ordering live in ToolSearchBar.astro (window.__ztApply).
    function getRecent() {
      try {
        return JSON.parse(localStorage.getItem('zt-recent') || '[]');
      } catch (e) {
        return [];
      }
    }

    // Show Recently Used chip if localStorage has entries
    var recentChip = document.getElementById('chip-recent');
    if (recentChip) {
      var recentList = getRecent();
      if (recentList.length > 0) {
        recentChip.hidden = false;
      }
    }

    // Category chip click handler
    var filter = document.querySelector('.category-filter');
    if (!filter) return;
    filter.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-cat]');
      if (!btn) return;
      var cat = btn.getAttribute('data-cat');
      if (!cat) return;
      window.__ztCat = cat;
      // Update active chip and aria-pressed
      var chips = filter.querySelectorAll('.chip');
      for (var i = 0; i < chips.length; i++) {
        var isActive = chips[i].getAttribute('data-cat') === cat;
        chips[i].classList.toggle('chip--active', isActive);
        chips[i].setAttribute('aria-pressed', isActive ? 'true' : 'false');
      }
      if (typeof window.__ztApply === 'function') window.__ztApply();
    });
  })();
</script>

<style>
  .category-filter {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.45rem;
    overflow-x: auto;
    padding: 0.15rem 0 0.2rem;
    margin-bottom: 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .category-filter::-webkit-scrollbar {
    display: none;
  }

  .chip {
    flex-shrink: 0;
    min-height: 38px;
    padding: 0.38rem 0.82rem;
    font-size: 0.85rem;
    font-weight: 700;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    cursor: pointer;
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
    transition: background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
    white-space: nowrap;
  }

  @media (hover: hover) {
    .chip:hover {
      color: var(--color-primary);
      background: var(--color-surface);
    }
  }

  .chip:active {
    transform: scale(0.96);
  }

  .chip--active {
    background: var(--color-primary);
    color: var(--color-primary-contrast, #fff);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), var(--shadow-subtle);
  }

  .chip--active:hover {
    color: var(--color-primary-contrast, #fff);
  }
</style>
