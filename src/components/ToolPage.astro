---
// Shared body of every tool page. astro.config.mjs (toolRoutes) injects one
// route per tool that renders this with its own tool component in the "tool" slot.
import { getCollection, getEntry } from 'astro:content';
import ToolLayout from '../layouts/ToolLayout.astro';
import { allTools, getToolName } from '../data/tools';
import { guideDirFor } from '../data/guides';

interface Props {
  slug: string;
  lang: string;
}

const { slug, lang } = Astro.props;
const tool = allTools.find((t) => t.slug === slug)!;
const entry = await getEntry('tools', `${slug}/${lang}`);
if (!entry) throw new Error(`Missing content entry: tools/${slug}/${lang}`);
const { Content } = await entry.render();
const { seoTitle, seoDescription, faqItems } = entry.data;
// getCollection instead of getEntry: getEntry logs a warning for every tool without a guide.
const guideDir = guideDirFor(slug);
const [guide] = await getCollection('blog', (p) => p.slug === `${guideDir}/${lang}` && !p.data.draft);
const guideLink = guide
  ? { href: (lang === 'en' ? '' : '/' + lang) + `/blog/${guideDir}/`, title: guide.data.title }
  : undefined;
---

<ToolLayout
  toolName={getToolName(tool, lang)}
  title={seoTitle}
  description={seoDescription}
  lang={lang}
  faqItems={faqItems}
  guideLink={guideLink}
>
  <slot name="tool" slot="tool" />
  <Content />
</ToolLayout>
