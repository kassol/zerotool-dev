---
import { t } from '../i18n/utils';

interface Props {
  lang: 'en' | 'zh' | 'ja' | 'ko';
}
const { lang } = Astro.props;
const placeholder = t(lang, 'search.placeholder');
const noResultsText = t(lang, 'search.noResults');
---

<div class="search-wrap">
  <div class="search-box">
    <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input
      type="search"
      id="tool-search"
      class="search-input"
      placeholder={placeholder}
      aria-label={placeholder}
      autocomplete="off"
      spellcheck="false"
    />
  </div>
  <p id="no-results" class="no-results" hidden>{noResultsText}</p>
</div>

<script>
  // Ranking and matching rules are in tool-search.mjs. CategoryFilter.astro keeps the chip
  // state in window.__ztCat and calls window.__ztApply after a click.
  import { makeEntry, searchEntries } from './tool-search.mjs';

  const input = document.getElementById('tool-search') as HTMLInputElement | null;
  const noResults = document.getElementById('no-results');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.tool-card'));
  const w = window as unknown as { __ztCat?: string; __ztApply?: () => void };

  if (input && noResults && cards.length) {
    const grid = cards[0].parentNode as HTMLElement;
    const entries = cards.map((c) => makeEntry({
      slug: c.dataset.slug || '',
      name: c.dataset.name || '',
      description: c.dataset.desc || '',
      altNames: (c.dataset.alt || '').split('\n'),
    }));

    const getRecent = (): string[] => {
      try { return JSON.parse(localStorage.getItem('zt-recent') || '[]'); } catch { return []; }
    };

    // The first result should start inside the window; when it does not, bring the search
    // controls to the top (below the sticky header) so the results follow right under them.
    const revealResults = (first: HTMLElement) => {
      if (first.getBoundingClientRect().top <= window.innerHeight - 120) return;
      const header = document.querySelector('.site-header');
      const offset = header ? header.getBoundingClientRect().height : 0;
      const target = input.closest('.directory-controls') || input;
      const top = target.getBoundingClientRect().top + window.scrollY - offset - 8;
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top, behavior: smooth ? 'smooth' : 'auto' });
    };

    const apply = (reveal: boolean) => {
      const cat = w.__ztCat || 'all';
      const ranked = searchEntries(entries, input.value);
      const recent = cat === 'recent' ? getRecent() : [];
      let order = cards.map((_, i) => i);
      if (ranked) {
        const hit = new Set(ranked);
        order = ranked.concat(order.filter((i) => !hit.has(i)));
      } else if (cat === 'recent') {
        const rank = (i: number) => { const k = recent.indexOf(cards[i].dataset.slug || ''); return k === -1 ? 9999 : k; };
        order = order.slice().sort((a, b) => rank(a) - rank(b) || a - b);
      }
      const hit = ranked ? new Set(ranked) : null;
      let visible = 0;
      let first: HTMLElement | null = null;
      for (const i of order) {
        const card = cards[i];
        grid.appendChild(card);
        const inCat = cat === 'all' || (cat === 'recent' ? recent.includes(card.dataset.slug || '') : card.dataset.category === cat);
        const show = inCat && (!hit || hit.has(i));
        card.style.display = show ? '' : 'none';
        if (show) { visible++; if (!first) first = card; }
      }
      noResults.hidden = visible > 0;
      if (reveal && ranked && first) revealResults(first);
    };

    w.__ztApply = () => apply(false);
    let timer: ReturnType<typeof setTimeout> | undefined;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => apply(true), 150);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { clearTimeout(timer); apply(true); }
    });
    // Text typed or restored before this module ran, or a chip clicked before it.
    if (input.value.trim() || (w.__ztCat && w.__ztCat !== 'all')) apply(false);
  }
</script>

<style>
  .search-wrap {
    margin-bottom: 0.85rem;
  }

  .search-box {
    position: relative;
    max-width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    min-height: 54px;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    font-size: 1rem;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    outline: none;
    box-sizing: border-box;
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
    transition: box-shadow var(--transition-fast), background-color var(--transition-fast);
  }

  .search-input:focus {
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-primary), 0 0 0 4px var(--color-primary-light);
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  /* Remove default search clear button */
  .search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .no-results {
    margin: 1.5rem 0 0;
    text-align: center;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }
</style>
