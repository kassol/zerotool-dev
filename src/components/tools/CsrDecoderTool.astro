          });
        }

        if (sans.length) {
          checks.push({ state: 'pass', label: t.checkSan, detail: t.sanOk.replace('{n}', String(sans.length)) });
        } else {
          checks.push({ state: 'fail', label: t.checkSan, detail: t.sanMissing });
        }

        var cnEntry = null;
        for (var i = 0; i < csr.subject.length; i++) {
          if (csr.subject[i].oid === '2.5.4.3') { cnEntry = csr.subject[i]; break; }
        }
        var hostSans = sans.filter(function (s) { return s.type === 'DNS' || s.type === 'IP'; })
          .map(function (s) { return String(s.value).toLowerCase(); });
        if (!cnEntry) {
          checks.push({ state: 'warn', label: t.checkCn, detail: t.cnAbsent });
        } else {
          var cn = String(cnEntry.value);
          var covered = hostSans.indexOf(cn.toLowerCase()) !== -1;
          checks.push({
            state: covered ? 'pass' : 'fail',
            label: t.checkCn,
            detail: (covered ? t.cnOk : t.cnMissingFromSan).replace('{cn}', cn)
          });
        }

        var wildcards = hostSans.filter(function (n) { return n.indexOf('*') !== -1; });
        if (!wildcards.length) {
          checks.push({ state: 'pass', label: t.checkWildcard, detail: t.wildcardNone });
        } else {
          for (var w = 0; w < wildcards.length; w++) {
            var name = wildcards[w];
            var labels = name.split('.');
            if (labels[0] !== '*' || name.slice(1).indexOf('*') !== -1) {
              checks.push({ state: 'fail', label: t.checkWildcard, detail: t.wildcardBad.replace('{name}', name) });
            } else if (labels.length <= 2) {
              checks.push({ state: 'warn', label: t.checkWildcard, detail: t.wildcardBroad.replace('{name}', name) });
            } else {
              checks.push({ state: 'pass', label: t.checkWildcard, detail: t.wildcardOk.replace('{name}', name) });
            }
          }
        }

        var offenders = [];
        for (var j = 0; j < sans.length; j++) {
          var entry = sans[j];
          var val = String(entry.value);
          if (entry.type === 'IP') {
            if (isPrivateIp(val)) offenders.push(val);
            continue;
          }
          if (entry.type !== 'DNS') continue;
          var lower = val.toLowerCase();
          if (lower.indexOf('.') === -1) { offenders.push(val); continue; }
          for (var k = 0; k < INTERNAL_SUFFIXES.length; k++) {
            if (lower.slice(-INTERNAL_SUFFIXES[k].length) === INTERNAL_SUFFIXES[k]) { offenders.push(val); break; }
          }
        }
        if (sans.length) {
          if (offenders.length) {
            checks.push({ state: 'fail', label: t.checkPublic, detail: t.publicBad.replace('{name}', offenders.join(', ')) });
          } else {
            checks.push({ state: 'pass', label: t.checkPublic, detail: t.publicOk });
          }
        }

        return checks;
      }

      // ── Rendering ────────────────────────────────────────────────────
      function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function renderRow(label, value, copy) {
        var copyBtn = copy ? '<button class="btn-copy csrd-copy" type="button" data-copy="' + escapeHtml(copy) + '">' + escapeHtml(t.copy) + '</button>' : '';
        return '<div class="csrd-row"><span class="csrd-row-label">' + escapeHtml(label) + '</span><span class="csrd-row-value">' + value + '</span>' + copyBtn + '</div>';
      }

      function renderCard(title, body) {
        return '<section class="csrd-card"><h3 class="csrd-card-title">' + escapeHtml(title) + '</h3><div class="csrd-card-body">' + body + '</div></section>';
      }

      var CHECK_GLYPH = { pass: '✓', warn: '!', fail: '✕' };

      function renderChecks(checks) {
        var body = checks.map(function (c) {
          return '<div class="csrd-check csrd-check--' + c.state + '">' +
            '<span class="csrd-check-mark" aria-hidden="true">' + CHECK_GLYPH[c.state] + '</span>' +
            '<span class="csrd-check-text"><span class="csrd-check-label">' + escapeHtml(c.label) + '</span>' +
            '<span class="csrd-check-detail">' + escapeHtml(c.detail) + '</span></span></div>';
        }).join('');
        return renderCard(t.sectionChecks, body);
      }

      function render(csr, checks, sans, fps) {
        var html = renderChecks(checks);

        function renderName(entries) {
          if (!entries.length) return '<div class="csrd-row csrd-row--muted">—</div>';
          return entries.map(function (e) {
            var label = OID[e.oid] || e.oid;
            var val = e.value instanceof Uint8Array ? bytesToHex(e.value, '') : String(e.value);
            return renderRow(label, escapeHtml(val));
          }).join('');
        }

        var pk = csr.publicKey;
        var pkBody = renderRow(t.labelAlgorithm, escapeHtml(OID[pk.algorithm] || pk.algorithm));
        if (pk.keySize) pkBody += renderRow(t.labelKeySize, escapeHtml(pk.keySize + ' bits'));
        if (pk.exponent) pkBody += renderRow(t.labelExponent, escapeHtml(pk.exponent));
        if (pk.curve) pkBody += renderRow(t.labelCurve, escapeHtml(OID[pk.curve] || pk.curve));

        html += '<div class="csrd-grid-2">' +
          renderCard(t.sectionSubject, renderName(csr.subject)) +
          renderCard(t.sectionPublicKey, pkBody) +
          '</div>';

        if (sans.length) {
          var sanBody = sans.map(function (s) {
            return renderRow(s.type, '<span class="csrd-mono">' + escapeHtml(s.value) + '</span>', s.value);
          }).join('');
          html += renderCard(t.sectionSan, sanBody);
        }

        var extBody = '';
        var kuExt = findExtension(csr.extensions, '2.5.29.15');
        if (kuExt) {
          try {
            var flags = parseKeyUsage(kuExt.raw);
            if (flags.length) {
              extBody += renderRow(t.labelKeyUsage, flags.map(function (f) {
                return '<span class="csrd-chip">' + escapeHtml(f) + '</span>';
              }).join(''));
            }
          } catch (e) { /* unreadable keyUsage is simply not shown */ }
        }
        var ekuExt = findExtension(csr.extensions, '2.5.29.37');
        if (ekuExt) {
          try {
            var ekus = parseEku(ekuExt.raw);
            if (ekus.length) {
              extBody += renderRow(t.labelEku, ekus.map(function (f) {
                return '<span class="csrd-chip">' + escapeHtml(f) + '</span>';
              }).join(''));
            }
          } catch (e) { /* unreadable EKU is simply not shown */ }
        }
        var bcExt = findExtension(csr.extensions, '2.5.29.19');
        if (bcExt) {
          try {
            var bc = parseBasicConstraints(bcExt.raw);
            extBody += renderRow(t.labelCa, escapeHtml(bc.ca ? t.statusYes : t.statusNo));
            if (bc.pathLen !== null) extBody += renderRow(t.labelPathLen, escapeHtml(String(bc.pathLen)));
          } catch (e) { /* unreadable basicConstraints is simply not shown */ }
        }
        if (extBody) html += renderCard(t.sectionExtensions, extBody);

        // extensionRequest is already surfaced through the SAN and extension cards.
        var otherAttrs = csr.attributes.filter(function (a) { return a.oid !== '1.2.840.113549.1.9.14'; });
        if (otherAttrs.length) {
          var attrBody = otherAttrs.map(function (a) {
            var label = OID[a.oid] || a.oid;
            // challengePassword is a shared secret used at revocation time; presence only.
            if (a.oid === '1.2.840.113549.1.9.7') {
              return renderRow(label, '<span class="csrd-row--muted">' + escapeHtml(t.present + ' — ' + t.notShown) + '</span>');
            }
            var shown = t.present;
            try {
              var v = valueOf(a.buf, asnChildren(a.buf, a.valueNode)[0]);
              if (typeof v === 'string' && v) shown = v;
            } catch (e) { /* opaque attribute value: fall back to presence */ }
            return renderRow(label, '<span class="csrd-mono">' + escapeHtml(shown) + '</span>');
          }).join('');
          html += renderCard(t.sectionAttributes, attrBody);
        }

        var sigOid = csr.signatureAlgorithm.oid;
        var sigBody = renderRow(t.labelSignatureAlgo, escapeHtml(OID[sigOid] || sigOid));
        var fpBody =
          renderRow('SHA-256', '<span class="csrd-mono">' + escapeHtml(fps.sha256) + '</span>', fps.sha256) +
          renderRow('SHA-1', '<span class="csrd-mono">' + escapeHtml(fps.sha1) + '</span>', fps.sha1) +
          renderRow(t.labelSpkiPin, '<span class="csrd-mono">' + escapeHtml(fps.spkiPin) + '</span>', fps.spkiPin);

        html += '<div class="csrd-grid-2">' +
          renderCard(t.sectionSignature, sigBody) +
          renderCard(t.sectionFingerprints, fpBody) +
          '</div>';

        html += renderCard(t.sectionMetadata, renderRow(t.labelVersion, escapeHtml('v' + csr.version)));

        return html;
      }

      // ── State & wiring ──────────────────────────────────────────────
      var inputEl = document.getElementById('csrd-input');
      var statusEl = document.getElementById('csrd-status');
      var resultsEl = document.getElementById('csrd-results');
      var btnDecode = document.getElementById('csrd-decode');
      var btnExample = document.getElementById('csrd-example');
      var btnClear = document.getElementById('csrd-clear');

      function setStatus(msg, type) {
        statusEl.textContent = msg || '';
        statusEl.className = 'tool-status ' + (type || 'none');
      }

      async function digest(algorithm, bytes) {
        var hashBuf = await crypto.subtle.digest(algorithm, bytes);
        return new Uint8Array(hashBuf);
      }

      async function runDecode() {
        var input = inputEl.value.trim();
        resultsEl.hidden = true;
        resultsEl.innerHTML = '';
        if (!input) { setStatus(t.errEmpty, 'error'); return; }
        if (input.indexOf('PRIVATE KEY-----') !== -1) { setStatus(t.errIsPrivateKey, 'error'); return; }

        var pems = extractPemCsrs(input);
        if (!pems.length) {
          setStatus(input.indexOf('-----BEGIN CERTIFICATE-----') !== -1 ? t.errIsCertificate : t.errNoMarkers, 'error');
          return;
        }

        var der;
        try { der = base64ToBytes(pems[0]); }
        catch (e) { setStatus(t.errBase64, 'error'); return; }

        var csr;
        try { csr = decodeCsr(der); }
        catch (e) { setStatus(t.errAsn1 + (e && e.message ? e.message : String(e)), 'error'); return; }

        try {
          var sigState = await verifySignature(csr);
          var sanExt = findExtension(csr.extensions, '2.5.29.17');
          var sans = [];
          if (sanExt) {
            try { sans = parseSan(sanExt.raw); }
            catch (e) { /* unreadable SAN behaves like an absent one for the checks */ }
          }
          var checks = buildChecks(csr, sigState, sans);

          var fps = { sha256: '—', sha1: '—', spkiPin: '—' };
          if (crypto && crypto.subtle) {
            fps.sha256 = bytesToHex(await digest('SHA-256', der), ':');
            fps.sha1 = bytesToHex(await digest('SHA-1', der), ':');
            fps.spkiPin = 'sha256/' + bytesToBase64(await digest('SHA-256', csr.spkiBytes));
          }

          resultsEl.innerHTML = render(csr, checks, sans, fps);
          resultsEl.hidden = false;
          setStatus(pems.length > 1 ? t.bundleNotice.replace('{n}', pems.length) : t.decoded, pems.length > 1 ? 'info' : 'success');
          wireCopyButtons();
        } catch (e) {
          setStatus(t.errUnexpected + (e && e.message ? e.message : String(e)), 'error');
        }
      }

      function wireCopyButtons() {
        resultsEl.querySelectorAll('.csrd-copy').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var v = btn.getAttribute('data-copy') || '';
            if (!v) return;
            try {
              navigator.clipboard.writeText(v).then(function () {
                var original = btn.textContent;
                btn.classList.add('copied');
                btn.textContent = t.copied;
                setTimeout(function () { btn.classList.remove('copied'); btn.textContent = original; }, 1400);
              }).catch(function () { /* permission denied: the value stays selectable on screen */ });
            } catch (e) { /* clipboard API absent: the value stays selectable on screen */ }
          });
        });
      }

      btnDecode.addEventListener('click', runDecode);
      btnExample.addEventListener('click', function () {
        inputEl.value = EXAMPLE_PEM;
        setStatus('', 'none');
      });
      btnClear.addEventListener('click', function () {
        inputEl.value = '';
        resultsEl.hidden = true;
        resultsEl.innerHTML = '';
        setStatus('', 'none');
      });

      inputEl.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); runDecode(); }
      });

      // No ztPersist wiring: persistence policy for csr-decoder is `disabled` because a CSR
      // can carry a challengePassword and lists domains that are not public before issuance.
    })();
  </script>

  <style is:global>
    .csrd-wrap {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .csrd-input-section {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .csrd-input {
      min-height: 200px;
    }
    .csrd-actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .csrd-results {
      display: grid;
      gap: 0.75rem;
    }
    .csrd-grid-2 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    @media (min-width: 720px) {
      .csrd-grid-2 {
        grid-template-columns: 1fr 1fr;
      }
    }
    .csrd-card {
      background: var(--color-surface);
      border-radius: var(--radius-lg);
      padding: 0.9rem 1rem;
      box-shadow: inset 0 0 0 1px var(--color-border-soft), var(--shadow-card);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      min-width: 0;
    }
    .csrd-card-title {
      margin: 0;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-primary);
    }
    .csrd-card-body {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      min-width: 0;
    }
    .csrd-row {
      display: flex;
      gap: 0.7rem;
      align-items: center;
      flex-wrap: wrap;
      padding: 0.4rem 0.6rem;
      border-radius: var(--radius-md);
      background: var(--color-bg-secondary);
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
      min-width: 0;
    }
    .csrd-row--muted {
      color: var(--color-text-muted);
      font-style: italic;
    }
    .csrd-row-label {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-text-secondary);
      flex: 0 0 auto;
      min-width: 7rem;
    }
    .csrd-row-value {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 0.88rem;
      color: var(--color-text);
      word-break: break-all;
      overflow-wrap: anywhere;
    }
    .csrd-mono {
      font-family: var(--font-mono);
      font-size: 0.82rem;
    }
    .csrd-chip {
      display: inline-flex;
      align-items: center;
      padding: 0.2rem 0.65rem;
      border-radius: var(--radius-pill);
      background: var(--color-surface);
      color: var(--color-text-secondary);
      font-size: 0.82rem;
      font-weight: 600;
      margin-right: 0.35rem;
      margin-bottom: 0.3rem;
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
    }
    .csrd-copy {
      flex: 0 0 auto;
    }
    .csrd-check {
      display: flex;
      gap: 0.6rem;
      align-items: flex-start;
      padding: 0.5rem 0.65rem;
      border-radius: var(--radius-md);
      background: var(--color-bg-secondary);
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
      min-width: 0;
    }
    .csrd-check-mark {
      flex: 0 0 auto;
      width: 1.35rem;
      height: 1.35rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-pill);
      font-size: 0.78rem;
      font-weight: 800;
      line-height: 1;
      background: color-mix(in oklch, currentColor 14%, transparent);
      box-shadow: inset 0 0 0 1px color-mix(in oklch, currentColor 35%, transparent);
    }
    .csrd-check-text {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      min-width: 0;
    }
    .csrd-check-label {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-text-secondary);
    }
    .csrd-check-detail {
      font-size: 0.88rem;
      color: var(--color-text);
      overflow-wrap: anywhere;
    }
    .csrd-check--pass .csrd-check-mark { color: var(--color-success); }
    .csrd-check--warn .csrd-check-mark { color: var(--color-accent); }
    .csrd-check--fail .csrd-check-mark { color: var(--color-danger); }
    @media (max-width: 640px) {
      .csrd-row-label {
        min-width: 0;
        flex: 0 0 100%;
      }
    }
  </style>
</div>
