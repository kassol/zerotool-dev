---
// CsrDecoderTool — PKCS#10 certificate signing request decoder
// 100% client-side: ASN.1 DER parser + Web Crypto signature verification, no dependencies.
// The ASN.1 primitives mirror SslCertificateDecoderTool; DER is the same grammar for
// X.509 and PKCS#10, and asnRead here additionally records each node's start offset so
// the exact CertificationRequestInfo and SubjectPublicKeyInfo byte ranges can be sliced
// for crypto.subtle.verify.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
---

<div>
  <div class="csrd-wrap">
    <div class="csrd-input-section">
      <label for="csrd-input" class="tool-label">
        <span data-i18n="pasteLabel">Paste CSR (PEM)</span>
      </label>
      <textarea
        id="csrd-input"
        class="tool-textarea csrd-input"
        rows="9"
        placeholder="-----BEGIN CERTIFICATE REQUEST-----&#10;MIIDQzCCAisCAQAwgYYxCzAJBgNVBAYTAlVT...&#10;-----END CERTIFICATE REQUEST-----"
        data-i18n-placeholder="placeholder"
        spellcheck="false"
        autocomplete="off"
      ></textarea>
    </div>

    <div class="csrd-actions">
      <button id="csrd-decode" class="btn-primary" type="button" data-i18n="decode">Decode</button>
      <button id="csrd-example" class="btn-ghost" type="button" data-i18n="loadExample">Load Example</button>
      <button id="csrd-clear" class="btn-ghost" type="button" data-i18n="clear">Clear</button>
    </div>

    <div id="csrd-status" class="tool-status none" aria-live="polite"></div>

    <div id="csrd-results" class="csrd-results" hidden></div>
  </div>

