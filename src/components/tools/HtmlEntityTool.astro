---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: { table: { char: "Character", name: "Name", entity: "Entity", decimal: "Decimal", hex: "Hex", amp: "Ampersand", lt: "Less-than", gt: "Greater-than", quot: "Double quote", apos: "Apostrophe", nbsp: "Non-breaking space", copy: "Copyright", reg: "Registered", trade: "Trademark", mdash: "Em dash", ndash: "En dash", laquo: "Left guillemet", raquo: "Right guillemet" }, modeLabel: "Direction", outputPlaceholder: "Encoded or decoded text appears here...", refTable: "Quick Reference — Common HTML Entities", safety: "Use the encoded result for HTML text and quoted attributes. JavaScript, event handlers, CSS and URLs need their own escaping rules.", tips: {"mode": "Choose Encode or Decode. Typing converts after 0.3 seconds in the selected direction. Changing direction converts the current input immediately and cancels a pending conversion. Clear keeps the selected direction.", "input": "Encode replaces &, <, >, double quotes and apostrophes. Each non-ASCII code point becomes one decimal reference, including emoji. Spaces, tabs and line breaks stay as entered.", "output": "Decode reads named, decimal and hexadecimal references with the browser’s textarea parser. Tags remain text. Legacy names may work without a semicolon; the English status counts only references ending in a semicolon.", "copy": "Copy the complete displayed output. If copying fails, select the output and copy it manually.", "reference": "Expand the table to look up common named, decimal and hexadecimal references. These are reference examples; Encode uses decimal references for non-ASCII characters."}, copyFail: 'Could not copy. Please select and copy the output manually.', inputLabel: 'Input', outputLabel: 'Output', encode: 'Encode', decode: 'Decode', clear: 'Clear', copy: 'Copy', copied: 'Copied!', inputPlaceholder: 'Enter text to encode or encoded text to decode...' },
  zh: { table: { char: "字符", name: "说明", entity: "实体名称", decimal: "十进制", hex: "十六进制", amp: "与号", lt: "小于号", gt: "大于号", quot: "双引号", apos: "单引号", nbsp: "不换行空格", copy: "版权符号", reg: "注册商标符号", trade: "商标符号", mdash: "长破折号", ndash: "短破折号", laquo: "左指双尖引号", raquo: "右指双尖引号" }, modeLabel: "方向", outputPlaceholder: "编码或解码后的文本会显示在这里...", refTable: "速查表 — 常见 HTML 实体", safety: "编码结果用于 HTML 文本和带引号的属性。JavaScript、事件处理器、CSS 和 URL 需要各自的转义规则。", tips: {"mode": "选择「编码」或「解码」。停止输入 0.3 秒后按所选方向转换。切换方向会立即转换当前输入，并取消等待中的转换。「清除」保留所选方向。", "input": "「编码」替换 &、<、>、双引号和单引号。每个非 ASCII 码点生成一个十进制引用，包括表情符号。空格、制表符和换行保持原样。", "output": "「解码」使用浏览器的 textarea 解析器读取命名、十进制和十六进制引用，标签保持为文本。部分旧名称可省略分号；英文状态只统计以分号结尾的引用。", "copy": "复制当前显示的完整输出。复制失败时，请选中输出后手动复制。", "reference": "展开表格，查看常见命名、十进制和十六进制引用。这些条目供查阅；「编码」对非 ASCII 字符使用十进制引用。"}, copyFail: '复制失败。请选中输出内容后手动复制。', inputLabel: '输入', outputLabel: '输出', encode: '编码', decode: '解码', clear: '清除', copy: '复制', copied: '已复制！', inputPlaceholder: '输入要编码的文本或要解码的 HTML 实体...' },
  ja: { table: { char: "文字", name: "名称", entity: "名前付き参照", decimal: "10進数", hex: "16進数", amp: "アンパサンド", lt: "小なり記号", gt: "大なり記号", quot: "二重引用符", apos: "単一引用符", nbsp: "ノーブレークスペース", copy: "著作権記号", reg: "登録商標記号", trade: "商標記号", mdash: "エムダッシュ", ndash: "エンダッシュ", laquo: "左ギュメ", raquo: "右ギュメ" }, modeLabel: "方向", outputPlaceholder: "エンコードまたはデコードしたテキストをここに表示します...", refTable: "クイックリファレンス — よく使う HTML エンティティ", safety: "エンコード結果は HTML 本文と引用符付き属性に使います。JavaScript、イベントハンドラー、CSS、URL には各文脈のエスケープが必要です。", tips: {"mode": "「エンコード」か「デコード」を選びます。入力を止めて0.3秒後、選択中の方向で変換します。方向を変えると現在の入力をすぐに変換し、待機中の変換を取り消します。「クリア」でも方向は保持します。", "input": "エンコードは &、<、>、二重引用符、単一引用符を置き換えます。ASCII 範囲外の各コードポイントは、絵文字を含め1つの10進数参照になります。空白、タブ、改行は保持します。", "output": "デコードはブラウザーの textarea パーサーで名前付き・10進数・16進数参照を読み取ります。タグは文字列のままです。一部の旧名称はセミコロンなしでも読めます。英語のステータスはセミコロンで終わる参照のみ数えます。", "copy": "表示中の出力全体をコピーします。失敗した場合は出力を選択して手動でコピーしてください。", "reference": "表を開くと、よく使う名前付き・10進数・16進数参照を確認できます。表は参照用で、エンコードは ASCII 範囲外の文字を10進数参照にします。"}, copyFail: 'コピーできませんでした。出力を選択して手動でコピーしてください。', inputLabel: '入力', outputLabel: '出力', encode: 'エンコード', decode: 'デコード', clear: 'クリア', copy: 'コピー', copied: 'コピー済み！', inputPlaceholder: 'エンコードするテキストまたはデコードする HTML エンティティを入力...' },
  ko: { table: { char: "문자", name: "설명", entity: "이름 참조", decimal: "10진수", hex: "16진수", amp: "앰퍼샌드", lt: "부등호(작음)", gt: "부등호(큼)", quot: "큰따옴표", apos: "작은따옴표", nbsp: "줄바꿈 없는 공백", copy: "저작권 기호", reg: "등록 상표 기호", trade: "상표 기호", mdash: "엠 대시", ndash: "엔 대시", laquo: "왼쪽 기메", raquo: "오른쪽 기메" }, modeLabel: "방향", outputPlaceholder: "인코딩하거나 디코딩한 텍스트가 여기에 표시됩니다...", refTable: "빠른 참조 — 자주 쓰는 HTML 엔티티", safety: "인코딩 결과는 HTML 본문과 따옴표로 감싼 속성에 사용하세요. JavaScript, 이벤트 핸들러, CSS, URL에는 문맥에 맞는 별도 이스케이프 규칙이 필요합니다.", tips: {"mode": "인코딩 또는 디코딩을 선택하세요. 입력을 멈추고 0.3초 뒤 선택한 방향으로 변환합니다. 방향을 바꾸면 대기 중인 변환을 취소하고 현재 입력을 즉시 변환합니다. 지우기는 선택한 방향을 유지합니다.", "input": "인코딩은 &, <, >, 큰따옴표와 작은따옴표를 바꿉니다. 이모지를 포함해 ASCII 범위 밖의 각 코드 포인트는 10진수 참조 하나가 됩니다. 공백, 탭, 줄바꿈은 유지됩니다.", "output": "디코딩은 브라우저의 textarea 파서로 이름·10진수·16진수 참조를 읽습니다. 태그는 텍스트로 남습니다. 일부 예전 이름은 세미콜론 없이도 인식되며 영어 상태 메시지는 세미콜론으로 끝나는 참조만 셉니다.", "copy": "현재 표시된 출력 전체를 복사합니다. 실패하면 출력을 선택하여 직접 복사하세요.", "reference": "표를 펼쳐 자주 쓰는 이름·10진수·16진수 참조를 확인하세요. 표는 참조용이며 인코딩은 ASCII 범위 밖의 문자를 10진수 참조로 바꿉니다."}, copyFail: '복사하지 못했습니다. 출력을 선택하여 직접 복사하세요.', inputLabel: '입력', outputLabel: '출력', encode: '인코딩', decode: '디코딩', clear: '지우기', copy: '복사', copied: '복사됨!', inputPlaceholder: '인코딩할 텍스트 또는 디코딩할 HTML 엔티티를 입력...' }
} as const;
const T = STRINGS[lang];
const { tips: TIPS, table: TABLE, ...CLIENT_T } = T;
---

<div class="he-wrap">
    <div class="he-controls">
      <div class="he-direction">
        <div class="he-modes zt-segmented" role="group" aria-label={T.modeLabel}>
          <label><input id="he-encode" type="radio" name="hemode" value="encode" checked /> <span>{T.encode}</span></label>
          <label><input id="he-decode" type="radio" name="hemode" value="decode" /> <span>{T.decode}</span></label>
        </div>
        <Toggletip id="he-tip-mode" about={T.modeLabel} lang={lang}>{TIPS.mode}</Toggletip>
      </div>
      <button id="he-clear" class="btn-ghost" type="button">{T.clear}</button>
    </div>
    <div id="he-status" class="he-status" aria-live="polite"></div>
    <div class="he-panels zt-io">
      <div class="he-row zt-io-pane">
        <div class="he-head">
          <label for="he-input">{T.inputLabel}</label>
          <Toggletip id="he-tip-input" about={T.inputLabel} lang={lang}>{TIPS.input}</Toggletip>
        </div>
        <textarea id="he-input" class="tool-textarea he-box zt-io-fill" placeholder={T.inputPlaceholder} spellcheck="false"></textarea>
      </div>
      <div id="he-output-pane" class="he-row zt-io-pane" data-empty="true">
        <div class="he-head">
          <label for="he-output">{T.outputLabel}</label>
          <Toggletip id="he-tip-output" about={T.outputLabel} lang={lang}>{TIPS.output}</Toggletip>
          <div class="he-copy-controls">
            <button id="he-copy" class="btn-copy" type="button">{T.copy}</button>
            <Toggletip id="he-tip-copy" about={T.copy} lang={lang}>{TIPS.copy}</Toggletip>
          </div>
        </div>
        <textarea id="he-output" class="tool-textarea he-box zt-io-fill" placeholder={T.outputPlaceholder} readonly spellcheck="false"></textarea>
      </div>
    </div>
    <p class="he-safety">{T.safety}</p>
    <div class="he-reference">
      <details class="he-ref">
        <summary>{T.refTable}</summary>
        <div class="he-ref-table-wrap" tabindex="0" role="region" aria-label={T.refTable}>
        <table class="he-ref-table">
          <thead>
            <tr><th>{TABLE.char}</th><th>{TABLE.name}</th><th>{TABLE.entity}</th><th>{TABLE.decimal}</th><th>{TABLE.hex}</th></tr>
          </thead>
          <tbody>
            <tr><td>&amp;</td><td>{TABLE.amp}</td><td>&amp;amp;</td><td>&amp;#38;</td><td>&amp;#x26;</td></tr>
            <tr><td>&lt;</td><td>{TABLE.lt}</td><td>&amp;lt;</td><td>&amp;#60;</td><td>&amp;#x3C;</td></tr>
            <tr><td>&gt;</td><td>{TABLE.gt}</td><td>&amp;gt;</td><td>&amp;#62;</td><td>&amp;#x3E;</td></tr>
            <tr><td>"</td><td>{TABLE.quot}</td><td>&amp;quot;</td><td>&amp;#34;</td><td>&amp;#x22;</td></tr>
            <tr><td>'</td><td>{TABLE.apos}</td><td>&amp;apos;</td><td>&amp;#39;</td><td>&amp;#x27;</td></tr>
            <tr><td> </td><td>{TABLE.nbsp}</td><td>&amp;nbsp;</td><td>&amp;#160;</td><td>&amp;#xA0;</td></tr>
            <tr><td>&copy;</td><td>{TABLE.copy}</td><td>&amp;copy;</td><td>&amp;#169;</td><td>&amp;#xA9;</td></tr>
            <tr><td>&reg;</td><td>{TABLE.reg}</td><td>&amp;reg;</td><td>&amp;#174;</td><td>&amp;#xAE;</td></tr>
            <tr><td>&trade;</td><td>{TABLE.trade}</td><td>&amp;trade;</td><td>&amp;#8482;</td><td>&amp;#x2122;</td></tr>
            <tr><td>&mdash;</td><td>{TABLE.mdash}</td><td>&amp;mdash;</td><td>&amp;#8212;</td><td>&amp;#x2014;</td></tr>
            <tr><td>&ndash;</td><td>{TABLE.ndash}</td><td>&amp;ndash;</td><td>&amp;#8211;</td><td>&amp;#x2013;</td></tr>
            <tr><td>&laquo;</td><td>{TABLE.laquo}</td><td>&amp;laquo;</td><td>&amp;#171;</td><td>&amp;#xAB;</td></tr>
            <tr><td>&raquo;</td><td>{TABLE.raquo}</td><td>&amp;raquo;</td><td>&amp;#187;</td><td>&amp;#xBB;</td></tr>
          </tbody>
        </table>
        </div>
      </details>
      <Toggletip id="he-tip-reference" about={T.refTable} lang={lang}>{TIPS.reference}</Toggletip>
    </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var inputEl = document.getElementById('he-input');
      var outputEl = document.getElementById('he-output');
      var outputPane = document.getElementById('he-output-pane');
      var statusEl = document.getElementById('he-status');
      var copyBtn = document.getElementById('he-copy');
      var lastValidHtmlOutput = '';
      var heMode = 'encode'; // tracks last used direction
      var copyError = false;
      var copyRevision = 0;
      var copyTimer = null;

      function setStatus(msg, isError) {
        copyError = false;
        statusEl.textContent = msg;
        statusEl.className = 'he-status ' + (isError ? 'error' : 'success');
        outputPane.setAttribute('data-empty', outputEl.value ? 'false' : 'true');
      }

      function clearStatus() {
        copyError = false;
        statusEl.textContent = '';
        statusEl.className = 'he-status';
        outputPane.setAttribute('data-empty', outputEl.value ? 'false' : 'true');
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        if (copyError) clearStatus();
      }

      function clearResult() {
        invalidateCopy();
        outputEl.value = '';
        lastValidHtmlOutput = '';
        clearStatus();
      }

      /* ── engine:start ── */
      // Non-ASCII characters are written as one decimal reference per code point, so a
      // character outside the BMP (emoji) is not split into two surrogate references.
      function encodeHtml(str) {
        var count = 0;
        var result = '';
        for (var i = 0; i < str.length; i++) {
          var ch = str[i];
          var code = str.codePointAt(i);
          if (ch === '&') { result += '&amp;'; count++; }
          else if (ch === '<') { result += '&lt;'; count++; }
          else if (ch === '>') { result += '&gt;'; count++; }
          else if (ch === '"') { result += '&quot;'; count++; }
          else if (ch === "'") { result += '&#39;'; count++; }
          else if (code > 127) {
            result += '&#' + code + ';'; count++;
            if (code > 0xFFFF) i++;
          }
          else { result += ch; }
        }
        return { text: result, count: count };
      }

      // Character references in the input, for the decode status. Named references can
      // contain digits (&frac12;, &sup2;, &there4; in WHATWG entities.json).
      function countReferences(str) {
        var m = str.match(/&(?:#[xX][0-9a-fA-F]+|#[0-9]+|[a-zA-Z][a-zA-Z0-9]*);/g);
        return m ? m.length : 0;
      }
      /* ── engine:end ── */

      function decodeHtml(str) {
        var ta = document.createElement('textarea');
        ta.innerHTML = str;
        var decoded = ta.value;
        return { text: decoded, count: countReferences(str) };
      }

      /* ── Real-time encode/decode (debounced 300ms, uses last direction) ── */
      var _heLiveTimer = null;
      function convert(track) {
        invalidateCopy();
        var val = inputEl.value;
        if (!val) { clearResult(); return; }
        try {
          if (heMode === 'encode') {
            var r = encodeHtml(val);
            outputEl.value = r.text;
            lastValidHtmlOutput = r.text;
            setStatus('Encoded — ' + r.count + ' character' + (r.count !== 1 ? 's' : '') + ' converted.', false);
          } else {
            var r = decodeHtml(val);
            outputEl.value = r.text;
            lastValidHtmlOutput = r.text;
            setStatus('Decoded — ' + r.count + ' entit' + (r.count !== 1 ? 'ies' : 'y') + ' converted.', false);
          }
          if (track) window.trackTool && window.trackTool('html_entity', heMode);
        } catch (e) {
          setStatus('Error: ' + e.message, true);
        }
      }
      inputEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_heLiveTimer);
        _heLiveTimer = setTimeout(function () { convert(false); }, 300);
      });
      document.querySelectorAll('input[name="hemode"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
          if (!radio.checked) return;
          clearTimeout(_heLiveTimer);
          heMode = radio.value;
          convert(true);
        });
      });

      document.getElementById('he-clear').addEventListener('click', function () {
        clearTimeout(_heLiveTimer);
        inputEl.value = '';
        clearResult();
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var widget = document.querySelector('.he-wrap');
        if (widget && widget.contains(document.activeElement)) {
          clearTimeout(_heLiveTimer);
          clearResult();
        }
      });

      copyBtn.addEventListener('click', function () {
        if (!outputEl.value) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        function done() {
          if (revision !== copyRevision) return;
          if (copyError) clearStatus();
          copyBtn.textContent = t.copied;
          copyTimer = setTimeout(function () { if (revision === copyRevision) copyBtn.textContent = t.copy; }, 1500);
        }
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(t.copyFail, true);
          copyError = true;
        }
        try { navigator.clipboard.writeText(outputEl.value).then(done, failed); }
        catch (e) { failed(); }
      });
    })();
  </script>
</div>

<style>
  .he-wrap { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; }
  .he-controls { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; flex: none; }
  .he-direction { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .he-modes { padding: 3px; background: var(--color-bg-secondary); font-size: 0.88rem; }
  .he-modes label { position: relative; display: flex; align-items: center; padding: 0.3rem 0.65rem; border-radius: var(--radius-pill); cursor: pointer; color: var(--color-text-secondary); }
  .he-modes input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .he-modes label:has(input:checked) { background: var(--color-surface); color: var(--color-primary); }
  .he-modes label:has(input:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: 1px; }
  .he-head { display: flex; align-items: center; gap: 0.25rem; min-height: 32px; flex: none; }
  .he-head label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .he-copy-controls { display: flex; align-items: center; gap: 0.25rem; margin-left: auto; }
  .he-box { width: 100%; overflow: auto; font-family: var(--font-mono); font-size: 0.88rem; }
  .he-status { flex: none; height: 2.8em; line-height: 1.4; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; }
  .he-status.success { color: var(--color-success); }
  .he-status.error { color: var(--color-danger); }
  .he-safety { margin: 0; flex: none; font-size: 0.82rem; color: var(--color-text-secondary); }
  .he-reference { display: flex; align-items: flex-start; gap: 0.35rem; flex: none; min-width: 0; }
  .he-reference > :global(.zt-tip) { margin-top: 0.4rem; }
  .he-ref { flex: 1; min-width: 0; border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .he-ref summary { padding: 0.6rem 0.75rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); cursor: pointer; user-select: none; }
  .he-ref-table-wrap { max-height: 320px; overflow: auto; padding: 0 0.75rem 0.75rem; }
  .he-ref-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; font-family: var(--font-mono); }
  .he-ref-table th, .he-ref-table td { padding: 0.35rem 0.6rem; text-align: left; border-bottom: 1px solid var(--color-border); }
  .he-ref-table th { font-family: inherit; font-weight: 600; color: var(--color-text-secondary); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .he-ref-table tbody tr:last-child td { border-bottom: none; }
  @media (max-width: 860px) {
    #he-output-pane[data-empty="true"] { display: none; }
    .he-box { height: 160px; }
  }
  @media (max-width: 640px) {
    .he-modes label { min-height: 44px; padding-left: 0.5rem; padding-right: 0.5rem; }
    .he-status { height: 4.2em; }
    .he-box { height: 120px; }
    .he-ref summary { min-height: 44px; }
  }
</style>
