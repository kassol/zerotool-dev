      pngBlob().then(function (b) { save(b, stem() + '.png'); track('download_png'); });
    });
    els.svg.addEventListener('click', function () {
      if (!current) return;
      save(new Blob([svgText()], { type: 'image/svg+xml' }), stem() + '.svg');
      track('download_svg');
    });
    els.copy.addEventListener('click', function () {
      if (!current) return;
      var btn = els.copy;
      try {
        if (!navigator.clipboard || typeof ClipboardItem === 'undefined') throw new Error('no clipboard');
        navigator.clipboard.write([new ClipboardItem({ 'image/png': pngBlob() })])
          .then(function () { flash(btn, true); track('copy_png'); }, function () { flash(btn, false); });
      } catch (e) { flash(btn, false); }
    });
    els.copySvg.addEventListener('click', function () {
      if (!current) return;
      var btn = els.copySvg;
      if (!navigator.clipboard) { flash(btn, false); return; }
      navigator.clipboard.writeText(svgText()).then(function () { flash(btn, true); track('copy_svg'); }, function () { flash(btn, false); });
    });
    els.fixBtn.addEventListener('click', function () {
      els.text.value = 'https://' + els.text.value.trim();
      render();
      els.text.focus();
    });

    var tabs = Array.prototype.slice.call(document.querySelectorAll('.qrg-tab'));
    function selectTab(k, focus) {
      tab = k;
      tabs.forEach(function (b) {
        var on = b.getAttribute('data-tab') === k;
        b.setAttribute('aria-selected', on ? 'true' : 'false');
        b.tabIndex = on ? 0 : -1;
        $('qrg-panel-' + b.getAttribute('data-tab')).hidden = !on;
        if (on && focus) b.focus();
      });
      render();
    }
    tabs.forEach(function (b, i) {
      b.addEventListener('click', function () { selectTab(b.getAttribute('data-tab')); });
      b.addEventListener('keydown', function (e) {
        var j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -1;
        if (j === -1) return;
        e.preventDefault();
        selectTab(tabs[(j + tabs.length) % tabs.length].getAttribute('data-tab'), true);
      });
    });

    var pending = 0;
    function schedule() { if (pending) return; pending = requestAnimationFrame(function () { pending = 0; render(); }); }
    $('qrg').addEventListener('input', function (e) {
      if (e.target.closest('.qrg-options') || e.target === els.cformat) savePrefs();
      schedule();
    });
    $('qrg').addEventListener('change', function (e) {
      if (e.target.closest('.qrg-options') || e.target === els.cformat) { savePrefs(); render(); }
    });
    /* The shared Ctrl/⌘+L shortcut empties the text fields; redraw after it runs. */
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L')) setTimeout(render, 0);
    });
    var lastWidth = 0;
    window.addEventListener('resize', function () {
      var w = els.canvas.parentNode.clientWidth;
      if (current && w !== lastWidth) { lastWidth = w; drawPreview(); }
    });

    loadPrefs();
    render();
  })();
</script>

