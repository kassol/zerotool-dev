---
// No props needed — tool widget is language-independent
---

<div>
  <div class="efp-wrap">
    <div class="efp-input-section">
      <label for="efp-input">
        <span data-i18n="envContent">.env Content</span>
        <button id="efp-clear" class="btn-ghost" type="button" data-i18n="clear">Clear</button>
      </label>
      <textarea
        id="efp-input"
        placeholder={"# Comment\nDB_HOST=localhost\nDB_PORT=5432\nDB_NAME=myapp\nAPI_KEY=\"secret-key\"\nDEBUG="}
        spellcheck="false"
      ></textarea>
    </div>

    <div class="efp-actions">
      <button id="efp-parse" class="btn-primary" type="button" data-i18n="parse">Parse</button>
      <button id="efp-export-json" class="btn-ghost" type="button" data-i18n="exportJson">Export JSON</button>
    </div>

    <div id="efp-status" class="efp-status" aria-live="polite"></div>

    <div id="efp-result" class="efp-result" style="display:none">
      <div class="efp-table-wrap">
        <table class="efp-table" id="efp-table">
          <thead>
            <tr>
              <th>#</th>
              <th data-i18n="colKey">Key</th>
              <th data-i18n="colValue">Value</th>
              <th data-i18n="colNotes">Notes</th>
            </tr>
          </thead>
          <tbody id="efp-tbody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var STRINGS = {
        en: { envContent: '.env Content', clear: 'Clear', parse: 'Parse', exportJson: 'Export JSON', colKey: 'Key', colValue: 'Value', colNotes: 'Notes', pastePrompt: 'Paste .env content above and click Parse.', parseFirst: 'Parse a .env file first.', exported: 'Exported {n} key{s} to env.json.', stValid: '{n} valid', stWarn: '{n} warning', stWarns: '{n} warnings', stErr: '{n} error', stErrs: '{n} errors', stSep: ', ', stEnd: '.', notes: { missingEq: 'Missing = sign', emptyKey: 'Empty key', multiline: 'Multiline value (lines {from}-{to})', unclosed: 'Unclosed quote', afterQuote: 'Text after closing quote', hashComment: 'Text after # is a comment; quote the value to keep it', nonStandard: 'Non-standard key name', emptyValue: 'Empty value', duplicate: 'Duplicate key' } },
        zh: { envContent: '.env 内容', clear: '清除', parse: '解析', exportJson: '导出 JSON', colKey: '键', colValue: '值', colNotes: '备注', pastePrompt: '请粘贴 .env 内容后点击解析。', parseFirst: '请先解析一个 .env 文件。', exported: '已将 {n} 个键导出到 env.json。', stValid: '有效 {n} 个', stWarn: '警告 {n} 个', stWarns: '警告 {n} 个', stErr: '错误 {n} 个', stErrs: '错误 {n} 个', stSep: '，', stEnd: '。', notes: { missingEq: '缺少 = 号', emptyKey: '键为空', multiline: '多行值（第 {from}–{to} 行）', unclosed: '引号未闭合', afterQuote: '闭合引号后还有文字', hashComment: '# 之后的文字是注释；要保留请给值加引号', nonStandard: '键名不符合常见规则', emptyValue: '值为空', duplicate: '键重复' } },
        ja: { envContent: '.env の内容', clear: 'クリア', parse: '解析', exportJson: 'JSON エクスポート', colKey: 'キー', colValue: '値', colNotes: '備考', pastePrompt: '.env の内容を貼り付けて解析をクリックしてください。', parseFirst: '先に .env ファイルを解析してください。', exported: '{n} 件のキーを env.json にエクスポートしました。', stValid: '有効 {n} 件', stWarn: '警告 {n} 件', stWarns: '警告 {n} 件', stErr: 'エラー {n} 件', stErrs: 'エラー {n} 件', stSep: '、', stEnd: '。', notes: { missingEq: '= がありません', emptyKey: 'キーが空です', multiline: '複数行の値（{from}〜{to} 行目）', unclosed: '引用符が閉じていません', afterQuote: '閉じ引用符の後に文字があります', hashComment: '# 以降はコメントです。残すには値を引用符で囲んでください', nonStandard: '一般的でないキー名', emptyValue: '値が空です', duplicate: 'キーが重複しています' } },
        ko: { envContent: '.env 내용', clear: '지우기', parse: '파싱', exportJson: 'JSON 내보내기', colKey: '키', colValue: '값', colNotes: '메모', pastePrompt: '.env 내용을 붙여넣고 파싱을 클릭하세요.', parseFirst: '먼저 .env 파일을 파싱하세요.', exported: '{n}개의 키를 env.json으로 내보냈습니다.', stValid: '유효 {n}개', stWarn: '경고 {n}개', stWarns: '경고 {n}개', stErr: '오류 {n}개', stErrs: '오류 {n}개', stSep: ', ', stEnd: '.', notes: { missingEq: '= 기호가 없습니다', emptyKey: '키가 비어 있습니다', multiline: '여러 줄 값({from}~{to}행)', unclosed: '따옴표가 닫히지 않았습니다', afterQuote: '닫는 따옴표 뒤에 문자가 있습니다', hashComment: '# 뒤는 주석입니다. 남기려면 값을 따옴표로 감싸세요', nonStandard: '일반적이지 않은 키 이름', emptyValue: '값이 비어 있습니다', duplicate: '중복된 키' } }
      };

      var pageLang = (document.documentElement.lang || 'en').slice(0, 2);
      var t = STRINGS[pageLang] || STRINGS.en;
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n'); if (t[key]) el.textContent = t[key];
      });
      document.querySelectorAll('[data-i18n-ph]').forEach(function(el) {
        var key = el.getAttribute('data-i18n-ph'); if (t[key]) el.placeholder = t[key];
      });

      var inputEl = document.getElementById('efp-input');
      var statusEl = document.getElementById('efp-status');
      var resultEl = document.getElementById('efp-result');
      var tbodyEl = document.getElementById('efp-tbody');
      var parseBtn = document.getElementById('efp-parse');
      var exportBtn = document.getElementById('efp-export-json');
      var clearBtn = document.getElementById('efp-clear');

      var lastParsed = [];

      function setStatus(msg, type) {
        statusEl.textContent = msg;
        statusEl.className = 'efp-status ' + (type || '');
      }

      /* ── engine:start ── */
      // Parsing follows dotenv (https://github.com/motdotla/dotenv#what-rules-does-the-parsing-engine-follow,
      // LINE regex in lib/main.js): optional `export `, `#` starts a comment unless the value is
      // quoted, quoted values may span lines, only double quotes expand \n and \r.
      var NOTES_EN = { missingEq: 'Missing = sign', emptyKey: 'Empty key', multiline: 'Multiline value (lines {from}-{to})', unclosed: 'Unclosed quote', afterQuote: 'Text after closing quote', hashComment: 'Text after # is a comment; quote the value to keep it', nonStandard: 'Non-standard key name', emptyValue: 'Empty value', duplicate: 'Duplicate key' };
      // dotenv 16.6.1 LINE, with the leading whitespace/export captured for line numbers.
      var LINE_RE = /(?:^|^)(\s*(?:export\s+)?)([\w.-]+)(?:\s*=\s*?|:\s+?)(\s*'(?:\\'|[^'])*'|\s*"(?:\\"|[^"])*"|\s*`(?:\\`|[^`])*`|[^#\r\n]+)?\s*(?:#.*)?(?:$|$)/mg;

      function finishValue(raw) {
        var value = raw.trim();
        var maybeQuote = value[0];
        value = value.replace(/^(['"`])([\s\S]*)\1$/mg, '$2');
        if (maybeQuote === '"') {
          value = value.replace(/\\n/g, '\n').replace(/\\r/g, '\r');
        }
        return value;
      }

      // msg: note texts in the page language (STRINGS[lang].notes); English when omitted
      function parseEnv(text, msg) {
        var M = msg || NOTES_EN;
        text = text.replace(/\r\n?/g, '\n');
        var lines = text.split('\n');
        var entries = [];
        var seenKeys = Object.create(null);

        var matched = Object.create(null);
        var covered = Object.create(null);
        LINE_RE.lastIndex = 0;
        var match;
        while ((match = LINE_RE.exec(text)) !== null) {
          var keyPos = match.index + match[1].length;
          var firstLine = text.slice(0, keyPos).split('\n').length - 1;
          // Only the value spans continuation lines; a later standalone comment stays a row.
          var rawMatchedValue = match[3] || '';
          var valuePos = text.indexOf(rawMatchedValue, keyPos + match[2].length);
          var endPos = rawMatchedValue.trimEnd() ? valuePos + rawMatchedValue.trimEnd().length : keyPos;
          var lastLine = text.slice(0, endPos).split('\n').length - 1;
          matched[firstLine] = { key: match[2], rawValue: match[3] || '', lastLine: lastLine };
          for (var c = firstLine + 1; c <= lastLine; c++) covered[c] = true;
        }

        for (var i = 0; i < lines.length; i++) {
          if (covered[i]) continue;
          var raw = lines[i];
          var lineNo = i + 1;
          var trimmed = raw.trim();

          if (trimmed === '') continue;
          if (trimmed.startsWith('#')) {
            entries.push({ lineNo: lineNo, type: 'comment', raw: trimmed });
            continue;
          }

          var item = matched[i];
          if (!item) {
            var reason = /^\s*=/.test(raw) ? M.emptyKey : /[=:]/.test(raw) ? M.nonStandard : M.missingEq;
            entries.push({ lineNo: lineNo, type: 'error', raw: trimmed, error: reason });
            continue;
          }

          var key = item.key;
          var notes = [];
          var rawValue = item.rawValue.trim();
          var value = finishValue(item.rawValue);
          if (item.lastLine > i) {
            notes.push(M.multiline.replace('{from}', lineNo).replace('{to}', item.lastLine + 1));
          }
          var first = rawValue[0];
          var quoted = (first === '"' || first === "'" || first === '`') && rawValue.endsWith(first) && rawValue.length > 1;
          if (!quoted && (first === '"' || first === "'" || first === '`')) {
            notes.push(rawValue.indexOf(first, 1) === -1 ? M.unclosed : M.afterQuote);
          } else if (!quoted) {
            var rest = raw.slice(raw.search(/[=:]/) + 1);
            var hashIdx = rest.indexOf('#');
            if (hashIdx !== -1 && (hashIdx === 0 || !/\s/.test(rest[hashIdx - 1]))) notes.push(M.hashComment);
          }

          if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) {
            notes.push(M.nonStandard);
          }
          if (value === '') {
            notes.push(M.emptyValue);
          }
          if (seenKeys[key]) {
            notes.push(M.duplicate);
          } else {
            seenKeys[key] = true;
          }

          entries.push({
            lineNo: lineNo,
            type: notes.length > 0 ? 'warn' : 'ok',
            key: key,
            value: value,
            notes: notes
          });
        }

        return entries;
      }
      /* ── engine:end ── */

      function escapeHtml(str) {
        return str
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function render(entries) {
        tbodyEl.innerHTML = '';
        var validCount = 0;
        var errorCount = 0;
        var warnCount = 0;

        for (var i = 0; i < entries.length; i++) {
          var e = entries[i];
          if (e.type === 'comment') continue;

          var tr = document.createElement('tr');
          tr.className = 'efp-row-' + e.type;

          if (e.type === 'error') {
            errorCount++;
            tr.innerHTML =
              '<td>' + e.lineNo + '</td>' +
              '<td colspan="2" class="efp-raw"><code>' + escapeHtml(e.raw) + '</code></td>' +
              '<td class="efp-note error">' + escapeHtml(e.error) + '</td>';
          } else {
            if (e.notes && e.notes.length > 0) warnCount++;
            else validCount++;
            tr.innerHTML =
              '<td>' + e.lineNo + '</td>' +
              '<td><code class="efp-key">' + escapeHtml(e.key) + '</code></td>' +
              '<td><code class="efp-val">' + escapeHtml(e.value) + '</code></td>' +
              '<td class="efp-note ' + (e.notes && e.notes.length ? 'warn' : '') + '">' +
              (e.notes && e.notes.length ? escapeHtml(e.notes.join(t.stSep)) : '') + '</td>';
          }

          tbodyEl.appendChild(tr);
        }

        return { validCount: validCount, errorCount: errorCount, warnCount: warnCount };
      }

      parseBtn.addEventListener('click', function () {
        invalidateExport();
        var text = inputEl.value;
        if (!text.trim()) {
          setStatus(t.pastePrompt, '');
          resultEl.style.display = 'none';
          return;
        }

        lastParsed = parseEnv(text, t.notes);
        exportBtn.disabled = !lastParsed.some(function (e) { return e.type === 'ok' || e.type === 'warn'; });
        var counts = render(lastParsed);

        resultEl.style.display = '';

        var parts = [];
        parts.push(t.stValid.replace('{n}', counts.validCount));
        if (counts.warnCount > 0) parts.push((counts.warnCount === 1 ? t.stWarn : t.stWarns).replace('{n}', counts.warnCount));
        if (counts.errorCount > 0) parts.push((counts.errorCount === 1 ? t.stErr : t.stErrs).replace('{n}', counts.errorCount));

        var type = counts.errorCount > 0 ? 'error' : counts.warnCount > 0 ? 'warn' : 'success';
        setStatus(parts.join(t.stSep) + t.stEnd, type);

        window.trackTool && window.trackTool('env-file-parser', 'parse');
      });

      exportBtn.addEventListener('click', function () {
        if (exportBtn.disabled) return;
        var validEntries = lastParsed.filter(function (e) {
          return e.type === 'ok' || e.type === 'warn';
        });
        if (validEntries.length === 0) {
          setStatus(t.parseFirst, 'error');
          return;
        }

        // Null prototype: a key named __proto__ becomes a normal property instead of being dropped
        var obj = Object.create(null);
        for (var i = 0; i < validEntries.length; i++) {
          obj[validEntries[i].key] = validEntries[i].value;
        }
        var keyCount = Object.keys(obj).length;

        var json = JSON.stringify(obj, null, 2);
        var blob = new Blob([json], { type: 'application/json' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'env.json';
        a.click();
        URL.revokeObjectURL(url);
        var msg = t.exported.replace('{n}', keyCount).replace('{s}', keyCount !== 1 ? 's' : '');
        setStatus(msg, 'success');
        window.trackTool && window.trackTool('env-file-parser', 'export_json');
      });

      clearBtn.addEventListener('click', function () {
        inputEl.value = '';
        tbodyEl.innerHTML = '';
        resultEl.style.display = 'none';
        setStatus('', '');
        invalidateExport();
      });

      function invalidateExport() {
        lastParsed = [];
        exportBtn.disabled = true;
      }
      inputEl.addEventListener('input', function () {
        invalidateExport();
        tbodyEl.innerHTML = '';
        resultEl.style.display = 'none';
        setStatus('', '');
      });
      invalidateExport();

      /* Auto-parse on load if content is pre-filled (e.g. from persistence) */
      if (inputEl.value.trim()) {
        parseBtn.click();
      }
    })();
  </script>
</div>

<style>
  .efp-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  .efp-input-section { display: flex; flex-direction: column; gap: 0.4rem; }

  .efp-input-section label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  #efp-input {
    width: 100%;
    min-height: 180px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    resize: vertical;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    line-height: 1.5;
  }

  #efp-input:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .efp-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .efp-status { font-size: 0.85rem; min-height: 1.2rem; }
  .efp-status.success { color: #057a55; }
  .efp-status.warn    { color: #b45309; }
  .efp-status.error   { color: #c0392b; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .efp-status.success { color: #34d399; }
    :root:not([data-theme="light"]) .efp-status.warn    { color: #fbbf24; }
    :root:not([data-theme="light"]) .efp-status.error   { color: #f87171; }
  }
  [data-theme="dark"] .efp-status.success { color: #34d399; }
  [data-theme="dark"] .efp-status.warn    { color: #fbbf24; }
  [data-theme="dark"] .efp-status.error   { color: #f87171; }

  .efp-result { margin-top: 0.25rem; }

  .efp-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .efp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.83rem;
  }

  .efp-table th {
    text-align: left;
    padding: 0.5rem 0.75rem;
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    font-weight: 600;
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .efp-table th:first-child { width: 2.5rem; }

  .efp-table td {
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  .efp-table tr:last-child td { border-bottom: none; }

  .efp-table tr:hover td { background: var(--color-bg-secondary); }

  .efp-row-error td { background: rgba(192, 57, 43, 0.05); }
  .efp-row-warn  td { background: rgba(180, 83, 9,  0.05); }

  [data-theme="dark"] .efp-row-error td { background: rgba(248, 113, 113, 0.08); }
  [data-theme="dark"] .efp-row-warn  td { background: rgba(251, 191, 36,  0.08); }

  .efp-key { color: var(--color-primary); }
  .efp-val { color: var(--color-text); }
  .efp-raw { font-family: var(--font-mono); }

  code { font-family: var(--font-mono); font-size: 0.82rem; }

  .efp-note { font-size: 0.78rem; white-space: nowrap; }
  .efp-note.warn  { color: #b45309; }
  .efp-note.error { color: #c0392b; }

  [data-theme="dark"] .efp-note.warn  { color: #fbbf24; }
  [data-theme="dark"] .efp-note.error { color: #f87171; }
</style>
