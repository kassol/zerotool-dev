---
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  en: {
    results: "Parsed entries",
    emptyResult: "Parsed keys, values and notes will appear here.",
    privacyNote: "Values stay in plain text in the table and env.json. Check for secrets before sharing your screen or the download.",
    tips: {
      input: "Paste KEY=VALUE or KEY: value with a space after the colon. Quoted values may span lines; variable references are not expanded. Parsing follows dotenv 16.6.1.",
      parse: "Click Parse to inspect the current text. Editing the input hides the old table and disables Export JSON until you parse again.",
      clear: "Clear removes the input, table and status, and disables Export JSON. Ctrl or Command + L does the same while focus is inside this tool.",
      results: "Notes flag empty values, duplicate keys and non-standard names. Warnings can still be exported; error rows are excluded. Comment lines do not appear in the table.",
      download: "Download the parsed keys as env.json. Export requires at least one valid or warning entry. Duplicate keys use the last value; comments and error rows are excluded.",
    },
    envContent: '.env Content', clear: 'Clear', parse: 'Parse', exportJson: 'Export JSON', colKey: 'Key', colValue: 'Value', colNotes: 'Notes', pastePrompt: 'Paste .env content and click Parse.', parseFirst: 'Parse a .env file first.', exported: 'Exported {n} key{s} to env.json.', stValid: '{n} valid', stWarn: '{n} warning', stWarns: '{n} warnings', stErr: '{n} error', stErrs: '{n} errors', stSep: ', ', stEnd: '.', notes: { missingEq: 'Missing = sign', emptyKey: 'Empty key', multiline: 'Multiline value (lines {from}-{to})', unclosed: 'Unclosed quote', afterQuote: 'Text after closing quote', hashComment: 'Text after # is a comment; quote the value to keep it', nonStandard: 'Non-standard key name', colonForm: 'Use KEY=value, or KEY: value with a space after the colon and none before it', fullwidthSep: 'Full-width ＝ and ： are not separators; use = or : with a space after it', emptyValue: 'Empty value', duplicate: 'Duplicate key' } },
  zh: {
    results: "解析结果",
    emptyResult: "解析后的键、值和备注将显示在这里。",
    privacyNote: "表格和 env.json 都会保留明文值。共享屏幕或下载文件前，请检查其中的密钥。",
    tips: {
      input: "粘贴 KEY=VALUE，或冒号后带空格的 KEY: value。带引号的值可以跨行；变量引用不会展开。解析遵循 dotenv 16.6.1 的规则。",
      parse: "点击解析检查当前文本。编辑输入会隐藏旧表格并停用导出 JSON，直到再次解析。",
      clear: "清除会移除输入、表格和状态，并停用导出 JSON。焦点在本工具内时，Ctrl 或 Command + L 执行相同操作。",
      results: "备注标出空值、重复键和不常见的键名。带警告的条目仍可导出，错误行不会导出。注释行不显示在表格中。",
      download: "将解析后的键下载为 env.json。至少有一条有效或警告条目时才能导出。重复键取最后一个值，注释行和错误行不导出。",
    },
    envContent: '.env 内容', clear: '清除', parse: '解析', exportJson: '导出 JSON', colKey: '键', colValue: '值', colNotes: '备注', pastePrompt: '请粘贴 .env 内容后点击解析。', parseFirst: '请先解析一个 .env 文件。', exported: '已将 {n} 个键导出到 env.json。', stValid: '有效 {n} 个', stWarn: '警告 {n} 个', stWarns: '警告 {n} 个', stErr: '错误 {n} 个', stErrs: '错误 {n} 个', stSep: '，', stEnd: '。', notes: { missingEq: '缺少 = 号', emptyKey: '键为空', multiline: '多行值（第 {from}–{to} 行）', unclosed: '引号未闭合', afterQuote: '闭合引号后还有文字', hashComment: '# 之后的文字是注释；要保留请给值加引号', nonStandard: '键名不符合常见规则', colonForm: '应写成 KEY=value，或 KEY: value（冒号后有空格，前面没有空格）', fullwidthSep: '全角的 ＝ 和 ： 不是分隔符，请改成半角 =，或半角冒号加空格', emptyValue: '值为空', duplicate: '键重复' } },
  ja: {
    results: "解析結果",
    emptyResult: "解析したキー、値、備考がここに表示されます。",
    privacyNote: "テーブルと env.json には値が平文で残ります。画面やダウンロードしたファイルを共有する前に、シークレットを確認してください。",
    tips: {
      input: "KEY=VALUE、またはコロンの後に空白を入れた KEY: value を貼り付けます。引用符付きの値は複数行に対応します。変数参照は展開せず、dotenv 16.6.1 の規則で解析します。",
      parse: "解析をクリックすると現在のテキストを確認できます。入力を編集すると古いテーブルが隠れ、再解析するまで JSON エクスポートが無効になります。",
      clear: "クリアは入力、テーブル、状態を消去し、JSON エクスポートを無効にします。ツール内にフォーカスがある場合、Ctrl または Command + L でも同じ操作ができます。",
      results: "備考には空の値、重複キー、一般的でないキー名を表示します。警告のある項目もエクスポートできますが、エラー行は除外します。コメント行はテーブルに表示しません。",
      download: "解析したキーを env.json としてダウンロードします。有効または警告の項目が1件以上必要です。重複キーは最後の値を使い、コメント行とエラー行は除外します。",
    },
    envContent: '.env の内容', clear: 'クリア', parse: '解析', exportJson: 'JSON エクスポート', colKey: 'キー', colValue: '値', colNotes: '備考', pastePrompt: '.env の内容を貼り付けて解析をクリックしてください。', parseFirst: '先に .env ファイルを解析してください。', exported: '{n} 件のキーを env.json にエクスポートしました。', stValid: '有効 {n} 件', stWarn: '警告 {n} 件', stWarns: '警告 {n} 件', stErr: 'エラー {n} 件', stErrs: 'エラー {n} 件', stSep: '、', stEnd: '。', notes: { missingEq: '= がありません', emptyKey: 'キーが空です', multiline: '複数行の値（{from}〜{to} 行目）', unclosed: '引用符が閉じていません', afterQuote: '閉じ引用符の後に文字があります', hashComment: '# 以降はコメントです。残すには値を引用符で囲んでください', nonStandard: '一般的でないキー名', colonForm: 'KEY=value、または KEY: value（コロンの後に空白、前には空白なし）と書いてください', fullwidthSep: '全角の ＝ と ： は区切りになりません。半角の =、または半角コロンと空白にしてください', emptyValue: '値が空です', duplicate: 'キーが重複しています' } },
  ko: {
    results: "파싱 결과",
    emptyResult: "파싱한 키, 값, 메모가 여기에 표시됩니다.",
    privacyNote: "테이블과 env.json에는 값이 평문으로 남습니다. 화면이나 내려받은 파일을 공유하기 전에 비밀 값을 확인하세요.",
    tips: {
      input: "KEY=VALUE 또는 콜론 뒤에 공백을 둔 KEY: value를 붙여넣으세요. 따옴표로 감싼 값은 여러 줄에 걸칠 수 있습니다. 변수 참조는 확장하지 않으며 dotenv 16.6.1 규칙으로 파싱합니다.",
      parse: "파싱을 클릭해 현재 텍스트를 확인하세요. 입력을 편집하면 이전 테이블이 숨겨지고 다시 파싱할 때까지 JSON 내보내기가 비활성화됩니다.",
      clear: "지우기는 입력, 테이블, 상태를 비우고 JSON 내보내기를 비활성화합니다. 도구 안에 포커스가 있을 때 Ctrl 또는 Command + L도 같은 동작을 수행합니다.",
      results: "메모는 빈 값, 중복 키, 일반적이지 않은 키 이름을 표시합니다. 경고가 있는 항목도 내보낼 수 있지만 오류 줄은 제외됩니다. 주석 줄은 테이블에 표시하지 않습니다.",
      download: "파싱한 키를 env.json으로 내려받습니다. 유효 또는 경고 항목이 하나 이상 필요합니다. 중복 키는 마지막 값을 사용하며 주석과 오류 줄은 제외합니다.",
    },
    envContent: '.env 내용', clear: '지우기', parse: '파싱', exportJson: 'JSON 내보내기', colKey: '키', colValue: '값', colNotes: '메모', pastePrompt: '.env 내용을 붙여넣고 파싱을 클릭하세요.', parseFirst: '먼저 .env 파일을 파싱하세요.', exported: '{n}개의 키를 env.json으로 내보냈습니다.', stValid: '유효 {n}개', stWarn: '경고 {n}개', stWarns: '경고 {n}개', stErr: '오류 {n}개', stErrs: '오류 {n}개', stSep: ', ', stEnd: '.', notes: { missingEq: '= 기호가 없습니다', emptyKey: '키가 비어 있습니다', multiline: '여러 줄 값({from}~{to}행)', unclosed: '따옴표가 닫히지 않았습니다', afterQuote: '닫는 따옴표 뒤에 문자가 있습니다', hashComment: '# 뒤는 주석입니다. 남기려면 값을 따옴표로 감싸세요', nonStandard: '일반적이지 않은 키 이름', colonForm: 'KEY=value 또는 KEY: value(콜론 뒤에 공백, 앞에는 공백 없음)로 쓰세요', fullwidthSep: '전각 ＝와 ：는 구분자가 아닙니다. 반각 = 또는 반각 콜론과 공백으로 바꾸세요', emptyValue: '값이 비어 있습니다', duplicate: '중복된 키' } }
} as const;
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="efp-wrap">
  <div class="efp-actions">
    <span class="efp-control">
      <button id="efp-parse" class="btn-primary" type="button">{T.parse}</button>
      <Toggletip id="efp-tip-parse" lang={lang} about={T.parse}>{TIPS.parse}</Toggletip>
    </span>
    <span class="efp-control">
      <button id="efp-clear" class="btn-ghost" type="button">{T.clear}</button>
      <Toggletip id="efp-tip-clear" lang={lang} about={T.clear}>{TIPS.clear}</Toggletip>
    </span>
    <span class="efp-control">
      <button id="efp-export-json" class="btn-ghost" type="button">{T.exportJson}</button>
      <Toggletip id="efp-tip-export" lang={lang} about={T.exportJson}>{TIPS.download}</Toggletip>
    </span>
  </div>
  <div id="efp-status" class="efp-status" aria-live="polite"></div>
  <div class="efp-input-section">
    <div class="efp-label-row">
      <label for="efp-input" class="tool-label">{T.envContent}</label>
      <Toggletip id="efp-tip-input" lang={lang} about={T.envContent}>{TIPS.input}</Toggletip>
    </div>
    <textarea id="efp-input" class="tool-textarea"
      placeholder={"# Comment\nDB_HOST=localhost\nDB_PORT=5432\nDB_NAME=myapp\nAPI_KEY=\"secret-key\"\nDEBUG="}
      spellcheck="false"></textarea>
  </div>
  <p class="efp-empty">{T.emptyResult}</p>
  <div id="efp-result" class="efp-result" hidden>
    <div class="efp-label-row">
      <span id="efp-results-label" class="tool-label">{T.results}</span>
      <Toggletip id="efp-tip-results" lang={lang} about={T.results}>{TIPS.results}</Toggletip>
    </div>
    <div id="efp-scroll" class="efp-table-wrap" tabindex="0" aria-labelledby="efp-results-label">
      <table class="efp-table" id="efp-table">
        <thead><tr><th>#</th><th>{T.colKey}</th><th>{T.colValue}</th><th>{T.colNotes}</th></tr></thead>
        <tbody id="efp-tbody"></tbody>
      </table>
    </div>
  </div>
  <p class="efp-privacy">{T.privacyNote}</p>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var inputEl = document.getElementById('efp-input');
      var statusEl = document.getElementById('efp-status');
      var resultEl = document.getElementById('efp-result');
      var tbodyEl = document.getElementById('efp-tbody');
      var parseBtn = document.getElementById('efp-parse');
      var exportBtn = document.getElementById('efp-export-json');
      var clearBtn = document.getElementById('efp-clear');

      var lastParsed = [];

      function setStatus(msg, type) {
        statusEl.textContent = msg;
        statusEl.className = 'efp-status ' + (type || '');
      }

      /* ── engine:start ── */
      // Parsing follows dotenv (https://github.com/motdotla/dotenv#what-rules-does-the-parsing-engine-follow,
      // LINE regex in lib/main.js): optional `export `, `#` starts a comment unless the value is
      // quoted, quoted values may span lines, only double quotes expand \n and \r.
      var NOTES_EN = { missingEq: 'Missing = sign', emptyKey: 'Empty key', multiline: 'Multiline value (lines {from}-{to})', unclosed: 'Unclosed quote', afterQuote: 'Text after closing quote', hashComment: 'Text after # is a comment; quote the value to keep it', nonStandard: 'Non-standard key name', colonForm: 'Use KEY=value, or KEY: value with a space after the colon and none before it', fullwidthSep: 'Full-width ＝ and ： are not separators; use = or : with a space after it', emptyValue: 'Empty value', duplicate: 'Duplicate key' };
      // dotenv 16.6.1 LINE, with the leading whitespace/export captured for line numbers.
      var LINE_RE = /(?:^|^)(\s*(?:export\s+)?)([\w.-]+)(?:\s*=\s*?|:\s+?)(\s*'(?:\\'|[^'])*'|\s*"(?:\\"|[^"])*"|\s*`(?:\\`|[^`])*`|[^#\r\n]+)?\s*(?:#.*)?(?:$|$)/mg;

      function finishValue(raw) {
        var value = raw.trim();
        var maybeQuote = value[0];
        value = value.replace(/^(['"`])([\s\S]*)\1$/mg, '$2');
        if (maybeQuote === '"') {
          value = value.replace(/\\n/g, '\n').replace(/\\r/g, '\r');
        }
        return value;
      }

      // msg: note texts in the page language (STRINGS[lang].notes); English when omitted
      function parseEnv(text, msg) {
        var M = msg || NOTES_EN;
        text = text.replace(/\r\n?/g, '\n');
        var lines = text.split('\n');
        var entries = [];
        var seenKeys = Object.create(null);

        var matched = Object.create(null);
        var covered = Object.create(null);
        LINE_RE.lastIndex = 0;
        var match;
        while ((match = LINE_RE.exec(text)) !== null) {
          var keyPos = match.index + match[1].length;
          var firstLine = text.slice(0, keyPos).split('\n').length - 1;
          // Only the value spans continuation lines; a later standalone comment stays a row.
          var rawMatchedValue = match[3] || '';
          var valuePos = text.indexOf(rawMatchedValue, keyPos + match[2].length);
          var endPos = rawMatchedValue.trimEnd() ? valuePos + rawMatchedValue.trimEnd().length : keyPos;
          var lastLine = text.slice(0, endPos).split('\n').length - 1;
          matched[firstLine] = { key: match[2], rawValue: match[3] || '', lastLine: lastLine };
          for (var c = firstLine + 1; c <= lastLine; c++) covered[c] = true;
        }

        for (var i = 0; i < lines.length; i++) {
          if (covered[i]) continue;
          var raw = lines[i];
          var lineNo = i + 1;
          var trimmed = raw.trim();

          if (trimmed === '') continue;
          if (trimmed.startsWith('#')) {
            entries.push({ lineNo: lineNo, type: 'comment', raw: trimmed });
            continue;
          }

          var item = matched[i];
          if (!item) {
            // dotenv skips this line. Name the cause: no separator, the key, or the `: ` form.
            var sep = raw.search(/[=:]/);
            var candidate = sep === -1 ? '' : raw.slice(0, sep).replace(/^\s*(?:export\s+)?/, '').trim();
            var wide = raw.search(/[＝：]/);
            var reason = /^\s*=/.test(raw) ? M.emptyKey : wide !== -1 && (sep === -1 || wide < sep) ? M.fullwidthSep : sep === -1 ? M.missingEq :
              raw[sep] === ':' && /^[\w.-]+$/.test(candidate) ? M.colonForm : M.nonStandard;
            entries.push({ lineNo: lineNo, type: 'error', raw: trimmed, error: reason });
            continue;
          }

          var key = item.key;
          var notes = [];
          var rawValue = item.rawValue.trim();
          var value = finishValue(item.rawValue);
          if (item.lastLine > i) {
            notes.push(M.multiline.replace('{from}', lineNo).replace('{to}', item.lastLine + 1));
          }
          var first = rawValue[0];
          var quoted = (first === '"' || first === "'" || first === '`') && rawValue.endsWith(first) && rawValue.length > 1;
          if (!quoted && (first === '"' || first === "'" || first === '`')) {
            notes.push(rawValue.indexOf(first, 1) === -1 ? M.unclosed : M.afterQuote);
          } else if (!quoted) {
            var rest = raw.slice(raw.search(/[=:]/) + 1);
            var hashIdx = rest.indexOf('#');
            if (hashIdx !== -1 && (hashIdx === 0 || !/\s/.test(rest[hashIdx - 1]))) notes.push(M.hashComment);
          }

          if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) {
            notes.push(M.nonStandard);
          }
          if (value === '') {
            notes.push(M.emptyValue);
          }
          if (seenKeys[key]) {
            notes.push(M.duplicate);
          } else {
            seenKeys[key] = true;
          }

          entries.push({
            lineNo: lineNo,
            type: notes.length > 0 ? 'warn' : 'ok',
            key: key,
            value: value,
            notes: notes
          });
        }

        return entries;
      }
      /* ── engine:end ── */

      function escapeHtml(str) {
        return str
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function render(entries) {
        tbodyEl.innerHTML = '';
        var validCount = 0;
        var errorCount = 0;
        var warnCount = 0;

        for (var i = 0; i < entries.length; i++) {
          var e = entries[i];
          if (e.type === 'comment') continue;

          var tr = document.createElement('tr');
          tr.className = 'efp-row-' + e.type;

          if (e.type === 'error') {
            errorCount++;
            tr.innerHTML =
              '<td>' + e.lineNo + '</td>' +
              '<td colspan="2" class="efp-raw"><code>' + escapeHtml(e.raw) + '</code></td>' +
              '<td class="efp-note error">' + escapeHtml(e.error) + '</td>';
          } else {
            if (e.notes && e.notes.length > 0) warnCount++;
            else validCount++;
            tr.innerHTML =
              '<td>' + e.lineNo + '</td>' +
              '<td><code class="efp-key">' + escapeHtml(e.key) + '</code></td>' +
              '<td><code class="efp-val">' + escapeHtml(e.value) + '</code></td>' +
              '<td class="efp-note ' + (e.notes && e.notes.length ? 'warn' : '') + '">' +
              (e.notes && e.notes.length ? escapeHtml(e.notes.join(t.stSep)) : '') + '</td>';
          }

          tbodyEl.appendChild(tr);
        }

        return { validCount: validCount, errorCount: errorCount, warnCount: warnCount };
      }

      parseBtn.addEventListener('click', function () {
        invalidateExport();
        var text = inputEl.value;
        if (!text.trim()) {
          setStatus(t.pastePrompt, '');
          resultEl.hidden = true;
          return;
        }

        lastParsed = parseEnv(text, t.notes);
        exportBtn.disabled = !lastParsed.some(function (e) { return e.type === 'ok' || e.type === 'warn'; });
        var counts = render(lastParsed);

        resultEl.hidden = false;

        var parts = [];
        parts.push(t.stValid.replace('{n}', counts.validCount));
        if (counts.warnCount > 0) parts.push((counts.warnCount === 1 ? t.stWarn : t.stWarns).replace('{n}', counts.warnCount));
        if (counts.errorCount > 0) parts.push((counts.errorCount === 1 ? t.stErr : t.stErrs).replace('{n}', counts.errorCount));

        var type = counts.errorCount > 0 ? 'error' : counts.warnCount > 0 ? 'warn' : 'success';
        setStatus(parts.join(t.stSep) + t.stEnd, type);

        window.trackTool && window.trackTool('env-file-parser', 'parse');
      });

      exportBtn.addEventListener('click', function () {
        if (exportBtn.disabled) return;
        var validEntries = lastParsed.filter(function (e) {
          return e.type === 'ok' || e.type === 'warn';
        });
        if (validEntries.length === 0) {
          setStatus(t.parseFirst, 'error');
          return;
        }

        // Null prototype: a key named __proto__ becomes a normal property instead of being dropped
        var obj = Object.create(null);
        for (var i = 0; i < validEntries.length; i++) {
          obj[validEntries[i].key] = validEntries[i].value;
        }
        var keyCount = Object.keys(obj).length;

        var json = JSON.stringify(obj, null, 2);
        var blob = new Blob([json], { type: 'application/json' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'env.json';
        a.click();
        URL.revokeObjectURL(url);
        var msg = t.exported.replace('{n}', keyCount).replace('{s}', keyCount !== 1 ? 's' : '');
        setStatus(msg, 'success');
        window.trackTool && window.trackTool('env-file-parser', 'export_json');
      });

      clearBtn.addEventListener('click', function () {
        inputEl.value = '';
        tbodyEl.innerHTML = '';
        resultEl.hidden = true;
        setStatus('', '');
        invalidateExport();
      });

      function invalidateExport() {
        lastParsed = [];
        exportBtn.disabled = true;
      }
      function resetResult() {
        invalidateExport();
        tbodyEl.innerHTML = '';
        resultEl.hidden = true;
        setStatus('', '');
      }
      inputEl.addEventListener('input', resetResult);
      // ToolLayout's Ctrl/Cmd+L empties the textarea without an input event.
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && document.querySelector('.efp-wrap').contains(document.activeElement)) {
          inputEl.focus();
          setTimeout(function () { if (!inputEl.value) resetResult(); }, 0);
        }
      });
      invalidateExport();

