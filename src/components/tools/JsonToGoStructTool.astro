      function convert() {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = null;
        var raw = inputEl.value.trim();
        if (!raw) { inputEl.classList.remove('error'); clearStatus(); setOutput(''); return; }
        inputEl.classList.remove('error');

        var parsed;
        try {
          parsed = parseJson(raw);
        } catch (e) {
          inputEl.classList.add('error');
          setOutput('');
          setStatus(jsonErrorText(inputEl.value, e), true);
          return;
        }

        inputEl.classList.remove('error');
        var rootName = rootNameEl.value.trim() || 'RootObject';
        var result = generateGo(parsed, rootName);
        setOutput(result.code);
        if (result.count === 0) setStatus(MSG_GENERATED, false);
        else setStatus(result.count === 1 ? MSG_GEN_ONE : MSG_GEN_MANY.replace('{n}', result.count), false);
      }

      /* Analytics: one event per committed change (input change, Generate, Example), not on load or per typing pause.
         One action can fire both change (blur on mousedown) and click, so the same JSON and root name are sent once. */
      var lastTracked = null;
      function trackChange() {
        if (!outputCodeEl.textContent) return;
        var key = inputEl.value + '\u0000' + (rootNameEl.value.trim() || 'RootObject');
        if (key === lastTracked) return;
        lastTracked = key;
        window.trackTool && window.trackTool('json-to-go-struct', 'generate');
      }

      var _liveTimer = null;
      inputEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = setTimeout(convert, 300);
      });
      inputEl.addEventListener('change', function () {
        convert();
        trackChange();
      });

      document.getElementById('jgs-convert').addEventListener('click', function () {
        convert();
        trackChange();
      });

      document.getElementById('jgs-example').addEventListener('click', function () {
        inputEl.value = EXAMPLE;
        inputEl.classList.remove('error');
        clearStatus();
        convert();
        trackChange();
      });

      document.getElementById('jgs-clear').addEventListener('click', function () {
        invalidateCopy();
        lastTracked = null;
        clearTimeout(_liveTimer);
        _liveTimer = null;
        inputEl.value = '';
        setOutput('');
        inputEl.classList.remove('error');
        clearStatus();
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l' || !wrap.contains(document.activeElement)) return;
        e.preventDefault();
        inputEl.focus();
        document.getElementById('jgs-clear').click();
      });

      copyBtn.addEventListener('click', function () {
        var text = outputCodeEl.textContent;
        if (!text) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(COPY_FAILED, true);
          copyFailure = true;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            if (copyFailure) clearStatus();
            copyBtn.textContent = COPIED;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = COPY;
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });
    })();
  </script>
</div>

<style>
  .jgs-wrap { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; gap: 0.75rem; }
  .jgs-config { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .jgs-name-field { display: flex; flex-direction: column; gap: 0.25rem; width: 18rem; max-width: 100%; }
  .jgs-control-label { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .jgs-config label { font-size: 0.85rem; color: var(--color-text-secondary); display: flex; align-items: center; gap: 0.4rem; }
  .jgs-name-field input {
    min-height: 44px; width: 100%; padding: 0.4rem 0.6rem; font-size: 0.85rem;
    font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg); color: var(--color-text);
  }
  .jgs-name-field input:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jgs-panel-header { display: flex; justify-content: space-between; align-items: center; min-height: 44px; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .jgs-panel textarea, .jgs-output {
    width: 100%; min-width: 0; font-family: var(--font-mono); font-size: 0.82rem; padding: 0.75rem;
    border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg-secondary); color: var(--color-text); line-height: 1.5;
  }
  .jgs-panel textarea { transition: border-color 0.15s; }
  .jgs-panel textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }
  .jgs-panel textarea.error { border-color: #c0392b; }
  .jgs-output { margin: 0; overflow: auto; white-space: pre; }
  .jgs-output:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jgs-empty { display: none; margin: 0; padding: 2rem; align-items: center; justify-content: center; text-align: center; color: var(--color-text-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .jgs-output-pane:has(#jgs-output-code:empty) .jgs-output { display: none; }
  .jgs-output-pane:has(#jgs-output-code:empty) .jgs-empty { display: flex; }
  .jgs-actions { display: flex; gap: 0.5rem 1rem; flex-wrap: wrap; }
  .jgs-status { font-size: 0.85rem; line-height: 1.4; height: 2.8rem; flex: none; overflow: auto; overflow-wrap: anywhere; }
  .jgs-status.success { color: #057a55; }
  .jgs-status.error { color: #c0392b; }
  .jgs-actions button, .jgs-panel-header button { min-height: 44px; }
  .jgs-panel-header button:disabled { opacity: 0.5; cursor: not-allowed; }
  .jgs-output-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 860px) {
    .jgs-wrap { gap: 0.5rem; }
    .jgs-name-field { width: 100%; flex-direction: row; align-items: center; gap: 0.5rem; }
    .jgs-name-field .jgs-control-label { flex: 1; }
    .jgs-name-field input { width: 45%; flex: none; }
    .jgs-actions button, .jgs-panel-header button { min-height: 44px; }
    .jgs-panel textarea { height: 144px; min-height: 144px; }
    .jgs-output { height: 22rem; min-height: 160px; resize: none; }
    .jgs-output-pane:has(#jgs-output-code:empty) { display: none; }
  }
  @media (max-width: 640px) {
    .jgs-status { height: 3.6rem; }
    .jgs-panel-header { flex-wrap: wrap; }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .jgs-status.success { color: #34d399; }
    :global(:root:not([data-theme="light"])) .jgs-status.error { color: #f87171; }
    :global(:root:not([data-theme="light"])) .jgs-panel textarea.error { border-color: #f87171; }
  }
  :global([data-theme="dark"]) .jgs-status.success { color: #34d399; }
  :global([data-theme="dark"]) .jgs-status.error { color: #f87171; }
  :global([data-theme="dark"]) .jgs-panel textarea.error { border-color: #f87171; }
</style>
