---
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const labels = {
  en: {
    rootName: 'Root struct name',
    jsonInput: 'JSON Input',
    goOutput: 'Go Output',
    example: 'Example',
    clear: 'Clear',
    copy: 'Copy',
    copied: 'Copied!',
    generate: 'Generate Go Struct',
    msgInvalidJson: 'Invalid JSON: ',
    msgGenerated: 'Generated.',
    msgGenOne: 'Generated 1 struct.',
    msgGenMany: 'Generated {n} structs.',
  },
  zh: {
    rootName: '根结构体名称',
    jsonInput: 'JSON 输入',
    goOutput: 'Go 输出',
    example: '示例',
    clear: '清空',
    copy: '复制',
    copied: '已复制！',
    generate: '生成 Go Struct',
    msgInvalidJson: 'JSON 格式错误：',
    msgGenerated: '已生成。',
    msgGenOne: '已生成 1 个 struct。',
    msgGenMany: '已生成 {n} 个 struct。',
  },
  ja: {
    rootName: 'ルート構造体名',
    jsonInput: 'JSON 入力',
    goOutput: 'Go 出力',
    example: 'サンプル',
    clear: 'クリア',
    copy: 'コピー',
    copied: 'コピーしました！',
    generate: 'Go Struct を生成',
    msgInvalidJson: '無効なJSON：',
    msgGenerated: '生成しました。',
    msgGenOne: '1 個の構造体を生成しました。',
    msgGenMany: '{n} 個の構造体を生成しました。',
  },
  ko: {
    rootName: '루트 구조체 이름',
    jsonInput: 'JSON 입력',
    goOutput: 'Go 출력',
    example: '예시',
    clear: '지우기',
    copy: '복사',
    copied: '복사됨!',
    generate: 'Go Struct 생성',
    msgInvalidJson: '잘못된 JSON: ',
    msgGenerated: '생성 완료.',
    msgGenOne: '구조체 1개를 생성했습니다.',
    msgGenMany: '구조체 {n}개를 생성했습니다.',
  },
};

const L = labels[lang];
---

<div
  class="jgs-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-msg-invalid-json={L.msgInvalidJson}
  data-msg-generated={L.msgGenerated}
  data-msg-gen-one={L.msgGenOne}
  data-msg-gen-many={L.msgGenMany}
>
  <div class="jgs-config">
    <div class="jgs-config-row">
      <label for="jgs-root-name">{L.rootName}</label>
      <input id="jgs-root-name" type="text" value="RootObject" spellcheck="false" />
    </div>
  </div>

  <div class="jgs-panels">
    <div class="jgs-panel">
      <div class="jgs-panel-header">
        <span>{L.jsonInput}</span>
        <div class="jgs-panel-actions">
          <button id="jgs-example" class="btn-ghost btn-sm" type="button">{L.example}</button>
          <button id="jgs-clear" class="btn-ghost btn-sm" type="button">{L.clear}</button>
        </div>
      </div>
      <textarea
        id="jgs-input"
        placeholder='{"name": "Alice", "age": 30}'
        spellcheck="false"
      ></textarea>
    </div>

    <div class="jgs-panel">
      <div class="jgs-panel-header">
        <span>{L.goOutput}</span>
        <button id="jgs-copy" class="btn-ghost btn-sm" type="button">{L.copy}</button>
      </div>
      <pre id="jgs-output" class="jgs-output"><code id="jgs-output-code"></code></pre>
    </div>
  </div>

  <div class="jgs-actions">
    <button id="jgs-convert" class="btn-primary" type="button">{L.generate}</button>
  </div>

  <div id="jgs-status" class="jgs-status" aria-live="polite"></div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.jgs-wrap')
        : document.querySelector('.jgs-wrap');

      var COPY = wrap ? wrap.dataset.copy : 'Copy';
      var COPIED = wrap ? wrap.dataset.copied : 'Copied!';
      var MSG_INVALID = wrap ? wrap.dataset.msgInvalidJson : 'Invalid JSON: ';
      var MSG_GENERATED = wrap ? wrap.dataset.msgGenerated : 'Generated.';
      var MSG_GEN_ONE = wrap ? wrap.dataset.msgGenOne : 'Generated 1 struct.';
      var MSG_GEN_MANY = wrap ? wrap.dataset.msgGenMany : 'Generated {n} structs.';

      var inputEl = document.getElementById('jgs-input');
      var outputCodeEl = document.getElementById('jgs-output-code');
      var statusEl = document.getElementById('jgs-status');
      var rootNameEl = document.getElementById('jgs-root-name');

      var EXAMPLE = JSON.stringify({
        id: 1,
        name: "Alice",
        isActive: true,
        score: 9.5,
        tags: ["go", "json"],
        address: {
          city: "London",
          zip: "EC1A 1BB"
        },
        friends: [
          { id: 2, name: "Bob" },
          { id: 3, name: "Carol" }
        ],
        metadata: null
      }, null, 2);

      function setStatus(msg, isError) {
        statusEl.textContent = msg;
        statusEl.className = 'jgs-status ' + (isError ? 'error' : 'success');
      }
      function clearStatus() {
        statusEl.textContent = '';
        statusEl.className = 'jgs-status';
      }

      /* ── engine:start ── */
      function hasOwn(o, k) { return Object.prototype.hasOwnProperty.call(o, k); }

      // JSON.parse turns 19.0 into 19, which looks like an integer. Where the browser passes the
      // source text to the reviver (JSON.parse source text access; Chrome 114+, Firefox 135+, Safari 18.4+),
      // a number written with "." or an exponent is kept as a JsonFloat so it maps to float64.
      function JsonFloat(value) { this.value = value; }
      function parseJson(raw) {
        return JSON.parse(raw, function (k, v, ctx) {
          if (typeof v === 'number' && ctx && typeof ctx.source === 'string' && /[.eE]/.test(ctx.source)) return new JsonFloat(v);
          return v;
        });
      }
      function isObject(v) {
        return v !== null && typeof v === 'object' && !Array.isArray(v) && !(v instanceof JsonFloat);
      }

      // Exported Go names must start with an upper-case letter; a name that does not after
      // conversion (2fa, 名前) gets an "X" prefix so encoding/json can see the field.
      function toPascalCase(str) {
        var name = String(str)
          .replace(/[^\p{L}\p{N}]+(.)/gu, function (_, ch) { return ch.toUpperCase(); })
          .replace(/[^\p{L}\p{N}]/gu, '')
          .replace(/^(.)/, function (_, ch) { return ch.toUpperCase(); });
        if (!/^\p{Lu}/u.test(name)) name = 'X' + name;
        return name;
      }

      // encoding/json ignores a tag name with characters outside this set and uses the Go field
      // name instead (isValidTag in encoding/json/encode.go); an empty tag name does the same.
      function validTagName(k) {
        if (k === '') return false;
        for (var i = 0; i < k.length; i++) {
          var c = k.charAt(i);
          if ('!#$%&()*+-./:;<=>?@[]^_{|}~ '.indexOf(c) >= 0) continue;
          if (!/[\p{L}\p{N}]/u.test(c)) return false;
        }
        return true;
      }

      // Declarations are kept in the order they are first reached (root first). A nested object
      // gets the PascalCase of its key; when that name is used by a struct with different fields,
      // the parent's name is put in front (b.meta → BMeta), then a number is added. An object with
      // the same fields as an earlier one of the same key reuses that struct. The root name is
      // reserved.
      function newState(rootName) {
        var reserved = {};
        reserved[rootName] = true;
        return { list: [], byName: Object.create(null), reserved: reserved };
      }
      function openSlot(state) {
        var slot = { name: null, base: null, sig: null, fields: null };
        state.list.push(slot);
        return slot;
      }
      function closeSlot(state, slot, base, parent, fields, fixedName) {
        var sig = fields.join('\n');
        if (fixedName) {
          slot.name = fixedName; slot.base = base; slot.sig = sig; slot.fields = fields;
          state.byName[fixedName] = slot;
          return fixedName;
        }
        for (var i = 0; i < state.list.length; i++) {
          var other = state.list[i];
          if (other !== slot && other.base === base && other.sig === sig) {
            state.list.splice(state.list.indexOf(slot), 1);
            return other.name;
          }
        }
        var candidates = [base];
        if (parent) candidates.push(parent + base);
        var name = null;
        for (var c = 0; c < candidates.length && !name; c++) {
          if (!state.byName[candidates[c]] && !state.reserved[candidates[c]]) name = candidates[c];
        }
        for (var n = 2; !name; n++) {
          if (!state.byName[base + n] && !state.reserved[base + n]) name = base + n;
        }
        slot.name = name; slot.base = base; slot.sig = sig; slot.fields = fields;
        state.byName[name] = slot;
        return name;
      }

      // Several element / value types: int and float64 together become float64; anything else
      // mixed becomes interface{}.
      function combineTypes(types) {
        if (types.length === 1) return types[0];
        var bare = types.map(function (t) { return t.replace(/^\*/, ''); });
        if (bare.every(function (t) { return t === 'int' || t === 'float64'; })) {
          return (types.some(function (t) { return t.charAt(0) === '*'; }) ? '*' : '') + 'float64';
        }
        return 'interface{}';
      }

      /* Infer Go type from a JS value. nullable=true wraps in pointer. */
      function inferGoType(value, key, parent, state, nullable) {
        if (value === null) return 'interface{}';
        if (value instanceof JsonFloat) return nullable ? '*float64' : 'float64';
        if (typeof value === 'boolean') return nullable ? '*bool' : 'bool';
        if (typeof value === 'number') {
          var base = Number.isInteger(value) ? 'int' : 'float64';
          return nullable ? '*' + base : base;
        }
        if (typeof value === 'string') return nullable ? '*string' : 'string';

        if (Array.isArray(value)) {
          if (value.length === 0) return '[]interface{}';
          var objectItems = [];
          var types = [];
          for (var i = 0; i < value.length; i++) {
            var item = value[i];
            if (isObject(item)) {
              objectItems.push(item);
            } else {
              var t = inferGoType(item, key + 'Item', parent, state, item === null);
              if (types.indexOf(t) === -1) types.push(t);
            }
          }
          if (objectItems.length > 0) {
            var itemName = mergeObjects(objectItems, toPascalCase(key) + 'Item', parent, state, null);
            if (types.indexOf(itemName) === -1) types.push(itemName);
          }
          return '[]' + combineTypes(types);
        }

        if (isObject(value)) {
          var structName = buildStruct(value, toPascalCase(key), parent, state, null);
          return nullable ? '*' + structName : structName;
        }

        return 'interface{}';
      }

      function fieldLines(entries) {
        // entries: [{ key, type, omitempty }]
        var used = Object.create(null);
        var lines = [];
        entries.forEach(function (e) {
          if (!validTagName(e.key)) {
            lines.push('\t// JSON key ' + JSON.stringify(e.key) + ' cannot be named in a struct tag');
            return;
          }
          var fieldName = toPascalCase(e.key);
          if (used[fieldName]) {
            var n = 2;
            while (used[fieldName + n]) n++;
            fieldName = fieldName + n;
          }
          used[fieldName] = true;
          lines.push('\t' + fieldName + ' ' + e.type + ' `json:"' + e.key + (e.omitempty ? ',omitempty' : '') + '"`');
        });
        return lines;
      }

      function buildStruct(obj, base, parent, state, fixedName) {
        var slot = openSlot(state);
        var context = fixedName || base;
        var entries = Object.keys(obj).map(function (k) {
          var v = obj[k];
          return { key: k, type: inferGoType(v, k, context, state, v === null), omitempty: false };
        });
        return closeSlot(state, slot, base, parent, fieldLines(entries), fixedName);
      }

      function mergeObjects(objects, base, parent, state, fixedName) {
        var slot = openSlot(state);
        var context = fixedName || base;
        var info = Object.create(null);
        var order = [];
        for (var i = 0; i < objects.length; i++) {
          var ks = Object.keys(objects[i]);
          for (var j = 0; j < ks.length; j++) {
            if (!(ks[j] in info)) { info[ks[j]] = { count: 0, hasNull: false }; order.push(ks[j]); }
            info[ks[j]].count++;
            if (objects[i][ks[j]] === null) info[ks[j]].hasNull = true;
          }
        }

        var entries = order.map(function (k) {
          var presentInAll = info[k].count === objects.length;
          var nullable = !presentInAll || info[k].hasNull;
          var types = [];
          var nested = [];
          for (var oi = 0; oi < objects.length; oi++) {
            if (!hasOwn(objects[oi], k)) continue;
            var v = objects[oi][k];
            if (isObject(v)) { nested.push(v); continue; }
            if (v === null && objects.some(function (o) { return hasOwn(o, k) && o[k] !== null; })) continue;
            var t = inferGoType(v, k, context, state, nullable);
            if (types.indexOf(t) === -1) types.push(t);
          }
          if (nested.length) {
            var nt = nested.length === 1
              ? buildStruct(nested[0], toPascalCase(k), context, state, null)
              : mergeObjects(nested, toPascalCase(k), context, state, null);
            nt = nullable ? '*' + nt : nt;
            if (types.indexOf(nt) === -1) types.push(nt);
          }
          var goType = combineTypes(types);
          // If not present in all, wrap in pointer if not already
          if (!presentInAll && goType.charAt(0) !== '*' && goType.slice(0, 2) !== '[]' && goType !== 'interface{}') {
            goType = '*' + goType;
          }
          return { key: k, type: goType, omitempty: !presentInAll };
        });
        return closeSlot(state, slot, base, parent, fieldLines(entries), fixedName);
      }

      function renderStructs(state) {
        var lines = [];
        state.list.forEach(function (slot) {
          lines.push('type ' + slot.name + ' struct {');
          for (var j = 0; j < slot.fields.length; j++) lines.push(slot.fields[j]);
          lines.push('}');
          lines.push('');
        });
        return lines.join('\n').trimEnd();
      }

      // Returns { code, count }; count is 0 when the root is not an object (a type alias).
      function generateGo(parsed, rootName) {
        var state = newState(rootName);
        if (isObject(parsed)) {
          buildStruct(parsed, rootName, '', state, rootName);
        } else if (Array.isArray(parsed) && parsed.some(isObject)) {
          mergeObjects(parsed.filter(isObject), rootName, '', state, rootName);
        } else {
          return { code: 'type ' + rootName + ' = ' + inferGoType(parsed, rootName, '', state, parsed === null), count: 0 };
        }
        return { code: renderStructs(state), count: state.list.length };
      }
      /* ── engine:end ── */

      function convert() {
        var raw = inputEl.value.trim();
        if (!raw) { clearStatus(); outputCodeEl.textContent = ''; return; }
        inputEl.classList.remove('error');

        var parsed;
        try {
          parsed = parseJson(raw);
        } catch (e) {
          inputEl.classList.add('error');
          outputCodeEl.textContent = '';
          setStatus(MSG_INVALID + e.message, true);
          return;
        }

        inputEl.classList.remove('error');
        var rootName = rootNameEl.value.trim() || 'RootObject';
        var result = generateGo(parsed, rootName);
        outputCodeEl.textContent = result.code;
        if (result.count === 0) setStatus(MSG_GENERATED, false);
        else setStatus(result.count === 1 ? MSG_GEN_ONE : MSG_GEN_MANY.replace('{n}', result.count), false);
        window.trackTool && window.trackTool('json-to-go-struct', 'generate');
      }

      var _liveTimer = null;
      inputEl.addEventListener('input', function () {
        clearTimeout(_liveTimer);
        _liveTimer = setTimeout(convert, 300);
      });

      document.getElementById('jgs-convert').addEventListener('click', convert);

      document.getElementById('jgs-example').addEventListener('click', function () {
        inputEl.value = EXAMPLE;
        inputEl.classList.remove('error');
        clearStatus();
        convert();
      });

      document.getElementById('jgs-clear').addEventListener('click', function () {
        inputEl.value = '';
        outputCodeEl.textContent = '';
        inputEl.classList.remove('error');
        clearStatus();
      });

      document.getElementById('jgs-copy').addEventListener('click', function () {
        var text = outputCodeEl.textContent;
        if (!text) return;
        var btn = document.getElementById('jgs-copy');
        navigator.clipboard.writeText(text).then(function () {
          btn.textContent = COPIED;
          setTimeout(function () { btn.textContent = COPY; }, 1500);
        });
      });
    })();
  </script>
</div>

<style>
  .jgs-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  .jgs-config {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .jgs-config-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .jgs-config-row label {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .jgs-config-row input[type="text"] {
    padding: 0.25rem 0.5rem;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    width: 160px;
  }

  .jgs-config-row input[type="text"]:focus { outline: none; border-color: var(--color-primary); }

  .jgs-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .jgs-panels { grid-template-columns: 1fr; }
  }

  .jgs-panel { display: flex; flex-direction: column; gap: 0.4rem; }

  .jgs-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .jgs-panel-actions { display: flex; gap: 0.3rem; }

  .jgs-panel textarea {
    width: 100%;
    min-height: 260px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    resize: vertical;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    line-height: 1.5;
    transition: border-color 0.15s;
  }

  .jgs-panel textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }
  .jgs-panel textarea.error { border-color: #c0392b; }

  .jgs-output {
    min-height: 260px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    line-height: 1.5;
    margin: 0;
    overflow: auto;
    white-space: pre;
  }

  .btn-sm { padding: 0.2rem 0.5rem; font-size: 0.78rem; }
  .jgs-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .jgs-status { font-size: 0.85rem; min-height: 1.2rem; }
  .jgs-status.success { color: #057a55; }
  .jgs-status.error { color: #c0392b; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .jgs-status.success { color: #34d399; }
    :root:not([data-theme="light"]) .jgs-status.error { color: #f87171; }
    :root:not([data-theme="light"]) .jgs-panel textarea.error { border-color: #f87171; }
  }
  [data-theme="dark"] .jgs-status.success { color: #34d399; }
  [data-theme="dark"] .jgs-status.error { color: #f87171; }
  [data-theme="dark"] .jgs-panel textarea.error { border-color: #f87171; }
</style>
