            properties: {
              method: { const: 'card' },
              last4: { type: 'string', pattern: '^[0-9]{4}$' },
              expires: { type: 'string', pattern: '^(0[1-9]|1[0-2])/[0-9]{2}$' },
            },
            additionalProperties: false,
          },
          bank: {
            type: 'object',
            required: ['method', 'iban'],
            properties: { method: { const: 'bank' }, iban: { type: 'string', minLength: 15 } },
            additionalProperties: false,
          },
        },
      }, null, 2),
      data: JSON.stringify({ orderId: 'ORD-004211', payment: { method: 'card', last4: '42', expires: '13/27' } }, null, 2),
    },
    yaml: {
      schema: [
        '$schema: https://json-schema.org/draft/2020-12/schema',
        'type: object',
        'allOf:',
        '  - $ref: "#/$defs/service"',
        'properties:',
