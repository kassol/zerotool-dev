        '',
      ].join('\n'),
      data: [
        'name: web',
        'port: 8080',
        'replicas: 0',
        'release: 2026-10-02',
        'replica: 3',
        '',
      ].join('\n'),
    },
  };
  EXAMPLES.userErrors.schema = EXAMPLES.user.schema;

  let libPromise: Promise<Lib> | null = null;
  function loadLib(): Promise<Lib> {
    if (!libPromise) {
      libPromise = Promise.all([
        import('ajv'),
        import('ajv/dist/2019'),
        import('ajv/dist/2020'),
        import('ajv-draft-04'),
        import('ajv-formats'),
        import('ajv/dist/refs/json-schema-draft-06.json'),
        import('js-yaml'),
      ]).then((m: any[]) => ({
        Ajv: m[0].default, Ajv2019: m[1].default, Ajv2020: m[2].default, AjvDraft04: m[3].default,
        addFormats: m[4].default, draft06Meta: m[5].default, yaml: m[6].default || m[6],
      }));
      libPromise.catch(() => { libPromise = null; });
    }
    return libPromise;
  }

  const prefs = (window as any).ztPersist?.load(SLUG) || {};
  if (typeof prefs.draft === 'string' && Array.prototype.some.call(draftSel.options, (o: HTMLOptionElement) => o.value === prefs.draft)) draftSel.value = prefs.draft;
  if (prefs.formats === false) formatsEl.checked = false;
  function savePrefs() { (window as any).ztPersist?.save(SLUG, { draft: draftSel.value, formats: formatsEl.checked }); }

  const cache: any = { key: null, built: null };
  let lastResult: any = null;
  let runId = 0;
  let trackTimer: ReturnType<typeof setTimeout> | null = null;

  function setStatus(text: string, kind: string) {
    statusEl.textContent = text;
    statusEl.className = 'jsv-status ' + kind;
  }
  function el(tag: string, cls?: string, text?: string): HTMLElement {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }
  function textareaFor(side: string): HTMLTextAreaElement { return side === 'schema' ? schemaEl : side === 'extras' ? extraEl : dataEl; }
  function jump(side: string, range: number[] | undefined) {
    if (!range) return;
    const ta = textareaFor(side);
    if (side === 'extras') extrasBox.open = true;
    ta.focus({ preventScroll: true });
    ta.setSelectionRange(range[0], range[1]);
    const before = ta.value.slice(0, range[0]);
    const line = before.split('\n').length - 1;
    const lh = parseFloat(getComputedStyle(ta).lineHeight) || 20;
    ta.scrollTop = Math.max(0, line * lh - ta.clientHeight / 3);
    const r = ta.getBoundingClientRect();
    if (r.top < 0 || r.top > window.innerHeight - 80) ta.scrollIntoView({ block: 'center' });
  }
  function locLink(side: string, label: string, range: number[] | undefined, cls: string) {
    if (!range) return el('span', cls, label);
    const b = el('button', cls + ' jsv-link', label) as HTMLButtonElement;
    b.type = 'button';
    b.addEventListener('click', () => jump(side, range));
    return b;
  }
  function schemaLink(it: any, schemaRanges: any) {
    const label = fmt(T.schemaAt, { path: it.schemaPath });
    const range = it.schemaPtr !== undefined ? schemaRanges[it.schemaPtr] : undefined;
    return locLink('schema', label, range, 'jsv-schema-path');
  }
  function renderItem(it: any, schemaRanges: any, nested: boolean): HTMLElement {
    const li = el('li', 'jsv-item');
    const line = el('div', 'jsv-item-line');
    if (nested) {
      const where = (it.path === '' ? T.root : it.path) + (it.line ? ' · ' + fmt(T.lineCol, { line: it.line, col: it.col }) : '');
      line.appendChild(locLink('data', where, it.range, 'jsv-path'));
    }
    line.appendChild(el('span', 'jsv-msg', it.message));
    if (it.via) line.appendChild(el('span', 'jsv-via', fmt(T.via, { kw: it.via })));
    li.appendChild(line);
    const meta = el('div', 'jsv-item-meta');
    if (it.value !== undefined) meta.appendChild(el('code', 'jsv-value', fmt(T.valueLabel, { value: it.value })));
    meta.appendChild(schemaLink(it, schemaRanges));
    li.appendChild(meta);
    if (it.branches && it.branches.length) {
      const closest = it.branches.filter((b: any) => b.index === it.closest)[0];
      const others = it.branches.filter((b: any) => b !== closest);
      if (closest) {
        li.appendChild(el('div', 'jsv-branch-title', fmt(T.closest, { n: closest.index + 1 })));
        const ul = el('ul', 'jsv-items jsv-nested');
        closest.items.forEach((x: any) => ul.appendChild(renderItem(x, schemaRanges, true)));
        li.appendChild(ul);
      }
      if (others.length) {
        const det = el('details', 'jsv-others') as HTMLDetailsElement;
        det.appendChild(el('summary', '', fmt(T.otherBranches, { n: others.length })));
        others.forEach((b: any) => {
          det.appendChild(el('div', 'jsv-branch-title', fmt(T.branch, { n: b.index + 1 })));
          const ul = el('ul', 'jsv-items jsv-nested');
          if (!b.items.length) ul.appendChild(el('li', 'jsv-item', T.branchNoErrors));
          b.items.forEach((x: any) => ul.appendChild(renderItem(x, schemaRanges, true)));
          det.appendChild(ul);
        });
        li.appendChild(det);
      }
    }
    return li;
  }
  function schemaRangesFor(res: any): Record<string, number[]> {
    const want: Record<string, number> = {};
    const walk = (it: any) => { if (it.schemaPtr !== undefined) want[it.schemaPtr] = 0; (it.branches || []).forEach((b: any) => b.items.forEach(walk)); };
    res.docs.forEach((d: any) => d.groups.forEach((g: any) => g.items.forEach(walk)));
    if (res.schemaFormat !== 'json' || !Object.keys(want).length) return {};
    let text = schemaEl.value, base = 0;
    if (text.charCodeAt(0) === 0xfeff) { text = text.slice(1); base = 1; }
    const sc = scanJson(text, want, null);
    const out: Record<string, number[]> = {};
    Object.keys(sc.spans).forEach((k) => { out[k] = [sc.spans[k][0] + base, sc.spans[k][1] + base]; });
    return out;
  }
  function renderNotices(list: any[]) {
    if (!list.length) return;
    const box = el('div', 'jsv-notices');
    box.appendChild(el('div', 'jsv-notices-title', T.noticesTitle));
    const ul = el('ul', 'jsv-notice-list');
    list.slice(0, 60).forEach((n: any) => {
      const li = el('li', 'jsv-notice');
      const text = noticeText(n, T);
      if (n.offset !== undefined) {
        const b = locLink(n.side === 'schema' ? 'schema' : 'data', text, [n.offset, n.offset + (n.len || 1)], 'jsv-notice-text');
        li.appendChild(b);
      } else li.textContent = text;
      ul.appendChild(li);
    });
    box.appendChild(ul);
    outEl.appendChild(box);
  }
  function render(res: any) {
    lastResult = res;
    outEl.textContent = '';
    for (const side of ['schema', 'data']) {
      const f = side === 'schema' ? res.schemaFormat : res.dataFormat;
      const badge = fmtBadges[side];
      const label = f === 'json' ? T.fmtJson : f === 'yaml' ? T.fmtYaml : f === 'jsonl' ? T.fmtJsonl : '';
      badge.textContent = label;
      badge.hidden = !label;
    }
    copyTextBtn.hidden = copyJsonBtn.hidden = true;
    if (res.state === 'empty') {
      setStatus(statusText(res, T), 'none');
      resultEl.hidden = !res.notices.length;
      renderNotices(res.notices);
      return;
    }
    if (res.state === 'schemaParse' || res.state === 'dataParse' || res.state === 'extrasParse') {
      setStatus(statusText(res, T), 'error');
      resultEl.hidden = false;
      const box = el('ul', 'jsv-items');
      const li = el('li', 'jsv-item');
      li.appendChild(locLink(res.side, parseErrorText(res.parseError, T), [res.parseError.offset, res.parseError.offset + 1], 'jsv-msg'));
      box.appendChild(li);
      outEl.appendChild(box);
      renderNotices(res.notices);
      return;
    }
    if (res.state === 'schemaInvalid' || res.state === 'schemaFail') {
      setStatus(statusText(res, T), 'error');
      resultEl.hidden = false;
      const box = el('ul', 'jsv-items');
      res.schemaErrors.forEach((e: any) => {
        const li = el('li', 'jsv-item');
        li.appendChild(locLink('schema', schemaErrorText(e, T), e.range, 'jsv-msg'));
        box.appendChild(li);
      });
      outEl.appendChild(box);
      if (res.schemaErrors.some((e: any) => e.code === 'missingRef')) extrasBox.open = true;
      renderNotices(res.notices);
      return;
    }
    const multi = res.docs.length > 1;
    setStatus(statusText(res, T), res.state === 'valid' ? 'success' : 'error');
    resultEl.hidden = res.state === 'valid' && !res.notices.length;
    copyTextBtn.hidden = copyJsonBtn.hidden = res.state === 'valid';
    const schemaRanges = schemaRangesFor(res);
    let shown = 0, hidden = 0;
    res.docs.forEach((doc: any) => {
      if (multi && doc.valid) return;
      if (multi) outEl.appendChild(el('div', 'jsv-doc-title', fmt(doc.line ? T.docLine : T.docLabel, { n: doc.index + 1, line: doc.line })));
      doc.groups.forEach((g: any) => {
        if (shown >= MAX_GROUPS) { hidden++; return; }
        shown++;
        const box = el('div', 'jsv-group');
        const head = el('div', 'jsv-group-head');
        const where = g.path === '' ? T.root : g.path;
        head.appendChild(locLink('data', where, g.range, 'jsv-path'));
        if (g.line) head.appendChild(el('span', 'jsv-line', fmt(T.lineCol, { line: g.line, col: g.col })));
        box.appendChild(head);
        const ul = el('ul', 'jsv-items');
        g.items.forEach((it: any) => {
          const li = renderItem(it, schemaRanges, false);
          if (it.range && it.keyPath) {
            const m = li.querySelector('.jsv-msg');
            if (m) { const b = locLink('data', m.textContent || '', it.range, 'jsv-msg'); m.replaceWith(b); }
          }
          ul.appendChild(li);
        });
        box.appendChild(ul);
        outEl.appendChild(box);
      });
    });
    if (hidden) outEl.appendChild(el('p', 'jsv-more', fmt(T.moreGroups, { n: hidden })));
    renderNotices(res.notices);
  }

  async function run(manual: boolean) {
    const id = ++runId;
    const size = schemaEl.value.length + dataEl.value.length + extraEl.value.length;
    if (!manual && size > AUTO_LIMIT) { setStatus(T.large, 'info'); return; }
    if (!schemaEl.value.trim() && !dataEl.value.trim() && !extraEl.value.trim()) {
      render({ state: 'empty', notices: [], docs: [] });
      return;
    }
    let lib: Lib;
    try {
      if (!libPromise) setStatus(T.loading, 'info');
      lib = await loadLib();
    } catch {
      if (id === runId) setStatus(T.loadFailed, 'error');
      return;
    }
    if (id !== runId) return;
    const res = runValidation(lib, {
      schemaText: schemaEl.value, dataText: dataEl.value, extrasText: extraEl.value,
      menu: draftSel.value, formats: formatsEl.checked,
    }, T, cache);
    render(res);
    if (trackTimer) clearTimeout(trackTimer);
    const action = res.state === 'valid' ? 'validate_success' : res.state === 'invalid' ? 'validate_error' : 'validate_' + res.state;
    if (res.state !== 'empty') trackTimer = setTimeout(() => (window as any).trackTool?.(SLUG, action), manual ? 0 : 1500);
  }

  let timer: ReturnType<typeof setTimeout> | null = null;
  function schedule() {
    if (timer) clearTimeout(timer);
    timer = setTimeout(() => run(false), 300);
  }

  validateBtn.addEventListener('click', () => run(true));
  [schemaEl, dataEl, extraEl].forEach((ta) => ta.addEventListener('input', schedule));
  draftSel.addEventListener('change', () => { savePrefs(); run(true); });
  formatsEl.addEventListener('change', () => { savePrefs(); run(true); });
  exampleSel.addEventListener('change', () => {
    const ex = EXAMPLES[exampleSel.value];
    exampleSel.value = '';
    if (!ex) return;
    schemaEl.value = ex.schema;
    dataEl.value = ex.data;
    extraEl.value = ex.extras || '';
    run(true);
  });
  wrap.querySelectorAll<HTMLButtonElement>('[data-clear]').forEach((b) => b.addEventListener('click', () => {
    textareaFor(b.dataset.clear || '').value = '';
    run(true);
  }));
  let openSide = 'data';
  wrap.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => b.addEventListener('click', () => {
    openSide = b.dataset.open || 'data';
    fileEl.value = '';
    fileEl.click();
  }));
  async function loadFile(file: File, side: string) {
    if (file.size > FILE_LIMIT) { setStatus(fmt(T.fileTooBig, { name: file.name }), 'error'); return; }
    try {
      textareaFor(side).value = await file.text();
      run(true);
    } catch {
      setStatus(fmt(T.fileRead, { name: file.name }), 'error');
    }
  }
  fileEl.addEventListener('change', () => { const f = fileEl.files && fileEl.files[0]; if (f) loadFile(f, openSide); });
  wrap.querySelectorAll<HTMLElement>('.jsv-panel').forEach((panel) => {
    panel.addEventListener('dragover', (e) => { if (e.dataTransfer && Array.prototype.includes.call(e.dataTransfer.types, 'Files')) { e.preventDefault(); panel.classList.add('jsv-drop'); } });
    panel.addEventListener('dragleave', () => panel.classList.remove('jsv-drop'));
    panel.addEventListener('drop', (e) => {
      panel.classList.remove('jsv-drop');
      const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (!f) return;
      e.preventDefault();
      loadFile(f, panel.dataset.side || 'data');
    });
  });
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L')) setTimeout(() => run(true), 0);
  });

  async function copy(text: string, btn: HTMLButtonElement, label: string) {
    let ok = false;
    try { await navigator.clipboard.writeText(text); ok = true; } catch {
      const ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { ok = document.execCommand('copy'); } catch { ok = false; }
      ta.remove();
    }
    if (!ok) { setStatus(T.copyFailed, 'error'); return; }
    btn.textContent = T.copied;
    setTimeout(() => { btn.textContent = label; }, 1500);
  }
  copyTextBtn.addEventListener('click', () => { if (lastResult) copy(reportText(lastResult, T), copyTextBtn, T.copyText); });
  copyJsonBtn.addEventListener('click', () => { if (lastResult) copy(reportJson(lastResult), copyJsonBtn, T.copyJson); });

