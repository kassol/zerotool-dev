      extraNoId: '참조되는 스키마 {n}에 "$id"가 없어 어떤 $ref로도 참조할 수 없습니다.',
      extraDraft: '참조되는 스키마 {id}가 $schema "{uri}"를 선언했습니다. 모든 스키마가 {draft}를 써야 합니다.',
      extraDup: '참조되는 스키마 두 개가 같은 "$id"를 씁니다: {id}.',
      compile: 'Ajv가 스키마를 컴파일하지 못했습니다: {message}',
      itemsArray: '{draft}의 "items"는 스키마 하나만 받습니다. 배열 형식은 draft-07 문법입니다. 위치별 스키마는 "prefixItems"를 쓰세요.',
    },
    notice: {
      noSchema: '$schema가 없어 {draft}로 검증했습니다. "$schema"를 쓰거나 메뉴에서 드래프트를 고르세요.',
      schemaUnknown: '$schema "{uri}"는 다섯 드래프트 중 어느 것도 아닙니다. {draft}로 검증했습니다.',
      schemaNonCanonical: '$schema "{uri}"를 {draft}로 읽었지만 공식 표기는 "{canonical}"입니다. 다른 검증기는 인식하지 못할 수 있습니다.',
      schemaMismatch: '$schema는 {schemaDraft}이지만 메뉴에서 {draft}를 지정했습니다.',
      olderSyntax: '스키마에 draft-07 문법 {keywords}가 있습니다. Draft 7을 고르거나 "$schema"를 쓰세요.',
      refSiblings: '{draft}에서는 "$ref" 옆의 키워드가 무시됩니다: {path}의 {keywords}.',
      unknownKeyword: '{path}의 알 수 없는 키워드 "{keyword}"는 무시됩니다.',
      unknownKeywordMany: '알 수 없는 키워드 "{keyword}"는 무시됩니다({count}곳, 처음 위치 {path}).',
      suggestion: '"{suggestion}"의 오타가 아닌지 확인하세요.',
      nullable: '{path}의 "nullable"은 OpenAPI 3.0 키워드라 JSON Schema에서는 무시됩니다. "type": [{types}]로 쓰세요.',
      idKeyword: '{path}의 "id"는 draft-04 키워드라 무시됩니다. {draft}에서는 "$id"를 씁니다.',
      dependencies: '{draft}에서는 {path}의 "dependencies"가 무시됩니다. "dependentRequired"나 "dependentSchemas"를 쓰세요.',
      additionalItems: '{draft}에서는 {path}의 "additionalItems"가 무시됩니다. "prefixItems"와 "items"를 쓰세요.',
      formatUnchecked: 'format {formats}은(는) 검사하지 않습니다. 어떤 문자열도 통과합니다.',
      formatOff: 'format 검사가 꺼져 있습니다. "format"은 주석으로만 쓰입니다.',
      dupKey: '{side}의 {path}에 키 "{key}"가 중복되어 있습니다({line}행). JSON.parse는 마지막 값만 남기므로 앞의 값은 검증되지 않습니다.',
      lossyNumber: '{side}의 {path}에 있는 숫자 {raw}({line}행)는 JavaScript에서 정확히 표현할 수 없어 {parsed}(으)로 읽힙니다.',
      lossyNumberYaml: 'YAML {side}에 있는 숫자 {raw}는 JavaScript에서 정확히 표현할 수 없어 {parsed}(으)로 읽힙니다.',
      bom: '{side} 앞의 BOM(바이트 순서 표시)을 제거했습니다.',
      yamlRead: '{side}를 YAML로 읽었습니다(문서 {n}개). 날짜와 yes / no는 문자열로 남습니다(YAML 1.2 core schema).',
      jsonlRead: '데이터를 JSON Lines로 읽었습니다. {n}줄을 한 줄씩 검증합니다.',
      sideSchema: '스키마',
      sideData: '데이터',
    },
    reason: {
      dynamicRef: '{path}에서 "$dynamicRef"를 씁니다. Ajv는 동적 참조를 일부만 구현해 공식 테스트 일부에서 틀린 결과를 냅니다.',
      recursiveRef: '{path}의 "$recursiveRef"가 있는 스키마 리소스에는 "$recursiveAnchor": true가 없고 다른 리소스에는 있습니다. 이 경우 Ajv는 잘못된 스키마를 따라갑니다.',
      refOverflow: '이 스키마에서 중첩된 "$id"에 대한 "$ref"를 해석하다가 Ajv의 스택이 넘쳤습니다(상대 참조에 관한 Ajv의 알려진 한계). 스키마 자체는 올바를 수 있습니다.',
      unevaluated: '{path}의 "{keyword}"가 {at}의 {combo}와 함께 쓰였습니다. Ajv는 이 조합을 잘못 판정합니다.',
      combo_ifPartial: '"then"이나 "else"가 없는 "if"',
      combo_contains: '"contains"',
      combo_itemsInBranch: 'anyOf / oneOf 분기 안의 "items"',
      vocabUnknown: '메타 스키마 {uri}가 이 도구가 모르는 어휘를 필수로 지정합니다: {vocab}.',
      vocabMissing: '메타 스키마 {uri}에 {vocab}가 없습니다. Ajv는 그래도 이 키워드로 검증합니다.',
      proto: '스키마가 "__proto__"라는 속성을 제약하고({path}) 데이터에도 그 키가 있습니다. Ajv는 이 이름을 건너뛰므로 제약이 검사되지 않습니다.',
      lossyData: '데이터에 JavaScript가 정확히 담을 수 없는 숫자가 있습니다: {raw}가 {parsed}(으)로 읽히고, 스키마는 숫자를 비교합니다.',
      lossySchema: '스키마에 JavaScript가 정확히 담을 수 없는 숫자가 있습니다: {raw}가 {parsed}(으)로 읽힙니다.',
      validateError: 'Ajv가 검증 중에 멈췄습니다: {message}.',
    },
    kw: {
      type: '{expected}여야 하는데 {actual}입니다',
      required: '필수 속성 "{name}"이(가) 없습니다',
      additionalProperties: '속성 "{name}"은(는) 허용되지 않습니다(additionalProperties)',
      unevaluatedProperties: '속성 "{name}"은(는) 허용되지 않습니다(unevaluatedProperties)',
      unevaluatedItems: '항목은 {limit}개까지입니다(unevaluatedItems). {actual}개 있습니다',
      items: '항목은 {limit}개까지입니다. {actual}개 있습니다',
      dependentRequired: '속성 "{property}"가 있으면 {deps}도 있어야 합니다',
      compare: '{comparison} {limit}여야 하는데 {value}입니다',
      multipleOf: '{multipleOf}의 배수여야 하는데 {value}입니다',
      minLength: '{limit}자 이상이어야 합니다. {actual}자입니다',
      maxLength: '{limit}자 이하여야 합니다. {actual}자입니다',
      pattern: '패턴 {pattern}과(와) 맞지 않습니다',
      format: '올바른 "{format}"이(가) 아닙니다',
      enum: '{values} 중 하나여야 합니다',
      const: '{value}여야 합니다',
      minItems: '항목이 {limit}개 이상이어야 합니다. {actual}개입니다',
      maxItems: '항목이 {limit}개 이하여야 합니다. {actual}개입니다',
      minProperties: '속성이 {limit}개 이상이어야 합니다. {actual}개입니다',
      maxProperties: '속성이 {limit}개 이하여야 합니다. {actual}개입니다',
      uniqueItems: '{j}번째와 {i}번째 항목이 같습니다(uniqueItems)',
      minContains: 'contains에 맞는 항목이 {limit}개 이상 있어야 합니다',
      maxContains: 'contains에 맞는 항목은 {limit}개까지입니다',
      propertyNames: '속성 이름 "{name}"은(는) 허용되지 않습니다(propertyNames)',
      oneOfNone: 'oneOf의 어느 분기와도 맞지 않습니다',
      oneOfMany: 'oneOf의 여러 분기와 동시에 맞습니다({branches})',
      anyOf: 'anyOf의 어느 분기와도 맞지 않습니다',
      not: '"not"의 스키마와 맞으면 안 됩니다',
      falseSchema: '여기에는 값을 둘 수 없습니다(스키마가 false)',
      if: '"{kw}"의 스키마와 맞지 않습니다',
    },
  },
};
const S = STRINGS[lang] || STRINGS.en;
---

<div class="jsv-wrap" id="jsv-wrap" data-lang={lang} data-strings={JSON.stringify(S)}>
  <div class="jsv-toolbar">
    <label class="jsv-field">
      <span class="jsv-field-label">{S.draftLabel}</span>
      <select id="jsv-draft" class="tool-input jsv-select">
        <option value="auto">{S.draftAuto}</option>
        <option value="2020-12">Draft 2020-12</option>
        <option value="2019-09">Draft 2019-09</option>
        <option value="7">Draft 7</option>
        <option value="6">Draft 6</option>
        <option value="4">Draft 4</option>
      </select>
    </label>
    <label class="jsv-check">
      <input type="checkbox" id="jsv-formats" checked />
      <span>{S.formatToggle}</span>
    </label>
    <label class="jsv-field jsv-field-ex">
      <span class="jsv-field-label">{S.examples}</span>
      <select id="jsv-example" class="tool-input jsv-select">
        <option value="">{S.examples}…</option>
        <option value="user">{S.exUser}</option>
        <option value="userErrors">{S.exUserErrors}</option>
        <option value="oneOf">{S.exOneOf}</option>
        <option value="yaml">{S.exYaml}</option>
      </select>
    </label>
    <button id="jsv-validate" class="btn-primary jsv-validate" type="button">{S.validate}</button>
  </div>

  <div class="jsv-status-row">
    <p id="jsv-status" class="jsv-status" role="status" aria-live="polite">{S.empty}</p>
    <button id="jsv-cancel" class="btn-ghost jsv-mini" type="button" hidden>{S.cancel}</button>
  </div>

  <div class="jsv-panels">
    <div class="jsv-panel" data-side="schema">
      <div class="jsv-panel-head">
        <label for="jsv-schema" class="jsv-panel-label">{S.schemaLabel}</label>
        <span class="jsv-badge" id="jsv-schema-fmt" hidden></span>
        <span class="jsv-panel-actions">
          <button class="btn-ghost jsv-mini" type="button" data-open="schema">{S.open}</button>
          <button class="btn-ghost jsv-mini" type="button" data-clear="schema">{S.clear}</button>
        </span>
      </div>
      <textarea id="jsv-schema" class="tool-textarea jsv-text" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder={S.schemaPh}></textarea>
    </div>
    <div class="jsv-panel" data-side="data">
      <div class="jsv-panel-head">
        <label for="jsv-data" class="jsv-panel-label">{S.dataLabel}</label>
        <span class="jsv-badge" id="jsv-data-fmt" hidden></span>
        <span class="jsv-panel-actions">
          <button class="btn-ghost jsv-mini" type="button" data-open="data">{S.open}</button>
          <button class="btn-ghost jsv-mini" type="button" data-clear="data">{S.clear}</button>
        </span>
      </div>
      <textarea id="jsv-data" class="tool-textarea jsv-text" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder={S.dataPh}></textarea>
    </div>
  </div>
  <input type="file" id="jsv-file" accept=".json,.yaml,.yml,.jsonl,.ndjson,.txt,application/json,application/yaml,text/yaml" hidden />

  <details class="jsv-extras" id="jsv-extras">
    <summary>{S.extrasSummary}</summary>
    <p class="jsv-help">{S.extrasHelp}</p>
    <textarea id="jsv-extra" class="tool-textarea jsv-text jsv-extra-text" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder={S.extrasPh} aria-label={S.extrasSummary}></textarea>
  </details>

  <div id="jsv-result" class="jsv-result" hidden>
    <div class="jsv-result-actions">
      <button type="button" class="btn-copy" id="jsv-copy-text">{S.copyText}</button>
      <button type="button" class="btn-copy" id="jsv-copy-json">{S.copyJson}</button>
    </div>
    <div id="jsv-out"></div>
  </div>
</div>

<script>
  // Parsing and validation run in a Web Worker (json-schema-validator.worker.js), so a large
  // file does not freeze the page; a new run or "Cancel" terminates the running one. When a
  // worker cannot start, the same module runs on the main thread. The engine
  // (json-schema-validator-engine.js) also builds the status line, messages and copies here.
  import ValidatorWorker from './json-schema-validator.worker.js?worker';
  import { fmt, statusText, reportText, reportJson, noticeText, schemaErrorText, parseErrorText, reasonText } from './json-schema-validator-engine.js';

  const wrap = document.getElementById('jsv-wrap') as HTMLElement;
  const T: any = JSON.parse(wrap.dataset.strings || '{}');
  const SLUG = 'json-schema-validator';
  const schemaEl = document.getElementById('jsv-schema') as HTMLTextAreaElement;
  const dataEl = document.getElementById('jsv-data') as HTMLTextAreaElement;
  const extraEl = document.getElementById('jsv-extra') as HTMLTextAreaElement;
  const extrasBox = document.getElementById('jsv-extras') as HTMLDetailsElement;
  const draftSel = document.getElementById('jsv-draft') as HTMLSelectElement;
  const formatsEl = document.getElementById('jsv-formats') as HTMLInputElement;
  const exampleSel = document.getElementById('jsv-example') as HTMLSelectElement;
  const validateBtn = document.getElementById('jsv-validate') as HTMLButtonElement;
  const cancelBtn = document.getElementById('jsv-cancel') as HTMLButtonElement;
  const statusEl = document.getElementById('jsv-status') as HTMLElement;
  const resultEl = document.getElementById('jsv-result') as HTMLElement;
  const outEl = document.getElementById('jsv-out') as HTMLElement;
  const fileEl = document.getElementById('jsv-file') as HTMLInputElement;
  const copyTextBtn = document.getElementById('jsv-copy-text') as HTMLButtonElement;
  const copyJsonBtn = document.getElementById('jsv-copy-json') as HTMLButtonElement;
  const fmtBadges: Record<string, HTMLElement> = {
    schema: document.getElementById('jsv-schema-fmt') as HTMLElement,
    data: document.getElementById('jsv-data-fmt') as HTMLElement,
  };
  const AUTO_LIMIT = 1_000_000;
  const MAX_GROUPS = 200;
  const FILE_LIMIT = 20 * 1024 * 1024;

  const EXAMPLES: Record<string, { schema: string; data: string; extras?: string }> = {
    user: {
      schema: JSON.stringify({
        $schema: 'http://json-schema.org/draft-07/schema#',
        title: 'User',
        type: 'object',
        required: ['name', 'age', 'email'],
        properties: {
          name: { type: 'string', minLength: 1 },
          age: { type: 'integer', minimum: 0, maximum: 120 },
          email: { type: 'string', format: 'email' },
          role: { type: 'string', enum: ['admin', 'user', 'guest'] },
        },
        additionalProperties: false,
      }, null, 2),
      data: JSON.stringify({ name: 'Alice', age: 30, email: 'alice@example.com', role: 'admin' }, null, 2),
    },
    userErrors: {
      schema: '',
      data: JSON.stringify({ name: '', age: -5, email: 'not-an-email', role: 'superuser', extra: 'not allowed' }, null, 2),
    },
    oneOf: {
      schema: JSON.stringify({
        $schema: 'https://json-schema.org/draft/2020-12/schema',
        type: 'object',
        required: ['orderId', 'payment'],
        properties: {
          orderId: { type: 'string', pattern: '^ORD-[0-9]{6}$' },
          payment: { oneOf: [{ $ref: '#/$defs/card' }, { $ref: '#/$defs/bank' }] },
        },
        $defs: {
          card: {
            type: 'object',
            required: ['method', 'last4', 'expires'],
            properties: {
              method: { const: 'card' },
              last4: { type: 'string', pattern: '^[0-9]{4}$' },
              expires: { type: 'string', pattern: '^(0[1-9]|1[0-2])/[0-9]{2}$' },
            },
            additionalProperties: false,
          },
          bank: {
            type: 'object',
            required: ['method', 'iban'],
            properties: { method: { const: 'bank' }, iban: { type: 'string', minLength: 15 } },
            additionalProperties: false,
          },
        },
      }, null, 2),
      data: JSON.stringify({ orderId: 'ORD-004211', payment: { method: 'card', last4: '42', expires: '13/27' } }, null, 2),
    },
    yaml: {
      schema: [
        '$schema: https://json-schema.org/draft/2020-12/schema',
        'type: object',
        'allOf:',
        '  - $ref: "#/$defs/service"',
        'properties:',
        '  replicas: { type: integer, minimum: 1 }',
        '  release: { type: string, format: date }',
        'unevaluatedProperties: false',
        '$defs:',
        '  service:',
        '    type: object',
        '    required: [name, port]',
        '    properties:',
        '      name: { type: string }',
        '      port: { type: integer, minimum: 1, maximum: 65535 }',
        '',
      ].join('\n'),
      data: [
        'name: web',
        'port: 8080',
        'replicas: 0',
        'release: 2026-10-02',
        'replica: 3',
        '',
      ].join('\n'),
    },
  };
  EXAMPLES.userErrors.schema = EXAMPLES.user.schema;

  const prefs = (window as any).ztPersist?.load(SLUG) || {};
  if (typeof prefs.draft === 'string' && Array.prototype.some.call(draftSel.options, (o: HTMLOptionElement) => o.value === prefs.draft)) draftSel.value = prefs.draft;
  if (prefs.formats === false) formatsEl.checked = false;
  function savePrefs() { (window as any).ztPersist?.save(SLUG, { draft: draftSel.value, formats: formatsEl.checked }); }

  /* ── worker ── */
  let worker: Worker | null = null;
  let pending: { id: number; resolve: (v: any) => void } | null = null;
  let seq = 0;
  let fallback: Promise<any> | null = null;
  function stopWorker() { if (worker) { worker.terminate(); worker = null; } }
  function startWorker(): Worker | null {
    if (worker) return worker;
    try {
      worker = new ValidatorWorker();
      worker.onmessage = (e: MessageEvent) => {
        const d = e.data || {};
        if (!pending || d.id !== pending.id) return;
        const p = pending; pending = null;
        p.resolve(d);
      };
      worker.onerror = (e: ErrorEvent) => {
        if (pending) { const p = pending; pending = null; p.resolve({ error: (e && e.message) || 'worker error', load: true }); }
        stopWorker();
      };
    } catch { worker = null; }
    return worker;
  }
  // Stops the running validation: its result, if it still arrives, is never shown.
  function abandon() {
    seq++;
    if (pending) { stopWorker(); pending.resolve(null); pending = null; }
  }
  function validateIn(input: any): Promise<any> {
    abandon();
    const id = seq;
    const w = startWorker();
    if (!w) {
      return (fallback || (fallback = import('./json-schema-validator-run.js'))).then(
        (m: any) => (id === seq ? m.runValidation(input, T) : null),
        () => { fallback = null; return id === seq ? { error: 'load', load: true } : null; },
      );
    }
    return new Promise((resolve) => {
      pending = { id, resolve };
      w.postMessage({ id, input, T });
    });
  }

  let lastResult: any = null;
  let started = false;
  let trackTimer: ReturnType<typeof setTimeout> | null = null;
  let cancelTimer: ReturnType<typeof setTimeout> | null = null;

  function setStatus(text: string, kind: string) {
    statusEl.textContent = text;
    statusEl.className = 'jsv-status ' + kind;
  }
  function el(tag: string, cls?: string, text?: string): HTMLElement {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }
  function textareaFor(side: string): HTMLTextAreaElement { return side === 'schema' ? schemaEl : side === 'extras' ? extraEl : dataEl; }
  function jump(side: string, range: number[] | undefined) {
    if (!range) return;
    const ta = textareaFor(side);
    if (side === 'extras') extrasBox.open = true;
    ta.focus({ preventScroll: true });
    ta.setSelectionRange(range[0], range[1]);
    const before = ta.value.slice(0, range[0]);
    const line = before.split('\n').length - 1;
    const lh = parseFloat(getComputedStyle(ta).lineHeight) || 20;
    ta.scrollTop = Math.max(0, line * lh - ta.clientHeight / 3);
    const r = ta.getBoundingClientRect();
    if (r.top < 0 || r.top > window.innerHeight - 80) ta.scrollIntoView({ block: 'center' });
  }
  function locLink(side: string, label: string, range: number[] | undefined, cls: string) {
    if (!range) return el('span', cls, label);
    const b = el('button', cls + ' jsv-link', label) as HTMLButtonElement;
    b.type = 'button';
    b.addEventListener('click', () => jump(side, range));
    return b;
  }
  function schemaLink(it: any, schemaRanges: any) {
    const label = fmt(T.schemaAt, { path: it.schemaPath });
    const range = it.schemaPtr !== undefined ? schemaRanges[it.schemaPtr] : undefined;
    return locLink('schema', label, range, 'jsv-schema-path');
  }
  function renderItem(it: any, schemaRanges: any, nested: boolean): HTMLElement {
    const li = el('li', 'jsv-item');
    const line = el('div', 'jsv-item-line');
    if (nested) {
      const where = (it.path === '' ? T.root : it.path) + (it.line ? ' · ' + fmt(T.lineCol, { line: it.line, col: it.col }) : '');
      line.appendChild(locLink('data', where, it.range, 'jsv-path'));
    }
    line.appendChild(el('span', 'jsv-msg', it.message));
    if (it.via) line.appendChild(el('span', 'jsv-via', fmt(T.via, { kw: it.via })));
    li.appendChild(line);
    const meta = el('div', 'jsv-item-meta');
    if (it.value !== undefined) meta.appendChild(el('code', 'jsv-value', fmt(T.valueLabel, { value: it.value })));
    meta.appendChild(schemaLink(it, schemaRanges));
    li.appendChild(meta);
    if (it.branches && it.branches.length) {
      const closest = it.branches.filter((b: any) => b.index === it.closest)[0];
      const others = it.branches.filter((b: any) => b !== closest);
      if (closest) {
        li.appendChild(el('div', 'jsv-branch-title', fmt(T.closest, { n: closest.index + 1 })));
        const ul = el('ul', 'jsv-items jsv-nested');
        closest.items.forEach((x: any) => ul.appendChild(renderItem(x, schemaRanges, true)));
        li.appendChild(ul);
      }
      if (others.length) {
        const det = el('details', 'jsv-others') as HTMLDetailsElement;
        det.appendChild(el('summary', '', fmt(T.otherBranches, { n: others.length })));
        others.forEach((b: any) => {
          det.appendChild(el('div', 'jsv-branch-title', fmt(T.branch, { n: b.index + 1 })));
          const ul = el('ul', 'jsv-items jsv-nested');
          if (!b.items.length) ul.appendChild(el('li', 'jsv-item', T.branchNoErrors));
          b.items.forEach((x: any) => ul.appendChild(renderItem(x, schemaRanges, true)));
          det.appendChild(ul);
        });
        li.appendChild(det);
      }
    }
    return li;
  }
  function renderNotices(list: any[]) {
    if (!list.length) return;
    const box = el('div', 'jsv-notices');
    box.appendChild(el('div', 'jsv-notices-title', T.noticesTitle));
    const ul = el('ul', 'jsv-notice-list');
    list.slice(0, 60).forEach((n: any) => {
      const li = el('li', 'jsv-notice');
      const text = noticeText(n, T);
      if (n.offset !== undefined) {
        const b = locLink(n.side === 'schema' ? 'schema' : 'data', text, [n.offset, n.offset + (n.len || 1)], 'jsv-notice-text');
        li.appendChild(b);
      } else li.textContent = text;
      ul.appendChild(li);
    });
    box.appendChild(ul);
    outEl.appendChild(box);
  }
  function renderReasons(list: any[]) {
    if (!list || !list.length) return;
    const box = el('div', 'jsv-reasons');
    box.appendChild(el('div', 'jsv-reasons-title', T.reasonsTitle));
    const ul = el('ul', 'jsv-notice-list');
    list.forEach((r: any) => ul.appendChild(el('li', 'jsv-notice', reasonText(r, T))));
    box.appendChild(ul);
    outEl.appendChild(box);
  }
  function clearResult() {
    lastResult = null;
    outEl.textContent = '';
    resultEl.hidden = true;
    resultEl.classList.remove('jsv-stale');
    copyTextBtn.hidden = copyJsonBtn.hidden = true;
  }
  function render(res: any) {
    lastResult = res;
    outEl.textContent = '';
    resultEl.classList.remove('jsv-stale');
    for (const side of ['schema', 'data']) {
      const f = side === 'schema' ? res.schemaFormat : res.dataFormat;
      const badge = fmtBadges[side];
      const label = f === 'json' ? T.fmtJson : f === 'yaml' ? T.fmtYaml : f === 'jsonl' ? T.fmtJsonl : '';
      badge.textContent = label;
      badge.hidden = !label;
    }
    copyTextBtn.hidden = copyJsonBtn.hidden = true;
    if (res.state === 'empty') {
      setStatus(statusText(res, T), 'none');
      resultEl.hidden = !res.notices.length;
      renderNotices(res.notices);
      return;
    }
    if (res.state === 'schemaParse' || res.state === 'dataParse' || res.state === 'extrasParse') {
      setStatus(statusText(res, T), 'error');
      resultEl.hidden = false;
      const box = el('ul', 'jsv-items');
      const li = el('li', 'jsv-item');
      li.appendChild(locLink(res.side, parseErrorText(res.parseError, T), [res.parseError.offset, res.parseError.offset + 1], 'jsv-msg'));
      box.appendChild(li);
      outEl.appendChild(box);
      renderNotices(res.notices);
      return;
    }
    if (res.state === 'schemaInvalid' || res.state === 'schemaFail') {
      setStatus(statusText(res, T), 'error');
      resultEl.hidden = false;
      const box = el('ul', 'jsv-items');
      res.schemaErrors.forEach((e: any) => {
        const li = el('li', 'jsv-item');
        li.appendChild(locLink('schema', schemaErrorText(e, T), e.range, 'jsv-msg'));
        box.appendChild(li);
      });
      outEl.appendChild(box);
      if (res.schemaErrors.some((e: any) => e.code === 'missingRef')) extrasBox.open = true;
      renderNotices(res.notices);
      return;
    }
    const multi = res.docs.length > 1;
    setStatus(statusText(res, T), res.state === 'valid' ? 'success' : res.state === 'unknown' ? 'warn' : 'error');
    resultEl.hidden = res.state === 'valid' && !res.notices.length;
    copyTextBtn.hidden = copyJsonBtn.hidden = res.state === 'valid';
    renderReasons(res.reasons);
    const schemaRanges = res.schemaRanges || {};
    let shown = 0, hidden = 0;
    res.docs.forEach((doc: any) => {
      if (multi && doc.state === 'valid') return;
      if (multi) {
        if (shown >= MAX_GROUPS) { hidden++; return; }
        const title = fmt(doc.line ? T.docLine : T.docLabel, { n: doc.index + 1, line: doc.line });
        outEl.appendChild(el('div', 'jsv-doc-title', doc.state === 'unknown' ? title + ': ' + T.unknown : title));
        if (doc.state === 'unknown') shown++;
      }
      doc.groups.forEach((g: any) => {
        if (shown >= MAX_GROUPS) { hidden++; return; }
        shown++;
        const box = el('div', 'jsv-group');
        const head = el('div', 'jsv-group-head');
        const where = g.path === '' ? T.root : g.path;
        head.appendChild(locLink('data', where, g.range, 'jsv-path'));
        if (g.line) head.appendChild(el('span', 'jsv-line', fmt(T.lineCol, { line: g.line, col: g.col })));
        box.appendChild(head);
        const ul = el('ul', 'jsv-items');
        g.items.forEach((it: any) => {
          const li = renderItem(it, schemaRanges, false);
          if (it.range && it.keyPath) {
            const m = li.querySelector('.jsv-msg');
            if (m) { const b = locLink('data', m.textContent || '', it.range, 'jsv-msg'); m.replaceWith(b); }
          }
          ul.appendChild(li);
        });
        box.appendChild(ul);
        outEl.appendChild(box);
      });
    });
    if (hidden) outEl.appendChild(el('p', 'jsv-more', fmt(T.moreGroups, { n: hidden })));
    renderNotices(res.notices);
  }

  function setBusy(on: boolean) {
    if (cancelTimer) { clearTimeout(cancelTimer); cancelTimer = null; }
    if (on) cancelTimer = setTimeout(() => { cancelBtn.hidden = false; }, 300);
    else cancelBtn.hidden = true;
  }
  async function run(manual: boolean) {
    const size = schemaEl.value.length + dataEl.value.length + extraEl.value.length;
    if (!schemaEl.value.trim() && !dataEl.value.trim() && !extraEl.value.trim()) {
      abandon(); setBusy(false);
      render({ state: 'empty', notices: [], docs: [] });
      return;
    }
    if (!manual && size > AUTO_LIMIT) {
      // the result on screen belongs to the previous text, so it is removed
      abandon(); setBusy(false); clearResult();
      setStatus(T.large, 'info');
      return;
    }
    if (lastResult) { resultEl.classList.add('jsv-stale'); copyTextBtn.hidden = copyJsonBtn.hidden = true; }
    setStatus(started ? T.validating : T.loading, 'info');
    setBusy(true);
    const resp = await validateIn({
      schemaText: schemaEl.value, dataText: dataEl.value, extrasText: extraEl.value,
      menu: draftSel.value, formats: formatsEl.checked,
    });
    if (!resp) return;
    setBusy(false);
    if (resp.error) {
      clearResult();
      setStatus(resp.load ? T.loadFailed : fmt(T.schemaErr.compile, { message: resp.error }), 'error');
      return;
    }
    started = true;
    const res = resp.result;
    render(res);
    if (trackTimer) clearTimeout(trackTimer);
    const action = res.state === 'valid' ? 'validate_success' : res.state === 'invalid' ? 'validate_error' : 'validate_' + res.state;
    if (res.state !== 'empty') trackTimer = setTimeout(() => (window as any).trackTool?.(SLUG, action), manual ? 0 : 1500);
  }
  cancelBtn.addEventListener('click', () => {
    abandon(); setBusy(false); clearResult();
    setStatus(T.cancelled, 'none');
  });

  let timer: ReturnType<typeof setTimeout> | null = null;
  function schedule() {
    if (timer) clearTimeout(timer);
    timer = setTimeout(() => run(false), 300);
  }
  // From the first keystroke the result on screen belongs to the previous text; until the
  // debounced run starts, the status line must not present it as the current verdict.
  function markStale() {
    if (!lastResult || lastResult.state === 'empty') return;
    resultEl.classList.add('jsv-stale');
    copyTextBtn.hidden = copyJsonBtn.hidden = true;
    const size = schemaEl.value.length + dataEl.value.length + extraEl.value.length;
    setStatus(size > AUTO_LIMIT ? T.large : started ? T.validating : T.loading, 'info');
  }

  // A file read that finishes after the box was edited, cleared or loaded again is dropped.
  const fileGen: Record<string, number> = { schema: 0, data: 0, extras: 0 };
  validateBtn.addEventListener('click', () => run(true));
  ([['schema', schemaEl], ['data', dataEl], ['extras', extraEl]] as [string, HTMLTextAreaElement][]).forEach(([side, ta]) => ta.addEventListener('input', () => { fileGen[side]++; markStale(); schedule(); }));
  draftSel.addEventListener('change', () => { savePrefs(); run(true); });
  formatsEl.addEventListener('change', () => { savePrefs(); run(true); });
  exampleSel.addEventListener('change', () => {
    const ex = EXAMPLES[exampleSel.value];
    exampleSel.value = '';
    if (!ex) return;
    fileGen.schema++; fileGen.data++; fileGen.extras++;
    schemaEl.value = ex.schema;
    dataEl.value = ex.data;
    extraEl.value = ex.extras || '';
    run(true);
  });
  wrap.querySelectorAll<HTMLButtonElement>('[data-clear]').forEach((b) => b.addEventListener('click', () => {
    const side = b.dataset.clear || '';
    fileGen[side]++;
    textareaFor(side).value = '';
    run(true);
  }));
  let openSide = 'data';
  wrap.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => b.addEventListener('click', () => {
    openSide = b.dataset.open || 'data';
    fileEl.value = '';
    fileEl.click();
  }));
  async function loadFile(file: File, side: string) {
    const gen = ++fileGen[side];
    if (file.size > FILE_LIMIT) { setStatus(fmt(T.fileTooBig, { name: file.name }), 'error'); return; }
    let text: string;
    try { text = await file.text(); } catch {
      if (gen === fileGen[side]) setStatus(fmt(T.fileRead, { name: file.name }), 'error');
      return;
    }
    if (gen !== fileGen[side]) return;
    textareaFor(side).value = text;
    run(true);
  }
  fileEl.addEventListener('change', () => { const f = fileEl.files && fileEl.files[0]; if (f) loadFile(f, openSide); });
  wrap.querySelectorAll<HTMLElement>('.jsv-panel').forEach((panel) => {
    panel.addEventListener('dragover', (e) => { if (e.dataTransfer && Array.prototype.includes.call(e.dataTransfer.types, 'Files')) { e.preventDefault(); panel.classList.add('jsv-drop'); } });
    panel.addEventListener('dragleave', () => panel.classList.remove('jsv-drop'));
    panel.addEventListener('drop', (e) => {
      panel.classList.remove('jsv-drop');
      const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (!f) return;
      e.preventDefault();
      loadFile(f, panel.dataset.side || 'data');
    });
  });
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L')) {
      fileGen.schema++; fileGen.data++; fileGen.extras++;
      setTimeout(() => run(true), 0);
    }
  });

  async function copy(text: string, btn: HTMLButtonElement, label: string) {
    let ok = false;
    try { await navigator.clipboard.writeText(text); ok = true; } catch {
      const ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { ok = document.execCommand('copy'); } catch { ok = false; }
      ta.remove();
    }
    if (!ok) { setStatus(T.copyFailed, 'error'); return; }
    btn.textContent = T.copied;
    setTimeout(() => { btn.textContent = label; }, 1500);
  }
  copyTextBtn.addEventListener('click', () => { if (lastResult) copy(reportText(lastResult, T), copyTextBtn, T.copyText); });
  copyJsonBtn.addEventListener('click', () => { if (lastResult) copy(reportJson(lastResult, T), copyJsonBtn, T.copyJson); });

  if (!schemaEl.value.trim() && !dataEl.value.trim()) {
    schemaEl.value = EXAMPLES.user.schema;
    dataEl.value = EXAMPLES.user.data;
  }
  run(false);
</script>

<style>
  .jsv-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  .jsv-toolbar { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.6rem 0.9rem; }
  .jsv-field { display: flex; flex-direction: column; gap: 0.25rem; }
  .jsv-field-label { font-size: 0.78rem; font-weight: 650; color: var(--color-text-secondary); }
  .jsv-select { font-family: var(--font-sans); font-size: 0.88rem; padding-right: 2rem; }
  .jsv-check { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 40px; font-size: 0.88rem; font-weight: 650; color: var(--color-text-secondary); cursor: pointer; }
  .jsv-validate { margin-left: auto; }

  .jsv-status { margin: 0; font-size: 0.9rem; font-weight: 650; min-height: 1.3rem; }
  .jsv-status.success { color: var(--color-success); }
  .jsv-status.error { color: var(--color-danger); }
  .jsv-status.info { color: var(--color-primary); }
  .jsv-status.none { color: var(--color-text-muted); font-weight: 500; }
  .jsv-status.warn { color: var(--color-text); }
  .jsv-status-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.75rem; }
  .jsv-status-row .jsv-status { flex: 1 1 16rem; }

  .jsv-panels { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.75rem; }
  .jsv-panel { display: flex; flex-direction: column; gap: 0.35rem; border-radius: var(--radius-md); }
  .jsv-panel.jsv-drop { outline: 2px dashed var(--color-primary); outline-offset: 3px; }
  .jsv-panel-head { display: flex; align-items: center; gap: 0.5rem; min-height: 32px; }
  .jsv-panel-label { font-size: 0.85rem; font-weight: 700; color: var(--color-text-secondary); }
  .jsv-badge { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.03em; padding: 0.1rem 0.45rem; border-radius: var(--radius-pill); background: var(--color-surface-muted); color: var(--color-text-secondary); box-shadow: inset 0 0 0 1px var(--color-border-soft); }
  .jsv-panel-actions { margin-left: auto; display: inline-flex; flex: none; flex-wrap: nowrap; gap: 0.15rem; }
  .jsv-mini { min-height: 32px; padding: 0.25rem 0.6rem; font-size: 0.8rem; }
  .jsv-text { min-height: 260px; font-size: 0.82rem; line-height: 1.5; tab-size: 2; white-space: pre; overflow-wrap: normal; overflow-x: auto; }
  .jsv-extra-text { min-height: 120px; }

  .jsv-extras { border-radius: var(--radius-md); }
  .jsv-extras summary { cursor: pointer; font-size: 0.85rem; font-weight: 650; color: var(--color-text-secondary); padding: 0.2rem 0; }
  .jsv-help { margin: 0.4rem 0; font-size: 0.82rem; color: var(--color-text-muted); }

  .jsv-result { display: flex; flex-direction: column; gap: 0.6rem; }
  .jsv-result.jsv-stale { opacity: 0.45; }
  .jsv-result-actions { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: flex-end; }
  .jsv-result-actions:has(> :not([hidden])) { min-height: 32px; }

  .jsv-wrap :global(.jsv-group) {
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: inset 3px 0 0 var(--color-danger), inset 0 0 0 1px var(--color-border-soft);
    padding: 0.55rem 0.8rem 0.6rem 0.95rem;
    margin-bottom: 0.5rem;
  }
  .jsv-wrap :global(.jsv-group-head) { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.6rem; margin-bottom: 0.25rem; }
  .jsv-wrap :global(.jsv-path) { font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; color: var(--color-primary); overflow-wrap: anywhere; }
  .jsv-wrap :global(.jsv-line) { font-size: 0.76rem; color: var(--color-text-muted); }
  .jsv-wrap :global(.jsv-items) { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .jsv-wrap :global(.jsv-nested) { margin: 0.25rem 0 0.2rem; padding-left: 0.8rem; border-left: 2px solid var(--color-border-soft); }
  .jsv-wrap :global(.jsv-item) { font-size: 0.86rem; line-height: 1.45; color: var(--color-text); }
  .jsv-wrap :global(.jsv-item-line) { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.5rem; }
  .jsv-wrap :global(.jsv-msg) { overflow-wrap: anywhere; }
  .jsv-wrap :global(.jsv-via) { font-size: 0.74rem; color: var(--color-text-muted); }
  .jsv-wrap :global(.jsv-item-meta) { display: flex; flex-wrap: wrap; gap: 0.15rem 0.7rem; margin-top: 0.1rem; }
  .jsv-wrap :global(.jsv-value),
  .jsv-wrap :global(.jsv-schema-path) { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text-muted); overflow-wrap: anywhere; background: none; padding: 0; }
  .jsv-wrap :global(.jsv-branch-title) { margin-top: 0.3rem; font-size: 0.76rem; font-weight: 700; color: var(--color-text-secondary); }
  .jsv-wrap :global(.jsv-others) { margin-top: 0.3rem; }
  .jsv-wrap :global(.jsv-others > summary) { cursor: pointer; font-size: 0.78rem; font-weight: 650; color: var(--color-text-secondary); padding: 0.2rem 0; }
  .jsv-wrap :global(.jsv-link) {
    border: 0; padding: 0; margin: 0; background: none; font: inherit; text-align: left; cursor: pointer;
    color: inherit; text-decoration: underline; text-decoration-color: var(--color-border); text-underline-offset: 2px;
  }
  .jsv-wrap :global(.jsv-path.jsv-link) { color: var(--color-primary); }
  .jsv-wrap :global(.jsv-link:hover) { text-decoration-color: currentColor; }
  .jsv-wrap :global(.jsv-link:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: 2px; border-radius: 3px; }
  .jsv-wrap :global(.jsv-doc-title) { font-size: 0.82rem; font-weight: 700; color: var(--color-text-secondary); margin: 0.2rem 0; }
  .jsv-wrap :global(.jsv-more) { margin: 0; font-size: 0.82rem; color: var(--color-text-muted); }
  .jsv-wrap :global(.jsv-notices) {
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
    padding: 0.55rem 0.8rem;
  }
  .jsv-wrap :global(.jsv-reasons) {
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
    box-shadow: inset 3px 0 0 var(--color-warning, #b45309), inset 0 0 0 1px var(--color-border-soft);
    padding: 0.55rem 0.8rem 0.6rem 0.95rem;
  }
  .jsv-wrap :global(.jsv-reasons-title) { font-size: 0.82rem; font-weight: 750; color: var(--color-text); margin-bottom: 0.25rem; }
  .jsv-wrap :global(.jsv-notices-title) { font-size: 0.76rem; font-weight: 750; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-text-secondary); margin-bottom: 0.25rem; }
  .jsv-wrap :global(.jsv-notice-list) { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .jsv-wrap :global(.jsv-notice) { font-size: 0.82rem; line-height: 1.45; color: var(--color-text-secondary); overflow-wrap: anywhere; }

  @media (max-width: 760px) {
    .jsv-panels { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .jsv-toolbar { gap: 0.5rem 0.6rem; }
    .jsv-field { flex: 1 1 9rem; }
    .jsv-field-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .jsv-select { width: 100%; }
    .jsv-check { min-height: 44px; }
    .jsv-validate { margin-left: 0; flex: 1 1 auto; }
    .jsv-mini { min-height: 44px; }
    .jsv-text { min-height: 120px; height: 120px; }
    .jsv-extras summary { padding: 0.7rem 0; }
    .jsv-wrap :global(.jsv-link) { min-height: 24px; }
  }
</style>
