---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: { modeLabel: "Mode", variantLabel: "Alphabet", fileLabel: "File", selectFile: "Select file", tips: {
    mode: "Text uses UTF-8. Typing converts after 0.3 seconds; changing Encode or Decode converts the current text immediately. Decoding displays UTF-8 text only. A lone surrogate is rejected with its position.",
    variant: "Standard uses + and / with = padding. URL-safe uses - and _ and removes trailing =. Switching updates the current text or encoded file. A file still being read uses the latest selection.",
    file: "Choose or drop any file in Encode mode to encode its raw bytes. Files over 5 MiB show a warning and are still processed. The whole file and Base64 result are held in memory.",
    uri: "For an encoded file, add data:<mime>;base64, before the result. The MIME type comes from the file; an empty type uses application/octet-stream. This also works for an empty file.",
    swap: "Exchange the current input and output. The mode stays the same. Swap cancels a pending text conversion and leaves the exchanged values as they are.",
    copy: "Copy the complete displayed output, including the Data URI prefix when enabled. If copying fails, select the output and copy it manually.",
  }, copyFail: 'Could not copy. Please select and copy the output manually.', loneSurrogate: 'Position {n}: a lone surrogate (half of an emoji or other character) cannot be encoded as UTF-8.', largeFile: 'Large file — encoding may take a few seconds.', readFailed: 'Could not read the file.', dataUri: 'Include Data URI prefix', encode: 'Encode', decode: 'Decode', swap: 'Swap', clear: 'Clear', copy: 'Copy', copied: 'Copied!', plainText: 'Plain Text', base64: 'Base64', encodedOk: 'Encoded.', decodedOk: 'Decoded.', fileEncoded: 'File encoded.', encodePh: 'Enter text to encode...', decodePh: 'Enter Base64 string to decode...', b64OutPh: 'Base64 output appears here...', decodedOutPh: 'Decoded text appears here...', filePh: 'File loaded — text input cleared', invalidBase64: 'Invalid Base64 input. Please check your input and try again.', dropText: 'Drop any file here, or ', dropAction: 'click to select' },
  zh: { modeLabel: "模式", variantLabel: "字母表", fileLabel: "文件", selectFile: "选择文件", tips: {
    mode: "文本按 UTF-8 处理。停止输入 0.3 秒后转换；切换「编码」或「解码」会立即转换当前文本。解码只显示 UTF-8 文本。孤立的代理项会报错并指出位置。",
    variant: "Standard 使用 +、/ 和末尾的 = 填充；URL-safe 使用 -、_ 并去掉末尾的 =。切换会更新当前文本或已编码文件；仍在读取的文件按最新选项输出。",
    file: "在「编码」模式选择或拖入任意文件，按原始字节编码。超过 5 MiB 会提示，仍继续处理。整个文件和 Base64 结果都会占用内存。",
    uri: "为已编码文件的结果加上 data:<mime>;base64, 前缀。MIME 类型取自文件；未提供时使用 application/octet-stream。空文件也可加前缀。",
    swap: "交换当前输入和输出，模式保持不变。「交换」会取消等待中的文本转换，保留交换后的两个值。",
    copy: "复制完整的当前输出，包括已启用的 Data URI 前缀。复制失败时，请选中输出内容后手动复制。",
  }, copyFail: '复制失败。请选中输出内容后手动复制。', loneSurrogate: '第 {n} 个字符：孤立的代理项（emoji 等字符的一半）无法编码为 UTF-8。', largeFile: '文件较大，编码可能需要几秒。', readFailed: '无法读取文件。', dataUri: '加上 Data URI 前缀', encode: '编码', decode: '解码', swap: '交换', clear: '清除', copy: '复制', copied: '已复制！', plainText: '纯文本', base64: 'Base64', encodedOk: '已编码。', decodedOk: '已解码。', fileEncoded: '文件已编码。', encodePh: '输入要编码的文本...', decodePh: '输入要解码的 Base64 字符串...', b64OutPh: 'Base64 输出在这里...', decodedOutPh: '解码文本在这里...', filePh: '文件已加载 — 文本输入已清除', invalidBase64: 'Base64 输入无效，请检查后重试。', dropText: '拖入任意文件，或', dropAction: '点击选择' },
  ja: { modeLabel: "モード", variantLabel: "アルファベット", fileLabel: "ファイル", selectFile: "ファイルを選択", tips: {
    mode: "テキストは UTF-8 で処理します。入力を止めて0.3秒後に変換し、「エンコード」「デコード」を切り替えると現在のテキストをすぐに変換します。デコードは UTF-8 テキストのみ表示します。単独のサロゲートは位置を示してエラーにします。",
    variant: "Standard は +、/ と末尾の = を使い、URL-safe は -、_ を使って末尾の = を除きます。切り替えると現在のテキストやファイルの結果を更新します。読み込み中のファイルには最新の選択を使います。",
    file: "「エンコード」で任意のファイルを選ぶかドロップすると、元のバイト列を変換します。5 MiB を超えると注意を表示し、処理を続けます。ファイル全体と Base64 の結果をメモリに保持します。",
    uri: "ファイルの変換結果に data:<mime>;base64, を付けます。MIME タイプはファイルから取得し、空なら application/octet-stream を使います。空のファイルにも付けられます。",
    swap: "現在の入力と出力を入れ替えます。モードは変わりません。待機中のテキスト変換を取り消し、入れ替えた値をそのまま残します。",
    copy: "表示中の出力全体をコピーします。有効な Data URI の接頭辞も含みます。失敗した場合は出力を選択し、手動でコピーしてください。",
  }, copyFail: 'コピーできませんでした。出力を選択して手動でコピーしてください。', loneSurrogate: '{n} 文字目：単独のサロゲート（絵文字などの半分）は UTF-8 にエンコードできません。', largeFile: 'ファイルが大きいため、エンコードに数秒かかることがあります。', readFailed: 'ファイルを読み込めませんでした。', dataUri: 'Data URI の接頭辞を付ける', encode: 'エンコード', decode: 'デコード', swap: '入れ替え', clear: 'クリア', copy: 'コピー', copied: 'コピー済み！', plainText: 'プレーンテキスト', base64: 'Base64', encodedOk: 'エンコードしました。', decodedOk: 'デコードしました。', fileEncoded: 'ファイルをエンコードしました。', encodePh: 'エンコードするテキストを入力...', decodePh: 'デコードする Base64 文字列を入力...', b64OutPh: 'Base64 出力がここに表示されます...', decodedOutPh: 'デコードされたテキストがここに表示されます...', filePh: 'ファイルを読み込みました — テキスト入力をクリア', invalidBase64: '無効な Base64 入力です。入力内容を確認して再試行してください。', dropText: 'ファイルをここにドロップ、または', dropAction: 'クリックして選択' },
  ko: { modeLabel: "모드", variantLabel: "알파벳", fileLabel: "파일", selectFile: "파일 선택", tips: {
    mode: "텍스트는 UTF-8로 처리합니다. 입력을 멈추고 0.3초 뒤 변환하며, 인코딩 또는 디코딩 모드를 바꾸면 현재 텍스트를 즉시 변환합니다. 디코딩은 UTF-8 텍스트만 표시합니다. 짝이 없는 서로게이트는 위치와 함께 오류를 표시합니다.",
    variant: "Standard는 +, /와 끝의 = 패딩을 사용합니다. URL-safe는 -, _를 사용하고 끝의 =를 제거합니다. 바꾸면 현재 텍스트나 파일 결과가 갱신됩니다. 읽는 중인 파일에는 최신 선택을 적용합니다.",
    file: "인코딩 모드에서 파일을 선택하거나 끌어 놓으면 원본 바이트를 변환합니다. 5 MiB를 넘으면 안내를 표시하고 처리를 계속합니다. 파일 전체와 Base64 결과를 메모리에 보관합니다.",
    uri: "파일 변환 결과 앞에 data:<mime>;base64,를 붙입니다. MIME 유형은 파일에서 읽으며, 없으면 application/octet-stream을 사용합니다. 빈 파일에도 접두사를 붙일 수 있습니다.",
    swap: "현재 입력과 출력을 서로 바꿉니다. 모드는 유지됩니다. 대기 중인 텍스트 변환을 취소하고 바뀐 값을 그대로 둡니다.",
    copy: "표시된 출력 전체를 복사합니다. Data URI 접두사가 켜져 있으면 함께 복사합니다. 실패하면 출력을 선택하여 직접 복사하세요.",
  }, copyFail: '복사하지 못했습니다. 출력을 선택하여 직접 복사하세요.', loneSurrogate: '{n}번째 문자: 짝이 없는 서로게이트(이모지 등 문자의 절반)는 UTF-8로 인코딩할 수 없습니다.', largeFile: '파일이 커서 인코딩에 몇 초 걸릴 수 있습니다.', readFailed: '파일을 읽을 수 없습니다.', dataUri: 'Data URI 접두사 포함', encode: '인코딩', decode: '디코딩', swap: '교체', clear: '지우기', copy: '복사', copied: '복사됨!', plainText: '일반 텍스트', base64: 'Base64', encodedOk: '인코딩 완료.', decodedOk: '디코딩 완료.', fileEncoded: '파일 인코딩 완료.', encodePh: '인코딩할 텍스트를 입력...', decodePh: '디코딩할 Base64 문자열을 입력...', b64OutPh: 'Base64 출력이 여기에 표시됩니다...', decodedOutPh: '디코딩된 텍스트가 여기에 표시됩니다...', filePh: '파일이 로드됨 — 텍스트 입력 초기화됨', invalidBase64: '유효하지 않은 Base64 입력입니다. 입력을 확인하고 다시 시도하세요.', dropText: '파일을 여기에 끌어다 놓거나 ', dropAction: '클릭하여 선택' }
} as const;

const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="b64-wrap">
    <div class="b64-controls">
      <div class="b64-option">
        <div class="b64-mode zt-segmented" role="group" aria-label={T.modeLabel}>
          <label><input type="radio" name="b64mode" value="encode" checked /> <span>{T.encode}</span></label>
          <label><input type="radio" name="b64mode" value="decode" /> <span>{T.decode}</span></label>
        </div>
        <Toggletip id="b64-tip-mode" about={T.modeLabel} lang={lang}>{TIPS.mode}</Toggletip>
      </div>
      <div class="b64-option">
        <div class="b64-variant zt-segmented" role="group" aria-label={T.variantLabel}>
          <label><input type="radio" name="b64variant" value="standard" checked /> Standard</label>
          <label><input type="radio" name="b64variant" value="urlsafe" /> URL-safe</label>
        </div>
        <Toggletip id="b64-tip-variant" about={T.variantLabel} lang={lang}>{TIPS.variant}</Toggletip>
      </div>
      <div class="b64-actions">
        <div class="b64-option">
          <button id="b64-swap" class="btn-secondary" type="button">{T.swap}</button>
          <Toggletip id="b64-tip-swap" about={T.swap} lang={lang}>{TIPS.swap}</Toggletip>
        </div>
        <button id="b64-clear" class="btn-ghost" type="button">{T.clear}</button>
      </div>
    </div>

    <div id="b64-status" class="b64-status" aria-live="polite"></div>

    <div class="b64-panels zt-io">
      <div class="b64-row b64-input-row zt-io-pane">
        <div class="b64-head">
          <label for="b64-input" id="b64-input-label"><span>{T.plainText}</span></label>
        </div>
        <div class="b64-file-entry">
          <div id="b64-drop" class="b64-drop" role="button" tabindex="0">
            <div class="b64-drop-inner">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
              </svg>
              <span>{T.dropText}<strong>{T.dropAction}</strong></span>
            </div>
            <input type="file" id="b64-file" class="b64-file-input" aria-label={T.selectFile} />
          </div>
          <Toggletip id="b64-tip-file" about={T.fileLabel} lang={lang}>{TIPS.file}</Toggletip>
        </div>
        <div id="b64-file-info" class="b64-file-info" hidden></div>
        <div id="b64-uri-row" class="b64-uri-row" hidden>
          <label><input type="checkbox" id="b64-uri-toggle" /> {T.dataUri}</label>
          <Toggletip id="b64-tip-uri" about={T.dataUri} lang={lang}>{TIPS.uri}</Toggletip>
        </div>
        <textarea id="b64-input" class="tool-textarea b64-box zt-io-fill" placeholder={T.encodePh} spellcheck="false"></textarea>
      </div>
      <div id="b64-output-pane" class="b64-row b64-output-row zt-io-pane" data-empty="true">
        <div class="b64-head">
          <label for="b64-output" id="b64-output-label"><span>{T.base64}</span></label>
          <div class="b64-option b64-copy-controls">
            <button id="b64-copy" class="btn-copy" type="button">{T.copy}</button>
            <Toggletip id="b64-tip-copy" about={T.copy} lang={lang}>{TIPS.copy}</Toggletip>
          </div>
        </div>
        <textarea id="b64-output" class="tool-textarea b64-box zt-io-fill" placeholder={T.b64OutPh} readonly spellcheck="false"></textarea>
      </div>
    </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {

      var inputEl = document.getElementById('b64-input');
      var outputEl = document.getElementById('b64-output');
      var outputPane = document.getElementById('b64-output-pane');
      var statusEl = document.getElementById('b64-status');
      var copyBtn = document.getElementById('b64-copy');
      var inputLabel = document.getElementById('b64-input-label');
      var outputLabel = document.getElementById('b64-output-label');
      var dropEl = document.getElementById('b64-drop');
      var fileInput = document.getElementById('b64-file');
      var fileInfoEl = document.getElementById('b64-file-info');
      var uriRowEl = document.getElementById('b64-uri-row');
      var uriToggle = document.getElementById('b64-uri-toggle');
      var mode = 'encode';
      var variant = 'standard';
      var rawB64 = '';
      var currentMime = '';
      var lastValidB64Output = '';
      var fileRevision = 0;
      var activeReader = null;
      var copyRevision = 0;
      var copyTimer = null;
      var copyError = false;

      function updateOutputState() {
        outputPane.setAttribute('data-empty', outputEl.value ? 'false' : 'true');
      }

      function setStatus(msg, isError) {
        copyError = false;
        statusEl.textContent = msg;
        statusEl.className = 'b64-status ' + (isError ? 'error' : 'success');
        updateOutputState();
      }

      function showError(val) {
        outputEl.value = '';
        var at = mode === 'encode' ? loneSurrogateAt(val) : -1;
        setStatus(at > 0 ? t.loneSurrogate.replace('{n}', String(at)) : t.invalidBase64, true);
      }

      function clearStatus() {
        copyError = false;
        statusEl.textContent = '';
        statusEl.className = 'b64-status';
        updateOutputState();
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        if (copyError) clearStatus();
      }

      function invalidateFileRead() {
        fileRevision++;
        if (activeReader && activeReader.readyState === 1) activeReader.abort();
        activeReader = null;
      }

      function clearFileState() {
        invalidateCopy();
        invalidateFileRead();
        fileInput.value = '';
        fileInfoEl.hidden = true;
        fileInfoEl.innerHTML = '';
        uriRowEl.hidden = true;
        uriToggle.checked = false;
        rawB64 = '';
        currentMime = '';
        inputEl.placeholder = mode === 'encode' ? t.encodePh : t.decodePh;
      }

      /* ── engine:start ── */
      // 1-based position (in code points) of the first unpaired UTF-16 surrogate, or -1.
      // encodeURIComponent throws on one, which used to show "Invalid Base64 input" in Encode mode.
      function loneSurrogateAt(text) {
        var m = /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(^|[^\uD800-\uDBFF])[\uDC00-\uDFFF]/.exec(text);
        if (!m) return -1;
        return Array.from(text.slice(0, m.index + (m[1] ? m[1].length : 0))).length + 1;
      }

      // Convert existing Base64 output to the other alphabet (RFC 4648 §4 / §5)
      function switchVariant(b64, to) {
        if (to === 'urlsafe') return b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
        var s = b64.replace(/-/g, '+').replace(/_/g, '/');
        var pad = s.length % 4;
        return pad === 2 ? s + '==' : pad === 3 ? s + '=' : s;
      }
      /* ── engine:end ── */

      function toUrlSafe(b64) {
        return b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      }

      // Drop the ASCII whitespace that atob() drops in Standard mode (tab, LF, FF, CR, space)
      // before the padding is counted, so wrapped URL-safe text decodes like wrapped Standard text.
      function fromUrlSafe(b64url) {
        var b64 = b64url.replace(/[\t\n\f\r ]/g, '').replace(/-/g, '+').replace(/_/g, '/');
        // restore padding
        var pad = b64.length % 4;
        if (pad === 2) b64 += '==';
        else if (pad === 3) b64 += '=';
        return b64;
      }

      function encodeText(text) {
        var b64 = btoa(unescape(encodeURIComponent(text)));
        return variant === 'urlsafe' ? toUrlSafe(b64) : b64;
      }

      function decodeText(input) {
        var b64 = variant === 'urlsafe' ? fromUrlSafe(input.trim()) : input.trim();
        return decodeURIComponent(escape(atob(b64)));
      }

      function arrayBufferToBase64(buffer) {
        var bytes = new Uint8Array(buffer);
        var binary = '';
        var chunk = 8192;
        for (var i = 0; i < bytes.length; i += chunk) {
          binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
        }
        return btoa(binary);
      }

      function formatBytes(n) {
        if (n < 1024) return n + ' B';
        if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1048576).toFixed(2) + ' MB';
      }

      function esc(s) {
        var d = document.createElement('span');
        d.textContent = s;
        return d.innerHTML;
      }

      function updateLabels() {
        if (mode === 'encode') {
          inputLabel.querySelector('span').textContent = t.plainText;
          outputLabel.querySelector('span').textContent = t.base64;
          inputEl.placeholder = t.encodePh;
          outputEl.placeholder = t.b64OutPh;
          dropEl.hidden = false;
        } else {
          inputLabel.querySelector('span').textContent = t.base64;
          outputLabel.querySelector('span').textContent = t.plainText;
          inputEl.placeholder = t.decodePh;
          outputEl.placeholder = t.decodedOutPh;
          dropEl.hidden = true;
          fileInfoEl.hidden = true;
        }
      }

      function applyUriPrefix(b64) {
        return uriToggle.checked && currentMime
          ? 'data:' + currentMime + ';base64,' + b64
          : b64;
      }

      function processFile(file) {
        invalidateCopy();
        invalidateFileRead();
        clearTimeout(_b64LiveTimer);
        clearTimeout(_b64SaveTimer);
        rawB64 = '';
        currentMime = '';
        outputEl.value = '';
        lastValidB64Output = '';
        fileInfoEl.hidden = true;
        fileInfoEl.innerHTML = '';
        uriRowEl.hidden = true;
        clearStatus();
        if (file.size > 5 * 1024 * 1024) {
          setStatus(t.largeFile, false);
        }
        var revision = fileRevision;
        var reader = new FileReader();
        activeReader = reader;
        reader.onload = function (e) {
          if (revision !== fileRevision) return;
          invalidateCopy();
          activeReader = null;
          var b64 = arrayBufferToBase64(e.target.result);
          if (variant === 'urlsafe') b64 = toUrlSafe(b64);
          rawB64 = b64;
          currentMime = file.type || 'application/octet-stream';
          outputEl.value = applyUriPrefix(b64);
          inputEl.value = '';
          inputEl.placeholder = t.filePh;
          fileInfoEl.innerHTML =
            '<strong>' + esc(file.name) + '</strong> &mdash; ' +
            esc(currentMime) + ' &mdash; ' + formatBytes(file.size);
          fileInfoEl.hidden = false;
          uriRowEl.hidden = false;
          setStatus(t.fileEncoded, false);
          window.trackTool && window.trackTool('base64', 'encode_file');
        };
        reader.onerror = function () {
          if (revision !== fileRevision) return;
          invalidateCopy();
          activeReader = null;
          setStatus(t.readFailed, true);
        };
        reader.readAsArrayBuffer(file);
      }

      uriToggle.addEventListener('change', function () {
        invalidateCopy();
        if (currentMime) outputEl.value = applyUriPrefix(rawB64);
        updateOutputState();
      });

      // Restore saved input
      if (window.ztPersist) {
        var _b64Saved = window.ztPersist.load('base64')['input'];
        if (_b64Saved) inputEl.value = _b64Saved;
      }

      // Real-time encode/decode on input (debounced 300ms) + save at 500ms
      var _b64LiveTimer = null;
      var _b64SaveTimer = null;
      inputEl.addEventListener('input', function () {
        clearFileState();
        clearTimeout(_b64LiveTimer);
        clearTimeout(_b64SaveTimer);
        _b64LiveTimer = setTimeout(function () { convert(false); }, 300);
        _b64SaveTimer = setTimeout(function () {
          if (window.ztPersist) window.ztPersist.save('base64', { input: inputEl.value });
        }, 500);
      });

      document.querySelectorAll('input[name="b64mode"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
          mode = this.value;
          clearTimeout(_b64LiveTimer);
          clearFileState();
          updateLabels();
          clearStatus();
          outputEl.value = '';
          lastValidB64Output = '';
          convert(true);
        });
      });

      document.querySelectorAll('input[name="b64variant"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
          variant = this.value;
          invalidateCopy();
          if (mode !== 'encode') { convert(true); return; }
          if (activeReader) return;
          if (currentMime) {
            rawB64 = switchVariant(rawB64, variant);
            outputEl.value = applyUriPrefix(rawB64);
            updateOutputState();
          } else {
            convert(true);
          }
        });
      });

      function convert(track) {
        clearTimeout(_b64LiveTimer);
        invalidateCopy();
        if (activeReader) return;
        var val = inputEl.value;
        if (!val && currentMime) { clearStatus(); return; }
        clearFileState();
        if (!val) { outputEl.value = ''; lastValidB64Output = ''; clearStatus(); return; }
        try {
          if (mode === 'encode') {
            outputEl.value = encodeText(val);
            lastValidB64Output = outputEl.value;
            setStatus(t.encodedOk, false);
            track && window.trackTool && window.trackTool('base64', 'encode');
          } else {
            outputEl.value = decodeText(val);
            lastValidB64Output = outputEl.value;
            setStatus(t.decodedOk, false);
            track && window.trackTool && window.trackTool('base64', 'decode');
          }
        } catch (e) {
          showError(val);
        }
      }

      document.getElementById('b64-swap').addEventListener('click', function () {
        clearTimeout(_b64LiveTimer);
        clearFileState();
        var tmp = inputEl.value;
        inputEl.value = outputEl.value;
        outputEl.value = tmp;
        clearStatus();
      });

      function clearTool(clearSaved) {
        clearTimeout(_b64LiveTimer);
        clearTimeout(_b64SaveTimer);
        clearFileState();
        inputEl.value = '';
        outputEl.value = '';
        lastValidB64Output = '';
        clearStatus();
        if (clearSaved && window.ztPersist) window.ztPersist.clear('base64');
      }

      document.getElementById('b64-clear').addEventListener('click', function () { clearTool(true); });
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var widget = document.querySelector('.b64-wrap');
        if (!widget || !widget.contains(document.activeElement)) return;
        clearTool(false);
      });

      copyBtn.addEventListener('click', function () {
        if (!outputEl.value) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        function done() {
          if (revision !== copyRevision) return;
          if (copyError) clearStatus();
          copyBtn.textContent = t.copied;
          copyTimer = setTimeout(function () {
            if (revision === copyRevision) copyBtn.textContent = t.copy;
          }, 1500);
        }
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(t.copyFail, true);
          copyError = true;
        }
        try {
          navigator.clipboard.writeText(outputEl.value).then(done, failed);
        } catch (e) { failed(); }
      });

      /* ── Drop zone ── */
      dropEl.addEventListener('click', function (e) {
        if (e.target !== fileInput) fileInput.click();
      });

      dropEl.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        if (e.ctrlKey || e.metaKey || e.altKey || e.shiftKey) return;
        fileInput.click();
      });

      fileInput.addEventListener('change', function () {
        if (this.files && this.files[0]) processFile(this.files[0]);
      });

      dropEl.addEventListener('dragover', function (e) {
        e.preventDefault();
        dropEl.classList.add('drag-over');
      });

      dropEl.addEventListener('dragleave', function (e) {
        if (!dropEl.contains(e.relatedTarget)) dropEl.classList.remove('drag-over');
      });

      dropEl.addEventListener('drop', function (e) {
        e.preventDefault();
        dropEl.classList.remove('drag-over');
        var file = e.dataTransfer.files[0];
        if (file) processFile(file);
      });

      if (inputEl.value) convert(false);
    })();
  </script>
</div>

<style>
  .b64-wrap { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; }
  .b64-wrap [hidden] { display: none; }
  .b64-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 0.9rem; flex: none; }
  .b64-option { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .b64-actions { display: flex; gap: 0.5rem; margin-left: auto; }
  .b64-wrap .b64-actions .btn-secondary,
  .b64-wrap .b64-actions .btn-ghost { flex: none; }
  .b64-mode, .b64-variant { padding: 3px; background: var(--color-bg-secondary); font-size: 0.88rem; }
  .b64-mode label, .b64-variant label { position: relative; display: flex; align-items: center; padding: 0.3rem 0.65rem; border-radius: var(--radius-pill); cursor: pointer; white-space: nowrap; color: var(--color-text-secondary); }
  .b64-mode input, .b64-variant input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .b64-mode label:has(input:checked), .b64-variant label:has(input:checked) { background: var(--color-surface); color: var(--color-primary); }
  .b64-mode label:has(input:focus-visible), .b64-variant label:has(input:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: 1px; }
  .b64-status { flex: none; height: 2.8em; line-height: 1.4; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; }
  .b64-status.success { color: var(--color-success); }
  .b64-status.error { color: var(--color-danger); }
  .b64-head { display: flex; align-items: center; gap: 0.4rem; min-height: 32px; flex: none; }
  .b64-head label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .b64-copy-controls { margin-left: auto; }
  .b64-file-entry { display: flex; align-items: center; gap: 0.25rem; flex: none; min-width: 0; }
  .b64-file-entry:has(.b64-drop[hidden]) { display: none; }
  .b64-drop { position: relative; flex: 1; min-width: 0; border: 2px dashed var(--color-border); border-radius: var(--radius-sm); padding: 0.65rem 0.75rem; cursor: pointer; background: var(--color-bg-secondary); }
  .b64-drop:hover, .b64-drop.drag-over { border-color: var(--color-primary); background: var(--color-bg); }
  .b64-drop:focus-visible, .b64-drop:has(input:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .b64-drop-inner { display: flex; align-items: center; gap: 0.5rem; color: var(--color-text-secondary); font-size: 0.85rem; pointer-events: none; user-select: none; }
  .b64-drop-inner svg { flex: none; }
  .b64-file-input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
  .b64-file-info { flex: none; max-height: 2.8em; line-height: 1.4; overflow: auto; overflow-wrap: anywhere; font-size: 0.82rem; color: var(--color-text-secondary); }
  .b64-uri-row { display: flex; align-items: center; gap: 0.25rem; flex: none; font-size: 0.85rem; color: var(--color-text-secondary); }
  .b64-uri-row label { display: flex; align-items: center; gap: 0.4rem; min-width: 0; cursor: pointer; }
  .b64-box { width: 100%; overflow: auto; font-family: var(--font-mono); font-size: 0.88rem; }
  @media (max-width: 860px) {
    .b64-output-row[data-empty="true"] { display: none; }
    .b64-box { height: 160px; }
  }
  @media (max-width: 640px) {
    .b64-controls { gap: 0.4rem 0.65rem; }
    .b64-actions { margin-left: 0; }
    .b64-mode label, .b64-variant label { min-height: 44px; padding-left: 0.5rem; padding-right: 0.5rem; }
    .b64-status { height: 4.2em; }
    .b64-box { height: 120px; }
  }
</style>
