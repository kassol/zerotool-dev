---
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: { copyFail: 'Could not copy. Please select and copy the output manually.', loneSurrogate: 'Position {n}: a lone surrogate (half of an emoji or other character) cannot be encoded as UTF-8.', largeFile: 'Large file — encoding may take a few seconds.', readFailed: 'Could not read the file.', dataUri: 'Include Data URI prefix', encode: 'Encode', decode: 'Decode', swap: 'Swap', clear: 'Clear', copy: 'Copy', copied: 'Copied!', plainText: 'Plain Text', base64: 'Base64', encodedOk: 'Encoded.', decodedOk: 'Decoded.', fileEncoded: 'File encoded.', encodePh: 'Enter text to encode...', decodePh: 'Enter Base64 string to decode...', b64OutPh: 'Base64 output appears here...', decodedOutPh: 'Decoded text appears here...', filePh: 'File loaded — text input cleared', invalidBase64: 'Invalid Base64 input. Please check your input and try again.', dropText: 'Drop any file here, or ', dropAction: 'click to select' },
  zh: { copyFail: '复制失败。请选中输出内容后手动复制。', loneSurrogate: '第 {n} 个字符：孤立的代理项（emoji 等字符的一半）无法编码为 UTF-8。', largeFile: '文件较大，编码可能需要几秒。', readFailed: '无法读取文件。', dataUri: '加上 Data URI 前缀', encode: '编码', decode: '解码', swap: '交换', clear: '清除', copy: '复制', copied: '已复制！', plainText: '纯文本', base64: 'Base64', encodedOk: '已编码。', decodedOk: '已解码。', fileEncoded: '文件已编码。', encodePh: '输入要编码的文本...', decodePh: '输入要解码的 Base64 字符串...', b64OutPh: 'Base64 输出在这里...', decodedOutPh: '解码文本在这里...', filePh: '文件已加载 — 文本输入已清除', invalidBase64: 'Base64 输入无效，请检查后重试。', dropText: '拖入任意文件，或', dropAction: '点击选择' },
  ja: { copyFail: 'コピーできませんでした。出力を選択して手動でコピーしてください。', loneSurrogate: '{n} 文字目：単独のサロゲート（絵文字などの半分）は UTF-8 にエンコードできません。', largeFile: 'ファイルが大きいため、エンコードに数秒かかることがあります。', readFailed: 'ファイルを読み込めませんでした。', dataUri: 'Data URI の接頭辞を付ける', encode: 'エンコード', decode: 'デコード', swap: '入れ替え', clear: 'クリア', copy: 'コピー', copied: 'コピー済み！', plainText: 'プレーンテキスト', base64: 'Base64', encodedOk: 'エンコードしました。', decodedOk: 'デコードしました。', fileEncoded: 'ファイルをエンコードしました。', encodePh: 'エンコードするテキストを入力...', decodePh: 'デコードする Base64 文字列を入力...', b64OutPh: 'Base64 出力がここに表示されます...', decodedOutPh: 'デコードされたテキストがここに表示されます...', filePh: 'ファイルを読み込みました — テキスト入力をクリア', invalidBase64: '無効な Base64 入力です。入力内容を確認して再試行してください。', dropText: 'ファイルをここにドロップ、または', dropAction: 'クリックして選択' },
  ko: { copyFail: '복사하지 못했습니다. 출력을 선택하여 직접 복사하세요.', loneSurrogate: '{n}번째 문자: 짝이 없는 서로게이트(이모지 등 문자의 절반)는 UTF-8로 인코딩할 수 없습니다.', largeFile: '파일이 커서 인코딩에 몇 초 걸릴 수 있습니다.', readFailed: '파일을 읽을 수 없습니다.', dataUri: 'Data URI 접두사 포함', encode: '인코딩', decode: '디코딩', swap: '교체', clear: '지우기', copy: '복사', copied: '복사됨!', plainText: '일반 텍스트', base64: 'Base64', encodedOk: '인코딩 완료.', decodedOk: '디코딩 완료.', fileEncoded: '파일 인코딩 완료.', encodePh: '인코딩할 텍스트를 입력...', decodePh: '디코딩할 Base64 문자열을 입력...', b64OutPh: 'Base64 출력이 여기에 표시됩니다...', decodedOutPh: '디코딩된 텍스트가 여기에 표시됩니다...', filePh: '파일이 로드됨 — 텍스트 입력 초기화됨', invalidBase64: '유효하지 않은 Base64 입력입니다. 입력을 확인하고 다시 시도하세요.', dropText: '파일을 여기에 끌어다 놓거나 ', dropAction: '클릭하여 선택' }
} as const;

const T = STRINGS[lang];
---

<div>
  <div class="b64-wrap">
    {/* Mode + variant row */}
    <div class="b64-controls">
      <div class="b64-mode">
        <label>
          <input type="radio" name="b64mode" value="encode" checked /> <span>{T.encode}</span>
        </label>
        <label>
          <input type="radio" name="b64mode" value="decode" /> <span>{T.decode}</span>
        </label>
      </div>
      <div class="b64-variant">
        <label>
          <input type="radio" name="b64variant" value="standard" checked /> Standard
        </label>
        <label>
          <input type="radio" name="b64variant" value="urlsafe" /> URL-safe
        </label>
      </div>
    </div>

    {/* File drop zone (encode mode only) */}
    <div id="b64-drop" class="b64-drop" role="button" tabindex="0">
      <div class="b64-drop-inner">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
        </svg>
        <span>{T.dropText}<strong>{T.dropAction}</strong></span>
      </div>
      <input type="file" id="b64-file" class="b64-file-input" aria-label="Select file" />
    </div>

    {/* File info (shown after file dropped) */}
    <div id="b64-file-info" class="b64-file-info" hidden></div>

    {/* Data URI toggle (encode mode + file loaded only) */}
    <div id="b64-uri-row" class="b64-uri-row" hidden>
      <label>
        <input type="checkbox" id="b64-uri-toggle" />
        {T.dataUri} (<code>data:&lt;mime&gt;;base64,…</code>)
      </label>
    </div>

    <div class="b64-row">
      <label for="b64-input" id="b64-input-label"><span>{T.plainText}</span></label>
      <textarea
        id="b64-input"
        placeholder={T.encodePh}
        spellcheck="false"
      ></textarea>
    </div>

    <div class="b64-actions">
      <button id="b64-run" class="btn-primary">{T.encode}</button>
      <button id="b64-swap" class="btn-secondary">{T.swap}</button>
      <button id="b64-clear" class="btn-ghost">{T.clear}</button>
    </div>

    <div id="b64-status" class="b64-status" aria-live="polite"></div>

    <div class="b64-row b64-output-row">
      <label for="b64-output" id="b64-output-label">
        <span>{T.base64}</span>
        <button id="b64-copy" class="btn-copy" type="button">{T.copy}</button>
      </label>
      <textarea
        id="b64-output"
        placeholder={T.b64OutPh}
        readonly
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <script is:inline define:vars={{ t: T }}>
    (function () {

      var inputEl = document.getElementById('b64-input');
      var outputEl = document.getElementById('b64-output');
      var statusEl = document.getElementById('b64-status');
      var runBtn = document.getElementById('b64-run');
      var copyBtn = document.getElementById('b64-copy');
      var inputLabel = document.getElementById('b64-input-label');
      var outputLabel = document.getElementById('b64-output-label');
      var dropEl = document.getElementById('b64-drop');
      var fileInput = document.getElementById('b64-file');
      var fileInfoEl = document.getElementById('b64-file-info');
      var uriRowEl = document.getElementById('b64-uri-row');
      var uriToggle = document.getElementById('b64-uri-toggle');
      var mode = 'encode';
      var variant = 'standard';
      var rawB64 = '';
      var currentMime = '';
      var lastValidB64Output = '';
      var fileRevision = 0;
      var activeReader = null;
      var copyRevision = 0;
      var copyTimer = null;
      var copyError = false;

      function setStatus(msg, isError) {
        copyError = false;
        statusEl.textContent = msg;
        statusEl.className = 'b64-status ' + (isError ? 'error' : 'success');
      }

      function showError(val) {
        outputEl.value = '';
        var at = mode === 'encode' ? loneSurrogateAt(val) : -1;
        setStatus(at > 0 ? t.loneSurrogate.replace('{n}', String(at)) : t.invalidBase64, true);
      }

      function clearStatus() {
        copyError = false;
        statusEl.textContent = '';
        statusEl.className = 'b64-status';
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        if (copyError) clearStatus();
      }

      function invalidateFileRead() {
        fileRevision++;
        if (activeReader && activeReader.readyState === 1) activeReader.abort();
        activeReader = null;
      }

      function clearFileState() {
        invalidateCopy();
        invalidateFileRead();
        fileInput.value = '';
        fileInfoEl.hidden = true;
        fileInfoEl.innerHTML = '';
        uriRowEl.hidden = true;
        uriToggle.checked = false;
        rawB64 = '';
        currentMime = '';
        inputEl.placeholder = mode === 'encode' ? t.encodePh : t.decodePh;
      }

      /* ── engine:start ── */
      // 1-based position (in code points) of the first unpaired UTF-16 surrogate, or -1.
      // encodeURIComponent throws on one, which used to show "Invalid Base64 input" in Encode mode.
      function loneSurrogateAt(text) {
        var m = /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(^|[^\uD800-\uDBFF])[\uDC00-\uDFFF]/.exec(text);
        if (!m) return -1;
        return Array.from(text.slice(0, m.index + (m[1] ? m[1].length : 0))).length + 1;
      }

      // Convert existing Base64 output to the other alphabet (RFC 4648 §4 / §5)
      function switchVariant(b64, to) {
        if (to === 'urlsafe') return b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
        var s = b64.replace(/-/g, '+').replace(/_/g, '/');
        var pad = s.length % 4;
        return pad === 2 ? s + '==' : pad === 3 ? s + '=' : s;
      }
      /* ── engine:end ── */

      function toUrlSafe(b64) {
        return b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      }

      function fromUrlSafe(b64url) {
        var b64 = b64url.replace(/-/g, '+').replace(/_/g, '/');
        // restore padding
        var pad = b64.length % 4;
        if (pad === 2) b64 += '==';
        else if (pad === 3) b64 += '=';
        return b64;
      }

      function encodeText(text) {
        var b64 = btoa(unescape(encodeURIComponent(text)));
        return variant === 'urlsafe' ? toUrlSafe(b64) : b64;
      }

      function decodeText(input) {
        var b64 = variant === 'urlsafe' ? fromUrlSafe(input.trim()) : input.trim();
        return decodeURIComponent(escape(atob(b64)));
      }

      function arrayBufferToBase64(buffer) {
        var bytes = new Uint8Array(buffer);
        var binary = '';
        var chunk = 8192;
        for (var i = 0; i < bytes.length; i += chunk) {
          binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
        }
        return btoa(binary);
      }

      function formatBytes(n) {
        if (n < 1024) return n + ' B';
        if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1048576).toFixed(2) + ' MB';
      }

      function esc(s) {
        var d = document.createElement('span');
        d.textContent = s;
        return d.innerHTML;
      }

      function updateLabels() {
        if (mode === 'encode') {
          inputLabel.querySelector('span').textContent = t.plainText;
          outputLabel.querySelector('span').textContent = t.base64;
          inputEl.placeholder = t.encodePh;
          outputEl.placeholder = t.b64OutPh;
          runBtn.textContent = t.encode;
          dropEl.hidden = false;
        } else {
          inputLabel.querySelector('span').textContent = t.base64;
          outputLabel.querySelector('span').textContent = t.plainText;
          inputEl.placeholder = t.decodePh;
          outputEl.placeholder = t.decodedOutPh;
          runBtn.textContent = t.decode;
          dropEl.hidden = true;
          fileInfoEl.hidden = true;
        }
      }

      function applyUriPrefix(b64) {
        return uriToggle.checked && currentMime
          ? 'data:' + currentMime + ';base64,' + b64
          : b64;
      }

      function processFile(file) {
        invalidateCopy();
        invalidateFileRead();
        clearTimeout(_b64LiveTimer);
        clearTimeout(_b64SaveTimer);
        rawB64 = '';
        currentMime = '';
        outputEl.value = '';
        lastValidB64Output = '';
        fileInfoEl.hidden = true;
        fileInfoEl.innerHTML = '';
        uriRowEl.hidden = true;
        clearStatus();
        if (file.size > 5 * 1024 * 1024) {
          setStatus(t.largeFile, false);
        }
        var revision = fileRevision;
        var reader = new FileReader();
        activeReader = reader;
        reader.onload = function (e) {
          if (revision !== fileRevision) return;
          invalidateCopy();
          activeReader = null;
          var b64 = arrayBufferToBase64(e.target.result);
          if (variant === 'urlsafe') b64 = toUrlSafe(b64);
          rawB64 = b64;
          currentMime = file.type || 'application/octet-stream';
          outputEl.value = applyUriPrefix(b64);
          inputEl.value = '';
          inputEl.placeholder = t.filePh;
          fileInfoEl.innerHTML =
            '<strong>' + esc(file.name) + '</strong> &mdash; ' +
            esc(currentMime) + ' &mdash; ' + formatBytes(file.size);
          fileInfoEl.hidden = false;
          uriRowEl.hidden = false;
          setStatus(t.fileEncoded, false);
          window.trackTool && window.trackTool('base64', 'encode_file');
        };
        reader.onerror = function () {
          if (revision !== fileRevision) return;
          invalidateCopy();
          activeReader = null;
          setStatus(t.readFailed, true);
        };
        reader.readAsArrayBuffer(file);
      }

      uriToggle.addEventListener('change', function () {
        invalidateCopy();
        if (currentMime) outputEl.value = applyUriPrefix(rawB64);
      });

      // Restore saved input
      if (window.ztPersist) {
        var _b64Saved = window.ztPersist.load('base64')['input'];
        if (_b64Saved) inputEl.value = _b64Saved;
      }

      // Real-time encode/decode on input (debounced 300ms) + save at 500ms
      var _b64LiveTimer = null;
      var _b64SaveTimer = null;
      inputEl.addEventListener('input', function () {
        clearFileState();
        clearTimeout(_b64LiveTimer);
        clearTimeout(_b64SaveTimer);
        _b64LiveTimer = setTimeout(function () { convert(false); }, 300);
        _b64SaveTimer = setTimeout(function () {
          if (window.ztPersist) window.ztPersist.save('base64', { input: inputEl.value });
        }, 500);
      });

      document.querySelectorAll('input[name="b64mode"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
          mode = this.value;
          clearTimeout(_b64LiveTimer);
          clearFileState();
          updateLabels();
          clearStatus();
          outputEl.value = '';
          lastValidB64Output = '';
        });
      });

      document.querySelectorAll('input[name="b64variant"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
          variant = this.value;
          invalidateCopy();
          if (mode !== 'encode') { if (inputEl.value) runBtn.click(); return; }
          if (activeReader) return;
          if (currentMime) {
            rawB64 = switchVariant(rawB64, variant);
            outputEl.value = applyUriPrefix(rawB64);
          } else if (inputEl.value) {
            runBtn.click();
          }
        });
      });

      function convert(track) {
        clearTimeout(_b64LiveTimer);
        invalidateCopy();
        if (activeReader) return;
        var val = inputEl.value;
        if (!val && currentMime) { clearStatus(); return; }
        clearFileState();
        if (!val) { outputEl.value = ''; lastValidB64Output = ''; clearStatus(); return; }
        try {
          if (mode === 'encode') {
            outputEl.value = encodeText(val);
            lastValidB64Output = outputEl.value;
            setStatus(t.encodedOk, false);
            track && window.trackTool && window.trackTool('base64', 'encode');
          } else {
            outputEl.value = decodeText(val);
            lastValidB64Output = outputEl.value;
            setStatus(t.decodedOk, false);
            track && window.trackTool && window.trackTool('base64', 'decode');
          }
        } catch (e) {
          showError(val);
        }
      }

      runBtn.addEventListener('click', function () { convert(true); });

      document.getElementById('b64-swap').addEventListener('click', function () {
        clearTimeout(_b64LiveTimer);
        clearFileState();
        var tmp = inputEl.value;
        inputEl.value = outputEl.value;
        outputEl.value = tmp;
        clearStatus();
      });

      function clearTool(clearSaved) {
        clearTimeout(_b64LiveTimer);
        clearTimeout(_b64SaveTimer);
        clearFileState();
        inputEl.value = '';
        outputEl.value = '';
        lastValidB64Output = '';
        clearStatus();
        if (clearSaved && window.ztPersist) window.ztPersist.clear('base64');
      }

      document.getElementById('b64-clear').addEventListener('click', function () { clearTool(true); });
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var widget = document.querySelector('.b64-wrap');
        if (!widget || !widget.contains(document.activeElement)) return;
        clearTool(false);
      });

      copyBtn.addEventListener('click', function () {
        if (!outputEl.value) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        function done() {
          if (revision !== copyRevision) return;
          if (copyError) clearStatus();
          copyBtn.textContent = t.copied;
          copyTimer = setTimeout(function () {
            if (revision === copyRevision) copyBtn.textContent = t.copy;
          }, 1500);
        }
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(t.copyFail, true);
          copyError = true;
        }
        try {
          navigator.clipboard.writeText(outputEl.value).then(done, failed);
        } catch (e) { failed(); }
      });

      /* ── Drop zone ── */
      dropEl.addEventListener('click', function (e) {
        if (e.target !== fileInput) fileInput.click();
      });

      dropEl.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        if (e.ctrlKey || e.metaKey || e.altKey || e.shiftKey) return;
        fileInput.click();
      });

      fileInput.addEventListener('change', function () {
        if (this.files && this.files[0]) processFile(this.files[0]);
      });

      dropEl.addEventListener('dragover', function (e) {
        e.preventDefault();
        dropEl.classList.add('drag-over');
      });

      dropEl.addEventListener('dragleave', function (e) {
        if (!dropEl.contains(e.relatedTarget)) dropEl.classList.remove('drag-over');
      });

      dropEl.addEventListener('drop', function (e) {
        e.preventDefault();
        dropEl.classList.remove('drag-over');
        var file = e.dataTransfer.files[0];
        if (file) processFile(file);
      });
    })();
  </script>
</div>

<style>
  .b64-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  .b64-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .b64-mode,
  .b64-variant { display: flex; gap: 1.25rem; font-size: 0.95rem; }
  .b64-mode label,
  .b64-variant label { display: flex; align-items: center; gap: 0.4rem; cursor: pointer; }

  .b64-variant {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
  }

  /* Drop zone */
  .b64-drop {
    position: relative;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.65rem 1rem;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    background: var(--color-bg-secondary);
  }

  .b64-drop:hover,
  .b64-drop.drag-over {
    border-color: var(--color-primary);
    background: var(--color-bg);
  }

  .b64-drop-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    pointer-events: none;
    user-select: none;
  }

  .b64-file-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .b64-file-info {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    padding: 0.25rem 0;
  }

  .b64-uri-row {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .b64-uri-row label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
  }

  .b64-uri-row code {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  .b64-row { display: flex; flex-direction: column; gap: 0.4rem; }

  .b64-row label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .b64-row textarea {
    width: 100%;
    min-height: 140px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    resize: vertical;
    background: var(--color-bg-secondary);
    color: var(--color-text);
  }

  .b64-row textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .b64-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .b64-status { font-size: 0.85rem; min-height: 1.2rem; }
  .b64-status.success { color: #057a55; }
  .b64-status.error { color: #c0392b; }

  /* Mobile: keep the Encode / Decode button in the first viewport. The file drop
     zone moves below the buttons, and textareas are shorter. */
  @media (max-width: 640px) {
    .b64-row textarea { min-height: 100px; }
    .b64-drop,
    .b64-file-info,
    .b64-uri-row { order: 1; }
    .b64-status,
    .b64-output-row { order: 2; }
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .b64-status.success { color: #34d399; }
    :root:not([data-theme="light"]) .b64-status.error { color: #f87171; }
  }
  [data-theme="dark"] .b64-status.success { color: #34d399; }
  [data-theme="dark"] .b64-status.error { color: #f87171; }
</style>
