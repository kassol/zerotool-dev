        setStatus(statusEl, fill(S.statusDone, { format: schemeLabel(identifyHash(line.slice(line.indexOf(':') + 1))) }), 'success');
        var box = outEl.getBoundingClientRect();
        if (box.bottom > window.innerHeight || box.top < 0) outEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        if (window.trackTool) window.trackTool('htpasswd_generator', 'generate');
      } catch (e) {
        if (my === revision) setStatus(statusEl, String(e && e.message || e), 'error');
      } finally {
        setBusy(false);
      }
    }

    function copyText(text, btn, statusTarget) {
      if (!text) return;
      var done = function () {
        btn.textContent = S.copied;
        setTimeout(function () { btn.textContent = S.copy; }, 1500);
      };
      var fallback = function () {
        var ta = document.createElement('textarea');
        ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.body.removeChild(ta);
        if (ok) done(); else setStatus(statusTarget, S.copyFail, 'error');
      };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fallback);
      else fallback();
    }
    function download(text, name) {
      var url = URL.createObjectURL(new Blob([text], { type: 'text/plain;charset=utf-8' }));
      var a = document.createElement('a');
      a.href = url; a.download = name;
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    }

    fmtEl.addEventListener('change', function () { syncFormat(); hideOutput(); });
    [userEl, passEl, costEl, roundsEl].forEach(function (el) {
      el.addEventListener('input', hideOutput);
      el.addEventListener('change', hideOutput);
    });
    [userEl, passEl].forEach(function (el) {
      el.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.metaKey && !e.ctrlKey && !e.isComposing) { e.preventDefault(); generate(); }
      });
    });
    $('htpw-random').addEventListener('click', function () { passEl.value = randomPassword(); hideOutput(); });
    genBtn.addEventListener('click', generate);
    copyBtn.addEventListener('click', function () { copyText(lineEl.textContent, copyBtn, statusEl); });

    // ── Batch ──
    var batchEl = $('htpw-batch'), batchStatus = $('htpw-batch-status'), batchIssues = $('htpw-batch-issues');
    var batchOut = $('htpw-batch-out'), batchResult = $('htpw-batch-result');
    batchEl.addEventListener('input', function () {
      discardPending(); batchOut.hidden = true; batchResult.value = '';
      setStatus(batchStatus, ''); renderIssues(batchIssues, []);
    });
    $('htpw-batch-run').addEventListener('click', async function () {
      if (busy) return;
      var my = revision, parsed = parseBatch(batchEl.value), fmt = fmtEl.value, o = opts();
      var notes = parsed.errors.map(function (e) {
        return { level: 'error', text: fill(S.batchLine, { line: e.line, msg: issueText(e) }) };
      });
      var todo = [];
      parsed.items.forEach(function (it) {
        var pi = checkPassword(it.password, fmt), bad = false;
        pi.forEach(function (i) {
          if (i.level === 'info') return;
          if (i.level === 'error') bad = true;
          notes.push({ level: i.level, text: fill(S.batchLine, { line: it.line, msg: issueText(i) }) });
        });
        checkUser(it.user).forEach(function (i) {
          if (i.level === 'warn') notes.push({ level: 'warn', text: fill(S.batchLine, { line: it.line, msg: issueText(i) }) });
        });
        if (!bad) todo.push(it);
      });
      notes.sort(function (a, b) { return (parseInt(a.text.replace(/\D+/, ''), 10) || 0) - (parseInt(b.text.replace(/\D+/, ''), 10) || 0); });
      renderIssues(batchIssues, notes);
      if (!parsed.items.length && !parsed.errors.length) { setStatus(batchStatus, S.issue_passEmpty, 'error'); batchOut.hidden = true; return; }
      setBusy(true);
      try {
        var lines = [];
        for (var i = 0; i < todo.length; i++) {
          setStatus(batchStatus, fill(S.hashing, { pct: Math.round((i / todo.length) * 100) }), 'info');
          lines.push(buildLine(todo[i].user, await hashPassword(todo[i].password, o, bc)));
          if (my !== revision) return;
        }
        batchResult.value = lines.length ? lines.join('\n') + '\n' : '';
        batchOut.hidden = !lines.length;
        var skipped = parsed.errors.length + (parsed.items.length - todo.length);
        setStatus(batchStatus, fill(S.batchDone, { n: lines.length, skipped: skipped }), skipped ? 'error' : 'success');
        if (window.trackTool) window.trackTool('htpasswd_generator', 'batch');
      } catch (e) {
        if (my === revision) setStatus(batchStatus, String(e && e.message || e), 'error');
      } finally {
        setBusy(false);
      }
    });
    $('htpw-batch-copy').addEventListener('click', function () { copyText(batchResult.value, $('htpw-batch-copy'), batchStatus); });
    $('htpw-batch-download').addEventListener('click', function () { download(batchResult.value, 'htpasswd'); });

    // ── Existing file ──
    var fileEl = $('htpw-file'), fileSummary = $('htpw-file-summary'), fileTable = $('htpw-file-table');
    var fileStatus = $('htpw-file-status'), fileIssues = $('htpw-file-issues');
    var highlight = 0, parseTimer = 0;
    function renderFile() {
      var text = fileEl.value;
      fileTable.textContent = '';
      if (!text.trim()) { fileTable.hidden = true; setStatus(fileSummary, ''); return null; }
      var parsed = parseHtpasswd(text), rows = parsed.lines.filter(function (l) { return l.kind === 'entry' || l.kind === 'invalid'; });
      var entries = 0, noted = 0;
      var table = document.createElement('table');
      table.className = 'htpw-table';
      var head = document.createElement('tr');
      [S.colLine, S.colUser, S.colFormat, S.colNotes].forEach(function (h) {
        var th = document.createElement('th'); th.textContent = h; th.scope = 'col'; head.appendChild(th);
      });
      var thead = document.createElement('thead'); thead.appendChild(head); table.appendChild(thead);
      var tbody = document.createElement('tbody');
      rows.forEach(function (l) {
        if (l.kind === 'entry') entries++;
        if (l.issues && l.issues.length) noted++;
        var tr = document.createElement('tr');
        if (l.n === highlight) tr.className = 'htpw-row--hit';
        var worst = (l.issues || []).some(function (i) { return i.level === 'error'; }) ? 'error' : (l.issues || []).some(function (i) { return i.level === 'warn'; }) ? 'warn' : '';
        var cells = [String(l.n), l.kind === 'entry' ? l.user : l.raw, l.kind === 'entry' && l.hash ? schemeLabel(l.scheme) : '—',
          (l.issues || []).map(issueText).join(' ')];
        cells.forEach(function (c, ci) {
          var td = document.createElement('td'); td.textContent = c;
          if (ci === 3 && worst) td.className = 'htpw-note--' + worst;
          tr.appendChild(td);
        });
        tbody.appendChild(tr);
      });
      table.appendChild(tbody);
      fileTable.appendChild(table);
      fileTable.hidden = rows.length === 0;
      setStatus(fileSummary, fill(S.fileSummary, { entries: entries, notes: noted }), noted ? 'error' : 'none');
      return parsed;
    }
    fileEl.addEventListener('input', function () {
      discardPending();
      highlight = 0;
      clearTimeout(parseTimer);
      parseTimer = setTimeout(renderFile, 150);
    });
    $('htpw-open').addEventListener('click', function () { $('htpw-file-input').click(); });
    $('htpw-file-input').addEventListener('change', function () {
      var f = this.files && this.files[0];
      this.value = '';
      if (!f) return;
      if (f.size > 1048576) { setStatus(fileStatus, S.fileTooBig, 'error'); return; }
      f.text().then(function (t) { fileEl.value = t; highlight = 0; renderFile(); setStatus(fileStatus, ''); });
    });

    function needFile() {
      if (fileEl.value.trim()) return true;
      setStatus(fileStatus, S.fileEmpty, 'error');
      return false;
    }
    function fileUser(parsed) {
      if (userEl.value) return userEl.value;
      var entries = parsed.lines.filter(function (l) { return l.kind === 'entry'; });
      return entries.length === 1 ? entries[0].user : '';
    }
    $('htpw-check').addEventListener('click', async function () {
      if (busy || !needFile()) return;
      var parsed = parseHtpasswd(fileEl.value), user = fileUser(parsed);
      if (!user) { setStatus(fileStatus, S.issue_userEmpty, 'error'); return; }
      if (!passEl.value) { setStatus(fileStatus, S.issue_passEmpty, 'error'); return; }
      var hits = parsed.lines.filter(function (l) { return l.kind === 'entry' && l.user === user; });
      if (!hits.length) { highlight = 0; renderFile(); setStatus(fileStatus, fill(S.checkNoUser, { user: user }), 'error'); return; }
      setBusy(true);
      setStatus(fileStatus, S.checkSlow, 'info');
      var my = revision;
      try {
        var hit = hits[0], r = await verifyPassword(hit.hash, passEl.value, bc);
        if (my !== revision) return;
        var vars = { line: hit.n, user: user, format: schemeLabel(r.scheme.id === r.id ? r.scheme : { id: r.id }) };
        var msg = !r.supported ? fill(S.checkUnsupported, vars) : fill(r.ok ? S.checkMatch : S.checkNoMatch, vars);
        if (hits.length > 1) msg += ' ' + fill(S.checkDup, { user: user, others: hits.slice(1).map(function (h) { return h.n; }).join(', ') });
        highlight = hit.n;
        renderFile();
        setStatus(fileStatus, msg, r.ok ? 'success' : 'error');
      } finally {
        setBusy(false);
      }
    });
    $('htpw-upsert').addEventListener('click', async function () {
      if (busy) return;
      setStatus(fileStatus, '');
      if (!validate(fileIssues, fileStatus)) return;
      var my = revision, values = { user: userEl.value, password: passEl.value, options: opts() };
      setBusy(true);
      try {
        var line = await makeLine(fileStatus, values, my);
        if (my !== revision) return;
        var r = upsertUser(fileEl.value, values.user, line);
        fileEl.value = r.text;
        highlight = r.lines[0];
        renderFile();
        setStatus(fileStatus, fill(r.action === 'added' ? S.added : S.upserted, { user: values.user, lines: r.lines.join(', ') }), 'success');
      } catch (e) {
        if (my === revision) setStatus(fileStatus, String(e && e.message || e), 'error');
      } finally {
        setBusy(false);
      }
    });
    $('htpw-remove').addEventListener('click', function () {
      if (busy || !needFile()) return;
      var user = userEl.value;
      if (!user) { setStatus(fileStatus, S.issue_userEmpty, 'error'); return; }
      var r = removeUser(fileEl.value, user);
      if (!r.lines.length) { setStatus(fileStatus, fill(S.notFoundRemove, { user: user }), 'error'); return; }
      fileEl.value = r.text;
      highlight = 0;
      renderFile();
      setStatus(fileStatus, fill(S.removed, { user: user, lines: r.lines.join(', ') }), 'success');
    });
    $('htpw-file-copy').addEventListener('click', function () { copyText(fileEl.value, $('htpw-file-copy'), fileStatus); });
    $('htpw-file-download').addEventListener('click', function () { if (fileEl.value) download(fileEl.value, 'htpasswd'); });

    // The site-wide Ctrl/⌘+L empties every text field in the widget; reset what depends on them.
    document.addEventListener('keydown', function (e) {
      if (!(e.metaKey || e.ctrlKey) || (e.key !== 'l' && e.key !== 'L')) return;
      var widget = document.querySelector('.tool-widget');
      if (!widget || !widget.contains(document.activeElement)) return;
      discardPending();
      setTimeout(function () {
        hideOutput(); setStatus(statusEl, ''); renderIssues(issuesEl, []);
        batchOut.hidden = true; setStatus(batchStatus, ''); renderIssues(batchIssues, []);
        highlight = 0; renderFile(); setStatus(fileStatus, ''); renderIssues(fileIssues, []);
      }, 0);
    });

    syncFormat();
  })();
</script>

<style>
  .htpw-wrap { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
  .htpw-main { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  .htpw-creds { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 0.75rem; }
  .htpw-field { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .htpw-pass-row { display: flex; gap: 0.5rem; min-width: 0; }
  .htpw-pass-row .tool-input { flex: 1; min-width: 0; }
  .htpw-pass-row .btn-secondary { flex: none; white-space: nowrap; }
  .htpw-opts { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.75rem; }
  .htpw-field--format { flex: 1 1 18rem; }
  .htpw-field--small { flex: 0 0 8.5rem; }
  .htpw-field[hidden] { display: none; }
  .htpw-generate { flex: none; }
  .htpw-out {
    display: flex; align-items: flex-start; gap: 0.6rem; padding: 0.7rem 0.8rem;
    background: var(--color-bg-secondary); border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }
  .htpw-out[hidden] { display: none; }
  .htpw-line {
    flex: 1; min-width: 0; font-family: var(--font-mono); font-size: 0.88rem; line-height: 1.5;
    overflow-wrap: anywhere; word-break: break-all; color: var(--color-text); background: transparent;
  }
  .htpw-wrap .tool-status { margin: 0; }
  .htpw-wrap .tool-status:empty { display: none; }
  .htpw-cmd[hidden] { display: none; }
  .htpw-cmd, .htpw-compat, .htpw-note, .htpw-privacy { margin: 0; font-size: 0.82rem; color: var(--color-text-secondary); line-height: 1.5; }
  .htpw-cmd code { font-family: var(--font-mono); overflow-wrap: anywhere; }
  .htpw-privacy { color: var(--color-text-muted); }
  .htpw-issues { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.84rem; line-height: 1.45; }
  .htpw-issues[hidden] { display: none; }
  .htpw-issue--error { color: var(--color-danger); }
  .htpw-issue--warn { color: var(--color-text); }
  .htpw-issue--info { color: var(--color-text-secondary); }
  .htpw-section {
    border-radius: var(--radius-md); background: var(--color-surface-muted);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }
  .htpw-section > summary {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.6rem; cursor: pointer;
    padding: 0.7rem 0.85rem; font-weight: 650; font-size: 0.92rem; color: var(--color-text);
  }
  .htpw-tip { font-weight: 400; font-size: 0.8rem; color: var(--color-text-secondary); }
  .htpw-section-body { display: flex; flex-direction: column; gap: 0.6rem; padding: 0 0.85rem 0.85rem; min-width: 0; }
  .htpw-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .htpw-result { display: flex; flex-direction: column; gap: 0.5rem; }
  .htpw-result[hidden] { display: none; }
  .htpw-readonly { background: var(--color-bg-secondary); }
  .htpw-file-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .htpw-table-wrap { overflow-x: auto; }
  .htpw-table-wrap[hidden] { display: none; }
  .htpw-wrap :global(.htpw-table) { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
  .htpw-wrap :global(.htpw-table th),
  .htpw-wrap :global(.htpw-table td) {
    text-align: left; vertical-align: top; padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--color-border-soft); overflow-wrap: anywhere;
  }
  .htpw-wrap :global(.htpw-table th) { font-weight: 650; color: var(--color-text-secondary); white-space: nowrap; }
  .htpw-wrap :global(.htpw-table td:nth-child(2)) { font-family: var(--font-mono); }
  .htpw-wrap :global(.htpw-row--hit td) { background: color-mix(in srgb, var(--color-primary) 10%, transparent); }
  .htpw-wrap :global(.htpw-note--error) { color: var(--color-danger); }
  .htpw-wrap :global(.htpw-note--warn) { color: var(--color-text); }

  @media (max-width: 640px) {
    .htpw-creds { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
    .htpw-main { gap: 0.55rem; }
    .htpw-opts { gap: 0.5rem; }
    .htpw-field--format { flex: 1 1 100%; }
    .htpw-field--small { flex: 1 1 0; }
    .htpw-generate { flex: 1 1 0; }
    .htpw-section > summary { min-height: 44px; align-items: center; }
  }
</style>
