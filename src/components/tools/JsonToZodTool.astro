const L = STRINGS[lang];
---

<div
  class="jtz-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-msg-invalid-json={L.msgInvalidJson}
  data-msg-invalid-at={L.msgInvalidAt}
  data-json-parse={JSON.stringify(L.jsonParse)}
  data-msg-failed={L.msgFailed}
  data-msg-generated={L.msgGenerated}
>
  <div class="jtz-config">
    <div class="jtz-name-field">
      <div class="jtz-control-label">
        <label for="jtz-root-name">{L.rootName}</label>
        <Toggletip id="jtz-tip-root-name" lang={lang} about={L.rootName}>{L.tips.rootName}</Toggletip>
      </div>
      <input id="jtz-root-name" type="text" value="User" spellcheck="false" />
    </div>
    <div class="jtz-options">
      <div class="jtz-control-label">
        <label for="jtz-strict"><input id="jtz-strict" type="checkbox" />{L.strictMode}</label>
        <Toggletip id="jtz-tip-strict" lang={lang} about={L.strictMode}>{L.tips.strict}</Toggletip>
      </div>
    </div>
  </div>
  <div class="jtz-actions">
    <div class="jtz-control-label">
      <button id="jtz-convert" class="btn-primary" type="button">{L.generate}</button>
      <Toggletip id="jtz-tip-generate" lang={lang} about={L.generate}>{L.tips.generate}</Toggletip>
    </div>
    <div class="jtz-control-label">
      <button id="jtz-example" class="btn-ghost" type="button">{L.example}</button>
      <Toggletip id="jtz-tip-example" lang={lang} about={L.example}>{L.tips.example}</Toggletip>
    </div>
    <div class="jtz-control-label">
      <button id="jtz-clear" class="btn-ghost" type="button">{L.clear}</button>
      <Toggletip id="jtz-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip>
    </div>
  </div>
  <div id="jtz-status" class="jtz-status" aria-live="polite"></div>

  <div class="jtz-panels zt-io">
    <div class="jtz-panel zt-io-pane">
      <div class="jtz-panel-header">
        <div class="jtz-control-label">
          <label for="jtz-input">{L.jsonInput}</label>
          <Toggletip id="jtz-tip-input" lang={lang} about={L.jsonInput}>{L.tips.input}</Toggletip>
        </div>
      </div>
      <textarea id="jtz-input" class="zt-io-fill" placeholder='{"name": "Alice", "age": 30, "active": true}' spellcheck="false"></textarea>
    </div>
    <div class="jtz-panel jtz-output-pane zt-io-pane">
      <div class="jtz-panel-header">
        <span id="jtz-output-label">{L.zodOutput}</span>
        <div class="jtz-control-label">
          <button id="jtz-copy" class="btn-ghost" type="button">{L.copy}</button>
          <Toggletip id="jtz-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip>
        </div>
      </div>
      <p class="jtz-empty zt-io-fill">{L.empty}</p>
      <pre id="jtz-output" class="jtz-output zt-io-fill" tabindex="0" aria-labelledby="jtz-output-label"><code id="jtz-output-code"></code></pre>
    </div>
  </div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.jtz-wrap')
        : document.querySelector('.jtz-wrap');

      var COPY = wrap ? wrap.dataset.copy : 'Copy';
      var COPIED = wrap ? wrap.dataset.copied : 'Copied!';
      var COPY_FAILED = wrap ? wrap.dataset.copyFailed : 'Copy failed. Please copy the output manually.';
      var MSG_INVALID = wrap ? wrap.dataset.msgInvalidJson : 'Invalid JSON: ';
      var MSG_INVALID_AT = wrap ? wrap.dataset.msgInvalidAt : 'Invalid JSON: line {line}, column {col}, {reason}.';
      var JSON_PARSE = wrap && wrap.dataset.jsonParse ? JSON.parse(wrap.dataset.jsonParse) : {};
      var MSG_FAILED = wrap ? wrap.dataset.msgFailed : 'Could not generate the schema: ';
      var MSG_GENERATED = wrap ? wrap.dataset.msgGenerated : 'Generated.';

      var inputEl = document.getElementById('jtz-input');
      var outputCodeEl = document.getElementById('jtz-output-code');
      var statusEl = document.getElementById('jtz-status');
      var rootNameEl = document.getElementById('jtz-root-name');
      var strictEl = document.getElementById('jtz-strict');
      var copyBtn = document.getElementById('jtz-copy');
      var copyRevision = 0;
      var copyTimer = null;
      var copyFailure = false;

      // Copy is enabled only while there is output to copy.
      function setOutput(text) {
        outputCodeEl.textContent = text;
        copyBtn.disabled = !text;
      }
      setOutput('');

      var EXAMPLE = JSON.stringify({
        id: 1,
        name: "Alice",
        isActive: true,
        score: 9.5,
        tags: ["typescript", "json"],
        address: {
          city: "London",
          zip: "EC1A 1BB"
        },
        friends: [
          { id: 2, name: "Bob" },
          { id: 3, name: "Carol" }
        ],
        metadata: null
      }, null, 2);

      function setStatus(msg, isError) {
        copyFailure = false;
        statusEl.textContent = msg;
        statusEl.className = 'jtz-status ' + (isError ? 'error' : 'success');
      }
      function clearStatus() {
        copyFailure = false;
        statusEl.textContent = '';
        statusEl.className = 'jtz-status';
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        if (copyFailure) clearStatus();
      }

      /* ── engine:start ── */
      // A type name from free text: ECMAScript identifier characters (ID_Start / ID_Continue,
      // $ and _) are kept, runs of other characters are removed and the next character is
      // capitalized (user profile → userProfile). A name that cannot start an identifier gets a
      // T prefix (2fa → T2fa); a reserved word or a TypeScript primitive type name gets a _
      // suffix (class → class_). Returns '' when nothing is left.
      var RESERVED_NAMES = Object.create(null);
      ('break case catch class const continue debugger default delete do else enum export extends false finally for ' +
        'function if import in instanceof new null return super switch this throw true try typeof var void while with ' +
        'implements interface let package private protected public static yield await ' +
        'any unknown never object string number boolean symbol bigint undefined').split(' ').forEach(function (w) { RESERVED_NAMES[w] = true; });
      function safeIdentifier(str) {
        var name = String(str)
          .replace(/[^\p{ID_Continue}$\u200C\u200D]+(.)/gu, function (_, ch) { return ch.toUpperCase(); })
          .replace(/[^\p{ID_Continue}$\u200C\u200D]/gu, '');
        if (!name) return '';
        if (!/^[\p{ID_Start}$_]/u.test(name)) name = 'T' + name;
        if (RESERVED_NAMES[name]) name += '_';
        return name;
      }

      /* ── PascalCase helper: first letter in upper case, then a safe identifier ── */
      function toPascalCase(str) {
        return safeIdentifier(String(str).replace(/^(.)/u, function (_, ch) { return ch.toUpperCase(); }));
      }

      /* ── Zod type inference ── */
      // Returns a string like "z.string()" or a multi-line object block
      function inferZod(value, key, strict, indent) {
        if (value === null) return 'z.null()';
        if (typeof value === 'undefined') return 'z.unknown()';
        if (typeof value === 'string') return 'z.string()';
        if (typeof value === 'boolean') return 'z.boolean()';
        if (typeof value === 'number') {
          return Number.isInteger(value) ? 'z.number().int()' : 'z.number()';
        }

        if (Array.isArray(value)) {
          if (value.length === 0) return 'z.array(z.unknown())';

          // Collect object items separately
          var objItems = value.filter(function (v) {
            return v !== null && typeof v === 'object' && !Array.isArray(v);
          });
          var nonObjItems = value.filter(function (v) {
            return !(v !== null && typeof v === 'object' && !Array.isArray(v));
          });

          var elementTypes = [];

          nonObjItems.forEach(function (v) {
            var t = inferZod(v, key + 'Item', strict, indent);
            if (elementTypes.indexOf(t) === -1) elementTypes.push(t);
          });

          if (objItems.length > 0) {
            var mergedType = buildMergedObjectZod(objItems, strict, indent);
            if (elementTypes.indexOf(mergedType) === -1) elementTypes.push(mergedType);
          }

          var inner = elementTypes.length === 1 ? elementTypes[0] : 'z.union([' + elementTypes.join(', ') + '])';
          return 'z.array(' + inner + ')';
        }

        if (typeof value === 'object') {
          return buildObjectZod(value, strict, indent);
        }

        return 'z.unknown()';
      }

      // An object-literal key. "__proto__" (quoted or not) sets the prototype in a literal, so it
      // is written as a computed key to stay an own property of the shape.
      function objectKey(k) {
        if (k === '__proto__') return '["__proto__"]';
        return /^[a-zA-Z_$][a-zA-Z0-9_$]*$/.test(k) ? k : JSON.stringify(k);
      }

      function buildObjectZod(obj, strict, indent) {
        var keys = Object.keys(obj);
        if (keys.length === 0) {
          var base = 'z.record(z.string(), z.unknown())';
          return base;
        }

        var nextIndent = indent + '  ';
        var fields = keys.map(function (k) {
          var safeKey = objectKey(k);
          var zodType = inferZod(obj[k], k, strict, nextIndent);
          return nextIndent + safeKey + ': ' + zodType + ',';
        });

        var closing = indent + '})' + (strict ? '.strict()' : '');
        return 'z.object({\n' + fields.join('\n') + '\n' + closing;
      }

      function buildMergedObjectZod(objects, strict, indent) {
        // Collect all keys and their presence count
        var allKeys = Object.create(null);
        objects.forEach(function (obj) {
          Object.keys(obj).forEach(function (k) {
            if (!allKeys[k]) allKeys[k] = 0;
            allKeys[k]++;
          });
        });

        var keyList = Object.keys(allKeys);
        var nextIndent = indent + '  ';

        var fields = keyList.map(function (k) {
          var presentInAll = allKeys[k] === objects.length;
          // Collect distinct types for this key
          var types = [];
          objects.forEach(function (obj) {
            if (Object.prototype.hasOwnProperty.call(obj, k)) {
              var t = inferZod(obj[k], k, strict, nextIndent + '  ');
              if (types.indexOf(t) === -1) types.push(t);
            }
          });
          var zodType = types.length === 1 ? types[0] : 'z.union([' + types.join(', ') + '])';
          if (!presentInAll) zodType = zodType + '.optional()';
          var safeKey = objectKey(k);
          return nextIndent + safeKey + ': ' + zodType + ',';
        });

        var closing = indent + '})' + (strict ? '.strict()' : '');
        return 'z.object({\n' + fields.join('\n') + '\n' + closing;
      }

      function buildRootZod(parsed, rootName, strict) {
        if (parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed)) {
          return buildObjectZod(parsed, strict, '');
        }
        // Same path as nested arrays: objects are merged, other element types join a union.
        if (Array.isArray(parsed)) return inferZod(parsed, rootName, strict, '  ');
        return inferZod(parsed, rootName, strict, '');
      }
      /* ── engine:end ── */

      /* ── json-reason:start ── */
      // Why the input is not JSON, in the page language, instead of the browser's English
      // message. lineCol and jsonSyntaxError are copied verbatim from json-formatter-engine.js
      // (the test compares the source); jsonSyntaxError runs only after JSON.parse has failed.
      function lineCol(text, offset) {
        var line = 1, last = -1;
        for (var i = text.indexOf('\n'); i !== -1 && i < offset; i = text.indexOf('\n', i + 1)) { line++; last = i; }
        return { line: line, col: offset - last };
      }
      function jsonSyntaxError(text) {
        var i = 0, n = text.length;
        var SMART = '\u201c\u201d\u2018\u2019\u300c\u300d';
        var WIDE = '\u3000\uff1a\uff0c\uff5b\uff5d\uff3b\uff3d\uff02';
        function fail(code, at, ch) { throw { jsonErr: true, code: code, offset: at === undefined ? i : at, ch: ch }; }
        function special(c) {
          if (SMART.indexOf(c) >= 0) fail('smartQuote', i, c);
          if (WIDE.indexOf(c) >= 0) fail('fullWidth', i, c);
        }
        function ws() {
          while (i < n) {
            var c = text[i];
            if (c === ' ' || c === '\t' || c === '\n' || c === '\r') { i++; continue; }
            if (c === '/' && (text[i + 1] === '/' || text[i + 1] === '*')) fail('comment');
            if (c === '#') fail('comment');
            break;
          }
        }
        var NUM = /-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?/y;
        var WORD = /[A-Za-z_$][\w$]*/y;
        function str() {
          var s = i; i++;
          while (i < n) {
            var c = text.charCodeAt(i);
            if (c === 34) { i++; return; }
            if (c === 92) {
              var e = text[i + 1];
              if (e !== undefined && '"\\/bfnrt'.indexOf(e) >= 0) { i += 2; continue; }
              if (e === 'u' && /^[0-9a-fA-F]{4}$/.test(text.substr(i + 2, 4))) { i += 6; continue; }
              fail('badEscape');
            }
            if (c < 0x20) fail('controlChar');
            i++;
          }
          fail('unterminatedString', s);
        }
        function num() {
          NUM.lastIndex = i;
          var m = NUM.exec(text);
          if (!m || m[0] === '-' || m[0] === '') fail('badNumber');
          i += m[0].length;
          if (i < n && /[0-9.eE]/.test(text[i])) fail('badNumber');
        }
        function startsValue(c) { return c === '{' || c === '[' || c === '"' || c === '-' || (c >= '0' && c <= '9') || c === 't' || c === 'f' || c === 'n'; }
        function value(depth) {
          if (depth > 3000) fail('unexpectedChar');
          ws();
          if (i >= n) fail('unexpectedEnd');
          var c = text[i];
          if (c === '{') return obj(depth);
          if (c === '[') return arr(depth);
          if (c === '"') return str();
          if (c === "'") fail('singleQuote');
          special(c);
          if (c === '-' || (c >= '0' && c <= '9')) return num();
          if (c === '+' || c === '.') fail('badNumber');
          WORD.lastIndex = i;
          var m = WORD.exec(text);
          if (m) {
            if (m[0] === 'true' || m[0] === 'false' || m[0] === 'null') { i += m[0].length; return; }
            if (m[0] === 'NaN' || m[0] === 'Infinity') fail('badNumber');
            fail('badLiteral');
          }
          fail('unexpectedChar', i, c);
        }
        function obj(depth) {
          i++; ws();
          if (text[i] === '}') { i++; return; }
          for (;;) {
            ws();
            if (i >= n) fail('unexpectedEnd');
            var c = text[i];
            if (c === "'") fail('singleQuote');
            special(c);
            if (c !== '"') { if (/[A-Za-z_$0-9]/.test(c)) fail('unquotedKey'); fail('unexpectedChar', i, c); }
            str(); ws();
            if (i >= n) fail('unexpectedEnd');
            if (text[i] !== ':') { special(text[i]); fail('missingColon'); }
            i++;
            value(depth + 1); ws();
            if (i >= n) fail('unexpectedEnd');
            c = text[i];
            if (c === ',') { var comma = i; i++; ws(); if (text[i] === '}') fail('trailingComma', comma); continue; }
            if (c === '}') { i++; return; }
            special(c);
            if (c === '"' || /[A-Za-z_$]/.test(c)) fail('missingComma');
            fail('unexpectedChar', i, c);
          }
        }
        function arr(depth) {
          i++; ws();
          if (text[i] === ']') { i++; return; }
          for (;;) {
            value(depth + 1); ws();
            if (i >= n) fail('unexpectedEnd');
            var c = text[i];
            if (c === ',') { var comma = i; i++; ws(); if (text[i] === ']') fail('trailingComma', comma); continue; }
            if (c === ']') { i++; return; }
            special(c);
            if (startsValue(c)) fail('missingComma');
            fail('unexpectedChar', i, c);
          }
        }
        try {
          ws();
          if (i >= n) return { code: 'empty', offset: 0 };
          value(0);
          ws();
          if (i < n) fail('extraData');
          return null;
        } catch (e) {
          if (e && e.jsonErr) return { code: e.code, offset: e.offset, ch: e.ch };
          throw e;
        }
      }
      // The status line for a JSON.parse error on text.trim(). The position is counted in the
      // text as typed, so leading blank lines and spaces are included. A failure that is not a
      // SyntaxError (a browser limit, for example) keeps the browser's message.
      function jsonErrorText(text, err) {
        var e = err && err.name === 'SyntaxError' ? jsonSyntaxError(text.trim()) : null;
        if (!e) return MSG_INVALID + (err && err.message ? err.message : String(err));
        var at = lineCol(text, text.length - text.trimStart().length + e.offset);
        var reason = fillText(JSON_PARSE[e.code] || JSON_PARSE.unexpectedChar || e.code, { ch: e.ch == null ? '' : e.ch });
        return fillText(MSG_INVALID_AT, { line: at.line, col: at.col, reason: reason });
      }
      function fillText(tpl, vars) {
        return String(tpl).replace(/\{(\w+)\}/g, function (m, k) { return vars[k] != null ? String(vars[k]) : m; });
      }
      /* ── json-reason:end ── */

      /* ── Main generate ── */
      function generate() {
        invalidateCopy();
        clearTimeout(_jtzLiveTimer);
        _jtzLiveTimer = null;
        var raw = inputEl.value.trim();
        if (!raw) { inputEl.classList.remove('error'); clearStatus(); setOutput(''); return; }

        inputEl.classList.remove('error');

        var parsed;
        try {
          parsed = JSON.parse(raw);
        } catch (e) {
          setOutput('');
          inputEl.classList.add('error');
          setStatus(jsonErrorText(inputEl.value, e), true);
          return;
        }

        inputEl.classList.remove('error');

        var rootName = (rootNameEl.value.trim() || 'Root');
        var strict = strictEl.checked;
        var typeName = toPascalCase(rootName) || 'Root';
        var schemaName = typeName + 'Schema';

        var zodExpr;
        try {
          zodExpr = buildRootZod(parsed, rootName, strict);
        } catch (e) {
          // For example a stack overflow on very deep nesting: never leave the previous schema.
          setOutput('');
          setStatus(MSG_FAILED + (e && e.message ? e.message : String(e)), true);
          return;
        }

        var lines = [];
        lines.push('import { z } from "zod";');
        lines.push('');
        lines.push('const ' + schemaName + ' = ' + zodExpr + ';');
        lines.push('');
        lines.push('export type ' + typeName + ' = z.infer<typeof ' + schemaName + '>;');

        setOutput(lines.join('\n'));
        setStatus(MSG_GENERATED, false);
      }

      /* Analytics: one event per committed edit, Generate or Example, not per typing pause.
         One action can fire both change (blur on mousedown) and click, so the same JSON,
         root name and strict mode are sent once. */
      var lastTracked = null;
      function trackGenerate() {
        if (!outputCodeEl.textContent || inputEl.classList.contains('error')) return;
        var key = inputEl.value + '\u0000' + (rootNameEl.value.trim() || 'Root') + '\u0000' + strictEl.checked;
        if (key === lastTracked) return;
        lastTracked = key;
        window.trackTool && window.trackTool('json-to-zod', 'generate');
      }

      /* ── Real-time generate (debounced 300ms) ── */
      var _jtzLiveTimer = null;
      inputEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_jtzLiveTimer);
        _jtzLiveTimer = setTimeout(generate, 300);
      });
      inputEl.addEventListener('change', function () {
        if (_jtzLiveTimer) generate();
        trackGenerate();
      });

      document.getElementById('jtz-convert').addEventListener('click', function () {
        generate();
        trackGenerate();
      });

      document.getElementById('jtz-example').addEventListener('click', function () {
        inputEl.value = EXAMPLE;
        inputEl.classList.remove('error');
        clearStatus();
        generate();
        trackGenerate();
      });

      document.getElementById('jtz-clear').addEventListener('click', function () {
        invalidateCopy();
        lastTracked = null;
        clearTimeout(_jtzLiveTimer);
        _jtzLiveTimer = null;
        inputEl.focus();
        inputEl.value = '';
        setOutput('');
        inputEl.classList.remove('error');
        clearStatus();
      });

      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
          e.preventDefault();
          document.getElementById('jtz-clear').click();
        }
      });

      copyBtn.addEventListener('click', function () {
        var text = outputCodeEl.textContent;
        if (!text) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(COPY_FAILED, true);
          copyFailure = true;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            if (copyFailure) clearStatus();
            copyBtn.textContent = COPIED;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = COPY;
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });
    })();
  </script>
</div>

<style>
  .jtz-wrap { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; gap: 0.75rem; }
  .jtz-config { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .jtz-name-field { display: flex; flex-direction: column; gap: 0.25rem; width: 18rem; max-width: 100%; }
  .jtz-control-label { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .jtz-options { display: flex; align-items: center; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  .jtz-config label { font-size: 0.85rem; color: var(--color-text-secondary); display: flex; align-items: center; gap: 0.4rem; }
  .jtz-options label { min-height: 44px; }
  .jtz-name-field input {
    min-height: 44px; width: 100%; padding: 0.4rem 0.6rem; font-size: 0.85rem;
    font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg); color: var(--color-text);
  }
  .jtz-name-field input:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jtz-panel-header { display: flex; justify-content: space-between; align-items: center; min-height: 44px; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .jtz-panel textarea, .jtz-output {
    width: 100%; min-width: 0; font-family: var(--font-mono); font-size: 0.82rem; padding: 0.75rem;
    border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg-secondary); color: var(--color-text); line-height: 1.5;
  }
  .jtz-panel textarea { transition: border-color 0.15s; }
  .jtz-panel textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }
  .jtz-panel textarea.error { border-color: #c0392b; }
  .jtz-output { margin: 0; overflow: auto; white-space: pre; }
  .jtz-output:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jtz-panel-header button:disabled { opacity: 0.5; cursor: not-allowed; }
  .jtz-empty { display: none; margin: 0; padding: 2rem; align-items: center; justify-content: center; text-align: center; color: var(--color-text-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .jtz-output-pane:has(#jtz-output-code:empty) .jtz-output { display: none; }
  .jtz-output-pane:has(#jtz-output-code:empty) .jtz-empty { display: flex; }
  .jtz-actions { display: flex; gap: 0.5rem 1rem; flex-wrap: wrap; }
  .jtz-status { font-size: 0.85rem; line-height: 1.4; height: 2.4rem; min-height: 2.4rem; flex: none; overflow: auto; overflow-wrap: anywhere; }
  .jtz-status.success { color: #057a55; }
  .jtz-status.error { color: #c0392b; }
  @media (max-width: 860px) {
    .jtz-wrap { gap: 0.5rem; }
    .jtz-name-field { width: 100%; flex-direction: row; align-items: center; gap: 0.5rem; }
    .jtz-name-field .jtz-control-label { flex: 1; }
    .jtz-name-field input { width: 45%; flex: none; }
    .jtz-options { align-items: flex-start; flex-direction: column; gap: 0; }
    .jtz-actions button, .jtz-panel-header button { min-height: 44px; }
    .jtz-panel textarea { height: 144px; min-height: 144px; }
    .jtz-output { height: 22rem; min-height: 160px; resize: none; }
    .jtz-output-pane:has(#jtz-output-code:empty) { display: none; }
  }
  @media (max-width: 640px) {
    .jtz-panel-header { flex-wrap: wrap; }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .jtz-status.success { color: #34d399; }
    :global(:root:not([data-theme="light"])) .jtz-status.error { color: #f87171; }
    :global(:root:not([data-theme="light"])) .jtz-panel textarea.error { border-color: #f87171; }
  }
  :global([data-theme="dark"]) .jtz-status.success { color: #34d399; }
  :global([data-theme="dark"]) .jtz-status.error { color: #f87171; }
  :global([data-theme="dark"]) .jtz-panel textarea.error { border-color: #f87171; }
</style>
