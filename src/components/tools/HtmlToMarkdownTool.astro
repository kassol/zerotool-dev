---
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: {
    htmlInput: 'HTML Input',
    mdOutput: 'Markdown Output',
    example: 'Example',
    clear: 'Clear',
    copy: 'Copy',
    copied: 'Copied!',
    copyFailed: 'Copy failed',
    download: 'Download .md',
    largInput: 'Input is very large — conversion may be slow.',
    emptyOutput: "Your converted Markdown will appear here.",
    tips: {
      "input": "Paste or type HTML. Conversion runs 300 ms after you stop typing. Input over 1,048,576 characters shows a warning and still converts.",
      "output": "Headings use ATX syntax, code blocks keep language classes, and tables with header cells become GFM tables. Check the Markdown before publishing.",
      "example": "Load the sample with headings, links, code, lists, a table and a quotation. It replaces the current HTML and converts immediately.",
      "clear": "Clear both fields, the warning and copy feedback, and cancel pending conversion. Ctrl/⌘+L also clears the tool when focus is inside it.",
      "copy": "Copy the complete Markdown output as text. Empty output is not copied.",
      "download": "Save the complete Markdown output as a UTF-8 file named output.md. Empty output is not downloaded."
    },
  },
  zh: {
    htmlInput: 'HTML 输入',
    mdOutput: 'Markdown 输出',
    example: '示例',
    clear: '清空',
    copy: '复制',
    copied: '已复制！',
    copyFailed: '复制失败',
    download: '下载 .md',
    largInput: '输入内容过大，转换可能较慢。',
    emptyOutput: "转换后的 Markdown 会显示在这里。",
    tips: {
      "input": "粘贴或输入 HTML，停止输入 300 ms 后转换。超过 1,048,576 个字符时会显示警告，转换仍会继续。",
      "output": "标题使用 ATX 语法，代码块保留语言 class，带表头单元格的表格转为 GFM 表格。发布前请检查 Markdown。",
      "example": "加载包含标题、链接、代码、列表、表格和引用的示例，替换当前 HTML 并立即转换。",
      "clear": "清空两栏、警告和复制反馈，并取消排队的转换。焦点在工具内时，Ctrl/⌘+L 也会清空。",
      "copy": "以纯文本复制完整的 Markdown 输出。输出为空时不复制。",
      "download": "将完整的 Markdown 输出保存为 UTF-8 文件 output.md。输出为空时不下载。"
    },
  },
  ja: {
    htmlInput: 'HTML 入力',
    mdOutput: 'Markdown 出力',
    example: 'サンプル',
    clear: 'クリア',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyFailed: 'コピー失敗',
    download: '.md をダウンロード',
    largInput: '入力が非常に大きいため、変換に時間がかかる場合があります。',
    emptyOutput: "変換した Markdown がここに表示されます。",
    tips: {
      "input": "HTML を入力・貼り付けます。入力停止から 300 ms 後に変換します。1,048,576 文字を超えると警告を表示しますが、変換は続行します。",
      "output": "見出しは ATX 形式、コードブロックは言語クラスを保持し、見出しセルのある表は GFM 形式になります。公開前に Markdown を確認してください。",
      "example": "見出し、リンク、コード、リスト、表、引用を含むサンプルを読み込みます。現在の HTML を置き換えてすぐに変換します。",
      "clear": "両方の欄、警告、コピーの表示を消し、待機中の変換を取り消します。ツール内にフォーカスがあれば Ctrl/⌘+L でも消去できます。",
      "copy": "Markdown 出力全体をテキストとしてコピーします。空の出力はコピーしません。",
      "download": "Markdown 出力全体を UTF-8 の output.md ファイルとして保存します。空の出力はダウンロードしません。"
    },
  },
  ko: {
    htmlInput: 'HTML 입력',
    mdOutput: 'Markdown 출력',
    example: '예시',
    clear: '지우기',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사 실패',
    download: '.md 다운로드',
    largInput: '입력이 매우 크면 변환이 느릴 수 있습니다.',
    emptyOutput: "변환된 Markdown이 여기에 표시됩니다.",
    tips: {
      "input": "HTML을 입력하거나 붙여 넣으세요. 입력을 멈춘 뒤 300 ms 후 변환합니다. 1,048,576자를 초과하면 경고를 표시하며 변환은 계속합니다.",
      "output": "제목은 ATX 구문을 사용하고 코드 블록의 언어 클래스를 유지하며 머리글 셀이 있는 표는 GFM 표로 변환합니다. 게시 전에 Markdown을 확인하세요.",
      "example": "제목, 링크, 코드, 목록, 표, 인용문이 있는 예시를 불러옵니다. 현재 HTML을 바꾸고 즉시 변환합니다.",
      "clear": "두 입력란, 경고, 복사 피드백을 지우고 대기 중인 변환을 취소합니다. 도구 안에 포커스가 있으면 Ctrl/⌘+L로도 지울 수 있습니다.",
      "copy": "전체 Markdown 출력을 텍스트로 복사합니다. 출력이 비어 있으면 복사하지 않습니다.",
      "download": "전체 Markdown 출력을 UTF-8 파일 output.md로 저장합니다. 출력이 비어 있으면 다운로드하지 않습니다."
    },
  },
};

// strings:end
const L = STRINGS[lang];
const TIPS = L.tips;
---

<div
  class="htm-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-larg-input={L.largInput}
>
  <div class="htm-toolbar">
    <div class="htm-control">
      <button id="htm-example" class="btn-ghost btn-sm" type="button">{L.example}</button>
      <Toggletip id="htm-tip-example" lang={lang} about={L.example}>{TIPS.example}</Toggletip>
    </div>
    <div class="htm-control">
      <button id="htm-clear" class="btn-ghost btn-sm" type="button">{L.clear}</button>
      <Toggletip id="htm-tip-clear" lang={lang} about={L.clear}>{TIPS.clear}</Toggletip>
    </div>
    <div class="htm-control">
      <button id="htm-download" class="btn-ghost btn-sm" type="button">{L.download}</button>
      <Toggletip id="htm-tip-download" lang={lang} about={L.download}>{TIPS.download}</Toggletip>
    </div>
    <div class="htm-control">
      <button id="htm-copy" class="btn-ghost btn-sm" type="button">{L.copy}</button>
      <Toggletip id="htm-tip-copy" lang={lang} about={L.copy}>{TIPS.copy}</Toggletip>
    </div>
  </div>
  <div id="htm-status" class="htm-status" aria-live="polite"></div>
  <div class="htm-panels zt-io">
    <div class="htm-panel zt-io-pane">
      <div class="htm-panel-header">
        <label for="htm-input">{L.htmlInput}</label>
        <Toggletip id="htm-tip-input" lang={lang} about={L.htmlInput}>{TIPS.input}</Toggletip>
      </div>
      <textarea id="htm-input" class="zt-io-fill" spellcheck="false" placeholder="<h1>Hello, World</h1>"></textarea>
    </div>
    <div id="htm-output-panel" class="htm-panel htm-output-panel zt-io-pane">
      <div class="htm-panel-header">
        <span id="htm-output-label">{L.mdOutput}</span>
        <Toggletip id="htm-tip-output" lang={lang} about={L.mdOutput}>{TIPS.output}</Toggletip>
      </div>
      <textarea id="htm-output" class="zt-io-fill" aria-labelledby="htm-output-label" placeholder=" " spellcheck="false" readonly></textarea>
      <p id="htm-empty-output" class="htm-empty-output">{L.emptyOutput}</p>
    </div>
  </div>
</div>

<script src="/vendor/turndown.umd.js" is:inline></script>
<script src="/vendor/turndown-plugin-gfm.js" is:inline></script>
<script is:inline>
(function () {
  var wrap = document.querySelector('.htm-wrap');
  if (!wrap) return;

  var COPY = wrap.dataset.copy || 'Copy';
  var COPIED = wrap.dataset.copied || 'Copied!';
  var COPY_FAILED = wrap.dataset.copyFailed || 'Copy failed';
  var LARG_INPUT = wrap.dataset.largInput || 'Input is very large — conversion may be slow.';

  var inputEl = document.getElementById('htm-input');
  var outputEl = document.getElementById('htm-output');
  var statusEl = document.getElementById('htm-status');

  // engine:start
  function createConverter(TurndownService, turndownPluginGfm) {
    var td = new TurndownService({
      headingStyle: 'atx',
      bulletListMarker: '-',
      codeBlockStyle: 'fenced',
      fence: '```',
      emDelimiter: '*',
      strongDelimiter: '**',
    });

    td.use(turndownPluginGfm.tables);

    // Same output as the plugin's tableCell rule, but a literal | is escaped
    // and a line break inside a cell becomes <br>; both would split the row.
    td.addRule('tableCellEscaped', {
      filter: ['th', 'td'],
      replacement: function (content, node) {
        var text = content.replace(/\|/g, '\\|').replace(/ *\n */g, '<br>');
        var index = Array.prototype.indexOf.call(node.parentNode.childNodes, node);
        return (index === 0 ? '| ' : ' ') + text + ' |';
      },
    });

    td.addRule('fencedCodeBlockWithLang', {
      filter: function (node) {
        return (
          node.nodeName === 'PRE' &&
          node.firstChild &&
          node.firstChild.nodeName === 'CODE'
        );
      },
      replacement: function (_content, node) {
        var code = node.firstChild;
        var className = code.getAttribute('class') || '';
        var langMatch = className.match(/language-(\S+)/);
        var lang = langMatch ? langMatch[1] : '';
        var text = code.textContent || '';
        if (text.charAt(text.length - 1) === '\n') text = text.slice(0, -1);
        return '\n\n```' + lang + '\n' + text + '\n```\n\n';
      },
    });
    return td;
  }
  // engine:end

  var td = createConverter(TurndownService, turndownPluginGfm);

  var EXAMPLE = [
    '<h1>HTML to Markdown Example</h1>',
    '<p>This converter supports <strong>bold</strong>, <em>italic</em>, and <a href="https://zerotool.dev">links</a>.</p>',
    '<h2>Code Blocks</h2>',
    '<pre><code class="language-javascript">const greeting = "Hello, World!";\nconsole.log(greeting);</code></pre>',
    '<h2>Lists</h2>',
    '<ul><li>Unordered item 1</li><li>Unordered item 2<ul><li>Nested item</li></ul></li></ul>',
    '<ol><li>Ordered item 1</li><li>Ordered item 2</li></ol>',
    '<h2>Table</h2>',
    '<table><thead><tr><th>Name</th><th>Role</th><th>Language</th></tr></thead><tbody><tr><td>Alice</td><td>Engineer</td><td>TypeScript</td></tr><tr><td>Bob</td><td>Designer</td><td>CSS</td></tr></tbody></table>',
    '<blockquote><p>Good tools make hard problems easy.</p></blockquote>',
  ].join('\n');

  function convert() {
    var raw = inputEl.value;
    if (!raw.trim()) {
      outputEl.value = '';
      statusEl.textContent = '';
      statusEl.className = 'htm-status';
      return;
    }
    if (raw.length > 1024 * 1024) {
      statusEl.textContent = LARG_INPUT;
      statusEl.className = 'htm-status warn';
    } else {
      statusEl.textContent = '';
      statusEl.className = 'htm-status';
    }
    try {
      outputEl.value = td.turndown(raw);
      window.trackTool && window.trackTool('html-to-markdown', 'convert');
    } catch (e) {
      outputEl.value = '';
    }
  }

  var copyBtn = document.getElementById('htm-copy');
  var copyRevision = 0;
  var copyTimer = null;
  function invalidateCopy() {
    copyRevision++;
    clearTimeout(copyTimer);
    copyBtn.textContent = COPY;
  }

  var _timer = null;
  inputEl.addEventListener('input', function () {
    invalidateCopy();
    clearTimeout(_timer);
    _timer = setTimeout(function () { invalidateCopy(); convert(); }, 300);
  });

  document.getElementById('htm-example').addEventListener('click', function () {
    clearTimeout(_timer);
    invalidateCopy();
    inputEl.value = EXAMPLE;
    convert();
  });

  function clearAll() {
    inputEl.focus();
    clearTimeout(_timer);
    invalidateCopy();
    inputEl.value = '';
    outputEl.value = '';
    statusEl.textContent = '';
    statusEl.className = 'htm-status';
  }
  document.getElementById('htm-clear').addEventListener('click', clearAll);
  document.addEventListener('keydown', function (e) {
    if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
      e.preventDefault();
      clearAll();
    }
  });

  copyBtn.addEventListener('click', function () {
    var text = outputEl.value;
    if (!text) return;
    var request = ++copyRevision;
    clearTimeout(copyTimer);
    function failed() {
      if (request === copyRevision) copyBtn.textContent = COPY_FAILED;
    }
    try {
      navigator.clipboard.writeText(text).then(function () {
        if (request !== copyRevision) return;
        copyBtn.textContent = COPIED;
        copyTimer = setTimeout(function () {
          if (request === copyRevision) copyBtn.textContent = COPY;
        }, 1500);
      }, failed);
    } catch (_e) { failed(); }
  });

  document.getElementById('htm-download').addEventListener('click', function () {
    var text = outputEl.value;
    if (!text) return;
    var blob = new Blob([text], { type: 'text/markdown;charset=utf-8;' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'output.md';
    a.click();
    URL.revokeObjectURL(url);
  });

  if (!inputEl.value) inputEl.value = EXAMPLE;
  convert();
})();
</script>

<style>
  .htm-wrap { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; flex: 1; }

  .htm-panels { min-height: 0; }
  .htm-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; }
  .htm-control { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
  .htm-control button { min-height: 44px; min-width: 6.5rem; }
  .htm-panel { min-width: 0; min-height: 0; }
  .htm-output-panel { position: relative; }
  .htm-empty-output { display: none; position: absolute; inset: 2rem 0 0; margin: 0; padding: 1rem; place-content: center; text-align: center; color: var(--color-text-secondary); pointer-events: none; }
  .htm-output-panel:has(#htm-output:placeholder-shown) .htm-empty-output { display: grid; }

  .htm-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .htm-panel textarea {
    width: 100%;
    min-height: 0;
    overflow: auto;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    resize: none;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    line-height: 1.5;
    transition: border-color 0.15s;
    box-sizing: border-box;
  }

  .htm-panel textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }
  .htm-panel textarea[readonly] { cursor: default; }

  .btn-sm { padding: 0.2rem 0.5rem; font-size: 0.78rem; }

  .htm-status { flex: none; font-size: 0.82rem; height: 2.6em; line-height: 1.3; overflow: auto; overflow-wrap: anywhere; }
  .htm-status.warn { color: #d97706; }

  @media (max-width: 860px) {
    .htm-panel textarea { flex: none; height: 220px; }
    .htm-output-panel:has(#htm-output:placeholder-shown) { display: none; }
  }
  @media (max-width: 640px) {
    .htm-wrap { gap: 0.5rem; }
    .htm-toolbar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
    .htm-control button { flex: 1; min-width: 0; padding: 0.35rem 0.5rem; white-space: normal; }
    .htm-panel-header { justify-content: flex-start; gap: 0.4rem; }
    #htm-input { height: 144px; }
    #htm-output { height: 256px; }
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .htm-status.warn { color: #fbbf24; }
  }
  [data-theme="dark"] .htm-status.warn { color: #fbbf24; }
</style>
