---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  "en": {
    "copyFail": "Could not copy. Please select and copy the slug manually.",
    "inputText": "Input Text",
    "lowercase": "Lowercase",
    "trim": "Trim",
    "separator": "Separator",
    "sepHyphen": "Hyphen (-)",
    "sepUnderscore": "Underscore (_)",
    "sepDot": "Dot (.)",
    "slug": "Slug",
    "copy": "Copy",
    "copied": "Copied!",
    "emptyResult": "Result is empty — all characters were removed.",
    "inputPlaceholder": "Enter a title, file name or sentence…",
    "emptyOutput": "Your slug will appear here.",
    "tips": {
      "input": "The slug updates as you type or change an option. Accented Latin letters lose combining marks; mapped letters and symbols are replaced, and other non-ASCII characters are removed. An empty result shows a warning and disables Copy. Ctrl/⌘+L inside the tool clears the input and result. This tool does not save them.",
      "lowercase": "Lowercase is on by default. Turn it off to keep the case of the remaining ASCII letters and mapped letters.",
      "trim": "Trim is on by default and removes the selected separator from both ends. With it off, leading and trailing separators stay. With the dot separator and Trim off, punctuation-only input can produce a single dot.",
      "separator": "Choose hyphen, underscore or dot. Runs of whitespace and existing hyphens, underscores and dots become the selected separator. The option changes the result immediately.",
      "copy": "Copy copies the entire current slug. If copying fails, select the slug and copy it manually."
    }
  },
  "zh": {
    "copyFail": "复制失败。请选中 Slug 后手动复制。",
    "inputText": "输入文本",
    "lowercase": "小写",
    "trim": "修剪",
    "separator": "分隔符",
    "sepHyphen": "连字符 (-)",
    "sepUnderscore": "下划线 (_)",
    "sepDot": "点 (.)",
    "slug": "Slug",
    "copy": "复制",
    "copied": "已复制！",
    "emptyResult": "结果为空 — 所有字符已被移除。",
    "inputPlaceholder": "输入标题、文件名或句子…",
    "emptyOutput": "生成的 Slug 会显示在这里。",
    "tips": {
      "input": "输入或改变选项时立即更新 Slug。带重音的拉丁字母去掉组合标记，映射表中的字母和符号会被替换，其他非 ASCII 字符被移除。结果为空时显示警告并禁用复制。在工具内按 Ctrl/⌘+L 清空输入和结果。本工具不保存它们。",
      "lowercase": "默认开启「小写」。关闭后，保留剩余 ASCII 字母和映射字母的大小写。",
      "trim": "默认开启「修剪」，移除两端的所选分隔符。关闭后保留两端分隔符。选择点且关闭修剪时，仅含标点的输入可能得到一个点。",
      "separator": "选择连字符、下划线或点。连续空白以及已有的连字符、下划线和点都会变为所选分隔符。改变选项立即更新结果。",
      "copy": "「复制」复制当前完整 Slug。失败时，请选中 Slug 后手动复制。"
    }
  },
  "ja": {
    "copyFail": "コピーできませんでした。スラッグを選択して手動でコピーしてください。",
    "inputText": "入力テキスト",
    "lowercase": "小文字",
    "trim": "トリム",
    "separator": "区切り文字",
    "sepHyphen": "ハイフン (-)",
    "sepUnderscore": "アンダースコア (_)",
    "sepDot": "ドット (.)",
    "slug": "Slug",
    "copy": "コピー",
    "copied": "コピー済み！",
    "emptyResult": "結果が空です — すべての文字が削除されました。",
    "inputPlaceholder": "タイトル、ファイル名、文章を入力…",
    "emptyOutput": "生成したスラッグをここに表示します。",
    "tips": {
      "input": "入力や設定の変更と同時にスラッグを更新します。ラテン文字の結合記号を除き、表にある文字や記号を置き換え、ほかの非 ASCII 文字は削除します。結果が空なら警告を表示し、コピーを無効にします。ツール内の Ctrl/⌘+L で入力と結果を消去します。入力や結果は保存しません。",
      "lowercase": "「小文字」は初期状態で有効です。無効にすると、残った ASCII 文字や置換した文字の大文字小文字を保ちます。",
      "trim": "「トリム」は初期状態で有効で、両端の区切り文字を除きます。無効にすると両端に残ります。ドットを選びトリムを無効にした場合、記号だけの入力がドット 1 つになることがあります。",
      "separator": "ハイフン、アンダースコア、ドットから選びます。連続する空白と既存のハイフン、アンダースコア、ドットは選んだ区切り文字になります。変更はすぐに反映します。",
      "copy": "「コピー」は現在のスラッグ全体をコピーします。失敗した場合はスラッグを選択して手動でコピーしてください。"
    }
  },
  "ko": {
    "copyFail": "복사하지 못했습니다. 슬러그를 선택하여 직접 복사하세요.",
    "inputText": "입력 텍스트",
    "lowercase": "소문자",
    "trim": "다듬기",
    "separator": "구분자",
    "sepHyphen": "하이픈 (-)",
    "sepUnderscore": "밑줄 (_)",
    "sepDot": "점 (.)",
    "slug": "Slug",
    "copy": "복사",
    "copied": "복사됨!",
    "emptyResult": "결과가 비어 있습니다 — 모든 문자가 제거되었습니다.",
    "inputPlaceholder": "제목, 파일 이름 또는 문장을 입력하세요…",
    "emptyOutput": "생성한 슬러그가 여기에 표시됩니다.",
    "tips": {
      "input": "입력하거나 옵션을 바꾸면 슬러그가 즉시 갱신됩니다. 라틴 문자의 결합 부호를 제거하고 표에 있는 문자와 기호를 치환하며 나머지 비 ASCII 문자는 제거합니다. 결과가 비면 경고를 표시하고 복사를 비활성화합니다. 도구 안에서 Ctrl/⌘+L로 입력과 결과를 비웁니다. 이 도구는 입력과 결과를 저장하지 않습니다.",
      "lowercase": "소문자는 기본으로 켜져 있습니다. 끄면 남은 ASCII 문자와 치환된 문자의 대소문자를 유지합니다.",
      "trim": "다듬기는 기본으로 켜져 있으며 양 끝의 선택한 구분자를 제거합니다. 끄면 양 끝 구분자가 남습니다. 점을 선택하고 다듬기를 끄면 기호만 있는 입력이 점 하나가 될 수 있습니다.",
      "separator": "하이픈, 밑줄 또는 점을 선택하세요. 연속 공백과 기존 하이픈, 밑줄, 점은 선택한 구분자로 바뀝니다. 옵션을 바꾸면 결과가 즉시 갱신됩니다.",
      "copy": "복사는 현재 슬러그 전체를 복사합니다. 실패하면 슬러그를 선택하여 직접 복사하세요."
    }
  }
} as const;
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---
<div class="sl-wrap">
  <div class="sl-options">
    <div class="sl-option"><label class="sl-opt" for="sl-lowercase"><input type="checkbox" id="sl-lowercase" checked /><span>{T.lowercase}</span></label><Toggletip id="sl-tip-lowercase" about={T.lowercase} lang={lang}>{TIPS.lowercase}</Toggletip></div>
    <div class="sl-option"><label class="sl-opt" for="sl-trim"><input type="checkbox" id="sl-trim" checked /><span>{T.trim}</span></label><Toggletip id="sl-tip-trim" about={T.trim} lang={lang}>{TIPS.trim}</Toggletip></div>
    <div class="sl-option"><label for="sl-separator">{T.separator}</label><select id="sl-separator"><option value="-">{T.sepHyphen}</option><option value="_">{T.sepUnderscore}</option><option value=".">{T.sepDot}</option></select><Toggletip id="sl-tip-separator" about={T.separator} lang={lang}>{TIPS.separator}</Toggletip></div>
  </div>
  <div id="sl-status" class="sl-status" aria-live="polite"></div>
  <div class="sl-panels zt-io">
    <div class="sl-field zt-io-pane">
      <div class="sl-head"><label for="sl-input">{T.inputText}</label><Toggletip id="sl-tip-input" about={T.inputText} lang={lang} wide>{TIPS.input}</Toggletip></div>
      <textarea id="sl-input" class="tool-textarea sl-input zt-io-fill" placeholder={T.inputPlaceholder} spellcheck="false"></textarea>
    </div>
    <div id="sl-result-wrap" class="sl-result-wrap zt-io-pane">
      <div class="sl-head"><span id="sl-result-label">{T.slug}</span><div class="sl-copy-controls"><button id="sl-copy" class="btn-copy" type="button" disabled>{T.copy}</button><Toggletip id="sl-tip-copy" about={T.copy} lang={lang}>{TIPS.copy}</Toggletip></div></div>
      <div class="sl-output zt-io-fill" role="region" aria-labelledby="sl-result-label" tabindex="0"><code id="sl-result" class="sl-result"></code><p class="sl-empty">{T.emptyOutput}</p></div>
    </div>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var inputEl = document.getElementById('sl-input');
      var resultEl = document.getElementById('sl-result');
      var copyBtn = document.getElementById('sl-copy');
      var statusEl = document.getElementById('sl-status');
      var lowercaseEl = document.getElementById('sl-lowercase');
      var trimEl = document.getElementById('sl-trim');
      var separatorEl = document.getElementById('sl-separator');
      var copyRevision = 0;
      var copyTimer = null;
      var copyError = false;

      /* ── engine:start ── */
      // Letters: the text is NFD-decomposed and combining marks (Mn) are removed, so
      // é → e, ó → o, ź → z. Letters that have no decomposition are replaced from this table
      // (values from sindresorhus/transliterate). Symbols become a separate word, as
      // sindresorhus/slugify does for & → " and " (Tom&Jerry → tom-and-jerry). The ASCII
      // symbols & @ # % + must be looked up too, not only non-ASCII characters.
      var letterMap = {
        'ß':'ss','ẞ':'Ss','æ':'ae','Æ':'AE','œ':'oe','Œ':'OE','ð':'d','Ð':'D',
        'đ':'d','Đ':'D','ø':'o','Ø':'O','þ':'th','Þ':'TH','ł':'l','Ł':'L',
        'ı':'i','ħ':'h','Ħ':'H','ĳ':'ij','Ĳ':'IJ','ə':'a','Ə':'A',
      };
      var symbolMap = {
        '&':'and','@':'at','#':'hash','%':'percent','+':'plus',
        '©':'c','®':'r','™':'tm','€':'euro','£':'pound','¥':'yen',
        '°':'deg','×':'x','÷':'div',
      };

      function slugify(text, opts) {
        var sep = opts.separator;
        var lower = opts.lowercase;
        var trim = opts.trim;
        var has = Object.prototype.hasOwnProperty;

        // Replace known chars; drop other non-ASCII characters
        var result = text.normalize('NFD').replace(/\p{Mn}/gu, '');
        result = result.replace(/[^\u0000-\u007E]|[&@#%+]/g, function(c) {
          if (has.call(symbolMap, c)) return ' ' + symbolMap[c] + ' ';
          return has.call(letterMap, c) ? letterMap[c] : '';
        });

        // Replace special chars with separator
        result = result
          .replace(/[^a-zA-Z0-9\s\-_\.]/g, ' ')
          .replace(/[\s]+/g, sep)
          .replace(/[\-_\.]+/g, sep);

        if (lower) result = result.toLowerCase();
        if (trim) result = result.replace(new RegExp('^[' + sep + ']+|[' + sep + ']+$', 'g'), '');

        return result;
      }
      /* ── engine:end ── */

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        if (copyError) {
          statusEl.textContent = '';
          statusEl.className = 'sl-status';
          copyError = false;
        }
      }

      function update() {
        invalidateCopy();
        var text = inputEl.value;
        if (!text) {
          resultEl.textContent = '';
          copyBtn.disabled = true;
          statusEl.textContent = '';
          statusEl.className = 'sl-status';
          return;
        }
        var slug = slugify(text, { separator: separatorEl.value, lowercase: lowercaseEl.checked, trim: trimEl.checked });
        resultEl.textContent = slug;
        copyBtn.disabled = !slug;
        statusEl.textContent = slug ? '' : t.emptyResult;
        statusEl.className = slug ? 'sl-status' : 'sl-status warn';
      }

      /* Analytics: one event per committed change (as in css-triangle-generator), not per input event. */
      function trackConvert() {
        if (resultEl.textContent) window.trackTool && window.trackTool('slugify', 'convert');
      }

      inputEl.addEventListener('input', update);
      inputEl.addEventListener('change', trackConvert);
      [lowercaseEl, trimEl, separatorEl].forEach(function (el) {
        el.addEventListener('change', function () { update(); trackConvert(); });
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var root = document.querySelector('.sl-wrap');
        if (root && root.contains(document.activeElement)) {
          inputEl.value = '';
          update();
        }
      });

      copyBtn.addEventListener('click', function () {
        var val = resultEl.textContent;
        if (!val) return;
        invalidateCopy();
        var revision = copyRevision;
        function done() {
          if (revision !== copyRevision) return;
          copyBtn.textContent = t.copied;
          copyTimer = setTimeout(function () { if (revision === copyRevision) copyBtn.textContent = t.copy; }, 1500);
        }
        function failed() {
          if (revision !== copyRevision) return;
          statusEl.textContent = t.copyFail;
          statusEl.className = 'sl-status error';
          copyError = true;
        }
        try { navigator.clipboard.writeText(val).then(done, failed); }
        catch (e) { failed(); }
      });
    })();
  </script>
</div>

<style>
  .sl-wrap { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; }
  .sl-options { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; flex: none; font-size: 0.85rem; color: var(--color-text-secondary); }
  .sl-option, .sl-opt { display: flex; align-items: center; gap: 0.35rem; }
  .sl-opt { cursor: pointer; }
  .sl-opt input { flex: none; }
  .sl-option select { font-size: 0.85rem; padding: 0.3rem 0.4rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-secondary); color: var(--color-text); }
  .sl-status { flex: none; height: 2.8em; line-height: 1.4; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; }
  .sl-status.warn { color: #b45309; }
  .sl-status.error { color: var(--color-danger); }
  .sl-head { display: flex; align-items: center; gap: 0.35rem; min-height: 32px; flex: none; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .sl-copy-controls { display: flex; align-items: center; gap: 0.25rem; margin-left: auto; }
  .sl-input { width: 100%; overflow: auto; font-family: var(--font-mono); font-size: 0.88rem; }
  .sl-output { overflow: auto; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-secondary); }
  .sl-result { display: block; font-family: var(--font-mono); font-size: 0.88rem; color: var(--color-text); word-break: break-all; }
  .sl-empty { margin: 0; font-size: 0.88rem; color: var(--color-text-secondary); }
  .sl-result-wrap:has(.sl-result:not(:empty)) .sl-empty { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sl-status.warn { color: #fbbf24; }
  }
  :global([data-theme="dark"]) .sl-status.warn { color: #fbbf24; }
  @media (max-width: 860px) {
    .sl-result-wrap:has(.sl-result:empty) { display: none; }
    .sl-input, .sl-output { height: 160px; }
  }
  @media (max-width: 640px) {
    .sl-opt, .sl-option select, .sl-copy-controls button { min-height: 44px; }
    .sl-status { height: 4.2em; }
    .sl-input { height: 120px; }
  }
</style>
