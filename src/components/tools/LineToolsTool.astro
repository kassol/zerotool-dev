---

<div class="lt-wrap">
  <div class="lt-actions">
    <div class="lt-action">
      <button id="lt-dedup" class="btn-secondary" type="button">{T.dedup}</button>
      <Toggletip id="lt-tip-dedup" about={T.dedup} lang={lang}>{TIPS.dedup}</Toggletip>
    </div>
    <div class="lt-action">
      <button id="lt-sort-asc" class="btn-secondary" type="button">{T.sortAsc}</button>
      <Toggletip id="lt-tip-sort-asc" about={T.sortAsc} lang={lang}>{TIPS.sortAsc}</Toggletip>
    </div>
    <div class="lt-action">
      <button id="lt-sort-desc" class="btn-secondary" type="button">{T.sortDesc}</button>
      <Toggletip id="lt-tip-sort-desc" about={T.sortDesc} lang={lang}>{TIPS.sortDesc}</Toggletip>
    </div>
    <div class="lt-action">
      <button id="lt-sort-num" class="btn-secondary" type="button">{T.sortNum}</button>
      <Toggletip id="lt-tip-sort-num" about={T.sortNum} lang={lang}>{TIPS.sortNum}</Toggletip>
    </div>
    <div class="lt-action">
      <button id="lt-reverse" class="btn-secondary" type="button">{T.reverse}</button>
      <Toggletip id="lt-tip-reverse" about={T.reverse} lang={lang}>{TIPS.reverse}</Toggletip>
    </div>
    <div class="lt-action">
      <button id="lt-shuffle" class="btn-secondary" type="button">{T.shuffle}</button>
      <Toggletip id="lt-tip-shuffle" about={T.shuffle} lang={lang}>{TIPS.shuffle}</Toggletip>
    </div>
    <div class="lt-action">
      <button id="lt-trim" class="btn-secondary" type="button">{T.trim}</button>
      <Toggletip id="lt-tip-trim" about={T.trim} lang={lang}>{TIPS.trim}</Toggletip>
    </div>
    <div class="lt-action">
      <button id="lt-empty" class="btn-secondary" type="button">{T.removeEmpty}</button>
      <Toggletip id="lt-tip-empty" about={T.removeEmpty} lang={lang}>{TIPS.removeEmpty}</Toggletip>
    </div>
    <button id="lt-clear" class="btn-ghost" type="button">{T.clear}</button>
  </div>
  <div id="lt-status" class="lt-status" aria-live="polite"></div>
  <div class="lt-panels zt-io">
    <div class="lt-field zt-io-pane">
      <div class="lt-head">
        <label for="lt-input">{T.inputLines}</label>
        <Toggletip id="lt-tip-input" about={T.inputLines} lang={lang}>{TIPS.input}</Toggletip>
        <span id="lt-count" class="lt-count"></span>
      </div>
      <textarea id="lt-input" class="tool-textarea lt-box zt-io-fill" placeholder="apple&#10;banana&#10;cherry&#10;apple&#10;banana&#10;date" spellcheck="false"></textarea>
    </div>
    <div id="lt-output-pane" class="lt-field lt-output-pane zt-io-pane" data-empty="true">
      <div class="lt-head">
        <label for="lt-output">{T.output}</label>
        <div class="lt-copy-controls">
          <button id="lt-copy" class="btn-copy" type="button">{T.copy}</button>
          <Toggletip id="lt-tip-copy" about={T.copy} lang={lang}>{TIPS.copy}</Toggletip>
        </div>
      </div>
      <textarea id="lt-output" class="tool-textarea lt-box zt-io-fill" placeholder={T.outputPlaceholder} readonly spellcheck="false"></textarea>
    </div>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var inputEl = document.getElementById('lt-input');
      var outputEl = document.getElementById('lt-output');
      var outputPane = document.getElementById('lt-output-pane');
      var statusEl = document.getElementById('lt-status');
      var countEl = document.getElementById('lt-count');
      var copyBtn = document.getElementById('lt-copy');
      var copyRevision = 0;
      var copyTimer = null;
      var copyError = false;

      function format(key, n) {
        return t[key][n === 1 ? 'one' : 'other'].replace('{n}', String(n));
      }

      function updateOutputState() {
        outputPane.setAttribute('data-empty', outputEl.value ? 'false' : 'true');
      }

      function setStatus(msg, isError) {
        copyError = false;
        statusEl.textContent = msg;
        statusEl.className = 'lt-status ' + (isError ? 'error' : 'success');
        updateOutputState();
      }

      function clearStatus() {
        copyError = false;
        statusEl.textContent = '';
        statusEl.className = 'lt-status';
        updateOutputState();
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        if (copyError) clearStatus();
      }

      function getLines() {
        var raw = inputEl.value;
        if (!raw) return [];
        return raw.split('\n');
      }

      function updateCount() {
        var raw = inputEl.value.trim();
        if (!raw) { countEl.textContent = ''; return; }
        var lines = raw.split('\n');
        countEl.textContent = format('lineCount', lines.length);
      }

      inputEl.addEventListener('input', function () { invalidateCopy(); updateCount(); });
      updateCount();

      /* ── Remove Duplicates ── */
      document.getElementById('lt-dedup').addEventListener('click', function () {
        invalidateCopy();
        var lines = getLines();
        if (!lines.length) { outputEl.value = ''; clearStatus(); return; }

        var seen = new Set();
        var result = [];
        var removed = 0;
        for (var i = 0; i < lines.length; i++) {
          if (!seen.has(lines[i])) {
            seen.add(lines[i]);
            result.push(lines[i]);
          } else {
            removed++;
          }
        }
        outputEl.value = result.join('\n');
        setStatus(format('removedDup', removed) + ' ' + format('uniqueLines', result.length), false);
        window.trackTool && window.trackTool('line_tools', 'deduplicate');
      });

      /* ── Sort A→Z ── */
      document.getElementById('lt-sort-asc').addEventListener('click', function () {
        invalidateCopy();
        var lines = getLines();
        if (!lines.length) { outputEl.value = ''; clearStatus(); return; }

        var sorted = lines.slice().sort(function (a, b) {
          return a.localeCompare(b);
        });
        outputEl.value = sorted.join('\n');
        setStatus(format('sortedAlphaAsc', sorted.length), false);
        window.trackTool && window.trackTool('line_tools', 'sort_asc');
      });

      /* ── Sort Z→A ── */
      document.getElementById('lt-sort-desc').addEventListener('click', function () {
        invalidateCopy();
        var lines = getLines();
        if (!lines.length) { outputEl.value = ''; clearStatus(); return; }

        var sorted = lines.slice().sort(function (a, b) {
          return b.localeCompare(a);
        });
        outputEl.value = sorted.join('\n');
        setStatus(format('sortedAlphaDesc', sorted.length), false);
        window.trackTool && window.trackTool('line_tools', 'sort_desc');
      });

      /* ── Sort Numeric ── */
      document.getElementById('lt-sort-num').addEventListener('click', function () {
        invalidateCopy();
        var lines = getLines();
        if (!lines.length) { outputEl.value = ''; clearStatus(); return; }

        var sorted = lines.slice().sort(function (a, b) {
          var na = parseFloat(a);
          var nb = parseFloat(b);
          if (isNaN(na) && isNaN(nb)) return a.localeCompare(b);
          if (isNaN(na)) return 1;
          if (isNaN(nb)) return -1;
          return na - nb;
        });
        outputEl.value = sorted.join('\n');
        setStatus(format('sortedNum', sorted.length), false);
        window.trackTool && window.trackTool('line_tools', 'sort_numeric');
      });

      /* ── Reverse ── */
      document.getElementById('lt-reverse').addEventListener('click', function () {
        invalidateCopy();
        var lines = getLines();
        if (!lines.length) { outputEl.value = ''; clearStatus(); return; }

        outputEl.value = lines.slice().reverse().join('\n');
        setStatus(format('reversed', lines.length), false);
        window.trackTool && window.trackTool('line_tools', 'reverse');
      });

      /* ── Shuffle ── */
      document.getElementById('lt-shuffle').addEventListener('click', function () {
        invalidateCopy();
        var lines = getLines();
        if (!lines.length) { outputEl.value = ''; clearStatus(); return; }

        var arr = lines.slice();
        for (var i = arr.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var tmp = arr[i];
          arr[i] = arr[j];
          arr[j] = tmp;
        }
        outputEl.value = arr.join('\n');
        setStatus(format('shuffled', arr.length), false);
        window.trackTool && window.trackTool('line_tools', 'shuffle');
      });

      /* ── Trim Lines ── */
      document.getElementById('lt-trim').addEventListener('click', function () {
        invalidateCopy();
        var lines = getLines();
        if (!lines.length) { outputEl.value = ''; clearStatus(); return; }

        var trimmed = lines.map(function (l) { return l.trim(); });
        outputEl.value = trimmed.join('\n');
        setStatus(format('trimmed', trimmed.length), false);
        window.trackTool && window.trackTool('line_tools', 'trim');
      });

      /* ── Remove Empty ── */
      document.getElementById('lt-empty').addEventListener('click', function () {
        invalidateCopy();
        var lines = getLines();
        if (!lines.length) { outputEl.value = ''; clearStatus(); return; }

        var result = lines.filter(function (l) { return l.trim() !== ''; });
        var removed = lines.length - result.length;
        outputEl.value = result.join('\n');
        setStatus(format('removedEmpty', removed) + ' ' + format('remaining', result.length), false);
        window.trackTool && window.trackTool('line_tools', 'remove_empty');
      });

      /* ── Clear ── */
      function clearTool() {
        invalidateCopy();
        inputEl.value = '';
        outputEl.value = '';
        countEl.textContent = '';
        clearStatus();
      }

      document.getElementById('lt-clear').addEventListener('click', clearTool);
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var widget = document.querySelector('.lt-wrap');
        if (!widget || !widget.contains(document.activeElement)) return;
        clearTool();
      });

      /* ── Copy ── */
      copyBtn.addEventListener('click', function () {
        if (!outputEl.value) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        function done() {
          if (revision !== copyRevision) return;
          if (copyError) clearStatus();
          copyBtn.textContent = t.copied;
          copyTimer = setTimeout(function () {
            if (revision === copyRevision) copyBtn.textContent = t.copy;
          }, 1500);
        }
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(t.copyFail, true);
          copyError = true;
        }
        try {
          navigator.clipboard.writeText(outputEl.value).then(done, failed);
        } catch (e) { failed(); }
      });
    })();
  </script>
</div>

