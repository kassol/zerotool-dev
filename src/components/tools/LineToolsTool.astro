  .lt-action { display: flex; align-items: center; gap: 0.2rem; min-width: 0; }
  .lt-wrap .lt-actions .btn-secondary, .lt-wrap .lt-actions .btn-ghost { flex: none; }
  .lt-head { display: flex; align-items: center; gap: 0.3rem; min-height: 32px; flex: none; }
  .lt-head label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .lt-count { margin-left: auto; font-size: 0.78rem; color: var(--color-text-muted); }
  .lt-copy-controls { display: flex; align-items: center; gap: 0.25rem; margin-left: auto; }
  .lt-status { height: 2.8em; line-height: 1.4; overflow: auto; overflow-wrap: anywhere; flex: none; font-size: 0.85rem; }
  .lt-status.success { color: var(--color-success); }
  .lt-status.error { color: var(--color-danger); }
  .lt-box { width: 100%; overflow: auto; font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.5; }
  @media (max-width: 860px) {
    .lt-output-pane[data-empty="true"] { display: none; }
    .lt-box { height: 160px; }
  }
  @media (max-width: 640px) {
    .lt-wrap { gap: 0.5rem; }
    .lt-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.35rem 0.5rem; }
    .lt-wrap .lt-action .btn-secondary { flex: 1 1 auto; min-width: 0; min-height: 44px; padding: 0.35rem 0.4rem; font-size: 0.78rem; }
    .lt-wrap .lt-actions .btn-ghost { min-height: 44px; justify-self: start; }
    .lt-status { height: 4.2em; }
    .lt-box { height: 120px; }
  }
</style>
