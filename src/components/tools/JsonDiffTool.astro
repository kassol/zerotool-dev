    msgParseErrorAfter: 'After JSON parse error: ',
    msgNoDiff: 'No differences found — the JSON values are identical.',
    msgChanges: '{n} change(s) detected.',
    sideBefore: 'Before',
    sideAfter: 'After',
    noteSep: ' ',
    msgLossy: 'JavaScript cannot hold these numbers exactly and compares them as rounded values, so differences in them can be missed and the patch writes the rounded values: {list}.',
    msgDup: 'These keys appear more than once in the same object; JSON.parse keeps only the last value, and only that value is compared: {list}.',
    msgMore: 'and {n} more',
    msgTooDeep: 'The JSON is nested too deeply to compare in this browser (the call stack ran out). Nothing was compared.',
  },
  zh: {
    result: "结果",
