---
// JsonDiffTool — deep JSON comparison producing RFC 6902 JSON Patch + visual diff
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: {
    result: "Result",
    hideInputs: "Hide inputs",
    showInputs: "Show inputs",
    emptyResult: "Compare two JSON values to see their patch and visual differences here.",
    tips: {
      compare: "Click Compare or press Ctrl+Enter (⌘+Enter on Mac). Both inputs must be valid JSON. Comparison runs only on request; formatting and object key order do not affect the patch.",
      clear: "Clear or Ctrl+L (⌘+L on Mac) empties both inputs, results and status while focus is inside the tool.",
      swap: "Swap exchanges both inputs and clears the results. Click Compare again to generate the reverse patch.",
      before: "Enter the original JSON value: an object, array, string, number, boolean or null. Comments and trailing commas are invalid JSON. Numbers use JavaScript precision.",
      after: "Enter the changed JSON value. Arrays compare by index, not by an id field. Editing either input clears old results without comparing automatically.",
      patch: "Copy copies the complete JSON Patch. It contains add, remove and replace operations; paths escape ~ as ~0 and / as ~1. Array removals run from the highest index down. Copy failures keep the patch available for retry.",
      visual: "Visual Diff shows + for additions, − for removals and ~ for changed values. Dotted paths are for reading; use JSON Pointer paths from the patch in code. Unchanged values are omitted.",
      results: "When differences exist, Hide inputs frees space for the results without discarding text. Show inputs restores the editors. Identical values show a status message without a patch.",
