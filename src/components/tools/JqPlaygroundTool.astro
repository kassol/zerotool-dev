    else fallback();
  }

  /* ── files ── */
  $('jqp-open').addEventListener('click', function () { fileEl.click(); });
  fileEl.addEventListener('change', function () { if (fileEl.files && fileEl.files[0]) openFile(fileEl.files[0]); fileEl.value = ''; });
  var inputPanel = $('jqp-input-panel');
  inputPanel.addEventListener('dragover', function (e) { if (e.dataTransfer && Array.from(e.dataTransfer.types || []).indexOf('Files') >= 0) { e.preventDefault(); inputPanel.classList.add('jqp-drop'); } });
  inputPanel.addEventListener('dragleave', function () { inputPanel.classList.remove('jqp-drop'); });
  inputPanel.addEventListener('drop', function (e) {
    inputPanel.classList.remove('jqp-drop');
    var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (!f) return;
    e.preventDefault();
    openFile(f);
  });
  function openFile(f) {
