  copyBtn.addEventListener('click', function () { copyText(state.lastStdout, copyBtn, T.copy, T.copied); if (window.trackTool) window.trackTool(SLUG, 'copy'); });
  $('jqp-copy-cmd').addEventListener('click', function (e) { copyText(cmdEl.textContent, e.currentTarget, T.copyCommand, T.copied); });
  $('jqp-copy-link').addEventListener('click', function (e) {
