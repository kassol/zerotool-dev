    if (inflight && runBtn.dataset.stop) { stopRun(Math.round((Date.now() - inflight.sentAt) / 1000)); return; }
    clearTimeout(runTimer);
    run(true);
    if (window.trackTool) window.trackTool(SLUG, 'run-button');
  });

  // Load the engine on the first interaction with the tool, not on page load.
  ['focusin', 'pointerdown'].forEach(function (type) {
    wrap.addEventListener(type, function () { startWorker(); }, { once: true });
  });

  var undoInput = null;
  examplesEl.addEventListener('change', function () {
    var ex = EXAMPLES.find(function (e) { return e.id === examplesEl.value; });
    examplesEl.value = '';
    if (!ex) return;
    var st = exampleState(ex);
    var before = currentInput();
    var replacing = !state.file && before.trim() !== '' && before !== st.input && !EXAMPLES.some(function (e) { return exampleState(e).input === before; });
    closeFile();
    filterEl.value = st.filter;
    inputEl.value = st.input;
    state.opts = st.opts;
    state.args = st.args;
    renderOptions(); renderArgs(); renderNotes(); renderCommand();
    if (replacing) {
      undoInput = before;
      state.notice = { text: T.exampleLoaded, label: T.undo, action: function () { inputEl.value = undoInput; undoInput = null; setStatus('', ''); schedule(0); } };
