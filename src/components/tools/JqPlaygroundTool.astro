    f.arrayBuffer().then(function (buf) {
      var text;
      try { text = new TextDecoder('utf-8', { fatal: true }).decode(buf); }
      catch (e) { setStatus(fill(T.fileEncoding, { name: f.name }), 'error'); return; }
      if (text.length > EDITOR_LIMIT) {
        state.file = { name: f.name, size: f.size, text: text };
        fileText.textContent = fill(T.fileOpened, { name: f.name, size: formatBytes(f.size), limit: formatBytes(EDITOR_LIMIT) });
        fileBanner.hidden = false;
        inputEl.value = text.slice(0, 20000);
        inputEl.readOnly = true;
        inputEl.classList.add('jqp-input--file');
      } else {
        closeFile();
        inputEl.value = text;
      }
      clearTimeout(runTimer);
      run(true);
    }, function () { setStatus(fill(T.fileReadError, { name: f.name }), 'error'); });
  }
  function closeFile() {
    if (!state.file) return;
    state.file = null;
    fileBanner.hidden = true;
    inputEl.readOnly = false;
    inputEl.classList.remove('jqp-input--file');
    inputEl.value = '';
  }
  $('jqp-file-close').addEventListener('click', function () { closeFile(); clearOutput(); persist(); });

  /* ── start ── */
  // A shared link (#jq=…) sets the filter, options and variable names; the hash is removed
  // from the address bar once read.
  function applyShare() {
    var shared = decodeShare(location.hash);
    if (!shared || shared.error) return false;
    filterEl.value = shared.filter;
    state.opts = shared.opts;
    state.args = shared.args;
    try { history.replaceState(null, '', location.pathname + location.search); } catch (e) {}
    return true;
  }
  window.addEventListener('hashchange', function () {
    if (applyShare()) { renderOptions(); renderArgs(); renderNotes(); renderCommand(); startWorker(); run(false); }
  });
  (function init() {
    var restored = false;
    if (applyShare()) {
      restored = true;
      try {
        var saved0 = window.ztPersist && window.ztPersist.load(SLUG);
        if (saved0 && typeof saved0.json === 'string') inputEl.value = saved0.json;
      } catch (e) {}
    } else {
      try {
        var saved = window.ztPersist && window.ztPersist.load(SLUG);
        if (saved && typeof saved === 'object') {
          if (typeof saved.filter === 'string') filterEl.value = saved.filter;
          if (typeof saved.json === 'string') inputEl.value = saved.json;
          state.opts = normalizeOptions(saved.opts);
          state.args = normalizeArgs(saved.args);
          restored = filterEl.value !== DEFAULT_FILTER || inputEl.value !== SAMPLE_INPUT || buildFlags(state.opts, state.args).length > 0;
        }
      } catch (e) {}
    }
    renderOptions(); renderArgs(); renderNotes(); renderCommand();
    // The sample output is in the page already; run only when the state differs from it.
    if (restored) { startWorker(); run(false); }
  })();
</script>

<style is:global>
