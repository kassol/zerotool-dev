      filter: "입력을 멈추고 0.25초 뒤에 실행합니다. 필터가 비어 있으면 .(그대로 출력)으로 실행합니다. Ctrl+Enter(Mac은 \u2318+Enter)를 누르면 바로 실행합니다. curl \u2026 | jq -r '.items[]' 같은 명령 전체를 붙여 넣으면 필터, 옵션, 변수를 가져올지 묻습니다. 필터를 감싼 셸 따옴표를 제거하거나, 문자열 밖의 전각 기호와 둥근 따옴표를 바꿀 수도 있습니다. import, include, -f는 디스크의 파일이 필요해 쓸 수 없습니다.",
      run: "필터를 바로 실행합니다. 2MB가 넘는 입력은 입력하는 동안 실행하지 않으니 「실행」을 누르세요. 실행이 1초 이어지면 버튼이 「중지」로 바뀝니다. 10초(입력 1MB마다 1초 추가)가 넘는 실행은 중지합니다. repeat(1) 같은 필터는 스스로 끝나지 않습니다.",
      options: "버튼 하나가 jq 명령줄 옵션 하나이며, jq에 넘기듯이 켭니다. -r은 문자열을 따옴표 없이 출력하고, -c는 값 하나를 한 줄로 출력하고, -s는 모든 입력 값을 배열 하나로 모으고, -n은 null에서 시작해 필터가 input이나 inputs로 입력을 읽고, -R은 입력을 텍스트 줄로 읽습니다. 버튼에 포인터를 올리면 설명이 보입니다. 「들여쓰기」는 JSON 출력의 들여쓰기(--indent n 또는 --tab)를 정합니다.",
      args: "필터에서 $이름으로 읽는 변수를 추가합니다. --arg는 값을 문자열로 넘기고, --argjson은 값을 JSON으로 파싱하므로 10은 숫자, {\"a\":1}은 객체가 됩니다. 이름에는 영문자, 숫자, _를 쓸 수 있고 숫자로 시작할 수 없습니다. 이름이 올바르지 않거나 두 번 쓰였거나 --argjson 값이 올바른 JSON이 아닌 동안에는 필터를 실행하지 않습니다.",
      input: "JSON, 이어서 나열된 여러 JSON 값(JSON Lines, NDJSON), 또는 -R과 함께 쓰는 텍스트를 넣습니다. 「파일 열기」는 200MB 이하의 UTF-8 파일을 읽습니다. 이 칸에 파일을 끌어다 놓아도 됩니다. 2MB가 넘는 파일은 편집기에 표시하지 않고 앞 20,000자만 보이지만 jq는 파일 전체를 읽습니다. 2MB가 넘는 입력은 「실행」을 눌러야 실행됩니다. 「지우기」는 입력과 출력을 지우고 필터는 그대로 둡니다. 필터, 옵션, 변수(이름과 값), 직접 입력하거나 붙여 넣은 40KB 이하의 입력은 이 브라우저에 저장되어 다음에 열 때 돌아옵니다. 연 파일은 저장하지 않습니다. 「지우기」를 누르면 저장된 입력도 지워집니다.",
      output: "jq가 stdout에 쓴 내용을 그대로 보여 줍니다. jq가 오류를 내면 stderr 문구는 출력 아래에, 종료 코드는 두 칸 위의 상태 줄에 나옵니다. 「입력에서 보기」와 「필터에서 보기」는 jq가 알려 준 위치를 선택합니다. 출력 칸은 앞 1MB만 보여 주고, 256KB 이하의 JSON에는 색을 입힙니다. 「복사」와 「다운로드」는 항상 출력 전체입니다. 다운로드 파일 이름은 output.json이고, -c를 켜면 output.jsonl, -r이나 -j를 켜면 output.txt입니다.",
      command: "같은 실행을 셸 명령으로 적은 것입니다. 입력을 input.json으로 저장하고 명령을 bash나 zsh에 붙여 넣으세요. 필터와 변수 값은 POSIX 셸에 맞게 따옴표로 감쌌습니다. 「링크 복사」로 얻는 링크에는 필터, 옵션, 변수 이름만 들어가고 입력과 변수 값은 이 기기에 남습니다.",
    },
  },
};
/* strings:end */

const T = STRINGS[lang] ?? STRINGS.en;
// The script gets every string except the toggletip text, which is in the HTML.
const { tips: TIPS, ...CLIENT_T } = T;
const exampleLabel = (ex) => {
  const flags = ex.flags ? Object.keys(ex.flags).filter((k) => ex.flags[k]).map((k) => BOOL_OPTIONS.find((d) => d.key === k)?.short || '--' + k) : [];
  const args = (ex.args || []).map((a) => (a.type === 'json' ? '--argjson ' : '--arg ') + a.name);
  const extra = [...flags, ...args];
  return ex.filter + (extra.length ? '   (' + extra.join(' ') + ')' : '');
};
const sampleHtml = highlightJson(SAMPLE_OUTPUT);
const sampleCount = countJsonValues(SAMPLE_OUTPUT);
const sampleCommand = buildCommand(DEFAULT_FILTER, defaultOptions(), []);
---

<div class="jqp-wrap" id="jqp-wrap" data-strings={JSON.stringify(CLIENT_T)} data-sample-input={SAMPLE_INPUT} data-default-filter={DEFAULT_FILTER}>
  <div class="jqp-top">
    <div class="jqp-filter-head">
      <label class="tool-label" for="jqp-filter">{T.filter}</label>
      <Toggletip id="jqp-tip-filter" lang={lang} about={T.filter} wide>{TIPS.filter}</Toggletip>
      <select id="jqp-examples" class="jqp-examples" aria-label={T.examples}>
        <option value="">{T.examplesPick}</option>
        {EXAMPLE_GROUPS.map((g) => (
          <optgroup label={T.groups[g]}>
            {EXAMPLES.filter((ex) => ex.group === g).map((ex) => <option value={ex.id}>{exampleLabel(ex)}</option>)}
          </optgroup>
        ))}
      </select>
    </div>
    <div class="jqp-filter-row">
      <textarea id="jqp-filter" class="tool-textarea jqp-filter" rows="2" spellcheck="false" autocomplete="off" autocapitalize="off">{DEFAULT_FILTER}</textarea>
      <span class="jqp-run-cell">
        <button id="jqp-run" class="btn-primary jqp-run" type="button">{T.run}</button>
        <Toggletip id="jqp-tip-run" lang={lang} about={T.run} wide>{TIPS.run}</Toggletip>
      </span>
    </div>
    <div id="jqp-filter-notes" class="jqp-notes" aria-live="polite"></div>
    <div class="jqp-opts" role="group" aria-label={T.options}>
      {BOOL_OPTIONS.map((d) => (
        <button type="button" class="jqp-opt" data-opt={d.key} aria-pressed="false" title={T.opt[d.key]} aria-label={(d.short || d.long) + ' — ' + T.opt[d.key]}>{d.short || d.long}</button>
      ))}
      <Toggletip id="jqp-tip-options" lang={lang} about={T.options} wide>{TIPS.options}</Toggletip>
      <label class="jqp-indent">
        <span>{T.indent}</span>
        <select id="jqp-indent">
          {INDENT_VALUES.map((v) => <option value={v}>{T.indentValues[v]}</option>)}
        </select>
      </label>
      <span class="jqp-add">
        <button type="button" id="jqp-add-arg" class="jqp-opt jqp-add-arg">{T.addArg}</button>
        <Toggletip id="jqp-tip-args" lang={lang} about={T.argsLabel} wide>{TIPS.args}</Toggletip>
      </span>
    </div>
    <div id="jqp-args" class="jqp-args"></div>
  </div>

  <div class="jqp-statusline">
    <span id="jqp-count" class="jqp-count">{sampleCount === 1 ? T.valueOne : T.valueMany.replace('{n}', String(sampleCount))}</span>
    <span id="jqp-exit" class="jqp-exit" hidden></span>
    <div id="jqp-status" class="jqp-status" role="status" aria-live="polite"></div>
  </div>

  <div class="jqp-io zt-io">
    <div class="jqp-panel zt-io-pane" id="jqp-input-panel">
      <div class="jqp-panel-head">
        <label class="tool-label" for="jqp-input">{T.input}</label>
        <Toggletip id="jqp-tip-input" lang={lang} about={T.input} wide>{TIPS.input}</Toggletip>
        <span class="jqp-spacer"></span>
        <button id="jqp-open" class="btn-ghost jqp-small" type="button">{T.openFile}</button>
        <button id="jqp-clear" class="btn-ghost jqp-small" type="button">{T.clear}</button>
        <input id="jqp-file" type="file" accept=".json,.jsonl,.ndjson,.geojson,.txt,.log,.csv,application/json,text/plain" hidden />
      </div>
      <div id="jqp-file-banner" class="jqp-banner" hidden>
        <span id="jqp-file-text"></span>
        <button id="jqp-file-close" class="btn-ghost jqp-small" type="button">{T.closeFile}</button>
      </div>
      <textarea id="jqp-input" class="tool-textarea jqp-input zt-io-fill" spellcheck="false" autocomplete="off" autocapitalize="off">{SAMPLE_INPUT}</textarea>
    </div>

    <div class="jqp-panel zt-io-pane">
      <div class="jqp-panel-head">
        <span class="tool-label" id="jqp-out-label">{T.output}</span>
        <Toggletip id="jqp-tip-output" lang={lang} about={T.output} wide>{TIPS.output}</Toggletip>
        <span class="jqp-spacer"></span>
        <button id="jqp-copy" class="btn-copy" type="button">{T.copy}</button>
        <button id="jqp-download" class="btn-ghost jqp-small" type="button">{T.download}</button>
      </div>
      <pre id="jqp-out" class="jqp-out zt-io-fill" tabindex="0" aria-labelledby="jqp-out-label"><code id="jqp-code" set:html={sampleHtml}></code></pre>
      <div id="jqp-stderr-box" class="jqp-stderr-box" hidden>
        <div class="jqp-stderr-title">{T.stderr}</div>
        <pre id="jqp-stderr" class="jqp-stderr"></pre>
        <div id="jqp-locate" class="jqp-locate"></div>
      </div>
      <ul id="jqp-hints" class="jqp-hints" hidden></ul>
    </div>
  </div>

  <div class="jqp-cmd">
    <span class="tool-label">{T.command}</span>
    <Toggletip id="jqp-tip-command" lang={lang} about={T.command} wide>{TIPS.command}</Toggletip>
    <code id="jqp-cmd" class="jqp-cmd-text">{sampleCommand}</code>
    <button id="jqp-copy-cmd" class="btn-ghost jqp-small" type="button">{T.copyCommand}</button>
    <button id="jqp-copy-link" class="btn-ghost jqp-small" type="button">{T.copyLink}</button>
  </div>
  <p class="jqp-engine-note">{T.engineNote}</p>
</div>

<script>
  // @ts-nocheck
  import {
    EXAMPLES, SAMPLE_INPUT, DEFAULT_FILTER, normalizeOptions, normalizeArgs, buildFlags, checkArgs,
    buildCommand, detectPastedCommand, prepareInput, countJsonValues, countLines, outputIsJson, parseStderr,
    inputErrorRange, lineRange, findSuspiciousChars, fixSuspiciousChars, hintsFor, encodeShare, decodeShare,
    exampleState, highlightJson, escapeHtml, formatBytes, clipOutput, defaultOptions, parseJqCommand,
  } from './jq-playground-engine.js';

  var SLUG = 'jq-playground';
  var wrap = document.getElementById('jqp-wrap');
  var T = JSON.parse(wrap.dataset.strings);
  var $ = function (id) { return document.getElementById(id); };
  var filterEl = $('jqp-filter'), inputEl = $('jqp-input'), runBtn = $('jqp-run'), codeEl = $('jqp-code');
  var countEl = $('jqp-count'), exitEl = $('jqp-exit'), statusEl = $('jqp-status'), stderrBox = $('jqp-stderr-box');
  var stderrEl = $('jqp-stderr'), locateEl = $('jqp-locate'), hintsEl = $('jqp-hints'), notesEl = $('jqp-filter-notes');
  var argsEl = $('jqp-args'), indentEl = $('jqp-indent'), cmdEl = $('jqp-cmd'), copyBtn = $('jqp-copy');
  var fileEl = $('jqp-file'), fileBanner = $('jqp-file-banner'), fileText = $('jqp-file-text'), examplesEl = $('jqp-examples');

  var AUTO_LIMIT = 2 * 1024 * 1024;      // inputs above this run only on Run
  var EDITOR_LIMIT = 2 * 1024 * 1024;    // files above this stay out of the textarea
  var FILE_LIMIT = 200 * 1024 * 1024;
  var SHOW_LIMIT = 1024 * 1024;          // characters of output rendered
  var HIGHLIGHT_LIMIT = 256 * 1024;
  var COUNT_LIMIT = 50 * 1024 * 1024;
  var PERSIST_INPUT_LIMIT = 40 * 1024;   // ztPersist keeps 50 KB per tool

  var state = { opts: defaultOptions(), args: [], file: null, lastStdout: '', lastJson: true, notice: null };

  function fill(tpl, p) {
    return String(tpl).replace(/\{(\w+)\}/g, function (m, k) { return p && p[k] !== undefined ? String(p[k]) : m; });
  }
  function el(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }
  function currentInput() { return state.file ? state.file.text : inputEl.value; }

  /* ── options and variables ── */
  function renderOptions() {
    wrap.querySelectorAll('.jqp-opt[data-opt]').forEach(function (b) {
      b.setAttribute('aria-pressed', state.opts[b.dataset.opt] ? 'true' : 'false');
    });
    indentEl.value = state.opts.indent;
  }
  function renderArgs() {
    argsEl.textContent = '';
    state.args.forEach(function (a, i) {
      var row = el('div', 'jqp-arg');
      var type = el('select', 'jqp-arg-type');
      type.setAttribute('aria-label', T.argType);
      [['string', T.argString], ['json', T.argJson]].forEach(function (o) {
        var opt = el('option', '', o[1]); opt.value = o[0]; type.appendChild(opt);
      });
      type.value = a.type;
      var name = el('input', 'tool-input jqp-arg-name');
      name.type = 'text'; name.value = a.name; name.placeholder = T.argName; name.setAttribute('aria-label', T.argName);
      name.spellcheck = false; name.autocomplete = 'off';
      var value = el('input', 'tool-input jqp-arg-value');
      value.type = 'text'; value.value = a.value; value.placeholder = T.argValue; value.setAttribute('aria-label', T.argValue);
      value.spellcheck = false; value.autocomplete = 'off';
      var del = el('button', 'btn-ghost jqp-arg-del', '×');
      del.type = 'button'; del.setAttribute('aria-label', T.argRemove); del.title = T.argRemove;
      type.addEventListener('change', function () { state.args[i].type = type.value; changed(); });
      name.addEventListener('input', function () { state.args[i].name = name.value; changed(); });
      value.addEventListener('input', function () { state.args[i].value = value.value; changed(); });
      del.addEventListener('click', function () { state.args.splice(i, 1); renderArgs(); changed(); });
      row.append(type, el('span', 'jqp-dollar', '$'), name, value, del);
      argsEl.appendChild(row);
    });
  }

  /* ── persistence ── */
  function persist() {
    try {
      if (!window.ztPersist) return;
      var data = { filter: filterEl.value, opts: state.opts, args: state.args };
      if (!state.file && inputEl.value.length <= PERSIST_INPUT_LIMIT) data.json = inputEl.value;
      window.ztPersist.save(SLUG, data);
    } catch (e) {}
  }

  /* ── engine (worker) ── */
  var worker = null, workerReady = false, loadError = null;
  var nextId = 1, inflight = null, pending = null, waitTimer = null, tickTimer = null;

  function startWorker() {
    if (worker) return;
    loadError = null;
    workerReady = false;
    setStatus(T.engineLoading, 'info');
    try {
      worker = new Worker('/jq-web/jq-worker.js');
    } catch (e) {
      failLoad(e && e.message ? e.message : String(e));
      return;
    }
    worker.onmessage = onWorkerMessage;
    worker.onerror = function (ev) {
      if (!workerReady) { ev.preventDefault && ev.preventDefault(); failLoad(ev.message || 'worker error'); }
    };
  }
  function failLoad(msg) {
    loadError = msg;
    killWorker();
    inflight = null;
    setStatus(fill(T.engineFailed, { msg: msg }), 'error', T.retry, function () { startWorker(); schedule(0); });
  }
  function killWorker() {
    if (worker) { worker.terminate(); worker = null; }
    workerReady = false;
    clearTimeout(waitTimer); clearInterval(tickTimer);
    runBtn.textContent = T.run; delete runBtn.dataset.stop;
  }
  function onWorkerMessage(ev) {
    var m = ev.data || {};
    if (m.type === 'ready') {
      workerReady = true;
      if (!inflight) setStatus('', '');
      return;
    }
    if (m.type === 'loadError') { failLoad(m.message); return; }
    if (m.type !== 'result' || !inflight || m.id !== inflight.id) return;
    var req = inflight;
    inflight = null;
    clearTimeout(waitTimer); clearInterval(tickTimer);
    runBtn.textContent = T.run; delete runBtn.dataset.stop;
    if (pending) { var p = pending; pending = null; send(p); return; }
    if (m.fatal) {
      killWorker();
      render(req, { stdout: m.stdout, stderr: m.stderr, exitCode: null });
      setStatus(fill(T.fatal, { msg: String(m.fatal).replace(/[.\s]+$/, '') }), 'error');
      return;
    }
    render(req, m);
  }

  function send(req) {
    startWorker();
    if (!worker) return;
    inflight = req;
    worker.postMessage({ id: req.id, input: req.input, filter: req.filter, flags: req.flags });
    var started = Date.now();
    var limit = 10000 + Math.round(req.input.length / 1e6) * 1000;
    clearTimeout(waitTimer); clearInterval(tickTimer);
    tickTimer = setInterval(function () {
      var s = (Date.now() - started) / 1000;
      if (s >= 1 && workerReady) { runBtn.textContent = T.stop; runBtn.dataset.stop = '1'; setStatus(fill(T.running, { s: s.toFixed(0) }), 'info'); }
    }, 500);
    var check = function () {
      if (inflight !== req) return;
      // Still loading the engine: wait for it without a time limit.
      if (!workerReady) { waitTimer = setTimeout(check, 1000); return; }
      stopRun(Math.round((Date.now() - started) / 1000));
    };
    waitTimer = setTimeout(check, limit);
  }
  function stopRun(seconds) {
    killWorker();
    inflight = null; pending = null;
    clearOutput();
    setStatus(fill(T.stopped, { s: seconds }), 'error');
  }

  /* ── run ── */
  var gaTimer = null;
  function run(manual) {
    persist();
    renderCommand();
    var problems = checkArgs(state.args);
    if (problems.length) {
      showProblems(problems);
      return;
    }
    var input = currentInput();
    if (!manual && input.length > AUTO_LIMIT) {
      setStatus(fill(T.bigInput, { size: formatBytes(input.length) }), 'info');
      return;
    }
    var req = { id: nextId++, input: prepareInput(input), filter: filterEl.value.trim() === '' ? '.' : filterEl.value, flags: buildFlags(state.opts, state.args), raw: input, opts: Object.assign({}, state.opts), filterText: filterEl.value };
    if (inflight) {
      // jq is busy; replace the queued run. A run that has taken over 1.5 s is stopped instead.
      if (Date.now() - (inflight.sentAt || Date.now()) > 1500 && workerReady) { killWorker(); inflight = null; send(stamp(req)); }
      else pending = stamp(req);
      return;
    }
    send(stamp(req));
    clearTimeout(gaTimer);
    gaTimer = setTimeout(function () { if (window.trackTool) window.trackTool(SLUG, 'run'); }, 1500);
  }
  function stamp(req) { req.sentAt = Date.now(); return req; }

  var runTimer = null;
  function schedule(delay) {
    clearTimeout(runTimer);
    runTimer = setTimeout(function () { run(false); }, delay === undefined ? 250 : delay);
  }
  function changed() {
    renderNotes();
    renderCommand();
    schedule();
  }

  /* ── output ── */
  function setStatus(text, kind, actionLabel, action) {
    statusEl.textContent = '';
    statusEl.className = 'jqp-status' + (kind ? ' jqp-status--' + kind : '');
    if (!text) return;
    statusEl.appendChild(el('span', '', text));
    if (actionLabel) {
      var b = el('button', 'btn-ghost jqp-small', actionLabel);
      b.type = 'button';
      b.addEventListener('click', action);
      statusEl.appendChild(b);
    }
  }
  function showProblems(problems) {
    clearOutput();
    var lines = problems.map(function (p) { return fill(T.argProblem[p.code], { row: p.row + 1, name: p.name }); });
    setStatus(lines.join(' '), 'error');
  }
  function clearOutput() {
    codeEl.textContent = '';
    countEl.textContent = '';
    exitEl.hidden = true;
    stderrBox.hidden = true;
    hintsEl.hidden = true;
    copyBtn.disabled = true;
    state.lastStdout = '';
  }

  function render(req, r) {
    var stdout = r.stdout || '';
    state.lastStdout = stdout;
    state.lastJson = outputIsJson(req.opts);
    if (state.notice) { setStatus(state.notice.text, 'info', state.notice.label, state.notice.action); state.notice = null; }
    else setStatus('', '');
    if (!stdout) {
      codeEl.textContent = '';
      codeEl.appendChild(el('span', 'jqp-no-output', T.noOutput));
      countEl.textContent = '';
    } else {
      var clip = clipOutput(stdout, SHOW_LIMIT);
      codeEl.innerHTML = state.lastJson && clip.shown.length <= HIGHLIGHT_LIMIT ? highlightJson(clip.shown) : escapeHtml(clip.shown);
      if (clip.clipped) setStatus(fill(T.clipped, { shown: formatBytes(clip.shown.length), total: formatBytes(stdout.length) }), 'info');
      if (stdout.length > COUNT_LIMIT) countEl.textContent = fill(T.notCounted, { size: formatBytes(stdout.length) });
      else {
        var n = state.lastJson ? countJsonValues(stdout) : countLines(stdout);
        countEl.textContent = state.lastJson ? (n === 1 ? T.valueOne : fill(T.valueMany, { n: n })) : (n === 1 ? T.lineOne : fill(T.lineMany, { n: n }));
      }
      if (typeof r.ms === 'number') countEl.textContent += ' · ' + fill(T.ranIn, { ms: Math.max(1, Math.round(r.ms)) });
    }
    copyBtn.disabled = !stdout;
    if (r.exitCode) { exitEl.hidden = false; exitEl.textContent = fill(T.exitCode, { n: r.exitCode }); }
    else exitEl.hidden = true;

    // stderr exactly as jq prints it, plus buttons that select the reported position.
    var stderr = r.stderr || '';
    stderrBox.hidden = !stderr;
