  function renderCommand() {
    cmdEl.textContent = buildCommand(filterEl.value.trim() === '' ? '.' : filterEl.value, state.opts, state.args);
  }

  /* ── events ── */
  wrap.querySelectorAll('.jqp-opt[data-opt]').forEach(function (b) {
    b.addEventListener('click', function () {
      var k = b.dataset.opt;
      state.opts[k] = !state.opts[k];
