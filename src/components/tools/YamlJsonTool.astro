---
import Toggletip from '../Toggletip.astro';
// YamlJsonTool — bidirectional YAML ↔ JSON converter (bundles js-yaml from npm).
// Values JSON or YAML cannot hold as written stop the conversion with their JSON Pointer paths:
// YAML .inf / .nan and !!binary going to JSON, integers outside ±(2^53 − 1) on either side, JSON
// numbers that overflow and YAML timestamps that are not real dates (2026-02-31) or have more than
// millisecond precision (conversion-fidelity.js). The old output is cleared and its copy button
// disabled. -0.0 is written -0.0; the JSON integer -0 is 0. Valid timestamps become UTC ISO text
// (the same instant; the written offset is not kept).
// YAML errors from the js-yaml work limits are shown in the page language (yaml-limits.js).
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: { copy: 'Copy', copied: 'Copied!', copyFailed: 'Copy failed. Try again.', clear: 'Clear', convertedYamlToJson: 'Converted YAML to JSON.', convertedJsonToYaml: 'Converted JSON to YAML.', invalidYaml: 'Invalid YAML', invalidJson: 'Invalid JSON', tips: {
    yaml: "Paste one YAML document here. After 0.3 seconds without typing, the JSON pane updates with two-space indentation. Values JSON cannot preserve stop conversion and are listed by field path.",
    json: "Paste JSON here. After 0.3 seconds without typing, the YAML pane updates with two-space indentation. Long lines are not folded.",
    copyYaml: "Copies all current text in the YAML pane, including your edits. An empty pane cannot be copied.",
    copyJson: "Copies all current text in the JSON pane, including your edits. An empty pane cannot be copied.",
    clear: "Clears both panes, the status and pending conversion. Ctrl+L (⌘+L on Mac) does the same while focus is inside this tool.",
  } },
  zh: { copy: '复制', copied: '已复制！', copyFailed: '复制失败，请重试。', clear: '清除', convertedYamlToJson: '已将 YAML 转换为 JSON。', convertedJsonToYaml: '已将 JSON 转换为 YAML。', invalidYaml: '无效 YAML', invalidJson: '无效 JSON', tips: {
    yaml: "在此粘贴一个 YAML 文档。停止输入 0.3 秒后，JSON 面板会更新，并使用两个空格缩进。遇到 JSON 无法原样保存的值时会停止转换，并按字段路径列出原因。",
    json: "在此粘贴 JSON。停止输入 0.3 秒后，YAML 面板会更新，并使用两个空格缩进。长行不会自动折叠。",
    copyYaml: "复制 YAML 面板内当前的全部文本，包括您编辑的内容。面板为空时无法复制。",
    copyJson: "复制 JSON 面板内当前的全部文本，包括您编辑的内容。面板为空时无法复制。",
    clear: "清空两个面板、状态和等待执行的转换。焦点在工具内时，Ctrl+L（Mac 为 ⌘+L）也会清空。",
  } },
  ja: { copy: 'コピー', copied: 'コピー済み！', copyFailed: 'コピーできませんでした。もう一度お試しください。', clear: 'クリア', convertedYamlToJson: 'YAML を JSON に変換しました。', convertedJsonToYaml: 'JSON を YAML に変換しました。', invalidYaml: '無効な YAML', invalidJson: '無効な JSON', tips: {
    yaml: "YAML 文書を1つ貼り付けます。入力を止めて0.3秒後に、JSON 欄がスペース2個のインデントで更新されます。JSON で元の値を保てない場合は変換を止め、フィールドのパスと理由を表示します。",
    json: "JSON を貼り付けます。入力を止めて0.3秒後に、YAML 欄がスペース2個のインデントで更新されます。長い行は折り返し形式に変換しません。",
    copyYaml: "YAML 欄に現在あるテキストを、編集した内容も含めてすべてコピーします。空の欄はコピーできません。",
    copyJson: "JSON 欄に現在あるテキストを、編集した内容も含めてすべてコピーします。空の欄はコピーできません。",
    clear: "両方の欄、ステータス、待機中の変換をクリアします。ツール内にフォーカスがある場合は、Ctrl+L（Mac は ⌘+L）でもクリアできます。",
  } },
  ko: { copy: '복사', copied: '복사됨!', copyFailed: '복사하지 못했습니다. 다시 시도하세요.', clear: '지우기', convertedYamlToJson: 'YAML을 JSON으로 변환했습니다.', convertedJsonToYaml: 'JSON을 YAML로 변환했습니다.', invalidYaml: '유효하지 않은 YAML', invalidJson: '유효하지 않은 JSON', tips: {
    yaml: "YAML 문서 하나를 붙여 넣으세요. 입력을 멈추고 0.3초 뒤 JSON 칸이 공백 두 개 들여쓰기로 갱신됩니다. JSON에 원래 값 그대로 담을 수 없으면 변환을 멈추고 필드 경로와 이유를 표시합니다.",
    json: "JSON을 붙여 넣으세요. 입력을 멈추고 0.3초 뒤 YAML 칸이 공백 두 개 들여쓰기로 갱신됩니다. 긴 줄을 접힌 형식으로 바꾸지 않습니다.",
    copyYaml: "직접 편집한 내용을 포함하여 YAML 칸의 현재 텍스트 전체를 복사합니다. 빈 칸은 복사할 수 없습니다.",
    copyJson: "직접 편집한 내용을 포함하여 JSON 칸의 현재 텍스트 전체를 복사합니다. 빈 칸은 복사할 수 없습니다.",
    clear: "두 칸과 상태를 지우고 대기 중인 변환을 취소합니다. 도구 안에 포커스가 있을 때 Ctrl+L(Mac은 ⌘+L)로도 지울 수 있습니다.",
  } },
};
// strings:end
const T = STRINGS[lang] || STRINGS.en;
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="yj-wrap" data-lang={lang} data-strings={JSON.stringify(CLIENT_T)}>
  <div class="yj-toolbar">
    <button id="yj-clear" class="btn-ghost" type="button">{T.clear}</button>
    <Toggletip id="yj-tip-clear" about={T.clear} lang={lang}>{TIPS.clear}</Toggletip>
  </div>

  <div id="yj-status" class="yj-status" aria-live="polite"></div>

  <div class="yj-panels zt-io">
    <div class="yj-panel zt-io-pane">
      <div class="yj-head">
        <div class="yj-control">
          <label for="yj-yaml">YAML</label>
          <Toggletip id="yj-tip-yaml" about="YAML" lang={lang}>{TIPS.yaml}</Toggletip>
        </div>
        <div class="yj-control">
          <button id="yj-copy-yaml" class="btn-copy" type="button" disabled>{T.copy}</button>
          <Toggletip id="yj-tip-copy-yaml" about={T.copy + ' YAML'} lang={lang}>{TIPS.copyYaml}</Toggletip>
        </div>
      </div>
      <textarea
        id="yj-yaml"
        class="tool-textarea yj-box zt-io-fill"
        placeholder="name: Alice&#10;age: 30&#10;hobbies:&#10;  - reading&#10;  - hiking"
        spellcheck="false"
      ></textarea>
    </div>
    <div class="yj-panel zt-io-pane">
      <div class="yj-head">
        <div class="yj-control">
          <label for="yj-json">JSON</label>
          <Toggletip id="yj-tip-json" about="JSON" lang={lang}>{TIPS.json}</Toggletip>
        </div>
        <div class="yj-control">
          <button id="yj-copy-json" class="btn-copy" type="button" disabled>{T.copy}</button>
          <Toggletip id="yj-tip-copy-json" about={T.copy + ' JSON'} lang={lang}>{TIPS.copyJson}</Toggletip>
        </div>
      </div>
      <textarea
        id="yj-json"
        class="tool-textarea yj-box zt-io-fill"
        placeholder='{"name":"Alice","age":30,"hobbies":["reading","hiking"]}'
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <script>
    import jsyaml from 'js-yaml';
    import { yamlLoadSchema, parseJsonExact, findLosses, formatLosses, stringifyJson } from './conversion-fidelity.js';
    import { yamlErrorText } from './yaml-limits.js';

    const yamlEl = document.getElementById('yj-yaml') as HTMLTextAreaElement;
    const jsonEl = document.getElementById('yj-json') as HTMLTextAreaElement;
    const statusEl = document.getElementById('yj-status') as HTMLElement;
    const copyYamlBtn = document.getElementById('yj-copy-yaml') as HTMLButtonElement;
    const copyJsonBtn = document.getElementById('yj-copy-json') as HTMLButtonElement;
    const yjWrap = document.querySelector('.yj-wrap') as HTMLElement;
    const S = JSON.parse(yjWrap.dataset.strings || '{}');
    const LANG = yjWrap.dataset.lang || 'en';
    const YAML_SCHEMA = yamlLoadSchema(jsyaml, { timestamps: true });

    type Result = { ok: true; text: string } | { ok: false; message: string };

    function yamlToJson(raw: string): Result {
      let data: any;
      try { data = jsyaml.load(raw, { schema: YAML_SCHEMA }); }
      catch (e: any) { return { ok: false, message: S.invalidYaml + ': ' + yamlErrorText(e, LANG) }; }
      const found = findLosses(data, 'json');
      if (found.count) return { ok: false, message: formatLosses(found, 'JSON', LANG) };
      return { ok: true, text: stringifyJson(found.value, 2) };
    }

    function jsonToYaml(raw: string): Result {
      let data: any;
      try { data = parseJsonExact(raw); }
      catch (e: any) { return { ok: false, message: S.invalidJson + ': ' + (e?.message || String(e)) }; }
      const found = findLosses(data, 'yaml');
      if (found.count) return { ok: false, message: formatLosses(found, 'YAML', LANG) };
      return { ok: true, text: jsyaml.dump(found.value, { indent: 2, lineWidth: -1, noRefs: true }) };
    }

    function syncCopy() {
      copyYamlBtn.disabled = !yamlEl.value;
      copyJsonBtn.disabled = !jsonEl.value;
    }

    function setStatus(msg: string, isError: boolean) {
      copyErrorOwner = null;
      statusEl.textContent = msg;
      statusEl.className = 'yj-status ' + (isError ? 'error' : 'success');
    }

    function clearStatus() {
      copyErrorOwner = null;
      statusEl.textContent = '';
      statusEl.className = 'yj-status';
    }

    let copyRevision = 0;
    let copyErrorOwner: HTMLButtonElement | null = null;
    const copyStates = [copyYamlBtn, copyJsonBtn].map(btn => ({ btn, request: 0, timer: null as ReturnType<typeof setTimeout> | null }));

    function invalidateCopies() {
      copyRevision++;
      copyErrorOwner = null;
      copyStates.forEach(state => {
        if (state.timer) clearTimeout(state.timer);
        state.timer = null;
        state.btn.textContent = S.copy;
      });
    }

    function cancelQueued() {
      if (_yjYamlTimer) clearTimeout(_yjYamlTimer);
      if (_yjJsonTimer) clearTimeout(_yjJsonTimer);
      _yjYamlTimer = _yjJsonTimer = null;
    }

    /* Runs one direction; a failed conversion clears the output so a stale result cannot be copied. */
    function run(fromEl: HTMLTextAreaElement, toEl: HTMLTextAreaElement, convert: (raw: string) => Result, okMsg: string): boolean {
      cancelQueued();
      invalidateCopies();
      const raw = fromEl.value.trim();
      if (!raw) { toEl.value = ''; clearStatus(); syncCopy(); return false; }
      const r = convert(raw);
      if (r.ok) { toEl.value = r.text; setStatus(okMsg, false); }
      else { toEl.value = ''; setStatus(r.message, true); }
      syncCopy();
      return r.ok;
    }
    const runYaml = () => run(yamlEl, jsonEl, yamlToJson, S.convertedYamlToJson);
    const runJson = () => run(jsonEl, yamlEl, jsonToYaml, S.convertedJsonToYaml);

    /* ── Real-time conversion (debounced 300ms) ── */
    let _yjYamlTimer: ReturnType<typeof setTimeout> | null = null;
    yamlEl.addEventListener('input', () => {
      cancelQueued();
      invalidateCopies();
      syncCopy();
      _yjYamlTimer = setTimeout(runYaml, 300);
    });

    let _yjJsonTimer: ReturnType<typeof setTimeout> | null = null;
    jsonEl.addEventListener('input', () => {
      cancelQueued();
      invalidateCopies();
      syncCopy();
      _yjJsonTimer = setTimeout(runJson, 300);
    });

    function clearAll() {
      cancelQueued();
      invalidateCopies();
      yamlEl.value = '';
      jsonEl.value = '';
      clearStatus();
      syncCopy();
      yamlEl.focus();
    }
    document.getElementById('yj-clear')!.addEventListener('click', clearAll);

    /* ── Copy buttons ── */
    function copyFrom(el: HTMLTextAreaElement, btn: HTMLButtonElement) {
      if (!el.value || btn.disabled) return;
      const state = copyStates[btn === copyYamlBtn ? 0 : 1];
      const request = ++state.request;
      const revision = copyRevision;
      const text = el.value;
      if (state.timer) clearTimeout(state.timer);
      state.timer = null;
      btn.textContent = S.copy;
      const current = () => revision === copyRevision && request === state.request && el.value === text && !btn.disabled;
      const failed = () => {
        if (!current()) return;
        setStatus(S.copyFailed, true);
        copyErrorOwner = btn;
      };
      const done = () => {
        if (!current()) return;
        if (copyErrorOwner === btn && statusEl.textContent === S.copyFailed) clearStatus();
        btn.textContent = S.copied;
        state.timer = setTimeout(() => { if (current()) btn.textContent = S.copy; }, 1500);
      };
      try {
        if (!navigator.clipboard?.writeText) { failed(); return; }
        navigator.clipboard.writeText(text).then(done, failed);
      } catch { failed(); }
    }
    copyYamlBtn.addEventListener('click', () => copyFrom(yamlEl, copyYamlBtn));
    copyJsonBtn.addEventListener('click', () => copyFrom(jsonEl, copyJsonBtn));

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && yjWrap.contains(document.activeElement)) {
        e.preventDefault();
        clearAll();
      }
    });

    /* ── Page load ── Astro bundles this script as a module, which runs only after the page is
       parsed. Text typed (or restored by the browser) before then had no input listener, so
       convert it once now: the focused panel first, else the YAML panel, else the JSON panel. */
    const focused = document.activeElement;
    if (focused === jsonEl && jsonEl.value.trim()) runJson();
    else if (yamlEl.value.trim()) runYaml();
    else if (jsonEl.value.trim()) runJson();
  </script>
</div>

<style>
  .yj-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; min-height: 0; }
  .yj-toolbar { display: flex; align-items: center; gap: 0.4rem; flex: none; }
  .yj-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; min-height: 32px; }
  .yj-control { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .yj-head label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .yj-box { min-width: 0; overflow: auto; tab-size: 2; }
  .yj-status { height: 2.6rem; min-height: 2.6rem; flex: none; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; line-height: 1.5; color: var(--color-text-secondary); }
  .yj-status.success { color: var(--color-success); }
  .yj-status.error { color: var(--color-danger); }

  @media (max-width: 860px) {
    .yj-box { height: 180px; }
    .yj-status { height: 3.25rem; min-height: 3.25rem; }
  }
  @media (max-width: 640px) {
    .yj-wrap { gap: 0.5rem; }
    .yj-head { min-height: 44px; }
    .yj-box { height: 120px; }
  }
</style>
