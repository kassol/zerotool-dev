---
// YamlJsonTool — bidirectional YAML ↔ JSON converter (bundles js-yaml from npm).
// Values JSON or YAML cannot hold as written stop the conversion with their JSON Pointer paths:
// YAML .inf / .nan going to JSON, integers outside ±(2^53 − 1) on either side, JSON numbers
// that overflow and YAML timestamps that are not real dates (2026-02-31) or have more than
// millisecond precision (conversion-fidelity.js). The old output is cleared and its copy button
// disabled. -0.0 is written -0.0; the JSON integer -0 is 0. Valid timestamps become UTC ISO text
// (the same instant; the written offset is not kept).
// YAML errors from the js-yaml work limits are shown in the page language (yaml-limits.js).
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: { copy: 'Copy', copied: 'Copied!', clear: 'Clear', yamlToJson: 'YAML \u2192 JSON', jsonToYaml: 'JSON \u2192 YAML', convertedYamlToJson: 'Converted YAML to JSON.', convertedJsonToYaml: 'Converted JSON to YAML.', invalidYaml: 'Invalid YAML', invalidJson: 'Invalid JSON' },
  zh: { copy: '复制', copied: '已复制！', clear: '清除', yamlToJson: 'YAML \u2192 JSON', jsonToYaml: 'JSON \u2192 YAML', convertedYamlToJson: '已将 YAML 转换为 JSON。', convertedJsonToYaml: '已将 JSON 转换为 YAML。', invalidYaml: '无效 YAML', invalidJson: '无效 JSON' },
  ja: { copy: 'コピー', copied: 'コピー済み！', clear: 'クリア', yamlToJson: 'YAML \u2192 JSON', jsonToYaml: 'JSON \u2192 YAML', convertedYamlToJson: 'YAML を JSON に変換しました。', convertedJsonToYaml: 'JSON を YAML に変換しました。', invalidYaml: '無効な YAML', invalidJson: '無効な JSON' },
  ko: { copy: '복사', copied: '복사됨!', clear: '지우기', yamlToJson: 'YAML \u2192 JSON', jsonToYaml: 'JSON \u2192 YAML', convertedYamlToJson: 'YAML을 JSON으로 변환했습니다.', convertedJsonToYaml: 'JSON을 YAML로 변환했습니다.', invalidYaml: '유효하지 않은 YAML', invalidJson: '유효하지 않은 JSON' },
};
// strings:end
const T = STRINGS[lang] || STRINGS.en;
---

<div>
  <div class="yj-wrap" data-lang={lang} data-strings={JSON.stringify(T)}>
    <div class="yj-panels">
      <div class="yj-panel">
        <label for="yj-yaml">
          <span>YAML</span>
          <button id="yj-copy-yaml" class="btn-copy" type="button" disabled>{T.copy}</button>
        </label>
        <textarea
          id="yj-yaml"
          placeholder="name: Alice&#10;age: 30&#10;hobbies:&#10;  - reading&#10;  - hiking"
          spellcheck="false"
        ></textarea>
      </div>
      <div class="yj-panel">
        <label for="yj-json">
          <span>JSON</span>
          <button id="yj-copy-json" class="btn-copy" type="button" disabled>{T.copy}</button>
        </label>
        <textarea
          id="yj-json"
          placeholder='{"name":"Alice","age":30,"hobbies":["reading","hiking"]}'
          spellcheck="false"
        ></textarea>
      </div>
    </div>

    <div class="yj-actions">
      <button id="yj-to-json" class="btn-primary">{T.yamlToJson}</button>
      <button id="yj-to-yaml" class="btn-primary">{T.jsonToYaml}</button>
      <button id="yj-clear" class="btn-ghost">{T.clear}</button>
    </div>

    <div id="yj-status" class="yj-status" aria-live="polite"></div>
  </div>

  <script>
    import jsyaml from 'js-yaml';
    import { yamlLoadSchema, parseJsonExact, findLosses, formatLosses, stringifyJson } from './conversion-fidelity.js';
    import { yamlErrorText } from './yaml-limits.js';

    const yamlEl = document.getElementById('yj-yaml') as HTMLTextAreaElement;
    const jsonEl = document.getElementById('yj-json') as HTMLTextAreaElement;
    const statusEl = document.getElementById('yj-status') as HTMLElement;
    const copyYamlBtn = document.getElementById('yj-copy-yaml') as HTMLButtonElement;
    const copyJsonBtn = document.getElementById('yj-copy-json') as HTMLButtonElement;
    const yjWrap = document.querySelector('.yj-wrap') as HTMLElement;
    const S = JSON.parse(yjWrap.dataset.strings || '{}');
    const LANG = yjWrap.dataset.lang || 'en';
    const YAML_SCHEMA = yamlLoadSchema(jsyaml, { timestamps: true });

    type Result = { ok: true; text: string } | { ok: false; message: string };

    function yamlToJson(raw: string): Result {
      let data: any;
      try { data = jsyaml.load(raw, { schema: YAML_SCHEMA }); }
      catch (e: any) { return { ok: false, message: S.invalidYaml + ': ' + yamlErrorText(e, LANG) }; }
      const found = findLosses(data, 'json');
      if (found.count) return { ok: false, message: formatLosses(found, 'JSON', LANG) };
      return { ok: true, text: stringifyJson(found.value, 2) };
    }

    function jsonToYaml(raw: string): Result {
      let data: any;
      try { data = parseJsonExact(raw); }
      catch (e: any) { return { ok: false, message: S.invalidJson + ': ' + (e?.message || String(e)) }; }
      const found = findLosses(data, 'yaml');
      if (found.count) return { ok: false, message: formatLosses(found, 'YAML', LANG) };
      return { ok: true, text: jsyaml.dump(found.value, { indent: 2, lineWidth: -1, noRefs: true }) };
    }

    function syncCopy() {
      copyYamlBtn.disabled = !yamlEl.value;
      copyJsonBtn.disabled = !jsonEl.value;
    }

    function setStatus(msg: string, isError: boolean) {
      statusEl.textContent = msg;
      statusEl.className = 'yj-status ' + (isError ? 'error' : 'success');
    }

    function clearStatus() {
      statusEl.textContent = '';
      statusEl.className = 'yj-status';
    }

    /* Runs one direction; a failed conversion clears the output so a stale result cannot be copied. */
    function run(fromEl: HTMLTextAreaElement, toEl: HTMLTextAreaElement, convert: (raw: string) => Result, okMsg: string): boolean {
      const raw = fromEl.value.trim();
      if (!raw) { clearStatus(); syncCopy(); return false; }
      const r = convert(raw);
      if (r.ok) { toEl.value = r.text; setStatus(okMsg, false); }
      else { toEl.value = ''; setStatus(r.message, true); }
      syncCopy();
      return r.ok;
    }
    const runYaml = () => run(yamlEl, jsonEl, yamlToJson, S.convertedYamlToJson);
    const runJson = () => run(jsonEl, yamlEl, jsonToYaml, S.convertedJsonToYaml);

    /* ── Real-time conversion (debounced 300ms) ── */
    let _yjYamlTimer: ReturnType<typeof setTimeout> | null = null;
    yamlEl.addEventListener('input', () => {
      syncCopy();
      if (_yjYamlTimer) clearTimeout(_yjYamlTimer);
      _yjYamlTimer = setTimeout(runYaml, 300);
    });

    let _yjJsonTimer: ReturnType<typeof setTimeout> | null = null;
    jsonEl.addEventListener('input', () => {
      syncCopy();
      if (_yjJsonTimer) clearTimeout(_yjJsonTimer);
      _yjJsonTimer = setTimeout(runJson, 300);
    });

    /* ── Buttons ── */
    document.getElementById('yj-to-json')!.addEventListener('click', () => {
      if (runYaml()) (window as any).trackTool && (window as any).trackTool('yaml_json', 'yaml_to_json');
    });
    document.getElementById('yj-to-yaml')!.addEventListener('click', () => {
      if (runJson()) (window as any).trackTool && (window as any).trackTool('yaml_json', 'json_to_yaml');
    });

    document.getElementById('yj-clear')!.addEventListener('click', () => {
      yamlEl.value = '';
      jsonEl.value = '';
      clearStatus();
      syncCopy();
    });

    /* ── Copy buttons ── */
    function copyFrom(el: HTMLTextAreaElement, btn: HTMLButtonElement) {
      if (!el.value || btn.disabled) return;
      navigator.clipboard.writeText(el.value).then(() => {
        btn.textContent = S.copied;
        setTimeout(() => { btn.textContent = S.copy; }, 1500);
      });
    }
    copyYamlBtn.addEventListener('click', () => copyFrom(yamlEl, copyYamlBtn));
    copyJsonBtn.addEventListener('click', () => copyFrom(jsonEl, copyJsonBtn));

    /* ── Keyboard shortcut: Ctrl/Cmd+Enter ── */
    yamlEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) document.getElementById('yj-to-json')!.click();
    });
    jsonEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) document.getElementById('yj-to-yaml')!.click();
    });
  </script>
</div>

<style>
  .yj-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  .yj-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 600px) {
    .yj-panels { grid-template-columns: 1fr; }
  }

  .yj-panel { display: flex; flex-direction: column; gap: 0.4rem; }

  .yj-panel label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .yj-panel textarea {
    width: 100%;
    min-height: 200px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    resize: vertical;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    line-height: 1.5;
  }

  .yj-panel textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .yj-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .yj-status { font-size: 0.85rem; min-height: 1.2rem; }
  .yj-status.success { color: #057a55; }
  .yj-status.error { color: #c0392b; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .yj-status.success { color: #34d399; }
    :root:not([data-theme="light"]) .yj-status.error { color: #f87171; }
  }
  [data-theme="dark"] .yj-status.success { color: #34d399; }
  [data-theme="dark"] .yj-status.error { color: #f87171; }
</style>
