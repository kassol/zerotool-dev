---
// IpSubnetCalculatorTool — IPv4 subnet calculator, pure JS bit ops, zero deps
import Toggletip from '../Toggletip.astro';
const { lang = 'en' } = Astro.props;
// strings:start
const STRINGS = {
  en: {
    empty: "Enter an IPv4 address to view subnet details.",
    tips: {
      "input": "Enter four decimal numbers from 0 to 255, separated by dots, with no leading zeros. IPv4 only. Results update after a 250 ms pause. Ctrl/⌘+L clears the input and results while keeping the selected prefix.",
      "prefix": "Choose a prefix from 0 to 32. The default is /24. Changing this menu immediately updates the result and rewrites a /prefix already in the input; an address without a slash stays unchanged.",
      "results": "Any address in the subnet works: host bits are cleared for the network and CIDR fields. A /31 has two usable addresses and a /32 has one; neither has a broadcast. Other prefixes reserve the network and broadcast addresses.",
      "copy": "Copy all eight results as labelled plain-text lines, including the reason when there is no broadcast address. If copying fails, click Copy again to retry the same result."
    },
    inputLabel: 'IP Address / CIDR',
    placeholder: '192.168.1.0/24',
    prefixLabel: 'Prefix Length',
