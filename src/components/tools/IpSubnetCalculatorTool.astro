    errInvalidCidr: 'CIDR 前缀必须是 0–32 的整数（如 /24）。',
    errFormat: '请输入 IP 地址（如 192.168.1.0）并选择前缀，或使用 CIDR 表示法（如 192.168.1.0/24）。',
  },
  ja: {
    empty: "IPv4 アドレスを入力すると、サブネットの詳細が表示されます。",
    tips: {
      "input": "0〜255 の 10 進数を 4 つ、ドットで区切り、先頭に 0 を付けずに入力します。IPv4 のみ対応し、250 ミリ秒後に結果を更新します。Ctrl/⌘+L で入力と結果を消去し、選択中のプレフィックスを保ちます。",
      "prefix": "0〜32 から選択します。初期値は /24 です。メニューを変更すると直ちに再計算し、入力中の /プレフィックスも書き換えます。スラッシュがないアドレスの文字列は変わりません。",
      "results": "サブネット内のどのアドレスでも使えます。ネットワークと CIDR 欄ではホスト部のビットを消去します。/31 は 2 個、/32 は 1 個のアドレスを使え、どちらもブロードキャストはありません。他のプレフィックスではネットワークとブロードキャストのアドレスを差し引きます。",
      "copy": "8 項目をラベル付きのプレーンテキスト行としてコピーします。ブロードキャストがない場合は理由も含みます。失敗したら、同じ結果のコピーボタンで再試行できます。"
    },
    inputLabel: 'IPアドレス / CIDR',
    placeholder: '192.168.1.0/24',
    prefixLabel: 'プレフィックス長',
    resultsLabel: '結果',
    copy: 'コピー',
    copied: 'コピー済み！',
    copyFailed: 'コピー失敗',
    networkAddress: 'ネットワークアドレス',
    broadcastAddress: 'ブロードキャストアドレス',
    noBroadcast31: 'なし（/31 はポイントツーポイントリンク、RFC 3021）',
    noBroadcast32: 'なし（/32 は 1 個のアドレス）',
    subnetMask: 'サブネットマスク',
    wildcardMask: 'ワイルドカードマスク',
    firstHost: '最初の使用可能ホスト',
    lastHost: '最後の使用可能ホスト',
    usableHosts: '使用可能ホスト数',
    cidr: 'CIDR表記',
    errInvalidIp: '無効なIPv4アドレスです。0〜255 の数字 4 つをドットで区切り、先頭に 0 を付けずに入力してください（例: 10.0.0.1）。',
    errInvalidCidr: 'CIDRプレフィックスは 0〜32 の整数で指定してください（例: /24）。',
    errFormat: 'IPアドレス（例: 192.168.1.0）を入力してプレフィックスを選択するか、CIDR表記（例: 192.168.1.0/24）を使用してください。',
  },
  ko: {
    empty: "IPv4 주소를 입력하면 서브넷 세부 정보가 표시됩니다.",
    tips: {
      "input": "0–255 사이의 십진수 4개를 점으로 구분하고 앞에 0을 붙이지 마세요. IPv4만 지원하며, 입력을 250밀리초 멈추면 결과를 갱신합니다. Ctrl/⌘+L로 입력과 결과를 지우고 선택한 프리픽스는 유지합니다.",
      "prefix": "0–32 사이에서 선택하며 기본값은 /24입니다. 메뉴를 바꾸면 즉시 다시 계산하고 입력에 있는 /프리픽스를 변경합니다. 슬래시가 없는 주소 문자열은 그대로 유지합니다.",
      "results": "서브넷에 속하는 어떤 주소든 입력할 수 있습니다. 네트워크와 CIDR 필드에서는 호스트 비트를 지웁니다. /31은 주소 2개, /32는 1개를 쓸 수 있고 둘 다 브로드캐스트가 없습니다. 다른 프리픽스에서는 네트워크와 브로드캐스트 주소를 뺍니다.",
      "copy": "8개 결과를 라벨이 있는 일반 텍스트 줄로 복사합니다. 브로드캐스트가 없으면 그 이유도 포함합니다. 복사에 실패하면 같은 결과의 복사 버튼으로 다시 시도하세요."
    },
    inputLabel: 'IP 주소 / CIDR',
    placeholder: '192.168.1.0/24',
    prefixLabel: '프리픽스 길이',
    resultsLabel: '결과',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사 실패',
    networkAddress: '네트워크 주소',
    broadcastAddress: '브로드캐스트 주소',
    noBroadcast31: '없음 (/31 점대점 링크, RFC 3021)',
    noBroadcast32: '없음 (/32는 주소 하나)',
    subnetMask: '서브넷 마스크',
    wildcardMask: '와일드카드 마스크',
    firstHost: '첫 번째 사용 가능한 호스트',
    lastHost: '마지막 사용 가능한 호스트',
    usableHosts: '사용 가능한 호스트 수',
    cidr: 'CIDR 표기법',
    errInvalidIp: '유효하지 않은 IPv4 주소입니다. 0–255 숫자 4개를 점으로 구분하고 앞에 0을 붙이지 마세요(예: 10.0.0.1).',
    errInvalidCidr: 'CIDR 프리픽스는 0–32 사이의 정수여야 합니다(예: /24).',
    errFormat: 'IP 주소(예: 192.168.1.0)를 입력하고 프리픽스를 선택하거나, CIDR 표기법(예: 192.168.1.0/24)을 사용하세요.',
  },
};
// strings:end
const T = STRINGS[lang] || STRINGS.en;
const TIPS = T.tips;
const CLIENT_T = { copy: T.copy, copied: T.copied, copyFailed: T.copyFailed, networkAddress: T.networkAddress, broadcastAddress: T.broadcastAddress, noBroadcast31: T.noBroadcast31, noBroadcast32: T.noBroadcast32, subnetMask: T.subnetMask, wildcardMask: T.wildcardMask, firstHost: T.firstHost, lastHost: T.lastHost, usableHosts: T.usableHosts, cidr: T.cidr, errInvalidIp: T.errInvalidIp, errInvalidCidr: T.errInvalidCidr };
---
<div class="isc-wrap">
  <div class="isc-inputs">
    <div class="isc-field isc-field--wide">
      <div class="isc-label-row">
        <label for="isc-input">{T.inputLabel}</label>
        <Toggletip id="isc-tip-input" lang={lang} about={T.inputLabel}>{TIPS.input}</Toggletip>
      </div>
      <input id="isc-input" class="tool-input" type="text" placeholder={T.placeholder} spellcheck="false" autocomplete="off" />
    </div>
    <div class="isc-field">
      <div class="isc-label-row">
        <label for="isc-prefix">{T.prefixLabel}</label>
        <Toggletip id="isc-tip-prefix" lang={lang} about={T.prefixLabel}>{TIPS.prefix}</Toggletip>
      </div>
      <select id="isc-prefix">
        {/* filled by JS */}
      </select>
    </div>
  </div>
  <div class="isc-status" aria-live="polite">
    <div id="isc-error" class="isc-error" hidden></div>
  </div>
  <section class="isc-result-section" aria-label={T.resultsLabel}>
    <div id="isc-results" class="isc-results" hidden>
      <div class="isc-results-header">
        <div class="isc-label-row">
          <h2 class="isc-results-label">{T.resultsLabel}</h2>
          <Toggletip id="isc-tip-results" lang={lang} about={T.resultsLabel}>{TIPS.results}</Toggletip>
        </div>
        <div class="isc-label-row">
          <button id="isc-copy" class="btn-copy">{T.copy}</button>
          <Toggletip id="isc-tip-copy" lang={lang} about={T.copy}>{TIPS.copy}</Toggletip>
        </div>
      </div>
      <div class="isc-table-scroll" tabindex="0" role="region" aria-label={T.resultsLabel}>
    <table class="isc-table">
      <tbody>
        <tr><th>{T.networkAddress}</th><td id="isc-network"></td></tr>
        <tr><th>{T.broadcastAddress}</th><td id="isc-broadcast"></td></tr>
        <tr><th>{T.subnetMask}</th><td id="isc-mask"></td></tr>
        <tr><th>{T.wildcardMask}</th><td id="isc-wildcard"></td></tr>
        <tr><th>{T.firstHost}</th><td id="isc-first"></td></tr>
        <tr><th>{T.lastHost}</th><td id="isc-last"></td></tr>
        <tr><th>{T.usableHosts}</th><td id="isc-hosts"></td></tr>
        <tr><th>{T.cidr}</th><td id="isc-cidr"></td></tr>
      </tbody>
    </table>
      </div>
    </div>
    <p id="isc-empty" class="isc-empty">{T.empty}</p>
  </section>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var inputEl    = document.getElementById('isc-input');
      var prefixEl   = document.getElementById('isc-prefix');
      var errorEl    = document.getElementById('isc-error');
      var resultsEl  = document.getElementById('isc-results');
      var copyBtn    = document.getElementById('isc-copy');

      var cellNetwork   = document.getElementById('isc-network');
      var cellBroadcast = document.getElementById('isc-broadcast');
      var cellMask      = document.getElementById('isc-mask');
      var cellWildcard  = document.getElementById('isc-wildcard');
      var cellFirst     = document.getElementById('isc-first');
      var cellLast      = document.getElementById('isc-last');
      var cellHosts     = document.getElementById('isc-hosts');
      var cellCidr      = document.getElementById('isc-cidr');

      // Build prefix dropdown
      for (var i = 0; i <= 32; i++) {
        var opt = document.createElement('option');
        opt.value = String(i);
        opt.textContent = '/' + i;
        if (i === 24) opt.selected = true;
        prefixEl.appendChild(opt);
      }

      /* ── engine:start ── */
      // ---- Pure JS IPv4 bit ops ----
      // Dotted-decimal as inet_pton reads it (glibc inet_pton4): four decimal parts 0–255,
      // digits only, no leading zeros. Anything else (10.0.0.01, 10.0.0.1x, hex, octal,
      // fewer parts) is not an address.
      var OCTET = '(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])';
      var IPV4_RE = new RegExp('^' + OCTET + '\\.' + OCTET + '\\.' + OCTET + '\\.' + OCTET + '$');
      var PREFIX_RE = /^(3[0-2]|[12][0-9]|[0-9])$/;

      function ipToInt(ip) {
        var m = IPV4_RE.exec(ip);
        if (!m) return null;
        return ((+m[1] * 16777216) + (+m[2] << 16) + (+m[3] << 8) + +m[4]) >>> 0;
      }

      // "a.b.c.d/p" or "a.b.c.d" with the dropdown prefix → { ip, prefix } or
      // { error: 'ip' | 'cidr' }. The prefix is an integer 0–32 with no leading zero.
      function parseInput(raw, dropdownPrefix) {
        var slashIdx = raw.indexOf('/');
        var ipStr = raw;
        var prefix = dropdownPrefix;
        if (slashIdx !== -1) {
          ipStr = raw.slice(0, slashIdx).trim();
          var prefixStr = raw.slice(slashIdx + 1).trim();
          if (!PREFIX_RE.test(prefixStr)) return { error: 'cidr' };
          prefix = +prefixStr;
        }
        if (ipToInt(ipStr) === null) return { error: 'ip' };
        return { ip: ipStr, prefix: prefix };
      }

      function intToIp(n) {
        return [
          (n >>> 24) & 0xff,
          (n >>> 16) & 0xff,
          (n >>> 8) & 0xff,
          n & 0xff,
        ].join('.');
      }

      function prefixToMask(prefix) {
        if (prefix === 0) return 0;
        return (0xffffffff << (32 - prefix)) >>> 0;
      }

      function calculate(ipStr, prefix) {
        var ipInt = ipToInt(ipStr);
        if (ipInt === null) return null;

        var mask = prefixToMask(prefix);
        var network = (ipInt & mask) >>> 0;
        var broadcast = (network | (~mask >>> 0)) >>> 0;
        var wildcard = (~mask) >>> 0;

        var first, last, usable;
        if (prefix >= 31) {
          // /31 point-to-point, /32 host route
          first = network;
          last = broadcast;
          usable = prefix === 32 ? 1 : 2;
        } else {
          first = (network + 1) >>> 0;
          last = (broadcast - 1) >>> 0;
          usable = broadcast - network - 1;
        }

        return {
          network: intToIp(network),
          // RFC 3021: a /31 has two host addresses and no broadcast; a /32 is one address.
          broadcast: prefix >= 31 ? null : intToIp(broadcast),
          mask: intToIp(mask),
          wildcard: intToIp(wildcard),
          first: intToIp(first),
          last: intToIp(last),
          usable: usable.toLocaleString(),
          cidr: intToIp(network) + '/' + prefix,
        };
      }
      /* ── engine:end ── */

      function showError(msg) {
        errorEl.textContent = msg;
        errorEl.hidden = false;
        resultsEl.hidden = true;
      }

      function clearError() {
        errorEl.hidden = true;
        errorEl.textContent = '';
      }

      var copyRevision = 0;
      var copyRequest = 0;
      var copyTimer;
      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
      }

      function render() {
        invalidateCopy();
        var raw = inputEl.value.trim();
        if (!raw) { clearError(); resultsEl.hidden = true; return; }

        var parsed = parseInput(raw, parseInt(prefixEl.value, 10));
        if (parsed.error === 'cidr') { showError(t.errInvalidCidr); return; }
        if (parsed.error) { showError(t.errInvalidIp); return; }
        // Sync dropdown
        prefixEl.value = String(parsed.prefix);

        var result = calculate(parsed.ip, parsed.prefix);
        if (!result) { showError(t.errInvalidIp); return; }

        clearError();
        cellNetwork.textContent   = result.network;
        cellBroadcast.textContent = result.broadcast !== null ? result.broadcast
          : (parsed.prefix === 31 ? t.noBroadcast31 : t.noBroadcast32);
        cellMask.textContent      = result.mask;
        cellWildcard.textContent  = result.wildcard;
        cellFirst.textContent     = result.first;
        cellLast.textContent      = result.last;
        cellHosts.textContent     = result.usable;
        cellCidr.textContent      = result.cidr;
        resultsEl.hidden = false;

        window.trackTool && window.trackTool('ip_subnet_calculator', 'calculate');
      }

      var _debounce;
      inputEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_debounce);
        _debounce = setTimeout(render, 250);
      });
      // A prefix typed after the slash wins in render(), so a dropdown change rewrites it
      prefixEl.addEventListener('change', function () {
        var slashIdx = inputEl.value.indexOf('/');
        if (slashIdx !== -1) inputEl.value = inputEl.value.slice(0, slashIdx) + '/' + prefixEl.value;
        render();
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var scope = document.querySelector('.isc-wrap');
        if (!scope || !scope.contains(document.activeElement)) return;
        e.preventDefault();
        inputEl.focus();
        clearTimeout(_debounce);
        inputEl.value = '';
        render();
      });

      copyBtn.addEventListener('click', function () {
        if (resultsEl.hidden) return;
        var revision = copyRevision;
        var request = ++copyRequest;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        function current() { return revision === copyRevision && request === copyRequest && !resultsEl.hidden; }
        function failed() { if (current()) copyBtn.textContent = t.copyFailed; }
        var rows = [
          t.networkAddress + ': ' + cellNetwork.textContent,
          t.broadcastAddress + ': ' + cellBroadcast.textContent,
          t.subnetMask + ': ' + cellMask.textContent,
          t.wildcardMask + ': ' + cellWildcard.textContent,
          t.firstHost + ': ' + cellFirst.textContent,
          t.lastHost + ': ' + cellLast.textContent,
          t.usableHosts + ': ' + cellHosts.textContent,
          t.cidr + ': ' + cellCidr.textContent,
        ];
        try {
          Promise.resolve(navigator.clipboard.writeText(rows.join('\n'))).then(function () {
            if (!current()) return;
            copyBtn.textContent = t.copied;
            copyTimer = setTimeout(function () { if (current()) copyBtn.textContent = t.copy; }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });

      // Boot with default
      inputEl.value = '192.168.1.0/24';
      render();
    })();
  </script>
</div>

<style>
  .isc-wrap { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; }
  .isc-inputs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(9rem, auto); gap: 0.75rem; flex: none; }
  .isc-field { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .isc-label-row { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .isc-field label { font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); }
  .isc-field input, .isc-field select {
    min-width: 0; width: 100%; font-size: 0.9rem; padding: 0.55rem 0.75rem;
    border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg-secondary); color: var(--color-text);
  }
  .isc-field input:focus, .isc-field select:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }
  .isc-status { flex: none; height: 2.8em; overflow: auto; font-size: 0.85rem; line-height: 1.4; }
  .isc-error { padding: 0.35rem 0.75rem; color: #b45309; background: #fef3c7; border: 1px solid #fcd34d; border-radius: var(--radius-sm); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .isc-error { background: #1c1a0e; color: #fbbf24; border-color: #78350f; }
  }
  :global([data-theme="dark"]) .isc-error { background: #1c1a0e; color: #fbbf24; border-color: #78350f; }
  .isc-result-section { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0; min-height: 0; }
  .isc-results { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0; min-height: 0; border: 1px solid var(--color-border); border-radius: var(--radius-sm); overflow: hidden; background: var(--color-bg-secondary); }
