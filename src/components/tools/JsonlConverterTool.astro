  .jlc-file { display: none; }
  .jlc-stats { display: grid; flex: none; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.65rem; }
  .jlc-stat { display: flex; align-items: baseline; gap: 0.4rem; min-width: 0; }
  .jlc-stat-value { color: var(--color-primary); font-family: var(--font-mono); font-size: 1rem; font-weight: 700; }
  .jlc-stat-label { color: var(--color-text-muted); font-size: 0.78rem; }
  .jlc-issues { flex: none; min-width: 0; border-radius: var(--radius-md); background: var(--color-bg-secondary); box-shadow: inset 0 0 0 1px var(--color-border-soft); }
  .jlc-issues-head { display: flex; align-items: center; justify-content: space-between; gap: 0.65rem; padding: 0.25rem 0.8rem; color: var(--color-text-secondary); font-size: 0.82rem; font-weight: 700; }
  .jlc-issues-list { display: flex; flex-direction: column; height: 4.5rem; overflow: auto; overscroll-behavior: contain; }
  .jlc-issues-list:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -2px; }
  .jlc-issues-list :global(.jlc-issue-empty), .jlc-issues-list :global(.jlc-issue-row) { flex: none; padding: 0.45rem 0.8rem; color: var(--color-text-secondary); font-size: 0.85rem; }
  .jlc-issues-list :global(.jlc-issue-row) { display: grid; grid-template-columns: minmax(72px, 0.28fr) minmax(0, 0.7fr) minmax(0, 1fr); gap: 0.65rem; border-top: 1px solid var(--color-border-soft); }
  .jlc-issues-list :global(.jlc-issue-line) { color: var(--color-primary); font-family: var(--font-mono); font-weight: 700; }
  .jlc-issues-list :global(.jlc-issue-message) { color: var(--color-danger); overflow-wrap: anywhere; }
  .jlc-issues-list :global(.jlc-issue-preview) { color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.78rem; overflow-wrap: anywhere; }
  @media (max-width: 860px) {
    #jlc-status { height: 3.25rem; }
    .jlc-box { height: 180px; min-height: 180px; }
    .jlc-issues-list :global(.jlc-issue-row) { grid-template-columns: 1fr; gap: 0.25rem; }
  }
  @media (max-width: 640px) {
    .jlc-panel-head { min-height: 44px; }
    .jlc-actions button, .jlc-label-actions button, .jlc-check, .jlc-options summary { min-height: 44px; }
    .jlc-box { height: 120px; min-height: 120px; }
    .jlc-stats { gap: 0.35rem; }
    .jlc-stat { flex-direction: column; gap: 0.1rem; }
  }
</style>
