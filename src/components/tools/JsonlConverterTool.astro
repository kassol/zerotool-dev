---

<div class="jlc-wrap">
  <div class="jlc-actions">
    <div class="jlc-control"><button id="jlc-to-json" class="btn-primary" type="button">{T.jsonlToJson}</button> <Toggletip id="jlc-tip-to-json" lang={lang} about={T.jsonlToJson}>{TIPS.toJson}</Toggletip></div>
    <div class="jlc-control"><button id="jlc-to-jsonl" class="btn-primary" type="button">{T.jsonToJsonl}</button> <Toggletip id="jlc-tip-to-jsonl" lang={lang} about={T.jsonToJsonl}>{TIPS.toJsonl}</Toggletip></div>
    <div class="jlc-control"><button id="jlc-load-sample" class="btn-secondary" type="button">{T.sample}</button> <Toggletip id="jlc-tip-load-sample" lang={lang} about={T.sample}>{TIPS.sample}</Toggletip></div>
    <div class="jlc-control"><button id="jlc-clear" class="btn-ghost" type="button">{T.clear}</button> <Toggletip id="jlc-tip-clear" lang={lang} about={T.clear}>{TIPS.clear}</Toggletip></div>
    <details class="jlc-options">
      <summary class="btn-ghost">{T.options}</summary>
      <div class="jlc-option-fields">
        <div class="jlc-control"><label class="jlc-check"><input id="jlc-ignore-empty" type="checkbox" checked /><span>{T.ignoreEmpty}</span></label> <Toggletip id="jlc-tip-ignore-empty" lang={lang} about={T.ignoreEmpty}>{TIPS.ignoreEmpty}</Toggletip></div>
        <div class="jlc-control"><label class="jlc-check"><input id="jlc-valid-only" type="checkbox" /><span>{T.validOnly}</span></label> <Toggletip id="jlc-tip-valid-only" lang={lang} about={T.validOnly}>{TIPS.validOnly}</Toggletip></div>
        <div class="jlc-control"><label class="jlc-check"><input id="jlc-pretty-json" type="checkbox" checked /><span>{T.prettyJson}</span></label> <Toggletip id="jlc-tip-pretty-json" lang={lang} about={T.prettyJson}>{TIPS.pretty}</Toggletip></div>
        <div class="jlc-control"><button id="jlc-download-json" class="btn-secondary" type="button">{T.downloadJson}</button></div>
        <div class="jlc-control"><button id="jlc-download-jsonl" class="btn-secondary" type="button">{T.downloadJsonl}</button></div>
      </div>
    </details>
  </div>
  <div id="jlc-status" class="tool-status none" aria-live="polite"></div>
  <div class="jlc-panels zt-io">
    <div class="jlc-panel zt-io-pane">
      <div class="jlc-panel-head">
        <div class="jlc-control"><label for="jlc-jsonl">JSONL / NDJSON</label> <Toggletip id="jlc-tip-jsonl" lang={lang} about={"JSONL / NDJSON"}>{TIPS.jsonl}</Toggletip></div>
        <div class="jlc-label-actions"><button id="jlc-open-jsonl" class="btn-copy" type="button">{T.openFile}</button><button id="jlc-copy-jsonl" class="btn-copy" type="button">{T.copy}</button> <Toggletip id="jlc-tip-copy-jsonl" lang={lang} about={T.copy}>{TIPS.copyJsonl}</Toggletip></div>
      </div>
      <textarea id="jlc-jsonl" class="tool-textarea jlc-box zt-io-fill" placeholder="{&quot;id&quot;:1,&quot;event&quot;:&quot;signup&quot;}&#10;{&quot;id&quot;:2,&quot;event&quot;:&quot;purchase&quot;}" spellcheck="false"></textarea>
    </div>
    <div class="jlc-panel zt-io-pane">
      <div class="jlc-panel-head">
        <div class="jlc-control"><label for="jlc-json">{T.jsonArray}</label> <Toggletip id="jlc-tip-json" lang={lang} about={T.jsonArray}>{TIPS.json}</Toggletip></div>
        <div class="jlc-label-actions"><button id="jlc-open-json" class="btn-copy" type="button">{T.openFile}</button><button id="jlc-copy-json" class="btn-copy" type="button">{T.copy}</button> <Toggletip id="jlc-tip-copy-json" lang={lang} about={T.copy}>{TIPS.copyJson}</Toggletip></div>
      </div>
      <textarea id="jlc-json" class="tool-textarea jlc-box zt-io-fill" placeholder="[{&quot;id&quot;:1,&quot;event&quot;:&quot;signup&quot;},{&quot;id&quot;:2,&quot;event&quot;:&quot;purchase&quot;}]" spellcheck="false"></textarea>
    </div>
  </div>
  <input id="jlc-file" class="jlc-file" type="file" accept=".jsonl,.ndjson,.json,.txt,application/json,text/plain" />
  <div class="jlc-stats" aria-live="polite">
    <div class="jlc-stat"><span id="jlc-total-lines" class="jlc-stat-value">0</span><span class="jlc-stat-label">{T.lines}</span></div>
    <div class="jlc-stat"><span id="jlc-valid-lines" class="jlc-stat-value">0</span><span class="jlc-stat-label">{T.valid}</span></div>
    <div class="jlc-stat"><span id="jlc-error-lines" class="jlc-stat-value">0</span><span class="jlc-stat-label">{T.errors}</span></div>
    <div class="jlc-stat"><span id="jlc-empty-lines" class="jlc-stat-value">0</span><span class="jlc-stat-label">{T.empty}</span></div>
  </div>
  <div class="jlc-issues">
    <div class="jlc-issues-head"><div class="jlc-control"><span>{T.lineIssues}</span> <Toggletip id="jlc-tip-issues" lang={lang} about={T.lineIssues}>{TIPS.issues}</Toggletip></div><span id="jlc-issues-count">0</span></div>
    <div id="jlc-issues-list" class="jlc-issues-list" role="region" tabindex="0" aria-label={T.lineIssues} aria-live="polite"></div>
  </div>
</div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var jsonlEl = document.getElementById('jlc-jsonl');
      var jsonEl = document.getElementById('jlc-json');
      var fileEl = document.getElementById('jlc-file');
      var statusEl = document.getElementById('jlc-status');
      var issuesListEl = document.getElementById('jlc-issues-list');
      var issuesCountEl = document.getElementById('jlc-issues-count');
      var ignoreEmptyEl = document.getElementById('jlc-ignore-empty');
      var validOnlyEl = document.getElementById('jlc-valid-only');
      var prettyJsonEl = document.getElementById('jlc-pretty-json');
      var totalLinesEl = document.getElementById('jlc-total-lines');
      var validLinesEl = document.getElementById('jlc-valid-lines');
      var errorLinesEl = document.getElementById('jlc-error-lines');
      var emptyLinesEl = document.getElementById('jlc-empty-lines');
      var copyJsonlBtn = document.getElementById('jlc-copy-jsonl');
      var copyJsonBtn = document.getElementById('jlc-copy-json');
      var downloadJsonBtn = document.getElementById('jlc-download-json');
      var downloadJsonlBtn = document.getElementById('jlc-download-jsonl');
      var pendingFileTarget = 'jsonl';
      var lastJsonOutput = '';
      var lastJsonlOutput = '';

      function msg(template, values) {
        return template.replace(/\{(\w+)\}/g, function (_, key) {
          if (key === 's') return values.n === 1 ? '' : 's';
          return values[key] === undefined ? '' : String(values[key]);
        });
      }

      var copyRevision = 0;
      var copyErrorOwner = null;
      var copyStates = [{ btn: copyJsonlBtn, request: 0, timer: null }, { btn: copyJsonBtn, request: 0, timer: null }];
      function invalidateCopies() {
        copyRevision++;
        copyStates.forEach(function (state) {
          clearTimeout(state.timer);
          state.timer = null;
          state.btn.textContent = t.copy;
        });
        copyErrorOwner = null;
      }

      function setStatus(message, type) {
        copyErrorOwner = null;
        statusEl.textContent = message;
        statusEl.className = 'tool-status ' + (type || 'none');
      }

      function clearStatus() {
        setStatus('', 'none');
      }

      function setInputError(el, hasError) {
        el.classList.toggle('jlc-input-error', !!hasError);
      }

      // JSON.parse validates syntax only. Number values are never used: retain their tokens.
      function parseLossless(text) {
        JSON.parse(text);
        var tokens = text.match(/"(?:\\[\s\S]|[^"\\])*"|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?|true|false|null|[{}\[\],:]/g);
        var stack = [];
        var root;
        function add(node) {
          var parent = stack[stack.length - 1];
          if (!parent) root = node;
          else if (parent.node.kind === 'array') parent.node.values.push(node);
          else parent.node.values[parent.key] = node;
        }
        tokens.forEach(function (token) {
          var frame = stack[stack.length - 1];
          if (token === '{' || token === '[') {
            var node = { kind: token === '[' ? 'array' : 'object', values: token === '[' ? [] : Object.create(null) };
            add(node);
            stack.push({ node: node, key: null, needsKey: token === '{' });
          } else if (token === '}' || token === ']') stack.pop();
          else if (token === ',') { if (frame.node.kind === 'object') frame.needsKey = true; }
          else if (token !== ':') {
            if (frame && frame.needsKey) {
              frame.key = JSON.parse(token);
              frame.needsKey = false;
            } else {
              add({ kind: 'scalar', raw: token[0] === '"' ? JSON.stringify(JSON.parse(token)) : token });
            }
          }
        });
        return root;
      }

      function stringifyLossless(node, pretty) {
        var chunks = [];
        var work = [{ node: node, depth: 0 }];
        while (work.length) {
          var item = work.pop();
          if (typeof item === 'string') { chunks.push(item); continue; }
          var current = item.node;
          if (current.kind === 'scalar') { chunks.push(current.raw); continue; }
          var array = current.kind === 'array';
          var keys = array ? current.values.map(function (_, i) { return i; }) : Object.keys(current.values);
          var open = array ? '[' : '{';
          var close = array ? ']' : '}';
          if (!keys.length) { chunks.push(open + close); continue; }
          chunks.push(open);
          work.push((pretty ? '\n' + '  '.repeat(item.depth) : '') + close);
          for (var i = keys.length - 1; i >= 0; i--) {
            var key = keys[i];
            if (i < keys.length - 1) work.push(',');
            work.push({ node: current.values[key], depth: item.depth + 1 });
            work.push((pretty ? '\n' + '  '.repeat(item.depth + 1) : '') +
              (array ? '' : JSON.stringify(key) + (pretty ? ': ' : ':')));
          }
        }
        return chunks.join('');
      }

      function invalidateOutput(target) {
        if (target === 'json') jsonEl.value = '';
        if (target === 'jsonl') {
          // The counters and line issues describe the JSONL text that was just removed.
          jsonlEl.value = '';
          updateStats({ total: 0, valid: 0, empty: 0, errors: [] });
          renderIssues([]);
          setInputError(jsonlEl, false);
        }
        lastJsonOutput = '';
        lastJsonlOutput = '';
        copyJsonBtn.disabled = copyJsonlBtn.disabled = true;
        downloadJsonBtn.disabled = downloadJsonlBtn.disabled = true;
      }

      function enableOutput() {
        copyJsonBtn.disabled = downloadJsonBtn.disabled = !lastJsonOutput;
        copyJsonlBtn.disabled = downloadJsonlBtn.disabled = !lastJsonlOutput;
      }

      /* ── json-reason:start ── */
      // Why a JSONL line or the JSON panel is not JSON, in the page language, without the browser's
      // English message. lineCol and jsonSyntaxError are copied verbatim from json-formatter-engine.js
      // (the test compares the source); jsonSyntaxError runs only after JSON.parse has failed. The parsed
      // text is trimmed, so the leading whitespace is added back to count from the line or panel start.
      function lineCol(text, offset) {
        var line = 1, last = -1;
        for (var i = text.indexOf('\n'); i !== -1 && i < offset; i = text.indexOf('\n', i + 1)) { line++; last = i; }
        return { line: line, col: offset - last };
      }
      function jsonSyntaxError(text) {
        var i = 0, n = text.length;
        var SMART = '\u201c\u201d\u2018\u2019\u300c\u300d';
        var WIDE = '\u3000\uff1a\uff0c\uff5b\uff5d\uff3b\uff3d\uff02';
        function fail(code, at, ch) { throw { jsonErr: true, code: code, offset: at === undefined ? i : at, ch: ch }; }
        function special(c) {
          if (SMART.indexOf(c) >= 0) fail('smartQuote', i, c);
          if (WIDE.indexOf(c) >= 0) fail('fullWidth', i, c);
        }
        function ws() {
          while (i < n) {
            var c = text[i];
            if (c === ' ' || c === '\t' || c === '\n' || c === '\r') { i++; continue; }
            if (c === '/' && (text[i + 1] === '/' || text[i + 1] === '*')) fail('comment');
            if (c === '#') fail('comment');
            break;
          }
        }
        var NUM = /-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?/y;
        var WORD = /[A-Za-z_$][\w$]*/y;
        function str() {
          var s = i; i++;
          while (i < n) {
            var c = text.charCodeAt(i);
            if (c === 34) { i++; return; }
            if (c === 92) {
              var e = text[i + 1];
              if (e !== undefined && '"\\/bfnrt'.indexOf(e) >= 0) { i += 2; continue; }
              if (e === 'u' && /^[0-9a-fA-F]{4}$/.test(text.substr(i + 2, 4))) { i += 6; continue; }
              fail('badEscape');
            }
            if (c < 0x20) fail('controlChar');
            i++;
          }
          fail('unterminatedString', s);
        }
        function num() {
          NUM.lastIndex = i;
          var m = NUM.exec(text);
          if (!m || m[0] === '-' || m[0] === '') fail('badNumber');
          i += m[0].length;
          if (i < n && /[0-9.eE]/.test(text[i])) fail('badNumber');
        }
        function startsValue(c) { return c === '{' || c === '[' || c === '"' || c === '-' || (c >= '0' && c <= '9') || c === 't' || c === 'f' || c === 'n'; }
        function value(depth) {
          if (depth > 3000) fail('unexpectedChar');
          ws();
          if (i >= n) fail('unexpectedEnd');
          var c = text[i];
          if (c === '{') return obj(depth);
          if (c === '[') return arr(depth);
          if (c === '"') return str();
          if (c === "'") fail('singleQuote');
          special(c);
          if (c === '-' || (c >= '0' && c <= '9')) return num();
          if (c === '+' || c === '.') fail('badNumber');
          WORD.lastIndex = i;
          var m = WORD.exec(text);
          if (m) {
            if (m[0] === 'true' || m[0] === 'false' || m[0] === 'null') { i += m[0].length; return; }
            if (m[0] === 'NaN' || m[0] === 'Infinity') fail('badNumber');
            fail('badLiteral');
          }
          fail('unexpectedChar', i, c);
        }
        function obj(depth) {
          i++; ws();
          if (text[i] === '}') { i++; return; }
          for (;;) {
            ws();
            if (i >= n) fail('unexpectedEnd');
            var c = text[i];
            if (c === "'") fail('singleQuote');
            special(c);
            if (c !== '"') { if (/[A-Za-z_$0-9]/.test(c)) fail('unquotedKey'); fail('unexpectedChar', i, c); }
            str(); ws();
            if (i >= n) fail('unexpectedEnd');
            if (text[i] !== ':') { special(text[i]); fail('missingColon'); }
            i++;
            value(depth + 1); ws();
            if (i >= n) fail('unexpectedEnd');
            c = text[i];
            if (c === ',') { var comma = i; i++; ws(); if (text[i] === '}') fail('trailingComma', comma); continue; }
            if (c === '}') { i++; return; }
            special(c);
            if (c === '"' || /[A-Za-z_$]/.test(c)) fail('missingComma');
            fail('unexpectedChar', i, c);
          }
        }
        function arr(depth) {
          i++; ws();
          if (text[i] === ']') { i++; return; }
          for (;;) {
            value(depth + 1); ws();
            if (i >= n) fail('unexpectedEnd');
            var c = text[i];
            if (c === ',') { var comma = i; i++; ws(); if (text[i] === ']') fail('trailingComma', comma); continue; }
            if (c === ']') { i++; return; }
            special(c);
            if (startsValue(c)) fail('missingComma');
            fail('unexpectedChar', i, c);
          }
        }
        try {
          ws();
          if (i >= n) return { code: 'empty', offset: 0 };
          value(0);
          ws();
          if (i < n) fail('extraData');
          return null;
        } catch (e) {
          if (e && e.jsonErr) return { code: e.code, offset: e.offset, ch: e.ch };
          throw e;
        }
      }
      function jsonReason(e) {
        return String(t.jsonParse[e.code] || t.jsonParse.unexpectedChar || e.code).replace('{ch}', function () { return e.ch == null ? '' : e.ch; });
      }
      function jsonErrorText(value) {
        var e = jsonSyntaxError(value.trim());
        if (!e) return t.errJson;
        var at = lineCol(value, value.length - value.trimStart().length + e.offset);
        return msg(t.errJsonAt, { line: at.line, col: at.col, reason: jsonReason(e) });
      }
      function lineIssueText(line) {
        var e = jsonSyntaxError(line.trim());
        if (!e) return t.errJson;
        var at = lineCol(line, line.length - line.trimStart().length + e.offset);
        return msg(t.issueAt, { col: at.col, reason: jsonReason(e) });
      }
      /* ── json-reason:end ── */

      function parseJsonl(text, ignoreEmpty) {
        var lines = text.length ? text.split('\n') : [];
        var values = [];
        var errors = [];
        var emptyCount = 0;

        lines.forEach(function (line, index) {
          var lineNumber = index + 1;
          var trimmed = line.trim();
          if (trimmed === '') {
            emptyCount++;
            if (!ignoreEmpty) {
              errors.push({ line: lineNumber, message: t.emptyLine, preview: '' });
            }
            return;
          }
          try {
            values.push({ line: lineNumber, value: parseLossless(trimmed), raw: trimmed });
          } catch (e) {
            errors.push({
              line: lineNumber,
              message: e && e.name === 'SyntaxError' ? lineIssueText(line) : e.message,
              preview: trimmed.slice(0, 120)
            });
          }
        });

        return {
          total: lines.length,
          valid: values.length,
          empty: emptyCount,
          values: values,
          errors: errors
        };
      }

      function updateStats(result) {
        totalLinesEl.textContent = String(result.total);
        validLinesEl.textContent = String(result.valid);
        errorLinesEl.textContent = String(result.errors.length);
        emptyLinesEl.textContent = String(result.empty);
      }

      function renderIssues(errors) {
        issuesCountEl.textContent = String(errors.length);
        issuesListEl.textContent = '';
        if (errors.length === 0) {
          var empty = document.createElement('div');
          empty.className = 'jlc-issue-empty';
          empty.textContent = t.noIssues;
          issuesListEl.appendChild(empty);
          return;
        }

        errors.slice(0, 40).forEach(function (error) {
          var row = document.createElement('div');
          row.className = 'jlc-issue-row';

          var line = document.createElement('span');
          line.className = 'jlc-issue-line';
          line.textContent = t.line + ' ' + error.line;

          var message = document.createElement('span');
          message.className = 'jlc-issue-message';
          message.textContent = error.message;

          var preview = document.createElement('span');
          preview.className = 'jlc-issue-preview';
          preview.textContent = error.preview ? t.preview + ': ' + error.preview : '';

          row.appendChild(line);
          row.appendChild(message);
          row.appendChild(preview);
          issuesListEl.appendChild(row);
        });
      }

      function validateJsonl() {
        cancelPending();
        var result = parseJsonl(jsonlEl.value, ignoreEmptyEl.checked);
        updateStats(result);
        renderIssues(result.errors);
        setInputError(jsonlEl, result.errors.length > 0);
        if (!jsonlEl.value.trim()) {
          clearStatus();
        } else if (result.errors.length > 0) {
          invalidateOutput('json');
          setStatus(t.strictErrors, 'error');
        } else {
          setStatus(t.validJsonl, 'success');
        }
        return result;
      }

      function compactJsonlFromValues(values) {
        return values.map(function (record) {
          return stringifyLossless(record.value, false);
        }).join('\n');
      }

      function convertJsonlToJson() {
        cancelPending();
        invalidateOutput('json');
        var result = parseJsonl(jsonlEl.value, ignoreEmptyEl.checked);
        updateStats(result);
        renderIssues(result.errors);
        setInputError(jsonlEl, result.errors.length > 0);

        if (!jsonlEl.value.trim()) {
          setStatus(t.emptyInput, 'none');
          return;
        }
        if (result.errors.length > 0 && !validOnlyEl.checked) {
          setStatus(t.strictErrors, 'error');
          return;
        }

        var values = result.values.map(function (record) { return record.value; });
        var json = stringifyLossless({ kind: 'array', values: values }, prettyJsonEl.checked);
        var jsonl = compactJsonlFromValues(result.values);
        jsonEl.value = json;
        lastJsonOutput = json;
        lastJsonlOutput = jsonl;
        enableOutput();
        setStatus(msg(t.convertedToJson, { n: values.length }), result.errors.length > 0 ? 'info' : 'success');
        window.trackTool && window.trackTool('jsonl-converter', 'jsonl_to_json');
      }

      function convertJsonToJsonl() {
        cancelPending();
        invalidateOutput('jsonl');
        var raw = jsonEl.value.trim();
        if (!raw) {
          setInputError(jsonEl, false);
          setStatus(t.emptyInput, 'none');
          return;
        }

        try {
          var parsed = parseLossless(raw);
          if (parsed.kind !== 'array') {
            throw new Error(t.jsonArrayRequired);
          }
          var lines = parsed.values.map(function (item) {
            return stringifyLossless(item, false);
          });
          var jsonl = lines.join('\n');
          jsonlEl.value = jsonl;
          lastJsonlOutput = jsonl;
          lastJsonOutput = stringifyLossless(parsed, prettyJsonEl.checked);
          enableOutput();
          setInputError(jsonEl, false);
          var result = parseJsonl(jsonl, true);
          updateStats(result);
          renderIssues(result.errors);
          setInputError(jsonlEl, false);
          setStatus(msg(t.convertedToJsonl, { n: parsed.values.length }), 'success');
          window.trackTool && window.trackTool('jsonl-converter', 'json_to_jsonl');
        } catch (e) {
          setInputError(jsonEl, true);
          setStatus(e && e.name === 'SyntaxError' ? jsonErrorText(jsonEl.value) : t.invalidJson + ': ' + e.message, 'error');
        }
      }

      function copyText(text, button) {
        if (!text || button.disabled) return;
        var state = copyStates[button === copyJsonlBtn ? 0 : 1];
        var revision = copyRevision;
        var request = ++state.request;
        clearTimeout(state.timer);
        state.timer = null;
        button.textContent = t.copy;
        function current() {
          return revision === copyRevision && request === state.request && !button.disabled &&
            text === (button === copyJsonlBtn ? lastJsonlOutput : lastJsonOutput);
        }
        function failed() {
          if (!current()) return;
          setStatus(t.copyFailed, 'error');
          copyErrorOwner = button;
        }
        function done() {
          if (!current()) return;
          if (copyErrorOwner === button && statusEl.textContent === t.copyFailed) clearStatus();
          button.textContent = t.copied;
          state.timer = setTimeout(function () { if (current()) button.textContent = t.copy; }, 1500);
        }
        try {
          if (!navigator.clipboard || !navigator.clipboard.writeText) { failed(); return; }
          navigator.clipboard.writeText(text).then(done, failed);
        } catch (e) { failed(); }
      }

      function downloadText(filename, type, text) {
        if (!text) {
          setStatus(t.emptyInput, 'none');
          return;
        }
        var blob = new Blob([text], { type: type });
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.href = url;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        link.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
        setStatus(t.downloadReady, 'success');
      }

      function openFile(target) {
        if (copyErrorOwner && statusEl.textContent === t.copyFailed) clearStatus();
        cancelPending();
        pendingFileTarget = target;
        fileEl.value = '';
        fileEl.click();
      }

      function loadSample() {
        jsonlEl.value = [
          '{"id":1,"event":"signup","user":"alice","plan":"free"}',
          '{"id":2,"event":"purchase","user":"bob","amount":29.99}',
          '{"id":3,"event":"cancel","user":"carol","reason":"duplicate"}'
        ].join('\n');
        convertJsonlToJson();
      }

      document.getElementById('jlc-to-json').addEventListener('click', convertJsonlToJson);
      document.getElementById('jlc-to-jsonl').addEventListener('click', convertJsonToJsonl);
      function clearAll() {
        cancelPending();
        jsonlEl.value = '';
        jsonEl.value = '';
        fileEl.value = '';
        invalidateOutput();
        clearTimeout(jsonlTimer);
        updateStats({ total: 0, valid: 0, empty: 0, errors: [] });
        renderIssues([]);
        setInputError(jsonlEl, false);
        setInputError(jsonEl, false);
        clearStatus();
        jsonlEl.focus();
      }
      document.getElementById('jlc-clear').addEventListener('click', clearAll);
      // ToolLayout's Ctrl/Cmd+L empties both panels without input events; drop the cached output too.
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && document.querySelector('.jlc-wrap').contains(document.activeElement)) {
          e.preventDefault();
          clearAll();
        }
      });
      document.getElementById('jlc-load-sample').addEventListener('click', loadSample);
      document.getElementById('jlc-open-jsonl').addEventListener('click', function () { openFile('jsonl'); });
      document.getElementById('jlc-open-json').addEventListener('click', function () { openFile('json'); });
      downloadJsonBtn.addEventListener('click', function () {
        if (!downloadJsonBtn.disabled) downloadText('jsonl-converted.json', 'application/json;charset=utf-8', lastJsonOutput);
      });
      downloadJsonlBtn.addEventListener('click', function () {
        if (!downloadJsonlBtn.disabled) downloadText('jsonl-converted.jsonl', 'application/x-ndjson;charset=utf-8', lastJsonlOutput);
      });
      copyJsonlBtn.addEventListener('click', function () {
        if (!copyJsonlBtn.disabled) copyText(lastJsonlOutput, copyJsonlBtn);
      });
      copyJsonBtn.addEventListener('click', function () {
        if (!copyJsonBtn.disabled) copyText(lastJsonOutput, copyJsonBtn);
      });

      fileEl.addEventListener('change', function () {
        var file = fileEl.files && fileEl.files[0];
        if (!file) return;
        cancelPending();
        var generation = fileGeneration;
        var target = pendingFileTarget;
        invalidateOutput(target === 'json' ? 'jsonl' : 'json');
        var reader = new FileReader();
        reader.onload = function () {
          if (generation !== fileGeneration) return;
          var text = String(reader.result || '');
          if (target === 'json') {
            jsonEl.value = text;
            convertJsonToJsonl();
          } else {
            jsonlEl.value = text;
            var result = validateJsonl();
            if (!result.errors.length && text.trim()) setStatus(msg(t.fileLoaded, { name: file.name }), 'success');
          }
        };
        reader.onerror = function () {
          if (generation !== fileGeneration) return;
          invalidateOutput(target === 'json' ? 'jsonl' : 'json');
          setStatus(t.fileReadError, 'error');
        };
        reader.readAsText(file);
      });

      var jsonlTimer = null;
      var fileGeneration = 0;
      function cancelPending() {
        invalidateCopies();
        clearTimeout(jsonlTimer);
        fileGeneration++;
      }
      jsonlEl.addEventListener('input', function () {
        cancelPending();
        invalidateOutput('json');
        clearTimeout(jsonlTimer);
        jsonlTimer = setTimeout(validateJsonl, 350);
      });

      jsonEl.addEventListener('input', function () {
        cancelPending();
        invalidateOutput('jsonl');
        if (!jsonEl.value.trim()) setInputError(jsonEl, false);
        clearStatus();
      });
      ignoreEmptyEl.addEventListener('change', function () { invalidateOutput('json'); validateJsonl(); });
      validOnlyEl.addEventListener('change', function () { invalidateOutput('json'); validateJsonl(); });
      prettyJsonEl.addEventListener('change', function () {
        if (jsonlEl.value.trim()) convertJsonlToJson();
      });

      // stopPropagation: ToolLayout's page-wide Ctrl/Cmd+Enter would also click the first primary
      // button (JSONL → JSON) and convert the fresh JSONL output back over the JSON input.
      jsonlEl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault(); e.stopPropagation();
          convertJsonlToJson();
        }
      });
      jsonEl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault(); e.stopPropagation();
          convertJsonToJsonl();
        }
      });

      invalidateOutput();
      renderIssues([]);
    })();
  </script>

