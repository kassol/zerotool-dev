  .jlc-check { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--color-text-secondary); font-size: 0.85rem; cursor: pointer; }
  #jlc-status { height: 2.6rem; min-height: 0; flex: none; overflow: auto; overflow-wrap: anywhere; line-height: 1.4; }
  .jlc-panels { min-height: 0; }
  .jlc-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; min-height: 32px; }
