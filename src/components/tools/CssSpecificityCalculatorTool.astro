---
// CssSpecificityCalculatorTool — pure client-side CSS specificity calculator
---
<div>
  <div class="csc-wrap">
    <div class="csc-field">
      <label for="csc-input" data-i18n="inputLabel">CSS Selector(s)</label>
      <input
        id="csc-input"
        type="text"
        data-i18n-ph="inputPlaceholder"
        placeholder="#nav .item:hover, h1.title"
        spellcheck="false"
        autocomplete="off"
      />
      <span class="csc-hint" data-i18n="hint">Comma-separate multiple selectors to compare</span>
    </div>

    <div id="csc-results" class="csc-results" aria-live="polite"></div>
  </div>

  <script is:inline>
    (function () {
      var STRINGS = {
        en: {
          inputLabel: 'CSS Selector(s)',
          inputPlaceholder: '#nav .item:hover, h1.title',
          hint: 'Comma-separate multiple selectors to compare',
          id: 'ID', cls: 'Class / Attr / Pseudo-class', elem: 'Element / Pseudo-element',
          specificity: 'Specificity', noInput: 'Enter a CSS selector above.',
          copyBtn: 'Copy', copied: 'Copied!', copyFailed: 'Copy failed',
          note: 'Compare left to right: the first column that differs decides. :where() counts 0; :is(), :not(), :has() count as their most specific argument.',
          invalid: 'Not a valid selector: {msg}'
        },
        zh: {
          inputLabel: 'CSS 选择器',
          inputPlaceholder: '#nav .item:hover, h1.title',
          hint: '用逗号分隔多个选择器以对比优先级',
          id: 'ID', cls: '类 / 属性 / 伪类', elem: '元素 / 伪元素',
          specificity: '优先级', noInput: '请在上方输入 CSS 选择器。',
          copyBtn: '复制', copied: '已复制!', copyFailed: '复制失败',
          note: '从左往右比较，第一个不同的列决定胜负。:where() 计 0；:is()、:not()、:has() 取参数中优先级最高的一项。',
          invalid: '不是有效的选择器：{msg}'
        },
        ja: {
          inputLabel: 'CSS セレクター',
          inputPlaceholder: '#nav .item:hover, h1.title',
          hint: 'カンマ区切りで複数のセレクターを比較',
          id: 'ID', cls: 'クラス / 属性 / 疑似クラス', elem: '要素 / 疑似要素',
          specificity: '詳細度', noInput: '上にCSSセレクターを入力してください。',
          copyBtn: 'コピー', copied: 'コピー済み!', copyFailed: 'コピー失敗',
          note: '左の列から比較し、最初に異なる列で決まります。:where() は 0、:is()・:not()・:has() は引数のうち最も詳細度が高いものを使います。',
          invalid: '有効なセレクターではありません：{msg}'
        },
        ko: {
          inputLabel: 'CSS 선택자',
          inputPlaceholder: '#nav .item:hover, h1.title',
          hint: '쉼표로 구분하여 여러 선택자 비교',
          id: 'ID', cls: '클래스 / 속성 / 가상 클래스', elem: '요소 / 가상 요소',
          specificity: '명시도', noInput: '위에 CSS 선택자를 입력하세요.',
          copyBtn: '복사', copied: '복사됨!', copyFailed: '복사 실패',
          note: '왼쪽 열부터 비교하며 처음 달라지는 열이 결정합니다. :where()는 0, :is()·:not()·:has()는 인수 중 명시도가 가장 높은 것을 씁니다.',
          invalid: '올바른 선택자가 아닙니다: {msg}'
        }
      };

      var pageLang = (document.documentElement.lang || 'en').slice(0, 2);
      var t = STRINGS[pageLang] || STRINGS.en;

      document.querySelectorAll('.csc-wrap [data-i18n]').forEach(function (el) {
        var key = el.getAttribute('data-i18n');
        if (t[key]) el.textContent = t[key];
      });
      document.querySelectorAll('.csc-wrap [data-i18n-ph]').forEach(function (el) {
        var key = el.getAttribute('data-i18n-ph');
        if (t[key]) el.placeholder = t[key];
      });

      var inputEl = document.getElementById('csc-input');
      var resultsEl = document.getElementById('csc-results');

      /* ── engine:start ── */
      /* Specificity per Selectors Level 4 §17: a = IDs, b = classes, attributes
         and pseudo-classes, c = type selectors and pseudo-elements; `*` and
         combinators count 0. :is() / :not() / :has() count as their most
         specific argument, :where() counts 0, :nth-child(An+B of S) /
         :nth-last-child() count one pseudo-class plus the most specific S.
         ::slotted(), :host() and :host-context() add their argument (CSS Scoping).
         `&` counts 0 here: its real value is that of the parent rule, which a
         lone selector does not show. */
      var LEGACY_PSEUDO_ELEMENTS = { before: 1, after: 1, 'first-line': 1, 'first-letter': 1 };
      var MAX_OF_ARGS = { is: 1, not: 1, has: 1, matches: 1, '-webkit-any': 1, '-moz-any': 1 };

      function cssError(msg, pos) {
        var e = new SyntaxError(msg + ' (position ' + (pos + 1) + ')');
        e.position = pos;
        return e;
      }

      /* Index just past a quoted string that starts at i. */
      function skipString(s, i) {
        var q = s[i];
        i++;
        while (i < s.length && s[i] !== q) {
          if (s[i] === '\\') i++;
          i++;
        }
        if (i >= s.length) throw cssError('Unclosed string', i - 1);
        return i + 1;
      }

      /* Index of the bracket that closes the one at i (`(` or `[`). */
      function matchClose(s, i) {
        var stack = [];
        for (var j = i; j < s.length; j++) {
          var ch = s[j];
          if (ch === '\\') { j++; continue; }
          if (ch === '"' || ch === "'") { j = skipString(s, j) - 1; continue; }
          if (ch === '(' || ch === '[') stack.push(ch === '(' ? ')' : ']');
          else if (ch === ')' || ch === ']') {
            if (stack.pop() !== ch) throw cssError('Unexpected "' + ch + '"', j);
            if (!stack.length) return j;
          }
        }
        throw cssError('Missing "' + (s[i] === '(' ? ')' : ']') + '"', i);
      }

      /* Split at commas that are not inside brackets or strings; each item
         keeps its start index so errors can point into the original text. */
      function splitRanges(text) {
        var parts = [], depth = 0, start = 0;
        function push(end) {
          var raw = text.slice(start, end);
          var lead = raw.length - raw.replace(/^\s+/, '').length;
          var trimmed = raw.trim();
          if (trimmed) parts.push({ text: trimmed, start: start + lead });
        }
        for (var i = 0; i < text.length; i++) {
          var ch = text[i];
          if (ch === '\\') { i++; continue; }
          if (ch === '"' || ch === "'") {
            var q = ch;
            i++;
            while (i < text.length && text[i] !== q) { if (text[i] === '\\') i++; i++; }
            continue;
          }
          if (ch === '(' || ch === '[') depth++;
          else if ((ch === ')' || ch === ']') && depth > 0) depth--;
          else if (ch === ',' && depth === 0) { push(i); start = i + 1; }
        }
        push(text.length);
        return parts;
      }
      function splitSelectorList(text) {
        return splitRanges(text).map(function (p) { return p.text; });
      }

      function isIdentChar(ch) {
        return /[A-Za-z0-9_-]/.test(ch) || ch.charCodeAt(0) >= 0x80;
      }
      /* Read a CSS identifier (with escapes) at i; return the index after it. */
      function readIdent(s, i) {
        var start = i;
        while (i < s.length) {
          if (s[i] === '\\') {
            if (i + 1 >= s.length) throw cssError('Escape at end of input', i);
            i++;
            if (/[0-9a-fA-F]/.test(s[i])) {
              var n = 0;
              while (n < 6 && i < s.length && /[0-9a-fA-F]/.test(s[i])) { i++; n++; }
              if (i < s.length && /\s/.test(s[i])) i++;
            } else {
              i++;
            }
          } else if (isIdentChar(s[i])) {
            i++;
          } else {
            break;
          }
        }
        if (i === start || s.slice(start, i) === '-') throw cssError('Expected a name', start);
        return i;
      }

      function maxSpec(list) {
        var best = { a: 0, b: 0, c: 0 };
        for (var i = 0; i < list.length; i++) {
          var x = list[i];
          if (x.a > best.a || (x.a === best.a && (x.b > best.b || (x.b === best.b && x.c > best.c)))) best = x;
        }
        return best;
      }
      function listSpec(text, offset) {
        var items = splitRanges(text);
        if (!items.length) throw cssError('Empty argument', offset);
        return maxSpec(items.map(function (item) { return complexSpec(item.text, offset + item.start); }));
      }

      function complexSpec(sel, offset) {
        offset = offset || 0;
        var a = 0, b = 0, c = 0;
        var s = sel;
        var i = 0;
        function add(x) { a += x.a; b += x.b; c += x.c; }
        try {
          while (i < s.length) {
            var ch = s[i];
            if (/\s/.test(ch) || ch === '>' || ch === '+' || ch === '~' || ch === '*' || ch === '&') { i++; continue; }
            if (ch === '|') { i += s[i + 1] === '|' ? 2 : 1; continue; }
            if (ch === '#') { i = readIdent(s, i + 1); a++; continue; }
            if (ch === '.') { i = readIdent(s, i + 1); b++; continue; }
            if (ch === '[') { i = matchClose(s, i) + 1; b++; continue; }
            if (ch === ':') {
              var pseudoElement = s[i + 1] === ':';
              var nameStart = i + (pseudoElement ? 2 : 1);
              var nameEnd = readIdent(s, nameStart);
              var name = s.slice(nameStart, nameEnd).toLowerCase();
              var arg = null, argStart = 0;
              i = nameEnd;
              if (s[i] === '(') {
                var close = matchClose(s, i);
                argStart = i + 1;
                arg = s.slice(argStart, close);
                i = close + 1;
              }
              if (pseudoElement || (arg === null && LEGACY_PSEUDO_ELEMENTS[name])) {
                c++;
                if (pseudoElement && name === 'slotted' && arg !== null) add(listSpec(arg, offset + argStart));
                continue;
              }
              if (arg === null) { b++; continue; }
              if (name === 'where') continue;
              if (MAX_OF_ARGS[name]) { add(listSpec(arg, offset + argStart)); continue; }
              b++;
              if (name === 'nth-child' || name === 'nth-last-child') {
                var of = /\sof\s/i.exec(arg);
                if (of) add(listSpec(arg.slice(of.index + of[0].length), offset + argStart + of.index + of[0].length));
              } else if (name === 'host' || name === 'host-context') {
                add(listSpec(arg, offset + argStart));
              }
              continue;
            }
            if (isIdentChar(ch) || ch === '\\') {
              i = readIdent(s, i);
              if (s[i] === '|' && s[i + 1] !== '|') { i++; continue; }
              c++;
              continue;
            }
            throw cssError('Unexpected "' + ch + '"', i);
          }
        } catch (e) {
          if (e && typeof e.position === 'number' && !e.shifted) {
            var shifted = cssError(e.message.replace(/ \(position \d+\)$/, ''), e.position + offset);
            shifted.shifted = true;
            throw shifted;
          }
          throw e;
        }
        return { a: a, b: b, c: c };
      }

      /* Specificity of one selector (no top-level commas). */
      function specificity(sel) {
        if (!sel.trim()) throw cssError('Empty selector', 0);
        return complexSpec(sel, 0);
      }
      /* ── engine:end ── */

      function escHtml(str) {
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      var copyRevision = 0;
      function invalidateCopies() {
        copyRevision++;
        resultsEl.querySelectorAll('.csc-copy-btn').forEach(function (btn) {
          clearTimeout(btn._copyTimer);
          btn.textContent = t.copyBtn;
        });
      }

      function renderResults(selectors) {
        invalidateCopies();
        if (!selectors.length) {
          resultsEl.innerHTML = '<p class="csc-empty">' + t.noInput + '</p>';
          return;
        }

        var specs = selectors.map(function (sel) {
          try { return { sel: sel, spec: specificity(sel) }; }
          catch (e) { return { sel: sel, error: e.message || String(e) }; }
        });
        var valid = specs.filter(function (x) { return !x.error; });

        var maxA = Math.max.apply(null, valid.map(function (s) { return s.spec.a; }).concat([1]));
        var maxB = Math.max.apply(null, valid.map(function (s) { return s.spec.b; }).concat([1]));
        var maxC = Math.max.apply(null, valid.map(function (s) { return s.spec.c; }).concat([1]));

        var html = '';
        specs.forEach(function (item) {
          if (item.error) {
            html += '<div class="csc-result-card csc-result-error">';
            html += '<code class="csc-selector">' + escHtml(item.sel) + '</code>';
            html += '<p class="csc-error-msg">' + escHtml(t.invalid.replace('{msg}', item.error)) + '</p>';
            html += '</div>';
            return;
          }
          var s = item.spec;
          var tupleStr = '(' + s.a + ', ' + s.b + ', ' + s.c + ')';

          html += '<div class="csc-result-card">';
          html += '<div class="csc-result-header">';
          html += '<code class="csc-selector">' + escHtml(item.sel) + '</code>';
          html += '<span class="csc-tuple">' + tupleStr + '</span>';
          html += '</div>';

          // Breakdown badges
          html += '<div class="csc-badges">';
          html += '<span class="csc-badge csc-badge-id" title="' + t.id + '">';
          html += '<span class="csc-badge-label">a</span><span class="csc-badge-val">' + s.a + '</span>';
          html += '</span>';
          html += '<span class="csc-badge csc-badge-cls" title="' + t.cls + '">';
          html += '<span class="csc-badge-label">b</span><span class="csc-badge-val">' + s.b + '</span>';
          html += '</span>';
          html += '<span class="csc-badge csc-badge-elem" title="' + t.elem + '">';
          html += '<span class="csc-badge-label">c</span><span class="csc-badge-val">' + s.c + '</span>';
          html += '</span>';
          html += '</div>';

          // Visual bar
          html += '<div class="csc-bar-wrap">';
          html += '<div class="csc-bar-track">';
          var aPct = Math.round((s.a / maxA) * 100);
          var bPct = Math.round((s.b / maxB) * 100);
          var cPct = Math.round((s.c / maxC) * 100);
          html += '<div class="csc-bar-seg csc-bar-a" style="width:' + aPct + '%" title="' + t.id + ': ' + s.a + '"></div>';
          html += '<div class="csc-bar-seg csc-bar-b" style="width:' + bPct + '%" title="' + t.cls + ': ' + s.b + '"></div>';
          html += '<div class="csc-bar-seg csc-bar-c" style="width:' + cPct + '%" title="' + t.elem + ': ' + s.c + '"></div>';
          html += '</div>';
          html += '</div>';

          // Copy button
          html += '<button class="csc-copy-btn" type="button" data-val="' + escHtml(tupleStr) + '">' + t.copyBtn + '</button>';
          html += '</div>';
        });

        if (valid.length > 1) {
          html += '<p class="csc-note">' + t.note + '</p>';
        }

        resultsEl.innerHTML = html;

        // Copy handlers
        resultsEl.querySelectorAll('.csc-copy-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var val = btn.getAttribute('data-val');
            var revision = copyRevision;
            var request = (btn._copyRequest || 0) + 1;
            btn._copyRequest = request;
            clearTimeout(btn._copyTimer);
            btn.textContent = t.copyBtn;
            function current() {
              return revision === copyRevision && request === btn._copyRequest && resultsEl.contains(btn);
            }
            function copied() {
              if (!current()) return;
              btn.textContent = t.copied;
              btn._copyTimer = setTimeout(function () {
                if (current()) btn.textContent = t.copyBtn;
              }, 1500);
            }
            function failed() {
              if (current()) btn.textContent = t.copyFailed;
            }
            try {
              Promise.resolve(navigator.clipboard.writeText(val)).then(copied, failed);
            } catch (e) {
              failed();
            }
            window.trackTool && window.trackTool('css-specificity-calculator', 'copy');
          });
        });
      }

      var _timer = null;
      function onInput() {
        invalidateCopies();
        clearTimeout(_timer);
        _timer = setTimeout(function () {
          var raw = inputEl.value;
          var parts = splitSelectorList(raw);
          renderResults(parts);
          if (parts.length) window.trackTool && window.trackTool('css-specificity-calculator', 'calc');
        }, 200);
      }

      inputEl.addEventListener('input', onInput);
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        if (!document.querySelector('.csc-wrap').contains(document.activeElement)) return;
        e.preventDefault();
        inputEl.focus();
        clearTimeout(_timer);
        inputEl.value = '';
        renderResults([]);
      });

      // Initial render
      renderResults([]);
    })();
  </script>
</div>

<style>
  .csc-wrap { display: flex; flex-direction: column; gap: 1rem; }

  .csc-field { display: flex; flex-direction: column; gap: 0.3rem; }

  .csc-field label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .csc-field input {
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    width: 100%;
  }

  .csc-field input:focus {
    outline: none;
    border-color: var(--color-primary);
    background: var(--color-bg);
  }

  .csc-hint {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .csc-results { display: flex; flex-direction: column; gap: 0.75rem; }

  .csc-results :global(.csc-empty) {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .csc-results :global(.csc-result-card) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    background: var(--color-bg-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .csc-results :global(.csc-result-header) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: space-between;
  }

  .csc-results :global(.csc-selector) {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text);
    background: var(--color-bg-icon);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    word-break: break-all;
  }

  .csc-results :global(.csc-tuple) {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .csc-results :global(.csc-badges) {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .csc-results :global(.csc-badge) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: help;
  }

  .csc-results :global(.csc-badge-label) {
    font-family: var(--font-mono);
    font-weight: 700;
    opacity: 0.75;
  }

  .csc-results :global(.csc-badge-val) {
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .csc-results :global(.csc-badge-id) { background: #ede9fe; color: #5b21b6; }
  .csc-results :global(.csc-badge-cls) { background: #dbeafe; color: #1d4ed8; }
  .csc-results :global(.csc-badge-elem) { background: #dcfce7; color: #166534; }

  .csc-results :global(.csc-bar-wrap) { width: 100%; }

  .csc-results :global(.csc-bar-track) {
    display: flex;
    gap: 3px;
    height: 8px;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-border);
  }

  .csc-results :global(.csc-bar-seg) {
    border-radius: 4px;
    min-width: 0;
    transition: width 0.2s ease;
  }

  .csc-results :global(.csc-bar-a) { background: #7c3aed; }
  .csc-results :global(.csc-bar-b) { background: #2563eb; }
  .csc-results :global(.csc-bar-c) { background: #16a34a; }

  .csc-results :global(.csc-copy-btn) {
    align-self: flex-start;
    padding: 0.3rem 0.8rem;
    font-size: 0.82rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .csc-results :global(.csc-copy-btn:hover) { border-color: var(--color-primary); color: var(--color-primary); }

  .csc-results :global(.csc-note) {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .csc-results :global(.csc-badge-id) { background: #3b1f6b; color: #c4b5fd; }
    :global(:root:not([data-theme="light"])) .csc-results :global(.csc-badge-cls) { background: #1e3a6b; color: #93c5fd; }
    :global(:root:not([data-theme="light"])) .csc-results :global(.csc-badge-elem) { background: #14432a; color: #86efac; }
  }

  :global([data-theme="dark"]) .csc-results :global(.csc-badge-id) { background: #3b1f6b; color: #c4b5fd; }
  :global([data-theme="dark"]) .csc-results :global(.csc-badge-cls) { background: #1e3a6b; color: #93c5fd; }
  :global([data-theme="dark"]) .csc-results :global(.csc-badge-elem) { background: #14432a; color: #86efac; }
  .csc-results :global(.csc-error-msg) {
    margin: 0;
    font-size: 0.85rem;
    color: #b91c1c;
  }
  :global([data-theme="dark"]) .csc-results :global(.csc-error-msg) { color: #fca5a5; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .csc-results :global(.csc-error-msg) { color: #fca5a5; }
  }
</style>
