---
// CssSpecificityCalculatorTool — pure client-side CSS specificity calculator
import Toggletip from '../Toggletip.astro';
const { lang = 'en' } = Astro.props;
// strings:start
const STRINGS = {
  en: {
    parsingLabel: "Parsing limits", copyLabel: "Copy a result",
    tips: {
      "input": "Type selectors to calculate after a 200 ms pause. Separate selectors with commas; commas inside brackets or quoted strings stay within a selector. Ctrl/⌘+L clears the input and results.",
      "parsing": "Unclosed brackets or strings produce an error card with a position. Unknown pseudo-class names still count. The nesting selector & counts as zero because no parent rule is supplied.",
      "results": "Read (a, b, c) as IDs, classes/attributes/pseudo-classes, then elements/pseudo-elements. Compare from the left. :where() counts zero; :is(), :not() and :has() use their most specific argument. This covers specificity, not every step of the cascade.",
      "copy": "Each Copy button copies only that card’s tuple, such as (1, 2, 0). After a copy failure, click the same button to retry."
    },
    inputLabel: 'CSS Selector(s)',
    inputPlaceholder: '#nav .item:hover, h1.title',
    hint: 'Comma-separate multiple selectors to compare',
    id: 'ID', cls: 'Class / Attr / Pseudo-class', elem: 'Element / Pseudo-element',
    specificity: 'Specificity', noInput: 'Enter a CSS selector above.',
    copyBtn: 'Copy', copied: 'Copied!', copyFailed: 'Copy failed',
    note: 'Compare left to right: the first column that differs decides. :where() counts 0; :is(), :not(), :has() count as their most specific argument.',
    invalid: 'Not a valid selector: {msg}',
    errors: {
      unclosedString: 'Unclosed string (position {pos})',
      unexpected: 'Unexpected "{char}" (position {pos})',
      missing: 'Missing "{char}" (position {pos})',
      escapeEnd: 'Escape at end of input (position {pos})',
      expectedName: 'Expected a name (position {pos})',
      emptyArgument: 'Empty argument (position {pos})',
      emptySelector: 'Empty selector (position {pos})',
      unexpectedSpace: '{code} at position {pos} is not a CSS space and cannot be part of a name'
    },
    fullwidth: 'This selector contains full-width characters such as ＃ ． ： ［. CSS does not read them as # . : [ but as part of a name, and the tuple counts them that way. Type them in half-width form.'
  },
  zh: {
    parsingLabel: "解析限制", copyLabel: "复制结果",
    tips: {
      "input": "输入选择器，停顿 200 毫秒后自动计算。用逗号分隔多个选择器；括号或引号内的逗号不拆分。Ctrl/⌘+L 清空输入和结果。",
      "parsing": "括号或引号未闭合时，错误卡片会指出位置。未知的伪类名称仍会计数。未提供父规则，因此嵌套选择器 & 在这里计为零。",
      "results": "(a, b, c) 依次为 ID、类/属性/伪类、元素/伪元素。从左侧开始比较。:where() 计零；:is()、:not()、:has() 取参数中优先级最高的一项。这里只计算优先级，不涵盖层叠的所有步骤。",
      "copy": "每个复制按钮只复制所在卡片的元组，例如 (1, 2, 0)。复制失败后，可直接再次点击同一按钮。"
    },
    inputLabel: 'CSS 选择器',
    inputPlaceholder: '#nav .item:hover, h1.title',
    hint: '用逗号分隔多个选择器以对比优先级',
    id: 'ID', cls: '类 / 属性 / 伪类', elem: '元素 / 伪元素',
    specificity: '优先级', noInput: '请在上方输入 CSS 选择器。',
    copyBtn: '复制', copied: '已复制!', copyFailed: '复制失败',
    note: '从左往右比较，第一个不同的列决定胜负。:where() 计 0；:is()、:not()、:has() 取参数中优先级最高的一项。',
    invalid: '不是有效的选择器：{msg}',
    errors: {
      unclosedString: '引号没有闭合（第 {pos} 个字符）',
      unexpected: '这里不能出现「{char}」（第 {pos} 个字符）',
      missing: '第 {pos} 个字符处的括号缺少对应的「{char}」',
      escapeEnd: '反斜杠后面没有字符（第 {pos} 个字符）',
      expectedName: '第 {pos} 个字符处缺少名称',
      emptyArgument: '括号里没有选择器（第 {pos} 个字符）',
      emptySelector: '选择器为空（第 {pos} 个字符）',
      unexpectedSpace: '第 {pos} 个字符是 {code}，它在 CSS 里不是空格，也不能用在名称里'
    },
    fullwidth: '选择器里有全角字符（如 ＃ ． ： ［）。CSS 不把它们当作 # . : [，而是当作名称的一部分，元组也按这种读法计算。请改用半角字符。'
  },
  ja: {
    parsingLabel: "解析の制限", copyLabel: "結果のコピー",
    tips: {
      "input": "セレクターを入力し、200 ミリ秒待つと自動計算します。複数はカンマで区切ります。括弧や引用符の中のカンマでは分割しません。Ctrl/⌘+L で入力と結果を消去します。",
      "parsing": "閉じていない括弧や引用符は、位置付きのエラーカードになります。未知の疑似クラス名も数えます。親ルールがないため、ネストセレクター & はここではゼロです。",
      "results": "(a, b, c) は ID、クラス・属性・疑似クラス、要素・疑似要素の順です。左から比較します。:where() はゼロ、:is()・:not()・:has() は最も詳細度が高い引数を使います。カスケード全体ではなく、詳細度を計算します。",
      "copy": "各コピーボタンは、そのカードのタプルだけをコピーします。例は (1, 2, 0) です。失敗したら同じボタンで再試行できます。"
    },
    inputLabel: 'CSS セレクター',
    inputPlaceholder: '#nav .item:hover, h1.title',
    hint: 'カンマ区切りで複数のセレクターを比較',
    id: 'ID', cls: 'クラス / 属性 / 疑似クラス', elem: '要素 / 疑似要素',
    specificity: '詳細度', noInput: '上にCSSセレクターを入力してください。',
    copyBtn: 'コピー', copied: 'コピー済み!', copyFailed: 'コピー失敗',
    note: '左の列から比較し、最初に異なる列で決まります。:where() は 0、:is()・:not()・:has() は引数のうち最も詳細度が高いものを使います。',
    invalid: '有効なセレクターではありません：{msg}',
    errors: {
      unclosedString: '引用符が閉じていません（{pos} 文字目）',
      unexpected: '「{char}」はここに書けません（{pos} 文字目）',
      missing: '{pos} 文字目の括弧に対応する「{char}」がありません',
      escapeEnd: 'バックスラッシュの後に文字がありません（{pos} 文字目）',
      expectedName: '{pos} 文字目に名前がありません',
      emptyArgument: '括弧の中にセレクターがありません（{pos} 文字目）',
      emptySelector: 'セレクターが空です（{pos} 文字目）',
      unexpectedSpace: '{pos} 文字目の {code} は CSS の空白ではなく、名前にも使えません'
    },
    fullwidth: 'セレクターに全角文字（＃ ． ： ［ など）が含まれています。CSS はこれらを # . : [ としてではなく名前の一部として読み、タプルもその読み方で数えています。半角で入力してください。'
  },
  ko: {
    parsingLabel: "해석 제한", copyLabel: "결과 복사",
    tips: {
      "input": "선택자를 입력하고 200밀리초 멈추면 자동 계산합니다. 여러 선택자는 쉼표로 구분합니다. 괄호나 따옴표 안의 쉼표로는 나누지 않습니다. Ctrl/⌘+L로 입력과 결과를 지웁니다.",
      "parsing": "닫히지 않은 괄호나 따옴표는 위치가 표시된 오류 카드로 나타납니다. 알 수 없는 가상 클래스 이름도 셉니다. 부모 규칙이 없으므로 중첩 선택자 &는 여기서 0입니다.",
      "results": "(a, b, c)는 ID, 클래스·속성·가상 클래스, 요소·가상 요소 순입니다. 왼쪽부터 비교합니다. :where()는 0, :is()·:not()·:has()는 명시도가 가장 높은 인수를 씁니다. 캐스케이드의 모든 단계가 아닌 명시도를 계산합니다.",
      "copy": "각 복사 버튼은 해당 카드의 튜플만 복사합니다. 예: (1, 2, 0). 복사에 실패하면 같은 버튼을 다시 눌러 재시도하세요."
    },
    inputLabel: 'CSS 선택자',
    inputPlaceholder: '#nav .item:hover, h1.title',
    hint: '쉼표로 구분하여 여러 선택자 비교',
    id: 'ID', cls: '클래스 / 속성 / 가상 클래스', elem: '요소 / 가상 요소',
    specificity: '명시도', noInput: '위에 CSS 선택자를 입력하세요.',
    copyBtn: '복사', copied: '복사됨!', copyFailed: '복사 실패',
    note: '왼쪽 열부터 비교하며 처음 달라지는 열이 결정합니다. :where()는 0, :is()·:not()·:has()는 인수 중 명시도가 가장 높은 것을 씁니다.',
    invalid: '올바른 선택자가 아닙니다: {msg}',
    errors: {
      unclosedString: '따옴표가 닫히지 않았습니다({pos}번째 문자)',
      unexpected: '"{char}" 문자는 여기에 올 수 없습니다({pos}번째 문자)',
      missing: '{pos}번째 문자의 괄호를 닫는 "{char}" 문자가 없습니다',
      escapeEnd: '백슬래시 뒤에 문자가 없습니다({pos}번째 문자)',
      expectedName: '{pos}번째 문자에 이름이 없습니다',
      emptyArgument: '괄호 안에 선택자가 없습니다({pos}번째 문자)',
      emptySelector: '선택자가 비어 있습니다({pos}번째 문자)',
      unexpectedSpace: '{pos}번째 문자({code})는 CSS의 공백이 아니며 이름에도 쓸 수 없는 문자입니다'
    },
    fullwidth: '선택자에 전각 문자(＃ ． ： ［ 등)가 들어 있습니다. CSS는 이를 # . : [ 기호로 읽지 않고 이름의 일부로 읽으며, 튜플도 그렇게 셉니다. 반각 문자로 입력하세요.'
  }
};
// strings:end
const T = STRINGS[lang] || STRINGS.en;
const TIPS = T.tips;
const CLIENT_T = { id: T.id, cls: T.cls, elem: T.elem, noInput: T.noInput, copyBtn: T.copyBtn, copied: T.copied, copyFailed: T.copyFailed, note: T.note, invalid: T.invalid, errors: T.errors, fullwidth: T.fullwidth };
---
<div class="csc-wrap">
  <div class="csc-field">
    <div class="csc-label-row">
      <label for="csc-input">{T.inputLabel}</label>
      <Toggletip id="csc-tip-input" lang={lang} about={T.inputLabel}>{TIPS.input}</Toggletip>
      <span class="csc-help-label">{T.parsingLabel}</span>
      <Toggletip id="csc-tip-parsing" lang={lang} about={T.parsingLabel}>{TIPS.parsing}</Toggletip>
    </div>
    <input
      id="csc-input"
      class="tool-input"
      type="text"
      placeholder={T.inputPlaceholder}
      spellcheck="false"
      autocomplete="off"
    />
  </div>
  <div class="csc-hint csc-status">{T.hint}</div>
  <section class="csc-result-section" aria-labelledby="csc-result-label">
    <div class="csc-result-head">
      <div class="csc-label-row">
        <h2 id="csc-result-label">{T.specificity}</h2>
        <Toggletip id="csc-tip-results" lang={lang} about={T.specificity}>{TIPS.results}</Toggletip>
      </div>
      <div class="csc-label-row">
        <span class="csc-help-label">{T.copyLabel}</span>
        <Toggletip id="csc-tip-copy" lang={lang} about={T.copyLabel}>{TIPS.copy}</Toggletip>
      </div>
    </div>
    <div id="csc-results" class="csc-results" tabindex="0" role="region" aria-label={T.specificity} aria-live="polite"></div>
  </section>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var inputEl = document.getElementById('csc-input');
      var resultsEl = document.getElementById('csc-results');

      /* ── engine:start ── */
      /* Specificity per Selectors Level 4 §17: a = IDs, b = classes, attributes
         and pseudo-classes, c = type selectors and pseudo-elements; `*` and
         combinators count 0. :is() / :not() / :has() count as their most
         specific argument, :where() counts 0, :nth-child(An+B of S) /
         :nth-last-child() count one pseudo-class plus the most specific S.
         ::slotted(), :host() and :host-context() add their argument (CSS Scoping).
         `&` counts 0 here: its real value is that of the parent rule, which a
         lone selector does not show. */
      var LEGACY_PSEUDO_ELEMENTS = { before: 1, after: 1, 'first-line': 1, 'first-letter': 1 };
      var MAX_OF_ARGS = { is: 1, not: 1, has: 1, matches: 1, '-webkit-any': 1, '-moz-any': 1 };

      function cssError(msg, pos) {
        var e = new SyntaxError(msg + ' (position ' + (pos + 1) + ')');
        e.position = pos;
        return e;
      }

      /* Index just past a quoted string that starts at i. */
      function skipString(s, i) {
        var q = s[i];
        i++;
        while (i < s.length && s[i] !== q) {
          if (s[i] === '\\') i++;
          i++;
        }
        if (i >= s.length) throw cssError('Unclosed string', i - 1);
        return i + 1;
      }

      /* Index of the bracket that closes the one at i (`(` or `[`). */
      function matchClose(s, i) {
        var stack = [];
        for (var j = i; j < s.length; j++) {
          var ch = s[j];
          if (ch === '\\') { j++; continue; }
          if (ch === '"' || ch === "'") { j = skipString(s, j) - 1; continue; }
          if (ch === '(' || ch === '[') stack.push(ch === '(' ? ')' : ']');
          else if (ch === ')' || ch === ']') {
            if (stack.pop() !== ch) throw cssError('Unexpected "' + ch + '"', j);
            if (!stack.length) return j;
          }
        }
        throw cssError('Missing "' + (s[i] === '(' ? ')' : ']') + '"', i);
      }

      /* Split at commas that are not inside brackets or strings; each item
         keeps its start index so errors can point into the original text. */
      function splitRanges(text) {
        var parts = [], depth = 0, start = 0;
        function push(end) {
          var raw = text.slice(start, end);
          var lead = raw.length - raw.replace(/^\s+/, '').length;
          var trimmed = raw.trim();
          if (trimmed) parts.push({ text: trimmed, start: start + lead });
        }
        for (var i = 0; i < text.length; i++) {
          var ch = text[i];
          if (ch === '\\') { i++; continue; }
          if (ch === '"' || ch === "'") {
            var q = ch;
            i++;
            while (i < text.length && text[i] !== q) { if (text[i] === '\\') i++; i++; }
            continue;
          }
          if (ch === '(' || ch === '[') depth++;
          else if ((ch === ')' || ch === ']') && depth > 0) depth--;
          else if (ch === ',' && depth === 0) { push(i); start = i + 1; }
        }
        push(text.length);
        return parts;
      }
      function splitSelectorList(text) {
        return splitRanges(text).map(function (p) { return p.text; });
      }

      /* Name characters per CSS Syntax 3 §4.2 (non-ASCII ident code point). Surrogate halves
         belong to code points at or above U+10000, which are name characters. */
      function isIdentChar(ch) {
        if (/[A-Za-z0-9_-]/.test(ch)) return true;
        var c = ch.charCodeAt(0);
        return c === 0xB7 || (c >= 0xC0 && c <= 0xD6) || (c >= 0xD8 && c <= 0xF6) || (c >= 0xF8 && c <= 0x37D)
          || (c >= 0x37F && c <= 0x1FFF) || c === 0x200C || c === 0x200D || c === 0x203F || c === 0x2040
          || (c >= 0x2070 && c <= 0x218F) || (c >= 0x2C00 && c <= 0x2FEF) || (c >= 0x3001 && c <= 0xD7FF)
          || (c >= 0xD800 && c <= 0xDFFF) || (c >= 0xF900 && c <= 0xFDCF) || (c >= 0xFDF0 && c <= 0xFFFD);
      }
      /* Read a CSS identifier (with escapes) at i; return the index after it. */
      function readIdent(s, i) {
        var start = i;
        while (i < s.length) {
          if (s[i] === '\\') {
            if (i + 1 >= s.length) throw cssError('Escape at end of input', i);
            i++;
            if (/[0-9a-fA-F]/.test(s[i])) {
              var n = 0;
              while (n < 6 && i < s.length && /[0-9a-fA-F]/.test(s[i])) { i++; n++; }
              if (i < s.length && /[ \t\n\r\f]/.test(s[i])) i++;
            } else {
              i++;
            }
          } else if (isIdentChar(s[i])) {
            i++;
          } else {
            break;
          }
        }
        if (i === start || s.slice(start, i) === '-') throw cssError('Expected a name', start);
        return i;
      }

      function maxSpec(list) {
        var best = { a: 0, b: 0, c: 0 };
        for (var i = 0; i < list.length; i++) {
          var x = list[i];
          if (x.a > best.a || (x.a === best.a && (x.b > best.b || (x.b === best.b && x.c > best.c)))) best = x;
        }
        return best;
      }
      function listSpec(text, offset) {
        var items = splitRanges(text);
        if (!items.length) throw cssError('Empty argument', offset);
        return maxSpec(items.map(function (item) { return complexSpec(item.text, offset + item.start); }));
      }

      function complexSpec(sel, offset) {
        offset = offset || 0;
        var a = 0, b = 0, c = 0;
        var s = sel;
        var i = 0;
        function add(x) { a += x.a; b += x.b; c += x.c; }
        try {
          while (i < s.length) {
            var ch = s[i];
            if (/[ \t\n\r\f]/.test(ch) || ch === '>' || ch === '+' || ch === '~' || ch === '*' || ch === '&') { i++; continue; }
            if (ch === '|') { i += s[i + 1] === '|' ? 2 : 1; continue; }
            if (ch === '#') { i = readIdent(s, i + 1); a++; continue; }
            if (ch === '.') { i = readIdent(s, i + 1); b++; continue; }
            if (ch === '[') { i = matchClose(s, i) + 1; b++; continue; }
            if (ch === ':') {
              var pseudoElement = s[i + 1] === ':';
              var nameStart = i + (pseudoElement ? 2 : 1);
              var nameEnd = readIdent(s, nameStart);
              var name = s.slice(nameStart, nameEnd).toLowerCase();
              var arg = null, argStart = 0;
              i = nameEnd;
              if (s[i] === '(') {
                var close = matchClose(s, i);
                argStart = i + 1;
                arg = s.slice(argStart, close);
                i = close + 1;
              }
              if (pseudoElement || (arg === null && LEGACY_PSEUDO_ELEMENTS[name])) {
                c++;
                if (pseudoElement && name === 'slotted' && arg !== null) add(listSpec(arg, offset + argStart));
                continue;
              }
              if (arg === null) { b++; continue; }
              if (name === 'where') continue;
              if (MAX_OF_ARGS[name]) { add(listSpec(arg, offset + argStart)); continue; }
              b++;
              if (name === 'nth-child' || name === 'nth-last-child') {
                var of = /\sof\s/i.exec(arg);
                if (of) add(listSpec(arg.slice(of.index + of[0].length), offset + argStart + of.index + of[0].length));
              } else if (name === 'host' || name === 'host-context') {
                add(listSpec(arg, offset + argStart));
              }
              continue;
            }
            if (isIdentChar(ch) || ch === '\\') {
              i = readIdent(s, i);
              if (s[i] === '|' && s[i + 1] !== '|') { i++; continue; }
              c++;
              continue;
            }
            throw cssError('Unexpected "' + ch + '"', i);
          }
        } catch (e) {
          if (e && typeof e.position === 'number' && !e.shifted) {
            var shifted = cssError(e.message.replace(/ \(position \d+\)$/, ''), e.position + offset);
            shifted.shifted = true;
            throw shifted;
          }
          throw e;
        }
        return { a: a, b: b, c: c };
      }

      /* Specificity of one selector (no top-level commas). */
      function specificity(sel) {
        if (!sel.trim()) throw cssError('Empty selector', 0);
        return complexSpec(sel, 0);
      }
      /* ── engine:end ── */

      /* The engine's English messages in the page language, with the same position. */
      var ERROR_PATTERNS = [
        [/^Unclosed string \(position (\d+)\)$/, 'unclosedString', false],
        [/^Unexpected "([\s\S])" \(position (\d+)\)$/, 'unexpected', true],
        [/^Missing "([)\]])" \(position (\d+)\)$/, 'missing', true],
        [/^Escape at end of input \(position (\d+)\)$/, 'escapeEnd', false],
        [/^Expected a name \(position (\d+)\)$/, 'expectedName', false],
        [/^Empty argument \(position (\d+)\)$/, 'emptyArgument', false],
        [/^Empty selector \(position (\d+)\)$/, 'emptySelector', false]
      ];
      function localizeError(msg) {
        for (var i = 0; i < ERROR_PATTERNS.length; i++) {
          var m = ERROR_PATTERNS[i][0].exec(msg);
          if (!m) continue;
          var hasChar = ERROR_PATTERNS[i][2];
          if (ERROR_PATTERNS[i][1] === 'unexpected' && /\s/.test(m[1])) {
            var code = m[1].charCodeAt(0).toString(16).toUpperCase();
            return t.errors.unexpectedSpace
              .replace('{code}', 'U+' + ('0000' + code).slice(-4))
              .replace('{pos}', m[2]);
          }
          return t.errors[ERROR_PATTERNS[i][1]]
            .replace('{char}', hasChar ? m[1] : '')
            .replace('{pos}', hasChar ? m[2] : m[1]);
        }
        return msg;
      }

      /* Full-width forms (U+FF01–FF5E) are name characters in CSS (CSS Syntax 3, non-ASCII
         ident code point), so ＃ｍａｉｎ is one type selector. Text in quoted strings is not checked. */
      function hasFullwidth(sel) {
        return /[\uFF01-\uFF5E]/.test(sel.replace(/"(?:[^"\\]|\\[\s\S])*"|'(?:[^'\\]|\\[\s\S])*'/g, ''));
      }

      function escHtml(str) {
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      var copyRevision = 0;
      function invalidateCopies() {
        copyRevision++;
        resultsEl.querySelectorAll('.csc-copy-btn').forEach(function (btn) {
          clearTimeout(btn._copyTimer);
          btn.textContent = t.copyBtn;
        });
      }

      function renderResults(selectors) {
        invalidateCopies();
        if (!selectors.length) {
          resultsEl.innerHTML = '<p class="csc-empty">' + t.noInput + '</p>';
          return;
        }

        var specs = selectors.map(function (sel) {
          try { return { sel: sel, spec: specificity(sel) }; }
          catch (e) { return { sel: sel, error: e.message || String(e) }; }
        });
        var valid = specs.filter(function (x) { return !x.error; });

        var maxA = Math.max.apply(null, valid.map(function (s) { return s.spec.a; }).concat([1]));
        var maxB = Math.max.apply(null, valid.map(function (s) { return s.spec.b; }).concat([1]));
        var maxC = Math.max.apply(null, valid.map(function (s) { return s.spec.c; }).concat([1]));

        var html = '';
        specs.forEach(function (item) {
          if (item.error) {
            html += '<div class="csc-result-card csc-result-error">';
            html += '<code class="csc-selector">' + escHtml(item.sel) + '</code>';
            html += '<p class="csc-error-msg">' + escHtml(t.invalid.replace('{msg}', localizeError(item.error))) + '</p>';
            if (hasFullwidth(item.sel)) html += '<p class="csc-warn">' + escHtml(t.fullwidth) + '</p>';
            html += '</div>';
            return;
          }
          var s = item.spec;
          var tupleStr = '(' + s.a + ', ' + s.b + ', ' + s.c + ')';

          html += '<div class="csc-result-card">';
          html += '<div class="csc-result-header">';
          html += '<code class="csc-selector">' + escHtml(item.sel) + '</code>';
          html += '<span class="csc-tuple">' + tupleStr + '</span>';
          html += '</div>';
          if (hasFullwidth(item.sel)) html += '<p class="csc-warn">' + escHtml(t.fullwidth) + '</p>';

          // Breakdown badges
          html += '<div class="csc-badges">';
          html += '<span class="csc-badge csc-badge-id" title="' + t.id + '">';
          html += '<span class="csc-badge-label">a</span><span class="csc-badge-val">' + s.a + '</span>';
          html += '</span>';
          html += '<span class="csc-badge csc-badge-cls" title="' + t.cls + '">';
          html += '<span class="csc-badge-label">b</span><span class="csc-badge-val">' + s.b + '</span>';
          html += '</span>';
          html += '<span class="csc-badge csc-badge-elem" title="' + t.elem + '">';
          html += '<span class="csc-badge-label">c</span><span class="csc-badge-val">' + s.c + '</span>';
          html += '</span>';
          html += '</div>';

          // Visual bar
          html += '<div class="csc-bar-wrap">';
          html += '<div class="csc-bar-track">';
          var aPct = Math.round((s.a / maxA) * 100);
          var bPct = Math.round((s.b / maxB) * 100);
          var cPct = Math.round((s.c / maxC) * 100);
          html += '<div class="csc-bar-seg csc-bar-a" style="width:' + aPct + '%" title="' + t.id + ': ' + s.a + '"></div>';
          html += '<div class="csc-bar-seg csc-bar-b" style="width:' + bPct + '%" title="' + t.cls + ': ' + s.b + '"></div>';
          html += '<div class="csc-bar-seg csc-bar-c" style="width:' + cPct + '%" title="' + t.elem + ': ' + s.c + '"></div>';
          html += '</div>';
          html += '</div>';

          // Copy button
          html += '<button class="csc-copy-btn btn-copy" type="button" data-val="' + escHtml(tupleStr) + '">' + t.copyBtn + '</button>';
          html += '</div>';
        });

        if (valid.length > 1) {
          html += '<p class="csc-note">' + t.note + '</p>';
        }

        resultsEl.innerHTML = html;

        // Copy handlers
        resultsEl.querySelectorAll('.csc-copy-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var val = btn.getAttribute('data-val');
            var revision = copyRevision;
            var request = (btn._copyRequest || 0) + 1;
            btn._copyRequest = request;
            clearTimeout(btn._copyTimer);
            btn.textContent = t.copyBtn;
            function current() {
              return revision === copyRevision && request === btn._copyRequest && resultsEl.contains(btn);
            }
            function copied() {
              if (!current()) return;
              window.trackTool && window.trackTool('css-specificity-calculator', 'copy');
              btn.textContent = t.copied;
              btn._copyTimer = setTimeout(function () {
                if (current()) btn.textContent = t.copyBtn;
              }, 1500);
            }
            function failed() {
              if (current()) btn.textContent = t.copyFailed;
            }
            /* Hidden textarea + execCommand('copy') when the Clipboard API is missing, throws or
               rejects (as in color-palette-generator); focus returns to the button. */
            function viaFallback() {
              if (!current()) return;
              var ta = document.createElement('textarea');
              ta.value = val;
              ta.setAttribute('readonly', '');
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              var ok = false;
              try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
              document.body.removeChild(ta);
              btn.focus();
              if (ok) copied(); else failed();
            }
            var task;
            try {
              task = Promise.resolve(navigator.clipboard.writeText(val));
            } catch (e) {
              task = Promise.reject(e);
            }
            task.then(copied, viaFallback);
          });
        });
      }

      var _timer = null;
      function onInput() {
        invalidateCopies();
        clearTimeout(_timer);
        _timer = setTimeout(function () {
          var raw = inputEl.value;
          var parts = splitSelectorList(raw);
          renderResults(parts);
        }, 200);
      }

      inputEl.addEventListener('input', onInput);
      /* Analytics: one event per committed change (as in css-triangle-generator), not per pause. */
      inputEl.addEventListener('change', function () {
        if (splitSelectorList(inputEl.value).length) window.trackTool && window.trackTool('css-specificity-calculator', 'calc');
      });
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        if (!document.querySelector('.csc-wrap').contains(document.activeElement)) return;
        e.preventDefault();
        inputEl.focus();
        clearTimeout(_timer);
        inputEl.value = '';
        renderResults([]);
      });

      // Initial render
      renderResults([]);
    })();
  </script>
</div>

