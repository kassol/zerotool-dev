    "selectFiles": "Select image files",
    "resizeAria": "Long edge in pixels",
    "tips": {
      "format": "Choose Keep original, JPEG, PNG or WebP before importing. Settings do not recompress existing results; select the files again. JPEG replaces transparency with white. If the browser outputs PNG instead, the download uses .png and the card explains the fallback.",
      "quality": "Quality is 1–100, with a default of 75, for JPEG and WebP. PNG is lossless and ignores this value; the slider is disabled for PNG output or Keep original with a PNG first in the batch. Set quality before importing again.",
      "resize": "Enable Resize long edge to before importing. The default is 1920 px. Images above the limit shrink proportionally; smaller images are not enlarged. The numeric input offers 64–16384 px. Reimport to apply changes.",
      "files": "Select or drop JPEG, PNG, WebP or GIF files for automatic local compression. Each file is limited to 50 MB (50 × 1024 × 1024 bytes). Animation becomes a still image, and re-encoding drops metadata. Up to three images are processed at once.",
      "download": "Each card shows dimensions and byte sizes before and after compression. A larger output is marked in red. Download saves one result; Download All starts one download per successful file, without a ZIP. The browser may ask to allow multiple downloads."
    },
    "formatLabel": "Output format:",
    "keepOriginal": "Keep original",
    "qualityLabel": "Quality:",
    "resizeLabel": "Resize long edge to",
    "dropHint": "Drop images here, or <strong>click to select</strong>",
