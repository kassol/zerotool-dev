    invert: '반전',
    opacity: '불투명도',
    saturate: '채도',
    sepia: '세피아',
    reset: '초기화',
    resetAll: '모두 초기화',
    preview: '미리보기',
    uploadImage: '이미지 업로드',
    outputLabel: '생성된 CSS',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사 실패',
