    gap: 0.4rem;
    font-size: 0.8rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color 0.1s, color 0.1s;
    user-select: none;
  }

  .cfg-upload-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }

  .cfg-file-hidden {
    display: none;
  }

  /* Controls column */
  .cfg-controls-col {
    flex: 1;
    min-width: 260px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cfg-controls-header {
    display: flex;
    justify-content: flex-end;
  }

  .cfg-reset-all-btn {
    font-size: 0.76rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color 0.1s, color 0.1s;
  }

  .cfg-reset-all-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }

