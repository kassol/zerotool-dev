    padding: 0.15rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color 0.1s, color 0.1s;
    line-height: 1.4;
    min-height: 24px;
    min-width: 24px;
  }

  .cfg-reset-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }

  .cfg-slider-row { display: flex; align-items: center; gap: 0.5rem; }

  .cfg-range {
    flex: 1;
    min-width: 80px;
    accent-color: var(--color-primary);
    cursor: pointer;
  }

  .cfg-num-input {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.28rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    width: 60px;
    box-sizing: border-box;
    text-align: right;
  }

  .cfg-num-input:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .cfg-unit {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    flex-shrink: 0;
    width: 2rem;
  }

  /* Section label */
  .cfg-section-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  /* Output */
  .cfg-output-section { display: flex; flex-direction: column; gap: 0.5rem; }

  .cfg-output-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cfg-pre {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    overflow-x: auto;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .cfg-code { font-family: inherit; }

  .cfg-wrap :global(.cfg-hl-sel)   { color: #7c3aed; font-weight: 600; }
  .cfg-wrap :global(.cfg-hl-brace) { color: var(--color-text-secondary); }
