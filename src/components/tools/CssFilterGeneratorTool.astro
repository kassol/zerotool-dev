  .cfg-wrap { min-height: 0; min-width: 0; flex: 1; }
  .cfg-body { display: flex; gap: 1rem; flex: 1 1 0; min-height: 0; min-width: 0; }
  .cfg-rail { flex: 0 0 300px; width: 300px; overflow: auto; padding: 0.2rem; }
  .cfg-field-header, .cfg-label-tip { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
  .cfg-wrap .tool-status { min-height: 1.4rem; margin: 0; flex: none; }
  .cfg-pre { overflow: auto; min-width: 0; height: 10rem; max-height: 10rem; flex: none; }
  .cfg-preview-section { flex: 1; min-width: 0; min-height: 0; overflow: auto; }
  .cfg-empty { display: none; margin: auto; padding: 1rem; text-align: center; color: var(--color-text-secondary); }
  .cfg-wrap[data-empty="true"] .cfg-empty { display: block; }
  @media (max-width: 860px) {
    .cfg-body { flex-direction: column; flex: none; }
    .cfg-rail { width: 100%; flex: none; overflow: visible; padding: 0; }
    .cfg-preview-section { flex: none; }
    .cfg-wrap[data-empty="true"] .cfg-preview-section { display: none; }
  }
  @media (max-width: 640px) {
    .cfg-body { gap: 0.75rem; }
    .cfg-rail { gap: 0.55rem; }
