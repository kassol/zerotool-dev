  .cfg-upload-row { display: flex; align-items: center; gap: 0.35rem; }
  .cfg-controls-col { min-width: 0; min-height: 0; flex: 1 1 0; overflow: auto; gap: 0.45rem; }
  .cfg-controls-header { align-items: center; gap: 0.35rem; }
  .cfg-preview-col { flex-shrink: 1; }
  .cfg-preview-box { width: 100%; height: auto; min-height: 180px; flex: 1; display: flex; }
  .cfg-field-header { gap: 0.25rem; }
  .cfg-field-label { font-size: 0.75rem; }
  .cfg-more summary { cursor: pointer; min-height: 24px; font-size: 0.8rem; color: var(--color-text-secondary); }
  .cfg-more .cfg-field { margin-top: 0.45rem; }
  @media (max-width: 860px) {
    .cfg-controls-col { flex: none; overflow: visible; }
    .cfg-preview-box { flex: none; height: 200px; }
  }
  @media (max-width: 640px) {
    .cfg-upload-btn { min-height: 44px; }
    .cfg-num-input, .cfg-reset-btn, .cfg-reset-all-btn, .cfg-more summary { min-height: 24px; min-width: 24px; }
    .cfg-slider-row { gap: 0.3rem; }
    .cfg-controls-col { gap: 0.35rem; }
    .cfg-field { gap: 0.15rem; }
    .cfg-preview-box { height: 180px; min-height: 180px; }
  }
</style>
