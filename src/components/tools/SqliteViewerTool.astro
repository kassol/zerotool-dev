---
// SqliteViewerTool — opens a local SQLite file in memory with sql.js (WASM),
// lists tables/views with their structure, pages through rows, runs SQL against
// the in-memory copy, and exports results as CSV. The engine (/sql-js/, synced
// from node_modules by scripts/sync-sql-js.mjs) is fetched only after a file
// passes the header check. No upload, no persistence.
---

<div>
  <div class="sqv-shell">
    <div class="sqv-dropzone" id="sqv-dropzone" tabindex="0" role="button" aria-label="Choose SQLite file">
      <input type="file" id="sqv-file-input" accept=".db,.sqlite,.sqlite3,.db3,application/vnd.sqlite3,application/x-sqlite3" hidden />
      <svg class="sqv-dropzone-icon" xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>
      <p class="sqv-dropzone-title" data-i18n="dropTitle">Drop a SQLite file here</p>
      <p class="sqv-dropzone-hint" data-i18n="dropHint">.db · .sqlite · .sqlite3 — up to 100 MB · or click to choose · never uploaded</p>
    </div>

    <div class="sqv-meta" id="sqv-meta" hidden>
      <span class="sqv-pill sqv-pill-name" id="sqv-meta-name" title="">—</span>
      <span class="sqv-pill" id="sqv-meta-size">—</span>
      <span class="sqv-pill" id="sqv-meta-tables">—</span>
      <span class="sqv-pill" id="sqv-meta-views">—</span>
      <button class="btn-ghost sqv-reset" id="sqv-reset" type="button" data-i18n="openAnother">Open another file</button>
    </div>

    <div class="tool-status none" id="sqv-status" aria-live="polite"></div>

    <div class="sqv-layout" id="sqv-layout" hidden>
      <nav class="sqv-objects" id="sqv-objects" aria-label="Tables and views"></nav>

      <section class="sqv-card sqv-browse">
        <div class="sqv-browse-head">
          <h3 class="sqv-object-title" id="sqv-object-title">—</h3>
          <span class="sqv-object-sub" id="sqv-object-sub"></span>
        </div>

        <details class="sqv-structure" id="sqv-structure" open>
          <summary data-i18n="structure">Structure</summary>
          <div class="sqv-grid-wrap sqv-grid-wrap-sm"><table class="sqv-grid" id="sqv-columns"></table></div>
          <p class="sqv-subhead" data-i18n="indexes">Indexes</p>
          <div id="sqv-indexes"></div>
          <p class="sqv-subhead" data-i18n="createSql">CREATE statement</p>
          <pre class="sqv-create"><code id="sqv-create"></code></pre>
        </details>

        <div class="sqv-pager-actions">
          <button class="btn-secondary" id="sqv-prev" type="button" data-i18n="prev">Previous</button>
          <span class="sqv-range" id="sqv-range" aria-live="polite"></span>
          <button class="btn-secondary" id="sqv-next" type="button" data-i18n="next">Next</button>
          <button class="btn-ghost" id="sqv-export-table" type="button" data-i18n="exportCsv">Export CSV</button>
        </div>
        <div class="tool-status none" id="sqv-browse-status" aria-live="polite"></div>
        <div class="sqv-grid-wrap"><table class="sqv-grid" id="sqv-rows"></table></div>
      </section>

      <section class="sqv-card sqv-query">
        <label class="tool-label" for="sqv-sql" data-i18n="sqlLabel">SQL</label>
        <p class="sqv-hint" data-i18n="sqlHint">Runs against an in-memory copy. The file on your disk is never modified; changes vanish on reload.</p>
        <textarea id="sqv-sql" class="tool-textarea sqv-sql" rows="5" spellcheck="false" autocomplete="off"></textarea>
        <div class="sqv-query-actions">
          <button class="btn-primary" id="sqv-run" type="button" data-i18n="run">Run SQL</button>
          <button class="btn-ghost" id="sqv-export-query" type="button" data-i18n="exportCsv" disabled>Export CSV</button>
        </div>
        <div class="tool-status none" id="sqv-query-status" aria-live="polite"></div>
        <div class="sqv-grid-wrap" id="sqv-result-wrap" hidden><table class="sqv-grid" id="sqv-result"></table></div>
      </section>
    </div>
  </div>

  <script is:inline>
    (function () {
      /* ── engine:start ── */
      var MAX_BYTES = 100 * 1024 * 1024;
      var PAGE_SIZE = 100;
      var RESULT_RENDER_CAP = 1000;
      var HEADER = 'SQLite format 3\u0000';

      // A SQLite 3 file starts with a 100-byte header whose first 16 bytes are fixed.
      function isSqliteHeader(bytes) {
        if (!bytes || bytes.length < 100) return false;
        for (var i = 0; i < HEADER.length; i++) {
          if (bytes[i] !== HEADER.charCodeAt(i)) return false;
        }
        return true;
      }

      function quoteIdent(name) {
        return '"' + String(name).replace(/"/g, '""') + '"';
      }

      function toHex(bytes, limit) {
        var n = limit == null ? bytes.length : Math.min(limit, bytes.length);
        var out = '';
        for (var i = 0; i < n; i++) out += (bytes[i] < 16 ? '0' : '') + bytes[i].toString(16).toUpperCase();
        return out;
      }

      // RFC 4180: NULL → empty field, BLOB → full uppercase hex.
      function csvField(v) {
        if (v === null || v === undefined) return '';
        if (v instanceof Uint8Array) return toHex(v);
        var s = String(v);
        return /[",\r\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
      }

      function toCsv(columns, rows) {
        return [columns].concat(rows).map(function (r) { return r.map(csvField).join(','); }).join('\r\n') + '\r\n';
      }

      function pageCount(total) {
        return Math.max(1, Math.ceil(total / PAGE_SIZE));
      }

      function pageSql(name, page) {
        return 'SELECT * FROM ' + quoteIdent(name) + ' LIMIT ' + PAGE_SIZE + ' OFFSET ' + (page * PAGE_SIZE);
      }

      function rowsOf(db, sql, params) {
        var res = db.exec(sql, params);
        return res.length ? res[0].values : [];
      }

      // Tables and views, internal sqlite_* objects hidden. count is null when COUNT(*) fails
      // (e.g. a virtual table whose module is not compiled into sql.js).
      function listObjects(db) {
        return rowsOf(db, "SELECT type, name, sql FROM sqlite_master WHERE type IN ('table', 'view') AND name NOT LIKE 'sqlite\\_%' ESCAPE '\\' ORDER BY type, name COLLATE NOCASE")
          .map(function (r) {
            var count = null;
            if (r[0] === 'table') {
              try { count = rowsOf(db, 'SELECT COUNT(*) FROM ' + quoteIdent(r[1]))[0][0]; } catch (e) { count = null; }
            }
            return { type: r[0], name: r[1], sql: r[2] || '', count: count };
          });
      }

      function describe(db, name) {
        var columns = rowsOf(db, 'SELECT name, type, "notnull", dflt_value, pk FROM pragma_table_info(?)', [name])
          .map(function (r) { return { name: r[0], type: r[1], notnull: !!r[2], dflt: r[3], pk: r[4] }; });
        var indexes = rowsOf(db, 'SELECT name, "unique", origin FROM pragma_index_list(?) ORDER BY name', [name])
          .map(function (r) {
            var cols = rowsOf(db, 'SELECT name FROM pragma_index_info(?) ORDER BY seqno', [r[0]])
              .map(function (c) { return c[0] == null ? '(expr)' : c[0]; });
            return { name: r[0], unique: !!r[1], origin: r[2], columns: cols };
          });
        return { columns: columns, indexes: indexes };
      }

      // Runs every statement; returns the last result set that produced rows,
      // plus how many rows the whole script changed and whether the schema moved.
      function runSql(db, sql) {
        var before = rowsOf(db, 'SELECT total_changes()')[0][0];
        var schemaBefore = rowsOf(db, 'PRAGMA schema_version')[0][0];
        var sets = db.exec(sql);
        return {
          result: sets.length ? sets[sets.length - 1] : null,
          changes: rowsOf(db, 'SELECT total_changes()')[0][0] - before,
          schemaChanged: rowsOf(db, 'PRAGMA schema_version')[0][0] !== schemaBefore,
        };
      }
      /* ── engine:end ── */

      var STRINGS = {
        en: {
          dropTitle: 'Drop a SQLite file here',
          dropHint: '.db · .sqlite · .sqlite3 — up to 100 MB · or click to choose · never uploaded',
          openAnother: 'Open another file',
