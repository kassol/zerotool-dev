          colName: '列名', colType: '类型', colNotNull: '非空', colDefault: '默认值', colPk: '主键',
          idxName: '索引', idxUnique: '唯一', idxColumns: '列', idxOrigin: '来源', yes: '是',
          prev: '上一页', next: '下一页', exportCsv: '导出 CSV',
          rowsRange: '第 {a}–{b} 行，共 {n} 行', noRows: '没有数据行。', pageUnknown: '第 {p} 页',
