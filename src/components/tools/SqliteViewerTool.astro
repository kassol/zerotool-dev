        ja: {
          dropTitle: 'SQLite ファイルをここにドロップ',
          dropHint: '.db · .sqlite · .sqlite3、最大 100 MB · クリックで選択 · アップロードなし',
          openAnother: '別のファイルを開く',
          tables: 'テーブル', views: 'ビュー', noObjects: 'このデータベースにはテーブルもビューもありません。',
          typeTable: 'テーブル', typeView: 'ビュー',
          nTables: 'テーブル {n}', nViews: 'ビュー {n}', nRows: '{n} 行', countUnknown: '行数：—',
          structure: '構造', indexes: 'インデックス', createSql: 'CREATE 文', noIndexes: 'インデックスはありません。',
          colName: '列名', colType: '型', colNotNull: 'NOT NULL', colDefault: 'デフォルト', colPk: 'PK',
          idxName: 'インデックス', idxUnique: '一意', idxColumns: '列', idxOrigin: '由来', yes: 'はい',
          prev: '前へ', next: '次へ', exportCsv: 'CSV エクスポート',
          rowsRange: '{n} 行中 {a}–{b} 行目', noRows: '行がありません。', pageUnknown: '{p} ページ',
          sqlLabel: 'SQL',
          sqlHint: 'メモリ上のコピーに対して実行します。ディスク上の元ファイルは変更されず、再読み込みで変更は消えます。',
          run: 'SQL 実行',
          reading: '{name} を読み込み中…', loadingEngine: 'SQLite エンジンを読み込み中（約 340 KB、初回のみ）…',
          opened: '{name} を開きました：テーブル {t}、ビュー {v}。',
          notSqlite: 'SQLite 3 データベースではありません：ファイル先頭に "SQLite format 3" ヘッダーがありません。暗号化 DB（SQLCipher、SEE）も同様です。sqlcipher で復号するか、DB Browser for SQLite で開いてください。',
          tooBig: 'ファイルサイズ {size}。データベース全体をメモリに載せるため上限は 100 MB です。大きなファイルは sqlite3 CLI か DB Browser for SQLite を使ってください。',
          engineFailed: 'SQLite エンジンを読み込めませんでした。接続を確認して再試行してください。',
