          typeTable: 'table', typeView: 'view',
          nTables: '{n} table(s)', nViews: '{n} view(s)', nRows: '{n} row(s)', countUnknown: 'rows: —',
          structure: 'Structure', indexes: 'Indexes', createSql: 'CREATE statement', noIndexes: 'No indexes.',
          colName: 'Column', colType: 'Type', colNotNull: 'Not null', colDefault: 'Default', colPk: 'PK',
          idxName: 'Index', idxUnique: 'Unique', idxColumns: 'Columns', idxOrigin: 'Origin', yes: 'yes',
          prev: 'Previous', next: 'Next', exportCsv: 'Export CSV',
          rowsRange: 'Rows {a}–{b} of {n}', noRows: 'No rows.', pageUnknown: 'Page {p}',
          sqlLabel: 'SQL',
          sqlHint: 'Runs against an in-memory copy. The file on your disk is never modified; changes vanish on reload.',
          run: 'Run SQL',
          reading: 'Reading {name}…', loadingEngine: 'Loading the SQLite engine (about 340 KB, first file only)…',
          opened: 'Opened {name} — {t} table(s), {v} view(s).',
          notSqlite: 'Not a SQLite 3 database: the file does not start with the "SQLite format 3" header. Encrypted databases (SQLCipher, SEE) look like this too — decrypt them with sqlcipher or open them in DB Browser for SQLite.',
          tooBig: 'File is {size}. The limit is 100 MB because the whole database is held in memory — use the sqlite3 CLI or DB Browser for SQLite for larger files.',
          engineFailed: 'Could not load the SQLite engine. Check your connection and try again.',
          openFailed: 'SQLite could not open this file: {msg}',
          emptySql: 'Type a SQL statement first.',
          queryDone: 'Done. {n} row(s) changed in the in-memory copy.',
          queryRows: '{n} row(s).',
          queryCapped: 'Showing the first {cap} of {n} rows. Export CSV includes all rows.',
          sqlError: 'SQL error: {msg}',
