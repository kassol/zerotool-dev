          dropTitle: 'SQLite 파일을 여기에 드롭',
          dropHint: '.db · .sqlite · .sqlite3, 최대 100 MB · 클릭해서 선택 · 업로드 없음',
          openAnother: '다른 파일 열기',
          tables: '테이블', views: '뷰', noObjects: '이 데이터베이스에는 테이블이나 뷰가 없습니다.',
          typeTable: '테이블', typeView: '뷰',
          nTables: '테이블 {n}개', nViews: '뷰 {n}개', nRows: '{n}행', countUnknown: '행 수: —',
          structure: '구조', indexes: '인덱스', createSql: 'CREATE 문', noIndexes: '인덱스가 없습니다.',
          colName: '컬럼', colType: '타입', colNotNull: 'NOT NULL', colDefault: '기본값', colPk: 'PK',
          idxName: '인덱스', idxUnique: '고유', idxColumns: '컬럼', idxOrigin: '출처', yes: '예',
          prev: '이전', next: '다음', exportCsv: 'CSV 내보내기',
          rowsRange: '전체 {n}행 중 {a}–{b}행', noRows: '행이 없습니다.', pageUnknown: '{p} 페이지',
          sqlLabel: 'SQL',
          sqlHint: '메모리 복사본에서 실행됩니다. 디스크의 원본 파일은 변경되지 않으며, 새로고침하면 변경 내용이 사라집니다.',
          run: 'SQL 실행',
          reading: '{name} 읽는 중…', loadingEngine: 'SQLite 엔진 로딩 중 (약 340 KB, 최초 1회)…',
          opened: '{name} 열림 — 테이블 {t}개, 뷰 {v}개.',
          notSqlite: 'SQLite 3 데이터베이스가 아닙니다. 파일이 "SQLite format 3" 헤더로 시작하지 않습니다. 암호화된 DB(SQLCipher, SEE)도 이렇게 보입니다. sqlcipher로 복호화하거나 DB Browser for SQLite로 여세요.',
          tooBig: '파일 크기 {size}. 데이터베이스 전체를 메모리에 올리므로 최대 100 MB입니다. 더 큰 파일은 sqlite3 CLI나 DB Browser for SQLite를 사용하세요.',
          engineFailed: 'SQLite 엔진을 불러오지 못했습니다. 연결을 확인하고 다시 시도하세요.',
          openFailed: 'SQLite가 이 파일을 열 수 없습니다: {msg}',
          emptySql: '먼저 SQL 문을 입력하세요.',
          queryDone: '완료. 메모리 복사본에서 {n}행이 변경되었습니다.',
          queryRows: '{n}행.',
          queryCapped: '전체 {n}행 중 처음 {cap}행만 표시합니다. CSV 내보내기에는 모든 행이 포함됩니다.',
          sqlError: 'SQL 오류: {msg}',
          exported: '{n}행을 {file}(으)로 내보냈습니다.',
        },
      };

      var pageLang = (document.documentElement.lang || 'en').slice(0, 2);
      var t = STRINGS[pageLang] || STRINGS.en;
      function fmt(key, vars) {
        return t[key].replace(/\{(\w+)\}/g, function (m, k) { return vars && vars[k] != null ? vars[k] : m; });
      }
      function num(n) { return Number(n).toLocaleString(pageLang); }

      document.querySelectorAll('.sqv-shell [data-i18n]').forEach(function (el) {
        var k = el.getAttribute('data-i18n');
        if (t[k]) el.textContent = t[k];
      });

      var dropzone = document.getElementById('sqv-dropzone');
      var fileInput = document.getElementById('sqv-file-input');
      var meta = document.getElementById('sqv-meta');
      var statusEl = document.getElementById('sqv-status');
      var layout = document.getElementById('sqv-layout');
      var objectsEl = document.getElementById('sqv-objects');
      var titleEl = document.getElementById('sqv-object-title');
      var subEl = document.getElementById('sqv-object-sub');
      var columnsEl = document.getElementById('sqv-columns');
      var indexesEl = document.getElementById('sqv-indexes');
      var createEl = document.getElementById('sqv-create');
      var prevBtn = document.getElementById('sqv-prev');
      var nextBtn = document.getElementById('sqv-next');
      var rangeEl = document.getElementById('sqv-range');
      var exportTableBtn = document.getElementById('sqv-export-table');
      var browseStatusEl = document.getElementById('sqv-browse-status');
      var rowsEl = document.getElementById('sqv-rows');
      var sqlEl = document.getElementById('sqv-sql');
      var runBtn = document.getElementById('sqv-run');
      var exportQueryBtn = document.getElementById('sqv-export-query');
      var queryStatusEl = document.getElementById('sqv-query-status');
      var resultWrap = document.getElementById('sqv-result-wrap');
      var resultEl = document.getElementById('sqv-result');

      var db = null;
      var objects = [];
      var current = null;   // { type, name, sql, count }
      var page = 0;
      var lastResult = null; // { columns, values } of the last query

      function setStatus(el, msg, kind) {
        el.textContent = msg || '';
        el.className = 'tool-status ' + (msg ? (kind || 'none') : 'none');
      }
      function escapeHtml(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
      function fmtBytes(n) {
        var u = ['B', 'KB', 'MB', 'GB']; var i = 0;
        while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
        return (i === 0 ? n : n.toFixed(1)) + ' ' + u[i];
      }

      /* ── sql.js lazy loader: only called after a file passes the header check ── */
      var enginePromise = null;
      function ensureEngine() {
        if (enginePromise) return enginePromise;
        enginePromise = new Promise(function (resolve, reject) {
          var s = document.createElement('script');
          s.src = '/sql-js/sql-wasm.js';
          s.onload = function () {
            window.initSqlJs({ locateFile: function (f) { return '/sql-js/' + f; } }).then(resolve, reject);
          };
          s.onerror = function () { reject(new Error('script load failed')); };
          document.head.appendChild(s);
        });
        enginePromise.catch(function () { enginePromise = null; });
        return enginePromise;
      }

      /* ── rendering ── */
      function cellHtml(v) {
        if (v === null || v === undefined) return '<td class="sqv-null">NULL</td>';
        if (v instanceof Uint8Array) {
          var preview = toHex(v, 16) + (v.length > 16 ? '…' : '');
          return '<td class="sqv-blob">BLOB · ' + num(v.length) + ' B' + (v.length ? ' · ' + preview : '') + '</td>';
        }
        if (typeof v === 'number') return '<td class="sqv-num">' + escapeHtml(v) + '</td>';
        var s = String(v);
        var title = s.length > 60 ? ' title="' + escapeHtml(s.slice(0, 2000)) + '"' : '';
        return '<td' + title + '>' + escapeHtml(s) + '</td>';
      }
      function renderGrid(tableEl, columns, values, cap) {
        var head = '<thead><tr>' + columns.map(function (c) { return '<th scope="col">' + escapeHtml(c) + '</th>'; }).join('') + '</tr></thead>';
        var shown = cap ? values.slice(0, cap) : values;
        var body = '<tbody>' + shown.map(function (r) { return '<tr>' + r.map(cellHtml).join('') + '</tr>'; }).join('') + '</tbody>';
        tableEl.innerHTML = head + body;
      }

      function renderObjects() {
        if (!objects.length) {
          objectsEl.innerHTML = '<p class="sqv-empty">' + escapeHtml(t.noObjects) + '</p>';
          return;
        }
        var html = '';
        [['table', t.tables], ['view', t.views]].forEach(function (g) {
          var list = objects.filter(function (o) { return o.type === g[0]; });
          if (!list.length) return;
          html += '<p class="sqv-group">' + escapeHtml(g[1]) + '</p><ul class="sqv-object-list">';
          list.forEach(function (o) {
            var active = current && current.name === o.name;
            html += '<li><button type="button" class="sqv-object' + (active ? ' is-active' : '') + '" data-name="' + escapeHtml(o.name) + '"' + (active ? ' aria-current="true"' : '') + '>'
              + '<span class="sqv-object-name">' + escapeHtml(o.name) + '</span>'
              + (o.type === 'table' ? '<span class="sqv-object-count">' + (o.count == null ? '—' : num(o.count)) + '</span>' : '')
              + '</button></li>';
          });
          html += '</ul>';
        });
        objectsEl.innerHTML = html;
      }

      function renderStructure() {
        var info = describe(db, current.name);
        var head = [t.colName, t.colType, t.colNotNull, t.colDefault, t.colPk];
        renderGrid(columnsEl, head, info.columns.map(function (c) {
          return [c.name, c.type || '', c.notnull ? t.yes : '', c.dflt == null ? '' : c.dflt, c.pk ? c.pk : ''];
        }));
        if (!info.indexes.length) {
          indexesEl.innerHTML = '<p class="sqv-empty">' + escapeHtml(t.noIndexes) + '</p>';
        } else {
          indexesEl.innerHTML = '<div class="sqv-grid-wrap sqv-grid-wrap-sm"><table class="sqv-grid"></table></div>';
          renderGrid(indexesEl.querySelector('table'), [t.idxName, t.idxColumns, t.idxUnique, t.idxOrigin], info.indexes.map(function (i) {
            return [i.name, i.columns.join(', '), i.unique ? t.yes : '', i.origin];
          }));
        }
        createEl.textContent = current.sql;
      }

      function renderPage() {
        setStatus(browseStatusEl, '');
        var total = current.count;
        try {
          var res = db.exec(pageSql(current.name, page));
          var columns = res.length ? res[0].columns : describe(db, current.name).columns.map(function (c) { return c.name; });
          var values = res.length ? res[0].values : [];
          renderGrid(rowsEl, columns, values);
          if (total == null) {
            rangeEl.textContent = fmt('pageUnknown', { p: num(page + 1) });
          } else if (total === 0) {
            rangeEl.textContent = t.noRows;
          } else {
            rangeEl.textContent = fmt('rowsRange', { a: num(page * PAGE_SIZE + 1), b: num(page * PAGE_SIZE + values.length), n: num(total) });
          }
          prevBtn.disabled = page === 0;
          nextBtn.disabled = total == null ? values.length < PAGE_SIZE : page >= pageCount(total) - 1;
        } catch (e) {
          rowsEl.innerHTML = '';
          rangeEl.textContent = '';
          prevBtn.disabled = nextBtn.disabled = true;
          setStatus(browseStatusEl, fmt('sqlError', { msg: e.message || String(e) }), 'error');
        }
      }

      function selectObject(name) {
        current = objects.filter(function (o) { return o.name === name; })[0] || null;
        page = 0;
        renderObjects();
        if (!current) {
          titleEl.textContent = '—';
          subEl.textContent = '';
          columnsEl.innerHTML = rowsEl.innerHTML = indexesEl.innerHTML = createEl.textContent = rangeEl.textContent = '';
          prevBtn.disabled = nextBtn.disabled = exportTableBtn.disabled = true;
          return;
        }
        exportTableBtn.disabled = false;
        titleEl.textContent = current.name;
        subEl.textContent = (current.type === 'table' ? t.typeTable : t.typeView)
          + (current.type === 'table' ? ' · ' + (current.count == null ? t.countUnknown : fmt('nRows', { n: num(current.count) })) : '');
        renderStructure();
        renderPage();
      }

      function loadObjects(keepName) {
        objects = listObjects(db);
        document.getElementById('sqv-meta-tables').textContent = fmt('nTables', { n: objects.filter(function (o) { return o.type === 'table'; }).length });
        document.getElementById('sqv-meta-views').textContent = fmt('nViews', { n: objects.filter(function (o) { return o.type === 'view'; }).length });
        var keep = keepName && objects.some(function (o) { return o.name === keepName; });
        selectObject(keep ? keepName : (objects[0] ? objects[0].name : null));
      }

      /* ── file open ── */
      function openFile(file) {
        if (!file) return;
        if (file.size > MAX_BYTES) {
          setStatus(statusEl, fmt('tooBig', { size: fmtBytes(file.size) }), 'error');
          return;
        }
        setStatus(statusEl, fmt('reading', { name: file.name }), 'info');
        file.slice(0, 100).arrayBuffer().then(function (head) {
          if (!isSqliteHeader(new Uint8Array(head))) {
            setStatus(statusEl, t.notSqlite, 'error');
            return;
          }
          if (!enginePromise) setStatus(statusEl, t.loadingEngine, 'info');
          return Promise.all([ensureEngine(), file.arrayBuffer()]).then(function (res) {
            var next;
            try {
              next = new res[0].Database(new Uint8Array(res[1]));
              next.exec('SELECT COUNT(*) FROM sqlite_master');
            } catch (e) {
              if (next) next.close();
              setStatus(statusEl, fmt('openFailed', { msg: e.message || String(e) }), 'error');
              return;
            }
            if (db) db.close();
            db = next;
            showDatabase(file);
          }, function () {
            setStatus(statusEl, t.engineFailed, 'error');
          });
        });
      }

      function showDatabase(file) {
        var nameEl = document.getElementById('sqv-meta-name');
        nameEl.textContent = file.name;
        nameEl.setAttribute('title', file.name);
        document.getElementById('sqv-meta-size').textContent = fmtBytes(file.size);
        lastResult = null;
        exportQueryBtn.disabled = true;
        resultWrap.hidden = true;
        resultEl.innerHTML = '';
        setStatus(queryStatusEl, '');
        loadObjects(null);
        if (!sqlEl.value.trim() && current) sqlEl.value = 'SELECT * FROM ' + quoteIdent(current.name) + ' LIMIT 100;';
        dropzone.hidden = true;
        meta.hidden = false;
        layout.hidden = false;
        var tables = objects.filter(function (o) { return o.type === 'table'; }).length;
        setStatus(statusEl, fmt('opened', { name: file.name, t: tables, v: objects.length - tables }), 'success');
        if (window.trackTool) window.trackTool('sqlite-viewer', 'open');
      }

      /* ── SQL ── */
      function runQuery() {
        if (!db) return;
        var sql = sqlEl.value.trim();
        if (!sql) { setStatus(queryStatusEl, t.emptySql, 'error'); return; }
        lastResult = null;
        exportQueryBtn.disabled = true;
        resultWrap.hidden = true;
        resultEl.innerHTML = '';
        var out;
        try {
          out = runSql(db, sql);
        } catch (e) {
          setStatus(queryStatusEl, fmt('sqlError', { msg: e.message || String(e) }), 'error');
          return;
        }
        if (out.result) {
          lastResult = out.result;
          var n = out.result.values.length;
          renderGrid(resultEl, out.result.columns, out.result.values, RESULT_RENDER_CAP);
          resultWrap.hidden = false;
          exportQueryBtn.disabled = false;
          setStatus(queryStatusEl, n > RESULT_RENDER_CAP ? fmt('queryCapped', { cap: num(RESULT_RENDER_CAP), n: num(n) }) : fmt('queryRows', { n: num(n) }), 'success');
        } else {
          setStatus(queryStatusEl, fmt('queryDone', { n: num(out.changes) }), 'success');
        }
        if (out.changes > 0 || out.schemaChanged) loadObjects(current && current.name);
        if (window.trackTool) window.trackTool('sqlite-viewer', 'query');
      }

      /* ── CSV export ── */
      function download(name, columns, values) {
        var file = name.replace(/[^\w.-]+/g, '_') + '.csv';
        var blob = new Blob([toCsv(columns, values)], { type: 'text/csv;charset=utf-8' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = file;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
        if (window.trackTool) window.trackTool('sqlite-viewer', 'export_csv');
        return file;
      }

      exportTableBtn.addEventListener('click', function () {
        if (!db || !current) return;
        try {
          var res = db.exec('SELECT * FROM ' + quoteIdent(current.name));
          var columns = res.length ? res[0].columns : describe(db, current.name).columns.map(function (c) { return c.name; });
          var values = res.length ? res[0].values : [];
          var file = download(current.name, columns, values);
          setStatus(browseStatusEl, fmt('exported', { n: num(values.length), file: file }), 'success');
        } catch (e) {
          setStatus(browseStatusEl, fmt('sqlError', { msg: e.message || String(e) }), 'error');
        }
      });
      exportQueryBtn.addEventListener('click', function () {
        if (!lastResult) return;
        var file = download('query', lastResult.columns, lastResult.values);
        setStatus(queryStatusEl, fmt('exported', { n: num(lastResult.values.length), file: file }), 'success');
      });

      /* ── events ── */
      objectsEl.addEventListener('click', function (e) {
        var btn = e.target.closest('.sqv-object');
        if (btn) selectObject(btn.getAttribute('data-name'));
      });
      prevBtn.addEventListener('click', function () { if (page > 0) { page--; renderPage(); } });
      nextBtn.addEventListener('click', function () { page++; renderPage(); });
      runBtn.addEventListener('click', runQuery);

      function openPicker() { fileInput.click(); }
      dropzone.addEventListener('click', openPicker);
      dropzone.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openPicker(); }
      });
      fileInput.addEventListener('change', function () {
        if (fileInput.files && fileInput.files[0]) openFile(fileInput.files[0]);
        fileInput.value = '';
      });
      ['dragenter', 'dragover'].forEach(function (ev) {
        dropzone.addEventListener(ev, function (e) {
          e.preventDefault();
          dropzone.classList.add('is-dragover');
        });
      });
      ['dragleave', 'drop'].forEach(function (ev) {
        dropzone.addEventListener(ev, function (e) {
          e.preventDefault();
          if (ev === 'dragleave' && e.target !== dropzone) return;
          dropzone.classList.remove('is-dragover');
        });
      });
      dropzone.addEventListener('drop', function (e) {
        var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
        if (f) openFile(f);
      });

      document.getElementById('sqv-reset').addEventListener('click', function () {
        if (db) db.close();
        db = null; objects = []; current = null; lastResult = null;
        sqlEl.value = '';
        rowsEl.innerHTML = resultEl.innerHTML = columnsEl.innerHTML = indexesEl.innerHTML = objectsEl.innerHTML = '';
        resultWrap.hidden = true;
        setStatus(queryStatusEl, '');
        setStatus(browseStatusEl, '');
        setStatus(statusEl, '');
        layout.hidden = true;
        meta.hidden = true;
        dropzone.hidden = false;
        dropzone.focus();
      });
    })();
  </script>
</div>

<style is:global>
  .sqv-shell { display: flex; flex-direction: column; gap: 0.85rem; }

  .sqv-dropzone {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0.4rem; min-height: 200px; padding: 2.5rem 1rem; text-align: center;
    border-radius: var(--radius-lg);
    background: var(--color-surface-muted);
    outline: 1px dashed var(--color-border);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background var(--transition-fast), outline-color var(--transition-fast);
  }
  .sqv-dropzone[hidden] { display: none; }
  .sqv-dropzone:hover, .sqv-dropzone:focus-visible, .sqv-dropzone.is-dragover {
    background: color-mix(in oklch, var(--color-primary) 6%, var(--color-surface-muted));
    outline-color: var(--color-primary);
    outline-style: solid;
    color: var(--color-text);
  }
  .sqv-dropzone-icon { color: var(--color-cat-data); }
  .sqv-dropzone-title { margin: 0; font-size: 1rem; font-weight: 650; }
  .sqv-dropzone-hint { margin: 0; font-size: 0.82rem; color: var(--color-text-muted); }

  .sqv-meta:not([hidden]) {
    display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center;
    padding: 0.4rem 0.55rem; border-radius: var(--radius-md);
    background: var(--color-surface);
    outline: 1px solid var(--color-border-soft);
    outline-offset: -1px;
  }
  .sqv-pill {
    display: inline-flex; align-items: center;
    padding: 0.2rem 0.6rem; border-radius: var(--radius-pill);
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    font-family: var(--font-mono); font-size: 0.78rem;
    white-space: nowrap;
  }
  .sqv-pill-name { max-width: 28ch; overflow: hidden; text-overflow: ellipsis; }
  .sqv-reset { margin-left: auto; }

  .sqv-layout:not([hidden]) {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
  }
  .sqv-query { grid-column: 1 / -1; }

  .sqv-card {
    display: flex; flex-direction: column; gap: 0.6rem;
    padding: 0.9rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    outline: 1px solid var(--color-border-soft);
    outline-offset: -1px;
  }

  .sqv-objects {
    max-height: 560px; overflow: auto;
    padding: 0.6rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }
  .sqv-group {
    margin: 0.35rem 0.4rem 0.3rem;
    font-size: 0.72rem; font-weight: 750; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .sqv-object-list { list-style: none; margin: 0 0 0.4rem; padding: 0; }
  .sqv-object {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    width: 100%; min-height: 34px; padding: 0.35rem 0.55rem;
    border: 0; border-radius: var(--radius-md);
    background: none; color: var(--color-text);
    font-family: var(--font-mono); font-size: 0.82rem; text-align: left;
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  @media (hover: hover) {
    .sqv-object:hover { background: var(--color-surface-muted); color: var(--color-primary); }
  }
  .sqv-object:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -2px; }
  .sqv-object.is-active {
    background: color-mix(in oklch, var(--color-cat-data) 14%, var(--color-surface));
    color: var(--color-text);
    font-weight: 700;
  }
  .sqv-object-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sqv-object-count { flex-shrink: 0; font-size: 0.74rem; color: var(--color-text-muted); }

  .sqv-browse-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.7rem; }
  .sqv-object-title {
    margin: 0; font-family: var(--font-mono); font-size: 1.05rem; font-weight: 700;
    overflow-wrap: anywhere;
  }
  .sqv-object-sub { font-size: 0.82rem; color: var(--color-text-muted); }

  .sqv-structure summary {
    cursor: pointer; font-size: 0.85rem; font-weight: 700; color: var(--color-text-secondary);
    padding: 0.2rem 0;
  }
  .sqv-structure[open] summary { margin-bottom: 0.5rem; }
  .sqv-subhead { margin: 0.7rem 0 0.35rem; font-size: 0.8rem; font-weight: 700; color: var(--color-text-secondary); }
  .sqv-create {
    margin: 0; padding: 0.75rem 0.9rem; max-height: 220px;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
    font-family: var(--font-mono); font-size: 0.8rem;
  }
  .sqv-create code { background: transparent; color: var(--color-text); }

  .sqv-pager-actions, .sqv-query-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .sqv-range { font-size: 0.85rem; color: var(--color-text-secondary); font-variant-numeric: tabular-nums; }
  .sqv-pager-actions .btn-ghost { margin-left: auto; }

  .sqv-grid-wrap {
    max-height: 480px; overflow: auto;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }
  .sqv-grid-wrap[hidden] { display: none; }
  .sqv-grid-wrap-sm { max-height: 280px; }
  .tool-page .sqv-grid {
    width: max-content; min-width: 100%; margin: 0;
    border-collapse: separate; border-spacing: 0;
    font-family: var(--font-mono); font-size: 0.8rem;
  }
  .tool-page .sqv-grid th,
  .tool-page .sqv-grid td {
    max-width: 36ch; padding: 0.38rem 0.7rem;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    border-bottom: 1px solid var(--color-border-soft);
    text-align: left; vertical-align: top;
  }
  .tool-page .sqv-grid th {
    position: sticky; top: 0; z-index: 1;
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    font-family: var(--font-sans); font-weight: 700;
  }
  .tool-page .sqv-grid td.sqv-num { text-align: right; font-variant-numeric: tabular-nums; }
  .tool-page .sqv-grid td.sqv-null { color: var(--color-text-muted); font-style: italic; }
  .tool-page .sqv-grid td.sqv-blob { color: var(--color-accent); }

  .sqv-hint { margin: 0; font-size: 0.82rem; color: var(--color-text-muted); }
  .sqv-sql { min-height: 120px; }
  .sqv-empty { margin: 0.3rem 0.4rem; font-size: 0.85rem; color: var(--color-text-muted); }

  @media (max-width: 720px) {
    .sqv-layout:not([hidden]) { grid-template-columns: minmax(0, 1fr); }
    .sqv-objects { max-height: 220px; }
    .sqv-object { min-height: 44px; }
    .sqv-reset { margin-left: 0; }
    .sqv-pager-actions .btn-ghost { margin-left: 0; }
  }
</style>
