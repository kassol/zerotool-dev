      /* ── WCAG 2.2 contrast ── */
      /* WCAG relative luminance + contrast ratio, so the chosen text color
         always reaches the >=4.5:1 requirement (a perceived-brightness
         threshold like 0.299r+0.587g+0.114b can pick white on saturated
         mid-tone backgrounds, e.g. #3b82f6, which fails contrast). */
      function relativeLuminance(r, g, b) {
        var lin = [r, g, b].map(function (c) {
