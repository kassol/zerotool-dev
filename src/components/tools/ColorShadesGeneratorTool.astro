        statusEl.className = 'tool-status csg-status' + (scale.collapsed.length ? ' error' : '');
        statusEl.textContent = msgs.join(' ');

        renderScale(scale, name, valueFormat);
        codeEl.textContent = buildExport(scale, name, format, valueFormat);
        copyBtn.disabled = false;
        downloadBtn.disabled = false;
        var notes = [];
        if (name !== String(nameEl.value).trim()) notes.push(fill(S.noteName, { name: name }));
        if (format === 'tw3' && valueFormat === 'oklch') notes.push(fill(S.noteTw3Oklch, { name: name }));
        noteEl.textContent = notes.join(' ');
        if (!tracked) { tracked = true; } else if (window.trackTool) { window.trackTool(SLUG, 'generate'); }
      }

      inputEl.addEventListener('input', update);
      pickerEl.addEventListener('input', function () {
        inputEl.value = pickerEl.value;
        update();
      });
      [anchorEl, formatEl, valuesEl].forEach(function (el) { el.addEventListener('change', update); });
      [hueLightEl, hueDarkEl, nameEl].forEach(function (el) { el.addEventListener('input', update); });

      copyBtn.addEventListener('click', function () {
        if (!codeEl.textContent) return;
        copyText(codeEl.textContent).then(function () {
          copyBtn.textContent = S.copied;
          setTimeout(function () { copyBtn.textContent = S.copy; }, 1500);
          window.trackTool && window.trackTool(SLUG, 'copy_all');
