---
import Toggletip from '../Toggletip.astro';
// ColorShadesGeneratorTool — builds a 50–950 shade scale from one base color in OKLCH.
// The engine block (between engine:start / engine:end) is tested by
// scripts/test-color-shades-generator.mjs, together with the STRINGS table below.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
