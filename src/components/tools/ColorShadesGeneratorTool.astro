      function exportFileName(name, format) {
        var nm = sanitizeName(name);
        if (format === 'tw4') return nm + '-theme.css';
        if (format === 'tw3') return 'tailwind.config.js';
        if (format === 'scss') return '_' + nm + '.scss';
        if (format === 'json') return nm + '.json';
