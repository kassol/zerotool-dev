      /* ── engine:end ── */
      /* ── UI ── */
      var SLUG = 'color-shades-generator';
      var inputEl = document.getElementById('csg-input');
      var pickerEl = document.getElementById('csg-picker');
      var anchorEl = document.getElementById('csg-anchor');
      var hueLightEl = document.getElementById('csg-hue-light');
      var hueDarkEl = document.getElementById('csg-hue-dark');
      var statusEl = document.getElementById('csg-status');
      var scaleEl = document.getElementById('csg-scale');
      var formatEl = document.getElementById('csg-format');
      var valuesEl = document.getElementById('csg-values');
      var nameEl = document.getElementById('csg-name');
      var copyBtn = document.getElementById('csg-copy');
      var downloadBtn = document.getElementById('csg-download');
      var noteEl = document.getElementById('csg-export-note');
      var scaleNoteEl = document.getElementById('csg-scale-note');
      var codeEl = document.getElementById('csg-code');
      var current = null;
      var tracked = false;

      function fill(tpl, vars) {
        return tpl.replace(/\{(\w+)\}/g, function (m, k) { return k in vars ? String(vars[k]) : m; });
