      function buildExport(scale, name, format, valueFormat) {
        var nm = sanitizeName(name);
        var vals = scale.steps.map(function (s) { return { step: s.step, v: formatColor(s.rgb, valueFormat) }; });
        var baseNote = 'base: ' + nm + '-' + scale.anchorStep;
        if (format === 'tw4') {
          return '@theme {\n  /* ' + baseNote + ' */\n' + vals.map(function (x) { return '  --color-' + nm + '-' + x.step + ': ' + x.v + ';'; }).join('\n') + '\n}\n';
        }
        if (format === 'tw3') {
          return '/** @type {import(\'tailwindcss\').Config} */\nmodule.exports = {\n  theme: {\n    extend: {\n      colors: {\n        // ' + baseNote + '\n        \'' + nm + '\': {\n' +
            vals.map(function (x) { return '          ' + x.step + ': \'' + x.v + '\','; }).join('\n') +
            '\n        },\n      },\n    },\n  },\n};\n';
        }
        if (format === 'scss') {
          return '// ' + baseNote + '\n' + vals.map(function (x) { return '$' + nm + '-' + x.step + ': ' + x.v + ';'; }).join('\n') +
            '\n\n$' + nm + ': (\n' + vals.map(function (x) { return '  ' + x.step + ': $' + nm + '-' + x.step; }).join(',\n') + '\n);\n';
