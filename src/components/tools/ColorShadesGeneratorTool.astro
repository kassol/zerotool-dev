          okEl.className = 'csg-meta';
          okEl.textContent = formatColor(s.rgb, 'oklch');
          info.appendChild(okEl);
          var crEl = document.createElement('span');
          crEl.className = 'csg-contrast';
          [[S.onWhite, cr.white, cr.whiteGrade], [S.onBlack, cr.black, cr.blackGrade]].forEach(function (row) {
