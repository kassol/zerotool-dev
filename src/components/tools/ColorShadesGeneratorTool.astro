};

const L = STRINGS[lang] ?? STRINGS.en;
const STEP_LIST = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
const FORMAT_LIST = ['css', 'tw4', 'tw3', 'scss', 'json'] as const;
const VALUE_LIST = ['hex', 'oklch', 'rgb', 'hsl'] as const;
---

<div class="csg-wrap">
  <div class="csg-controls">
    <div class="csg-field csg-field-color">
      <label class="tool-label" for="csg-input">{L.baseColor}</label>
      <div class="csg-color-row">
        <input id="csg-picker" class="csg-picker" type="color" value="#3b82f6" aria-label={L.picker} />
        <input
          id="csg-input"
          class="tool-input csg-input"
          type="text"
          value="#3b82f6"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          aria-describedby="csg-input-hint csg-status"
        />
      </div>
      <span id="csg-input-hint" class="csg-hint">{L.inputHint}</span>
    </div>
    <div class="csg-field csg-field-anchor">
      <label class="tool-label" for="csg-anchor">{L.position}</label>
      <select id="csg-anchor" class="tool-input csg-select">
        <option value="auto">{L.auto}</option>
        {STEP_LIST.map((s) => <option value={String(s)}>{L.stepOption.replace('{step}', String(s))}</option>)}
      </select>
    </div>
    <details class="csg-more">
      <summary>{L.hueShift}</summary>
      <div class="csg-more-body">
        <label class="csg-num"><span>{L.hueLight}</span><input id="csg-hue-light" class="tool-input" type="number" min="-180" max="180" step="1" value="0" inputmode="numeric" /></label>
        <label class="csg-num"><span>{L.hueDark}</span><input id="csg-hue-dark" class="tool-input" type="number" min="-180" max="180" step="1" value="0" inputmode="numeric" /></label>
        <p class="csg-hint">{L.hueHelp}</p>
      </div>
    </details>
  </div>

  <p id="csg-status" class="tool-status csg-status" role="status" aria-live="polite"></p>

  <ol id="csg-scale" class="csg-scale" aria-label={L.scaleLabel}></ol>
  <p class="csg-hint csg-copy-hint"><span>{L.copyHint}</span> <span id="csg-scale-note"></span></p>

  <section class="csg-export" aria-labelledby="csg-export-title">
    <div class="csg-export-bar">
      <label class="csg-field">
        <span id="csg-export-title" class="tool-label">{L.exportLabel}</span>
        <select id="csg-format" class="tool-input csg-select">
          {FORMAT_LIST.map((f) => <option value={f}>{L.formats[f]}</option>)}
        </select>
      </label>
      <label class="csg-field">
        <span class="tool-label">{L.valuesLabel}</span>
        <select id="csg-values" class="tool-input csg-select">
          {VALUE_LIST.map((v) => <option value={v}>{L.values[v]}</option>)}
        </select>
      </label>
      <label class="csg-field">
        <span class="tool-label">{L.nameLabel}</span>
        <input id="csg-name" class="tool-input csg-name" type="text" value="brand" spellcheck="false" autocomplete="off" autocapitalize="off" />
      </label>
      <div class="csg-export-actions">
        <button id="csg-copy" class="btn-copy" type="button">{L.copy}</button>
        <button id="csg-download" class="btn-secondary" type="button">{L.download}</button>
      </div>
    </div>
    <p id="csg-export-note" class="csg-hint csg-export-note" aria-live="polite"></p>
    <pre class="csg-code"><code id="csg-code"></code></pre>
  </section>

  <script is:inline define:vars={{ S: L }}>
    (function () {
      /* ── engine:start ── */
      /* Reference curves taken from the Tailwind CSS v4.3.3 default palette
         (node_modules/tailwindcss/theme.css, values rounded to 3 decimals).
         scripts/test-color-shades-generator.mjs recomputes them from that file. */
      var STEPS = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
      /* [OKLCH hue of the 500 step, lightness per step, chroma per step / the
         palette's peak chroma] for the 17 chromatic palettes, sorted by hue. */
      var TW_CHROMATIC = [
        [16.439, [0.969, 0.941, 0.892, 0.81, 0.712, 0.645, 0.586, 0.514, 0.455, 0.41, 0.271], [0.059, 0.119, 0.229, 0.462, 0.767, 0.972, 1, 0.877, 0.743, 0.628, 0.415]], // rose
        [25.331, [0.971, 0.936, 0.885, 0.808, 0.704, 0.637, 0.577, 0.505, 0.444, 0.396, 0.258], [0.053, 0.131, 0.253, 0.465, 0.78, 0.967, 1, 0.869, 0.722, 0.576, 0.376]], // red
        [47.604, [0.98, 0.954, 0.901, 0.837, 0.75, 0.705, 0.646, 0.553, 0.47, 0.408, 0.266], [0.072, 0.171, 0.342, 0.577, 0.824, 0.959, 1, 0.878, 0.707, 0.554, 0.356]], // orange
        [70.08, [0.987, 0.962, 0.924, 0.879, 0.828, 0.769, 0.666, 0.555, 0.473, 0.414, 0.279], [0.116, 0.312, 0.635, 0.894, 1, 0.995, 0.947, 0.862, 0.725, 0.593, 0.407]], // amber
        [86.047, [0.987, 0.973, 0.945, 0.905, 0.852, 0.795, 0.681, 0.554, 0.476, 0.421, 0.286], [0.131, 0.357, 0.648, 0.915, 1, 0.925, 0.814, 0.678, 0.573, 0.477, 0.332]], // yellow
        [130.85, [0.986, 0.967, 0.938, 0.897, 0.841, 0.768, 0.648, 0.532, 0.453, 0.405, 0.274], [0.13, 0.282, 0.534, 0.824, 1, 0.979, 0.84, 0.66, 0.521, 0.424, 0.303]], // lime
        [149.579, [0.982, 0.962, 0.925, 0.871, 0.792, 0.723, 0.627, 0.527, 0.448, 0.393, 0.266], [0.082, 0.201, 0.384, 0.685, 0.954, 1, 0.886, 0.703, 0.543, 0.434, 0.297]], // green
        [162.48, [0.979, 0.95, 0.905, 0.845, 0.765, 0.696, 0.596, 0.508, 0.432, 0.378, 0.262], [0.119, 0.294, 0.525, 0.808, 1, 0.96, 0.819, 0.667, 0.537, 0.435, 0.288]], // emerald
        [182.503, [0.984, 0.953, 0.91, 0.855, 0.777, 0.704, 0.6, 0.511, 0.437, 0.386, 0.277], [0.092, 0.336, 0.632, 0.908, 1, 0.921, 0.776, 0.632, 0.513, 0.414, 0.303]], // teal
        [215.221, [0.984, 0.956, 0.917, 0.865, 0.789, 0.715, 0.609, 0.52, 0.45, 0.398, 0.302], [0.123, 0.292, 0.519, 0.825, 1, 0.929, 0.818, 0.682, 0.552, 0.455, 0.364]], // cyan
        [237.323, [0.977, 0.951, 0.901, 0.828, 0.746, 0.685, 0.588, 0.5, 0.443, 0.391, 0.293], [0.077, 0.154, 0.343, 0.657, 0.947, 1, 0.935, 0.793, 0.651, 0.533, 0.391]], // sky
        [259.815, [0.97, 0.932, 0.882, 0.809, 0.707, 0.623, 0.546, 0.488, 0.424, 0.379, 0.282], [0.057, 0.131, 0.241, 0.429, 0.673, 0.873, 1, 0.992, 0.812, 0.596, 0.371]], // blue
        [277.117, [0.962, 0.93, 0.87, 0.785, 0.673, 0.585, 0.511, 0.457, 0.398, 0.359, 0.257], [0.069, 0.13, 0.248, 0.439, 0.695, 0.889, 1, 0.916, 0.744, 0.55, 0.344]], // indigo
        [292.717, [0.969, 0.943, 0.894, 0.811, 0.702, 0.606, 0.541, 0.491, 0.432, 0.38, 0.283], [0.057, 0.103, 0.203, 0.395, 0.651, 0.89, 1, 0.961, 0.826, 0.673, 0.502]], // violet
        [303.9, [0.977, 0.946, 0.902, 0.827, 0.714, 0.627, 0.558, 0.496, 0.438, 0.381, 0.291], [0.049, 0.115, 0.219, 0.413, 0.705, 0.92, 1, 0.92, 0.757, 0.611, 0.517]], // purple
        [322.15, [0.977, 0.952, 0.903, 0.833, 0.74, 0.667, 0.591, 0.518, 0.452, 0.401, 0.293], [0.058, 0.125, 0.258, 0.492, 0.807, 1, 0.993, 0.858, 0.715, 0.576, 0.461]], // fuchsia
        [354.308, [0.971, 0.948, 0.899, 0.823, 0.718, 0.656, 0.592, 0.525, 0.459, 0.408, 0.284], [0.056, 0.112, 0.245, 0.482, 0.811, 0.968, 1, 0.896, 0.751, 0.614, 0.438]] // pink
      ];
      /* Per-step medians of the 9 neutral palettes (slate, gray, zinc, neutral,
         stone, mauve, olive, mist, taupe); the profile skips neutral (chroma 0). */
      var LADDER_NEUTRAL = [0.985, 0.967, 0.923, 0.87, 0.709, 0.553, 0.444, 0.372, 0.274, 0.212, 0.145];
      var PROFILE_NEUTRAL = [0.071, 0.092, 0.233, 0.353, 0.672, 1, 0.85, 0.767, 0.531, 0.445, 0.265];
      /* Estimated peak chroma (base chroma / profile at the base step) at or below
         NEUTRAL_MAX uses the neutral curves, at or above CHROMATIC_MIN the chromatic
         curves for the hue, linear blend in between. For the sRGB versions of
         Tailwind's 500 colors the estimate is 0.052 or less for the neutral palettes
         (slate) and 0.136 or more for the chromatic ones (cyan). */
      var NEUTRAL_MAX = 0.06;
      var CHROMATIC_MIN = 0.12;
      var ACHROMATIC_EPS = 1e-4;

      /* ── sRGB <-> OKLab (Björn Ottosson's matrices, as in CSS Color 4 §19) ── */
      function toLinear(c) {
        c /= 255;
        return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
      }
      function fromLinear(c) {
        return c <= 0.0031308 ? 12.92 * c : 1.055 * Math.pow(c, 1 / 2.4) - 0.055;
      }
      function linearToOklab(r, g, b) {
