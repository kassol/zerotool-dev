const L = STRINGS[lang] ?? STRINGS.en;
const { tips: TIPS, settings, codeLabel, empty, ...CLIENT_L } = L;
const STEP_LIST = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
const FORMAT_LIST = ['css', 'tw4', 'tw3', 'scss', 'json'] as const;
const VALUE_LIST = ['hex', 'oklch', 'rgb', 'hsl'] as const;
---

<div class="csg-wrap">
  <div class="csg-layout">
    <div class="csg-rail zt-rail">
      <div class="csg-primary">
        <div class="csg-field csg-field-color">
          <div class="csg-label-row"><label class="tool-label" for="csg-input">{L.baseColor}</label><Toggletip id="csg-tip-input" lang={lang} about={L.baseColor}>{TIPS.input}</Toggletip></div>
          <div class="csg-color-row">
            <input id="csg-picker" class="csg-picker" type="color" value="#3b82f6" aria-label={L.picker} />
            <input id="csg-input" class="tool-input csg-input" type="text" value="#3b82f6" spellcheck="false" autocomplete="off" autocapitalize="off" aria-describedby="csg-input-hint csg-status" />
          </div>
          <span id="csg-input-hint" class="csg-hint">{L.inputHint}</span>
        </div>
        <div class="csg-field csg-field-anchor">
          <div class="csg-label-row"><label class="tool-label" for="csg-anchor">{L.position}</label><Toggletip id="csg-tip-position" lang={lang} about={L.position}>{TIPS.position}</Toggletip></div>
          <select id="csg-anchor" class="tool-input csg-select">
            <option value="auto">{L.auto}</option>
            {STEP_LIST.map((s) => <option value={String(s)}>{L.stepOption.replace('{step}', String(s))}</option>)}
          </select>
        </div>
        <div class="csg-export-actions">
          <button id="csg-copy" class="btn-copy" type="button">{L.copy}</button>
          <button id="csg-download" class="btn-secondary" type="button">{L.download}</button>
          <Toggletip id="csg-tip-code" lang={lang} about={L.codeLabel}>{TIPS.code}</Toggletip>
        </div>
      </div>
      <div class="csg-secondary">
        <details class="csg-more">
          <summary>{L.hueShift}</summary>
          <div class="csg-more-body">
            <div class="csg-label-row"><span class="tool-label">{L.hueShift}</span><Toggletip id="csg-tip-hue" lang={lang} about={L.hueShift}>{TIPS.hue}</Toggletip></div>
            <label class="csg-num"><span>{L.hueLight}</span><input id="csg-hue-light" class="tool-input" type="number" min="-180" max="180" step="1" value="0" inputmode="numeric" /></label>
            <label class="csg-num"><span>{L.hueDark}</span><input id="csg-hue-dark" class="tool-input" type="number" min="-180" max="180" step="1" value="0" inputmode="numeric" /></label>
            <p class="csg-hint">{L.hueHelp}</p>
          </div>
        </details>
        <details class="csg-export" aria-labelledby="csg-export-title">
          <summary id="csg-export-title">{L.settings}</summary>
          <div class="csg-export-bar">
            <div class="csg-field">
              <div class="csg-label-row"><label for="csg-format" class="tool-label">{L.exportLabel}</label><Toggletip id="csg-tip-format" lang={lang} about={L.exportLabel}>{TIPS.format}</Toggletip></div>
              <select id="csg-format" class="tool-input csg-select">{FORMAT_LIST.map((f) => <option value={f}>{L.formats[f]}</option>)}</select>
            </div>
            <div class="csg-field">
              <div class="csg-label-row"><label for="csg-values" class="tool-label">{L.valuesLabel}</label><Toggletip id="csg-tip-value" lang={lang} about={L.valuesLabel}>{TIPS.value}</Toggletip></div>
              <select id="csg-values" class="tool-input csg-select">{VALUE_LIST.map((v) => <option value={v}>{L.values[v]}</option>)}</select>
            </div>
            <div class="csg-field">
              <div class="csg-label-row"><label for="csg-name" class="tool-label">{L.nameLabel}</label><Toggletip id="csg-tip-name" lang={lang} about={L.nameLabel}>{TIPS.name}</Toggletip></div>
              <input id="csg-name" class="tool-input csg-name" type="text" value="brand" spellcheck="false" autocomplete="off" autocapitalize="off" />
            </div>
          </div>
          <p id="csg-export-note" class="csg-hint"></p>
