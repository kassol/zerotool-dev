    baseColor: '기본 색상',
    picker: '기본 색상 선택',
    inputHint: 'HEX, rgb(), hsl(), oklch()',
    position: '기본 색상 위치',
    auto: '자동',
    stepOption: '{step}',
    hueShift: '색조 이동',
