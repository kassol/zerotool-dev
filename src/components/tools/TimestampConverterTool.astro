---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  "en": {
    "unit": "Unit",
    "unitAuto": "Auto unit",
    "unitS": "Seconds",
    "unitMs": "Milliseconds",
    "unitUs": "Microseconds",
    "unitNs": "Nanoseconds",
    "readAs": "Read as {unit} ({n} digits). Choose the unit if this is wrong.",
    "tsToDate": "Timestamp → Date",
    "dateToTs": "Date → Timestamp",
    "convert": "Convert",
    "now": "Now",
    "copy": "Copy",
    "copied": "Copied!",
    "copyFail": "Copy failed. Please copy the value manually.",
    "errNum": "Invalid timestamp. Enter digits with an optional sign and decimal point. For a date, use Date → Timestamp.",
    "errRange": "Timestamp out of range.",
    "errDate": "Invalid date.",
    "timestamp": "Unix timestamp",
    "dateTime": "Local date and time",
    "placeholder": "e.g. 1712160000",
    "tips": {
      "input": "Enter decimal digits with an optional sign and fraction. Spaces around the value are ignored, and full-width digits, signs and decimal points are read as ASCII. Exponents, hexadecimal and thousands separators are rejected. Dates must fall within ±8,640,000,000,000,000 milliseconds of the epoch.",
      "unit": "Auto unit counts integer digits: up to 12 means seconds, 13–15 milliseconds, 16–18 microseconds, and 19 or more nanoseconds. Choose a unit to override this. Sub-millisecond digits are discarded. Changing the unit converts nonempty input immediately.",
      "convert": "Convert the timestamp after editing it, or press Enter in its field. Ctrl/⌘+Enter also runs this action. Results show Unix seconds, milliseconds, ISO 8601, UTC and the browser’s local time.",
      "now": "Fill the timestamp with the current time and convert it. Seconds and Auto unit use whole seconds; milliseconds retain the current millisecond value. Microseconds and nanoseconds append zeros without adding clock precision.",
      "date": "Select a local date and time. Results update when the value changes, using your browser’s time zone. The same selection can represent a different instant on a computer in another zone."
    }
  },
  "zh": {
    "unit": "单位",
    "unitAuto": "自动判断单位",
    "unitS": "秒",
    "unitMs": "毫秒",
    "unitUs": "微秒",
    "unitNs": "纳秒",
    "readAs": "按{unit}读取（{n} 位）。如有误，请选择单位。",
    "tsToDate": "时间戳 → 日期",
    "dateToTs": "日期 → 时间戳",
    "convert": "转换",
    "now": "当前时间",
    "copy": "复制",
    "copied": "已复制！",
    "copyFail": "复制失败，请手动复制数值。",
    "errNum": "无效的时间戳。请输入数字，可带正负号和小数点；日期请在「日期 → 时间戳」中选择。",
    "errRange": "时间戳超出范围。",
    "errDate": "无效的日期。",
    "timestamp": "Unix 时间戳",
    "dateTime": "本地日期和时间",
    "placeholder": "如 1712160000",
    "tips": {
      "input": "输入十进制数字，可带正负号和小数，前后空格会被忽略，全角数字、正负号和小数点按半角读取。不接受指数、十六进制和千位分隔符。日期须在 Unix 纪元前后 ±8,640,000,000,000,000 毫秒内。",
      "unit": "自动判断只数整数位：12 位以内按秒，13–15 位按毫秒，16–18 位按微秒，19 位及以上按纳秒。可手动选择单位覆盖判断，毫秒以下的位数会舍去。输入非空时，切换单位会立即转换。",
      "convert": "编辑时间戳后点击「转换」，或在输入框内按 Enter。Ctrl/⌘+Enter 也会执行此操作。结果包含 Unix 秒、毫秒、ISO 8601、UTC 和浏览器的本地时间。",
      "now": "填入当前时间并转换。秒和自动判断单位使用整秒，毫秒保留当前毫秒值；微秒和纳秒在末尾补零，不会增加时钟精度。",
      "date": "选择本地日期和时间，值改变时自动更新结果。工具使用浏览器所在时区，同一选择值在另一时区的电脑上可能代表不同时刻。"
    }
  },
  "ja": {
    "unit": "単位",
    "unitAuto": "単位を自動判定",
    "unitS": "秒",
    "unitMs": "ミリ秒",
    "unitUs": "マイクロ秒",
    "unitNs": "ナノ秒",
    "readAs": "{unit}として読み取りました（{n} 桁）。違う場合は単位を選んでください。",
    "tsToDate": "タイムスタンプ → 日付",
    "dateToTs": "日付 → タイムスタンプ",
    "convert": "変換",
    "now": "現在時刻",
    "copy": "コピー",
    "copied": "コピー済み！",
    "copyFail": "コピーに失敗しました。値を手動でコピーしてください。",
    "errNum": "無効なタイムスタンプです。数字を入力してください（符号と小数点を使えます）。日付は「日付 → タイムスタンプ」で選びます。",
    "errRange": "タイムスタンプが範囲外です。",
    "errDate": "無効な日付です。",
    "timestamp": "Unix タイムスタンプ",
    "dateTime": "ローカルの日付と時刻",
    "placeholder": "例：1712160000",
    "tips": {
      "input": "10 進数を入力します。符号と小数を使え、前後の空白は無視されます。全角の数字・符号・小数点は半角として読みます。指数表記、16 進数、桁区切りには対応しません。日時の範囲は Unix エポックの前後 ±8,640,000,000,000,000 ミリ秒です。",
      "unit": "自動判定は整数部の桁数を数えます。12 桁以下は秒、13〜15 桁はミリ秒、16〜18 桁はマイクロ秒、19 桁以上はナノ秒です。単位を選ぶと自動判定を上書きし、ミリ秒未満は切り捨てます。入力が空でなければ単位変更で直ちに変換します。",
      "convert": "タイムスタンプを編集した後に「変換」を押すか、入力欄で Enter を押します。Ctrl/⌘+Enter でも実行できます。Unix 秒、ミリ秒、ISO 8601、UTC、ブラウザのローカル時刻を表示します。",
      "now": "現在時刻を入力して変換します。秒と自動判定は整数秒、ミリ秒は現在のミリ秒値を使います。マイクロ秒とナノ秒には末尾にゼロを付けますが、時計の精度は上がりません。",
      "date": "ローカルの日付と時刻を選ぶと、値の変更時に結果が更新されます。ブラウザのタイムゾーンを使うため、別のタイムゾーンの PC では同じ選択値が別の時点を表す場合があります。"
    }
  },
  "ko": {
    "unit": "단위",
    "unitAuto": "단위 자동 판단",
    "unitS": "초",
    "unitMs": "밀리초",
    "unitUs": "마이크로초",
    "unitNs": "나노초",
    "readAs": "{unit}(으)로 읽었습니다({n}자리). 틀리면 단위를 고르세요.",
    "tsToDate": "타임스탬프 → 날짜",
    "dateToTs": "날짜 → 타임스탬프",
    "convert": "변환",
    "now": "현재 시간",
    "copy": "복사",
    "copied": "복사됨!",
    "copyFail": "복사하지 못했습니다. 값을 직접 복사하세요.",
    "errNum": "잘못된 타임스탬프입니다. 숫자를 입력하세요(부호와 소수점 사용 가능). 날짜는 ‘날짜 → 타임스탬프’에서 고르세요.",
    "errRange": "타임스탬프가 범위를 벗어났습니다.",
    "errDate": "잘못된 날짜입니다.",
    "timestamp": "Unix 타임스탬프",
    "dateTime": "로컬 날짜와 시간",
    "placeholder": "예: 1712160000",
    "tips": {
      "input": "10진수를 입력합니다. 부호와 소수를 쓸 수 있고 앞뒤 공백은 무시되며, 전각 숫자·부호·소수점은 반각으로 읽습니다. 지수 표기, 16진수, 천 단위 구분 기호는 허용되지 않습니다. 날짜 범위는 Unix 에포크 전후 ±8,640,000,000,000,000밀리초입니다.",
      "unit": "자동 판단은 정수 부분의 자릿수를 셉니다. 12자리 이하는 초, 13~15자리는 밀리초, 16~18자리는 마이크로초, 19자리 이상은 나노초입니다. 단위를 선택해 자동 판단을 바꿀 수 있으며 밀리초 미만 자릿수는 버립니다. 입력이 비어 있지 않으면 단위 변경 시 즉시 변환합니다.",
      "convert": "타임스탬프를 편집한 뒤 변환을 누르거나 입력창에서 Enter를 누릅니다. Ctrl/⌘+Enter도 같은 동작입니다. Unix 초, 밀리초, ISO 8601, UTC와 브라우저의 로컬 시간을 표시합니다.",
      "now": "현재 시간을 입력하고 변환합니다. 초와 자동 판단은 정수 초를, 밀리초는 현재 밀리초 값을 사용합니다. 마이크로초와 나노초에는 뒤에 0을 붙이며 시계 정밀도를 높이지는 않습니다.",
      "date": "로컬 날짜와 시간을 선택하면 값이 바뀔 때 결과가 갱신됩니다. 브라우저의 타임존을 사용하므로 다른 타임존의 컴퓨터에서는 같은 선택 값이 다른 시점을 나타낼 수 있습니다."
    }
  }
};
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---
<div class="tc-wrap">
  <div class="tc-sections">
    <div class="tc-section">
      <h2 class="tc-section-title">{T.tsToDate}</h2>
      <div class="tc-controls">
        <div class="tc-unit-control">
          <div class="tc-field-label">
            <label for="tc-unit">{T.unit}</label>
            <Toggletip id="tc-tip-unit" lang={lang} about={T.unit}>{TIPS.unit}</Toggletip>
          </div>
          <select id="tc-unit" class="tc-unit" aria-label={T.unit}>
            <option value="auto">{T.unitAuto}</option>
            <option value="s">{T.unitS}</option>
            <option value="ms">{T.unitMs}</option>
            <option value="us">{T.unitUs}</option>
            <option value="ns">{T.unitNs}</option>
          </select>
        </div>
        <div class="tc-buttons">
          <div class="tc-action">
            <button id="tc-ts-convert" class="btn-primary" type="button">{T.convert}</button>
            <Toggletip id="tc-tip-convert" lang={lang} about={T.convert}>{TIPS.convert}</Toggletip>
          </div>
          <div class="tc-action">
            <button id="tc-ts-now" class="btn-secondary" type="button">{T.now}</button>
            <Toggletip id="tc-tip-now" lang={lang} about={T.now}>{TIPS.now}</Toggletip>
          </div>
        </div>
      </div>
      <div id="tc-ts-status" class="tc-status" aria-live="polite" tabindex="0"></div>
      <div class="tc-input-row">
        <div class="tc-field-label">
          <label for="tc-ts-input">{T.timestamp}</label>
          <Toggletip id="tc-tip-input" lang={lang} about={T.timestamp}>{TIPS.input}</Toggletip>
        </div>
        <input id="tc-ts-input" class="tool-input" type="text" placeholder={T.placeholder} spellcheck="false" inputmode="numeric" />
      </div>
      <div id="tc-ts-results" class="tc-results"></div>
    </div>
    <hr class="tc-divider" />
    <div class="tc-section">
      <h2 id="tc-date-to-ts-title" class="tc-section-title">{T.dateToTs}</h2>
      <div id="tc-date-status" class="tc-status" aria-live="polite" tabindex="0"></div>
      <div class="tc-input-row">
        <div class="tc-field-label">
          <label for="tc-date-input">{T.dateTime}</label>
          <Toggletip id="tc-tip-date" lang={lang} about={T.dateTime}>{TIPS.date}</Toggletip>
        </div>
        <input id="tc-date-input" class="tool-input" type="datetime-local" step="1" aria-labelledby="tc-date-to-ts-title" />
      </div>
      <div id="tc-date-results" class="tc-results"></div>
    </div>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var unitSel = document.getElementById('tc-unit');

      /* ── engine:start ── */
      // Integer digits decide the unit: present-day values have 10 (s), 13 (ms), 16 (µs) and
      // 19 (ns) digits. A chosen unit overrides this. Integer parts go through BigInt so that
      // nanosecond values above 2^53 keep their millisecond part; like Date, the result is cut
      // toward zero.
      var UNIT_DIV = { us: 1000n, ns: 1000000n };
      var MAX_MS = 8640000000000000;
      function readTimestamp(raw, unit) {
        var text = String(raw).trim();
        if (!text) return { error: 'empty' };
        var m = /^([+-]?)([0-9]+)(?:\.([0-9]*))?$/.exec(text);
        if (!m) return { error: 'num' };
        var digits = m[2].length;
        var u = unit !== 'auto' ? unit : digits <= 12 ? 's' : digits <= 15 ? 'ms' : digits <= 18 ? 'us' : 'ns';
        var neg = m[1] === '-';
        var ms;
        if (u === 's') ms = Number(BigInt(m[2]) * 1000n + BigInt(((m[3] || '') + '000').slice(0, 3)));
        else if (u === 'ms') ms = Number(BigInt(m[2]));
        else ms = Number(BigInt(m[2]) / UNIT_DIV[u]);
        ms = Math.trunc(ms);
        if (neg) ms = -ms;
        if (!isFinite(ms) || Math.abs(ms) > MAX_MS) return { error: 'range' };
        return { ms: ms === 0 ? 0 : ms, unit: u, digits: digits, auto: unit === 'auto' };
      }
      /* ── engine:end ── */

      var tsInput = document.getElementById('tc-ts-input');
      var tsStatus = document.getElementById('tc-ts-status');
      var tsResults = document.getElementById('tc-ts-results');
      var dateInput = document.getElementById('tc-date-input');
      var dateStatus = document.getElementById('tc-date-status');
      var dateResults = document.getElementById('tc-date-results');
      var copyRevision = 0, copyFailures = {};

      function invalidateCopies() {
        copyRevision++;
        document.querySelectorAll('.tc-wrap .btn-copy').forEach(function (btn) { btn.textContent = t.copy; });
      }

      function pad(n) { return ('0' + n).slice(-2); }

      function fmtOffset(offsetMin) {
        var sign = offsetMin <= 0 ? '+' : '-';
        var abs = Math.abs(offsetMin);
        return 'UTC' + sign + pad(Math.floor(abs/60)) + ':' + pad(abs%60);
      }

      function isoLocal(d) {
        return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()) +
          ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
      }

      function makeResultRow(label, value) {
        var div = document.createElement('div');
        div.className = 'tc-row';
        div.innerHTML = '<span class="tc-label">' + label + '</span><code class="tc-value" tabindex="0" aria-label="' + label + '">' + value + '</code><button class="btn-copy">' + t.copy + '</button>';
        return div;
      }

      function attachCopyListeners(container) {
        var status = container === tsResults ? tsStatus : dateStatus;
        container.querySelectorAll('.btn-copy').forEach(function (btn) {
          var requestId = 0, feedbackTimer = null;
          btn.addEventListener('click', function () {
            var el = btn.parentElement.querySelector('.tc-value');
            if (!el) return;
            var revision = copyRevision, request = ++requestId, failure = copyFailures[container.id] || 0;
            var text = el.textContent;
            clearTimeout(feedbackTimer);
            btn.textContent = t.copy;
            function isCurrent() { return revision === copyRevision && request === requestId && container.contains(btn); }
            function copied() {
              if (!isCurrent()) return;
              if (failure === (copyFailures[container.id] || 0) && status.textContent === t.copyFail) { status.textContent = ''; status.className = 'tc-status'; }
              btn.textContent = t.copied;
              feedbackTimer = setTimeout(function () { if (isCurrent()) btn.textContent = t.copy; }, 1500);
            }
            function failed() { if (isCurrent()) { copyFailures[container.id] = (copyFailures[container.id] || 0) + 1; setStatus(status, t.copyFail, true); } }
            // Clipboard API first; when it is missing, throws or rejects, a hidden textarea and
            // execCommand('copy') (same as MarkdownLinterTool.astro); both failing shows copyFail.
            // A copy that is no longer current does not fall back.
            function fallback() {
              if (!isCurrent()) return;
              var ta = document.createElement('textarea');
              ta.value = text;
              ta.setAttribute('readonly', '');
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              var ok = false;
              try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
              document.body.removeChild(ta);
              // select() moved focus to the textarea; give it back to the button (keyboard users).
              btn.focus();
              if (ok) copied(); else failed();
            }
            var pending;
            try { pending = navigator.clipboard && navigator.clipboard.writeText ? navigator.clipboard.writeText(text) : null; }
            catch (e) { pending = null; }
            if (pending) Promise.resolve(pending).then(copied, fallback);
            else fallback();
          });
        });
      }

      function setStatus(el, msg, isErr) {
        el.textContent = msg;
        el.className = 'tc-status ' + (isErr ? 'error' : 'success');
      }

      // Full-width digits, ＋, － and ． (U+FF10–FF19, U+FF0B, U+FF0D, U+FF0E) typed with a CJK
      // input method are read as ASCII before the engine runs; the field keeps what was typed.
      function halfWidth(s) {
        return s.replace(/[\uFF0B\uFF0D\uFF0E\uFF10-\uFF19]/g, function (c) { return String.fromCharCode(c.charCodeAt(0) - 0xFEE0); });
      }

      // Timestamp -> Date
      function convertTs() {
        invalidateCopies();
        var raw = halfWidth(tsInput.value).trim();
        tsResults.innerHTML = '';
        if (!raw) { tsStatus.textContent = ''; tsStatus.className = 'tc-status'; return; }
        var read = readTimestamp(raw, unitSel.value);
        if (read.error === 'num') { setStatus(tsStatus, t.errNum, true); return; }
        if (read.error === 'range') { setStatus(tsStatus, t.errRange, true); return; }
        var ms = read.ms;
        var d = new Date(ms);

        var unitName = { s: t.unitS, ms: t.unitMs, us: t.unitUs, ns: t.unitNs }[read.unit];
        if (read.auto) {
          tsStatus.textContent = t.readAs.replace('{unit}', unitName).replace('{n}', String(read.digits));
          tsStatus.className = 'tc-status info';
        } else {
          tsStatus.textContent = '';
          tsStatus.className = 'tc-status';
        }

        var tzLabel = fmtOffset(d.getTimezoneOffset());

        [
          ['Unix (s)', Math.floor(ms / 1000).toString()],
          ['Unix (ms)', ms.toString()],
          ['ISO 8601', d.toISOString()],
          ['UTC', d.toUTCString()],
          ['Local (' + tzLabel + ')', isoLocal(d)],
        ].forEach(function (pair) {
          tsResults.appendChild(makeResultRow(pair[0], pair[1]));
        });
        attachCopyListeners(tsResults);
      }

      document.getElementById('tc-ts-convert').addEventListener('click', function () {
        convertTs();
        window.trackTool && window.trackTool('timestamp_converter', 'ts_to_date');
      });
      tsInput.addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.ctrlKey && !e.metaKey) convertTs(); });
      tsInput.addEventListener('input', invalidateCopies);
      dateInput.addEventListener('input', invalidateCopies);
      unitSel.addEventListener('change', function () { if (tsInput.value.trim()) convertTs(); else invalidateCopies(); });

      document.getElementById('tc-ts-now').addEventListener('click', function () {
        var now = Date.now();
        var u = unitSel.value;
        tsInput.value = u === 'ms' ? String(now) : u === 'us' ? String(now) + '000' : u === 'ns' ? String(now) + '000000' : Math.floor(now / 1000).toString();
        convertTs();
      });

      // Date -> Timestamp
      function convertDate() {
        invalidateCopies();
        var val = dateInput.value;
        dateResults.innerHTML = '';
        if (!val) { dateStatus.textContent = ''; dateStatus.className = 'tc-status'; return; }

        // datetime-local gives local time — parse as local
        var d = new Date(val);
        if (isNaN(d.getTime())) { setStatus(dateStatus, t.errDate, true); return; }

        setStatus(dateStatus, '', false);
        dateStatus.className = 'tc-status';

        var ms = d.getTime();
        var tzLabel = fmtOffset(d.getTimezoneOffset());

        [
          ['Unix (s)', Math.floor(ms / 1000).toString()],
          ['Unix (ms)', ms.toString()],
          ['ISO 8601', d.toISOString()],
          ['UTC', d.toUTCString()],
          ['Local (' + tzLabel + ')', isoLocal(d)],
        ].forEach(function (pair) {
          dateResults.appendChild(makeResultRow(pair[0], pair[1]));
        });
        attachCopyListeners(dateResults);
      }

      dateInput.addEventListener('change', convertDate);
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && document.querySelector('.tc-wrap').contains(document.activeElement)) {
          tsInput.value = '';
          dateInput.value = '';
          convertTs();
          convertDate();
        }
      });
    })();
  </script>
</div>

<style>
  .tc-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; gap: 1rem; }
  .tc-wrap [hidden] { display: none !important; }
  .tc-sections { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; min-width: 0; }
  .tc-section { display: flex; flex-direction: column; min-width: 0; gap: 0.5rem; }
