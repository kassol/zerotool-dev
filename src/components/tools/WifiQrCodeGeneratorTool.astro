      els.toggle.setAttribute('aria-label', show ? t.hidePw : t.showPw);
      els.toggle.title = show ? t.hidePw : t.showPw;
      showEncoded(values());
    });

    var pending = 0;
    function schedule() { if (pending) return; pending = requestAnimationFrame(function () { pending = 0; render(); }); }
    $('wqg').addEventListener('input', schedule);
    $('wqg').addEventListener('change', schedule);
    /* Clear credentials now; redraw after the shared shortcut empties the text fields. */
    document.addEventListener('keydown', function (e) {
      if (!(e.metaKey || e.ctrlKey) || (e.key !== 'l' && e.key !== 'L') || !$('wqg').contains(document.activeElement)) return;
      if (pending) { cancelAnimationFrame(pending); pending = 0; }
      els.password.value = '';
      clearCode();
      els.encoded.textContent = ''; els.status.textContent = ''; renderWarnings([]);
      setTimeout(render, 0);
    });
    var previewObserver = new ResizeObserver(function () { if (current) drawPreview(); });
    previewObserver.observe(els.canvas.parentNode);
    window.addEventListener('resize', function () { if (current) drawPreview(); });

    els.ssid.value = 'Guest-WiFi';
    els.password.value = 'welcome-2026';
    render();
  })();
</script>

<style>
