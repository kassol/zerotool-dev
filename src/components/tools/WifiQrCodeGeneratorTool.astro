const L = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = L;
const prefix = lang === 'en' ? '' : '/' + lang;
const SIZES = [256, 512, 1024, 2048];
---
<div class="wqg" id="wqg">
  <div class="wqg-body">
    <div class="wqg-rail zt-rail">
      <div class="wqg-form">
        <div class="wqg-field">
          <div class="wqg-label-row">
            <span class="wqg-label-tip"><label for="wqg-ssid" class="tool-label">{L.ssid}</label><Toggletip id="wqg-tip-ssid" lang={lang} about={L.ssid}>{TIPS.ssid}</Toggletip></span>
            <span id="wqg-bytes" class="wqg-bytes" aria-live="polite"></span>
          </div>
          <input id="wqg-ssid" class="tool-input" type="text" placeholder={L.ssidPh} autocomplete="off" autocapitalize="off" spellcheck="false" />
        </div>
        <div class="wqg-field">
          <div class="wqg-label-row"><label for="wqg-password" class="tool-label">{L.password}</label><Toggletip id="wqg-tip-password" lang={lang} about={L.password}>{TIPS.password}</Toggletip></div>
          <div class="wqg-pwd-row">
            <input id="wqg-password" class="tool-input" type="password" autocomplete="off" autocapitalize="off" spellcheck="false" />
            <button type="button" id="wqg-pwd-toggle" class="wqg-pwd-btn" aria-pressed="false" aria-label={L.showPw} title={L.showPw}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <div class="wqg-field">
          <div class="wqg-label-row"><label for="wqg-sec" class="tool-label">{L.security}</label><Toggletip id="wqg-tip-security" lang={lang} about={L.security}>{TIPS.security}</Toggletip></div>
          <select id="wqg-sec" class="tool-input wqg-select">
            <option value="WPA" selected>{L.secWpa}</option>
            <option value="WPA3">{L.secWpa3}</option>
            <option value="WEP">{L.secWep}</option>
            <option value="nopass">{L.secOpen}</option>
          </select>
          <label class="wqg-check"><input type="checkbox" id="wqg-hidden" /> {L.hidden}</label>
        </div>
      </div>
      <div class="wqg-export">
        <div class="wqg-label-row"><span class="tool-label">{L.exportLabel}</span><Toggletip id="wqg-tip-export" lang={lang} about={L.exportLabel}>{TIPS.export}</Toggletip></div>
        <div class="wqg-actions">
          <button type="button" id="wqg-png" class="btn-primary">{L.dlPng}</button>
          <button type="button" id="wqg-svg" class="btn-secondary">{L.dlSvg}</button>
          <button type="button" id="wqg-copy" class="btn-ghost">{L.copyText}</button>
        </div>
      </div>
      <details class="wqg-settings wqg-details">
        <summary>{L.options}</summary>
        <div class="wqg-options">
          <div class="wqg-opt">
            <div class="wqg-label-row"><label class="tool-label" for="wqg-ecl">{L.ecl}</label><Toggletip id="wqg-tip-ecl" lang={lang} about={L.ecl}>{TIPS.ecl}</Toggletip></div>
            <select id="wqg-ecl" class="tool-input wqg-select">
              <option value="L">{L.eclL}</option><option value="M" selected>{L.eclM}</option><option value="Q">{L.eclQ}</option><option value="H">{L.eclH}</option>
            </select>
          </div>
          <div class="wqg-opt">
            <div class="wqg-label-row"><label class="tool-label" for="wqg-size">{L.size}</label><Toggletip id="wqg-tip-size" lang={lang} about={L.size}>{TIPS.size}</Toggletip></div>
            <select id="wqg-size" class="tool-input wqg-select">{SIZES.map((s) => <option value={s} selected={s === 1024}>{s} px</option>)}</select>
          </div>
          <div class="wqg-opt wqg-colors">
            <div class="wqg-label-row"><label class="wqg-color"><input type="color" id="wqg-fg" value="#000000" /><span>{L.dark}</span> <code id="wqg-fg-hex">#000000</code></label><Toggletip id="wqg-tip-colors" lang={lang} about={L.dark}>{TIPS.colors}</Toggletip></div>
            <label class="wqg-color"><input type="color" id="wqg-bg" value="#ffffff" /><span>{L.light}</span> <code id="wqg-bg-hex">#ffffff</code></label>
          </div>
        </div>
      </details>
      <details class="wqg-card wqg-details">
        <summary>{L.cardHeading}</summary>
        <div class="wqg-card-controls">
          <div class="wqg-label-row"><label class="tool-label" for="wqg-card-title">{L.cardTitleLabel}</label><Toggletip id="wqg-tip-card" lang={lang} about={L.cardHeading}>{TIPS.card}</Toggletip></div>
          <input id="wqg-card-title" class="tool-input" type="text" value={L.cardTitleDefault} autocomplete="off" />
          <label class="wqg-check"><input type="checkbox" id="wqg-card-pw" checked /> {L.cardShowPw}</label>
          <div class="wqg-card-actions">
            <button type="button" id="wqg-card-png" class="btn-secondary">{L.dlCardPng}</button>
            <button type="button" id="wqg-card-svg" class="btn-secondary">{L.dlCardSvg}</button>
            <button type="button" id="wqg-card-print" class="btn-ghost">{L.printCard}</button>
          </div>
          <p id="wqg-card-size" class="wqg-card-size"></p>
        </div>
      </details>
      <details class="wqg-encoded wqg-details">
        <summary>{L.encoded}</summary>
        <pre id="wqg-encoded" class="wqg-encoded-text"></pre>
      </details>
    </div>
    <div class="wqg-out">
      <div class="wqg-report">
        <p id="wqg-status" class="wqg-status" role="status" aria-live="polite"></p>
        <ul id="wqg-warn" class="wqg-warn" aria-live="polite"></ul>
      </div>
      <fieldset class="wqg-view-switch">
        <legend class="wqg-sr">{L.previewLabel}</legend>
        <label><input id="wqg-view-qr" type="radio" name="wqg-view" value="qr" checked /> {L.qrView}</label>
        <label><input id="wqg-view-card" type="radio" name="wqg-view" value="card" /> {L.cardHeading}</label>
      </fieldset>
      <div class="wqg-preview" id="wqg-preview">
        <canvas id="wqg-canvas" role="img" aria-label={L.previewAlt} width="0" height="0"></canvas>
        <p class="wqg-empty">{L.emptyPreview}</p>
      </div>
      <div class="wqg-card-view" id="wqg-card-view">
        <img id="wqg-card-img" class="wqg-card-img" alt={L.cardAlt} hidden />
        <p class="wqg-empty">{L.emptyPreview}</p>
      </div>
    </div>
  </div>
  <p class="wqg-cross">
    <a href={prefix + '/tools/qr-code-decoder/'}>{L.crossReader}</a>
    <a href={prefix + '/tools/qr-code-generator/'}>{L.crossGen}</a>
  </p>
</div>

<script src="/vendor/qrcode.min.js" is:inline></script>
<script is:inline define:vars={{ t: CLIENT_T, pageLang: lang }}>
  (function () {
    /* ── engine:start ── */
    /* ISO/IEC 18004 requires a quiet zone of 4 modules around a QR Code symbol. */
    var QR_MARGIN = 4;

    /* The WIFI: network string. Field syntax follows ZXing "Barcode Contents": a backslash before
       \ ; , " and : (Android's WifiUriParser and ZXing's WifiResultParser remove it again). Field order
       follows the WIFI URI ABNF of the WPA3 Specification v3.5 section 7.1: T, R, S, H, P. "WPA3 only"
       is T:WPA with R:1, the Transition Disable bit for WPA3-Personal (section 8); the specification
       sets the type to WPA for every password network. Open networks keep T:nopass, the value ZXing
       documents and Android's own share code writes. */
    var WIFI_TYPES = { WPA: 'T:WPA;', WPA3: 'T:WPA;R:1;', WEP: 'T:WEP;', nopass: 'T:nopass;' };
    function escapeWifiField(s) {
      return String(s).replace(/([\\;,":])/g, '\\$1');
    }
    function wifiPayload(o) {
      if (!o.ssid) return '';
      var sec = WIFI_TYPES[o.security] ? o.security : 'WPA';
      var s = 'WIFI:' + WIFI_TYPES[sec] + 'S:' + escapeWifiField(o.ssid) + ';';
      if (o.hidden) s += 'H:true;';
      if (sec !== 'nopass' && o.password) s += 'P:' + escapeWifiField(o.password) + ';';
      return s + ';';
    }
    function utf8Bytes(s) {
      return new TextEncoder().encode(String(s)).length;
    }
    function cpLength(s) { return codePoints(String(s)).length; }

    /* Checks before a code is drawn. error: a STRINGS key, and no code is drawn. warnings: the code is
       drawn, with these notes.
       - IEEE 802.11: an SSID is at most 32 octets (UTF-8 here, 3 bytes per CJK character). Readers
         turn the name into UTF-8 octets, so a router that broadcasts it in another encoding (GBK is an
         option on some TP-LINK models) does not match.
       - A WPA/WPA2 passphrase is 8–63 printable ASCII characters, or the PSK as 64 hex digits (Annex J).
         SAE (WPA3) takes any password, so "WPA3 only" skips this check.
       - WEP keys: 5 or 13 characters, or 10 or 26 hex digits (WEP-40 / WEP-104).
       - Android's WifiUriParser rejects a WPA or WEP code without P: ("Invalid format"), so that is an error.
       - The characters that ZXing escapes, and "%" followed by two hex digits, read differently under the
         percent-encoding of the WPA3 specification.
       - A value ending in a backslash ends in "\\;" once escaped; the older branch of WifiUriParser splits
         fields on ";" not preceded by "\" and so runs into the next field. */
    function checkWifi(o) {
      var ssid = String(o.ssid || ''), pw = String(o.password || ''), sec = WIFI_TYPES[o.security] ? o.security : 'WPA';
      var w = [];
      if (!ssid) return { error: 'errEmptySsid', warnings: w };
      if (sec !== 'nopass' && !pw) return { error: sec === 'WEP' ? 'errNoKey' : 'errNoPassword', warnings: w };
      var bytes = utf8Bytes(ssid);
      if (bytes > 32) w.push({ key: 'wSsidBytes', bytes: bytes });
      if (/[^\x00-\x7f]/.test(ssid)) w.push({ key: 'wSsidUtf8' });
