// WiFi QR code generator: builds the WIFI: network string, checks it against IEEE 802.11 limits and the
// readers that parse it (ZXing, Android's WifiUriParser), and draws the code and a printable card.
// The QR matrix comes from the vendor node-qrcode with segments and version chosen here; the encoding
// engine (capacity, fewest-bit segments, whole-pixel PNG, SVG, colour check) is copied verbatim from
// QrCodeGeneratorTool.astro, and scripts/test-wifi-qr-code-generator.mjs compares the two copies.
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
