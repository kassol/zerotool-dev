      els.status.textContent = fmt(t.info, { v: p.version, n: n, ecl: o.ecl, used: p.bits, cap: p.capacityBits }) + '\n' + fmt(t.outSize, { px: lay.size, s: lay.scale });
      var warns = c.warnings.map(warnText);
      var cc = colorCheck(o.fg, o.bg);
      if (cc.inverted) warns.push(t.wInverted);
      if (cc.contrast < 40) warns.push(fmt(t.wContrast, { sc: cc.contrast }));
      else if (!cc.inverted && cc.red < 40) warns.push(fmt(t.wRed, { sc: cc.red }));
      renderWarnings(warns);
      drawPreview();
      renderCard();
      setButtons(true);
    }

    function paint(ctx, scale, offX, offY) {
      var c = current, q = QR_MARGIN, w = (c.n + 2 * q) * scale;
      ctx.fillStyle = c.o.bg; ctx.fillRect(offX, offY, w, w);
      ctx.fillStyle = c.o.fg;
      darkRuns(c.get, c.n).forEach(function (r) { ctx.fillRect(offX + (r[1] + q) * scale, offY + (r[0] + q) * scale, r[2] * scale, scale); });
    }
    function drawPreview() {
      var c = current;
      var preview = els.canvas.parentNode;
      var box = Math.max(0, Math.min(preview.clientWidth, preview.clientHeight) - 16);
      var dpr = window.devicePixelRatio || 1;
      var w = c.n + 2 * QR_MARGIN;
      var scale = Math.max(1, Math.floor(box * dpr / w));
      els.canvas.width = w * scale; els.canvas.height = w * scale;
      els.canvas.style.width = (w * scale / dpr) + 'px'; els.canvas.style.height = (w * scale / dpr) + 'px';
      els.canvas.hidden = false;
      paint(els.canvas.getContext('2d'), scale, 0, 0);
    }
    function pngBlob() {
      return new Promise(function (resolve, reject) {
        var lay = pngLayout(current.n, QR_MARGIN, current.o.size);
        var cv = document.createElement('canvas');
        cv.width = lay.size; cv.height = lay.size;
        paint(cv.getContext('2d'), lay.scale, 0, 0);
        cv.toBlob(function (b) { if (b) resolve(b); else reject(new Error('toBlob')); }, 'image/png');
      });
    }
    function svgText() {
      var c = current, lay = pngLayout(c.n, QR_MARGIN, c.o.size);
      return svgMarkup(c.get, c.n, { quiet: QR_MARGIN, scale: lay.scale, fg: c.o.fg, bg: c.o.bg, transparent: false });
    }

    function cardInput() {
      var c = current;
      var title = els.cardTitle.value.trim();
      return {
        title: title, ssid: c.v.ssid, hidden: c.v.hidden, n: c.n,
        password: c.v.security !== 'nopass' && els.cardPw.checked ? c.v.password : null,
        labels: { network: t.cardNetwork, password: t.cardPassword, hidden: t.cardHidden, space: t.cardSpace, scan: t.cardScan },
      };
    }
    function cardText() {
      var lay = cardLayout(cardInput());
      return { lay: lay, svg: cardSvg(lay, current.get, current.n, { fg: current.o.fg, bg: current.o.bg, lang: pageLang }) };
    }
    function renderCard() {
      var ct = cardText();
      if (cardUrl) URL.revokeObjectURL(cardUrl);
      cardUrl = URL.createObjectURL(new Blob([ct.svg], { type: 'image/svg+xml' }));
      els.cardImg.src = cardUrl;
      els.cardImg.hidden = false;
      els.cardSize.textContent = fmt(t.cardSize, { h: (ct.lay.height / 12).toFixed(0), w: ct.lay.width, hp: ct.lay.height });
    }
    function cardPngBlob() {
      return new Promise(function (resolve, reject) {
        var ct = cardText(), lay = ct.lay;
        var cv = document.createElement('canvas');
        cv.width = lay.width; cv.height = lay.height;
        var ctx = cv.getContext('2d');
        ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, lay.width, lay.height);
        paint(ctx, lay.qr.module, lay.qr.x, lay.qr.y);
        ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
        lay.items.forEach(function (it) {
          ctx.font = it.weight + ' ' + it.size + 'px ' + cardFont(it.font, pageLang);
          ctx.fillStyle = it.color;
          ctx.fillText(it.text, lay.width / 2, it.y);
        });
        cv.toBlob(function (b) { if (b) resolve(b); else reject(new Error('toBlob')); }, 'image/png');
      });
    }
    function printCard() {
      var svg = cardText().svg;
      var frame = document.createElement('iframe');
      frame.setAttribute('aria-hidden', 'true');
      frame.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;';
      document.body.appendChild(frame);
      var doc = frame.contentDocument;
      var style = doc.createElement('style');
      style.textContent = '@page{margin:12mm}html,body{margin:0}img{display:block;width:100mm;height:auto}';
      doc.head.appendChild(style);
      var img = doc.createElement('img');
      img.alt = t.cardAlt;
      img.onload = function () {
        frame.contentWindow.focus();
        frame.contentWindow.print();
        setTimeout(function () { frame.remove(); }, 1000);
      };
      img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
      doc.body.appendChild(img);
    }

    function save(blob, name) {
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url; a.download = name;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
    }
    function flash(btn, ok) {
      var label = btn.textContent;
      if (ok) { btn.textContent = t.copied; setTimeout(function () { btn.textContent = label; }, 1500); }
      else { els.status.textContent = t.copyFailed; els.status.className = 'wqg-status is-error'; }
    }

    els.png.addEventListener('click', function () {
      if (!current) return;
      var name = fileStem(current.v.ssid) + '.png';
      pngBlob().then(function (b) { save(b, name); track('download_png'); });
    });
    els.svg.addEventListener('click', function () {
      if (!current) return;
      save(new Blob([svgText()], { type: 'image/svg+xml' }), fileStem(current.v.ssid) + '.svg');
      track('download_svg');
    });
    els.copy.addEventListener('click', function () {
      if (!current) return;
      var btn = els.copy;
      if (!navigator.clipboard) { flash(btn, false); return; }
      navigator.clipboard.writeText(current.payload).then(function () { flash(btn, true); track('copy_text'); }, function () { flash(btn, false); });
    });
    els.cardPng.addEventListener('click', function () {
      if (!current) return;
      var name = fileStem(current.v.ssid) + '-card.png';
      cardPngBlob().then(function (b) { save(b, name); track('download_card_png'); });
    });
    els.cardSvgBtn.addEventListener('click', function () {
      if (!current) return;
      save(new Blob([cardText().svg], { type: 'image/svg+xml' }), fileStem(current.v.ssid) + '-card.svg');
      track('download_card_svg');
    });
    els.cardPrint.addEventListener('click', function () {
      if (!current) return;
      printCard();
      track('print_card');
    });
    els.toggle.addEventListener('click', function () {
      var show = els.password.type === 'password';
