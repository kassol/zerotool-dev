const TYPE_LABEL: Record<string, string> = { document: T.tDocument, fetch: T.tFetch, js: T.tJs, css: T.tCss, img: T.tImg, font: T.tFont, media: T.tMedia, ws: T.tWs, other: T.tOther };
const PHASE_UI = [
  { key: 'blocked', label: T.phaseBlocked },
  { key: 'dns', label: T.phaseDns },
  { key: 'tcp', label: T.phaseTcp },
  { key: 'ssl', label: T.phaseSsl },
  { key: 'send', label: T.phaseSend },
  { key: 'wait', label: T.phaseWait },
  { key: 'receive', label: T.phaseReceive },
