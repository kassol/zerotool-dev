---
// HarFileAnalyzerTool — reads a HAR file (browser DevTools export) in the browser:
// overview with findings, a sortable and filterable waterfall with request details and
// cURL, and a redacted copy for sharing. Credentials are replaced by [redacted]; the copy
// is then serialized and parsed again to check that no removed value is left in it.
// Nothing is uploaded or stored.
//
// The pure functions sit between the `engine:start` / `engine:end` markers so
// scripts/test-har-file-analyzer.mjs and scripts/test-har-invariant.mjs run the shipped
// code. TOKEN_RULES are copied from SecretRedactorTool.astro; the test checks they match.
// Opening, redaction and bulk cURL run in short slices (loadJob, redactJob, curlJob) so the
// page keeps responding while a large file is processed.
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

