        if (bs >= 0 && hs >= 0) return hs + bs;
        return bs;
      }
      function cacheOf(entry) {
        if (entry._fromCache === 'memory' || entry._fromCache === 'disk') return entry._fromCache;
        if (entry._fetchType === 'Memory Cache') return 'memory';
        if (entry._fetchType === 'Disk Cache') return 'disk';
        if (entry._fetchType === 'Service Worker' || (entry.response && entry.response._fetchedViaServiceWorker === true)) return 'sw';
        if (entry.response && Number(entry.response.status) === 304) return '304';
        return '';
      }
      function splitUrl(url) {
        try {
          var u = new URL(url);
          var name = u.pathname + u.search;
          return { host: u.host || u.protocol, name: name || '/' };
        } catch (e) {
          return { host: '', name: url };
        }
      }

      function readHarText(text) {
        var data;
        try { data = JSON.parse(String(text).replace(/^\uFEFF/, '')); }
        catch (err) { return { error: 'json', detail: String(err && err.message || err) }; }
        return checkHar(data);
      }
      function checkHar(data) {
        var log = isObj(data) ? data.log : null;
        if (!isObj(log) || !Array.isArray(log.entries)) return { error: 'notHar' };
        var version = typeof log.version === 'string' || typeof log.version === 'number' ? String(log.version).trim() : '';
        if (version && parseInt(version, 10) !== 1) return { error: 'version', detail: version };
        if (!log.entries.length) return { error: 'empty' };
        return { har: data, version: version };
      }

      // buildIndex and scanSensitive are split into per-entry steps, so the page can run them
      // in short slices (loadJob) and stay responsive while a large file opens.
      function indexStart(har) {
        var log = har.log;
        var creator = isObj(log.creator) ? log.creator : {};
        var firefox = /firefox/i.test(str(creator.name)) || (isObj(log.browser) && /firefox/i.test(str(log.browser.name)));
        return { log: log, creator: creator, firefox: firefox, rows: [], stats: { badDates: 0, mismatch: 0, sslSeparate: 0, unknownSize: 0, skipped: 0 } };
      }
      function indexEntry(st, e, i) {
        var stats = st.stats;
        if (!isObj(e)) { stats.skipped++; return; }
        var req = isObj(e.request) ? e.request : {};
        var res = isObj(e.response) ? e.response : {};
        var start = parseIsoMs(e.startedDateTime);
        if (!isFinite(start)) stats.badDates++;
        var tm = normalizeTimings(e.timings, e.time);
        if (tm.mismatch) stats.mismatch++;
        if (tm.convention === 'ssl-separate') stats.sslSeparate++;
        var dur = tm.time >= 0 ? Math.max(tm.time, tm.sum) : tm.sum;
        var url = str(req.url);
        var parts = splitUrl(url);
        var transfer = transferOf(e, st.firefox);
        if (transfer < 0) stats.unknownSize++;
        var content = isObj(res.content) ? res.content : {};
        st.rows.push({
          i: i, start: start, dur: dur, url: url, host: parts.host, name: parts.name,
          method: str(req.method) || 'GET', status: num(res.status), statusText: str(res.statusText),
          cls: statusClass(res.status), type: typeOf(e), mime: mimeOf(e),
          transfer: transfer, size: num(content.size), tm: tm, cache: cacheOf(e),
          error: str(res._error || e._error || ''), protocol: str(res.httpVersion || req.httpVersion),
          remote: str(e.serverIPAddress), priority: str(e._priority), pageref: str(e.pageref)
        });
      }
      function buildIndex(har) {
        var st = indexStart(har);
        for (var i = 0; i < st.log.entries.length; i++) indexEntry(st, st.log.entries[i], i);
        return indexFinish(st);
      }
      function indexFinish(st) {
        var log = st.log, creator = st.creator, firefox = st.firefox, rows = st.rows, stats = st.stats;
        var min = Infinity, max = -Infinity;
        for (var r = 0; r < rows.length; r++) {
          if (!isFinite(rows[r].start)) continue;
          if (rows[r].start < min) min = rows[r].start;
          if (rows[r].start + rows[r].dur > max) max = rows[r].start + rows[r].dur;
        }
        if (!isFinite(min)) { min = 0; max = 0; }
        for (var k = 0; k < rows.length; k++) if (!isFinite(rows[k].start)) rows[k].start = min;
        var pages = Array.isArray(log.pages) ? log.pages.filter(isObj).map(function (pg) {
          var pt = isObj(pg.pageTimings) ? pg.pageTimings : {};
          return { id: str(pg.id), title: str(pg.title), start: parseIsoMs(pg.startedDateTime), dcl: num(pt.onContentLoad), load: num(pt.onLoad) };
        }) : [];
        var marks = {};
        for (var g = 0; g < pages.length; g++) {
          if (!isFinite(pages[g].start)) continue;
          if (pages[g].dcl >= 0) marks.dcl = pages[g].start + pages[g].dcl;
          if (pages[g].load >= 0) marks.load = pages[g].start + pages[g].load;
          marks.page = pages[g];
          break;
        }
        if (marks.load > max) max = marks.load;
        if (marks.dcl > max) max = marks.dcl;
        return {
          rows: rows, min: min, max: max, pages: pages, marks: marks, stats: stats, firefox: firefox,
          creator: { name: str(creator.name), version: str(creator.version) },
          browser: isObj(log.browser) ? { name: str(log.browser.name), version: str(log.browser.version) } : null,
          version: str(log.version)
        };
      }

      function compareRows(key) {
        switch (key) {
          case 'name': return function (a, b) { return a.url < b.url ? -1 : a.url > b.url ? 1 : a.i - b.i; };
          case 'status': return function (a, b) { return (a.status - b.status) || a.i - b.i; };
          case 'type': return function (a, b) { return TYPE_KEYS.indexOf(a.type) - TYPE_KEYS.indexOf(b.type) || a.i - b.i; };
          case 'size': return function (a, b) { return (a.transfer - b.transfer) || a.i - b.i; };
          case 'time': return function (a, b) { return (a.dur - b.dur) || a.i - b.i; };
          default: return function (a, b) { return (a.start - b.start) || a.i - b.i; };
        }
      }
      function sortRows(rows, key, desc) {
        var cmp = compareRows(key);
        var out = rows.slice().sort(cmp);
        if (desc) out.reverse();
        return out;
      }
      function parseQuery(q) {
        var pos = [], neg = [];
        String(q || '').toLowerCase().split(/\s+/).forEach(function (w) {
          if (!w) return;
          if (w[0] === '-' && w.length > 1) neg.push(w.slice(1)); else pos.push(w);
        });
        return { pos: pos, neg: neg };
      }
      function filterRows(rows, f) {
        var q = parseQuery(f.query);
        return rows.filter(function (r) {
          if (f.status && f.status.size && !f.status.has(r.cls)) return false;
          if (f.types && f.types.size && !f.types.has(r.type)) return false;
          if (q.pos.length || q.neg.length) {
