---

<div class="har-root">
  <div class="har-shell" id="har-shell">
    <div class="har-start" id="har-start">
      <div class="har-drop zt-empty-drop" id="har-drop" role="button" tabindex="0" aria-label={T.dropAria}>
        <svg class="har-drop-icon" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        <span class="har-drop-text">
          <span class="har-drop-title">{T.dropTitle}</span>
          <span class="har-drop-sub">{T.dropSub}</span>
        </span>
      </div>
      <div class="har-start-actions">
        <button type="button" class="btn-primary" id="har-choose">{T.chooseBtn}</button>
        <button type="button" class="btn-secondary" id="har-sample">{T.sampleBtn}</button>
