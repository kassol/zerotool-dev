    "ogType": "og:type을 선택하세요. 선택 값을 쓰며 article:published_time 같은 유형별 필드는 추가하지 않습니다.",
    "ogImage": "URL을 태그와 미리보기 img에 사용합니다. 이미지를 업로드하지 않으며 이미지 호스트에는 브라우저 요청이 전달됩니다.",
    "ogDimensions": "og:image가 있을 때만 너비, 높이, alt 태그를 씁니다. 이미지 크기는 조절하지 않습니다.",
    "twCard": "카드 태그를 선택하세요. app과 player의 추가 태그는 직접 넣어야 합니다.",
    "twImage": "비어 있으면 og:image를 사용합니다. 별도 URL은 Twitter 미리보기와 twitter:image를 바꿉니다.",
    "schema": "최소 JSON-LD 유형을 선택하세요. Article은 작성자가 있으면 Person을 추가합니다. 풍부한 검색 결과의 추가 필드는 직접 넣으세요.",
    "platform": "Google, Facebook, Twitter, Discord를 전환하세요. 플랫폼 모양의 근사치이며 생성 head는 같습니다.",
    "copy": "선택한 JSON-LD를 포함한 head 전체를 복사하세요. 페이지 head 안에 붙이고 예시 값을 바꾸세요."
  }
};
const EXTRA_STRINGS = {
  "en": {
    "options": "More metadata",
    "platform": "Preview platform",
    "networkNotice": "Facebook, Twitter and Discord image previews make your browser request the image URLs you enter. Those image hosts receive the request."
  },
  "zh": {
    "options": "更多元数据",
    "platform": "预览平台",
    "networkNotice": "Facebook、Twitter 和 Discord 图片预览会由浏览器请求你填写的图片 URL；图片主机会收到该请求。"
  },
  "ja": {
    "options": "その他のメタデータ",
    "platform": "プレビュー対象",
    "networkNotice": "Facebook、Twitter、Discord の画像プレビューは、入力した画像 URL をブラウザーで取得します。画像ホストにリクエストが届きます。"
  },
  "ko": {
    "options": "추가 메타데이터",
    "platform": "미리보기 플랫폼",
    "networkNotice": "Facebook, Twitter, Discord 이미지 미리보기는 브라우저가 입력한 이미지 URL을 요청합니다. 이미지 호스트가 이 요청을 받습니다。"
  }
};
const STRINGS = Object.fromEntries(Object.keys(ORIGINAL_STRINGS).map(code => [code, { ...ORIGINAL_STRINGS[code], ...EXTRA_STRINGS[code], tips: TIP_STRINGS[code] }]));
// strings:end
const L = STRINGS[lang] ?? STRINGS.en;
const CLIENT_T = Object.fromEntries(['copy', 'copied', 'copyFailed', 'fillToPreview'].map(key => [key, L[key]]));
---
<div class="mtg-wrap">
  <div class="mtg-main">
    <div class="mtg-rail zt-rail">
      <div class="mtg-actions"><button id="mtg-copy" class="btn-copy">{L.copy}</button><Toggletip id="mtg-tip-copy" about={L.copy} lang={lang}>{L.tips.copy}</Toggletip></div>
      <div class="mtg-status-slot" role="status" aria-live="polite"></div>
          <div class="mtg-field mtg-field-full">
            <label for="mtg-title" class="tool-label">
              <span>{L.title}</span>
              <span class="mtg-counter" id="mtg-title-counter">0 / 60</span>
            <Toggletip id="mtg-tip-title" about={L.title} lang={lang}>{L.tips.title}</Toggletip></label>
            <input id="mtg-title" class="tool-input" type="text" placeholder={L.titlePh} autocomplete="off" />
          </div>
          <div class="mtg-field mtg-field-full">
            <label for="mtg-description" class="tool-label">
              <span>{L.description}</span>
              <span class="mtg-counter" id="mtg-description-counter">0 / 160</span>
            <Toggletip id="mtg-tip-description" about={L.description} lang={lang}>{L.tips.description}</Toggletip></label>
            <textarea id="mtg-description" class="tool-textarea" rows="2" placeholder={L.descriptionPh}></textarea>
          </div>
      <details class="mtg-options"><summary>{L.options}</summary>
    <div class="mtg-form">
      <details class="mtg-group" open>
        <summary class="mtg-summary">
          <span class="mtg-summary-label">{L.basicSection}</span>
          <span class="mtg-summary-chevron" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </span>
        </summary>
        <div class="mtg-fields">




          <div class="mtg-field mtg-field-full">
            <label for="mtg-canonical" class="tool-label">{L.canonical}<Toggletip id="mtg-tip-canonical" about={L.canonical} lang={lang}>{L.tips.canonical}</Toggletip></label>
            <input id="mtg-canonical" class="tool-input" type="url" placeholder="https://example.com/page/" autocomplete="off" />
          </div>

          <div class="mtg-field">
            <label for="mtg-site-name" class="tool-label">{L.siteName}<Toggletip id="mtg-tip-siteName" about={L.siteName} lang={lang}>{L.tips.siteName}</Toggletip></label>
            <input id="mtg-site-name" class="tool-input" type="text" placeholder="My Site" autocomplete="off" />
          </div>

          <div class="mtg-field">
            <label for="mtg-author" class="tool-label">{L.author}</label>
            <input id="mtg-author" class="tool-input" type="text" placeholder="Jane Doe" autocomplete="off" />
          </div>

          <div class="mtg-field mtg-field-full">
            <label for="mtg-keywords" class="tool-label">{L.keywords}</label>
            <input id="mtg-keywords" class="tool-input" type="text" placeholder="seo, meta tags, open graph" autocomplete="off" />
          </div>

          <div class="mtg-field">
            <label for="mtg-language" class="tool-label">{L.language}<Toggletip id="mtg-tip-language" about={L.language} lang={lang}>{L.tips.language}</Toggletip></label>
            <select id="mtg-language" class="tool-input mtg-select">
              <option value="en">en (English)</option>
              <option value="en-US">en-US</option>
              <option value="en-GB">en-GB</option>
              <option value="zh-CN">zh-CN</option>
              <option value="zh-TW">zh-TW</option>
              <option value="ja">ja</option>
              <option value="ko">ko</option>
              <option value="fr">fr</option>
              <option value="de">de</option>
              <option value="es">es</option>
            </select>
          </div>

          <div class="mtg-field">
            <label id="mtg-theme-color-label" for="mtg-theme-color" class="tool-label">{L.themeColor}<Toggletip id="mtg-tip-theme" about={L.themeColor} lang={lang}>{L.tips.theme}</Toggletip></label>
            <div class="mtg-color-row">
              <input id="mtg-theme-color" class="mtg-color-picker" type="color" value="#5b3d20" />
              <input id="mtg-theme-color-text" class="tool-input mtg-color-text" type="text" value="#5b3d20" autocomplete="off" spellcheck="false" aria-labelledby="mtg-theme-color-label" />
            </div>
          </div>

          <div class="mtg-field">
            <label for="mtg-robots-index" class="tool-label">{L.robotsIndex}<Toggletip id="mtg-tip-robots" about={L.robotsIndex} lang={lang}>{L.tips.robots}</Toggletip></label>
            <select id="mtg-robots-index" class="tool-input mtg-select">
              <option value="index">index</option>
              <option value="noindex">noindex</option>
            </select>
          </div>

          <div class="mtg-field">
            <label for="mtg-robots-follow" class="tool-label">{L.robotsFollow}</label>
            <select id="mtg-robots-follow" class="tool-input mtg-select">
              <option value="follow">follow</option>
              <option value="nofollow">nofollow</option>
            </select>
          </div>

          <div class="mtg-field mtg-field-full">
            <label class="mtg-checkbox-label">
              <input id="mtg-viewport" type="checkbox" checked />
              <span>{L.includeViewport}</span><Toggletip id="mtg-tip-viewport" about={L.includeViewport} lang={lang}>{L.tips.viewport}</Toggletip>
            </label>
          </div>
        </div>
      </details>

      <details class="mtg-group" open>
        <summary class="mtg-summary">
          <span class="mtg-summary-label">{L.ogSection}</span>
          <span class="mtg-summary-chevron" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </span>
        </summary>
        <div class="mtg-fields">
          <div class="mtg-field">
            <label for="mtg-og-type" class="tool-label">{L.ogType}<Toggletip id="mtg-tip-ogType" about={L.ogType} lang={lang}>{L.tips.ogType}</Toggletip></label>
            <select id="mtg-og-type" class="tool-input mtg-select">
              <option value="website">website</option>
              <option value="article">article</option>
              <option value="product">product</option>
              <option value="video.other">video.other</option>
              <option value="music.song">music.song</option>
              <option value="profile">profile</option>
              <option value="book">book</option>
            </select>
          </div>

          <div class="mtg-field">
            <label for="mtg-og-locale" class="tool-label">{L.ogLocale}</label>
            <input id="mtg-og-locale" class="tool-input" type="text" placeholder="en_US" autocomplete="off" />
          </div>

          <div class="mtg-field mtg-field-full">
            <label for="mtg-og-image" class="tool-label">{L.ogImage}<Toggletip id="mtg-tip-ogImage" about={L.ogImage} lang={lang}>{L.tips.ogImage}</Toggletip></label>
            <input id="mtg-og-image" class="tool-input" type="url" placeholder="https://example.com/cover.png" autocomplete="off" />
          </div>

          <div class="mtg-field">
            <label for="mtg-og-image-width" class="tool-label">{L.ogImageWidth}<Toggletip id="mtg-tip-ogDimensions" about={L.ogImageWidth} lang={lang}>{L.tips.ogDimensions}</Toggletip></label>
            <input id="mtg-og-image-width" class="tool-input" type="number" min="1" placeholder="1200" autocomplete="off" />
          </div>

          <div class="mtg-field">
            <label for="mtg-og-image-height" class="tool-label">{L.ogImageHeight}</label>
            <input id="mtg-og-image-height" class="tool-input" type="number" min="1" placeholder="630" autocomplete="off" />
          </div>

          <div class="mtg-field mtg-field-full">
            <label for="mtg-og-image-alt" class="tool-label">{L.ogImageAlt}</label>
            <input id="mtg-og-image-alt" class="tool-input" type="text" placeholder="Cover image alt text" autocomplete="off" />
          </div>
        </div>
      </details>

      <details class="mtg-group">
        <summary class="mtg-summary">
          <span class="mtg-summary-label">{L.twitterSection}</span>
          <span class="mtg-summary-chevron" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </span>
        </summary>
        <div class="mtg-fields">
          <div class="mtg-field">
            <label for="mtg-tw-card" class="tool-label">{L.twCard}<Toggletip id="mtg-tip-twCard" about={L.twCard} lang={lang}>{L.tips.twCard}</Toggletip></label>
            <select id="mtg-tw-card" class="tool-input mtg-select">
              <option value="summary_large_image">summary_large_image</option>
              <option value="summary">summary</option>
              <option value="app">app</option>
              <option value="player">player</option>
            </select>
          </div>

          <div class="mtg-field">
            <label for="mtg-tw-site" class="tool-label">{L.twSite}</label>
            <input id="mtg-tw-site" class="tool-input" type="text" placeholder="@mysite" autocomplete="off" />
          </div>

          <div class="mtg-field">
            <label for="mtg-tw-creator" class="tool-label">{L.twCreator}</label>
            <input id="mtg-tw-creator" class="tool-input" type="text" placeholder="@author" autocomplete="off" />
          </div>

          <div class="mtg-field mtg-field-full">
            <label for="mtg-tw-image" class="tool-label">{L.twImage}<Toggletip id="mtg-tip-twImage" about={L.twImage} lang={lang}>{L.tips.twImage}</Toggletip></label>
            <input id="mtg-tw-image" class="tool-input" type="url" placeholder="https://example.com/twitter-card.png" autocomplete="off" />
          </div>
        </div>
      </details>

      <details class="mtg-group">
        <summary class="mtg-summary">
          <span class="mtg-summary-label">{L.schemaSection}</span>
          <span class="mtg-summary-chevron" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </span>
        </summary>
        <div class="mtg-fields">
          <div class="mtg-field mtg-field-full">
            <label for="mtg-schema-type" class="tool-label">{L.schemaType}<Toggletip id="mtg-tip-schema" about={L.schemaType} lang={lang}>{L.tips.schema}</Toggletip></label>
            <select id="mtg-schema-type" class="tool-input mtg-select">
              <option value="">— None —</option>
              <option value="WebPage">WebPage</option>
              <option value="Article">Article</option>
              <option value="Product">Product</option>
              <option value="Organization">Organization</option>
            </select>
            <p class="mtg-hint">{L.schemaHint}</p>
          </div>
        </div>
      </details>
    </div>

      </details>
    </div>
    <div class="mtg-preview-pane">
      <div class="mtg-platform-view" data-empty="false">
        <div class="mtg-platform-heading"><span class="tool-label">{L.platform}</span><Toggletip id="mtg-tip-platform" about={L.platform} lang={lang}>{L.tips.platform}</Toggletip></div>
        <p class="mtg-network-notice">{L.networkNotice}</p>
      <div class="mtg-preview-tabs" role="tablist" aria-label={L.platform}>
        <button class="mtg-preview-tab is-active" data-platform="google" role="tab" aria-selected="true">{L.tabGoogle}</button>
        <button class="mtg-preview-tab" data-platform="facebook" role="tab" aria-selected="false">{L.tabFacebook}</button>
        <button class="mtg-preview-tab" data-platform="twitter" role="tab" aria-selected="false">{L.tabTwitter}</button>
        <button class="mtg-preview-tab" data-platform="discord" role="tab" aria-selected="false">{L.tabDiscord}</button>
      </div>
      <div id="mtg-preview" class="mtg-preview" role="tabpanel" aria-live="polite"></div>
      </div>
  <div class="mtg-output-section">
    <div class="mtg-output-header">
      <span class="mtg-output-label">{L.generatedHead}</span>
    </div>
    <pre id="mtg-output" class="mtg-output"></pre>
  </div>


    </div>
  </div>
  <script is:inline define:vars={{ CLIENT_T }}>
    (function () {
      var pageLang = (document.documentElement.lang || 'en').slice(0, 2);
      var t = CLIENT_T;

      var fields = {
        title: document.getElementById('mtg-title'),
        description: document.getElementById('mtg-description'),
        canonical: document.getElementById('mtg-canonical'),
        siteName: document.getElementById('mtg-site-name'),
        author: document.getElementById('mtg-author'),
        keywords: document.getElementById('mtg-keywords'),
        language: document.getElementById('mtg-language'),
        themeColor: document.getElementById('mtg-theme-color'),
        themeColorText: document.getElementById('mtg-theme-color-text'),
        robotsIndex: document.getElementById('mtg-robots-index'),
        robotsFollow: document.getElementById('mtg-robots-follow'),
        viewport: document.getElementById('mtg-viewport'),
        ogType: document.getElementById('mtg-og-type'),
        ogLocale: document.getElementById('mtg-og-locale'),
        ogImage: document.getElementById('mtg-og-image'),
        ogImageWidth: document.getElementById('mtg-og-image-width'),
        ogImageHeight: document.getElementById('mtg-og-image-height'),
        ogImageAlt: document.getElementById('mtg-og-image-alt'),
        twCard: document.getElementById('mtg-tw-card'),
        twSite: document.getElementById('mtg-tw-site'),
        twCreator: document.getElementById('mtg-tw-creator'),
        twImage: document.getElementById('mtg-tw-image'),
        schemaType: document.getElementById('mtg-schema-type'),
      };

      var titleCounter = document.getElementById('mtg-title-counter');
      var descCounter = document.getElementById('mtg-description-counter');
      var outputEl = document.getElementById('mtg-output');
      var previewEl = document.getElementById('mtg-preview');
      var copyBtn = document.getElementById('mtg-copy');
      var tabs = document.querySelectorAll('.mtg-preview-tab');
      var currentPlatform = 'google';

      /* ── engine:start ── */
      function escapeAttr(s) {
        return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function escapeHtml(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
      function getValues() {
        return {
          title: fields.title.value.trim(),
          description: fields.description.value.trim(),
          canonical: fields.canonical.value.trim(),
          siteName: fields.siteName.value.trim(),
          author: fields.author.value.trim(),
          keywords: fields.keywords.value.trim(),
          language: fields.language.value,
          themeColor: fields.themeColorText.value.trim(),
          robotsIndex: fields.robotsIndex.value,
          robotsFollow: fields.robotsFollow.value,
          viewport: fields.viewport.checked,
          ogType: fields.ogType.value,
          ogLocale: fields.ogLocale.value.trim(),
          ogImage: fields.ogImage.value.trim(),
          ogImageWidth: fields.ogImageWidth.value.trim(),
          ogImageHeight: fields.ogImageHeight.value.trim(),
          ogImageAlt: fields.ogImageAlt.value.trim(),
          twCard: fields.twCard.value,
          twSite: fields.twSite.value.trim(),
          twCreator: fields.twCreator.value.trim(),
          twImage: fields.twImage.value.trim(),
          schemaType: fields.schemaType.value,
        };
      }

      function getDomain(url) {
        if (!url) return '';
        try {
          var u = new URL(url);
          return u.host;
        } catch (e) {
          return url.replace(/^https?:\/\//, '').split('/')[0];
        }
      }

      function getBreadcrumb(url) {
        if (!url) return '';
        try {
          var u = new URL(url);
          var path = u.pathname.replace(/^\/|\/$/g, '');
          if (!path) return u.host;
          return u.host + ' › ' + path.split('/').join(' › ');
        } catch (e) {
          return url;
        }
      }

      function buildHead(v) {
        var lines = [];
        if (v.viewport) lines.push('<meta name="viewport" content="width=device-width, initial-scale=1">');
        if (v.title) lines.push('<title>' + escapeHtml(v.title) + '</title>');
        if (v.description) lines.push('<meta name="description" content="' + escapeAttr(v.description) + '">');
        if (v.canonical) lines.push('<link rel="canonical" href="' + escapeAttr(v.canonical) + '">');
        if (v.author) lines.push('<meta name="author" content="' + escapeAttr(v.author) + '">');
        if (v.keywords) lines.push('<meta name="keywords" content="' + escapeAttr(v.keywords) + '">');
        if (v.themeColor) lines.push('<meta name="theme-color" content="' + escapeAttr(v.themeColor) + '">');
        lines.push('<meta name="robots" content="' + v.robotsIndex + ', ' + v.robotsFollow + '">');

        // Open Graph
        var hasOg = v.title || v.description || v.canonical || v.siteName || v.ogImage;
        if (hasOg) {
          lines.push('');
          lines.push('<!-- Open Graph / Facebook -->');
          lines.push('<meta property="og:type" content="' + v.ogType + '">');
          if (v.title) lines.push('<meta property="og:title" content="' + escapeAttr(v.title) + '">');
          if (v.description) lines.push('<meta property="og:description" content="' + escapeAttr(v.description) + '">');
          if (v.canonical) lines.push('<meta property="og:url" content="' + escapeAttr(v.canonical) + '">');
          if (v.siteName) lines.push('<meta property="og:site_name" content="' + escapeAttr(v.siteName) + '">');
          if (v.ogImage) lines.push('<meta property="og:image" content="' + escapeAttr(v.ogImage) + '">');
          if (v.ogImage && v.ogImageWidth) lines.push('<meta property="og:image:width" content="' + escapeAttr(v.ogImageWidth) + '">');
          if (v.ogImage && v.ogImageHeight) lines.push('<meta property="og:image:height" content="' + escapeAttr(v.ogImageHeight) + '">');
          if (v.ogImage && v.ogImageAlt) lines.push('<meta property="og:image:alt" content="' + escapeAttr(v.ogImageAlt) + '">');
          if (v.ogLocale) lines.push('<meta property="og:locale" content="' + escapeAttr(v.ogLocale) + '">');
        }

        // Twitter
        var hasTw = v.title || v.description || v.ogImage || v.twImage || v.twSite || v.twCreator;
        if (hasTw) {
          lines.push('');
          lines.push('<!-- Twitter Card -->');
          lines.push('<meta name="twitter:card" content="' + v.twCard + '">');
          if (v.twSite) lines.push('<meta name="twitter:site" content="' + escapeAttr(v.twSite) + '">');
          if (v.twCreator) lines.push('<meta name="twitter:creator" content="' + escapeAttr(v.twCreator) + '">');
          if (v.title) lines.push('<meta name="twitter:title" content="' + escapeAttr(v.title) + '">');
          if (v.description) lines.push('<meta name="twitter:description" content="' + escapeAttr(v.description) + '">');
          var twImage = v.twImage || v.ogImage;
          if (twImage) lines.push('<meta name="twitter:image" content="' + escapeAttr(twImage) + '">');
        }

        // Schema.org JSON-LD
        if (v.schemaType) {
          lines.push('');
          lines.push('<!-- Schema.org JSON-LD -->');
          var schema = { '@context': 'https://schema.org', '@type': v.schemaType };
          if (v.title) schema.name = v.title;
          if (v.description) schema.description = v.description;
          if (v.canonical) schema.url = v.canonical;
          if (v.ogImage) schema.image = v.ogImage;
          if (v.author && v.schemaType === 'Article') {
            schema.author = { '@type': 'Person', name: v.author };
          }
          // `<` is written as \u003c so a value containing a closing script tag cannot end the script element
          // in the page this block is pasted into; JSON parsers read both forms as the same string.
          var jsonLines = JSON.stringify(schema, null, 2).replace(/</g, '\\u003c').split('\n');
          lines.push('<script type="application/ld+json">');
          jsonLines.forEach(function (l) { lines.push(l); });
          lines.push('<\/script>');
        }

        return lines.join('\n');
      }

      /* ── engine:end ── */

      function placeholder(s) { return s || '—'; }
      function safeImg(url, fallback) {
        if (url) return escapeAttr(url);
        return fallback || '';
      }

      function renderPreview(v) {
        var hasAny = v.title || v.description || v.canonical || v.ogImage;
        if (!hasAny) {
          previewEl.innerHTML = '<div class="mtg-preview-empty">' + escapeHtml(t.fillToPreview) + '</div>';
          return;
        }

        var domain = getDomain(v.canonical) || (v.siteName ? v.siteName.toLowerCase().replace(/[^a-z0-9]+/g, '') + '.com' : 'example.com');
        var breadcrumb = getBreadcrumb(v.canonical) || domain;
        var titleText = v.title || 'Page Title';
        var descText = v.description || 'Description preview will appear here.';
        var siteText = v.siteName || domain;
        var imageUrl = v.ogImage || '';
        var twImageUrl = v.twImage || imageUrl;

        var html = '';
        if (currentPlatform === 'google') {
          html = '<div class="mtg-card mtg-google">' +
            '<div class="mtg-google-row">' +
              '<div class="mtg-google-favicon" aria-hidden="true"></div>' +
              '<div class="mtg-google-meta">' +
                '<div class="mtg-google-domain">' + escapeHtml(siteText) + '</div>' +
                '<div class="mtg-google-breadcrumb">' + escapeHtml(breadcrumb) + '</div>' +
              '</div>' +
            '</div>' +
            '<a class="mtg-google-title" href="#" onclick="return false;">' + escapeHtml(titleText) + '</a>' +
            '<p class="mtg-google-desc">' + escapeHtml(descText) + '</p>' +
          '</div>';
        } else if (currentPlatform === 'facebook') {
          html = '<div class="mtg-card mtg-fb">' +
            (imageUrl
              ? '<img class="mtg-fb-image" src="' + escapeAttr(imageUrl) + '" alt="" loading="lazy" />'
              : '<div class="mtg-fb-image mtg-image-empty">' + escapeHtml('og:image') + '</div>') +
            '<div class="mtg-fb-band">' +
              '<div class="mtg-fb-domain">' + escapeHtml(domain.toUpperCase()) + '</div>' +
              '<div class="mtg-fb-title">' + escapeHtml(titleText) + '</div>' +
              '<div class="mtg-fb-desc">' + escapeHtml(descText) + '</div>' +
            '</div>' +
          '</div>';
        } else if (currentPlatform === 'twitter') {
          if (v.twCard === 'summary') {
            html = '<div class="mtg-card mtg-twitter mtg-twitter-summary">' +
              (twImageUrl
                ? '<img class="mtg-twitter-img-small" src="' + escapeAttr(twImageUrl) + '" alt="" loading="lazy" />'
                : '<div class="mtg-twitter-img-small mtg-image-empty">img</div>') +
              '<div class="mtg-twitter-summary-band">' +
                '<div class="mtg-twitter-domain">' + escapeHtml(domain) + '</div>' +
                '<div class="mtg-twitter-title">' + escapeHtml(titleText) + '</div>' +
                '<div class="mtg-twitter-desc">' + escapeHtml(descText) + '</div>' +
              '</div>' +
            '</div>';
          } else {
            html = '<div class="mtg-card mtg-twitter">' +
              (twImageUrl
                ? '<img class="mtg-twitter-image" src="' + escapeAttr(twImageUrl) + '" alt="" loading="lazy" />'
                : '<div class="mtg-twitter-image mtg-image-empty">' + escapeHtml('twitter:image') + '</div>') +
              '<div class="mtg-twitter-band">' +
                '<div class="mtg-twitter-title">' + escapeHtml(titleText) + '</div>' +
                '<div class="mtg-twitter-domain">' + escapeHtml(domain) + '</div>' +
              '</div>' +
            '</div>';
          }
        } else if (currentPlatform === 'discord') {
          var bar = v.themeColor && /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/.test(v.themeColor) ? v.themeColor : '#5865f2';
          html = '<div class="mtg-card mtg-discord" style="--mtg-bar:' + escapeAttr(bar) + ';">' +
            '<div class="mtg-discord-bar" aria-hidden="true"></div>' +
            '<div class="mtg-discord-body">' +
              '<div class="mtg-discord-site">' + escapeHtml(siteText) + '</div>' +
              '<a class="mtg-discord-title" href="#" onclick="return false;">' + escapeHtml(titleText) + '</a>' +
              '<p class="mtg-discord-desc">' + escapeHtml(descText) + '</p>' +
              (imageUrl
                ? '<img class="mtg-discord-image" src="' + escapeAttr(imageUrl) + '" alt="" loading="lazy" />'
                : '') +
            '</div>' +
          '</div>';
        }

        previewEl.innerHTML = html;
      }

      var copyRequest = 0;
      var copyTimer = 0;
      function resetCopy() {
        copyRequest++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        copyBtn.classList.remove('copied');
      }

      function refreshOutput(v) {
        document.querySelector('.mtg-platform-view').setAttribute('data-empty', String(!(v.title || v.description || v.canonical || v.ogImage)));
      }

      function update() {
        resetCopy();
        var v = getValues();
        // counters
        if (titleCounter) titleCounter.textContent = (v.title.length) + ' / 60';
        if (descCounter) descCounter.textContent = (v.description.length) + ' / 160';
        // sync language → og:locale default if og:locale empty
        if (!fields.ogLocale.value) {
          var loc = v.language.replace('-', '_');
          if (loc && loc.length <= 6) {
            fields.ogLocale.placeholder = loc;
          }
        }
        var head = buildHead(v);
        outputEl.textContent = head;
        copyBtn.disabled = !head;
        renderPreview(v);
        refreshOutput(v);
        window.trackTool && window.trackTool('meta-tag-generator', 'update');
      }

      // Wire all inputs
      Object.keys(fields).forEach(function (k) {
        var el = fields[k];
        if (!el) return;
        var ev = (el.tagName === 'SELECT' || el.type === 'checkbox' || el.type === 'color') ? 'change' : 'input';
        el.addEventListener(ev, update);
        if (ev === 'change' && el.tagName === 'INPUT' && el.type !== 'checkbox') {
          el.addEventListener('input', update);
        }
      });

      // Sync color picker <-> text
      fields.themeColor.addEventListener('input', function () {
        fields.themeColorText.value = fields.themeColor.value;
        update();
      });
      fields.themeColorText.addEventListener('input', function () {
        var v = fields.themeColorText.value.trim();
        if (/^#[0-9a-fA-F]{6}$/.test(v) || /^#[0-9a-fA-F]{3}$/.test(v)) {
          fields.themeColor.value = v.length === 4
            ? '#' + v[1] + v[1] + v[2] + v[2] + v[3] + v[3]
            : v;
        }
        update();
      });

      // Tabs
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          tabs.forEach(function (x) { x.classList.remove('is-active'); x.setAttribute('aria-selected', 'false'); });
          tab.classList.add('is-active');
          tab.setAttribute('aria-selected', 'true');
          currentPlatform = tab.getAttribute('data-platform');
          update();
        });
      });

      // Copy
      copyBtn.addEventListener('click', function () {
        var val = outputEl.textContent;
        if (copyBtn.disabled || !val) return;
        resetCopy();
        var request = copyRequest;
        var done = function () {
          if (request !== copyRequest) return;
          copyBtn.textContent = t.copied;
          copyBtn.classList.add('copied');
          copyTimer = setTimeout(function () {
            if (request !== copyRequest) return;
            copyBtn.textContent = t.copy;
            copyBtn.classList.remove('copied');
          }, 1500);
        };
        function fallbackCopy() {
          if (request !== copyRequest) return;
          var ta = document.createElement('textarea');
          ta.value = val;
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          ta.setAttribute('readonly', '');
          document.body.appendChild(ta);
          ta.select();
          var ok = false;
          try { ok = document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta);
          if (ok) done();
          else copyBtn.textContent = t.copyFailed;
        }
        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function' && window.isSecureContext) {
          try { navigator.clipboard.writeText(val).then(done, fallbackCopy); }
          catch (e) { fallbackCopy(); }
        } else {
          fallbackCopy();
        }
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var wrap = document.querySelector('.mtg-wrap');
        if (!wrap || !document.activeElement || !wrap.contains(document.activeElement)) return;
        wrap.querySelectorAll('textarea, input[type="text"]').forEach(function (el) { el.value = ''; });
        update();
      });

      // Seed defaults so the preview is visible on first load.
      function seed() {
        if (!fields.title.value) fields.title.value = 'ZeroTool — Free browser-based dev utilities';
        if (!fields.description.value) fields.description.value = 'A growing library of one-task tools that run in your browser. No accounts, no uploads.';
        if (!fields.canonical.value) fields.canonical.value = 'https://zerotool.dev/';
        if (!fields.siteName.value) fields.siteName.value = 'ZeroTool';
        if (!fields.author.value) fields.author.value = 'ZeroTool Workshop';
        if (!fields.keywords.value) fields.keywords.value = 'dev tools, meta tags, open graph, twitter card';
        if (!fields.ogImage.value) fields.ogImage.value = 'https://zerotool.dev/og/json-formatter.png';
        if (!fields.ogImageWidth.value) fields.ogImageWidth.value = '1200';
        if (!fields.ogImageHeight.value) fields.ogImageHeight.value = '630';
        if (!fields.ogImageAlt.value) fields.ogImageAlt.value = 'ZeroTool cover image';
        if (!fields.ogLocale.value) fields.ogLocale.value = (pageLang === 'zh' ? 'zh_CN' : pageLang === 'ja' ? 'ja_JP' : pageLang === 'ko' ? 'ko_KR' : 'en_US');
        if (!fields.twSite.value) fields.twSite.value = '@zerotooldev';
        if (!fields.twCreator.value) fields.twCreator.value = '@zerotooldev';
      }

      seed();
      update();
    })();
  </script>
</div>

<style is:global>
  /* Base flex rules that the rules below override in part (formerly shared
     with the markdown table generator's .mtg-* rules). */
  .mtg-wrap { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; }
