---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: {
    empty: "Enter JSON or load the example to generate Python.",
    tips: {
      "input": "Enter valid JSON without comments or trailing commas. Generation runs 300 ms after typing stops; invalid JSON clears the output and shows an error.",
      "rootName": "A blank name uses Root. Changing the name generates again after 300 ms.",
      "mode": "Choose @dataclass, Pydantic v2 or TypedDict. Changing the mode generates again immediately.",
      "example": "Replace JSON with a sample containing nested objects, arrays and null, then generate immediately with the current settings.",
      "clear": "Clear JSON, output and status. Keep the root name and the selected mode. Ctrl/⌘+L with focus in the tool also clears the root name.",
      "copy": "Copy the complete displayed Python output. Empty output is not copied.",
      "download": "Save the complete displayed output as a .py file. The filename uses the lowercase root name; characters outside ASCII letters, digits and underscores become underscores. Empty output is not downloaded."
    },
    rootName: 'Root class name',
    mode: 'Mode',
    modeDataclass: '@dataclass',
    modePydantic: 'Pydantic v2',
    modeTypedDict: 'TypedDict',
    jsonInput: 'JSON Input',
    pythonOutput: 'Python Output',
    example: 'Example',
    clear: 'Clear',
    copy: 'Copy',
    copied: 'Copied!',
    copyFailed: 'Copy failed. Please copy the output manually.',
    download: 'Download .py',
    msgInvalidJson: 'Invalid JSON: ',
    msgFailed: 'Could not generate Python: ',
    msgGenerated: 'Generated.',
    msgGenOne: 'Generated 1 class.',
    msgGenMany: 'Generated {n} classes.',
  },
  zh: {
    empty: "输入 JSON 或载入示例以生成 Python。",
    tips: {
      "input": "输入合法 JSON，不能带注释或末尾逗号。停止输入 300 毫秒后自动生成；JSON 无效时会清空输出并显示错误。",
      "rootName": "留空时使用 Root。修改名称后，等待 300 毫秒自动生成。",
      "mode": "选择 @dataclass、Pydantic v2 或 TypedDict，切换后立即重新生成。",
      "example": "用含嵌套对象、数组和 null 的示例替换 JSON，并按当前设置立即生成。",
      "clear": "清空 JSON、输出和状态，保留根名和所选模式。在工具内按 Ctrl/⌘+L 还会清空根名。",
      "copy": "复制当前显示的完整 Python 输出。输出为空时不复制。",
      "download": "将当前完整输出保存为 .py 文件。文件名使用小写根名，ASCII 字母、数字和下划线以外的字符替换为下划线。输出为空时不下载。"
    },
    rootName: '根类名称',
    mode: '模式',
    modeDataclass: '@dataclass',
    modePydantic: 'Pydantic v2',
    modeTypedDict: 'TypedDict',
    jsonInput: 'JSON 输入',
    pythonOutput: 'Python 输出',
    example: '示例',
    clear: '清空',
    copy: '复制',
    copied: '已复制！',
    copyFailed: '复制失败，请手动复制输出。',
    download: '下载 .py',
    msgInvalidJson: 'JSON 格式错误：',
    msgFailed: '无法生成 Python：',
    msgGenerated: '已生成。',
    msgGenOne: '已生成 1 个类。',
    msgGenMany: '已生成 {n} 个类。',
  },
  ja: {
    empty: "JSON を入力するかサンプルを読み込むと、Python を生成します。",
    tips: {
      "input": "コメントや末尾のカンマを含まない有効な JSON を入力します。入力を止めてから 300 ミリ秒後に生成します。無効な JSON では出力を消去し、エラーを表示します。",
      "rootName": "空欄では Root を使います。名前を変更すると、300 ミリ秒後に再生成します。",
      "mode": "@dataclass、Pydantic v2、TypedDict から選択します。モードを変えると、すぐに再生成します。",
      "example": "JSON を、ネストされたオブジェクト、配列、null を含むサンプルに置き換え、現在の設定ですぐに生成します。",
      "clear": "JSON、出力、ステータスを消去し、ルート名と選択したモードを保持します。ツール内で Ctrl/⌘+L を押すとルート名も消去します。",
      "copy": "表示中の Python 出力を全文コピーします。出力が空の場合はコピーしません。",
      "download": "表示中の出力全体を .py ファイルに保存します。ファイル名はルート名を小文字にし、ASCII の英数字とアンダースコア以外をアンダースコアに置き換えます。空の出力は保存しません。"
    },
    rootName: 'ルートクラス名',
    mode: 'モード',
    modeDataclass: '@dataclass',
    modePydantic: 'Pydantic v2',
    modeTypedDict: 'TypedDict',
    jsonInput: 'JSON 入力',
    pythonOutput: 'Python 出力',
    example: 'サンプル',
    clear: 'クリア',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyFailed: 'コピーに失敗しました。出力を手動でコピーしてください。',
    download: '.py ダウンロード',
    msgInvalidJson: '無効なJSON：',
    msgFailed: 'Python を生成できませんでした：',
    msgGenerated: '生成しました。',
    msgGenOne: '1 個のクラスを生成しました。',
    msgGenMany: '{n} 個のクラスを生成しました。',
  },
  ko: {
    empty: "JSON을 입력하거나 예시를 불러와 Python 코드를 생성하세요.",
    tips: {
      "input": "주석이나 끝 쉼표가 없는 유효한 JSON을 입력하세요. 입력을 멈춘 뒤 300밀리초 후 생성합니다. JSON이 잘못되면 출력을 지우고 오류를 표시합니다.",
      "rootName": "비워 두면 Root를 사용합니다. 이름을 바꾸면 300밀리초 후 다시 생성합니다.",
      "mode": "@dataclass, Pydantic v2, TypedDict 중에서 선택하세요. 모드를 바꾸면 즉시 다시 생성합니다.",
      "example": "JSON을 중첩 객체, 배열, null이 포함된 예시로 바꾸고 현재 설정으로 즉시 생성합니다.",
      "clear": "JSON, 출력, 상태를 지우고 루트 이름과 선택한 모드는 유지합니다. 도구 안에서 Ctrl/⌘+L을 누르면 루트 이름도 지웁니다.",
      "copy": "현재 표시된 Python 출력 전체를 복사합니다. 출력이 비어 있으면 복사하지 않습니다.",
      "download": "현재 출력 전체를 .py 파일로 저장합니다. 파일명은 루트 이름을 소문자로 바꾸고 ASCII 영숫자와 밑줄 외의 문자를 밑줄로 바꿉니다. 빈 출력은 저장하지 않습니다."
    },
    rootName: '루트 클래스 이름',
    mode: '모드',
    modeDataclass: '@dataclass',
    modePydantic: 'Pydantic v2',
    modeTypedDict: 'TypedDict',
    jsonInput: 'JSON 입력',
    pythonOutput: 'Python 출력',
    example: '예시',
    clear: '지우기',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사하지 못했습니다. 출력을 직접 복사하세요.',
    download: '.py 다운로드',
    msgInvalidJson: '잘못된 JSON: ',
    msgFailed: 'Python 코드를 생성하지 못했습니다: ',
    msgGenerated: '생성 완료.',
    msgGenOne: '클래스 1개를 생성했습니다.',
    msgGenMany: '클래스 {n}개를 생성했습니다.',
  },
};

const L = STRINGS[lang];
---

<div
  class="jpdc-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-download={L.download}
  data-msg-invalid-json={L.msgInvalidJson}
  data-msg-failed={L.msgFailed}
  data-msg-generated={L.msgGenerated}
  data-msg-gen-one={L.msgGenOne}
  data-msg-gen-many={L.msgGenMany}
>
  <div class="jpdc-config">
    <div class="jpdc-name-field">
      <div class="jpdc-control-label">
        <label for="jpdc-root-name">{L.rootName}</label>
        <Toggletip id="jpdc-tip-root-name" lang={lang} about={L.rootName}>{L.tips.rootName}</Toggletip>
      </div>
      <input id="jpdc-root-name" type="text" value="Root" spellcheck="false" />
    </div>
    <div class="jpdc-option-field">
      <div class="jpdc-control-label"><span id="jpdc-mode-label">{L.mode}</span><Toggletip id="jpdc-tip-mode" lang={lang} about={L.mode}>{L.tips.mode}</Toggletip></div>
      <div class="jpdc-tabs zt-segmented" role="group" aria-labelledby="jpdc-mode-label" id="jpdc-mode-tabs">
        <button type="button" class="jpdc-tab active" aria-pressed="true" data-mode="dataclass">{L.modeDataclass}</button>
        <button type="button" class="jpdc-tab" aria-pressed="false" data-mode="pydantic">{L.modePydantic}</button>
        <button type="button" class="jpdc-tab" aria-pressed="false" data-mode="typeddict">{L.modeTypedDict}</button>
      </div>
    </div>
  </div>
  <div class="jpdc-actions">
    <div class="jpdc-control-label">
      <button id="jpdc-example" class="btn-ghost" type="button">{L.example}</button>
      <Toggletip id="jpdc-tip-example" lang={lang} about={L.example}>{L.tips.example}</Toggletip>
    </div>
    <div class="jpdc-control-label">
      <button id="jpdc-clear" class="btn-ghost" type="button">{L.clear}</button>
      <Toggletip id="jpdc-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip>
    </div>
  </div>
  <div id="jpdc-status" class="jpdc-status" aria-live="polite"></div>
  <div class="jpdc-panels zt-io">
    <div class="jpdc-panel zt-io-pane">
      <div class="jpdc-panel-header">
        <div class="jpdc-control-label">
          <label for="jpdc-input">{L.jsonInput}</label>
          <Toggletip id="jpdc-tip-input" lang={lang} about={L.jsonInput}>{L.tips.input}</Toggletip>
        </div>
      </div>
      <textarea id="jpdc-input" class="zt-io-fill" placeholder='{"name": "Alice", "age": 30}' spellcheck="false"></textarea>
    </div>
    <div class="jpdc-panel jpdc-output-pane zt-io-pane">
      <div class="jpdc-panel-header">
        <span id="jpdc-output-label">{L.pythonOutput}</span>
        <div class="jpdc-output-actions">
    <div class="jpdc-control-label">
      <button id="jpdc-copy" class="btn-ghost" type="button">{L.copy}</button>
      <Toggletip id="jpdc-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip>
    </div>
    <div class="jpdc-control-label">
      <button id="jpdc-download" class="btn-ghost" type="button">{L.download}</button>
      <Toggletip id="jpdc-tip-download" lang={lang} about={L.download}>{L.tips.download}</Toggletip>
    </div>
        </div>
      </div>
      <p class="jpdc-empty zt-io-fill">{L.empty}</p>
      <pre id="jpdc-output" class="jpdc-output zt-io-fill" tabindex="0" aria-labelledby="jpdc-output-label"><code id="jpdc-output-code"></code></pre>
    </div>
  </div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.jpdc-wrap')
        : document.querySelector('.jpdc-wrap');

      var COPY = wrap ? wrap.dataset.copy : 'Copy';
      var COPIED = wrap ? wrap.dataset.copied : 'Copied!';
      var COPY_FAILED = wrap ? wrap.dataset.copyFailed : 'Copy failed. Please copy the output manually.';
      var DOWNLOAD = wrap ? wrap.dataset.download : 'Download .py';
      var MSG_INVALID = wrap ? wrap.dataset.msgInvalidJson : 'Invalid JSON: ';
      var MSG_FAILED = wrap ? wrap.dataset.msgFailed : 'Could not generate Python: ';
      var MSG_GENERATED = wrap ? wrap.dataset.msgGenerated : 'Generated.';
      var MSG_GEN_ONE = wrap ? wrap.dataset.msgGenOne : 'Generated 1 class.';
      var MSG_GEN_MANY = wrap ? wrap.dataset.msgGenMany : 'Generated {n} classes.';

      var inputEl = document.getElementById('jpdc-input');
      var outputCodeEl = document.getElementById('jpdc-output-code');
      var statusEl = document.getElementById('jpdc-status');
      var rootNameEl = document.getElementById('jpdc-root-name');
      var copyBtn = document.getElementById('jpdc-copy');
      var copyRevision = 0;
      var copyTimer = null;
      var copyFailure = false;

      // Copy is enabled only while there is output to copy.
      function setOutput(text) {
        outputCodeEl.textContent = text;
        copyBtn.disabled = !text;
      }
      setOutput('');

      var currentMode = 'dataclass';

      var EXAMPLE = JSON.stringify({
        id: 1,
        name: "Alice",
        is_active: true,
        score: 9.5,
        tags: ["python", "json"],
        address: {
          city: "London",
          zip_code: "EC1A 1BB"
        },
        friends: [
          { id: 2, name: "Bob" },
          { id: 3, name: "Carol" }
        ],
        metadata: null
      }, null, 2);

      var tabs = wrap ? wrap.querySelectorAll('.jpdc-tab') : [];
      for (var ti = 0; ti < tabs.length; ti++) {
        (function (tab) {
          tab.addEventListener('click', function () {
            var changed = currentMode !== tab.dataset.mode;
            for (var j = 0; j < tabs.length; j++) {
              tabs[j].classList.remove('active');
              tabs[j].setAttribute('aria-pressed', 'false');
            }
            tab.classList.add('active');
            tab.setAttribute('aria-pressed', 'true');
            currentMode = tab.dataset.mode;
            convert();
            if (changed) trackGenerate();
          });
        })(tabs[ti]);
      }

      function setStatus(msg, isError) {
        copyFailure = false;
        statusEl.textContent = msg;
        statusEl.className = 'jpdc-status ' + (isError ? 'error' : 'success');
      }
      function clearStatus() {
        copyFailure = false;
        statusEl.textContent = '';
        statusEl.className = 'jpdc-status';
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        if (copyFailure) clearStatus();
      }

      /* ── engine:start ── */
      // Class name for a key by the Python identifier rules (PEP 3131): NFKC as Python reads
      // identifiers; words split at "_" and at characters that cannot be in an identifier; each word
      // starts with a capital (letters without case stay); "_" before a leading digit.
      function toPascalCase(str) {
        var words = String(str).normalize('NFKC').split(/[^\p{ID_Continue}]+|_+/u);
        var name = '';
        for (var i = 0; i < words.length; i++) {
          if (words[i]) name += words[i].charAt(0).toUpperCase() + words[i].slice(1);
        }
        if (!name) return 'Field';
        return /^\p{ID_Start}/u.test(name) ? name : '_' + name;
      }

      // Names a class must not take: keywords, the names the output imports or uses as types, and
      // every JSON key (a Pydantic field with a default shadows a class of the same name).
      var RESERVED_NAMES = ['False', 'None', 'True', 'and', 'as', 'assert', 'async', 'await', 'break', 'class', 'continue', 'def', 'del', 'elif', 'else', 'except', 'finally', 'for', 'from', 'global', 'if', 'import', 'in', 'is', 'lambda', 'nonlocal', 'not', 'or', 'pass', 'raise', 'return', 'try', 'while', 'with', 'yield', 'Any', 'List', 'NotRequired', 'Optional', 'TypedDict', 'Union', 'BaseModel', 'Field', 'dataclass', 'str', 'int', 'float', 'bool'];
      function reserveNames(taken, parsed) {
        for (var i = 0; i < RESERVED_NAMES.length; i++) taken[RESERVED_NAMES[i]] = true;
        var stack = [parsed];
        while (stack.length) {
          var v = stack.pop();
          if (Array.isArray(v)) { for (var j = 0; j < v.length; j++) stack.push(v[j]); }
          else if (isPlainObject(v)) {
            var ks = Object.keys(v);
            for (var k = 0; k < ks.length; k++) { taken[ks[k].normalize('NFKC')] = true; stack.push(v[ks[k]]); }
          }
        }
      }

      function isPlainObject(v) {
        return v !== null && typeof v === 'object' && !Array.isArray(v);
      }

      // ctx: classes (name → fields), taken (names in use) and shapes (stem + fields → name).
      function inferPythonType(value, key, ctx, imp, parentStem) {
        if (value === null) {
          imp.any = true;
          return 'Any';
        }
        if (typeof value === 'boolean') return 'bool';
        if (typeof value === 'number') {
          return Number.isInteger(value) ? 'int' : 'float';
        }
        if (typeof value === 'string') return 'str';

        if (Array.isArray(value)) {
          imp.list = true;
          if (value.length === 0) {
            imp.any = true;
            return 'List[Any]';
          }
          var objectItems = [];
          var primitiveTypes = [];
          var subArrays = [], subAt = -1;
          for (var i = 0; i < value.length; i++) {
            var item = value[i];
            if (isPlainObject(item)) {
              objectItems.push(item);
            } else if (Array.isArray(item)) {
              // The sub-arrays of one array are samples of one element type: read them together.
              if (subAt === -1) { subAt = primitiveTypes.length; primitiveTypes.push(null); }
              subArrays.push(item);
            } else {
              var t = inferPythonType(item, key + 'Item', ctx, imp, parentStem);
              if (primitiveTypes.indexOf(t) === -1) primitiveTypes.push(t);
            }
          }
          if (subAt !== -1) {
            var joinedItems = [];
            for (var si = 0; si < subArrays.length; si++) for (var sj = 0; sj < subArrays[si].length; sj++) joinedItems.push(subArrays[si][sj]);
            var subType = inferPythonType(joinedItems, key + 'Item', ctx, imp, parentStem);
            if (primitiveTypes.indexOf(subType) === -1) primitiveTypes[subAt] = subType;
            else primitiveTypes.splice(subAt, 1);
          }
          if (objectItems.length > 0) {
            var itemClassName = mergeObjectsToClass(objectItems, toPascalCase(key) + 'Item', parentStem, ctx, imp);
            if (primitiveTypes.indexOf(itemClassName) === -1) primitiveTypes.push(itemClassName);
          }
          if (primitiveTypes.length === 0) {
            imp.any = true;
            return 'List[Any]';
          }
          if (primitiveTypes.length === 1) return 'List[' + primitiveTypes[0] + ']';
          imp.union = true;
          return 'List[Union[' + primitiveTypes.join(', ') + ']]';
        }

        if (typeof value === 'object') return mergeObjectsToClass([value], toPascalCase(key), parentStem, ctx, imp);

        imp.any = true;
        return 'Any';
      }

      // One class from one or more objects. Every sample of a key counts: its objects merge into one
      // class and its arrays into one list. A class with the same stem and fields is reused; another
      // shape gets the parent stem as a prefix (b.meta → BMeta), then a number (Meta2).
      function mergeObjectsToClass(objects, stem, parentStem, ctx, imp, fixedName) {
        var totalCount = objects.length;
        var allKeys = Object.create(null);
        var keyList = [];
        for (var i = 0; i < objects.length; i++) {
          var ks = Object.keys(objects[i]);
          for (var j = 0; j < ks.length; j++) {
            if (!allKeys[ks[j]]) { allKeys[ks[j]] = []; keyList.push(ks[j]); }
            allKeys[ks[j]].push(objects[i][ks[j]]);
          }
        }

        var fields = [];
        for (var ki = 0; ki < keyList.length; ki++) {
          var k = keyList[ki];
          var vals = allKeys[k];
          var missing = vals.length < totalCount;
          var present = vals.filter(function (v) { return v !== null; });
          var nullable = present.length < vals.length;
          var objs = present.filter(isPlainObject);
          var arrs = present.filter(function (v) { return Array.isArray(v); });

          var types = [];
          for (var vi = 0; vi < present.length; vi++) {
            var v = present[vi], t = null;
            if (isPlainObject(v)) { if (v === objs[0]) t = mergeObjectsToClass(objs, toPascalCase(k), stem, ctx, imp); }
            else if (Array.isArray(v)) {
              if (v === arrs[0]) {
                // A loop, not concat.apply: spreading ~100,000 arrays as arguments overflows the stack.
                var joined = [];
                for (var ai = 0; ai < arrs.length; ai++) for (var aj = 0; aj < arrs[ai].length; aj++) joined.push(arrs[ai][aj]);
                t = inferPythonType(joined, k, ctx, imp, stem);
              }
            }
            else t = inferPythonType(v, k, ctx, imp, stem);
            if (t !== null && types.indexOf(t) === -1) types.push(t);
          }

          // PEP 484 lets int stand in for float, so int and float together are float.
          if (types.length === 2 && types.indexOf('int') >= 0 && types.indexOf('float') >= 0) types = ['float'];
          if (types.length === 0) {
            imp.any = true;
            types = ['Any'];
          }

          var type;
          if (types.length === 1) {
            type = types[0];
          } else {
            imp.union = true;
            type = 'Union[' + types.join(', ') + ']';
          }

          var optional = missing || nullable;
          if (optional) imp.optional = true;
          fields.push({ key: k, type: type, optional: optional, missing: missing, nullable: nullable });
        }

        var sig = JSON.stringify(fields.map(function (f) { return [f.key, f.type, f.optional, f.missing, f.nullable]; }));
        if (!fixedName) {
          for (var si = 0; si < ctx.shapes.length; si++) {
            if (ctx.shapes[si].stem === stem && ctx.shapes[si].sig === sig) return ctx.shapes[si].name;
          }
        }
        var name = fixedName || null;
        var candidates = [stem, parentStem + stem];
        for (var ci = 0; ci < candidates.length && !name; ci++) {
          if (!ctx.taken[candidates[ci]]) name = candidates[ci];
        }
        for (var n = 2; !name; n++) if (!ctx.taken[stem + n]) name = stem + n;
        ctx.taken[name] = true;
        // Children are inserted first; topoSort orders the output anyway.
        ctx.classes[name] = fields;
        ctx.shapes.push({ stem: stem, sig: sig, name: name });
        return name;
      }

      // Public attributes of pydantic.BaseModel (Pydantic 2.13): a field with one of these names fails
      // (model_config, model_dump) or hides the method.
      var BASEMODEL_ATTRS = ['construct', 'copy', 'dict', 'from_orm', 'json', 'model_computed_fields', 'model_config', 'model_construct', 'model_copy', 'model_dump', 'model_dump_json', 'model_extra', 'model_fields', 'model_fields_set', 'model_json_schema', 'model_parametrized_name', 'model_post_init', 'model_rebuild', 'model_validate', 'model_validate_json', 'model_validate_strings', 'parse_file', 'parse_obj', 'parse_raw', 'schema', 'schema_json', 'update_forward_refs', 'validate'];

      // Field name for each key. A key is kept when it is already a usable name: a Python identifier
      // as typed (NFKC leaves it unchanged), not a keyword or a name the annotations use (a field
      // with a default would hide it), not starting with "__" (mangled in a class body), and for
      // Pydantic not starting with "_" (private attribute) or "model_", or naming a BaseModel attribute. Other
      // keys get a name from their identifier characters with "_" added until it is free.
      function pyFieldNames(fields, mode, classNames) {
        var used = Object.create(null), names = [];
        function usable(n) {
          return /^[\p{ID_Start}_]\p{ID_Continue}*$/u.test(n) && n === n.normalize('NFKC') &&
            RESERVED_NAMES.indexOf(n) === -1 && !/^__/.test(n) && !(classNames && classNames[n]) &&
            !(mode === 'pydantic' && (/^_|^model_/.test(n) || BASEMODEL_ATTRS.indexOf(n) !== -1));
        }
        for (var i = 0; i < fields.length; i++) if (usable(fields[i].key)) used[fields[i].key] = true;
        for (var i = 0; i < fields.length; i++) {
          var key = fields[i].key;
          if (usable(key)) { names.push(key); continue; }
          var n = key.normalize('NFKC').replace(/[^\p{ID_Continue}]+/gu, '_');
          n = mode === 'pydantic' ? n.replace(/^_+/, '') : n.replace(/^_{2,}/, '_');
          if (!n) n = 'field';
          if (!/^[\p{ID_Start}_]/u.test(n)) n = (mode === 'pydantic' ? 'field_' : '_') + n;
          // Pydantic names its own members model_…; its protected namespaces warn on such fields.
          if (mode === 'pydantic' && /^model_/.test(n)) n = 'field_' + n;
          if (!usable(n)) n += '_';
          for (var c = n, k = 2; used[c] || !usable(c); k++) c = n + k;
          n = c;
          used[n] = true;
          names.push(n);
        }
        return names;
      }

      function renderClass(name, fields, mode, classNames) {
        if (!fields) return '';
        var names = pyFieldNames(fields, mode, classNames);
        var entries = fields.map(function (f, i) { return { f: f, name: names[i] }; });
        var ordered = entries.filter(function (e) { return !e.f.optional; }).concat(entries.filter(function (e) { return e.f.optional; }));

        var lines = [];

        if (mode === 'dataclass') {
          lines.push('@dataclass');
          lines.push('class ' + name + ':');
          if (ordered.length === 0) {
            lines.push('    pass');
          } else {
            for (var i = 0; i < ordered.length; i++) {
              var f = ordered[i].f, n = ordered[i].name;
              var note = n === f.key ? '' : '  # JSON key: ' + JSON.stringify(f.key);
              if (f.optional) {
                lines.push('    ' + n + ': Optional[' + f.type + '] = None' + note);
              } else {
                lines.push('    ' + n + ': ' + f.type + note);
              }
            }
          }
        } else if (mode === 'pydantic') {
          lines.push('class ' + name + '(BaseModel):');
          if (ordered.length === 0) {
            lines.push('    pass');
          } else {
            for (var i = 0; i < ordered.length; i++) {
              var f = ordered[i].f, n = ordered[i].name;
              var alias = n === f.key ? null : 'alias=' + JSON.stringify(f.key);
              if (f.optional) {
                lines.push('    ' + n + ': Optional[' + f.type + '] = ' + (alias ? 'Field(default=None, ' + alias + ')' : 'None'));
              } else {
                lines.push('    ' + n + ': ' + f.type + (alias ? ' = Field(' + alias + ')' : ''));
              }
            }
          }
        } else {
          /* TypedDict: a key missing from some samples is NotRequired (PEP 655); a key whose
             value can be null is Optional. Keys keep their JSON order. Keys that cannot be class
             attributes use the functional syntax, which keeps every key as it is. */
          var functional = entries.some(function (e) { return e.name !== e.f.key; });
          lines.push(functional ? name + ' = TypedDict(' + JSON.stringify(name) + ', {' : 'class ' + name + '(TypedDict):');
          if (fields.length === 0 && !functional) {
            lines.push('    pass');
          } else {
            for (var i = 0; i < fields.length; i++) {
              var f = fields[i];
              var tt = f.nullable ? 'Optional[' + f.type + ']' : f.type;
              if (f.missing) tt = 'NotRequired[' + tt + ']';
              lines.push(functional ? '    ' + JSON.stringify(f.key) + ': ' + tt + ',' : '    ' + f.key + ': ' + tt);
            }
          }
          if (functional) lines.push('})');
        }
        return lines.join('\n');
      }

      function topoSort(classes) {
        var names = Object.keys(classes);
        var nameSet = Object.create(null);
        for (var i = 0; i < names.length; i++) nameSet[names[i]] = true;

        var deps = Object.create(null);
        var identRe = /[\p{ID_Start}_]\p{ID_Continue}*/gu;
        for (var i = 0; i < names.length; i++) {
          var n = names[i];
          deps[n] = [];
          var fields = classes[n];
          if (!fields) continue;
          for (var j = 0; j < fields.length; j++) {
            identRe.lastIndex = 0;
            var m;
            while ((m = identRe.exec(fields[j].type)) !== null) {
              var dep = m[0];
              if (dep !== n && nameSet[dep] && deps[n].indexOf(dep) === -1) {
                deps[n].push(dep);
              }
            }
          }
        }

        var inDegree = Object.create(null);
        var rev = Object.create(null);
        for (var i = 0; i < names.length; i++) {
          inDegree[names[i]] = 0;
          rev[names[i]] = [];
        }
        for (var i = 0; i < names.length; i++) {
          var n = names[i];
          var d = deps[n];
          for (var j = 0; j < d.length; j++) {
            inDegree[n]++;
            rev[d[j]].push(n);
          }
        }

        var queue = [];
        for (var i = 0; i < names.length; i++) {
          if (inDegree[names[i]] === 0) queue.push(names[i]);
        }

        var ordered = [];
        while (queue.length > 0) {
          var cur = queue.shift();
          ordered.push(cur);
          var dependents = rev[cur];
          for (var i = 0; i < dependents.length; i++) {
            if (--inDegree[dependents[i]] === 0) queue.push(dependents[i]);
          }
        }

        // Cycle fallback: append remaining in insertion order
        for (var i = 0; i < names.length; i++) {
          if (ordered.indexOf(names[i]) === -1) ordered.push(names[i]);
        }

        return ordered;
      }

      function renderAll(classes, mode, alias) {
        var imp = {};
        // Field names must not take a generated class or alias name (Pydantic would read the field).
        var classNames = Object.create(null);
        Object.keys(classes).forEach(function (n) { classNames[n] = true; });
        if (alias) classNames[alias.name] = true;

        // Re-scan classes to collect imports (already set during build, but
        // we reference the global imp object from buildClass/merge calls,
        // so we pass the same one here)
        var needDataclass = mode === 'dataclass';
        var needPydantic = mode === 'pydantic';
        var needTypedDict = mode === 'typeddict';

        var names = Object.keys(classes);
        var importLines = [];

        if (needDataclass) importLines.push('from dataclasses import dataclass');
        if (needPydantic) {
          var needField = Object.keys(classes).some(function (n) {
            var fs = classes[n] || [], ns = pyFieldNames(fs, 'pydantic', classNames);
            return fs.some(function (f, i) { return ns[i] !== f.key; });
          });
          importLines.push('from pydantic import BaseModel' + (needField ? ', Field' : ''));
        }

        // Collect typing imports by scanning classes
        var hasOptional = false, hasList = false, hasAny = false, hasUnion = false, hasTypedDict = needTypedDict;
        var hasNotRequired = false;
        for (var i = 0; i < names.length; i++) {
          var fields = classes[names[i]];
          if (!fields) continue;
          for (var j = 0; j < fields.length; j++) {
            var f = fields[j];
            if (needTypedDict ? f.nullable : f.optional) hasOptional = true;
            if (needTypedDict && f.missing) hasNotRequired = true;
            var t = f.type;
            if (t.indexOf('List[') !== -1) hasList = true;
            if (t.indexOf('Any') !== -1) hasAny = true;
            if (t.indexOf('Union[') !== -1) hasUnion = true;
          }
        }
        if (alias) {
          hasList = true;
          if (alias.type.indexOf('Any') !== -1) hasAny = true;
          if (alias.type.indexOf('Union[') !== -1) hasUnion = true;
        }
        var typingParts = [];
        if (hasAny) typingParts.push('Any');
        if (hasList) typingParts.push('List');
        if (hasNotRequired) typingParts.push('NotRequired');
        if (hasOptional) typingParts.push('Optional');
        if (hasTypedDict) typingParts.push('TypedDict');
        if (hasUnion) typingParts.push('Union');
        typingParts.sort();
        if (typingParts.length > 0) {
          importLines.push('from typing import ' + typingParts.join(', '));
        }

        var orderedNames = topoSort(classes);
        var blocks = [];
        for (var i = 0; i < orderedNames.length; i++) {
          var rendered = renderClass(orderedNames[i], classes[orderedNames[i]], mode, classNames);
          if (rendered) blocks.push(rendered);
        }

        var result = importLines.length > 0 ? importLines.join('\n') + '\n\n' : '';
        result += blocks.join('\n\n');
        if (alias) result += '\n\n' + alias.name + ' = ' + alias.type;
        return result;
      }

      // Root class name: as typed (NFKC) when it is a Python identifier that is not reserved;
      // otherwise built like a key's class name (order-item → OrderItem, 2fa → _2fa); "_" after a
      // reserved name (class → class_); Root when no identifier character is left.
      function cleanRootName(raw) {
        var s = String(raw).normalize('NFKC');
        if (!/\p{ID_Continue}/u.test(s)) return 'Root';
        var name = /^[\p{ID_Start}_]\p{ID_Continue}*$/u.test(s) ? s : toPascalCase(s);
        // Nested classes take the root name as a prefix; a name starting with "__" would be mangled
        // inside class bodies (Python private name mangling), so keep one leading "_".
        name = name.replace(/^_{2,}/, '_');
        return RESERVED_NAMES.indexOf(name) === -1 ? name : name + '_';
      }

      /* Classes for an object or an array of objects; null for other roots. */
      function generatePython(parsed, rootName, mode) {
        rootName = cleanRootName(rootName);
        var ctx = { classes: Object.create(null), taken: Object.create(null), shapes: [] }, imp = {}, alias = null;
        reserveNames(ctx.taken, parsed);
        ctx.taken[rootName] = true;
        if (isPlainObject(parsed)) {
          mergeObjectsToClass([parsed], rootName, '', ctx, imp, rootName);
        } else if (Array.isArray(parsed)) {
          var objectItems = parsed.filter(isPlainObject);
          if (!objectItems.length) return null;
          // Values beside the objects stay in a module-level alias: <root>Array = List[Union[...]].
          var others = parsed.filter(function (v) { return !isPlainObject(v); });
          if (others.length) {
            var aliasName = rootName + 'Array';
            for (var n = 2; ctx.taken[aliasName]; n++) aliasName = rootName + 'Array' + n;
            ctx.taken[aliasName] = true;
          }
          mergeObjectsToClass(objectItems, rootName, '', ctx, imp, rootName);
          if (others.length) {
            var elementTypes = [];
            for (var oi = 0; oi < others.length; oi++) {
              var et = others[oi] === null ? 'None' : inferPythonType(others[oi], rootName, ctx, imp, '');
              if (elementTypes.indexOf(et) === -1) elementTypes.push(et);
            }
            elementTypes.push(rootName);
            alias = { name: aliasName, type: 'List[Union[' + elementTypes.join(', ') + ']]' };
          }
        } else {
          return null;
        }
        return { code: renderAll(ctx.classes, mode, alias), count: Object.keys(ctx.classes).length };
      }
      /* ── engine:end ── */

      function convert() {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = null;
        var raw = inputEl.value.trim();
        if (!raw) { inputEl.classList.remove('error'); clearStatus(); setOutput(''); return; }
        inputEl.classList.remove('error');

        var parsed;
        try {
          parsed = JSON.parse(raw);
        } catch (e) {
          inputEl.classList.add('error');
          setOutput('');
          setStatus(MSG_INVALID + e.message, true);
          return;
        }

        inputEl.classList.remove('error');
        var rootName = rootNameEl.value.trim() || 'Root';
        var r;
        try {
          r = generatePython(parsed, rootName, currentMode);
        } catch (e) {
          // For example a stack overflow on very deep nesting: never leave the previous output.
          setOutput('');
          setStatus(MSG_FAILED + (e && e.message ? e.message : String(e)), true);
          return;
        }
        if (!r) {
          setOutput(Array.isArray(parsed)
            ? '# Array of primitives — no class to generate'
            : '# Primitive value — no class to generate');
          setStatus(MSG_GENERATED, false);
          return;
        }
        setOutput(r.code);
        var msg = r.count === 1 ? MSG_GEN_ONE : MSG_GEN_MANY.replace('{n}', r.count);
        setStatus(msg, false);
      }

      // Analytics: one event per committed edit (change), Example or new mode, only when code is
      // shown; not after each typing pause.
      function trackGenerate() {
        if (outputCodeEl.textContent) window.trackTool && window.trackTool('json-to-python-dataclass', 'generate');
      }

      var _liveTimer = null;
      inputEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = setTimeout(convert, 300);
      });
      rootNameEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = setTimeout(convert, 300);
      });
      // A committed edit runs a pending generation first, so the event matches the shown code.
      function commitEdit() {
        if (_liveTimer) convert();
        trackGenerate();
      }
      inputEl.addEventListener('change', commitEdit);
      rootNameEl.addEventListener('change', commitEdit);

      document.getElementById('jpdc-example').addEventListener('click', function () {
        inputEl.value = EXAMPLE;
        inputEl.classList.remove('error');
        clearStatus();
        convert();
        trackGenerate();
      });

      document.getElementById('jpdc-clear').addEventListener('click', function () {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = null;
        inputEl.value = '';
        setOutput('');
        inputEl.classList.remove('error');
        clearStatus();
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l' || !wrap.contains(document.activeElement)) return;
        e.preventDefault();
        inputEl.focus();
        document.getElementById('jpdc-clear').click();
      });

      copyBtn.addEventListener('click', function () {
        var text = outputCodeEl.textContent;
        if (!text) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(COPY_FAILED, true);
          copyFailure = true;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            if (copyFailure) clearStatus();
            copyBtn.textContent = COPIED;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = COPY;
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });

      document.getElementById('jpdc-download').addEventListener('click', function () {
        var text = outputCodeEl.textContent;
        if (!text) return;
        var blob = new Blob([text], { type: 'text/plain' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = (rootNameEl.value.trim() || 'root').toLowerCase().replace(/[^a-z0-9_]/g, '_') + '.py';
        a.click();
        URL.revokeObjectURL(url);
      });
    })();
  </script>
</div>

<style>
  .jpdc-wrap { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; gap: 0.75rem; }
  .jpdc-config { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .jpdc-name-field { display: flex; flex-direction: column; gap: 0.25rem; width: 18rem; max-width: 100%; }
  .jpdc-control-label { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .jpdc-config label { font-size: 0.85rem; color: var(--color-text-secondary); display: flex; align-items: center; gap: 0.4rem; }
  .jpdc-name-field input {
    min-height: 44px; width: 100%; padding: 0.4rem 0.6rem; font-size: 0.85rem;
    font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg); color: var(--color-text);
  }
  .jpdc-name-field input:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jpdc-panel-header { display: flex; justify-content: space-between; align-items: center; min-height: 44px; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .jpdc-panel textarea, .jpdc-output {
    width: 100%; min-width: 0; font-family: var(--font-mono); font-size: 0.82rem; padding: 0.75rem;
    border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg-secondary); color: var(--color-text); line-height: 1.5;
  }
  .jpdc-panel textarea { transition: border-color 0.15s; }
  .jpdc-panel textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }
  .jpdc-panel textarea.error { border-color: #c0392b; }
  .jpdc-output { margin: 0; overflow: auto; white-space: pre; }
  .jpdc-output:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jpdc-empty { display: none; margin: 0; padding: 2rem; align-items: center; justify-content: center; text-align: center; color: var(--color-text-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .jpdc-output-pane:has(#jpdc-output-code:empty) .jpdc-output { display: none; }
  .jpdc-output-pane:has(#jpdc-output-code:empty) .jpdc-empty { display: flex; }
  .jpdc-actions { display: flex; gap: 0.5rem 1rem; flex-wrap: wrap; }
  .jpdc-status { font-size: 0.85rem; line-height: 1.4; height: 2.8rem; flex: none; overflow: auto; overflow-wrap: anywhere; }
  .jpdc-status.success { color: #057a55; }
  .jpdc-status.error { color: #c0392b; }
  .jpdc-actions button, .jpdc-panel-header button { min-height: 44px; }
  .jpdc-output-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 860px) {
    .jpdc-wrap { gap: 0.5rem; }
    .jpdc-name-field { width: 100%; flex-direction: row; align-items: center; gap: 0.5rem; }
    .jpdc-name-field .jpdc-control-label { flex: 1; }
    .jpdc-name-field input { width: 45%; flex: none; }
    .jpdc-actions button, .jpdc-panel-header button { min-height: 44px; }
    .jpdc-panel textarea { height: 144px; min-height: 144px; }
    .jpdc-output { height: 22rem; min-height: 160px; resize: none; }
    .jpdc-output-pane:has(#jpdc-output-code:empty) { display: none; }
  }
  @media (max-width: 640px) {
    .jpdc-wrap { gap: 0.25rem; }
    .jpdc-status { height: 2.4rem; }
    .jpdc-panel textarea { height: 120px; min-height: 120px; }
    .jpdc-panel-header { flex-wrap: wrap; }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .jpdc-status.success { color: #34d399; }
    :global(:root:not([data-theme="light"])) .jpdc-status.error { color: #f87171; }
    :global(:root:not([data-theme="light"])) .jpdc-panel textarea.error { border-color: #f87171; }
  }
  :global([data-theme="dark"]) .jpdc-status.success { color: #34d399; }
  :global([data-theme="dark"]) .jpdc-status.error { color: #f87171; }
  :global([data-theme="dark"]) .jpdc-panel textarea.error { border-color: #f87171; }
  .jpdc-option-field { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .jpdc-option-field > .jpdc-control-label { font-size: 0.85rem; color: var(--color-text-secondary); }
  .jpdc-tabs { padding: 0.15rem; background: var(--color-bg-secondary); gap: 0.15rem; }
  .jpdc-tab { min-height: 44px; padding: 0.3rem 0.65rem; border: 0; border-radius: 999px; background: transparent; color: var(--color-text-secondary); font-size: 0.78rem; cursor: pointer; white-space: nowrap; }
  .jpdc-tab:hover { color: var(--color-text); }
  .jpdc-tab.active { background: var(--color-text); color: var(--color-bg); }
  .jpdc-tab:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  @media (max-width: 860px) {
    .jpdc-option-field { width: 100%; }
    .jpdc-tab { flex: 1; min-width: 0; padding-inline: 0.35rem; }
  }
</style>
