---
// SvgToJsxTool — SVG to React JSX component converter, pure JS, zero deps
---
<div class="stj-wrap">
  <div class="stj-options">
    <div class="stj-opt-row">
      <label class="stj-opt-label" for="stj-name" data-i18n="componentName">Component name</label>
      <input id="stj-name" class="stj-name-input" type="text" value="MyIcon" spellcheck="false" autocomplete="off" />
    </div>
    <div class="stj-opt-row">
      <label class="stj-checkbox-label">
        <input type="checkbox" id="stj-typescript" />
        <span data-i18n="typescript">TypeScript (React.FC)</span>
      </label>
      <label class="stj-checkbox-label">
        <input type="checkbox" id="stj-forwardref" />
        <span data-i18n="forwardRef">forwardRef</span>
      </label>
      <label class="stj-checkbox-label">
        <input type="checkbox" id="stj-memo" />
        <span data-i18n="memo">memo</span>
      </label>
    </div>
  </div>

  <div class="stj-panes">
    <div class="stj-pane">
      <label class="stj-label" for="stj-input" data-i18n="inputLabel">SVG Input</label>
      <textarea
        id="stj-input"
        class="stj-textarea"
        spellcheck="false"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        data-i18n-ph="placeholder"
        placeholder="<!-- paste your SVG here -->"
      ></textarea>
    </div>
    <div class="stj-pane">
      <div class="stj-pane-header">
        <label class="stj-label" for="stj-output" data-i18n="outputLabel">JSX Output</label>
        <button id="stj-copy" class="stj-copy-btn" data-i18n="copy">Copy</button>
      </div>
      <textarea
        id="stj-output"
        class="stj-textarea stj-textarea--output"
        spellcheck="false"
        readonly
      ></textarea>
    </div>
  </div>

  <p id="stj-status" role="status" aria-live="polite"></p>

  <script is:inline>
    (function () {
      var STRINGS = {
        en: {
          inputLabel: 'SVG Input',
          outputLabel: 'JSX Output',
          copy: 'Copy',
          copied: 'Copied!',
          placeholder: '<!-- paste your SVG here -->',
          componentName: 'Component name',
          typescript: 'TypeScript (React.FC)',
          forwardRef: 'forwardRef',
          memo: 'memo',
          refused: 'Cannot convert style at position {position}: {reason}. Output cleared.',
          reasons: { syntax: 'invalid declaration or unclosed CSS syntax', property: 'unsupported or escaped property name', duplicate: 'repeated property cannot preserve CSS fallback order', priority: '!important cannot be preserved in a React style object', comment: 'CSS comments require manual conversion' },
        },
        zh: {
          inputLabel: 'SVG 输入',
          outputLabel: 'JSX 输出',
          copy: '复制',
          copied: '已复制！',
          placeholder: '<!-- 粘贴 SVG 到这里 -->',
          componentName: '组件名称',
          typescript: 'TypeScript (React.FC)',
          forwardRef: 'forwardRef 包裹',
          memo: 'memo 包裹',
          refused: '样式第 {position} 个字符无法转换：{reason}。已清空输出。',
          reasons: { syntax: '声明无效或 CSS 语法未闭合', property: '属性名不支持或含转义', duplicate: '重复属性无法保留 CSS 回退顺序', priority: 'React 样式对象无法保留 !important', comment: 'CSS 注释需要手动转换' },
        },
        ja: {
          inputLabel: 'SVG 入力',
          outputLabel: 'JSX 出力',
          copy: 'コピー',
          copied: 'コピー済み！',
          placeholder: '<!-- SVGをここに貼り付け -->',
          componentName: 'コンポーネント名',
          typescript: 'TypeScript (React.FC)',
          forwardRef: 'forwardRef ラップ',
          memo: 'memo ラップ',
          refused: 'スタイルの {position} 文字目を変換できません：{reason}。出力を消去しました。',
          reasons: { syntax: '宣言が無効、または CSS 構文が閉じていません', property: '未対応またはエスケープされたプロパティ名', duplicate: '重複プロパティの CSS フォールバック順序を保持できません', priority: 'React のスタイルオブジェクトでは !important を保持できません', comment: 'CSS コメントは手動で変換してください' },
        },
        ko: {
          inputLabel: 'SVG 입력',
          outputLabel: 'JSX 출력',
          copy: '복사',
          copied: '복사됨!',
          placeholder: '<!-- SVG를 여기에 붙여넣기 -->',
          componentName: '컴포넌트 이름',
          typescript: 'TypeScript (React.FC)',
          forwardRef: 'forwardRef 래핑',
          memo: 'memo 래핑',
          refused: '스타일 {position}번째 문자를 변환할 수 없습니다: {reason}. 출력을 지웠습니다.',
          reasons: { syntax: '잘못된 선언 또는 닫히지 않은 CSS 구문', property: '지원하지 않거나 이스케이프된 속성 이름', duplicate: '중복 속성의 CSS 대체 순서를 보존할 수 없습니다', priority: 'React 스타일 객체는 !important를 보존할 수 없습니다', comment: 'CSS 주석은 직접 변환해야 합니다' },
        },
      };

      var pageLang = (document.documentElement.lang || 'en').slice(0, 2);
      var t = STRINGS[pageLang] || STRINGS.en;

      document.querySelectorAll('.stj-wrap [data-i18n]').forEach(function (el) {
        var key = el.getAttribute('data-i18n');
        if (t[key]) el.textContent = t[key];
      });
      document.querySelectorAll('.stj-wrap [data-i18n-ph]').forEach(function (el) {
        var key = el.getAttribute('data-i18n-ph');
        if (t[key]) el.placeholder = t[key];
      });

      var inputEl  = document.getElementById('stj-input');
      var outputEl = document.getElementById('stj-output');
      var copyBtn  = document.getElementById('stj-copy');
      var statusEl = document.getElementById('stj-status');
      var nameEl   = document.getElementById('stj-name');
      var tsEl     = document.getElementById('stj-typescript');
      var frEl     = document.getElementById('stj-forwardref');
      var memoEl   = document.getElementById('stj-memo');

      /* ── engine:start ── */
      // SVG attribute → JSX camelCase map
      var SVG_ATTR_MAP = {
        'stroke-width':          'strokeWidth',
        'stroke-linecap':        'strokeLinecap',
        'stroke-linejoin':       'strokeLinejoin',
        'stroke-dasharray':      'strokeDasharray',
        'stroke-dashoffset':     'strokeDashoffset',
        'stroke-miterlimit':     'strokeMiterlimit',
        'stroke-opacity':        'strokeOpacity',
        'fill-rule':             'fillRule',
        'fill-opacity':          'fillOpacity',
        'clip-rule':             'clipRule',
        'clip-path':             'clipPath',
        'color-interpolation':   'colorInterpolation',
        'color-rendering':       'colorRendering',
        'dominant-baseline':     'dominantBaseline',
        'enable-background':     'enableBackground',
        'flood-color':           'floodColor',
        'flood-opacity':         'floodOpacity',
        'font-family':           'fontFamily',
        'font-size':             'fontSize',
        'font-size-adjust':      'fontSizeAdjust',
        'font-stretch':          'fontStretch',
        'font-style':            'fontStyle',
        'font-variant':          'fontVariant',
        'font-weight':           'fontWeight',
        'glyph-orientation-horizontal': 'glyphOrientationHorizontal',
        'glyph-orientation-vertical':   'glyphOrientationVertical',
        'image-rendering':       'imageRendering',
        'letter-spacing':        'letterSpacing',
        'lighting-color':        'lightingColor',
        'marker-end':            'markerEnd',
        'marker-mid':            'markerMid',
        'marker-start':          'markerStart',
        'overline-position':     'overlinePosition',
        'overline-thickness':    'overlineThickness',
        'paint-order':           'paintOrder',
        'pointer-events':        'pointerEvents',
        'shape-rendering':       'shapeRendering',
        'stop-color':            'stopColor',
        'stop-opacity':          'stopOpacity',
        'strikethrough-position':   'strikethroughPosition',
        'strikethrough-thickness':  'strikethroughThickness',
        'text-anchor':           'textAnchor',
        'text-decoration':       'textDecoration',
        'text-rendering':        'textRendering',
        'underline-position':    'underlinePosition',
        'underline-thickness':   'underlineThickness',
        'unicode-bidi':          'unicodeBidi',
        'vector-effect':         'vectorEffect',
        'word-spacing':          'wordSpacing',
        'writing-mode':          'writingMode',
        // HTML attrs also valid in SVG
        'class':                 'className',
        'tabindex':              'tabIndex',
        'crossorigin':           'crossOrigin',
        'xlink:href':            'xlinkHref',
        'xlink:actuate':         'xlinkActuate',
        'xlink:arcrole':         'xlinkArcrole',
        'xlink:role':            'xlinkRole',
        'xlink:show':            'xlinkShow',
        'xlink:title':           'xlinkTitle',
        'xlink:type':            'xlinkType',
        'xml:base':              'xmlBase',
        'xml:lang':              'xmlLang',
        'xml:space':             'xmlSpace',
      };

      // Same CSS and text lowering as HtmlToJsxTool; keep the copied declarations in sync.
      var NAMED_ENTITIES = { quot: '"', apos: "'", amp: '&', lt: '<', gt: '>', nbsp: '\u00a0' };
      function decodeEntities(str) {
        return str.replace(/&(#[xX][0-9a-fA-F]+|#[0-9]+|[a-zA-Z]+);/g, function (m, ref) {
          if (ref.charAt(0) === '#') {
            var code = ref.charAt(1) === 'x' || ref.charAt(1) === 'X'
              ? parseInt(ref.slice(2), 16)
              : parseInt(ref.slice(1), 10);
            return code > 0 && code <= 0x10ffff ? String.fromCodePoint(code) : m;
          }
          return Object.prototype.hasOwnProperty.call(NAMED_ENTITIES, ref) ? NAMED_ENTITIES[ref] : m;
        });
      }
      function jsxString(value) {
        return JSON.stringify(value).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
      }
      function styleError(code, position) {
        var error = new Error(code + ' at style position ' + (position + 1));
        error.code = code;
        error.position = position;
        throw error;
      }
      function styleStringToObject(styleStr) {
        var props = [];
        var seen = Object.create(null);
        var start = 0, colon = -1, valueEnd = 0, quote = '', stack = [];
        function declaration(end) {
          if (/^[ \t\n\r\f]*$/.test(styleStr.slice(start, end))) return;
          if (colon < start) styleError('syntax', start);
          var prop = styleStr.slice(start, colon).replace(/^[ \t\n\r\f]+|[ \t\n\r\f]+$/g, '');
          var val = styleStr.slice(colon + 1, valueEnd).replace(/^[ \t\n\r\f]+/, '');
          if (!val) styleError('syntax', colon + 1);
          if (!/^(?:--[a-zA-Z0-9_-]+|-?[a-zA-Z][a-zA-Z0-9-]*)$/.test(prop)) styleError('property', start);
          var custom = prop.indexOf('--') === 0;
          var key = custom ? prop : prop.toLowerCase();
          if (seen[key]) styleError('duplicate', start);
          seen[key] = true;
          var jsProp = custom ? prop : key.replace(/^-ms-/, 'ms-').replace(/-([a-z])/g, function (_, c) { return c.toUpperCase(); });
          props.push(jsxString(jsProp) + ': ' + jsxString(val));
        }
        for (var i = 0; i < styleStr.length; i++) {
          var c = styleStr[i];
          if (c === '\\') {
            if (i + 1 === styleStr.length) styleError('syntax', i);
            i++;
            if (/[\n\r\f]/.test(styleStr[i])) {
              if (!quote) styleError('syntax', i - 1);
              if (styleStr[i] === '\r' && styleStr[i + 1] === '\n') i++;
            } else if (/[0-9a-fA-F]/.test(styleStr[i])) {
              var count = 1;
              while (count < 6 && /[0-9a-fA-F]/.test(styleStr[i + 1] || '')) { i++; count++; }
              if (/[ \t\n\r\f]/.test(styleStr[i + 1] || '')) {
                i++;
                if (styleStr[i] === '\r' && styleStr[i + 1] === '\n') i++;
              }
            }
            if (colon >= start) valueEnd = i + 1;
            continue;
          }
          if (colon >= start && !/[ \t\n\r\f]/.test(c) && (c !== ';' || quote || stack.length)) valueEnd = i + 1;
          if (quote) {
            if (c === quote) quote = '';
            else if (/[\n\r\f]/.test(c)) styleError('syntax', i);
            continue;
          }
          if (c === '"' || c === "'") { quote = c; continue; }
          if (c === '/' && styleStr[i + 1] === '*') styleError('comment', i);
          if (c === '(' || c === '[' || c === '{') { stack.push(c); continue; }
          if (c === ')' || c === ']' || c === '}') {
            if (stack.pop() !== { ')': '(', ']': '[', '}': '{' }[c]) styleError('syntax', i);
            continue;
          }
          if (!stack.length) {
            if (c === '!') styleError('priority', i);
            if (c === ':' && colon < start) { colon = i; valueEnd = i + 1; }
            if (c === ';') { declaration(i); start = i + 1; colon = -1; }
          }
        }
        if (quote || stack.length) styleError('syntax', styleStr.length);
        declaration(styleStr.length);
        return '{{ ' + props.join(', ') + ' }}';
      }
      function jsxText(text) {
        return text.replace(/[{}<>]/g, function (c) { return { '{': '&#123;', '}': '&#125;', '<': '&lt;', '>': '&gt;' }[c]; });
      }

      // Generic camelCase converter for any remaining hyphenated attrs
      function toCamelCase(attr) {
        return attr.replace(/-([a-z])/g, function (_, c) { return c.toUpperCase(); });
      }

      // JSX name for one attribute name: known map first, then camelCase for any other
      // hyphenated name (data-*, aria-* excluded)
      function jsxAttrName(name) {
        var lower = name.toLowerCase();
        if (Object.prototype.hasOwnProperty.call(SVG_ATTR_MAP, lower)) return SVG_ATTR_MAP[lower];
        if (/^[a-z]+(?:-[a-z]+)+$/.test(name) && !/^(data|aria)-/.test(name)) return toCamelCase(name);
        return name;
      }

      // Process names and inline styles; ordinary values keep their original quoting.
      var ATTR_RE = /(\s+)([^\s"'>\/=]+)(?:\s*=\s*("[^"]*"|'[^']*'|[^\s"'=<>`]+))?/g;
      function processAttrs(attrStr) {
        if (!attrStr) return '';
        return attrStr.replace(ATTR_RE, function (_, space, name, rawValue) {
          if (name === 'xmlns' || name.indexOf('xmlns:') === 0) return '';
          if (rawValue === undefined) return space + jsxAttrName(name);
          var quote = rawValue.charAt(0);
          var quoted = quote === '"' || quote === "'";
          if (name.toLowerCase() === 'style') {
            var value = quoted ? rawValue.slice(1, -1) : rawValue;
            return space + 'style=' + styleStringToObject(decodeEntities(value));
          }
          return space + jsxAttrName(name) + '=' + (quoted ? rawValue : '"' + rawValue + '"');
        });
      }

      var TAG_RE = /<([a-zA-Z][a-zA-Z0-9.-]*)((?:\s+[^\s"'>\/=]+(?:\s*=\s*(?:"[^"]*"|'[^']*'|[^\s"'=<>`]+))?)*)\s*(\/?)>/g;

      // Indent all lines by N spaces (for wrapping)
      function indent(str, spaces) {
        var pad = new Array(spaces + 1).join(' ');
        return str.split('\n').map(function (l) { return l ? pad + l : l; }).join('\n');
      }

      // Main: convert SVG string to JSX component
      function svgToJsx(svgStr, compName, useTs, useForwardRef, useMemo) {
        if (!svgStr.trim()) return '';

        // 1. Remove XML declaration
        var result = svgStr.replace(/<\?xml[^?]*\?>/g, '').trim();

        // Tokenize original SVG nodes before producing JSX expressions. CSS text stays a
        // string; comments cannot expose their embedded tags to attribute conversion.
        var spreadDone = false;
        var tokens = new RegExp('<!--[\\s\\S]*?-->|<style\\b(?:"[^"]*"|\'[^\']*\'|[^\'">])*?>[\\s\\S]*?<\\/style\\s*>|<!\\[CDATA\\[[\\s\\S]*?\\]\\]>|<\\/[a-zA-Z][a-zA-Z0-9.-]*\\s*>|' + TAG_RE.source, 'g');
        var out = '', cursor = 0, match;
        while ((match = tokens.exec(result))) {
          out += jsxText(result.slice(cursor, match.index));
          cursor = tokens.lastIndex;
          var raw = match[0];
          if (raw.indexOf('<!--') === 0) {
            out += '{/*' + raw.slice(4, -3).replace(/\*\//g, '* /') + '*/}';
            continue;
          }
          if (raw.indexOf('<![CDATA[') === 0) { out += '{' + jsxString(raw.slice(9, -3)) + '}'; continue; }
          if (raw.indexOf('</') === 0) { out += raw; continue; }
          var tagMatch = new RegExp('^' + TAG_RE.source).exec(raw);
          var tag = tagMatch[1], attrs = tagMatch[2], selfClose = tagMatch[3];
          var processed = processAttrs(attrs || '');
          if (!spreadDone && tag === 'svg') {
            spreadDone = true;
            processed += useForwardRef ? ' ref={ref} {...props}' : ' {...props}';
          }
          if (tag === 'style' && !selfClose) {
            var css = raw.slice(tagMatch[0].length).replace(/<\/style\s*>$/, '');
            css = css.split(/(<!\[CDATA\[[\s\S]*?\]\]>)/g).map(function (part) {
              return part.indexOf('<![CDATA[') === 0 ? part.slice(9, -3) : decodeEntities(part);
            }).join('');
            out += '<style' + processed + '>{' + jsxString(css) + '}</style>';
          } else out += '<' + tag + processed + (selfClose ? ' />' : '>');
        }
        result = out + jsxText(result.slice(cursor));

        // 4. Indent the SVG body
        result = indent(result, 4);

        // 5. Build component
        var nl = '\n';
        var propsType = useTs ? ': React.SVGProps<SVGSVGElement>' : '';
        var fcType    = useTs ? ': React.FC<React.SVGProps<SVGSVGElement>>' : '';

        var importLine = useTs ? "import React from 'react';" : "import React from 'react';";
        var memoImport = useMemo    ? ', memo'       : '';
        var frImport   = useForwardRef ? ', forwardRef' : '';

        // Build imports
        var imports;
        if (useMemo || useForwardRef) {
          imports = "import React" + (useForwardRef || useMemo ? ', { ' + [useForwardRef && 'forwardRef', useMemo && 'memo'].filter(Boolean).join(', ') + ' }' : '') + " from 'react';";
        } else {
          imports = "import React from 'react';";
        }

        var innerFn;
        if (useForwardRef) {
          if (useTs) {
            innerFn = 'const ' + compName + ' = forwardRef<SVGSVGElement, React.SVGProps<SVGSVGElement>>(function ' + compName + '(props, ref) {' + nl
              + '  return (' + nl + result + nl + '  );' + nl + '});';
          } else {
            innerFn = 'const ' + compName + ' = forwardRef(function ' + compName + '(props, ref) {' + nl
              + '  return (' + nl + result + nl + '  );' + nl + '});';
          }
        } else {
          if (useTs) {
            innerFn = 'const ' + compName + fcType + ' = function(props) {' + nl
              + '  return (' + nl + result + nl + '  );' + nl + '};';
          } else {
            innerFn = 'function ' + compName + '(props) {' + nl
              + '  return (' + nl + result + nl + '  );' + nl + '}';
          }
        }

        var exportLine;
        if (useMemo) {
          exportLine = nl + nl + 'export default memo(' + compName + ');';
        } else {
          exportLine = nl + nl + 'export default ' + compName + ';';
        }

        return imports + nl + nl + innerFn + exportLine;
      }
      /* ── engine:end ── */

      function convert() {
        var svg   = inputEl.value;
        var name  = (nameEl.value.trim() || 'MyIcon').replace(/[^a-zA-Z0-9_$]/g, '');
        // Ensure component name starts with uppercase
        if (name && name[0] >= 'a' && name[0] <= 'z') name = name[0].toUpperCase() + name.slice(1);
        var useTs = tsEl.checked;
        var useFr = frEl.checked;
        var useMemo = memoEl.checked;
        statusEl.textContent = '';
        try {
          outputEl.value = svg ? svgToJsx(svg, name || 'MyIcon', useTs, useFr, useMemo) : '';
          copyBtn.disabled = !outputEl.value;
          if (svg) window.trackTool && window.trackTool('svg_to_jsx', 'convert');
        } catch (error) {
          outputEl.value = '';
          copyBtn.disabled = true;
          statusEl.textContent = t.refused.replace('{position}', error.position + 1).replace('{reason}', t.reasons[error.code] || t.reasons.syntax);
        }
      }

      var _debounce;
      function debounced() {
        clearTimeout(_debounce);
        _debounce = setTimeout(convert, 200);
      }

      inputEl.addEventListener('input', debounced);
      nameEl.addEventListener('input', debounced);
      tsEl.addEventListener('change', convert);
      frEl.addEventListener('change', convert);
      memoEl.addEventListener('change', convert);

      copyBtn.addEventListener('click', function () {
        var text = outputEl.value;
        if (!text) return;
        navigator.clipboard.writeText(text).then(function () {
          copyBtn.textContent = t.copied;
          setTimeout(function () { copyBtn.textContent = t.copy; }, 1500);
        });
      });
    })();
  </script>
</div>

<style>
  .stj-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stj-options {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.65rem 0.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .stj-opt-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stj-opt-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .stj-name-input {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    width: 10rem;
  }

  .stj-name-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .stj-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    cursor: pointer;
    user-select: none;
  }

  .stj-panes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .stj-panes {
      grid-template-columns: 1fr;
    }
  }

  .stj-pane {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .stj-pane-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .stj-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .stj-textarea {
