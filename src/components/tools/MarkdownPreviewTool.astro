---
// MarkdownPreviewTool — reusable widget, no props needed
---
<div>
  <div class="mp-wrap">
    <div class="mp-toolbar">
      <button id="mp-copy-html" class="btn-secondary" data-i18n="copyHtml">Copy HTML</button>
      <button id="mp-clear" class="btn-ghost" data-i18n="clear">Clear</button>
      <span id="mp-word-count" class="mp-word-count"></span>
    </div>
    <div class="mp-panes">
      <div class="mp-pane mp-editor-pane">
        <div class="mp-pane-label" data-i18n="markdownLabel">Markdown</div>
        <textarea
          id="mp-editor"
          spellcheck="false"
          placeholder="# Hello, World!&#10;&#10;Type your **Markdown** here..."
        ></textarea>
      </div>
      <div class="mp-pane mp-preview-pane">
        <div class="mp-pane-label" data-i18n="previewLabel">Preview</div>
        <div id="mp-preview" class="mp-preview prose"></div>
      </div>
    </div>
    <div id="mp-status" class="mp-status" aria-live="polite"></div>
  </div>

  <script>
    import hljs from 'highlight.js/lib/core';
    import javascript from 'highlight.js/lib/languages/javascript';
    import typescript from 'highlight.js/lib/languages/typescript';
    import python from 'highlight.js/lib/languages/python';
    import go from 'highlight.js/lib/languages/go';
    import php from 'highlight.js/lib/languages/php';
    import ruby from 'highlight.js/lib/languages/ruby';
    import java from 'highlight.js/lib/languages/java';
    import bash from 'highlight.js/lib/languages/bash';
    import json from 'highlight.js/lib/languages/json';
    import xml from 'highlight.js/lib/languages/xml';
    import css from 'highlight.js/lib/languages/css';
    import markdown from 'highlight.js/lib/languages/markdown';
    import { micromark } from 'micromark';
    import { gfm, gfmHtml } from 'micromark-extension-gfm';

    hljs.registerLanguage('javascript', javascript);
    hljs.registerLanguage('js', javascript);
    hljs.registerLanguage('typescript', typescript);
    hljs.registerLanguage('ts', typescript);
    hljs.registerLanguage('python', python);
    hljs.registerLanguage('py', python);
    hljs.registerLanguage('go', go);
    hljs.registerLanguage('php', php);
    hljs.registerLanguage('ruby', ruby);
    hljs.registerLanguage('rb', ruby);
    hljs.registerLanguage('java', java);
    hljs.registerLanguage('bash', bash);
    hljs.registerLanguage('sh', bash);
    hljs.registerLanguage('shell', bash);
    hljs.registerLanguage('json', json);
    hljs.registerLanguage('xml', xml);
    hljs.registerLanguage('html', xml);
    hljs.registerLanguage('css', css);
    hljs.registerLanguage('markdown', markdown);
    hljs.registerLanguage('md', markdown);

    var STRINGS = {
      en: { copyHtml: 'Copy HTML', clear: 'Clear', copied: 'Copied!', markdownLabel: 'Markdown', previewLabel: 'Preview', wordsSep: 'words', charsSep: 'chars' },
      zh: { copyHtml: '复制 HTML', clear: '清除', copied: '已复制！', markdownLabel: 'Markdown', previewLabel: '预览', wordsSep: '词', charsSep: '字符' },
      ja: { copyHtml: 'HTML コピー', clear: 'クリア', copied: 'コピー済み！', markdownLabel: 'Markdown', previewLabel: 'プレビュー', wordsSep: '語', charsSep: '文字' },
      ko: { copyHtml: 'HTML 복사', clear: '지우기', copied: '복사됨!', markdownLabel: 'Markdown', previewLabel: '미리보기', wordsSep: '단어', charsSep: '문자' }
    };

    var pageLang = (document.documentElement.lang || 'en').slice(0, 2);
    var t = STRINGS[pageLang] || STRINGS.en;
    document.querySelectorAll('[data-i18n]').forEach(function(el) {
      var key = el.getAttribute('data-i18n'); if (t[key]) el.textContent = t[key];
    });
    document.querySelectorAll('[data-i18n-ph]').forEach(function(el) {
      var key = el.getAttribute('data-i18n-ph'); if (t[key]) el.placeholder = t[key];
    });

    // CommonMark + GFM (tables, task lists, strikethrough, autolink literals, footnotes) via
    // micromark. Raw HTML is escaped and shown as text, and link / image URLs other than
    // http(s), mailto, irc(s), xmpp (links) or http(s) (images) and relative URLs are emptied:
    // micromark's defaults (allowDangerousHtml / allowDangerousProtocol false). The preview runs
    // on the zerotool.dev origin, so markup from pasted text must never become live elements.
    /* ── engine:start ── */
    function renderMarkdown(src, lib) {
      return lib.micromark(src, {
        extensions: [lib.gfm()],
        htmlExtensions: [lib.gfmHtml()],
        allowDangerousHtml: false,
        allowDangerousProtocol: false,
      });
    }
    /* ── engine:end ── */

    var editor = document.getElementById('mp-editor') as HTMLTextAreaElement;
    var preview = document.getElementById('mp-preview') as HTMLElement;
    var wordCount = document.getElementById('mp-word-count') as HTMLElement;

    var mdLib = { micromark: micromark, gfm: gfm, gfmHtml: gfmHtml };
    var lastHtml = '';

    function update() {
      var src = editor.value;
      lastHtml = renderMarkdown(src, mdLib);
      preview.innerHTML = lastHtml;
      // Open links in a new tab so a click does not leave the page and lose the text.
      preview.querySelectorAll('a[href]').forEach(function(a) {
        var href = a.getAttribute('href') || '';
        if (href.charAt(0) === '#') return;
        a.setAttribute('target', '_blank');
        a.setAttribute('rel', 'noopener noreferrer');
      });
      preview.querySelectorAll('pre code').forEach(function(el) {
        (el as HTMLElement).removeAttribute('data-highlighted');
        hljs.highlightElement(el as HTMLElement);
      });
      var words = src.trim() ? src.trim().split(/\s+/).length : 0;
      var chars = src.length;
      wordCount.textContent = words + ' ' + t.wordsSep + ' · ' + chars + ' ' + t.charsSep;
    }

    var _mpTimer: ReturnType<typeof setTimeout> | null = null;
    editor.addEventListener('input', function () {
      clearTimeout(_mpTimer!);
      _mpTimer = setTimeout(update, 300);
    });

    document.getElementById('mp-copy-html')!.addEventListener('click', function () {
      // The renderer's own HTML: no highlight.js spans and no target attributes added for the preview.
      var html = lastHtml;
      if (!html) return;
      navigator.clipboard.writeText(html).then(function () {
        var btn = document.getElementById('mp-copy-html') as HTMLElement;
        btn.textContent = t.copied;
        setTimeout(function () { btn.textContent = t.copyHtml; }, 1500);
      });
      (window as any).trackTool && (window as any).trackTool('markdown_preview', 'copy_html');
    });

    document.getElementById('mp-clear')!.addEventListener('click', function () {
      editor.value = '';
      lastHtml = '';
      preview.innerHTML = '';
      wordCount.textContent = '';
    });

    // Default content
    editor.value = [
      '# Welcome to Markdown Preview',
      '',
      'This is a **live** Markdown editor. Changes render _instantly_ to the right.',
      '',
      '## Features',
      '',
      '- Headings H1–H6',
      '- **Bold**, _italic_, ~~strikethrough~~',
      '- `inline code` and fenced code blocks',
      '- [Links](https://zerotool.dev) and images',
      '- Tables (GFM)',
      '- Task lists',
      '',
      '## Code Example',
      '',
      '```js',
      'const greet = name => `Hello, ${name}!`;',
      'console.log(greet("ZeroTool"));',
      '```',
      '',
      '## Table',
      '',
      '| Name | Role |',
      '|------|------|',
      '| Alice | Engineer |',
      '| Bob | Designer |',
      '',
      '## Task List',
      '',
      '- [x] Build 5 tools',
      '- [ ] Deploy to production',
    ].join('\n');
    update();
  </script>
</div>

<style>
  .mp-wrap { display: flex; flex-direction: column; gap: 0.5rem; }

  .mp-toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .mp-word-count {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .mp-panes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    min-height: 320px;
  }

  @media (max-width: 600px) {
    .mp-panes { grid-template-columns: 1fr; }
  }

  .mp-pane { display: flex; flex-direction: column; gap: 0.3rem; }

  .mp-pane-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mp-editor-pane textarea {
    flex: 1;
    width: 100%;
    min-height: 300px;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    resize: vertical;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    line-height: 1.6;
    box-sizing: border-box;
  }

  .mp-editor-pane textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .mp-preview {
    flex: 1;
    min-height: 300px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    overflow-y: auto;
    line-height: 1.7;
  }

  /* Prose styles inside preview. The preview content is set with innerHTML, so it has no
     scoped attributes and every rule below must be :global. */
  .mp-preview :global(h1), .mp-preview :global(h2), .mp-preview :global(h3),
  .mp-preview :global(h4), .mp-preview :global(h5), .mp-preview :global(h6) {
    margin: 1rem 0 0.4rem;
    line-height: 1.3;
  }
  .mp-preview :global(h1) { font-size: 1.6rem; }
  .mp-preview :global(h2) { font-size: 1.3rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.2rem; }
  .mp-preview :global(h3) { font-size: 1.1rem; }
  .mp-preview :global(p) { margin: 0.5rem 0; }
  .mp-preview :global(code) { background: var(--color-bg-icon); padding: 0.1rem 0.3rem; border-radius: 3px; font-size: 0.88em; }
  .mp-preview :global(pre) { padding: 0; border-radius: var(--radius-sm); overflow-x: auto; margin: 0.75rem 0; }
  .mp-preview :global(pre code.hljs) { border-radius: var(--radius-sm); font-size: 0.86rem; font-family: var(--font-mono); line-height: 1.5; }
  .mp-preview :global(blockquote) { border-left: 3px solid var(--color-primary); margin: 0.75rem 0; padding: 0.25rem 1rem; color: var(--color-text-secondary); background: #f8f9ff; border-radius: 0 4px 4px 0; }
  .mp-preview :global(ul), .mp-preview :global(ol) { padding-left: 1.5rem; margin: 0.4rem 0; }
  .mp-preview :global(li) { margin: 0.2rem 0; }
  .mp-preview :global(table) { border-collapse: collapse; width: 100%; margin: 0.75rem 0; font-size: 0.9rem; }
  .mp-preview :global(th), .mp-preview :global(td) { border: 1px solid var(--color-border); padding: 0.4rem 0.75rem; text-align: left; }
  .mp-preview :global(th[align="center"]), .mp-preview :global(td[align="center"]) { text-align: center; }
  .mp-preview :global(th[align="right"]), .mp-preview :global(td[align="right"]) { text-align: right; }
  .mp-preview :global(th) { background: var(--color-bg-icon); font-weight: 600; }
  .mp-preview :global(hr) { border: none; border-top: 1px solid var(--color-border); margin: 1rem 0; }
  .mp-preview :global(a) { color: var(--color-primary); text-decoration: underline; text-underline-offset: 0.18em; }
  .mp-preview :global(del) { color: var(--color-text-muted); }
  .mp-preview :global(img) { max-width: 100%; border-radius: 4px; }
  .mp-preview :global(.footnotes) { margin-top: 1.5rem; border-top: 1px solid var(--color-border); font-size: 0.9rem; }
  .mp-preview :global(.sr-only) { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .mp-status { font-size: 0.85rem; min-height: 1.2rem; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .mp-preview :global(blockquote) { background: rgba(59, 158, 255, 0.08); }
  }
  [data-theme="dark"] .mp-preview :global(blockquote) { background: rgba(59, 158, 255, 0.08); }
</style>
