---
import Toggletip from '../Toggletip.astro';
const { lang = 'en' } = Astro.props;
// strings:start
const STRINGS = {
  "en": {
    "copyHtml": "Copy HTML",
    "clear": "Clear",
    "copied": "Copied!",
    "copyFailed": "Copy failed",
    "markdownLabel": "Markdown",
    "previewLabel": "Preview",
    "wordsSep": "words",
    "charsSep": "chars",
    "countLabel": "Word and character count",
    "emptyPreview": "Your rendered Markdown will appear here.",
    "imageNotice": "Preview images load from their addresses. The image host can see your IP address and browser details.",
    "tips": {
      "editor": "Type or paste CommonMark or GitHub Flavored Markdown. The preview updates 300 ms after you stop typing.",
      "preview": "Raw HTML is shown as text. Supported code blocks get syntax colors. Links open in a new tab, except fragment links. Markdown images load from their addresses.",
      "copy": "Copy the HTML produced by the renderer. It excludes preview-only syntax highlighting and link attributes; raw HTML in your Markdown stays escaped.",
      "clear": "Clear the Markdown, preview, count and copy feedback. Pending updates are cancelled. Ctrl/⌘+L also clears this tool when focus is inside it.",
      "count": "Words are separated by whitespace. Characters are counted as UTF-16 code units, including spaces and line breaks; some symbols count as two."
    }
  },
  "zh": {
    "copyHtml": "复制 HTML",
    "clear": "清除",
    "copied": "已复制！",
    "copyFailed": "复制失败",
    "markdownLabel": "Markdown",
    "previewLabel": "预览",
    "wordsSep": "词",
    "charsSep": "字符",
    "countLabel": "词数与字符数",
    "emptyPreview": "渲染后的 Markdown 会显示在这里。",
    "imageNotice": "预览图片会从其地址加载，图片服务器能看到你的 IP 地址和浏览器信息。",
    "tips": {
      "editor": "输入或粘贴 CommonMark 或 GitHub 风格 Markdown。停止输入 300 ms 后更新预览。",
      "preview": "原始 HTML 显示为文字。支持的代码块会高亮。除片段链接外，链接在新标签页打开。Markdown 图片从其地址加载。",
      "copy": "复制渲染器生成的 HTML，不含预览专用的代码高亮和链接属性；Markdown 中的原始 HTML 保持转义。",
      "clear": "清除 Markdown、预览、计数和复制反馈，并取消排队的更新。焦点在工具内时，Ctrl/⌘+L 也会清空。",
      "count": "按空白分词。字符数按 UTF-16 代码单元计算，包含空格和换行；部分符号计为两个。"
    }
  },
  "ja": {
    "copyHtml": "HTML コピー",
    "clear": "クリア",
    "copied": "コピー済み！",
    "copyFailed": "コピー失敗",
    "markdownLabel": "Markdown",
    "previewLabel": "プレビュー",
    "wordsSep": "語",
    "charsSep": "文字",
    "countLabel": "語数と文字数",
    "emptyPreview": "レンダリングした Markdown がここに表示されます。",
    "imageNotice": "プレビュー画像は指定のアドレスから読み込まれます。画像サーバーには IP アドレスとブラウザー情報が伝わります。",
    "tips": {
      "editor": "CommonMark または GitHub Flavored Markdown を入力・貼り付けます。入力停止から 300 ms 後にプレビューが更新されます。",
      "preview": "生の HTML は文字として表示します。対応するコードブロックは色分けします。フラグメントリンク以外は新しいタブで開きます。Markdown の画像は指定のアドレスから読み込みます。",
      "copy": "レンダラーが生成した HTML をコピーします。プレビュー専用の構文ハイライトやリンク属性は含みません。Markdown 内の生の HTML はエスケープされたままです。",
      "clear": "Markdown、プレビュー、語数・文字数、コピーの表示を消し、待機中の更新を取り消します。ツール内にフォーカスがあるときは Ctrl/⌘+L でも消去できます。",
      "count": "空白で語を区切ります。文字数は空白や改行を含む UTF-16 コード単位の数です。一部の記号は 2 つとして数えます。"
    }
  },
  "ko": {
    "copyHtml": "HTML 복사",
    "clear": "지우기",
    "copied": "복사됨!",
    "copyFailed": "복사 실패",
    "markdownLabel": "Markdown",
    "previewLabel": "미리보기",
    "wordsSep": "단어",
    "charsSep": "문자",
    "countLabel": "단어 및 문자 수",
    "emptyPreview": "렌더링된 Markdown이 여기에 표시됩니다.",
    "imageNotice": "미리보기 이미지는 지정한 주소에서 불러옵니다. 이미지 서버에 IP 주소와 브라우저 정보가 전달됩니다.",
    "tips": {
      "editor": "CommonMark 또는 GitHub Flavored Markdown을 입력하거나 붙여 넣으세요. 입력을 멈춘 뒤 300 ms 후에 미리보기가 갱신됩니다.",
      "preview": "원시 HTML은 글자로 표시합니다. 지원하는 코드 블록은 구문을 강조합니다. 조각 링크를 제외한 링크는 새 탭에서 열립니다. Markdown 이미지는 지정한 주소에서 불러옵니다.",
      "copy": "렌더러가 생성한 HTML을 복사합니다. 미리보기 전용 구문 강조와 링크 속성은 제외하며, Markdown의 원시 HTML은 이스케이프된 상태로 유지합니다.",
      "clear": "Markdown, 미리보기, 개수 및 복사 피드백을 지우고 대기 중인 갱신을 취소합니다. 도구 안에 포커스가 있으면 Ctrl/⌘+L로도 지울 수 있습니다.",
      "count": "공백으로 단어를 나눕니다. 문자 수는 공백과 줄바꿈을 포함한 UTF-16 코드 단위 수이며 일부 기호는 두 개로 셉니다."
    }
  }
};
// strings:end
const T = STRINGS[lang as keyof typeof STRINGS] || STRINGS.en;
const { tips: TIPS, ...CLIENT_T } = T;
---
<div class="mp-wrap" data-strings={JSON.stringify(CLIENT_T)}>
  <div class="mp-toolbar">
    <div class="mp-control">
      <button id="mp-copy-html" class="btn-secondary">{T.copyHtml}</button>
      <Toggletip id="mp-tip-copy" lang={lang} about={T.copyHtml}>{TIPS.copy}</Toggletip>
    </div>
    <div class="mp-control">
      <button id="mp-clear" class="btn-ghost">{T.clear}</button>
      <Toggletip id="mp-tip-clear" lang={lang} about={T.clear}>{TIPS.clear}</Toggletip>
    </div>
    <div class="mp-count">
      <span id="mp-word-count" class="mp-word-count"></span>
      <Toggletip id="mp-tip-count" lang={lang} about={T.countLabel}>{TIPS.count}</Toggletip>
    </div>
  </div>
  <div id="mp-status" class="mp-status" aria-live="polite"></div>
  <div class="mp-panes zt-io">
    <div class="mp-pane mp-editor-pane zt-io-pane">
      <div class="mp-pane-head">
        <label class="mp-pane-label" for="mp-editor">{T.markdownLabel}</label>
        <Toggletip id="mp-tip-editor" lang={lang} about={T.markdownLabel}>{TIPS.editor}</Toggletip>
      </div>
      <textarea id="mp-editor" class="zt-io-fill" spellcheck="false" placeholder="# Hello, World!&#10;&#10;Type your **Markdown** here..."></textarea>
    </div>
    <div class="mp-pane mp-preview-pane zt-io-pane">
      <div class="mp-pane-head">
        <span id="mp-preview-label" class="mp-pane-label">{T.previewLabel}</span>
        <Toggletip id="mp-tip-preview" lang={lang} about={T.previewLabel}>{TIPS.preview}</Toggletip>
      </div>
      <div id="mp-preview" class="mp-preview prose zt-io-fill" tabindex="0" role="region" aria-labelledby="mp-preview-label"></div>
      <p id="mp-empty-preview" class="mp-empty-preview">{T.emptyPreview}</p>
      <p id="mp-image-notice" class="mp-image-notice">{T.imageNotice}</p>
    </div>
  </div>
  <script>
    import hljs from 'highlight.js/lib/core';
    import javascript from 'highlight.js/lib/languages/javascript';
    import typescript from 'highlight.js/lib/languages/typescript';
    import python from 'highlight.js/lib/languages/python';
    import go from 'highlight.js/lib/languages/go';
    import php from 'highlight.js/lib/languages/php';
    import ruby from 'highlight.js/lib/languages/ruby';
    import java from 'highlight.js/lib/languages/java';
    import bash from 'highlight.js/lib/languages/bash';
    import json from 'highlight.js/lib/languages/json';
    import xml from 'highlight.js/lib/languages/xml';
    import css from 'highlight.js/lib/languages/css';
    import markdown from 'highlight.js/lib/languages/markdown';
    import { micromark } from 'micromark';
    import { gfm, gfmHtml } from 'micromark-extension-gfm';

    hljs.registerLanguage('javascript', javascript);
    hljs.registerLanguage('js', javascript);
    hljs.registerLanguage('typescript', typescript);
    hljs.registerLanguage('ts', typescript);
    hljs.registerLanguage('python', python);
    hljs.registerLanguage('py', python);
    hljs.registerLanguage('go', go);
    hljs.registerLanguage('php', php);
    hljs.registerLanguage('ruby', ruby);
    hljs.registerLanguage('rb', ruby);
    hljs.registerLanguage('java', java);
    hljs.registerLanguage('bash', bash);
    hljs.registerLanguage('sh', bash);
    hljs.registerLanguage('shell', bash);
    hljs.registerLanguage('json', json);
    hljs.registerLanguage('xml', xml);
    hljs.registerLanguage('html', xml);
    hljs.registerLanguage('css', css);
    hljs.registerLanguage('markdown', markdown);
    hljs.registerLanguage('md', markdown);

    var t = JSON.parse(document.querySelector('.mp-wrap').dataset.strings);

    // CommonMark + GFM (tables, task lists, strikethrough, autolink literals, footnotes) via
    // micromark. Raw HTML is escaped and shown as text, and link / image URLs other than
    // http(s), mailto, irc(s), xmpp (links) or http(s) (images) and relative URLs are emptied:
    // micromark's defaults (allowDangerousHtml / allowDangerousProtocol false). The preview runs
    // on the zerotool.dev origin, so markup from pasted text must never become live elements.
    /* ── engine:start ── */
    function renderMarkdown(src, lib) {
      return lib.micromark(src, {
        extensions: [lib.gfm()],
        htmlExtensions: [lib.gfmHtml()],
        allowDangerousHtml: false,
        allowDangerousProtocol: false,
      });
    }
    /* ── engine:end ── */

    var editor = document.getElementById('mp-editor') as HTMLTextAreaElement;
    var preview = document.getElementById('mp-preview') as HTMLElement;
    var wordCount = document.getElementById('mp-word-count') as HTMLElement;
    var copyBtn = document.getElementById('mp-copy-html') as HTMLElement;
    var statusEl = document.getElementById('mp-status') as HTMLElement;

    var mdLib = { micromark: micromark, gfm: gfm, gfmHtml: gfmHtml };
    var lastHtml = '';
    var copyRevision = 0;
    var copyTimer: ReturnType<typeof setTimeout> | null = null;

    function invalidateCopy() {
      copyRevision++;
      clearTimeout(copyTimer!);
      copyTimer = null;
      copyBtn.textContent = t.copyHtml;
      statusEl.textContent = '';
    }

    function update() {
      invalidateCopy();
      var src = editor.value;
      lastHtml = renderMarkdown(src, mdLib);
      preview.innerHTML = lastHtml;
      // Open links in a new tab so a click does not leave the page and lose the text.
      preview.querySelectorAll('a[href]').forEach(function(a) {
        var href = a.getAttribute('href') || '';
        if (href.charAt(0) === '#') return;
        a.setAttribute('target', '_blank');
        a.setAttribute('rel', 'noopener noreferrer');
      });
      preview.querySelectorAll('pre code').forEach(function(el) {
        (el as HTMLElement).removeAttribute('data-highlighted');
        hljs.highlightElement(el as HTMLElement);
      });
      var words = src.trim() ? src.trim().split(/\s+/).length : 0;
      var chars = src.length;
      wordCount.textContent = words + ' ' + t.wordsSep + ' · ' + chars + ' ' + t.charsSep;
    }

    var _mpTimer: ReturnType<typeof setTimeout> | null = null;
    editor.addEventListener('input', function () {
      invalidateCopy();
      clearTimeout(_mpTimer!);
      _mpTimer = setTimeout(update, 300);
    });

    document.getElementById('mp-copy-html')!.addEventListener('click', function () {
      // The renderer's own HTML: no highlight.js spans and no target attributes added for the preview.
      var html = lastHtml;
      if (!html) return;
      invalidateCopy();
      var revision = copyRevision;
      function failed() {
        if (revision === copyRevision) statusEl.textContent = t.copyFailed;
      }
      try {
        navigator.clipboard.writeText(html).then(function () {
          if (revision !== copyRevision) return;
          copyBtn.textContent = t.copied;
          copyTimer = setTimeout(function () {
            if (revision === copyRevision) copyBtn.textContent = t.copyHtml;
          }, 1500);
        }, failed);
      } catch (_) { failed(); }
      (window as any).trackTool && (window as any).trackTool('markdown_preview', 'copy_html');
    });

    function clearAll() {
      clearTimeout(_mpTimer!);
      _mpTimer = null;
      invalidateCopy();
      editor.value = '';
      lastHtml = '';
      preview.innerHTML = '';
      wordCount.textContent = '';
    }
    document.getElementById('mp-clear')!.addEventListener('click', clearAll);
    document.addEventListener('keydown', function (e) {
      if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l') return;
      if (!document.querySelector('.mp-wrap')!.contains(document.activeElement)) return;
      e.preventDefault();
      editor.focus();
      clearAll();
    });

    // Default content
    if (!editor.value) editor.value = [
      '# Welcome to Markdown Preview',
      '',
      'This is a **live** Markdown editor. Changes render _instantly_ to the right.',
      '',
      '## Features',
      '',
      '- Headings H1–H6',
      '- **Bold**, _italic_, ~~strikethrough~~',
      '- `inline code` and fenced code blocks',
      '- [Links](https://zerotool.dev) and images',
      '- Tables (GFM)',
      '- Task lists',
      '',
      '## Code Example',
      '',
      '```js',
      'const greet = name => `Hello, ${name}!`;',
      'console.log(greet("ZeroTool"));',
      '```',
      '',
      '## Table',
      '',
      '| Name | Role |',
      '|------|------|',
      '| Alice | Engineer |',
      '| Bob | Designer |',
      '',
      '## Task List',
      '',
      '- [x] Build 5 tools',
      '- [ ] Deploy to production',
    ].join('\n');
    update();
  </script>
</div>

<style>
  .mp-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; gap: 0.5rem; }
  .mp-toolbar { display: flex; align-items: center; gap: 0.5rem 0.75rem; flex-wrap: wrap; }
  .mp-control, .mp-count, .mp-pane-head { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
  .mp-toolbar button { min-height: 44px; }
  #mp-copy-html { min-width: 8.5rem; }
  .mp-count { margin-left: auto; }
  .mp-word-count { font-size: 0.8rem; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .mp-status { height: 1.5rem; min-height: 1.5rem; flex: none; overflow: auto; font-size: 0.85rem; line-height: 1.5; color: var(--color-danger); }
  .mp-pane { position: relative; }
  .mp-pane-head { min-height: 28px; flex: none; }
  .mp-pane-label { font-size: 0.78rem; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .mp-editor-pane textarea { width: 100%; min-width: 0; overflow: auto; font-family: var(--font-mono); font-size: 0.86rem; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-secondary); color: var(--color-text); line-height: 1.6; box-sizing: border-box; }
  .mp-editor-pane textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }
  .mp-preview { min-width: 0; padding: 0.75rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg); color: var(--color-text); overflow: auto; line-height: 1.7; }
  .mp-preview:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .mp-empty-preview { display: none; position: absolute; top: calc(28px + 0.4rem); left: 0; right: 0; margin: 0; padding: 1rem; color: var(--color-text-muted); pointer-events: none; }
  .mp-preview-pane:has(.mp-preview:empty) .mp-empty-preview { display: block; }
  .mp-image-notice { display: none; flex: none; margin: 0; font-size: 0.8rem; line-height: 1.5; color: var(--color-text-secondary); }
  :global(.mp-preview-pane:has(img[src]:not([src=""]))) .mp-image-notice { display: block; }
  @media (max-width: 860px) {
    .mp-editor-pane textarea { height: 180px; }
    .mp-preview { height: 320px; }
    .mp-preview-pane:has(.mp-preview:empty) { display: none; }
  }
  @media (max-width: 640px) {
    .mp-count { flex-basis: 100%; justify-content: flex-end; min-height: 28px; }
    .mp-editor-pane textarea { height: 144px; }
    .mp-preview { height: 280px; }
  }

  /* Prose styles inside preview. The preview content is set with innerHTML, so it has no
     scoped attributes and every rule below must be :global. */
  .mp-preview :global(h1), .mp-preview :global(h2), .mp-preview :global(h3),
  .mp-preview :global(h4), .mp-preview :global(h5), .mp-preview :global(h6) {
    margin: 1rem 0 0.4rem;
    line-height: 1.3;
  }
  .mp-preview :global(h1) { font-size: 1.6rem; }
  .mp-preview :global(h2) { font-size: 1.3rem; border-bottom: 1px solid var(--color-border-light); padding-bottom: 0.2rem; }
  .mp-preview :global(h3) { font-size: 1.1rem; }
  .mp-preview :global(p) { margin: 0.5rem 0; }
  .mp-preview :global(code) { background: var(--color-bg-icon); padding: 0.1rem 0.3rem; border-radius: 3px; font-size: 0.88em; }
  .mp-preview :global(pre) { padding: 0; border-radius: var(--radius-sm); overflow-x: auto; margin: 0.75rem 0; }
  .mp-preview :global(pre code.hljs) { border-radius: var(--radius-sm); font-size: 0.86rem; font-family: var(--font-mono); line-height: 1.5; }
  .mp-preview :global(blockquote) { border-left: 3px solid var(--color-primary); margin: 0.75rem 0; padding: 0.25rem 1rem; color: var(--color-text-secondary); background: #f8f9ff; border-radius: 0 4px 4px 0; }
  .mp-preview :global(ul), .mp-preview :global(ol) { padding-left: 1.5rem; margin: 0.4rem 0; }
  .mp-preview :global(li) { margin: 0.2rem 0; }
  .mp-preview :global(table) { border-collapse: collapse; width: 100%; margin: 0.75rem 0; font-size: 0.9rem; }
  .mp-preview :global(th), .mp-preview :global(td) { border: 1px solid var(--color-border); padding: 0.4rem 0.75rem; text-align: left; }
  .mp-preview :global(th[align="center"]), .mp-preview :global(td[align="center"]) { text-align: center; }
  .mp-preview :global(th[align="right"]), .mp-preview :global(td[align="right"]) { text-align: right; }
  .mp-preview :global(th) { background: var(--color-bg-icon); font-weight: 600; }
  .mp-preview :global(hr) { border: none; border-top: 1px solid var(--color-border); margin: 1rem 0; }
  .mp-preview :global(a) { color: var(--color-primary); text-decoration: underline; text-underline-offset: 0.18em; }
  .mp-preview :global(del) { color: var(--color-text-muted); }
  .mp-preview :global(img) { max-width: 100%; border-radius: 4px; }
  .mp-preview :global(.footnotes) { margin-top: 1.5rem; border-top: 1px solid var(--color-border); font-size: 0.9rem; }
  .mp-preview :global(.sr-only) { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .mp-preview :global(blockquote) { background: rgba(59, 158, 255, 0.08); }
  }
  [data-theme="dark"] .mp-preview :global(blockquote) { background: rgba(59, 158, 255, 0.08); }
</style>
