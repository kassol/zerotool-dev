  .chmod-options { display: flex; align-items: flex-start; gap: 0.4rem; }
  .chmod-options > :global(.zt-tip) { margin-top: 0.5rem; }
  .chmod-special-section { flex: 1; min-width: 0; }
  .chmod-special-section summary { min-height: 44px; padding: 0.65rem 0; cursor: pointer; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .chmod-special-row { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; padding-bottom: 0.5rem; }
  .chmod-special-label { display: flex; align-items: center; gap: 0.4rem; min-height: 32px; cursor: pointer; font-size: 0.85rem; color: var(--color-text); }
  .chmod-special-label input { width: 1.1rem; height: 1.1rem; accent-color: var(--color-primary); flex: none; }
  .chmod-status { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.5rem; height: 3rem; min-height: 3rem; overflow: auto; }
  .chmod-error { font-size: 0.78rem; line-height: 1.5; color: var(--color-danger); overflow-wrap: anywhere; }
  .chmod-inputs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 1.5rem; }
  .chmod-fields, .chmod-permissions { display: flex; flex-direction: column; min-width: 0; gap: 0.65rem; }
  .chmod-label-row { display: flex; align-items: center; min-width: 0; min-height: 28px; gap: 0.35rem; }
  .chmod-result-label { min-width: 0; font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); }
  .chmod-result-group { display: flex; flex-direction: column; min-width: 0; gap: 0.25rem; }
  .chmod-result-value { display: flex; align-items: center; min-width: 0; gap: 0.5rem; }
  .chmod-result-value .btn-copy { flex: none; }
  .chmod-numeric-input, .chmod-symbolic-input { flex: 1; min-width: 0; width: 0; font-family: var(--font-mono); font-size: 1rem; }
  .chmod-input-error { border-color: var(--color-danger) !important; }
  .chmod-grid { display: grid; grid-template-columns: minmax(5rem, 1.3fr) repeat(3, minmax(0, 1fr)); align-items: center; gap: 0.15rem 0.5rem; }
  .chmod-grid-header { font-size: 0.78rem; font-weight: 600; color: var(--color-text-secondary); text-align: center; }
  .chmod-grid-label { font-size: 0.85rem; font-weight: 600; color: var(--color-text); }
  .chmod-cb { display: flex; justify-content: center; align-items: center; min-height: 32px; cursor: pointer; }
  .chmod-cb input { width: 1.25rem; height: 1.25rem; accent-color: var(--color-primary); cursor: pointer; }
  .chmod-results { display: flex; flex-direction: column; min-width: 0; gap: 0.4rem; }
  .chmod-result-row { display: grid; grid-template-columns: 9rem minmax(0, 1fr); align-items: center; gap: 0.5rem; height: 3.5rem; padding: 0 0.4rem 0 0.75rem; border-radius: var(--radius-md); background: var(--color-bg-secondary); box-shadow: inset 0 0 0 1px var(--color-border-soft); }
  .chmod-output { display: block; flex: 1; width: 0; min-width: 0; height: 2.75rem; line-height: 2rem; overflow-x: auto; overflow-y: hidden; white-space: pre; font-family: var(--font-mono); font-size: 0.9rem; color: var(--color-text); user-select: all; }
  .chmod-description { height: 4.5em; line-height: 1.5; overflow: auto; overflow-wrap: anywhere; font-size: 0.82rem; color: var(--color-text-secondary); }
  .chmod-output:focus-visible, .chmod-description:focus-visible, .chmod-status:focus-visible, .chmod-special-section summary:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  @media (max-width: 860px) {
    .chmod-inputs { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
  }
  @media (max-width: 640px) {
    .chmod-wrap { gap: 0.5rem; }
    .chmod-cb, .chmod-special-label { min-height: 44px; }
    .chmod-permissions { gap: 0.25rem; }
    .chmod-result-row { grid-template-columns: 6.5rem minmax(0, 1fr); gap: 0.4rem; height: 3.5rem; padding: 0 0.3rem 0 0.5rem; }
    .chmod-result-row .chmod-result-label { font-size: 0.78rem; }
  }
</style>
