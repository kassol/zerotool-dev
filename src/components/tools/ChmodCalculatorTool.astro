---
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  "en": {
    "read": "Read",
    "write": "Write",
    "execute": "Execute",
    "owner": "Owner",
    "group": "Group",
    "others": "Others",
    "numeric": "Numeric",
    "symbolic": "Symbolic",
    "command": "Command",
    "commandSym": "Symbolic cmd",
    "findPerm": "find -perm",
    "copy": "Copy",
    "copied": "Copied!",
    "copyFailed": "Copy failed",
    "specialBits": "Special Bits",
    "setuid": "Setuid (4000)",
    "setgid": "Setgid (2000)",
    "sticky": "Sticky (1000)",
    "errInvalidOctal": "Invalid octal (use digits 0–7, up to 4 chars)",
    "errInvalidSymbolic": "Invalid symbolic (must be 9 chars: rwxr-xr-x)",
    "permNone": "none",
    "descRead": "read",
    "descWrite": "write",
    "descExecute": "execute",
    "permissions": "Permissions",
    "tips": {
      "permissions": "Toggle Read, Write and Execute for Owner, Group and Others. Numeric and symbolic values and all three commands update immediately. Ctrl/⌘+L inside the tool clears every permission, field and result.",
      "special": "Open Special Bits to add Setuid (4), Setgid (2) or Sticky (1) as the leading octal digit. They use s or t when execute is also set, and S or T when it is not.",
      "numeric": "Enter three or four octal digits, using 0–7, such as 644 or 2775. Complete input updates the checkboxes and commands. An incomplete entry shows an error and keeps the last valid result.",
      "symbolic": "Enter a nine-character mode such as rwxr-xr-x, including s/S and t/T for special bits. You can paste ls -l forms such as drwxrwxrwt or -rw-r--r--@; the file type and trailing marker are removed.",
      "commands": "Copy the numeric value, symbolic mode or a command. Replace filename with your path. Symbolic cmd includes special bits; Sticky uses a separate +t, which works on both GNU and macOS chmod."
    }
  },
  "zh": {
    "read": "读",
    "write": "写",
    "execute": "执行",
    "owner": "所有者",
    "group": "用户组",
    "others": "其他",
    "numeric": "数字",
    "symbolic": "符号",
    "command": "命令",
    "commandSym": "符号命令",
    "findPerm": "find -perm",
    "copy": "复制",
    "copied": "已复制！",
    "copyFailed": "复制失败",
    "specialBits": "特殊位",
    "setuid": "Setuid (4000)",
    "setgid": "Setgid (2000)",
    "sticky": "粘滞位 (1000)",
    "errInvalidOctal": "无效八进制（0–7 数字，最多 4 位）",
    "errInvalidSymbolic": "无效符号串（需恰好 9 位，如 rwxr-xr-x）",
    "permNone": "无",
    "descRead": "读",
    "descWrite": "写",
    "descExecute": "执行",
    "permissions": "权限",
    "tips": {
      "permissions": "勾选所有者、用户组和其他用户的读、写、执行权限。数字、符号及三条命令会即时更新。在工具内按 Ctrl/⌘+L 会清空全部权限、输入和结果。",
      "special": "展开特殊位，可用 Setuid（4）、Setgid（2）或粘滞位（1）组成八进制首位。执行权限同时启用时显示 s 或 t，未启用时显示 S 或 T。",
      "numeric": "输入三位或四位八进制数字，只用 0–7，例如 644 或 2775。完整输入会更新复选框和命令；输入未完成时显示错误，并保留上次合法结果。",
      "symbolic": "输入 rwxr-xr-x 这样的九位权限串，特殊位可用 s/S 和 t/T。也可粘贴 drwxrwxrwt 或 -rw-r--r--@ 等 ls -l 字段，工具会去掉文件类型字符和末尾标记。",
      "commands": "复制数字、符号或所需命令，并把 filename 换成你的路径。符号命令包含特殊位；粘滞位单独写成 +t，可用于 GNU 和 macOS chmod。"
    }
  },
  "ja": {
    "read": "読取",
    "write": "書込",
    "execute": "実行",
    "owner": "オーナー",
    "group": "グループ",
    "others": "その他",
    "numeric": "数値",
    "symbolic": "シンボル",
    "command": "コマンド",
    "commandSym": "シンボルコマンド",
    "findPerm": "find -perm",
    "copy": "コピー",
    "copied": "コピー済み！",
    "copyFailed": "コピー失敗",
    "specialBits": "特殊ビット",
    "setuid": "SUID (4000)",
    "setgid": "SGID (2000)",
    "sticky": "スティッキー (1000)",
    "errInvalidOctal": "無効な8進数（0〜7の数字、最大4桁）",
    "errInvalidSymbolic": "無効なシンボル（9文字が必要、例: rwxr-xr-x）",
    "permNone": "なし",
    "descRead": "読取",
    "descWrite": "書込",
    "descExecute": "実行",
    "permissions": "アクセス権",
    "tips": {
      "permissions": "オーナー、グループ、その他の読取・書込・実行を切り替えると、数値、シンボル、3つのコマンドが即座に更新されます。ツール内で Ctrl/⌘+L を押すと、権限、入力、結果をすべて消去します。",
      "special": "特殊ビットを開き、SUID（4）、SGID（2）、スティッキー（1）を先頭の8進数桁に加えます。実行権限があれば s または t、なければ S または T になります。",
      "numeric": "0〜7を使う3桁または4桁の8進数を入力します（例：644、2775）。有効な入力でチェックボックスとコマンドが更新されます。入力途中はエラーを示し、直前の有効な結果を保持します。",
      "symbolic": "rwxr-xr-x のような9文字のモードを入力します。特殊ビットの s/S、t/T にも対応します。drwxrwxrwt や -rw-r--r--@ などの ls -l の表記も使え、ファイル種別と末尾の印は取り除かれます。",
      "commands": "数値、シンボル、必要なコマンドをコピーし、filename を実際のパスに置き換えます。シンボルコマンドには特殊ビットも含まれます。スティッキーは GNU と macOS の両方で使える独立した +t で表します。"
    }
  },
  "ko": {
    "read": "읽기",
    "write": "쓰기",
    "execute": "실행",
    "owner": "소유자",
    "group": "그룹",
    "others": "기타",
    "numeric": "숫자",
    "symbolic": "기호",
    "command": "명령어",
    "commandSym": "기호 명령어",
    "findPerm": "find -perm",
    "copy": "복사",
    "copied": "복사됨!",
    "copyFailed": "복사 실패",
    "specialBits": "특수 비트",
    "setuid": "SUID (4000)",
    "setgid": "SGID (2000)",
    "sticky": "스티키 (1000)",
    "errInvalidOctal": "잘못된 8진수 (0–7 숫자, 최대 4자리)",
    "errInvalidSymbolic": "잘못된 기호 (9자리 필요, 예: rwxr-xr-x)",
    "permNone": "없음",
    "descRead": "읽기",
    "descWrite": "쓰기",
    "descExecute": "실행",
    "permissions": "권한",
    "tips": {
      "permissions": "소유자, 그룹, 기타 사용자의 읽기·쓰기·실행을 바꾸면 숫자, 기호, 세 명령어가 즉시 갱신됩니다. 도구 안에서 Ctrl/⌘+L을 누르면 모든 권한, 입력과 결과를 지웁니다.",
      "special": "특수 비트를 열어 SUID(4), SGID(2), 스티키(1)를 맨 앞 8진수 자릿수에 추가합니다. 실행 권한도 있으면 s 또는 t, 없으면 S 또는 T로 표시됩니다.",
      "numeric": "0–7만 사용한 세 자리 또는 네 자리 8진수를 입력합니다(예: 644, 2775). 완성된 입력은 체크박스와 명령어를 갱신합니다. 입력 중에는 오류를 표시하고 마지막 유효한 결과를 유지합니다.",
      "symbolic": "rwxr-xr-x처럼 아홉 자리 모드를 입력하며 특수 비트 s/S와 t/T도 지원합니다. drwxrwxrwt 또는 -rw-r--r--@ 같은 ls -l 필드도 붙여넣을 수 있으며 파일 유형과 끝 표시는 제거됩니다.",
      "commands": "숫자, 기호 또는 필요한 명령어를 복사하고 filename을 실제 경로로 바꾸세요. 기호 명령어에는 특수 비트가 포함됩니다. 스티키는 GNU와 macOS chmod에서 모두 작동하는 별도의 +t로 표시됩니다."
    }
  }
} as const;
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---
<div class="chmod-wrap">
  <div class="chmod-options">
    <details class="chmod-special-section">
      <summary>{T.specialBits}</summary>
      <div class="chmod-special-row">
        <label class="chmod-special-label"><input type="checkbox" id="chmod-setuid" /><span>{T.setuid}</span></label>
        <label class="chmod-special-label"><input type="checkbox" id="chmod-setgid" /><span>{T.setgid}</span></label>
        <label class="chmod-special-label"><input type="checkbox" id="chmod-sticky" /><span>{T.sticky}</span></label>
      </div>
    </details>
    <Toggletip id="chmod-tip-special" lang={lang} about={T.specialBits}>{TIPS.special}</Toggletip>
  </div>
  <div class="chmod-status" tabindex="0">
    <div id="chmod-numeric-error" class="chmod-error" aria-live="polite"></div>
    <div id="chmod-symbolic-error" class="chmod-error" aria-live="polite"></div>
  </div>
  <div class="chmod-inputs">
    <div class="chmod-fields">
      <div class="chmod-result-group">
        <div class="chmod-label-row">
          <label class="chmod-result-label" for="chmod-numeric">{T.numeric}</label>
          <Toggletip id="chmod-tip-numeric" lang={lang} about={T.numeric}>{TIPS.numeric}</Toggletip>
        </div>
        <div class="chmod-result-value">
          <input type="text" id="chmod-numeric" class="tool-input chmod-numeric-input" value="755" maxlength="4" inputmode="numeric" spellcheck="false" autocomplete="off" aria-describedby="chmod-numeric-error" />
          <button id="chmod-copy-numeric" class="btn-copy" type="button">{T.copy}</button>
        </div>
      </div>
      <div class="chmod-result-group">
        <div class="chmod-label-row">
          <label class="chmod-result-label" for="chmod-symbolic">{T.symbolic}</label>
          <Toggletip id="chmod-tip-symbolic" lang={lang} about={T.symbolic}>{TIPS.symbolic}</Toggletip>
        </div>
        <div class="chmod-result-value">
          <input type="text" id="chmod-symbolic" class="tool-input chmod-symbolic-input" value="rwxr-xr-x" maxlength="11" spellcheck="false" autocomplete="off" aria-describedby="chmod-symbolic-error" />
          <button id="chmod-copy-symbolic" class="btn-copy" type="button">{T.copy}</button>
        </div>
      </div>
    </div>
    <div class="chmod-permissions">
      <div class="chmod-label-row">
        <span class="chmod-result-label">{T.permissions}</span>
        <Toggletip id="chmod-tip-permissions" lang={lang} about={T.permissions}>{TIPS.permissions}</Toggletip>
      </div>
      <div class="chmod-grid">
        <div class="chmod-grid-header"></div>
        <div class="chmod-grid-header">{T.read}</div>
        <div class="chmod-grid-header">{T.write}</div>
        <div class="chmod-grid-header">{T.execute}</div>
        <div class="chmod-grid-label">{T.owner}</div>
        <label class="chmod-cb"><input type="checkbox" data-who="owner" data-perm="r" checked aria-label={T.owner + ' ' + T.read} /><span></span></label>
        <label class="chmod-cb"><input type="checkbox" data-who="owner" data-perm="w" checked aria-label={T.owner + ' ' + T.write} /><span></span></label>
        <label class="chmod-cb"><input type="checkbox" data-who="owner" data-perm="x" checked aria-label={T.owner + ' ' + T.execute} /><span></span></label>
        <div class="chmod-grid-label">{T.group}</div>
        <label class="chmod-cb"><input type="checkbox" data-who="group" data-perm="r" checked aria-label={T.group + ' ' + T.read} /><span></span></label>
        <label class="chmod-cb"><input type="checkbox" data-who="group" data-perm="w" aria-label={T.group + ' ' + T.write} /><span></span></label>
        <label class="chmod-cb"><input type="checkbox" data-who="group" data-perm="x" checked aria-label={T.group + ' ' + T.execute} /><span></span></label>
        <div class="chmod-grid-label">{T.others}</div>
        <label class="chmod-cb"><input type="checkbox" data-who="others" data-perm="r" checked aria-label={T.others + ' ' + T.read} /><span></span></label>
        <label class="chmod-cb"><input type="checkbox" data-who="others" data-perm="w" aria-label={T.others + ' ' + T.write} /><span></span></label>
        <label class="chmod-cb"><input type="checkbox" data-who="others" data-perm="x" checked aria-label={T.others + ' ' + T.execute} /><span></span></label>
      </div>
    </div>
  </div>
  <div class="chmod-results">
    <div class="chmod-result-row">
      <div class="chmod-label-row">
        <span id="chmod-command-label" class="chmod-result-label">{T.command}</span>
        <Toggletip id="chmod-tip-commands" lang={lang} about={T.command}>{TIPS.commands}</Toggletip>
      </div>
      <div class="chmod-result-value">
        <code id="chmod-command" class="chmod-output" tabindex="0" aria-labelledby="chmod-command-label">chmod 755 filename</code>
        <button id="chmod-copy-command" class="btn-copy" type="button">{T.copy}</button>
      </div>
    </div>
    <div class="chmod-result-row">
      <span id="chmod-command-sym-label" class="chmod-result-label">{T.commandSym}</span>
      <div class="chmod-result-value">
        <code id="chmod-command-sym" class="chmod-output" tabindex="0" aria-labelledby="chmod-command-sym-label">chmod u=rwx,g=rx,o=rx filename</code>
        <button id="chmod-copy-command-sym" class="btn-copy" type="button">{T.copy}</button>
      </div>
    </div>
    <div class="chmod-result-row">
      <span id="chmod-find-perm-label" class="chmod-result-label">{T.findPerm}</span>
      <div class="chmod-result-value">
        <code id="chmod-find-perm" class="chmod-output" tabindex="0" aria-labelledby="chmod-find-perm-label">find . -type f -perm 0755</code>
        <button id="chmod-copy-find-perm" class="btn-copy" type="button">{T.copy}</button>
      </div>
    </div>
  </div>
  <div id="chmod-description" class="chmod-description" tabindex="0" aria-label={T.permissions}></div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var WHO_ORDER = ['owner', 'group', 'others'];
      var PERM_MAP = { r: 4, w: 2, x: 1 };
      var copyRevision = 0;

      function resetCopyFeedback() {
        copyRevision++;
        document.querySelectorAll('.chmod-wrap .btn-copy').forEach(function (btn) { btn.textContent = t.copy; });
      }

      function getCheckbox(who, perm) {
        return document.querySelector('input[data-who="' + who + '"][data-perm="' + perm + '"]');
      }

      function getSpecialBits() {
        return (
          (document.getElementById('chmod-setuid').checked ? 4 : 0) +
          (document.getElementById('chmod-setgid').checked ? 2 : 0) +
          (document.getElementById('chmod-sticky').checked ? 1 : 0)
        );
      }

      function calcDigits() {
        var digits = [];
        for (var i = 0; i < WHO_ORDER.length; i++) {
          var who = WHO_ORDER[i];
          var val = 0;
          ['r', 'w', 'x'].forEach(function (p) {
            if (getCheckbox(who, p).checked) val += PERM_MAP[p];
          });
          digits.push(val);
        }
        return digits;
      }

      /* ── engine:start ── */
      function buildSymbolic(digits, special) {
        // special: digit 0-7 (4=setuid, 2=setgid, 1=sticky)
        var sym = '';
        var xChars = ['s', 's', 't'];
        var XChars = ['S', 'S', 'T'];
        var specialFlags = [!!(special & 4), !!(special & 2), !!(special & 1)];

        for (var i = 0; i < 3; i++) {
          var d = digits[i];
          sym += (d & 4) ? 'r' : '-';
          sym += (d & 2) ? 'w' : '-';
          if (specialFlags[i]) {
            sym += (d & 1) ? xChars[i] : XChars[i];
          } else {
            sym += (d & 1) ? 'x' : '-';
          }
        }
        return sym;
      }

      function buildNumericStr(digits, special) {
        var base = digits.join('');
        return special > 0 ? (special + '' + base) : base;
      }

      // Special bits: s after u= / g= (setuid / setgid), and a separate +t for the sticky bit.
      // o+t and o=...t are ignored by BSD/macOS chmod; +t works there and in GNU coreutils.
      function buildSymCmd(digits, special) {
        var classes = ['u', 'g', 'o'];
        var parts = [];
        special = special || 0;
        for (var i = 0; i < 3; i++) {
          var d = digits[i];
          var p = '';
          if (d & 4) p += 'r';
          if (d & 2) p += 'w';
          if (d & 1) p += 'x';
          if (i === 0 && (special & 4)) p += 's';
          if (i === 1 && (special & 2)) p += 's';
          parts.push(classes[i] + '=' + p);
        }
        if (special & 1) parts.push('+t');
        return 'chmod ' + parts.join(',') + ' filename';
      }

      // Accept a mode string copied from ls -l: drop the file-type character in front
      // (- d l b c p s) and the ACL / extended-attribute / SELinux marker after it (+ @ .).
      function stripLsDecorations(raw) {
        var m = /^[-dlbcps]?([-rwxsStT]{9})[+@.]?$/.exec(raw);
        return m ? m[1] : raw;
      }
      /* ── engine:end ── */

      function buildDescription(digits, special) {
        var classNames = [t.owner, t.group, t.others];
        var permNames = [t.descRead, t.descWrite, t.descExecute];
        var specialFlags = [!!(special & 4), !!(special & 2), !!(special & 1)];
        var specialLabels = ['setuid', 'setgid', 'sticky'];
        var parts = [];

        for (var i = 0; i < 3; i++) {
          var d = digits[i];
          var perms = [];
          if (d & 4) perms.push(permNames[0]);
          if (d & 2) perms.push(permNames[1]);
          if (d & 1) perms.push(permNames[2]);
          if (specialFlags[i]) perms.push(specialLabels[i]);
          parts.push(classNames[i] + ': ' + (perms.length ? perms.join(', ') : t.permNone));
        }
        return parts.join('; ');
      }

      function updateOutputsFromState() {
        resetCopyFeedback();
        var digits = calcDigits();
        var special = getSpecialBits();
        var numeric = buildNumericStr(digits, special);
        var symbolic = buildSymbolic(digits, special);

        document.getElementById('chmod-numeric').value = numeric;
        document.getElementById('chmod-symbolic').value = symbolic;
        document.getElementById('chmod-command').textContent = 'chmod ' + numeric + ' filename';
        document.getElementById('chmod-command-sym').textContent = buildSymCmd(digits, special);
        document.getElementById('chmod-find-perm').textContent = 'find . -type f -perm ' + (special > 0 ? numeric : ('0' + numeric));
        document.getElementById('chmod-description').textContent = buildDescription(digits, special);

        setError('chmod-numeric', '');
        setError('chmod-symbolic', '');
      }

      function setError(fieldId, msg) {
        var input = document.getElementById(fieldId);
        var errEl = document.getElementById(fieldId + '-error');
        if (msg) {
          input.classList.add('chmod-input-error');
          errEl.textContent = msg;
        } else {
          input.classList.remove('chmod-input-error');
          if (errEl) errEl.textContent = '';
        }
      }

      function applyNumericToState(raw) {
        if (!/^[0-7]{1,4}$/.test(raw)) return false;
        var len = raw.length;
        var special = 0;
        var base;
        if (len === 4) {
          special = parseInt(raw[0], 8);
          base = raw.slice(1);
        } else if (len === 3) {
          base = raw;
        } else {
          return false;
        }
        for (var i = 0; i < 3; i++) {
          var d = parseInt(base[i], 8);
          var who = WHO_ORDER[i];
          getCheckbox(who, 'r').checked = !!(d & 4);
          getCheckbox(who, 'w').checked = !!(d & 2);
          getCheckbox(who, 'x').checked = !!(d & 1);
        }
        document.getElementById('chmod-setuid').checked = !!(special & 4);
        document.getElementById('chmod-setgid').checked = !!(special & 2);
        document.getElementById('chmod-sticky').checked = !!(special & 1);
        return true;
      }

      function applySymbolicToState(sym) {
        if (sym.length !== 9) return false;
        // Validate each position
        var pos = [
          /^[r\-]$/, /^[w\-]$/, /^[xsS\-]$/,
          /^[r\-]$/, /^[w\-]$/, /^[xsS\-]$/,
          /^[r\-]$/, /^[w\-]$/, /^[xtT\-]$/
        ];
        for (var i = 0; i < 9; i++) {
          if (!pos[i].test(sym[i])) return false;
        }
        // Decode
        var groups = [sym.slice(0, 3), sym.slice(3, 6), sym.slice(6, 9)];
        var special = 0;
        for (var g = 0; g < 3; g++) {
          var chars = groups[g];
          var who = WHO_ORDER[g];
          getCheckbox(who, 'r').checked = chars[0] === 'r';
          getCheckbox(who, 'w').checked = chars[1] === 'w';
          var xc = chars[2];
          if (g < 2) { // owner or group: s/S = setuid/setgid
            if (xc === 's') { getCheckbox(who, 'x').checked = true; special += (g === 0 ? 4 : 2); }
            else if (xc === 'S') { getCheckbox(who, 'x').checked = false; special += (g === 0 ? 4 : 2); }
            else { getCheckbox(who, 'x').checked = xc === 'x'; }
          } else { // others: t/T = sticky
            if (xc === 't') { getCheckbox(who, 'x').checked = true; special += 1; }
            else if (xc === 'T') { getCheckbox(who, 'x').checked = false; special += 1; }
            else { getCheckbox(who, 'x').checked = xc === 'x'; }
          }
        }
        document.getElementById('chmod-setuid').checked = !!(special & 4);
        document.getElementById('chmod-setgid').checked = !!(special & 2);
        document.getElementById('chmod-sticky').checked = !!(special & 1);
        return true;
      }

      // Checkbox + special bit → update all outputs
      document.querySelectorAll('.chmod-grid input[type="checkbox"]').forEach(function (cb) {
        cb.addEventListener('change', function () {
          updateOutputsFromState();
          window.trackTool && window.trackTool('chmod_calculator', 'toggle');
        });
      });
      ['chmod-setuid', 'chmod-setgid', 'chmod-sticky'].forEach(function (id) {
        document.getElementById(id).addEventListener('change', function () {
          updateOutputsFromState();
          window.trackTool && window.trackTool('chmod_calculator', 'special_bit');
        });
      });

      // Numeric input
      var numericInput = document.getElementById('chmod-numeric');
      numericInput.addEventListener('input', function () {
        resetCopyFeedback();
        var original = this.value;
        var raw = original.replace(/[^0-7]/g, '');
        this.value = raw;
        if (raw.length >= 3 && raw.length <= 4) {
          if (applyNumericToState(raw)) {
            var digits = calcDigits();
            var special = getSpecialBits();
            document.getElementById('chmod-symbolic').value = buildSymbolic(digits, special);
            document.getElementById('chmod-command').textContent = 'chmod ' + raw + ' filename';
            document.getElementById('chmod-command-sym').textContent = buildSymCmd(digits, special);
            document.getElementById('chmod-find-perm').textContent = 'find . -type f -perm ' + (special > 0 ? raw : ('0' + raw));
            document.getElementById('chmod-description').textContent = buildDescription(digits, special);
            setError('chmod-numeric', '');
            setError('chmod-symbolic', '');
            window.trackTool && window.trackTool('chmod_calculator', 'numeric_input');
          }
        } else if (raw.length > 0 && raw.length < 3) {
          setError('chmod-numeric', t.errInvalidOctal);
        } else if (original.length > 0 && raw.length === 0) {
          setError('chmod-numeric', t.errInvalidOctal);
        } else {
          setError('chmod-numeric', '');
        }
      });

      // Symbolic input
      var symbolicInput = document.getElementById('chmod-symbolic');
      symbolicInput.addEventListener('input', function () {
        resetCopyFeedback();
        var raw = stripLsDecorations(this.value.trim());
        if (raw.length === 9) {
          if (applySymbolicToState(raw)) {
            var digits = calcDigits();
            var special = getSpecialBits();
            var numeric = buildNumericStr(digits, special);
            document.getElementById('chmod-numeric').value = numeric;
            document.getElementById('chmod-command').textContent = 'chmod ' + numeric + ' filename';
            document.getElementById('chmod-command-sym').textContent = buildSymCmd(digits, special);
            document.getElementById('chmod-find-perm').textContent = 'find . -type f -perm ' + (special > 0 ? numeric : ('0' + numeric));
            document.getElementById('chmod-description').textContent = buildDescription(digits, special);
            setError('chmod-symbolic', '');
            setError('chmod-numeric', '');
            window.trackTool && window.trackTool('chmod_calculator', 'symbolic_input');
          } else {
            setError('chmod-symbolic', t.errInvalidSymbolic);
          }
        } else if (raw.length > 0) {
          setError('chmod-symbolic', t.errInvalidSymbolic);
        } else {
          setError('chmod-symbolic', '');
        }
      });

      // Copy helpers
      function bindCopy(btnId, getText) {
        document.getElementById(btnId).addEventListener('click', function () {
          var text = getText();
          if (!text) return;
          var btn = this;
          resetCopyFeedback();
          var revision = copyRevision;
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            btn.textContent = t.copied;
            setTimeout(function () { if (revision === copyRevision) btn.textContent = t.copy; }, 2000);
          }, function () {
            if (revision === copyRevision) btn.textContent = t.copyFailed;
          });
        });
      }

      bindCopy('chmod-copy-numeric', function () { return document.getElementById('chmod-numeric').value; });
      bindCopy('chmod-copy-symbolic', function () { return document.getElementById('chmod-symbolic').value; });
      bindCopy('chmod-copy-command', function () { return document.getElementById('chmod-command').textContent; });
      bindCopy('chmod-copy-command-sym', function () { return document.getElementById('chmod-command-sym').textContent; });
      bindCopy('chmod-copy-find-perm', function () { return document.getElementById('chmod-find-perm').textContent; });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var wrap = document.querySelector('.chmod-wrap');
        if (!wrap || !wrap.contains(document.activeElement)) return;
        e.preventDefault();
        resetCopyFeedback();
        wrap.querySelectorAll('input[type="checkbox"]').forEach(function (cb) { cb.checked = false; });
        numericInput.value = '';
        symbolicInput.value = '';
        ['chmod-command', 'chmod-command-sym', 'chmod-find-perm', 'chmod-description'].forEach(function (id) {
          document.getElementById(id).textContent = '';
        });
        setError('chmod-numeric', '');
        setError('chmod-symbolic', '');
      });

      // Init
      updateOutputsFromState();
    })();
  </script>
</div>

<style>
