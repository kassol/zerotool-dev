---
// BarcodeGeneratorTool — 1D barcode generator for EAN-13, EAN-8, UPC-A, Code 128,
// Code 39, ITF-14, and Codabar. Hand-written symbology tables — no npm dependencies.
// Encoding tables cross-checked against ISO/IEC 15417 / 16388 / 16390 / 15420,
// zint, JsBarcode, and python-barcode; structural invariants asserted at runtime.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const labels = {
  en: {
    controls: 'Barcode input',
    symbology: 'Symbology',
    data: 'Data',
    appearance: 'Appearance',
    moduleWidth: 'Bar width',
    barHeight: 'Bar height',
    showText: 'Show human-readable text',
    code39Check: 'Append Code 39 mod-43 check character',
    preview: 'Preview',
    downloadPng: 'Download PNG',
    downloadSvg: 'Download SVG',
    copySvg: 'Copy SVG',
    copied: 'Copied!',
    copyFailed: 'Copy failed. Download the SVG instead.',
    reset: 'Reset',
    emptyInput: 'Enter the data to encode.',
    checkAppended: 'Check digit {d} appended.',
    checkValid: 'Check digit verified.',
    checkWrong: 'Wrong check digit. Expected {d}.',
    encoded: 'Encoded {n} modules.',
    errDigits: 'Digits only — {n} digits expected.',
    errLength: '{n} digits expected, got {got}.',
    errAscii: 'Code 128 encodes ASCII 0-127 only. Remove: {ch}',
    errCode39: 'Code 39 allows 0-9, A-Z, space, and - . $ / + % only. Remove: {ch}',
    errCodabar: 'Codabar allows 0-9 and - $ : / . + only. Remove: {ch}',
    lowercased: 'Lowercase letters were uppercased for Code 39.',
    modules: '{n} modules',
  },
  zh: {
    controls: '条码输入',
    symbology: '符号集',
    data: '数据',
    appearance: '外观',
    moduleWidth: '条宽',
    barHeight: '条高',
    showText: '显示可读文本',
    code39Check: '附加 Code 39 mod-43 校验字符',
    preview: '预览',
    downloadPng: '下载 PNG',
    downloadSvg: '下载 SVG',
    copySvg: '复制 SVG',
    copied: '已复制！',
    copyFailed: '复制失败，请改用下载 SVG。',
    reset: '重置',
    emptyInput: '请输入要编码的数据。',
    checkAppended: '已自动补校验位 {d}。',
    checkValid: '校验位正确。',
    checkWrong: '校验位错误，应为 {d}。',
    encoded: '已编码 {n} 个模块。',
    errDigits: '仅接受数字，需要 {n} 位。',
    errLength: '需要 {n} 位数字，当前 {got} 位。',
    errAscii: 'Code 128 仅编码 ASCII 0-127，请移除：{ch}',
    errCode39: 'Code 39 仅支持 0-9、A-Z、空格和 - . $ / + %，请移除：{ch}',
    errCodabar: 'Codabar 仅支持 0-9 和 - $ : / . +，请移除：{ch}',
    lowercased: '小写字母已转为大写以符合 Code 39。',
    modules: '{n} 个模块',
  },
  ja: {
    controls: 'バーコード入力',
    symbology: 'シンボロジー',
    data: 'データ',
    appearance: '外観',
    moduleWidth: 'バー幅',
    barHeight: 'バー高さ',
    showText: '可読テキストを表示',
    code39Check: 'Code 39 mod-43 チェック文字を付加',
    preview: 'プレビュー',
    downloadPng: 'PNG をダウンロード',
    downloadSvg: 'SVG をダウンロード',
    copySvg: 'SVG をコピー',
    copied: 'コピーしました！',
    copyFailed: 'コピーできませんでした。SVG をダウンロードしてください。',
    reset: 'リセット',
    emptyInput: 'エンコードするデータを入力してください。',
    checkAppended: 'チェックディジット {d} を付加しました。',
    checkValid: 'チェックディジットは正しいです。',
    checkWrong: 'チェックディジットが誤っています。正しくは {d} です。',
    encoded: '{n} モジュールをエンコードしました。',
    errDigits: '数字のみ、{n} 桁が必要です。',
    errLength: '{n} 桁必要ですが、現在 {got} 桁です。',
    errAscii: 'Code 128 は ASCII 0-127 のみ対応です。削除してください：{ch}',
    errCode39: 'Code 39 は 0-9、A-Z、スペース、- . $ / + % のみ対応です。削除してください：{ch}',
    errCodabar: 'Codabar は 0-9 と - $ : / . + のみ対応です。削除してください：{ch}',
    lowercased: 'Code 39 のため小文字を大文字に変換しました。',
    modules: '{n} モジュール',
  },
  ko: {
    controls: '바코드 입력',
    symbology: '심볼로지',
    data: '데이터',
    appearance: '모양',
    moduleWidth: '바 너비',
    barHeight: '바 높이',
    showText: '판독용 텍스트 표시',
    code39Check: 'Code 39 mod-43 검사 문자 추가',
    preview: '미리보기',
    downloadPng: 'PNG 다운로드',
    downloadSvg: 'SVG 다운로드',
    copySvg: 'SVG 복사',
    copied: '복사됨!',
    copyFailed: '복사하지 못했습니다. SVG를 다운로드하세요.',
    reset: '초기화',
    emptyInput: '인코딩할 데이터를 입력하세요.',
    checkAppended: '체크 디지트 {d}를 추가했습니다.',
    checkValid: '체크 디지트가 올바릅니다.',
    checkWrong: '체크 디지트가 틀렸습니다. {d}이어야 합니다.',
    encoded: '{n}개 모듈을 인코딩했습니다.',
    errDigits: '숫자만 입력하세요. {n}자리가 필요합니다.',
    errLength: '{n}자리가 필요하지만 현재 {got}자리입니다.',
    errAscii: 'Code 128은 ASCII 0-127만 인코딩합니다. 제거하세요: {ch}',
    errCode39: 'Code 39는 0-9, A-Z, 공백, - . $ / + %만 지원합니다. 제거하세요: {ch}',
    errCodabar: 'Codabar는 0-9와 - $ : / . +만 지원합니다. 제거하세요: {ch}',
    lowercased: 'Code 39를 위해 소문자를 대문자로 변환했습니다.',
    modules: '{n}개 모듈',
  },
};

const L = labels[lang] ?? labels.en;
---

<div
  class="bcode-wrap"
  data-empty-input={L.emptyInput}
  data-check-appended={L.checkAppended}
  data-check-valid={L.checkValid}
  data-check-wrong={L.checkWrong}
  data-encoded={L.encoded}
  data-err-digits={L.errDigits}
  data-err-length={L.errLength}
  data-err-ascii={L.errAscii}
  data-err-code39={L.errCode39}
  data-err-codabar={L.errCodabar}
  data-lowercased={L.lowercased}
  data-modules={L.modules}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-copy-svg={L.copySvg}
>
  <section class="bcode-controls" aria-labelledby="bcode-controls-title">
    <h2 id="bcode-controls-title" class="bcode-section-title">{L.controls}</h2>
    <div class="bcode-field-grid">
      <label class="bcode-field">
        <span class="tool-label">{L.symbology}</span>
        <select id="bcode-symbology" class="tool-input bcode-select">
          <option value="ean13">EAN-13</option>
          <option value="ean8">EAN-8</option>
          <option value="upca">UPC-A</option>
          <option value="code128">Code 128</option>
          <option value="code39">Code 39</option>
          <option value="itf14">ITF-14</option>
          <option value="codabar">Codabar</option>
        </select>
      </label>
      <label class="bcode-field bcode-field--data">
        <span class="tool-label">{L.data}</span>
        <input id="bcode-data" class="tool-input" type="text" spellcheck="false" autocomplete="off" autocapitalize="off" />
      </label>
    </div>
    <p id="bcode-hint" class="bcode-hint"></p>
    <span id="bcode-status" class="tool-status none" role="status" aria-live="polite"></span>
  </section>

  <section class="bcode-appearance" aria-labelledby="bcode-appearance-title">
    <h2 id="bcode-appearance-title" class="bcode-section-title">{L.appearance}</h2>
    <div class="bcode-field-grid">
      <label class="bcode-field">
        <span class="tool-label">{L.moduleWidth}: <strong id="bcode-module-label"></strong></span>
        <input id="bcode-module" type="range" min="1" max="4" step="1" value="2" />
      </label>
      <label class="bcode-field">
        <span class="tool-label">{L.barHeight}: <strong id="bcode-height-label"></strong></span>
        <input id="bcode-height" type="range" min="40" max="160" step="4" value="80" />
      </label>
    </div>
    <div class="bcode-toggles">
      <label class="bcode-toggle">
        <input id="bcode-showtext" type="checkbox" checked />
        <span>{L.showText}</span>
      </label>
      <label class="bcode-toggle" id="bcode-c39-toggle" hidden>
        <input id="bcode-c39check" type="checkbox" />
        <span>{L.code39Check}</span>
      </label>
    </div>
  </section>

  <section class="bcode-preview-card" aria-labelledby="bcode-preview-title">
    <div class="bcode-card-head">
      <h2 id="bcode-preview-title" class="bcode-section-title">{L.preview}</h2>
      <span id="bcode-meta" class="bcode-card-meta"></span>
    </div>
    <div id="bcode-canvas" class="bcode-canvas"></div>
    <div class="bcode-actions">
      <button id="bcode-png" class="btn-primary" type="button">{L.downloadPng}</button>
      <button id="bcode-svg" class="btn-secondary" type="button">{L.downloadSvg}</button>
      <button id="bcode-copy" class="btn-copy" type="button">{L.copySvg}</button>
      <button id="bcode-reset" class="btn-ghost" type="button">{L.reset}</button>
    </div>
  </section>
</div>

<script is:inline>
  (function() {
    'use strict';

    var SLUG = 'barcode-generator';
    var wrap = document.querySelector('.bcode-wrap');
    if (!wrap) return;

    /* ── Symbology tables ───────────────────────────────────────────────
       EAN/UPC: R is the bitwise complement of L; G is R reversed.
       Code 128 / Code 39 / ITF / Codabar use element-width runs starting
       with a bar: '212222' = bar 2, space 1, bar 2, space 2, bar 2, space 2. */

    var EAN_L = ['0001101','0011001','0010011','0111101','0100011','0110001','0101111','0111011','0110111','0001011'];
    var EAN_G = ['0100111','0110011','0011011','0100001','0011101','0111001','0000101','0010001','0001001','0010111'];
    var EAN_R = ['1110010','1100110','1101100','1000010','1011100','1001110','1010000','1000100','1001000','1110100'];
    var EAN13_PARITY = ['LLLLLL','LLGLGG','LLGGLG','LLGGGL','LGLLGG','LGGLLG','LGGGLL','LGLGLG','LGLGGL','LGGLGL'];
    var GUARD_SIDE = '101';
    var GUARD_MID = '01010';

    var CODE128 = [
      '212222','222122','222221','121223','121322','131222','122213','122312','132212','221213',
      '221312','231212','112232','122132','122231','113222','123122','123221','223211','221132',
      '221231','213212','223112','312131','311222','321122','321221','312212','322112','322211',
      '212123','212321','232121','111323','131123','131321','112313','132113','132311','211313',
      '231113','231311','112133','112331','132131','113123','113321','133121','313121','211331',
      '231131','213113','213311','213131','311123','311321','331121','312113','312311','332111',
      '314111','221411','431111','111224','111422','121124','121421','141122','141221','112214',
      '112412','122114','122411','142112','142211','241211','221114','413111','241112','134111',
      '111242','121142','121241','114212','124112','124211','411212','421112','421211','212141',
      '214121','412121','111143','111341','131141','114113','114311','411113','411311','113141',
      '114131','311141','411131','211412','211214','211232','2331112'
    ];
    var C128_START_A = 103, C128_START_B = 104, C128_START_C = 105, C128_STOP = 106;
    var C128_TO_C = 99, C128_TO_B = 100, C128_TO_A = 101;

    var CODE39_CHARS = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-. $/+%';
    var CODE39 = {
      '0':'111331311','1':'311311113','2':'113311113','3':'313311111','4':'111331113',
      '5':'311331111','6':'113331111','7':'111311313','8':'311311311','9':'113311311',
      'A':'311113113','B':'113113113','C':'313113111','D':'111133113','E':'311133111',
      'F':'113133111','G':'111113313','H':'311113311','I':'113113311','J':'111133311',
      'K':'311111133','L':'113111133','M':'313111131','N':'111131133','O':'311131131',
      'P':'113131131','Q':'111111333','R':'311111331','S':'113111331','T':'111131331',
      'U':'331111113','V':'133111113','W':'333111111','X':'131131113','Y':'331131111',
      'Z':'133131111','-':'131111313','.':'331111311',' ':'133111311','$':'131313111',
      '/':'131311131','+':'131113131','%':'111313131','*':'131131311'
    };

    var ITF = ['11331','31113','13113','33111','11313','31311','13311','11133','31131','13131'];
    var ITF_START = '1111';
    var ITF_STOP = '311';

    var CODABAR = {
      '0':'1111122','1':'1111221','2':'1112112','3':'2211111','4':'1121121',
      '5':'2111121','6':'1211112','7':'1211211','8':'1221111','9':'2112111',
      '-':'1112211','$':'1122111',':':'2111212','/':'2121112','.':'2121211','+':'1121212',
      'A':'1122121','B':'1212112','C':'1112122','D':'1112221'
    };

    var SPECS = {
      ean13: { digits: 12, sample: '590123412345', quietLeft: 11, quietRight: 7 },
      ean8: { digits: 7, sample: '9638507', quietLeft: 7, quietRight: 7 },
      upca: { digits: 11, sample: '03600029145', quietLeft: 9, quietRight: 9 },
      itf14: { digits: 13, sample: '1540141253226', quietLeft: 10, quietRight: 10 },
      code128: { sample: 'ZeroTool-128', quietLeft: 10, quietRight: 10 },
      code39: { sample: 'ZEROTOOL 39', quietLeft: 10, quietRight: 10 },
      codabar: { sample: 'A1234567890B', quietLeft: 10, quietRight: 10 }
    };

    var HINTS = {
      ean13: '12 digits — GTIN-13, ISBN-13, ISSN, and JAN share this encoding.',
      ean8: '7 digits — compact retail packaging.',
      upca: '11 digits — GTIN-12, North American retail.',
      itf14: '13 digits — GTIN-14 shipping cartons.',
      code128: 'ASCII 0-127 — subsets A, B, and C are switched automatically.',
      code39: '0-9, A-Z, space, and - . $ / + %',
      codabar: '0-9 and - $ : / . + between A/B/C/D start and stop characters.'
    };

    /* ── Helpers ─────────────────────────────────────────────────────── */

    function $(id) { return wrap.querySelector('#' + id); }
    function text(name) { return wrap.dataset[name] || ''; }
    function fill(template, values) {
      return template.replace(/\{(\w+)\}/g, function(_, key) {
        return values[key] === undefined ? '' : String(values[key]);
      });
    }
    function repeat(ch, n) {
      var out = '';
      for (var i = 0; i < n; i++) out += ch;
      return out;
    }
    function widthsToModules(widths) {
      var out = '', bar = true;
      for (var i = 0; i < widths.length; i++) {
        out += repeat(bar ? '1' : '0', Number(widths[i]));
        bar = !bar;
      }
      return out;
    }
    function escapeXml(value) {
      return String(value).replace(/[&<>"']/g, function(c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&apos;' }[c];
      });
    }

    // Shared GS1 mod-10: weights 3,1,3,1... from the rightmost data digit.
    function gs1CheckDigit(digits) {
      var sum = 0;
      for (var i = digits.length - 1, w = 3; i >= 0; i--, w = 4 - w) sum += Number(digits[i]) * w;
      return (10 - sum % 10) % 10;
    }

    /* ── Encoders ────────────────────────────────────────────────────── */

    function encodeEanUpc(kind, full) {
      var out = GUARD_SIDE, i;
      if (kind === 'ean8') {
        for (i = 0; i < 4; i++) out += EAN_L[Number(full[i])];
        out += GUARD_MID;
        for (i = 4; i < 8; i++) out += EAN_R[Number(full[i])];
      } else {
        var parity = EAN13_PARITY[Number(full[0])];
        for (i = 1; i < 7; i++) out += (parity[i - 1] === 'L' ? EAN_L : EAN_G)[Number(full[i])];
        out += GUARD_MID;
        for (i = 7; i < 13; i++) out += EAN_R[Number(full[i])];
      }
      return out + GUARD_SIDE;
    }

    function code128CharValue(ch, mode) {
      var code = ch.charCodeAt(0);
      if (mode === 'A') return code < 32 ? code + 64 : code - 32;
      return code - 32;
    }

    function code128Values(data) {
      var values = [];
      var i = 0;

      function digitRun(pos) {
        var n = 0;
        while (pos + n < data.length && data.charCodeAt(pos + n) >= 48 && data.charCodeAt(pos + n) <= 57) n++;
        return n;
      }
      function isCtrl(pos) { return data.charCodeAt(pos) < 32; }

      var head = digitRun(0);
      var mode;
      if (head >= 4 || (head === data.length && head >= 2 && head % 2 === 0)) {
        mode = 'C'; values.push(C128_START_C);
      } else if (data.length && isCtrl(0)) {
        mode = 'A'; values.push(C128_START_A);
      } else {
        mode = 'B'; values.push(C128_START_B);
      }

      while (i < data.length) {
        if (mode === 'C') {
          var runC = digitRun(i);
          if (runC >= 2) {
            var pairs = Math.floor(runC / 2);
            for (var k = 0; k < pairs; k++) { values.push(Number(data.substr(i, 2))); i += 2; }
            continue;
          }
          if (isCtrl(i)) { values.push(C128_TO_A); mode = 'A'; }
          else { values.push(C128_TO_B); mode = 'B'; }
          continue;
        }

        var run = digitRun(i);
        // Switching to subset C costs one symbol, so it only pays off from six
        // digits inward (four at the very start, where the start symbol is free).
        if (run >= (values.length === 1 ? 4 : 6)) {
          if (run % 2 === 1) { values.push(code128CharValue(data[i], mode)); i++; }
          values.push(C128_TO_C);
          mode = 'C';
          continue;
        }
        if (mode === 'B' && isCtrl(i)) { values.push(C128_TO_A); mode = 'A'; continue; }
        if (mode === 'A' && data.charCodeAt(i) > 95) { values.push(C128_TO_B); mode = 'B'; continue; }
        values.push(code128CharValue(data[i], mode));
        i++;
      }

      var sum = values[0];
      for (var v = 1; v < values.length; v++) sum += values[v] * v;
      values.push(sum % 103);
      values.push(C128_STOP);
      return values;
    }

    function encodeCode128(data) {
      return code128Values(data).map(function(v) { return widthsToModules(CODE128[v]); }).join('');
    }

    function code39CheckChar(data) {
      var sum = 0;
      for (var i = 0; i < data.length; i++) sum += CODE39_CHARS.indexOf(data[i]);
      return CODE39_CHARS[sum % 43];
    }

    function encodeCode39(data) {
      var chars = ('*' + data + '*').split('');
      return chars.map(function(ch) { return widthsToModules(CODE39[ch]); }).join('0');
    }

    function encodeItf(full) {
      var out = widthsToModules(ITF_START);
      for (var i = 0; i < full.length; i += 2) {
        var barWidths = ITF[Number(full[i])];
        var spaceWidths = ITF[Number(full[i + 1])];
        for (var e = 0; e < 5; e++) {
          out += repeat('1', Number(barWidths[e]));
          out += repeat('0', Number(spaceWidths[e]));
        }
      }
      return out + widthsToModules(ITF_STOP);
    }

    function encodeCodabar(data) {
      return data.split('').map(function(ch) { return widthsToModules(CODABAR[ch]); }).join('0');
    }

    /* ── Validation + build ──────────────────────────────────────────── */

    function firstInvalid(data, test) {
      for (var i = 0; i < data.length; i++) if (!test(data[i])) return data[i];
      return '';
    }

    function build(kind, raw, options) {
      var spec = SPECS[kind];
      var data = raw.trim();
      if (!data) return { error: text('emptyInput') };

      var notice = '';
      var status = 'success';

      if (kind === 'ean13' || kind === 'ean8' || kind === 'upca' || kind === 'itf14') {
        if (!/^\d+$/.test(data)) return { error: fill(text('errDigits'), { n: spec.digits }) };
        var full;
        if (data.length === spec.digits) {
          var cd = gs1CheckDigit(data);
          full = data + cd;
          notice = fill(text('checkAppended'), { d: cd });
        } else if (data.length === spec.digits + 1) {
          var expected = gs1CheckDigit(data.slice(0, spec.digits));
          if (Number(data[spec.digits]) !== expected) {
            return { error: fill(text('checkWrong'), { d: expected }) };
          }
          full = data;
          notice = text('checkValid');
        } else {
          return { error: fill(text('errLength'), { n: spec.digits, got: data.length }) };
        }

        if (kind === 'itf14') {
          return {
            modules: encodeItf(full), hri: full, layout: 'plain', bearer: true,
            quietLeft: spec.quietLeft, quietRight: spec.quietRight, notice: notice, status: status
          };
        }
        var padded = kind === 'upca' ? '0' + full : full;
        var guards = kind === 'ean8'
          ? [[0, 3], [31, 36], [64, 67]]
          : [[0, 3], [45, 50], [92, 95]];
        if (kind === 'upca') guards = guards.concat([[3, 10], [85, 92]]);
        return {
          modules: encodeEanUpc(kind === 'ean8' ? 'ean8' : 'ean13', padded),
          hri: full, layout: kind, guards: guards,
          quietLeft: spec.quietLeft, quietRight: spec.quietRight, notice: notice, status: status
        };
      }

      if (kind === 'code128') {
        var bad128 = firstInvalid(data, function(ch) { return ch.charCodeAt(0) <= 127; });
        if (bad128) return { error: fill(text('errAscii'), { ch: bad128 }) };
        return {
          modules: encodeCode128(data), hri: data, layout: 'plain',
          quietLeft: spec.quietLeft, quietRight: spec.quietRight, notice: '', status: 'none'
        };
      }

      if (kind === 'code39') {
        var upper = data.toUpperCase();
        if (upper !== data) notice = text('lowercased');
        var bad39 = firstInvalid(upper, function(ch) { return CODE39[ch] !== undefined && ch !== '*'; });
        if (bad39) return { error: fill(text('errCode39'), { ch: bad39 }) };
        var payload = options.code39Check ? upper + code39CheckChar(upper) : upper;
        return {
          modules: encodeCode39(payload), hri: payload, layout: 'plain',
          quietLeft: spec.quietLeft, quietRight: spec.quietRight,
          notice: notice, status: notice ? 'info' : 'none'
        };
      }

      // Codabar: A/B/C/D delimit the payload; add them when the user omits them.
      var body = data.toUpperCase();
      var startStop = /^[ABCD]/.test(body) && /[ABCD]$/.test(body) && body.length >= 2;
      var payloadCb = startStop ? body.slice(1, -1) : body;
      var badCb = firstInvalid(payloadCb, function(ch) {
        return CODABAR[ch] !== undefined && 'ABCD'.indexOf(ch) < 0;
      });
      if (badCb) return { error: fill(text('errCodabar'), { ch: badCb }) };
      var framed = startStop ? body : 'A' + payloadCb + 'B';
      return {
        modules: encodeCodabar(framed), hri: framed, layout: 'plain',
        quietLeft: spec.quietLeft, quietRight: spec.quietRight, notice: '', status: 'none'
      };
    }

    /* ── SVG rendering ───────────────────────────────────────────────── */

    function inGuard(index, guards) {
      if (!guards) return false;
      for (var i = 0; i < guards.length; i++) {
        if (index >= guards[i][0] && index < guards[i][1]) return true;
      }
      return false;
    }

    function renderSvg(result, mw, height, showText) {
      var modules = result.modules;
      var quietL = result.quietLeft;
      var totalModules = quietL + modules.length + result.quietRight;
      var width = totalModules * mw;
      var fontSize = Math.max(9, mw * 7);
      var guardDrop = showText ? fontSize * 0.9 : 0;
      var textGap = fontSize * 0.25;
      var bearer = result.bearer ? Math.max(2, mw * 2) : 0;
      var top = bearer;
      var barBottom = top + height;
      var svgHeight = barBottom + guardDrop + (showText ? fontSize + textGap : 0) + bearer;

      var parts = [];
      parts.push('<rect width="' + width + '" height="' + svgHeight + '" fill="#ffffff"/>');

      if (bearer) {
        parts.push('<rect x="0" y="0" width="' + width + '" height="' + bearer + '" fill="#000000"/>');
        parts.push('<rect x="0" y="' + (barBottom) + '" width="' + width + '" height="' + bearer + '" fill="#000000"/>');
      }

      var i = 0;
      while (i < modules.length) {
        if (modules[i] === '0') { i++; continue; }
        var run = 0;
        var extended = inGuard(i, result.guards);
        while (i + run < modules.length && modules[i + run] === '1' && inGuard(i + run, result.guards) === extended) run++;
        var x = (quietL + i) * mw;
        var barHeight = height + (extended ? guardDrop : 0);
        parts.push('<rect x="' + x + '" y="' + top + '" width="' + (run * mw) + '" height="' + barHeight + '" fill="#000000"/>');
        i += run;
      }

      if (showText) {
        var baseline = barBottom + guardDrop + fontSize;
        var font = 'font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="' + fontSize + '" fill="#000000"';
        var hri = result.hri;
        if (result.layout === 'ean13' || result.layout === 'upca') {
          var isUpc = result.layout === 'upca';
          var lead = hri[0];
          var leftGroup = isUpc ? hri.slice(1, 6) : hri.slice(1, 7);
          var rightGroup = isUpc ? hri.slice(6, 11) : hri.slice(7, 13);
          var leftStart = isUpc ? quietL + 10 : quietL + 3;
          var leftSpan = isUpc ? 35 : 42;
          var rightStart = isUpc ? quietL + 50 : quietL + 50;
          var rightSpan = isUpc ? 35 : 42;
          parts.push('<text x="' + ((quietL - 1) * mw) + '" y="' + baseline + '" text-anchor="end" ' + font + '>' + escapeXml(lead) + '</text>');
          parts.push('<text x="' + (leftStart * mw) + '" y="' + baseline + '" textLength="' + (leftSpan * mw) + '" lengthAdjust="spacing" ' + font + '>' + escapeXml(leftGroup) + '</text>');
          parts.push('<text x="' + (rightStart * mw) + '" y="' + baseline + '" textLength="' + (rightSpan * mw) + '" lengthAdjust="spacing" ' + font + '>' + escapeXml(rightGroup) + '</text>');
          if (isUpc) {
            parts.push('<text x="' + ((quietL + modules.length + 1) * mw) + '" y="' + baseline + '" text-anchor="start" ' + font + '>' + escapeXml(hri[11]) + '</text>');
          }
        } else if (result.layout === 'ean8') {
          parts.push('<text x="' + ((quietL + 3) * mw) + '" y="' + baseline + '" textLength="' + (28 * mw) + '" lengthAdjust="spacing" ' + font + '>' + escapeXml(hri.slice(0, 4)) + '</text>');
          parts.push('<text x="' + ((quietL + 36) * mw) + '" y="' + baseline + '" textLength="' + (28 * mw) + '" lengthAdjust="spacing" ' + font + '>' + escapeXml(hri.slice(4)) + '</text>');
        } else {
          parts.push('<text x="' + (width / 2) + '" y="' + baseline + '" text-anchor="middle" ' + font + '>' + escapeXml(hri) + '</text>');
        }
      }

      return '<svg xmlns="http://www.w3.org/2000/svg" width="' + width + '" height="' + svgHeight
        + '" viewBox="0 0 ' + width + ' ' + svgHeight + '" role="img" aria-label="'
        + escapeXml(result.hri) + '">' + parts.join('') + '</svg>';
    }

    /* ── Wiring ──────────────────────────────────────────────────────── */

    var symbologyEl = $('bcode-symbology');
    var dataEl = $('bcode-data');
    var moduleEl = $('bcode-module');
    var heightEl = $('bcode-height');
    var showTextEl = $('bcode-showtext');
    var c39CheckEl = $('bcode-c39check');
    var c39ToggleEl = $('bcode-c39-toggle');
    var hintEl = $('bcode-hint');
    var statusEl = $('bcode-status');
    var metaEl = $('bcode-meta');
    var canvasEl = $('bcode-canvas');
    var moduleLabel = $('bcode-module-label');
    var heightLabel = $('bcode-height-label');
    var lastSvg = '';

    function setStatus(kind, message) {
      statusEl.className = 'tool-status ' + (kind || 'none');
      statusEl.textContent = message || '';
    }

    function currentOptions() {
      return { code39Check: c39CheckEl.checked };
    }

    function render() {
      var kind = symbologyEl.value;
      var mw = Number(moduleEl.value);
      var height = Number(heightEl.value);
      var showText = showTextEl.checked;

      hintEl.textContent = HINTS[kind] || '';
      c39ToggleEl.hidden = kind !== 'code39';
      moduleLabel.textContent = mw + 'px';
      heightLabel.textContent = height + 'px';

      var result = build(kind, dataEl.value, currentOptions());
      if (result.error) {
        lastSvg = '';
        canvasEl.innerHTML = '';
        metaEl.textContent = '';
        setStatus('error', result.error);
        setButtonsEnabled(false);
        return;
      }

      lastSvg = renderSvg(result, mw, height, showText);
      canvasEl.innerHTML = lastSvg;
      metaEl.textContent = fill(text('modules'), { n: result.modules.length });
      setStatus(result.notice ? result.status : 'none', result.notice);
      setButtonsEnabled(true);

      window.ztPersist && window.ztPersist.save(SLUG, {
        symbology: kind,
        data: dataEl.value,
        module: mw,
        height: height,
        showText: showText,
        code39Check: c39CheckEl.checked
      });
    }

    function setButtonsEnabled(enabled) {
      [$('bcode-png'), $('bcode-svg'), $('bcode-copy')].forEach(function(btn) {
        btn.disabled = !enabled;
      });
    }

    function downloadBlob(blob, filename) {
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(function() { URL.revokeObjectURL(url); }, 1000);
    }

    function fileBase() {
      return symbologyEl.value + '-' + (dataEl.value.trim().replace(/[^\w-]/g, '') || 'barcode');
    }

    symbologyEl.addEventListener('change', function() {
      var kind = symbologyEl.value;
      var probe = build(kind, dataEl.value, currentOptions());
      if (probe.error) dataEl.value = SPECS[kind].sample;
      render();
    });
    dataEl.addEventListener('input', render);
    [moduleEl, heightEl].forEach(function(el) { el.addEventListener('input', render); });
    [showTextEl, c39CheckEl].forEach(function(el) { el.addEventListener('change', render); });

    $('bcode-svg').addEventListener('click', function() {
      if (!lastSvg) return;
      downloadBlob(new Blob([lastSvg], { type: 'image/svg+xml' }), fileBase() + '.svg');
      window.trackTool && window.trackTool(SLUG, 'download_svg');
    });

    $('bcode-png').addEventListener('click', function() {
      if (!lastSvg) return;
      // Render at 4x so 1px modules stay crisp when printed or scaled.
      var scale = 4;
      var svgEl = canvasEl.querySelector('svg');
      var width = Number(svgEl.getAttribute('width'));
      var height = Number(svgEl.getAttribute('height'));
      var img = new Image();
      var blobUrl = URL.createObjectURL(new Blob([lastSvg], { type: 'image/svg+xml' }));
      img.onload = function() {
        var canvas = document.createElement('canvas');
        canvas.width = width * scale;
        canvas.height = height * scale;
        var ctx = canvas.getContext('2d');
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        URL.revokeObjectURL(blobUrl);
        canvas.toBlob(function(blob) {
          if (blob) downloadBlob(blob, fileBase() + '.png');
        }, 'image/png');
        window.trackTool && window.trackTool(SLUG, 'download_png');
      };
      img.onerror = function() { URL.revokeObjectURL(blobUrl); };
      img.src = blobUrl;
    });

    $('bcode-copy').addEventListener('click', function() {
      if (!lastSvg) return;
      var button = this;
      var original = text('copySvg');
      var task = navigator.clipboard && window.isSecureContext
        ? navigator.clipboard.writeText(lastSvg)
        : Promise.reject(new Error('clipboard unavailable'));
      task.then(function() {
        button.textContent = text('copied');
        button.classList.add('copied');
        setTimeout(function() {
          button.textContent = original;
          button.classList.remove('copied');
        }, 1400);
        window.trackTool && window.trackTool(SLUG, 'copy_svg');
      }).catch(function() {
        setStatus('error', text('copyFailed'));
      });
    });

    $('bcode-reset').addEventListener('click', function() {
      applyState(defaults());
      render();
      window.ztPersist && window.ztPersist.clear(SLUG);
      dataEl.focus();
      window.trackTool && window.trackTool(SLUG, 'reset');
    });

    function defaults() {
      return {
        symbology: 'ean13',
        data: SPECS.ean13.sample,
        module: 2,
        height: 80,
        showText: true,
        code39Check: false
      };
    }

    function applyState(state) {
      symbologyEl.value = SPECS[state.symbology] ? state.symbology : 'ean13';
      dataEl.value = typeof state.data === 'string' ? state.data : SPECS[symbologyEl.value].sample;
      moduleEl.value = String(Math.min(4, Math.max(1, Number(state.module) || 2)));
      heightEl.value = String(Math.min(160, Math.max(40, Number(state.height) || 80)));
      showTextEl.checked = state.showText !== false;
      c39CheckEl.checked = state.code39Check === true;
    }

    window.addEventListener('storage', function(event) {
      if (event.key === 'zt-input-' + SLUG && event.newValue === null) {
        applyState(defaults());
        render();
      }
    });

    var saved = (window.ztPersist && window.ztPersist.load(SLUG)) || {};
    applyState(Object.assign(defaults(), saved));

    // Self-checks: structural invariants plus two published reference values.
    var ean13Check = build('ean13', '590123412345', { code39Check: false });
    var upcaCheck = build('upca', '03600029145', { code39Check: false });
    console.assert(
      ean13Check.modules.length === 95
      && ean13Check.hri === '5901234123457'
      && upcaCheck.hri === '036000291452'
      && encodeCode128('PJJ123C').length > 0
      && code128Values('PJJ123C')[code128Values('PJJ123C').length - 2] === 55,
      'Barcode symbology self-check failed'
    );

    render();
  })();
</script>

<style is:global>
  .bcode-wrap {
    --category-color: var(--color-cat-dev);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .bcode-controls,
  .bcode-appearance,
  .bcode-preview-card {
    padding: 1rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface-muted);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }

  .bcode-section-title {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 760;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .bcode-field-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .bcode-appearance .bcode-field-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .bcode-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .bcode-field .tool-input {
    width: 100%;
  }

  .bcode-select {
    appearance: auto;
  }

  .bcode-hint {
    margin: 0.6rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .bcode-controls .tool-status {
    display: block;
    margin-top: 0.4rem;
  }

  .bcode-toggles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.9rem;
  }

  .bcode-toggle {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .bcode-toggle input {
    flex-shrink: 0;
  }

  .bcode-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .bcode-card-meta {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
  }

  /* The preview stays white in every theme — barcodes are only scannable as
     dark bars on a light background, and the SVG export must match it. */
  .bcode-canvas {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 140px;
    margin-top: 0.75rem;
    padding: 1rem;
    overflow-x: auto;
    border-radius: var(--radius-md);
    background: #ffffff;
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }

  .bcode-canvas svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .bcode-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.9rem;
    flex-wrap: wrap;
  }

  .bcode-actions button[disabled] {
    cursor: not-allowed;
    opacity: 0.55;
  }

  @media (max-width: 760px) {
    .bcode-field-grid,
    .bcode-appearance .bcode-field-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .bcode-controls,
    .bcode-appearance,
    .bcode-preview-card {
      padding: 0.85rem;
    }

    .bcode-field .tool-input {
      min-height: 44px;
    }

    .bcode-canvas {
      padding: 0.75rem;
      justify-content: flex-start;
    }
  }
</style>
