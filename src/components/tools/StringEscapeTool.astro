      var ESCAPERS = { json: jsonEscape, js: jsEscape, java: javaEscape, c: cEscape, python: pyEscape, html: htmlEscape, xml: xmlEscape, csv: csvEscape, sql: sqlEscape, regex: regexEscape, shell: shellEscape };
      var UNESCAPERS = { json: jsonUnescape, js: jsUnescape, java: javaUnescape, c: cUnescape, python: pyUnescape, html: htmlUnescape, xml: xmlUnescape, csv: csvUnescape, sql: sqlUnescape, regex: regexUnescape, shell: shellUnescape };

      function convert(mode, direction, text, opts, env) {
        var o = {};
        for (var k in DEFAULT_OPTS) o[k] = DEFAULT_OPTS[k];
        if (opts) for (var j in opts) if (Object.prototype.hasOwnProperty.call(opts, j)) o[j] = opts[j];
        var fn = (direction === 'unescape' ? UNESCAPERS : ESCAPERS)[mode];
        var r = fn(text, o, env || {});
        // Japanese and Korean Windows fonts draw the backslash as ¥ or ₩, so escapes copied
        // from a screenshot or retyped by hand can contain the real yen / won sign instead.
        if (direction === 'unescape' && !r.error && BACKSLASH_MODES.indexOf(mode) >= 0) {
          var m = LOOKALIKE_RE.exec(text);
          if (m) r.notes.push({ key: 'backslashLookalike', ch: m[1], cp: uPlus(m[1].charCodeAt(0)), seq: m[0] });
        }
        return r;
      }
      var BACKSLASH_MODES = ['json', 'js', 'java', 'c', 'python', 'regex', 'sql'];
      var LOOKALIKE_RE = /([\u00A5\u20A9\uFF3C\uFFE5\uFFE6])[nrtbfvux"'\\\/]/;

      // "{n}" style placeholders; values are inserted as plain text.
      function fill(template, fields) {
        return template.replace(/\{(\w+)\}/g, function (m, k) {
          return fields && fields[k] !== undefined ? String(fields[k]) : m;
        });
      }
      /* ── engine:end ── */

      // ＼ (U+FF3C), ￥ (U+FFE5) and ￦ (U+FFE6) are full-width forms that come from full-width
      // input, not the yen / won signs that Japanese and Korean Windows fonts draw for the
      // backslash, so they get their own note text.
      function noteKey(n) {
        return n.key === 'backslashLookalike' && /^[\uFF3C\uFFE5\uFFE6]$/.test(n.ch) ? 'backslashFullwidth' : n.key;
      }

      var SLUG = 'string-escape';
      var SAMPLES = {
        base: 'He said "hi" \uD83D\uDC4B\nPath: C:\\temp\\new\t\u4E2D\u6587',
        html: '<a href="?q=1&lang=en">Tom\'s caf\u00E9</a>',
        xml: '<a href="?q=1&lang=en">Tom\'s caf\u00E9</a>',
        csv: '=SUM(A1:A3), "total"',
        sql: "O'Brien\\Sales",
        regex: 'price: $9.99 (USD)?',
        shell: "it's my file.txt"
      };

      var modeEl = document.getElementById('se-mode');
      var inputEl = document.getElementById('se-input');
      var outputEl = document.getElementById('se-output');
      var inputLabel = document.getElementById('se-input-label');
      var outputLabel = document.getElementById('se-output-label');
      var statusEl = document.getElementById('se-status');
      var copyBtn = document.getElementById('se-copy');
      var dirBtns = document.querySelectorAll('.se-dir-btn');
      var optWraps = document.querySelectorAll('.se-opt');
      var optEls = document.querySelectorAll('[data-opt]');

      var state = { mode: 'json', dir: 'escape', opts: {} };
      for (var k in DEFAULT_OPTS) state.opts[k] = DEFAULT_OPTS[k];

      // HTML references are decoded by the browser's own parser, in a document that has
      // no browsing context (scripts do not run, images do not load). Text is parsed as
      // the content of a <textarea> (RCDATA), so tags stay text. A leading "x" keeps a
      // leading line break, and splitting on CR keeps CR, which the parser turns into LF.
      var inertDoc = document.implementation.createHTMLDocument('');
      function decodeHtml(s) {
        return s.split('\r').map(function (part) {
          var ta = inertDoc.createElement('textarea');
          ta.innerHTML = 'x' + part;
          return ta.value.slice(1);
        }).join('\r');
      }
      var env = { decodeHtml: decodeHtml };

      function loadPrefs() {
        var saved = (window.ztPersist && window.ztPersist.load(SLUG)) || {};
        if (MODES.indexOf(saved.mode) >= 0) state.mode = saved.mode;
        if (saved.dir === 'escape' || saved.dir === 'unescape') state.dir = saved.dir;
        if (saved.opts && typeof saved.opts === 'object') {
          for (var key in DEFAULT_OPTS) {
            if (saved.opts[key] !== undefined && typeof saved.opts[key] === typeof DEFAULT_OPTS[key]) state.opts[key] = saved.opts[key];
          }
        }
      }
      function savePrefs() {
        if (window.ztPersist) window.ztPersist.save(SLUG, { mode: state.mode, dir: state.dir, opts: state.opts });
      }

      function count(n) { return fill(t.chars[n === 1 ? 0 : 1], { n: n }); }
      function setStatus(msg, kind) {
        statusEl.textContent = msg;
        statusEl.className = 'tool-status se-status' + (kind ? ' ' + kind : '');
      }
      function errorText(r) {
        var fields = {};
        for (var key in r) fields[key] = r[key];
        fields.at = fill(r.multiline ? t.atLine : t.atPos, r);
        fields.mode = t.modes[state.mode];
        return fill(t.err[r.error] || r.error, fields);
      }

      function applyUI() {
        modeEl.value = state.mode;
        dirBtns.forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-dir') === state.dir ? 'true' : 'false'); });
        optWraps.forEach(function (w) {
          var show = w.getAttribute('data-mode') === state.mode && (w.getAttribute('data-dir') === 'both' || w.getAttribute('data-dir') === state.dir);
          w.hidden = !show;
        });
        optEls.forEach(function (el) {
          var key = el.getAttribute('data-opt');
          if (el.type === 'checkbox') el.checked = !!state.opts[key];
          else el.value = state.opts[key];
        });
        var escapedLabel = fill(t.labelEscaped, { mode: t.modes[state.mode] });
        inputLabel.textContent = state.dir === 'escape' ? t.labelText : escapedLabel;
        outputLabel.textContent = state.dir === 'escape' ? escapedLabel : t.labelText;
        inputEl.placeholder = state.dir === 'escape' ? t.phEscape : t.phUnescape;
      }

      var tracked = {};
      function run() {
        var text = inputEl.value;
        if (!text) { outputEl.value = ''; setStatus('', ''); return; }
        var r = convert(state.mode, state.dir, text, state.opts, env);
        if (r.error) {
          outputEl.value = '';
          setStatus(errorText(r), 'error');
          return;
        }
        outputEl.value = r.output;
        var msg = fill(state.dir === 'escape' ? t.escaped : t.unescaped, { from: count(countCodePoints(text)), to: count(countCodePoints(r.output)) });
        var notes = r.notes.map(function (n) { return fill(t.note[noteKey(n)] || n.key, n); });
        setStatus(notes.length ? msg + ' ' + notes.join(' ') : msg, notes.length ? 'info' : 'success');
        var tag = state.mode + '_' + state.dir;
        if (!tracked[tag] && window.trackTool) { tracked[tag] = true; window.trackTool('string-escape', tag); }
      }

      var timer = null;
      inputEl.addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(run, inputEl.value.length > 200000 ? 300 : 80);
      });

      modeEl.addEventListener('change', function () {
        state.mode = modeEl.value;
        applyUI(); savePrefs(); run();
      });
      dirBtns.forEach(function (b) {
        b.addEventListener('click', function () {
          var d = b.getAttribute('data-dir');
          if (d === state.dir) return;
          state.dir = d;
          applyUI(); savePrefs(); run();
        });
      });
      optEls.forEach(function (el) {
        el.addEventListener('change', function () {
          var key = el.getAttribute('data-opt');
          state.opts[key] = el.type === 'checkbox' ? el.checked : el.value;
          savePrefs(); run();
        });
      });

      document.getElementById('se-swap').addEventListener('click', function () {
        var r = outputEl.value;
        state.dir = state.dir === 'escape' ? 'unescape' : 'escape';
        inputEl.value = r;
        applyUI(); savePrefs(); run();
        inputEl.focus();
      });
      document.getElementById('se-clear').addEventListener('click', function () {
        clearTimeout(timer);
        inputEl.value = '';
        outputEl.value = '';
        setStatus('', '');
        inputEl.focus();
      });
      document.getElementById('se-example').addEventListener('click', function () {
        var sample = SAMPLES[state.mode] || SAMPLES.base;
        if (state.dir === 'unescape') {
          var e = convert(state.mode, 'escape', sample, state.opts, env);
          sample = e.error ? '' : e.output;
        }
        inputEl.value = sample;
        run();
      });
      // The page-wide Ctrl/Cmd+L shortcut empties the text boxes; clear the status too.
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L')) {
          setTimeout(function () { if (!inputEl.value) { outputEl.value = ''; setStatus('', ''); } }, 0);
        }
      });

      copyBtn.addEventListener('click', function () {
        if (!outputEl.value) return;
        navigator.clipboard.writeText(outputEl.value).then(function () {
          copyBtn.textContent = t.copied;
          setTimeout(function () { copyBtn.textContent = t.copy; }, 1500);
        });
      });

      loadPrefs();
      applyUI();
    })();
  </script>
</div>

<style>
  /* v2 "convert" layout: the root is a flex column, so the two boxes (.zt-io in
     tool-common.css) take the height that is left under the toolbar, options and status line. */
  .se-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-height: 0; }

  .se-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; }
  .se-field { display: inline-flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .se-select { width: auto; max-width: 100%; min-width: 0; font-family: var(--font-sans, inherit); }
  .se-bar-end { display: inline-flex; flex-wrap: wrap; gap: 0.4rem; margin-left: auto; }

  .se-dir {
    display: inline-flex;
    padding: 3px;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }
  .se-dir-btn {
    min-height: 34px;
    padding: 0.3rem 0.9rem;
    border: 0;
    border-radius: calc(var(--radius-md) - 2px);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }
  .se-dir-btn[aria-pressed="true"] { background: var(--color-surface); color: var(--color-primary); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12); }
  .se-dir-btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 1px; }

  .se-options { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; align-items: center; font-size: 0.88rem; }
  .se-options:not(:has(.se-opt:not([hidden]))) { display: none; }
  .se-opt, .se-opt-in { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--color-text-secondary); }
  .se-opt { max-width: 100%; }
  .se-opt-in { min-width: 0; }
  .se-opt[hidden] { display: none; }
  .se-mini { font-size: 0.85rem; padding: 0.2rem 0.4rem; min-height: 30px; min-width: 0; max-width: 100%; }

  .se-status { margin: 0; overflow-wrap: anywhere; }

  .se-head { display: flex; align-items: center; gap: 0.25rem; min-height: 32px; }
  .se-head .btn-copy { margin-left: auto; }

  /* Stacked: the options move after the boxes, which get a fixed height. */
  @media (max-width: 860px) {
    .se-options { order: 5; }
    .se-textarea { height: 160px; }
  }

  /* Phones: format and direction take the first rows, the three buttons share one row,
     and both boxes start inside the first screen. */
  @media (max-width: 640px) {
    .se-wrap { gap: 0.5rem; }
    .se-bar { gap: 0.4rem; }
    .se-format { flex: 1 1 150px; }
    .se-format .tool-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .se-select { flex: 1 1 auto; width: 100%; }
    .se-dir-field { flex: 1 1 auto; }
    .se-dir { flex: 1 1 auto; }
    .se-dir-btn { flex: 1; min-height: 44px; padding: 0.3rem 0.55rem; font-size: 0.85rem; }
    .se-bar-end { flex: 1 1 100%; margin-left: 0; }
    .se-bar-end button { flex: 1 1 0; padding-left: 0.3rem; padding-right: 0.3rem; white-space: nowrap; }
    .se-textarea { height: 100px; min-height: 100px; }
    .se-mini { min-height: 36px; }
    .se-options { gap: 0 0.9rem; }
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .se-dir-btn[aria-pressed="true"] { background: var(--color-primary); color: var(--color-primary-contrast); }
  }
  :global([data-theme="dark"]) .se-dir-btn[aria-pressed="true"] { background: var(--color-primary); color: var(--color-primary-contrast); }
</style>
