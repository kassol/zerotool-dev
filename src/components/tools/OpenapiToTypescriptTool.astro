      optional: "Make generated schema properties optional, including matching Zod properties. Path parameters still follow their own required flags. Changes apply immediately.",
      paths: "Add namespaces for operations, with parameter, JSON request-body and JSON response types. The root namespace names the wrapper. Changes apply immediately.",
      zod: "Add Zod schemas alongside TypeScript declarations. Generated code includes the Zod import; it is not a full OpenAPI validator. Changes apply immediately.",
      example: "Replace the input with a Pet Store specification, then generate using the current namespace and options.",
      clear: "Clear the specification, output and status while keeping the namespace and options. Ctrl/⌘+L in this tool also clears the namespace.",
      copy: "Copy the complete displayed TypeScript, including any path types and Zod schemas. Empty output is not copied.",
    },
    rootName: 'Root namespace',
    makeOptional: 'Make properties optional',
    includePaths: 'Include path types',
    includeZod: 'Include Zod schemas',
