      example: "입력을 Pet Store 스펙으로 바꾸고 현재 네임스페이스와 옵션으로 즉시 생성합니다.",
      clear: "스펙, 출력과 상태를 지우고 네임스페이스와 옵션은 유지합니다. 도구 안의 Ctrl/⌘+L은 네임스페이스도 지웁니다.",
      copy: "활성화한 path 타입과 Zod 스키마를 포함한 TypeScript 출력 전체를 복사합니다. 출력이 비어 있으면 복사하지 않습니다.",
    },
    rootName: '루트 네임스페이스',
    makeOptional: '속성을 모두 선택적으로',
    includePaths: 'path 타입 포함',
    includeZod: 'Zod 스키마 포함',
    inputLabel: 'OpenAPI 스펙 (YAML 또는 JSON)',
    outputLabel: 'TypeScript 출력',
    example: '예시',
    clear: '지우기',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사에 실패했습니다. 다시 시도하세요.',
    msgParseError: 'YAML/JSON 파싱 오류: ',
    msgNotOpenApi: '문서가 OpenAPI 3.x 객체가 아닙니다.',
    msgUnsupportedVersion: 'OpenAPI 3.0+ 만 지원합니다. 현재 버전: ',
    msgSwagger2: 'Swagger 2.0은 지원하지 않습니다. editor.swagger.io에서 OpenAPI 3.x로 마이그레이션 후 사용하세요.',
    msgEmpty: '생성할 항목이 없습니다. 스펙에 components/schemas 또는 paths를 추가하세요.',
    msgGenerated: '{n}개 인터페이스 생성 완료.',
    msgUnresolved: '지원하지 않음: {refs}에 대한 $ref. #/components/schemas/...(path 타입에서는 #/components/parameters/...도)만 해석하며, 이 참조는 unknown으로 출력합니다. 먼저 redocly bundle 등으로 스펙을 한 파일로 합치세요.',
  },
};
const L = STRINGS[lang];
---

<div
  class="opts-wrap"
  data-lang={lang}
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-msg-parse-error={L.msgParseError}
  data-msg-not-openapi={L.msgNotOpenApi}
  data-msg-unsupported-version={L.msgUnsupportedVersion}
  data-msg-swagger2={L.msgSwagger2}
  data-msg-empty={L.msgEmpty}
  data-msg-generated={L.msgGenerated}
  data-msg-unresolved={L.msgUnresolved}
>
  <div class="opts-config">
    <div class="opts-root-row">
      <div class="opts-control-label"><label for="opts-root">{L.rootName}</label><Toggletip id="opts-tip-root" lang={lang} about={L.rootName}>{L.tips.root}</Toggletip></div>
      <input id="opts-root" type="text" value="Components" spellcheck="false" />
    </div>
    <div class="opts-checks">
      <div class="opts-control-label"><label class="opts-check"><input id="opts-optional" type="checkbox" /><span>{L.makeOptional}</span></label><Toggletip id="opts-tip-optional" lang={lang} about={L.makeOptional}>{L.tips.optional}</Toggletip></div>
      <div class="opts-control-label"><label class="opts-check"><input id="opts-paths" type="checkbox" /><span>{L.includePaths}</span></label><Toggletip id="opts-tip-paths" lang={lang} about={L.includePaths}>{L.tips.paths}</Toggletip></div>
      <div class="opts-control-label"><label class="opts-check"><input id="opts-zod" type="checkbox" /><span>{L.includeZod}</span></label><Toggletip id="opts-tip-zod" lang={lang} about={L.includeZod}>{L.tips.zod}</Toggletip></div>
    </div>
  </div>
  <div class="opts-actions">
    <div class="opts-control-label"><button id="opts-example" class="btn-ghost" type="button">{L.example}</button><Toggletip id="opts-tip-example" lang={lang} about={L.example}>{L.tips.example}</Toggletip></div>
    <div class="opts-control-label"><button id="opts-clear" class="btn-ghost" type="button">{L.clear}</button><Toggletip id="opts-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip></div>
  </div>
  <div id="opts-status" class="tool-status" aria-live="polite"></div>

  <div class="opts-panels zt-io">
    <div class="opts-panel zt-io-pane">
      <div class="opts-panel-header"><div class="opts-control-label"><label for="opts-input">{L.inputLabel}</label><Toggletip id="opts-tip-input" lang={lang} about={L.inputLabel}>{L.tips.input}</Toggletip></div></div>
      <textarea
        id="opts-input"
        class="opts-input zt-io-fill"
        spellcheck="false"
        autocomplete="off"
        placeholder={`openapi: 3.0.3
info:
  title: Pets
  version: 1.0.0
components:
  schemas:
    Pet:
      type: object
      required: [id, name]
      properties:
        id: { type: integer }
        name: { type: string }`}
      ></textarea>
    </div>
    <div class="opts-panel opts-output-pane zt-io-pane">
      <div class="opts-panel-header">
        <span id="opts-output-label">{L.outputLabel}</span>
        <div class="opts-control-label"><button id="opts-copy" class="btn-copy" type="button">{L.copy}</button><Toggletip id="opts-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip></div>
      </div>
      <p class="opts-empty zt-io-fill">{L.empty}</p>
      <pre id="opts-output" class="opts-output zt-io-fill" tabindex="0" aria-labelledby="opts-output-label"><code id="opts-output-code"></code></pre>
    </div>
  </div>
</div>

<script>
  import jsyaml from 'js-yaml';
  import { yamlErrorText } from './yaml-limits.js';

  const wrap = document.querySelector<HTMLElement>('.opts-wrap');
  if (!wrap) throw new Error('opts-wrap missing');

  const COPY = wrap.dataset.copy || 'Copy';
  const COPIED = wrap.dataset.copied || 'Copied!';
  const COPY_FAILED = wrap.dataset.copyFailed || 'Copy failed. Try again.';
  const MSG_PARSE_ERROR = wrap.dataset.msgParseError || 'Parse error: ';
  const MSG_NOT_OPENAPI = wrap.dataset.msgNotOpenapi || 'Not an OpenAPI 3.x object.';
  const MSG_UNSUPPORTED = wrap.dataset.msgUnsupportedVersion || 'Unsupported version: ';
  const MSG_SWAGGER2 = wrap.dataset.msgSwagger2 || 'Swagger 2.0 is not supported.';
  const MSG_EMPTY = wrap.dataset.msgEmpty || 'Nothing to generate.';
  const MSG_GENERATED = wrap.dataset.msgGenerated || 'Generated {n}.';
  const MSG_UNRESOLVED = wrap.dataset.msgUnresolved || 'Not resolved: {refs}.';

  const inputEl = document.getElementById('opts-input') as HTMLTextAreaElement;
  const outputCodeEl = document.getElementById('opts-output-code')!;
  const statusEl = document.getElementById('opts-status')!;
  const rootEl = document.getElementById('opts-root') as HTMLInputElement;
  const optionalEl = document.getElementById('opts-optional') as HTMLInputElement;
  const pathsEl = document.getElementById('opts-paths') as HTMLInputElement;
  const zodEl = document.getElementById('opts-zod') as HTMLInputElement;
  const exampleBtn = document.getElementById('opts-example')!;
  const clearBtn = document.getElementById('opts-clear')!;
  const copyBtn = document.getElementById('opts-copy')!;
  let copyRevision = 0;
  let copyTimer: number | null = null;

  function resetCopy(): void {
    copyRevision++;
    if (copyTimer !== null) window.clearTimeout(copyTimer);
    copyBtn.textContent = COPY;
    copyBtn.classList.remove('copied');
  }

  const EXAMPLE = `openapi: 3.0.3
info:
  title: Pet Store
  version: 1.0.0
paths:
  /pets:
    get:
      operationId: listPets
      parameters:
        - name: limit
          in: query
          schema: { type: integer }
      responses:
        '200':
          description: A list of pets
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Pet'
    post:
      operationId: createPet
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NewPet'
      responses:
        '201':
          description: Created
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Pet'
  /pets/{id}:
    get:
      operationId: getPetById
      parameters:
        - name: id
          in: path
          required: true
          schema: { type: integer }
      responses:
        '200':
          description: A pet
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Pet'
components:
  schemas:
    Pet:
      type: object
      required: [id, name, status]
      properties:
        id: { type: integer, format: int64 }
        name: { type: string }
        tag: { type: string, nullable: true }
        status:
          type: string
          enum: [available, pending, sold]
        photo: { type: string, format: binary }
    NewPet:
      type: object
      required: [name]
      properties:
        name: { type: string }
        tag: { type: string }
`;

  function setStatus(msg: string, kind: 'success' | 'error' | 'info' | 'none' = 'info'): void {
    statusEl.textContent = msg;
    statusEl.className = `tool-status ${kind === 'none' ? '' : kind}`;
  }

  /* ── engine:start ── */
  function pascalCase(s: string): string {
    return s
      .replace(/[^a-zA-Z0-9]+(.)/g, (_, ch) => ch.toUpperCase())
      .replace(/^(.)/, (_, ch) => ch.toUpperCase());
  }

  // Names TypeScript does not accept as a type or interface name, plus reserved words.
  const RESERVED_NAMES = new Set([
    'any', 'unknown', 'never', 'string', 'number', 'boolean', 'symbol', 'object', 'bigint',
    'undefined', 'void', 'null', 'true', 'false', 'this', 'break', 'case', 'catch', 'class',
    'const', 'continue', 'debugger', 'default', 'delete', 'do', 'else', 'enum', 'export',
    'extends', 'finally', 'for', 'function', 'if', 'import', 'in', 'instanceof', 'new',
    'return', 'super', 'switch', 'throw', 'try', 'typeof', 'var', 'while', 'with',
    'implements', 'interface', 'let', 'package', 'private', 'protected', 'public', 'static',
    'yield', 'await', 'type', 'namespace', 'module', 'declare', 'readonly', 'keyof', 'infer',
    'is', 'asserts', 'abstract', 'as', 'satisfies', 'z'
  ]);

  function safeIdent(s: string): string {
    let id = s.replace(/[^a-zA-Z0-9_$]/g, '_');
    if (!id || /^[0-9]/.test(id)) id = '_' + id;
    if (RESERVED_NAMES.has(id)) id = id + '_';
    return id;
  }

  function safeKey(k: string): string {
    return /^[a-zA-Z_$][a-zA-Z0-9_$]*$/.test(k) ? k : JSON.stringify(k);
  }

  function formatHint(schema: any): string {
    if (!schema || !schema.format) return '';
    const f = schema.format;
    if (f === 'date-time') return '/** ISO 8601 date-time */ ';
    if (f === 'date') return '/** ISO 8601 date (YYYY-MM-DD) */ ';
    if (f === 'uuid') return '/** UUID */ ';
    if (f === 'email') return '/** email address */ ';
    if (f === 'uri' || f === 'url') return '/** URI */ ';
    return '';
  }

  type Ctx = {
    doc: any;
    names: Map<string, string>;      // components/schemas key -> TypeScript identifier
    declared: Map<string, string>;   // identifier -> declaration
    declarationOrder: string[];
    optional: boolean;
    unsupportedRefs: Set<string>;
  };

  // components/schemas keys -> unique identifiers ("pet-status" -> "pet_status").
  function buildNameMap(doc: any): Map<string, string> {
    const names = new Map<string, string>();
    const used = new Set<string>();
    const schemas = doc?.components?.schemas;
    if (!schemas || typeof schemas !== 'object') return names;
    for (const key of Object.keys(schemas)) {
      let id = safeIdent(key);
      let n = 2;
      while (used.has(id)) id = safeIdent(key) + '_' + n++;
      used.add(id);
      names.set(key, id);
    }
    return names;
  }

  // JSON Pointer (RFC 6901) inside a URI fragment: percent-decode, then ~1 -> / and ~0 -> ~.
  function decodePointerToken(t: string): string {
    let d = t;
    try { d = decodeURIComponent(t); } catch { /* keep as is */ }
    return d.replace(/~1/g, '/').replace(/~0/g, '~');
  }

  // Returns the components/schemas key for a local ref, or null for anything else.
  function refToSchemaKey(ref: string, doc: any): string | null {
    const m = /^#\/components\/schemas\/([^/]+)$/.exec(String(ref));
    if (!m) return null;
    const key = decodePointerToken(m[1]);
    const schemas = doc?.components?.schemas;
    if (!schemas || !Object.prototype.hasOwnProperty.call(schemas, key)) return null;
    return key;
  }

  function refName(ref: string, ctx: Ctx): string | null {
    const key = refToSchemaKey(ref, ctx.doc);
    if (key === null) {
      ctx.unsupportedRefs.add(String(ref));
      return null;
    }
    return ctx.names.get(key) || null;
  }

  function isNullable(schema: any): boolean {
    if (schema && schema.nullable === true) return true;
    if (Array.isArray(schema.type) && schema.type.includes('null')) return true;
    return false;
  }

  function getBaseType(schema: any): string | undefined {
    if (Array.isArray(schema.type)) {
      const nonNull = schema.type.filter((t: string) => t !== 'null');
      return nonNull[0];
    }
    return schema.type;
  }

  function literalTs(v: any): string {
    if (v === null) return 'null';
    if (typeof v === 'string' || typeof v === 'number' || typeof v === 'boolean') return JSON.stringify(v);
    return 'unknown';
  }

  function schemaToTs(schema: any, nameHint: string, ctx: Ctx, indent = 0): string {
    if (!schema || typeof schema !== 'object') return 'unknown';

    if (schema.$ref) {
      const name = refName(schema.$ref, ctx);
      if (name === null) return `unknown /* unresolved $ref: ${String(schema.$ref).replace(/\*\//g, '*\\/')} */`;
      return name;
    }

    if (Object.prototype.hasOwnProperty.call(schema, 'const')) {
      const ts = literalTs(schema.const);
      return isNullable(schema) && schema.const !== null ? `${ts} | null` : ts;
    }

    if (Array.isArray(schema.enum)) {
      const ts = schema.enum.map(literalTs).join(' | ');
      return isNullable(schema) ? `${ts} | null` : ts;
    }

    if (Array.isArray(schema.oneOf)) {
      const parts = schema.oneOf.map((s: any, i: number) => schemaToTs(s, `${nameHint}Variant${i + 1}`, ctx, indent));
      const ts = parts.join(' | ');
      return isNullable(schema) ? `(${ts}) | null` : ts;
    }

    if (Array.isArray(schema.anyOf)) {
      const parts = schema.anyOf.map((s: any, i: number) => schemaToTs(s, `${nameHint}Variant${i + 1}`, ctx, indent));
      const ts = parts.join(' | ');
      return isNullable(schema) ? `(${ts}) | null` : ts;
    }

    if (Array.isArray(schema.allOf)) {
      const parts = schema.allOf.map((s: any, i: number) => schemaToTs(s, `${nameHint}Part${i + 1}`, ctx, indent));
      const ts = parts.join(' & ');
      return isNullable(schema) ? `(${ts}) | null` : ts;
    }

    const baseType = getBaseType(schema);
    const nullable = isNullable(schema);
    let ts: string;

    switch (baseType) {
      case 'string':
        if (schema.format === 'binary') ts = 'Blob';
        else ts = 'string';
        break;
      case 'integer':
      case 'number':
        ts = 'number';
        break;
      case 'boolean':
        ts = 'boolean';
        break;
      case 'null':
        ts = 'null';
        break;
      case 'array': {
        const itemTs = schemaToTs(schema.items || {}, `${nameHint}Item`, ctx, indent);
        ts = /[\s|&]/.test(itemTs) ? `(${itemTs})[]` : `${itemTs}[]`;
        break;
      }
      case 'object':
      case undefined: {
        if (schema.properties || schema.additionalProperties) {
          ts = inlineObject(schema, nameHint, ctx, indent);
        } else {
          ts = 'Record<string, unknown>';
        }
        break;
      }
      default:
        ts = 'unknown';
    }

    return nullable && ts !== 'null' ? `${ts} | null` : ts;
  }

  function inlineObject(schema: any, nameHint: string, ctx: Ctx, indent: number): string {
    const pad = '  '.repeat(indent + 1);
    const closePad = '  '.repeat(indent);
    const required = new Set<string>(Array.isArray(schema.required) ? schema.required : []);
    const lines: string[] = [];

    if (schema.properties && typeof schema.properties === 'object') {
      for (const [k, v] of Object.entries(schema.properties)) {
        const opt = ctx.optional || !required.has(k) ? '?' : '';
        const propTs = schemaToTs(v, `${nameHint}${pascalCase(k)}`, ctx, indent + 1);
        const hint = formatHint(v as any);
        lines.push(`${pad}${hint}${safeKey(k)}${opt}: ${propTs};`);
      }
    }

    if (schema.additionalProperties === true) {
      lines.push(`${pad}[key: string]: unknown;`);
    } else if (schema.additionalProperties && typeof schema.additionalProperties === 'object') {
      const apTs = schemaToTs(schema.additionalProperties, `${nameHint}Extra`, ctx, indent + 1);
      lines.push(`${pad}[key: string]: ${apTs};`);
    }

    if (lines.length === 0) return 'Record<string, unknown>';
    return `{\n${lines.join('\n')}\n${closePad}}`;
  }

  function newCtx(doc: any, optional: boolean): Ctx {
    return { doc, names: buildNameMap(doc), declared: new Map(), declarationOrder: [], optional, unsupportedRefs: new Set() };
  }

  function renderSchemaDeclaration(name: string, schema: any, ctx: Ctx): string {
    // If schema is an object with properties, render as interface; otherwise type alias.
    const isObjectInterface =
      schema && typeof schema === 'object' &&
      !schema.$ref &&
      !schema.enum &&
      !Object.prototype.hasOwnProperty.call(schema, 'const') &&
      !schema.oneOf &&
      !schema.anyOf &&
      !schema.allOf &&
      !isNullable(schema) &&
      (getBaseType(schema) === 'object' || (!getBaseType(schema) && schema.properties));

    if (isObjectInterface && (schema.properties || schema.additionalProperties)) {
      return `export interface ${name} ${inlineObject(schema, name, ctx, 0)}`;
    }

    const ts = schemaToTs(schema, name, ctx, 0);
    return `export type ${name} = ${ts};`;
  }

  function generateSchemas(doc: any, ctx: Ctx): string {
    const schemas = doc?.components?.schemas;
    if (!schemas || typeof schemas !== 'object') return '';
    const out: string[] = [];
    for (const [key, schema] of Object.entries(schemas)) {
      out.push(renderSchemaDeclaration(ctx.names.get(key)!, schema, ctx));
    }
    return out.join('\n\n');
  }

  function generatePathTypes(doc: any, namespace: string, ctx: Ctx): string {
    const paths = doc?.paths;
    if (!paths || typeof paths !== 'object') return '';

    const HTTP_METHODS = ['get', 'put', 'post', 'delete', 'options', 'head', 'patch'];
    const operationBlocks: string[] = [];

    for (const [p, pathItem] of Object.entries(paths)) {
      if (!pathItem || typeof pathItem !== 'object') continue;
      for (const method of HTTP_METHODS) {
        const op = (pathItem as any)[method];
        if (!op || typeof op !== 'object') continue;

        const opId = op.operationId
          ? safeIdent(pascalCase(String(op.operationId)))
          : safeIdent(pascalCase(`${method}${p.replace(/[{}\/]/g, '_').replace(/_+/g, '_')}`));

        const lines: string[] = [`  export namespace ${opId} {`];

        // Combine path-level and op-level parameters
        const pathLevelParams = Array.isArray((pathItem as any).parameters) ? (pathItem as any).parameters : [];
        const opParams = Array.isArray(op.parameters) ? op.parameters : [];
        const allParams = [...pathLevelParams, ...opParams].map((param: any) => {
          if (param && param.$ref) {
            const m = /^#\/components\/parameters\/([^/]+)$/.exec(param.$ref);
            const ref = m ? doc?.components?.parameters?.[decodePointerToken(m[1])] : undefined;
            if (ref) return ref;
            ctx.unsupportedRefs.add(String(param.$ref));
          }
          return param;
        });

        const groups: Record<string, any[]> = { path: [], query: [], header: [], cookie: [] };
        for (const param of allParams) {
          if (param && param.in && groups[param.in]) groups[param.in].push(param);
        }

        for (const [groupName, list] of Object.entries(groups)) {
          if (list.length === 0) continue;
          const fields = list.map((param: any) => {
            const opt = param.required ? '' : '?';
            const ts = schemaToTs(param.schema || {}, `${opId}${pascalCase(groupName)}${pascalCase(param.name || 'Param')}`, ctx, 2);
            return `      ${safeKey(param.name)}${opt}: ${ts};`;
          });
          const groupTypeName = `${pascalCase(groupName)}Parameters`;
          lines.push(`    export interface ${groupTypeName} {`);
          lines.push(...fields);
          lines.push(`    }`);
        }

        // Request body
        const rb = op.requestBody;
        if (rb && typeof rb === 'object') {
          if (rb.$ref) ctx.unsupportedRefs.add(String(rb.$ref));
          const json = rb.content?.['application/json']?.schema;
          if (json) {
            const ts = schemaToTs(json, `${opId}RequestBody`, ctx, 2);
            lines.push(`    export type RequestBody = ${ts};`);
          }
        }

        // Responses
        if (op.responses && typeof op.responses === 'object') {
          for (const [code, resp] of Object.entries(op.responses)) {
            if (!resp || typeof resp !== 'object') continue;
            if ((resp as any).$ref) ctx.unsupportedRefs.add(String((resp as any).$ref));
            const json = (resp as any).content?.['application/json']?.schema;
            if (!json) continue;
            const ts = schemaToTs(json, `${opId}Response${code}`, ctx, 2);
            const respName = `Response${String(code).replace(/[^A-Za-z0-9]/g, '')}`;
            lines.push(`    export type ${respName} = ${ts};`);
          }
        }

        lines.push(`  }`);
        operationBlocks.push(lines.join('\n'));
      }
    }

    if (operationBlocks.length === 0) return '';
    return `export namespace ${namespace} {\n${operationBlocks.join('\n\n')}\n}`;
  }

  // ── Zod schema generation ──
  type ZodCtx = Ctx & { current: string; emitted: Set<string>; cyclic: Set<string> };

  // Local schema refs reachable from one schema value (not following refs).
  function collectRefs(schema: any, doc: any, out: Set<string>): void {
    if (!schema || typeof schema !== 'object') return;
    if (Array.isArray(schema)) { for (const s of schema) collectRefs(s, doc, out); return; }
    if (typeof schema.$ref === 'string') {
      const key = refToSchemaKey(schema.$ref, doc);
      if (key !== null) out.add(key);
    }
    for (const [k, v] of Object.entries(schema)) {
      if (k === 'enum' || k === 'const' || k === 'example' || k === 'examples' || k === 'default') continue;
      collectRefs(v, doc, out);
    }
  }

  // Schemas that can reach themselves through refs (direct or indirect recursion).
  function findCyclic(doc: any): Set<string> {
    const schemas = doc?.components?.schemas || {};
    const edges = new Map<string, Set<string>>();
    for (const [k, v] of Object.entries(schemas)) {
      const out = new Set<string>();
      collectRefs(v, doc, out);
      edges.set(k, out);
    }
    const cyclic = new Set<string>();
    for (const start of edges.keys()) {
      const stack = [...(edges.get(start) || [])];
      const seen = new Set<string>();
      while (stack.length) {
        const n = stack.pop()!;
        if (n === start) { cyclic.add(start); break; }
        if (seen.has(n)) continue;
        seen.add(n);
        for (const m of edges.get(n) || []) stack.push(m);
      }
    }
    return cyclic;
  }

  function schemaToZod(schema: any, ctx: ZodCtx, depth = 0): string {
    if (!schema || typeof schema !== 'object') return 'z.unknown()';

    if (schema.$ref) {
      const key = refToSchemaKey(schema.$ref, ctx.doc);
      if (key === null) {
        ctx.unsupportedRefs.add(String(schema.$ref));
        return 'z.unknown()';
      }
      const target = `${ctx.names.get(key)}Schema`;
      // Not yet defined (forward reference) or part of a cycle: defer the lookup.
      if (!ctx.emitted.has(key) || (ctx.cyclic.has(key) && ctx.cyclic.has(ctx.current))) {
        return `z.lazy(() => ${target})`;
      }
      return target;
    }

    if (Object.prototype.hasOwnProperty.call(schema, 'const')) {
      const v = schema.const;
      const lit = v === null ? 'z.null()' : (typeof v === 'object' ? 'z.unknown()' : `z.literal(${JSON.stringify(v)})`);
      return v === null ? lit : wrapNullable(lit, schema);
    }

    if (Array.isArray(schema.enum)) {
      const allStrings = schema.enum.length > 0 && schema.enum.every((v: any) => typeof v === 'string');
      if (allStrings) {
        const lits = schema.enum.map((v: string) => JSON.stringify(v)).join(', ');
        return wrapNullable(`z.enum([${lits}])`, schema);
      }
      const lits = schema.enum.map((v: any) => (v === null ? 'z.null()' : `z.literal(${JSON.stringify(v)})`));
      return wrapNullable(lits.length === 1 ? lits[0] : `z.union([${lits.join(', ')}])`, schema);
    }

    if (Array.isArray(schema.oneOf) || Array.isArray(schema.anyOf)) {
      const arr = schema.oneOf || schema.anyOf;
      const parts = arr.map((s: any) => schemaToZod(s, ctx, depth + 1));
      return wrapNullable(parts.length === 1 ? parts[0] : `z.union([${parts.join(', ')}])`, schema);
    }

    if (Array.isArray(schema.allOf)) {
      const parts = schema.allOf.map((s: any) => schemaToZod(s, ctx, depth + 1));
      if (parts.length === 1) return wrapNullable(parts[0], schema);
      let acc = parts[0];
      for (let i = 1; i < parts.length; i++) acc = `z.intersection(${acc}, ${parts[i]})`;
      return wrapNullable(acc, schema);
    }

    const baseType = getBaseType(schema);
    let z: string;

    switch (baseType) {
      case 'string':
        if (schema.format === 'email') z = 'z.string().email()';
        else if (schema.format === 'uri' || schema.format === 'url') z = 'z.string().url()';
        else if (schema.format === 'uuid') z = 'z.string().uuid()';
        else if (schema.format === 'date-time') z = 'z.string().datetime()';
        else if (schema.format === 'binary') z = 'z.instanceof(Blob)';
        else z = 'z.string()';
        break;
      case 'integer':
        z = 'z.number().int()';
        break;
      case 'number':
        z = 'z.number()';
        break;
      case 'boolean':
        z = 'z.boolean()';
        break;
      case 'null':
        return 'z.null()';
      case 'array': {
        z = `z.array(${schemaToZod(schema.items || {}, ctx, depth + 1)})`;
        break;
      }
      case 'object':
      case undefined: {
        if (schema.properties && typeof schema.properties === 'object') {
          const required = new Set<string>(Array.isArray(schema.required) ? schema.required : []);
          const pad = '  '.repeat(depth + 1);
          const closePad = '  '.repeat(depth);
          const props = Object.entries(schema.properties).map(([k, v]) => {
            const zv = schemaToZod(v, ctx, depth + 1);
            const opt = ctx.optional || !required.has(k) ? '.optional()' : '';
            return `${pad}${safeKey(k)}: ${zv}${opt},`;
          });
          z = `z.object({\n${props.join('\n')}\n${closePad}})`;
        } else if (schema.additionalProperties) {
          const ap = schema.additionalProperties === true ? 'z.unknown()' : schemaToZod(schema.additionalProperties, ctx, depth + 1);
          z = `z.record(z.string(), ${ap})`;
        } else {
          z = 'z.record(z.string(), z.unknown())';
        }
        break;
      }
      default:
        z = 'z.unknown()';
    }

    return wrapNullable(z, schema);
  }

  function wrapNullable(expr: string, schema: any): string {
    return isNullable(schema) ? `${expr}.nullable()` : expr;
  }

  // Recursive schemas get an explicit `z.ZodType<Name>` annotation: TypeScript cannot infer the
  // type of a const that refers to itself in its own initializer (error TS7022).
  function generateZodSchemas(doc: any, base: Ctx): string {
    const schemas = doc?.components?.schemas;
    if (!schemas || typeof schemas !== 'object') return '';
    const ctx: ZodCtx = Object.assign(base, { current: '', emitted: new Set<string>(), cyclic: findCyclic(doc) });
    const lines = ['import { z } from \'zod\';\n'];
    for (const [key, schema] of Object.entries(schemas)) {
      const name = ctx.names.get(key)!;
      ctx.current = key;
      const expr = schemaToZod(schema, ctx);
      const annotation = ctx.cyclic.has(key) ? `: z.ZodType<${name}>` : '';
      lines.push(`export const ${name}Schema${annotation} = ${expr};`);
      ctx.emitted.add(key);
    }
    return lines.join('\n');
  }

  type GenOptions = { optional: boolean; includePaths: boolean; includeZod: boolean; namespace: string };

  function generateAll(doc: any, opts: GenOptions): { sections: string[]; count: number; unsupportedRefs: string[] } {
    const ctx = newCtx(doc, opts.optional);
    const sections: string[] = [];
    const schemasBlock = generateSchemas(doc, ctx);
    if (schemasBlock) sections.push(`// ── components/schemas ──\n${schemasBlock}`);
    if (opts.includePaths) {
      const pathsBlock = generatePathTypes(doc, opts.namespace || 'Paths', ctx);
      if (pathsBlock) sections.push(`// ── paths ──\n${pathsBlock}`);
    }
    if (opts.includeZod) {
      const zodBlock = generateZodSchemas(doc, ctx);
      if (zodBlock) sections.push(`// ── Zod schemas ──\n${zodBlock}`);
    }
    const count = (schemasBlock.match(/^export (interface|type) /gm) || []).length;
    return { sections, count, unsupportedRefs: [...ctx.unsupportedRefs] };
  }
  /* ── engine:end ── */

  // ── Main generate ──
  function generate(): void {
    if (liveTimer !== null) window.clearTimeout(liveTimer);
    resetCopy();
    const raw = inputEl.value.trim();
    if (!raw) {
      outputCodeEl.textContent = '';
      setStatus('', 'none');
      return;
    }

    let doc: any;
    try {
      doc = jsyaml.load(raw, { schema: jsyaml.JSON_SCHEMA });
    } catch (e: any) {
      outputCodeEl.textContent = '';
      setStatus(MSG_PARSE_ERROR + yamlErrorText(e, wrap.dataset.lang || 'en'), 'error');
      return;
    }

    if (!doc || typeof doc !== 'object') {
      outputCodeEl.textContent = '';
      setStatus(MSG_NOT_OPENAPI, 'error');
      return;
    }

    if (doc.swagger) {
      outputCodeEl.textContent = '';
      setStatus(MSG_SWAGGER2, 'error');
      return;
    }

    const ver = String(doc.openapi || '');
    if (!/^3\.\d+\.\d+/.test(ver)) {
      outputCodeEl.textContent = '';
      setStatus(MSG_UNSUPPORTED + (ver || '(missing)'), 'error');
      return;
    }

    const rawNamespace = (rootEl.value || 'Components').trim() || 'Components';
    const result = generateAll(doc, {
      optional: optionalEl.checked,
      includePaths: pathsEl.checked,
      includeZod: zodEl.checked,
      namespace: safeIdent(pascalCase(rawNamespace)),
    });

    if (result.sections.length === 0) {
      outputCodeEl.textContent = '';
      setStatus(MSG_EMPTY, 'info');
      return;
    }

    outputCodeEl.textContent = result.sections.join('\n\n');
    let msg = MSG_GENERATED.replace('{n}', String(result.count));
    if (result.unsupportedRefs.length) {
      msg += ' ' + MSG_UNRESOLVED.replace('{refs}', result.unsupportedRefs.join(', '));
    }
    setStatus(msg, result.unsupportedRefs.length ? 'error' : 'success');
    (window as any).trackTool?.('openapi-to-typescript', 'generate');
  }

  // Debounced live preview
  let liveTimer: number | null = null;
  function scheduleGenerate(): void {
    resetCopy();
    if (liveTimer !== null) window.clearTimeout(liveTimer);
    liveTimer = window.setTimeout(generate, 300);
  }

  inputEl.addEventListener('input', scheduleGenerate);
  rootEl.addEventListener('input', scheduleGenerate);
  optionalEl.addEventListener('change', generate);
  pathsEl.addEventListener('change', generate);
  zodEl.addEventListener('change', generate);

  exampleBtn.addEventListener('click', () => {
    inputEl.value = EXAMPLE;
    generate();
    (window as any).trackTool?.('openapi-to-typescript', 'example_load');
  });

  function clearAll(): void {
    if (liveTimer !== null) window.clearTimeout(liveTimer);
    resetCopy();
    inputEl.value = '';
    outputCodeEl.textContent = '';
    setStatus('', 'none');
    inputEl.focus();
  }
  clearBtn.addEventListener('click', clearAll);
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
      e.preventDefault();
      clearAll();
    }
  });

  copyBtn.addEventListener('click', () => {
    const text = outputCodeEl.textContent || '';
    if (!text) return;
    resetCopy();
    const revision = copyRevision;
    function failed(): void {
      if (revision === copyRevision) copyBtn.textContent = COPY_FAILED;
    }
    try {
      navigator.clipboard.writeText(text).then(() => {
        if (revision !== copyRevision) return;
        copyBtn.classList.add('copied');
        copyBtn.textContent = COPIED;
        copyTimer = window.setTimeout(() => {
          if (revision !== copyRevision) return;
          copyBtn.classList.remove('copied');
          copyBtn.textContent = COPY;
        }, 1500);
      }, failed);
    } catch { failed(); }
  });

</script>

<style>
  .opts-wrap { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; gap: 0.75rem; }
  .opts-config, .opts-checks, .opts-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .opts-root-row, .opts-control-label { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .opts-root-row { width: 20rem; font-size: 0.85rem; color: var(--color-text-secondary); }
  .opts-root-row input { width: 8rem; min-width: 0; flex: 1; padding: 0.4rem 0.5rem; font-size: 0.85rem; font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg); color: var(--color-text); }
  .opts-root-row input:focus { outline: none; border-color: var(--color-primary); }
  .opts-check { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.85rem; color: var(--color-text-secondary); cursor: pointer; }
  .opts-check input { width: 16px; height: 16px; flex: none; cursor: pointer; }
  .opts-panel-header { display: flex; align-items: center; justify-content: space-between; min-height: 44px; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .opts-input, .opts-output { width: 100%; min-width: 0; font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.55; padding: 0.82rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-secondary); color: var(--color-text); }
  .opts-input { resize: none; overflow: auto; }
  .opts-input:focus { outline: none; border-color: var(--color-primary); }
  .opts-output { margin: 0; overflow: auto; white-space: pre; }
  .opts-output:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .opts-output code { background: transparent; color: inherit; font: inherit; padding: 0; border: 0; white-space: pre; }
  .opts-empty { display: none; margin: 0; padding: 2rem; align-items: center; justify-content: center; text-align: center; color: var(--color-text-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .opts-output-pane:has(#opts-output-code:empty) .opts-output { display: none; }
  .opts-output-pane:has(#opts-output-code:empty) .opts-empty { display: flex; }
  #opts-status { font-size: 0.85rem; line-height: 1.4; height: 2.4rem; flex: none; overflow: auto; overflow-wrap: anywhere; }
  @media (max-width: 860px) {
    .opts-wrap { gap: 0.5rem; }
    .opts-root-row { width: 100%; }
    .opts-root-row .opts-control-label { flex: 1; }
    .opts-root-row input { width: 45%; flex: none; }
    .opts-input { height: 144px; min-height: 144px; flex: none; }
    .opts-output { height: 22rem; min-height: 160px; }
    .opts-output-pane:has(#opts-output-code:empty) { display: none; }
    #opts-status { height: 4.8rem; }
  }
  @media (max-width: 640px) {
    .opts-checks { gap: 0.25rem 0.75rem; }
    .opts-check, .opts-actions button, .opts-panel-header button, .opts-root-row input { min-height: 44px; }
  }
</style>
