const L = STRINGS[lang];
const TIPS = L.tips;

// "Zero-width steganography" sample: the secret written the way 330k Unicode
// Steganography does with its default characters (U+200C U+200D U+202C U+FEFF = 0–3,
// 8 digits per UTF-16 unit). 330k places the 8-character chunks at random gaps; this
// puts one chunk after each visible character so the build output is stable.
function stego330k(cover: string, secret: string): string {
  const chars = ['\u200C', '\u200D', '\u202C', '\uFEFF'];
  const chunks: string[] = [];
  for (let i = 0; i < secret.length; i++) {
    chunks.push(secret.charCodeAt(i).toString(4).padStart(8, '0').replace(/[0-3]/g, (d) => chars[Number(d)]));
  }
  const visible = Array.from(cover);
  let out = '';
  for (let i = 0; i < visible.length; i++) out += visible[i] + (i < chunks.length ? chunks[i] : '');
  return out + chunks.slice(visible.length).join('');
}
const STEGO_SAMPLE = stego330k(L.stego.cover, L.stego.secret);
