          return;
        }
        decStatus.textContent = enc.integrity ? DEC_S.decrypted : DEC_S.decryptedNoHmac;
        decStatus.className = 'tool-status success zwcd-decrypt-status';
        decState.readings = [{ scheme: 'stegcloak', text: out.text, confident: true, decrypted: true, integrity: enc.integrity }].concat(decState.readings);
        renderDecoded();
        setSummary(view.text, view.hits);
      });
    }
    decBtn.addEventListener('click', decryptNow);
    decPw.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); decryptNow(); }
    });

    downloadBtn.addEventListener('click', function () {
      var text = cleanedText;
      if (!text) return;
      var blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'cleaned.txt';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(url); }, 100);
    });

    update();
  })();
</script>

