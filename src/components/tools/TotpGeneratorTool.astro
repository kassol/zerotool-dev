const L = STRINGS[lang];
const { tips: TIPS, ...CLIENT_L } = L;
---
<div class="totp-wrap">
  <div class="totp-body">
    <div class="totp-rail zt-rail">
      <div class="totp-field">
        <div class="totp-label-row"><label for="totp-secret">{L.secretLabel}</label><Toggletip id="totp-tip-secret" lang={lang} about={L.secretLabel} wide>{TIPS.secret}</Toggletip></div>
        <input type="text" id="totp-secret" class="tool-input" placeholder="JBSWY3DPEHPK3PXP" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off" />
      </div>
      <div class="totp-actions"><button id="totp-gen-secret" class="btn-secondary" type="button">{L.random}</button><Toggletip id="totp-tip-random" lang={lang} about={L.random}>{TIPS.random}</Toggletip></div>
      <div id="totp-status" class="tool-status" aria-live="polite"></div>
      <details class="totp-details">
        <summary>{L.settings}</summary>
        <div class="totp-label-row totp-settings-label"><span class="tool-label">{L.settings}</span><Toggletip id="totp-tip-settings" lang={lang} about={L.settings}>{TIPS.settings}</Toggletip></div>
        <div class="totp-options">
          <div class="totp-opt">
            <label for="totp-algo">{L.algorithm}</label>
            <select id="totp-algo" class="tool-input"><option value="SHA-1">SHA-1</option><option value="SHA-256">SHA-256</option><option value="SHA-512">SHA-512</option></select>
          </div>
          <div class="totp-opt">
            <label for="totp-digits">{L.digits}</label>
            <select id="totp-digits" class="tool-input"><option value="6">6</option><option value="8">8</option></select>
          </div>
          <div class="totp-opt">
            <label for="totp-period">{L.period}</label>
            <input type="text" id="totp-period" class="tool-input" value="30" inputmode="numeric" autocomplete="off" />
          </div>
          <div class="totp-opt totp-wide">
            <div class="totp-label-row"><label for="totp-time">{L.time} <span class="totp-optional">({L.optional})</span></label><Toggletip id="totp-tip-time" lang={lang} about={L.time}>{TIPS.time}</Toggletip></div>
            <input type="text" id="totp-time" class="tool-input" placeholder={L.timePlaceholder} inputmode="numeric" autocomplete="off" />
          </div>
        </div>
      </details>
      <details class="totp-details">
        <summary>{L.identity}</summary>
        <div class="totp-label-row totp-settings-label"><span class="tool-label">{L.identity}</span><Toggletip id="totp-tip-identity" lang={lang} about={L.identity}>{TIPS.identity}</Toggletip></div>
        <div class="totp-opt"><label for="totp-issuer">{L.issuer} <span class="totp-optional">({L.optional})</span></label><input type="text" id="totp-issuer" class="tool-input" placeholder="Example" autocomplete="off" /></div>
        <div class="totp-opt"><label for="totp-account">{L.account} <span class="totp-optional">({L.optional})</span></label><input type="text" id="totp-account" class="tool-input" placeholder="alice@example.com" autocomplete="off" /></div>
      </details>
    </div>
    <div class="totp-result">
      <p class="totp-empty">{L.empty}</p>
      <div id="totp-display" class="totp-display" hidden>
        <div class="totp-label-row"><span class="tool-label">{L.codeLabel}</span><Toggletip id="totp-tip-code" lang={lang} about={L.codeLabel} wide>{TIPS.code}</Toggletip></div>
        <div class="totp-code-wrap">
          <span id="totp-code" class="totp-code" aria-label={L.codeLabel}>------</span>
          <button id="totp-copy-code" class="btn-copy" type="button">{L.copy}</button>
        </div>
        <div class="totp-timer-wrap">
          <div class="totp-bar-bg" aria-hidden="true"><div id="totp-bar" class="totp-bar"></div></div>
          <span id="totp-countdown" class="totp-countdown"></span>
        </div>
        <div class="totp-meta">
          <span>{L.previous} <code id="totp-prev">—</code></span>
          <span>{L.next} <code id="totp-next">—</code></span>
          <span id="totp-step"></span>
        </div>
        <p id="totp-clock" class="totp-clock" role="status" hidden></p>
      </div>
      <div id="totp-uri-block" class="totp-uri-block" hidden>
        <div class="totp-uri-label">
          <div class="totp-label-row"><label for="totp-uri">{L.uriLabel}</label><Toggletip id="totp-tip-uri" lang={lang} about={L.uriLabel}>{TIPS.uri}</Toggletip></div>
          <button id="totp-copy-uri" class="btn-copy" type="button">{L.copy}</button>
        </div>
        <input type="text" id="totp-uri" class="tool-input totp-uri-input" readonly />
        <p class="totp-note">{L.qrWarning}</p>
      </div>
      <div id="totp-qr-block" class="totp-qr-block" hidden>
        <div class="totp-qr-label">{L.qrLabel}</div>
        <div id="totp-qr-canvas-wrap"></div>
        <p id="totp-ga-note" class="totp-note" hidden>{L.gaNote}</p>
      </div>
    </div>
  </div>
  {/* qrcode.js (same vendor file as the QR code generator tool) */}
  <script src="/vendor/qrcode.min.js" is:inline></script>

  <script is:inline define:vars={{ S: CLIENT_L }}>
    (function () {
      /* ── engine:start ── */
      var B32 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
      var KEY_BYTES = { 'SHA-1': 20, 'SHA-256': 32, 'SHA-512': 64 };
      var URI_ALGOS = { SHA1: 'SHA-1', SHA256: 'SHA-256', SHA512: 'SHA-512' };

      function base32Decode(s) {
        var bits = 0, val = 0, out = [];
        for (var i = 0; i < s.length; i++) {
          val = ((val << 5) | B32.indexOf(s[i])) & 0xffff;
          bits += 5;
          if (bits >= 8) { bits -= 8; out.push((val >>> bits) & 0xff); }
        }
        return new Uint8Array(out);
      }

      function base32Encode(bytes) {
        var bits = 0, val = 0, out = '';
        for (var i = 0; i < bytes.length; i++) {
          val = ((val << 8) | bytes[i]) & 0xffff;
          bits += 8;
          while (bits >= 5) { bits -= 5; out += B32[(val >>> bits) & 31]; }
        }
        if (bits > 0) out += B32[(val << (5 - bits)) & 31];
        return out;
      }

      // RFC 4648 Base32 as users paste it: any case, grouped with spaces or hyphens,
      // full-width characters (NFKC), optional trailing '=' padding.
      function normalizeSecret(raw) {
        var s = String(raw == null ? '' : raw).normalize('NFKC').replace(/[\s-]/g, '').toUpperCase();
        var pad = s.indexOf('=');
        if (pad >= 0) {
          if (/[^=]/.test(s.slice(pad))) return { ok: false, error: 'padding' };
          s = s.slice(0, pad);
        }
        if (!s) return { ok: false, error: 'empty' };
        var chars = Array.from(s);
        for (var i = 0; i < chars.length; i++) {
          if (B32.indexOf(chars[i]) < 0) return { ok: false, error: 'char', char: chars[i] };
        }
        var rem = s.length % 8;
        if (rem === 1 || rem === 3 || rem === 6) return { ok: false, error: 'length', length: s.length };
        return { ok: true, secret: s, bytes: base32Decode(s) };
      }

      function counterBytes(counter) {
        var out = new Uint8Array(8);
        var hi = Math.floor(counter / 4294967296);
        var lo = counter - hi * 4294967296;
        for (var i = 3; i >= 0; i--) { out[i] = hi & 0xff; hi = Math.floor(hi / 256); }
        for (var j = 7; j >= 4; j--) { out[j] = lo & 0xff; lo = Math.floor(lo / 256); }
        return out;
      }

      // RFC 4226 §5.3: HMAC, dynamic truncation, modulo 10^digits.
      async function hotp(keyBytes, counter, algo, digits) {
        var key = await crypto.subtle.importKey('raw', keyBytes, { name: 'HMAC', hash: algo }, false, ['sign']);
        var h = new Uint8Array(await crypto.subtle.sign('HMAC', key, counterBytes(counter)));
        var o = h[h.length - 1] & 0x0f;
        var bin = ((h[o] & 0x7f) << 24) | (h[o + 1] << 16) | (h[o + 2] << 8) | h[o + 3];
        return String(bin % Math.pow(10, digits)).padStart(digits, '0');
      }

      // RFC 6238 §4.2 with T0 = 0: T = floor(unix seconds / period).
      function totpAt(keyBytes, unixSeconds, algo, digits, period) {
        return hotp(keyBytes, Math.floor(unixSeconds / period), algo, digits);
      }

      function timeState(nowMs, period) {
        var stepMs = period * 1000;
        var counter = Math.floor(nowMs / stepMs);
        var remainingMs = stepMs - (nowMs - counter * stepMs);
        return { counter: counter, remaining: Math.ceil(remainingMs / 1000) };
      }

      function codeIsStale(shownCounter, nowMs, period) {
        return timeState(nowMs, period).counter !== shownCounter;
      }

      // RFC 6238 §5.1: keys SHOULD be the length of the HMAC output.
      function randomSecret(algo, rng) {
        var buf = new Uint8Array(KEY_BYTES[algo] || 20);
        if (rng) rng(buf); else crypto.getRandomValues(buf);
        return base32Encode(buf);
      }

      // Google Authenticator Key Uri Format. Defaults (SHA1, 6, 30) are omitted.
      function buildUri(o) {
        if (o.issuer.indexOf(':') >= 0) return { ok: false, field: 'issuer' };
        if (o.account.indexOf(':') >= 0) return { ok: false, field: 'account' };
        var label = (o.issuer ? encodeURIComponent(o.issuer) + ':' : '') + encodeURIComponent(o.account || 'Account');
        var q = 'secret=' + o.secret;
        if (o.issuer) q += '&issuer=' + encodeURIComponent(o.issuer);
        if (o.algo !== 'SHA-1') q += '&algorithm=' + o.algo.replace('-', '');
        if (o.digits !== 6) q += '&digits=' + o.digits;
        if (o.period !== 30) q += '&period=' + o.period;
        return { ok: true, uri: 'otpauth://totp/' + label + '?' + q };
      }

      function parseUri(str) {
        var m = /^otpauth:\/\/([^/?#]*)\/([^?#]*)(?:\?([^#]*))?/i.exec(String(str).trim());
        if (!m) return { ok: false, error: 'scheme' };
        var type = m[1].toLowerCase();
        if (type === 'hotp') return { ok: false, error: 'hotp' };
        if (type !== 'totp') return { ok: false, error: 'type', value: m[1] };
        var label;
        try { label = decodeURIComponent(m[2]); } catch (e) { return { ok: false, error: 'label' }; }
        var params = new URLSearchParams(m[3] || '');
        var n = normalizeSecret(params.get('secret') || '');
        if (!n.ok) return { ok: false, error: 'secret' };
        var algoRaw = params.get('algorithm');
        var algo = URI_ALGOS[(algoRaw == null ? 'SHA1' : algoRaw).toUpperCase().replace('-', '')];
        if (!algo) return { ok: false, error: 'algorithm', value: algoRaw };
        var d = params.get('digits');
        if (d != null && d !== '6' && d !== '8') return { ok: false, error: 'digits', value: d };
        var p = params.get('period');
        if (p != null && (!/^\d+$/.test(p) || +p < 1 || +p > 86400)) return { ok: false, error: 'period', value: p };
        var sep = label.indexOf(':');
        var prefix = sep >= 0 ? label.slice(0, sep) : '';
        var account = sep >= 0 ? label.slice(sep + 1).replace(/^ +/, '') : label;
        var issuer = params.get('issuer') ? params.get('issuer') : prefix;
        return { ok: true, secret: n.secret, issuer: issuer, account: account, algo: algo, digits: d == null ? 6 : +d, period: p == null ? 30 : +p };
      }

      // HTTP Date has one-second resolution: server time at the response lies in
      // [D, D + 1000). The local midpoint of the request stands for that moment.
      function clockOffset(sentMs, receivedMs, dateHeader) {
        if (!dateHeader) return null;
        var d = Date.parse(dateHeader);
        if (isNaN(d)) return null;
        return { offsetMs: d + 500 - (sentMs + receivedMs) / 2, uncertaintyMs: 500 + (receivedMs - sentMs) / 2 };
      }

      function clockVerdict(o) {
        if (!o) return null;
        var abs = Math.abs(o.offsetMs);
        if (abs - o.uncertaintyMs < 3000) return null;
        return { direction: o.offsetMs > 0 ? 'behind' : 'ahead', seconds: Math.round(abs / 1000) };
      }
      /* ── engine:end ── */

      var $ = function (id) { return document.getElementById(id); };
      var secretEl = $('totp-secret');
      var algoEl = $('totp-algo');
      var digitsEl = $('totp-digits');
      var periodEl = $('totp-period');
      var timeEl = $('totp-time');
      var issuerEl = $('totp-issuer');
      var accountEl = $('totp-account');
      var statusEl = $('totp-status');
      var displayEl = $('totp-display');
      var codeEl = $('totp-code');
      var prevEl = $('totp-prev');
      var nextEl = $('totp-next');
      var stepEl = $('totp-step');
      var countdownEl = $('totp-countdown');
      var barEl = $('totp-bar');
      var clockEl = $('totp-clock');
      var uriBlock = $('totp-uri-block');
      var uriInput = $('totp-uri');
      var qrBlock = $('totp-qr-block');
      var qrWrap = $('totp-qr-canvas-wrap');
      var gaNote = $('totp-ga-note');

      var state = null;
      var gen = 0;
      var clockChecked = false;
      var lastTracked = '';

      function fmt(s, vars) {
        return s.replace(/\{(\w+)\}/g, function (_, k) { return vars[k]; });
      }

      function setStatus(msg, kind) {
        statusEl.textContent = msg || '';
        statusEl.className = 'tool-status' + (kind ? ' ' + kind : '');
      }

      function hideOutput() {
        gen++;
        state = null;
        displayEl.hidden = true;
        uriBlock.hidden = true;
        qrBlock.hidden = true;
        qrWrap.innerHTML = '';
        uriInput.value = '';
        codeEl.textContent = '------';
      }

      function secretMessage(n) {
        if (n.error === 'char') return fmt(S.errChar, { ch: n.char });
        if (n.error === 'padding') return S.errPadding;
        if (n.error === 'length') return fmt(S.errLength, { n: n.length });
        return S.errEmpty;
      }

      function uriMessage(p) {
        var key = { scheme: 'errUriScheme', hotp: 'errUriHotp', type: 'errUriType', label: 'errUriLabel', secret: 'errUriSecret', algorithm: 'errUriAlgorithm', digits: 'errUriDigits', period: 'errUriPeriod' }[p.error];
        return fmt(S[key], { v: p.value == null ? '' : p.value });
      }

      function renderTimer() {
        if (!state) return;
        if (state.fixedT != null) {
          countdownEl.textContent = S.fixedTime;
          barEl.style.width = '100%';
          barEl.className = 'totp-bar fixed';
          return;
        }
        var ts = timeState(Date.now(), state.period);
        countdownEl.textContent = fmt(S.seconds, { n: ts.remaining });
        barEl.style.width = (ts.remaining / state.period * 100) + '%';
        barEl.className = 'totp-bar' + (ts.remaining <= 5 ? ' urgent' : '');
      }

      function renderQr(uri) {
        qrWrap.innerHTML = '';
        if (typeof QRCode === 'undefined') return;
        var canvas = document.createElement('canvas');
        qrWrap.appendChild(canvas);
        QRCode.toCanvas(canvas, uri, { width: 192, margin: 2 }, function (err) {
          if (!err && state) qrBlock.hidden = false;
        });
      }

      function checkClock() {
        clockChecked = true;
        if (!window.fetch) return;
        var sent = Date.now();
        // Same-origin HEAD of this page, no query or body: only the Date header is read.
        fetch(location.pathname, { method: 'HEAD', cache: 'no-store' }).then(function (r) {
          var v = clockVerdict(clockOffset(sent, Date.now(), r.headers.get('Date')));
          if (!v) return;
          clockEl.textContent = fmt(v.direction === 'behind' ? S.clockBehind : S.clockAhead, { s: v.seconds });
          clockEl.hidden = false;
        }).catch(function () {});
      }

      async function update() {
        var raw = secretEl.value;
        var notes = [];
        if (/^\s*otpauth:/i.test(raw)) {
          var p = parseUri(raw);
          if (!p.ok) { hideOutput(); setStatus(uriMessage(p), 'error'); return; }
          secretEl.value = p.secret;
          issuerEl.value = p.issuer;
          accountEl.value = p.account;
          algoEl.value = p.algo;
          digitsEl.value = String(p.digits);
          periodEl.value = String(p.period);
          raw = p.secret;
          notes.push(S.imported);
        }
        if (!raw.trim()) { hideOutput(); setStatus('', null); return; }
        var n = normalizeSecret(raw);
        if (!n.ok) { hideOutput(); setStatus(secretMessage(n), 'error'); return; }
        var period = periodEl.value.trim();
        if (!/^\d+$/.test(period) || +period < 1 || +period > 86400) { hideOutput(); setStatus(S.errPeriod, 'error'); return; }
        period = +period;
        var t = timeEl.value.trim();
        if (t && !/^\d+$/.test(t)) { hideOutput(); setStatus(S.errTime, 'error'); return; }
        var fixedT = t ? +t : null;
        var algo = algoEl.value;
        var digits = +digitsEl.value;

        var my = ++gen;
        var ts = timeState(fixedT != null ? fixedT * 1000 : Date.now(), period);
        var codes;
        try {
          codes = await Promise.all([
            hotp(n.bytes, ts.counter, algo, digits),
            ts.counter > 0 ? hotp(n.bytes, ts.counter - 1, algo, digits) : Promise.resolve('—'),
            hotp(n.bytes, ts.counter + 1, algo, digits),
          ]);
        } catch (e) {
          if (my !== gen) return;
          hideOutput();
          setStatus(e.message, 'error');
          return;
        }
        if (my !== gen) return;

        state = { secret: n.secret, algo: algo, digits: digits, period: period, fixedT: fixedT, counter: ts.counter };
        codeEl.textContent = codes[0];
        prevEl.textContent = codes[1];
        nextEl.textContent = codes[2];
        stepEl.textContent = fmt(S.step, { t: ts.counter });
        displayEl.hidden = false;
        renderTimer();

        if (n.bytes.length * 8 < 128) notes.push(fmt(S.weakKey, { bits: n.bytes.length * 8 }));
        var u = buildUri({ secret: n.secret, issuer: issuerEl.value.trim(), account: accountEl.value.trim(), algo: algo, digits: digits, period: period });
        if (!u.ok) {
          uriBlock.hidden = true;
          qrBlock.hidden = true;
          qrWrap.innerHTML = '';
          uriInput.value = '';
          setStatus(fmt(S.errColon, { field: u.field === 'issuer' ? S.issuer : S.account }), 'error');
        } else {
          setStatus(notes.join(' '), null);
          if (u.uri !== uriInput.value || qrBlock.hidden) {
            uriInput.value = u.uri;
            renderQr(u.uri);
          }
          uriBlock.hidden = false;
          gaNote.hidden = algo === 'SHA-1' && digits === 6 && period === 30;
        }

        if (!clockChecked && fixedT == null) checkClock();
        if (n.secret !== lastTracked) {
          lastTracked = n.secret;
          window.trackTool && window.trackTool('totp-generator', 'generate');
        }
      }

      function tick() {
        if (!state) return;
        // Cleared without an input event (e.g. the page-wide Ctrl/Cmd+L shortcut).
        if (!secretEl.value.trim()) { hideOutput(); setStatus('', null); return; }
        if (state.fixedT != null) return;
        renderTimer();
        if (!state.refreshing && codeIsStale(state.counter, Date.now(), state.period)) {
          state.refreshing = true;
          update();
        }
      }
      setInterval(tick, 250);
      document.addEventListener('visibilitychange', function () { if (!document.hidden) tick(); });
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && document.querySelector('.totp-wrap').contains(document.activeElement)) {
          hideOutput();
          setStatus('', null);
        }
      });

      $('totp-gen-secret').addEventListener('click', function () {
        secretEl.value = randomSecret(algoEl.value);
        update();
      });

      function copyFrom(btn, text) {
        if (!text || !navigator.clipboard) return;
        navigator.clipboard.writeText(text).then(function () {
          btn.textContent = S.copied;
          setTimeout(function () { btn.textContent = S.copy; }, 1500);
        });
      }
      $('totp-copy-code').addEventListener('click', function () { if (state) copyFrom(this, codeEl.textContent); });
      $('totp-copy-uri').addEventListener('click', function () { copyFrom(this, uriInput.value); });

      [secretEl, periodEl, timeEl, issuerEl, accountEl].forEach(function (el) { el.addEventListener('input', update); });
      [algoEl, digitsEl].forEach(function (el) { el.addEventListener('change', update); });
    })();
  </script>
</div>

<style>
  .totp-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .totp-body { display: grid; grid-template-columns: clamp(270px, 26vw, 320px) minmax(0, 1fr); gap: 1.25rem; flex: 1 1 0; min-width: 0; min-height: 0; }
  .totp-rail { overflow: auto; padding: 0.1rem 0.25rem 0.1rem 0; }
  .totp-label-row, .totp-actions { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .totp-label-row label { min-width: 0; }
  .totp-actions button { min-height: 44px; }
  #totp-status { margin: 0; height: 7.5rem; flex: none; overflow: auto; font-size: 0.82rem; line-height: 1.5; overflow-wrap: anywhere; }
  .totp-details { border-top: 1px solid var(--color-border); }
  .totp-details summary { padding: 0.6rem 0; min-height: 44px; cursor: pointer; font-size: 0.85rem; font-weight: 600; }
  .totp-details > .totp-opt + .totp-opt { margin-top: 0.6rem; }
  .totp-settings-label { margin: 0.25rem 0 0.6rem; }
  .totp-result { display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; min-height: 0; overflow: auto; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-secondary); }
  .totp-result > * { flex: none; min-width: 0; width: 100%; max-width: 48rem; margin-inline: auto; }
  .totp-empty { margin-block: auto; text-align: center; color: var(--color-text-muted); font-size: 0.9rem; }
  .totp-result:has(.totp-display:not([hidden])) .totp-empty { display: none; }

  .totp-field,
  .totp-opt { display: flex; flex-direction: column; gap: 0.3rem; }
  .totp-field label,
  .totp-opt label,
  .totp-uri-label label,
  .totp-qr-label { font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); }
  .totp-optional { font-weight: 400; }

  .totp-field .tool-input { width: 100%; min-width: 0; min-height: 44px; }

  .totp-display {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .totp-display[hidden],
  .totp-uri-block[hidden],
  .totp-qr-block[hidden] { display: none; }

  .totp-code-wrap { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .totp-code {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .totp-timer-wrap { display: flex; align-items: center; gap: 0.75rem; }
  .totp-bar-bg {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--color-border);
    overflow: hidden;
  }
  .totp-bar {
    height: 100%;
    background: var(--color-primary);
    border-radius: 3px;
    transition: width 0.25s linear, background 0.3s;
  }
  .totp-bar.urgent { background: #dc2626; }
  .totp-bar.fixed { background: var(--color-text-secondary); }
  .totp-countdown {
    font-size: 0.82rem;
    font-family: var(--font-mono);
