      if (name === 'NotAllowedError') return 'errNotAllowed';
      if (name === 'InvalidStateError') return 'errBusy';
      return 'errOperation';
    }
    /* ── engine:end ── */

    var SLUG = 'eyedropper-color-picker';
    function $(id) { return document.getElementById(id); }
    function fill(tpl, v) {
      return String(tpl).replace(/\{(\w+)\}/g, function (m, k) { return v && v[k] !== undefined ? v[k] : m; });
    }
    function track(action) { if (window.trackTool) window.trackTool('eyedropper_color_picker', action); }

    var wrap = $('ecp-wrap');
    var pickBtn = $('ecp-pick'), openBtn = $('ecp-open'), dialogBtn = $('ecp-dialog'), clearBtn = $('ecp-clear');
    var fileInput = $('ecp-file'), nativeInput = $('ecp-native');
    var supportEl = $('ecp-support'), statusEl = $('ecp-status'), noteEl = $('ecp-note');
    var swatch = $('ecp-swatch'), swatchFill = $('ecp-swatch-fill');
    var drop = $('ecp-drop'), viewer = $('ecp-viewer'), imgInfo = $('ecp-imginfo'), imgNote = $('ecp-imgnote');
    var sampleSel = $('ecp-sample'), closeBtn = $('ecp-close');
    var hintEl = $('ecp-hint');
    var scroller = $('ecp-scroller'), canvas = $('ecp-canvas'), marker = $('ecp-marker'), loupe = $('ecp-loupe');
    var recentGrid = $('ecp-recent-grid'), recentEmpty = $('ecp-recent-empty');
    var recentClear = $('ecp-recent-clear'), copyAllBtn = $('ecp-copy-all');
    var fieldEls = {};
    wrap.querySelectorAll('input[data-field]').forEach(function (el) { fieldEls[el.getAttribute('data-field')] = el; });

    var current = null;      // formatColor() result shown in the fields
    var img = null;          // { w, h, ctx, p3ctx }
    var cursor = null;       // [x, y] image pixel under the pointer / keyboard cursor
    var zoom = 'fit';
    var touching = false;
    var dropperOpen = false;
    var hasEyeDropper = typeof window.EyeDropper === 'function';

    function setStatus(msg, kind) {
      statusEl.textContent = msg || '';
      statusEl.className = 'ecp-status' + (msg && kind ? ' is-' + kind : '');
    }

    // ── persistence (policy "preference": recent colors + sample size) ──
    function loadPrefs() {
      try { return (window.ztPersist && window.ztPersist.load(SLUG)) || {}; } catch (e) { return {}; }
    }
    function savePrefs(patch) {
      if (!window.ztPersist) return;
      var p = loadPrefs();
      for (var k in patch) p[k] = patch[k];
      try { window.ztPersist.save(SLUG, { recent: cleanRecent(p.recent), sample: p.sample }); } catch (e) {}
    }
    function getRecent() { return cleanRecent(loadPrefs().recent); }

    function renderRecent() {
      var list = getRecent();
      recentGrid.textContent = '';
      list.forEach(function (hex) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'ecp-chip';
        b.setAttribute('role', 'listitem');
        b.setAttribute('aria-label', fill(t.recentApply, { hex: hex }));
        b.title = hex;
        var s = document.createElement('span');
        s.className = 'ecp-chip-fill';
        s.style.background = hex;
        b.appendChild(s);
        b.addEventListener('click', function () {
          var c = parseColor(hex);
          if (!c.error) { show(c, { record: true }); track('recent_apply'); }
        });
        recentGrid.appendChild(b);
      });
      recentEmpty.hidden = list.length > 0;
      recentClear.hidden = list.length === 0;
      copyAllBtn.hidden = list.length === 0;
    }

    // ── show a color in every field ──
    function show(color, opts) {
      opts = opts || {};
      var f = formatColor(color);
      current = f;
      FIELDS_EACH(function (k) { if (k !== opts.skip) fieldEls[k].value = f[k]; });
      swatchFill.style.background = f.hex;
      if (!f.inGamut && window.CSS && CSS.supports && CSS.supports('color', f.p3)) swatchFill.style.background = f.p3;
      swatch.setAttribute('aria-label', fill(t.swatchAria, { hex: f.hex }));
      nativeInput.value = f.hex.slice(0, 7);
      var notes = [];
      if (!f.inGamut) notes.push(color.p3 && opts.fromImage ? t.outOfGamut : t.outOfGamutTyped);
      if (f.alpha8 < 255 && opts.fromImage) notes.push(fill(t.alphaNote, { a: trim(f.alpha8 / 255, 3) }));
      noteEl.textContent = notes.join(' ');
      noteEl.hidden = notes.length === 0;
      if (opts.status !== undefined) setStatus(opts.status, 'ok');
      if (opts.record) {
        savePrefs({ recent: pushRecent(getRecent(), f.hex) });
        renderRecent();
      }
    }
    function FIELDS_EACH(fn) { ['hex', 'rgb', 'hsl', 'oklch', 'p3'].forEach(fn); }

    function clearAll() {
      FIELDS_EACH(function (k) { fieldEls[k].value = ''; });
      current = null;
      swatchFill.style.background = '';
      noteEl.hidden = true;
      setStatus('');
      closeImage();
    }

    // ── typed values: any field accepts any CSS color syntax ──
    FIELDS_EACH(function (k) {
      var el = fieldEls[k];
      el.addEventListener('input', function () {
        var c = parseColor(el.value);
        if (!c.error) show(c, { skip: k, status: '' });
      });
      el.addEventListener('change', function () {
        if (!el.value.trim()) return;
        var c = parseColor(el.value);
        if (c.error) setStatus(t.invalid, 'error');
      });
    });

    // ── screen (EyeDropper API) ──
    if (!hasEyeDropper) {
      pickBtn.hidden = true;
      openBtn.className = 'btn-primary';
      supportEl.textContent = t.screenNone;
    }
    pickBtn.addEventListener('click', function () {
      if (!hasEyeDropper || dropperOpen) return;
      var dropper;
      try { dropper = new window.EyeDropper(); } catch (e) { setStatus(fill(t.errOperation, { msg: e.message || e.name }), 'error'); return; }
      dropperOpen = true;
      pickBtn.disabled = true;
      setStatus(t.screenOpen, 'info');
      Promise.resolve().then(function () { return dropper.open(); }).then(function (res) {
        var c = parseColor(res && res.sRGBHex);
        if (c.error) { setStatus(t.invalid, 'error'); return; }
        show(c, { record: true, status: t.fromScreen });
        track('screen_pick');
      }, function (err) {
        var key = eyeDropperErrorKey(err);
        setStatus(fill(t[key], { msg: (err && (err.message || err.name)) || '' }), key === 'canceled' ? 'info' : 'error');
      }).then(function () {
        dropperOpen = false;
        pickBtn.disabled = false;
      });
    });

    // ── system color dialog ──
    dialogBtn.addEventListener('click', function () {
      try {
        if (typeof nativeInput.showPicker === 'function') { nativeInput.showPicker(); return; }
      } catch (e) {}
      nativeInput.click();
    });
    nativeInput.addEventListener('input', function () {
      var c = parseColor(nativeInput.value);
      if (!c.error) show(c, { status: '' });
    });
    nativeInput.addEventListener('change', function () {
      var c = parseColor(nativeInput.value);
      if (!c.error) { show(c, { record: true, status: '' }); track('native_pick'); }
    });

    clearBtn.addEventListener('click', clearAll);

    // ── images ──
    function isImageFile(file) {
      return /^image\//.test(file.type) || /\.(png|jpe?g|gif|webp|avif|bmp|ico|svg|heic|heif|tiff?)$/i.test(file.name || '');
    }
    function openFile(file) {
      if (!file) return;
      var name = file.name || 'image';
      if (!isImageFile(file)) { setStatus(fill(t.notImage, { name: name }), 'error'); return; }
      setStatus(fill(t.loading, { name: name }), 'info');
      var url = URL.createObjectURL(file);
      var el = new Image();
      el.decoding = 'async';
      el.onload = function () {
        var w = el.naturalWidth, h = el.naturalHeight;
        if (!w || !h) { URL.revokeObjectURL(url); setStatus(fill(t.imgError, { name: name }), 'error'); return; }
        var fit = fitImageSize(w, h, MAX_CANVAS_AREA);
        canvas.width = fit.w; canvas.height = fit.h;
        var ctx = canvas.getContext('2d', { willReadFrequently: true });
        ctx.clearRect(0, 0, fit.w, fit.h);
        ctx.drawImage(el, 0, 0, fit.w, fit.h);
        var p3ctx = null;
        try {
          var c2 = document.createElement('canvas');
          c2.width = fit.w; c2.height = fit.h;
          var x2 = c2.getContext('2d', { colorSpace: 'display-p3', willReadFrequently: true });
          if (x2 && x2.getContextAttributes && x2.getContextAttributes().colorSpace === 'display-p3') {
            x2.drawImage(el, 0, 0, fit.w, fit.h);
            p3ctx = x2;
          }
        } catch (e) { p3ctx = null; }
        URL.revokeObjectURL(url);
        img = { w: fit.w, h: fit.h, ctx: ctx, p3ctx: p3ctx };
        cursor = null;
        marker.hidden = true;
        hintEl.textContent = t.imageHint;
        imgInfo.textContent = fill(t.imgInfo, { name: name, w: w, h: h });
        imgNote.hidden = !fit.scaled;
        imgNote.textContent = fit.scaled ? fill(t.imgScaled, { w: fit.w, h: fit.h, n: (w * h / (fit.w * fit.h)).toFixed(1) }) : '';
        drop.hidden = true;
        viewer.hidden = false;
        setZoom(zoom);
        setStatus('');
        // Keep the color fields and the whole image on screen together on small screens.
        var cr = canvas.getBoundingClientRect();
        if (cr.bottom > window.innerHeight) {
          var top = document.querySelector('.ecp-summary').getBoundingClientRect().top;
