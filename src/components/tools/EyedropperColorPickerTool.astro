const L = STRINGS[lang];
const FIELDS = ['hex', 'rgb', 'hsl', 'oklch', 'p3'];
---
<div class="ecp-wrap" id="ecp-wrap">
  <div class="ecp-left">
  <div class="ecp-actions-block">
    <div class="ecp-actions">
      <button id="ecp-pick" class="btn-primary" type="button">{L.pickScreen}</button>
      <button id="ecp-open" class="btn-secondary" type="button">{L.openImage}</button>
      <button id="ecp-dialog" class="btn-secondary" type="button">{L.dialog}</button>
      <button id="ecp-clear" class="btn-ghost" type="button">{L.clear}</button>
      <input id="ecp-file" type="file" accept="image/*,.svg,.avif,.heic,.heif" hidden />
      <input id="ecp-native" class="ecp-native" type="color" value="#1a73e8" tabindex="-1" aria-hidden="true" />
    </div>
    <p id="ecp-support" class="ecp-support">{L.screenReady}</p>
  </div>

  <section class="ecp-image" id="ecp-image">
    <div id="ecp-drop" class="ecp-drop" role="button" tabindex="0" aria-describedby="ecp-drop-sub">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/></svg>
      <strong>{L.dropTitle}</strong>
      <span id="ecp-drop-sub">{L.dropSub}</span>
    </div>
    <div id="ecp-viewer" class="ecp-viewer" hidden>
      <div class="ecp-viewer-bar">
        <span id="ecp-imginfo" class="ecp-imginfo"></span>
        <label class="ecp-sample">
          <span>{L.sample}</span>
          <select id="ecp-sample" class="tool-input ecp-select">
            <option value="1">{L.s1}</option>
            <option value="3">{L.s3}</option>
            <option value="5">{L.s5}</option>
          </select>
        </label>
        <div class="ecp-seg" role="group">
          <button type="button" class="ecp-seg-btn" data-zoom="fit" aria-pressed="true">{L.fit}</button>
          <button type="button" class="ecp-seg-btn" data-zoom="actual" aria-pressed="false">{L.actual}</button>
        </div>
        <button id="ecp-close" class="btn-ghost ecp-close" type="button">{L.closeImage}</button>
      </div>
      <div id="ecp-scroller" class="ecp-scroller">
        <div id="ecp-stage" class="ecp-stage">
          <canvas id="ecp-canvas" class="ecp-canvas" tabindex="0" aria-label={L.imageAria}></canvas>
          <span id="ecp-marker" class="ecp-marker" hidden></span>
        </div>
      </div>
      <p id="ecp-hint" class="ecp-hint" aria-live="polite">{L.imageHint}</p>
      <p id="ecp-imgnote" class="ecp-hint" hidden></p>
    </div>
    <canvas id="ecp-loupe" class="ecp-loupe" aria-hidden="true" hidden></canvas>
  </section>

  </div>

  <div class="ecp-right">
  <div class="ecp-summary">
    <div id="ecp-swatch" class="ecp-swatch" role="img" aria-label={L.swatchAria.replace('{hex}', '#1a73e8')}><span id="ecp-swatch-fill" class="ecp-swatch-fill"></span></div>
    <div class="ecp-summary-main">
      <label for="ecp-hex" class="ecp-label">{L.hexLabel}</label>
      <div class="ecp-input-row">
        <input id="ecp-hex" data-field="hex" class="tool-input ecp-value" type="text" value="#1a73e8" spellcheck="false" autocomplete="off" autocapitalize="off" />
        <button class="btn-copy" type="button" data-copy="hex">{L.copy}</button>
      </div>
      <p id="ecp-status" class="ecp-status" role="status" aria-live="polite"></p>
      <p id="ecp-note" class="ecp-note" hidden></p>
    </div>
  </div>

  <div class="ecp-fields">
    {FIELDS.slice(1).map((f) => (
      <div class="ecp-field">
        <label for={`ecp-${f}`} class="ecp-label">{L[`${f}Label` as 'rgbLabel']}</label>
        <div class="ecp-input-row">
          <input id={`ecp-${f}`} data-field={f} class="tool-input ecp-value" type="text" spellcheck="false" autocomplete="off" autocapitalize="off" />
          <button class="btn-copy" type="button" data-copy={f}>{L.copy}</button>
        </div>
      </div>
    ))}
  </div>
  </div>

  <div class="ecp-recent">
    <div class="ecp-recent-header">
      <span class="ecp-label">{L.recent}</span>
      <span class="ecp-recent-actions">
        <button id="ecp-copy-all" class="btn-copy" type="button" hidden>{L.copyAll}</button>
        <button id="ecp-recent-clear" class="btn-ghost ecp-recent-clear" type="button" hidden>{L.clearRecent}</button>
      </span>
    </div>
    <div id="ecp-recent-grid" class="ecp-recent-grid" role="list"></div>
    <p id="ecp-recent-empty" class="ecp-recent-empty">{L.recentEmpty}</p>
    <p class="ecp-recent-note">{L.recentNote}</p>
  </div>
</div>

<script is:inline define:vars={{ t: L }}>
  (function () {
    /* ── engine:start ── */
    // Pure color and sampling functions. No DOM access, so scripts/test-eyedropper-color-picker.mjs
    // can run them in Node. Conversion matrices and transfer functions are the CSS Color 4
