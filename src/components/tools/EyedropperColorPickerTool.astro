---
// Eyedropper color picker: pick from the screen (EyeDropper API), from an image or screenshot
// (canvas readout in sRGB and, where supported, Display P3), or from the system color dialog.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// {x} {y} {w} {h} {n} {a} {name} {msg} are filled in by the script.
