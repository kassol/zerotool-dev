    }
    wrap.querySelectorAll('[data-zoom]').forEach(function (b) {
      b.addEventListener('click', function () { setZoom(b.getAttribute('data-zoom')); });
    });
    function layout() {
      if (!img) return;
      var s;
      if (zoom === 'actual') {
        s = 1;
        scroller.classList.add('is-actual');
      } else {
        scroller.classList.remove('is-actual');
        var maxW = scroller.clientWidth || viewer.clientWidth || 300;
        var maxH = Math.max(160, Math.min(window.innerHeight * (window.innerWidth <= 640 ? 0.45 : 0.6), 640));
        s = Math.min(maxW / img.w, maxH / img.h, 16);
