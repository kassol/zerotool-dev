    }
    window.addEventListener('resize', layout);

    var sample = Number(loadPrefs().sample);
    if (sample === 3 || sample === 5) sampleSel.value = String(sample);
    sampleSel.addEventListener('change', function () { savePrefs({ sample: Number(sampleSel.value) }); if (cursor) drawLoupe(); });

    function readRegion(x, y, size) {
      var half = (size - 1) / 2;
      var x0 = Math.max(0, x - half), y0 = Math.max(0, y - half);
      var x1 = Math.min(img.w - 1, x + half), y1 = Math.min(img.h - 1, y + half);
      var w = x1 - x0 + 1, h = y1 - y0 + 1;
      var px = sampleRegion(img.ctx.getImageData(x0, y0, w, h).data, w, h, x - x0, y - y0, size);
      var p3px = null;
      if (img.p3ctx) {
        try { p3px = sampleRegion(img.p3ctx.getImageData(x0, y0, w, h, { colorSpace: 'display-p3' }).data, w, h, x - x0, y - y0, size); } catch (e) { p3px = null; }
      }
      return pixelColor(px, p3px);
    }
    function pick() {
      if (!img || !cursor) return;
      var size = Number(sampleSel.value) || 1;
      var c = readRegion(cursor[0], cursor[1], size);
      placeMarker(true);
      if (!c) { hintEl.textContent = t.transparent; return; }
      var at = { x: cursor[0], y: cursor[1], n: size * size };
      // Reported under the image, not above it, so the image does not move between picks.
      hintEl.textContent = fill(size > 1 ? t.fromImageAvg : t.fromImage, at);
      show(c, { record: true, fromImage: true, status: '' });
      track('image_pick');
    }
    function placeMarker(visible) {
      if (!img || !cursor) { marker.hidden = true; return; }
      if (visible) marker.hidden = false;
      marker.style.left = ((cursor[0] + 0.5) / img.w * 100) + '%';
      marker.style.top = ((cursor[1] + 0.5) / img.h * 100) + '%';
    }

    var LOUPE_CELLS = 11, LOUPE_CSS = 132;
    function drawLoupe(clientX, clientY) {
      if (!img || !cursor) return;
      var dpr = window.devicePixelRatio || 1;
      var px = Math.round(LOUPE_CSS * dpr);
      if (loupe.width !== px) { loupe.width = px; loupe.height = px; }
      var lc = loupe.getContext('2d');
      var cell = px / LOUPE_CELLS, half = (LOUPE_CELLS - 1) / 2;
      lc.imageSmoothingEnabled = false;
      lc.fillStyle = '#808080';
      lc.fillRect(0, 0, px, px);
      for (var gy = 0; gy < LOUPE_CELLS; gy++) {
        for (var gx = 0; gx < LOUPE_CELLS; gx++) {
          var sx = cursor[0] - half + gx, sy = cursor[1] - half + gy;
          if (sx < 0 || sy < 0 || sx >= img.w || sy >= img.h) continue;
          if ((gx + gy) % 2) { lc.fillStyle = '#d0d0d0'; lc.fillRect(gx * cell, gy * cell, cell, cell); }
          else { lc.fillStyle = '#f4f4f4'; lc.fillRect(gx * cell, gy * cell, cell, cell); }
        }
      }
      lc.drawImage(canvas, cursor[0] - half, cursor[1] - half, LOUPE_CELLS, LOUPE_CELLS, 0, 0, px, px);
      lc.strokeStyle = 'rgba(0,0,0,0.18)';
      lc.lineWidth = 1;
      for (var i = 1; i < LOUPE_CELLS; i++) {
        lc.beginPath(); lc.moveTo(i * cell, 0); lc.lineTo(i * cell, px); lc.stroke();
        lc.beginPath(); lc.moveTo(0, i * cell); lc.lineTo(px, i * cell); lc.stroke();
      }
      var size = Number(sampleSel.value) || 1;
      var o = (half - (size - 1) / 2) * cell, len = size * cell;
      lc.lineWidth = Math.max(2, dpr * 1.5);
      lc.strokeStyle = '#000';
      lc.strokeRect(o, o, len, len);
      lc.strokeStyle = '#fff';
      lc.strokeRect(o - lc.lineWidth, o - lc.lineWidth, len + 2 * lc.lineWidth, len + 2 * lc.lineWidth);
      if (clientX === undefined) {
        var r = canvas.getBoundingClientRect();
        clientX = r.left + (cursor[0] + 0.5) / img.w * r.width;
        clientY = r.top + (cursor[1] + 0.5) / img.h * r.height;
      }
      var gap = touching ? 48 : 18;
      var left = clientX + gap, top = clientY - gap - LOUPE_CSS;
      if (left + LOUPE_CSS > window.innerWidth - 4) left = clientX - gap - LOUPE_CSS;
      if (left < 4) left = 4;
      if (top < 4) top = clientY + gap;
      loupe.style.left = left + 'px';
      loupe.style.top = top + 'px';
      loupe.hidden = false;
    }
    function pointAt(e) {
      var r = canvas.getBoundingClientRect();
      cursor = clientToPixel(e.clientX - r.left, e.clientY - r.top, r.width, r.height, img.w, img.h);
      drawLoupe(e.clientX, e.clientY);
    }
    canvas.addEventListener('pointerdown', function (e) {
      if (!img) return;
      if (e.pointerType !== 'mouse') {
        touching = true;
        try { canvas.setPointerCapture(e.pointerId); } catch (err) {}
        pointAt(e);
      }
    });
    canvas.addEventListener('pointermove', function (e) { if (img) pointAt(e); });
    canvas.addEventListener('pointerup', function (e) {
      if (!img) return;
      if (e.pointerType === 'mouse') { if (e.button === 0) { pointAt(e); pick(); } return; }
      if (touching) { touching = false; pointAt(e); pick(); loupe.hidden = true; }
    });
    canvas.addEventListener('pointercancel', function () { touching = false; loupe.hidden = true; });
    canvas.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') loupe.hidden = true; });
    canvas.addEventListener('blur', function () { loupe.hidden = true; });
    canvas.addEventListener('keydown', function (e) {
      if (!img) return;
      var step = e.shiftKey ? 10 : 1;
      var d = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] }[e.key];
      if (d) {
        e.preventDefault();
        if (!cursor) cursor = [Math.floor(img.w / 2), Math.floor(img.h / 2)];
        else cursor = [Math.min(img.w - 1, Math.max(0, cursor[0] + d[0])), Math.min(img.h - 1, Math.max(0, cursor[1] + d[1]))];
        drawLoupe();
        placeMarker(true);
      } else if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (!cursor) cursor = [Math.floor(img.w / 2), Math.floor(img.h / 2)];
        pick();
      } else if (e.key === 'Escape') {
        loupe.hidden = true;
      }
    });
    window.addEventListener('scroll', function () { if (!touching) loupe.hidden = true; }, { passive: true });

    // ── copy ──
    function copyText(text, btn, fallbackInput) {
      if (!text) return;
      function done() {
        var prev = btn.textContent;
        btn.textContent = t.copied;
        setTimeout(function () { btn.textContent = prev; }, 1500);
      }
      function fallback() {
        try {
          if (fallbackInput) { fallbackInput.focus(); fallbackInput.select(); }
          if (fallbackInput && document.execCommand('copy')) { done(); return; }
        } catch (e) {}
        setStatus(t.copyFailed, 'error');
      }
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fallback);
      else fallback();
    }
    wrap.querySelectorAll('[data-copy]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var k = btn.getAttribute('data-copy');
        copyText(fieldEls[k].value, btn, fieldEls[k]);
        track('copy_' + k);
      });
    });
    copyAllBtn.addEventListener('click', function () { copyText(getRecent().join('\n'), copyAllBtn, null); });
    recentClear.addEventListener('click', function () { savePrefs({ recent: [] }); renderRecent(); });

    // The site-wide Ctrl/⌘+L shortcut empties text inputs; reset the rest of the tool with them.
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
        setTimeout(clearAll, 0);
      }
    });

    var start = parseColor(getRecent()[0] || '#1a73e8');
    show(start, {});
    renderRecent();
  })();
</script>

<style>
  .ecp-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: var(--radius-lg);
    outline: 2px dashed transparent;
    outline-offset: 4px;
    transition: outline-color var(--transition-fast);
  }
  .ecp-wrap.is-dragging { outline-color: var(--color-primary); }
  .ecp-wrap [hidden] { display: none !important; }
  /* Small screens: actions, current color, image, other formats. Wide screens: two columns,
     image on the left and the formats on the right, so a pick never moves the image. */
  .ecp-left, .ecp-right { display: contents; }
  .ecp-actions-block { order: 1; }
  .ecp-summary { order: 2; }
  .ecp-image { order: 3; }
  .ecp-fields { order: 4; }
  .ecp-recent { order: 5; }
  @media (min-width: 900px) {
    .ecp-wrap { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); column-gap: 1.5rem; row-gap: 1rem; align-items: start; }
    .ecp-left, .ecp-right { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
    .ecp-recent { grid-column: 1 / -1; }
  }
  .ecp-actions-block { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .ecp-summary { display: flex; gap: 0.9rem; align-items: flex-start; min-width: 0; }
  .ecp-image { min-width: 0; }
  .ecp-fields { display: flex; flex-direction: column; gap: 0.7rem; min-width: 0; }

  .ecp-actions { position: relative; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .ecp-native {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
    border: 0;
    padding: 0;
  }
  .ecp-support { margin: 0; font-size: 0.84rem; line-height: 1.45; color: var(--color-text-secondary); }

  .ecp-swatch {
    position: relative;
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--color-border), var(--shadow-subtle);
    background-color: #fff;
    background-image: linear-gradient(45deg, #ccc 25%, transparent 25%, transparent 75%, #ccc 75%), linear-gradient(45deg, #ccc 25%, transparent 25%, transparent 75%, #ccc 75%);
    background-size: 14px 14px;
    background-position: 0 0, 7px 7px;
