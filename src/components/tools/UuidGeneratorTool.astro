---
import Toggletip from '../Toggletip.astro';
const { lang = 'en' } = Astro.props;
// strings:start
const STRINGS = {
        en: { copyFailed: 'Copy failed. Try again.', clickGenerate: 'Click Generate', generate: 'Generate', copy: 'Copy', copied: 'Copied!', batch: 'Batch:', uuids: 'UUIDs', generateBatch: 'Generate Batch', copyAll: 'Copy All', clear: 'Clear', batchPlaceholder: 'Batch UUIDs appear here...', singleResult: "Single UUID", batchResult: "Batch UUIDs", empty: "Generated UUIDs appear here.", tips: {"generate": "A version 4 UUID is generated on load with crypto.randomUUID. Generate creates a fresh single value.", "copy": "Copy the current single UUID. Its value stays unchanged when you generate or clear a batch.", "count": "Generate 1–100 UUIDs per batch. Decimals are truncated; an empty or non-numeric count uses 5. Changing the count saves the preference without generating.", "batch": "Generate a new batch with the current count. Values are written one per line; the single UUID stays unchanged.", "copyAll": "Copy the entire batch with a line break between UUIDs. The two copy buttons keep separate feedback.", "clear": "Clear empties the batch only. Ctrl or Command plus L clears both results and keeps the count preference."} },
        zh: { copyFailed: '复制失败，请重试。', clickGenerate: '点击生成', generate: '生成', copy: '复制', copied: '已复制！', batch: '批量：', uuids: '个 UUID', generateBatch: '批量生成', copyAll: '全部复制', clear: '清除', batchPlaceholder: '批量 UUID 显示在此...', singleResult: "单个 UUID", batchResult: "批量 UUID", empty: "生成的 UUID 会显示在这里。", tips: {"generate": "页面载入时用 crypto.randomUUID 生成一个 v4 UUID；生成按钮创建新的单个值。", "copy": "复制当前单个 UUID；生成或清空批量结果不会改变这个值。", "count": "每批生成 1–100 个 UUID，小数舍去小数部分，空值或无效数字使用 5。修改数量只保存偏好，不会执行生成。", "batch": "按当前数量重新生成一批，每行一个；单个 UUID 保持不变。", "copyAll": "复制全部批量 UUID，每个值之间保留换行。两枚复制按钮分别维护反馈。", "clear": "清除只清空批量结果。Ctrl 或 Command 加 L 清空两份结果，并保留数量偏好。"} },
        ja: { copyFailed: 'コピーに失敗しました。再試行してください。', clickGenerate: '生成をクリック', generate: '生成', copy: 'コピー', copied: 'コピー済み！', batch: 'バッチ：', uuids: '件の UUID', generateBatch: 'バッチ生成', copyAll: 'すべてコピー', clear: 'クリア', batchPlaceholder: 'バッチ UUID がここに表示されます...', singleResult: "単体 UUID", batchResult: "バッチ UUID", empty: "生成した UUID がここに表示されます。", tips: {"generate": "ページ表示時に crypto.randomUUID で v4 UUID を 1 つ生成します。「生成」は新しい単体の値を作ります。", "copy": "現在の単体 UUID をコピーします。バッチの生成や消去ではこの値は変わりません。", "count": "1〜100 件を生成します。小数は切り捨て、空欄や無効な数値は 5 件になります。数量の変更は設定を保存し、生成は実行しません。", "batch": "現在の数量で新しいバッチを生成し、1 行に 1 件表示します。単体 UUID は保持します。", "copyAll": "バッチ全体を UUID 間の改行とともにコピーします。2 つのコピーボタンはそれぞれの表示を管理します。", "clear": "「クリア」はバッチのみ消去します。Ctrl または Command と L は両方の結果を消去し、数量設定を保持します。"} },
        ko: { copyFailed: '복사하지 못했습니다. 다시 시도하세요.', clickGenerate: '생성 클릭', generate: '생성', copy: '복사', copied: '복사됨!', batch: '배치:', uuids: '개 UUID', generateBatch: '배치 생성', copyAll: '모두 복사', clear: '지우기', batchPlaceholder: '배치 UUID가 여기에 표시됩니다...', singleResult: "단일 UUID", batchResult: "배치 UUID", empty: "생성한 UUID가 여기에 표시됩니다.", tips: {"generate": "페이지를 열면 crypto.randomUUID로 v4 UUID 하나를 생성합니다. 생성 버튼은 새 단일 값을 만듭니다.", "copy": "현재 단일 UUID를 복사합니다. 배치를 생성하거나 지워도 이 값은 유지됩니다.", "count": "배치마다 1~100개를 생성합니다. 소수점 이하는 버리고 빈 값이나 유효하지 않은 숫자는 5를 사용합니다. 수량 변경은 설정을 저장하며 생성은 실행하지 않습니다.", "batch": "현재 수량으로 새 배치를 생성하며 한 줄에 하나씩 표시합니다. 단일 UUID는 유지됩니다.", "copyAll": "UUID 사이의 줄바꿈과 함께 전체 배치를 복사합니다. 두 복사 버튼의 피드백은 각각 관리됩니다.", "clear": "지우기는 배치만 비웁니다. Ctrl 또는 Command와 L을 누르면 두 결과를 지우고 수량 설정은 유지합니다."} }
      };
// strings:end
const L = STRINGS[lang as keyof typeof STRINGS] || STRINGS.en;
const clientStrings = { clickGenerate: L.clickGenerate, copied: L.copied, copy: L.copy, copyAll: L.copyAll, copyFailed: L.copyFailed };
---
<div class="uuid-wrap" data-strings={JSON.stringify(clientStrings)}>
  <div class="uuid-main">
  <aside class="uuid-rail zt-rail">
    <div class="uuid-actions">
      <div class="uuid-action-row"><button id="uuid-generate" class="btn-primary">{L.generate}</button><Toggletip id="uuid-tip-generate" lang={lang} about={L.generate}>{L.tips.generate}</Toggletip></div>
      <div class="uuid-action-row uuid-status" role="status" aria-live="polite"><button id="uuid-copy-single" class="btn-secondary">{L.copy}</button><Toggletip id="uuid-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip></div>
    </div>
    <div class="uuid-count-row">
      <label class="batch-label" for="uuid-count"><span>{L.batch}</span><input type="number" id="uuid-count" value="5" min="1" max="100" /><span>{L.uuids}</span></label>
      <Toggletip id="uuid-tip-count" lang={lang} about={L.batch}>{L.tips.count}</Toggletip>
    </div>
    <div class="uuid-actions">
      <div class="uuid-action-row"><button id="uuid-batch-gen" class="btn-primary">{L.generateBatch}</button><Toggletip id="uuid-tip-batch" lang={lang} about={L.generateBatch}>{L.tips.batch}</Toggletip></div>
      <div class="uuid-action-row uuid-status" role="status" aria-live="polite"><button id="uuid-batch-copy" class="btn-secondary">{L.copyAll}</button><Toggletip id="uuid-tip-copy-all" lang={lang} about={L.copyAll}>{L.tips.copyAll}</Toggletip></div>
      <div class="uuid-action-row"><button id="uuid-batch-clear" class="btn-ghost">{L.clear}</button><Toggletip id="uuid-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip></div>
    </div>
  </aside>
  <section class="uuid-results" aria-label={L.singleResult}>
    <p class="uuid-empty">{L.empty}</p>
    <div class="uuid-result-content">
      <div class="uuid-single"><span class="tool-label">{L.singleResult}</span><div class="uuid-display" id="uuid-output">{L.clickGenerate}</div></div>
      <div class="uuid-batch-section"><label class="tool-label" for="uuid-batch-output">{L.batchResult}</label><textarea id="uuid-batch-output" readonly placeholder={L.batchPlaceholder} spellcheck="false"></textarea></div>
    </div>
  </section>
  </div>
  <script is:inline>
    (function () {
      var t = JSON.parse(document.querySelector('.uuid-wrap').dataset.strings);

      var singleOut = document.getElementById('uuid-output');
      var batchOut = document.getElementById('uuid-batch-output');
      var countInput = document.getElementById('uuid-count');

      var copyStates = new Map();
      function resetCopy(btn, label) {
        var previous = copyStates.get(btn);
        if (previous) clearTimeout(previous.timer);
        var state = { timer: null };
        copyStates.set(btn, state);
        btn.textContent = label;
        return state;
      }
      function copyText(btn, text, label, copied, delay) {
        if (!text || btn.disabled) return;
        var state = resetCopy(btn, label);
        function current() { return copyStates.get(btn) === state; }
        function failed() { if (current()) btn.textContent = t.copyFailed; }
        try {
          if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') { failed(); return; }
          Promise.resolve(navigator.clipboard.writeText(text)).then(function () {
            if (!current()) return;
            btn.textContent = copied;
            state.timer = setTimeout(function () { if (current()) btn.textContent = label; }, delay);
          }, failed);
        } catch (e) { failed(); }
      }
      var singleCopy = document.getElementById('uuid-copy-single');
      var batchCopy = document.getElementById('uuid-batch-copy');
      batchCopy.disabled = true;

      function genUUID() {
        return crypto.randomUUID();
      }

      document.getElementById('uuid-generate').addEventListener('click', function () {
        resetCopy(singleCopy, t.copy);
        singleCopy.disabled = false;
        singleOut.textContent = genUUID();
        singleOut.classList.add('has-value');
        window.trackTool && window.trackTool('uuid_generator', 'generate');
      });

      singleCopy.addEventListener('click', function () {
        var val = singleOut.textContent;
        if (val === t.clickGenerate) return;
        copyText(singleCopy, val, t.copy, t.copied, 1500);
      });

      document.getElementById('uuid-batch-gen').addEventListener('click', function () {
        var parsed = parseInt(countInput.value, 10);
        var count = Math.min(100, Math.max(1, isNaN(parsed) ? 5 : parsed));
        var uuids = [];
        for (var i = 0; i < count; i++) uuids.push(genUUID());
        resetCopy(batchCopy, t.copyAll);
        batchOut.value = uuids.join('\n');
        batchCopy.disabled = false;
        window.trackTool && window.trackTool('uuid_generator', 'generate_batch');
      });

      batchCopy.addEventListener('click', function () {
        copyText(batchCopy, batchOut.value, t.copyAll, t.copied, 1500);
      });

      document.getElementById('uuid-batch-clear').addEventListener('click', function () {
        batchOut.value = '';
        resetCopy(batchCopy, t.copyAll);
        batchCopy.disabled = true;
      });
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l') return;
        var tool = document.querySelector('.uuid-wrap');
        if (!tool || !tool.contains(document.activeElement)) return;
        singleOut.textContent = '';
        singleOut.classList.remove('has-value');
        batchOut.value = '';
        resetCopy(singleCopy, t.copy);
        resetCopy(batchCopy, t.copyAll);
        singleCopy.disabled = true;
        batchCopy.disabled = true;
      });

      // Restore saved count preference
      if (window.ztPersist) {
        var _savedCount = window.ztPersist.load('uuid-generator')['count'];
        if (_savedCount !== undefined) countInput.value = _savedCount;
      }

      // Save count on change
      countInput.addEventListener('change', function () {
        if (window.ztPersist) window.ztPersist.save('uuid-generator', { count: countInput.value });
      });

      // Auto-generate one on load
      singleOut.textContent = genUUID();
      singleOut.classList.add('has-value');
    })();
  </script>
</div>

<style>
  .uuid-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .uuid-main { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 1rem; flex: 1; min-width: 0; min-height: 0; }
  .uuid-rail { overflow: auto; }
  .uuid-actions { display: flex; flex-direction: column; gap: 0.5rem; }
  .uuid-action-row, .uuid-count-row { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .uuid-action-row button { min-width: 0; max-width: 100%; white-space: normal; }
  .uuid-status { min-height: 2.8em; }
  .batch-label { display: flex; align-items: center; gap: 0.5rem; min-width: 0; font-size: 0.9rem; font-weight: 600; color: var(--color-text-secondary); }
  .batch-label input { width: 70px; padding: 0.3rem 0.5rem; border: 1px solid var(--color-border); border-radius: 5px; font-size: 0.9rem; text-align: center; background: var(--color-bg); color: var(--color-text); }
  .uuid-results, .uuid-result-content { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; }
  .uuid-result-content { flex: 1; }
  .uuid-single { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; flex: none; }
  .uuid-results .tool-label { margin: 0; }
  .uuid-display { min-width: 0; font-family: var(--font-mono); font-size: 1.1rem; letter-spacing: 0.02em; padding: 0.75rem 1rem; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); width: 100%; color: var(--color-text-muted); user-select: all; white-space: pre; overflow: auto; }
  .uuid-display.has-value { color: var(--color-text); }
  .uuid-batch-section { display: flex; flex-direction: column; gap: 0.5rem; flex: 1; min-width: 0; min-height: 0; }
  #uuid-batch-output { flex: 1 1 0; width: 100%; min-height: 140px; font-family: var(--font-mono); font-size: 0.85rem; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-secondary); color: var(--color-text); resize: none; overflow: auto; white-space: pre; }
  .uuid-empty { display: none; margin: 0; color: var(--color-text-muted); }
  .uuid-results:has(#uuid-output:empty):has(#uuid-batch-output:placeholder-shown) .uuid-result-content { display: none; }
  .uuid-results:has(#uuid-output:empty):has(#uuid-batch-output:placeholder-shown) .uuid-empty { display: grid; flex: 1; min-height: 300px; place-content: center; padding: 1rem; }
  @media (max-width: 860px) {
    .uuid-main { grid-template-columns: minmax(0, 1fr); }
    .uuid-rail { overflow: visible; }
    #uuid-batch-output { flex: none; height: 200px; min-height: 0; }
    .uuid-results:has(#uuid-output:empty):has(#uuid-batch-output:placeholder-shown) { display: none; }
  }
  @media (max-width: 640px) {
    .uuid-main { gap: 0.75rem; }
    .uuid-actions { flex-direction: row; flex-wrap: wrap; gap: 0.35rem; }
    .uuid-action-row { flex: 1 1 auto; }
    .uuid-action-row button, .batch-label input { min-height: 44px; }
    .uuid-display { padding: 0.65rem 0.75rem; font-size: 0.95rem; }
    #uuid-batch-output { height: 180px; }
  }
</style>
