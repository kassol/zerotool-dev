---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: {
    empty: "Enter TypeScript or load the example to generate Zod schemas.",
    tips: {
      input: "Enter interface, type or enum declarations. Generation runs 300 ms after typing stops. Parse errors clear the output and show an error. Classes and generic type definitions are outside this parser’s scope.",
      example: "Replace the input with Address, User and Status declarations, then generate immediately.",
      clear: "Clear the TypeScript, Zod output, highlighting and status. Ctrl/⌘+L does the same while focus is in this tool.",
      copy: "Copy the complete Zod output, including its import and inferred types. Empty output is not copied.",
    },
    tsInput: 'TypeScript Input',
    zodOutput: 'Zod Schema Output',
    example: 'Example',
    clear: 'Clear',
    copy: 'Copy',
    copied: 'Copied!',
    copyFailed: 'Copy failed',
    msgNoDecl: 'No interface or type declarations found.',
    msgGenOne: 'Generated 1 schema.',
    msgGenMany: 'Generated {n} schemas.',
    msgError: 'Parse error: ',
    msgNoColon: 'Line {line}, column {col}: "{name}" needs ":" before its type.',
  },
  zh: {
    empty: "输入 TypeScript 或载入示例以生成 Zod schema。",
    tips: {
      input: "输入 interface、type 或 enum 声明。停止输入 300 毫秒后自动生成；解析出错时清空输出并显示错误。此解析器不处理 class 或泛型类型定义。",
      example: "用 Address、User 和 Status 声明替换输入，并立即生成。",
      clear: "清空 TypeScript、Zod 输出、高亮和状态。在工具内按 Ctrl/⌘+L 执行相同操作。",
      copy: "复制完整 Zod 输出，包括 import 和推断类型。输出为空时不复制。",
    },
    tsInput: 'TypeScript 输入',
    zodOutput: 'Zod Schema 输出',
    example: '示例',
    clear: '清空',
    copy: '复制',
    copied: '已复制！',
    copyFailed: '复制失败',
    msgNoDecl: '未找到 interface 或 type 声明。',
    msgGenOne: '已生成 1 个 schema。',
    msgGenMany: '已生成 {n} 个 schema。',
    msgError: '解析错误：',
    msgNoColon: '第 {line} 行第 {col} 列：“{name}”后面缺少冒号“:”。',
  },
  ja: {
    empty: "TypeScript を入力するかサンプルを読み込むと、Zod スキーマを生成します。",
    tips: {
      input: "interface、type、enum 宣言を入力します。入力停止から 300 ミリ秒後に生成します。解析エラー時は出力を消去してエラーを表示します。class とジェネリック型定義は対象外です。",
      example: "入力を Address、User、Status の宣言に置き換え、すぐに生成します。",
      clear: "TypeScript、Zod 出力、ハイライト、ステータスを消去します。ツール内で Ctrl/⌘+L を押しても同じ操作になります。",
      copy: "import と推論された型を含む Zod 出力を全文コピーします。出力が空の場合はコピーしません。",
    },
    tsInput: 'TypeScript 入力',
    zodOutput: 'Zod スキーマ出力',
    example: 'サンプル',
    clear: 'クリア',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyFailed: 'コピー失敗',
    msgNoDecl: 'interface または type 宣言が見つかりません。',
    msgGenOne: '1 個のスキーマを生成しました。',
    msgGenMany: '{n} 個のスキーマを生成しました。',
    msgError: '解析エラー：',
    msgNoColon: '{line} 行 {col} 列：「{name}」の後に「:」がありません。',
  },
  ko: {
    empty: "TypeScript를 입력하거나 예시를 불러와 Zod 스키마를 생성하세요.",
    tips: {
      input: "interface, type 또는 enum 선언을 입력하세요. 입력을 멈춘 뒤 300밀리초 후 생성합니다. 파싱 오류가 발생하면 출력을 지우고 오류를 표시합니다. class와 제네릭 타입 정의는 지원 범위 밖입니다.",
      example: "입력을 Address, User, Status 선언으로 바꾸고 즉시 생성합니다.",
      clear: "TypeScript, Zod 출력, 강조 표시와 상태를 지웁니다. 도구 안에서 Ctrl/⌘+L을 눌러도 같습니다.",
      copy: "import와 추론된 타입을 포함한 Zod 출력 전체를 복사합니다. 출력이 비어 있으면 복사하지 않습니다.",
    },
    tsInput: 'TypeScript 입력',
    zodOutput: 'Zod 스키마 출력',
    example: '예시',
    clear: '지우기',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사 실패',
    msgNoDecl: 'interface 또는 type 선언을 찾을 수 없습니다.',
    msgGenOne: '스키마 1개를 생성했습니다.',
    msgGenMany: '스키마 {n}개를 생성했습니다.',
    msgError: '파싱 오류: ',
    msgNoColon: '{line}행 {col}열: "{name}" 뒤에 ":"가 없습니다.',
  },
};

const L = STRINGS[lang];
---

<div
  class="ttz-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-msg-no-decl={L.msgNoDecl}
  data-msg-gen-one={L.msgGenOne}
  data-msg-gen-many={L.msgGenMany}
  data-msg-error={L.msgError}
  data-msg-no-colon={L.msgNoColon}
>
  <div class="ttz-actions">
    <div class="ttz-control-label">
      <button id="ttz-example" class="btn-ghost" type="button">{L.example}</button>
      <Toggletip id="ttz-tip-example" lang={lang} about={L.example}>{L.tips.example}</Toggletip>
    </div>
    <div class="ttz-control-label">
      <button id="ttz-clear" class="btn-ghost" type="button">{L.clear}</button>
      <Toggletip id="ttz-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip>
    </div>
  </div>
  <div id="ttz-status" class="ttz-status" aria-live="polite"></div>

  <div class="ttz-panels zt-io">
    <div class="ttz-panel zt-io-pane">
      <div class="ttz-panel-header">
        <div class="ttz-control-label">
          <label for="ttz-input">{L.tsInput}</label>
          <Toggletip id="ttz-tip-input" lang={lang} about={L.tsInput}>{L.tips.input}</Toggletip>
        </div>
      </div>
      <div class="ttz-input-wrap zt-io-fill">
        <pre class="ttz-input-hl" aria-hidden="true"><code id="ttz-input-hl-code" class="language-typescript"></code></pre>
        <textarea id="ttz-input" placeholder={`interface User {\n  name: string;\n  age?: number;\n}`} spellcheck="false"></textarea>
      </div>
    </div>
    <div class="ttz-panel ttz-output-pane zt-io-pane">
      <div class="ttz-panel-header">
        <span id="ttz-output-label">{L.zodOutput}</span>
        <div class="ttz-control-label">
          <button id="ttz-copy" class="btn-ghost" type="button">{L.copy}</button>
          <Toggletip id="ttz-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip>
        </div>
      </div>
      <p class="ttz-empty zt-io-fill">{L.empty}</p>
      <pre id="ttz-output" class="ttz-output zt-io-fill" tabindex="0" aria-labelledby="ttz-output-label"><code id="ttz-output-code"></code></pre>
    </div>
  </div>

  <script>
    import hljs from 'highlight.js/lib/core';
    import typescript from 'highlight.js/lib/languages/typescript';
    hljs.registerLanguage('typescript', typescript);

    (function () {
      var wrap = document.querySelector('.ttz-wrap');

      var COPY = wrap ? wrap.dataset.copy : 'Copy';
      var COPIED = wrap ? wrap.dataset.copied : 'Copied!';
      var COPY_FAILED = wrap ? wrap.dataset.copyFailed : 'Copy failed';
      var MSG_NO_DECL = wrap ? wrap.dataset.msgNoDecl : 'No declarations found.';
      var MSG_GEN_ONE = wrap ? wrap.dataset.msgGenOne : 'Generated 1 schema.';
      var MSG_GEN_MANY = wrap ? wrap.dataset.msgGenMany : 'Generated {n} schemas.';
      var MSG_ERROR = wrap ? wrap.dataset.msgError : 'Parse error: ';
      var MSG_NO_COLON = wrap ? wrap.dataset.msgNoColon : 'Line {line}, column {col}: "{name}" needs ":" before its type.';

      var inputEl = document.getElementById('ttz-input');
      var hlInputCodeEl = document.getElementById('ttz-input-hl-code');
      var outputCodeEl = document.getElementById('ttz-output-code');
      var statusEl = document.getElementById('ttz-status');
      var copyBtn = document.getElementById('ttz-copy');
      var copyRevision = 0;
      var copyTimer = null;

      function resetCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = COPY;
      }

      var _hlInputTimer = null;
      function syncInputHL() {
        hlInputCodeEl.textContent = inputEl.value + '\n';
        hlInputCodeEl.removeAttribute('data-highlighted');
        hljs.highlightElement(hlInputCodeEl);
      }

      var EXAMPLE = [
        'interface Address {',
        '  street: string;',
        '  city: string;',
        '  zipCode?: string;',
        '}',
        '',
        'export interface User {',
        '  id: number;',
        '  name: string;',
        '  email: string;',
        '  role: "admin" | "user" | "guest";',
        '  age?: number;',
        '  isActive: boolean;',
        '  tags: string[];',
        '  address: Address;',
        '}',
        '',
        'export type Status = "active" | "inactive" | "pending";',
      ].join('\n');

      function setStatus(msg, isError) {
        statusEl.textContent = msg;
        statusEl.className = 'ttz-status ' + (isError ? 'error' : 'success');
      }

      function clearStatus() {
        statusEl.textContent = '';
        statusEl.className = 'ttz-status';
      }

      /* ── engine:start ── */
      /* ── TOKENIZER ── */

      var KEYWORDS = Object.assign(Object.create(null), {
        'interface': 1, 'type': 1, 'export': 1, 'readonly': 1,
        'extends': 1, 'implements': 1, 'class': 1, 'enum': 1,
        'import': 1, 'from': 1, 'declare': 1, 'abstract': 1,
        'namespace': 1, 'module': 1, 'const': 1, 'let': 1, 'var': 1,
        'function': 1, 'return': 1, 'keyof': 1, 'typeof': 1, 'infer': 1,
        'in': 1, 'is': 1, 'as': 1,
      });

      var ID_START = /[\p{ID_Start}$_]/u;
      var ID_PART = /[\p{ID_Continue}$\u200C\u200D]/u;

      /* 1-based line and column (in code points) of source index p */
      function position(src, p) {
        var before = src.slice(0, p);
        var lineStart = before.lastIndexOf('\n') + 1;
        return { line: before.split('\n').length, col: Array.from(before.slice(lineStart)).length + 1 };
      }

      function tokenize(src) {
        var tokens = [];
        var i = 0;
        var n = src.length;

        while (i < n) {
          var ch = src[i];

          /* whitespace */
          if (ch <= ' ') { i++; continue; }

          /* single-line comment */
          if (ch === '/' && src[i + 1] === '/') {
            while (i < n && src[i] !== '\n') i++;
            continue;
          }

          /* multi-line comment */
          if (ch === '/' && src[i + 1] === '*') {
            i += 2;
            while (i < n && !(src[i] === '*' && src[i + 1] === '/')) i++;
            i += 2;
            continue;
          }

          /* string literal */
          if (ch === '"' || ch === "'") {
            var q = ch, j = i + 1;
            while (j < n && src[j] !== q) {
              if (src[j] === '\\') j++;
              j++;
            }
            tokens.push({ t: 'STRING', v: src.slice(i + 1, j), p: i });
            i = j + 1;
            continue;
          }

          /* template literal — treat content as opaque string */
          if (ch === '`') {
            var j = i + 1;
            while (j < n && src[j] !== '`') {
              if (src[j] === '\\') j++;
              j++;
            }
            tokens.push({ t: 'TEMPLATE', v: src.slice(i + 1, j), p: i });
            i = j + 1;
            continue;
          }

          /* number literal */
          if (ch >= '0' && ch <= '9') {
            var j = i;
            while (j < n && (src[j] >= '0' && src[j] <= '9' || src[j] === '.')) j++;
            tokens.push({ t: 'NUMBER', v: src.slice(i, j), p: i });
            i = j;
            continue;
          }

          /* identifier / keyword: Unicode ID_Start / ID_Continue plus $ and _, as in TypeScript */
          var cp = String.fromCodePoint(src.codePointAt(i));
          if (ID_START.test(cp)) {
            var j = i + cp.length;
            while (j < n) {
              var cj = String.fromCodePoint(src.codePointAt(j));
              if (!ID_PART.test(cj)) break;
              j += cj.length;
            }
            var word = src.slice(i, j);
            tokens.push({ t: KEYWORDS[word] ? 'KW' : 'IDENT', v: word, p: i });
            i = j;
            continue;
          }

          /* ellipsis */
          if (src[i] === '.' && src[i + 1] === '.' && src[i + 2] === '.') {
            tokens.push({ t: 'PUNCT', v: '...', p: i });
            i += 3;
            continue;
          }

          /* full-width colon (U+FF1A, typed with a CJK input method) reads as ":" outside string literals */
          if (ch === '\uFF1A') {
            tokens.push({ t: 'PUNCT', v: ':', p: i });
            i++;
            continue;
          }

          /* single-char punctuation */
          if ('{}[](),;:?|&=<>!-'.indexOf(ch) !== -1) {
            tokens.push({ t: 'PUNCT', v: ch, p: i });
            i++;
            continue;
          }

          /* skip unknown (decorators @, etc.) */
          i++;
        }

        tokens.push({ t: 'EOF', v: '', p: i });
        tokens.src = src;
        return tokens;
      }

      /* ── PARSER ── */

      function P(tokens) {
        return {
          tok: tokens,
          pos: 0,
          peek: function () { return this.tok[this.pos]; },
          pv: function () { return this.tok[this.pos].v; },
          pt: function () { return this.tok[this.pos].t; },
          next: function () { return this.tok[this.pos++]; },
          eat: function (v) {
            if (this.pv() !== v) throw new Error('Expected "' + v + '" got "' + this.pv() + '"');
            return this.next();
          },
          maybe: function (v) {
            if (this.pv() === v) { this.next(); return true; }
            return false;
          },
          isKW: function (kw) { return this.pt() === 'KW' && this.pv() === kw; },
        };
      }

      function parse(tokens) {
        var p = P(tokens);
        var decls = [];

        while (p.pt() !== 'EOF') {
          /* skip export */
          if (p.isKW('export')) p.next();
          /* skip declare */
          if (p.isKW('declare')) { p.next(); if (p.isKW('export')) p.next(); }

          if (p.isKW('interface')) {
            decls.push(parseInterface(p));
          } else if (p.isKW('type')) {
            decls.push(parseTypeAlias(p));
          } else if (p.isKW('enum') || (p.isKW('const') && p.tok[p.pos + 1].v === 'enum')) {
            if (p.isKW('const')) p.next();
            decls.push(parseEnum(p));
          } else if (p.isKW('import') || p.isKW('const') || p.isKW('let') ||
                     p.isKW('var') || p.isKW('function') || p.isKW('class') ||
                     p.isKW('namespace') || p.isKW('module')) {
            /* skip to next top-level — consume until '{' and balance, or until ';' */
            skipStatement(p);
          } else if (p.pt() !== 'EOF') {
            p.next();
          }
        }

        return { decls: decls };
      }

      function skipStatement(p) {
        /* rough skip: consume tokens until we see a top-level keyword or EOF */
        while (p.pt() !== 'EOF') {
          var v = p.pv();
          if (p.pt() === 'KW' && (v === 'interface' || v === 'type' || v === 'export' || v === 'declare')) break;
          if (v === '{') { skipBlock(p); continue; }
          p.next();
          if (v === ';') break;
        }
      }

      function skipBlock(p) {
        p.eat('{');
        var depth = 1;
        while (p.pt() !== 'EOF' && depth > 0) {
          var v = p.pv();
          p.next();
          if (v === '{') depth++;
          else if (v === '}') depth--;
        }
      }

      /* Source text of tokens [from, p.pos) — written out for recursive declarations */
      function sliceSource(p, from) {
        var last = p.tok[p.pos - 1];
        var len = last.v.length + (last.t === 'STRING' || last.t === 'TEMPLATE' ? 2 : 0);
        return p.tok.src.slice(p.tok[from].p, last.p + len);
      }

      function parseInterface(p) {
        var from = p.pos;
        p.next(); /* interface */
        var name = expectIdent(p);
        /* skip type params */
        if (p.pv() === '<') skipAngle(p);
        /* extends A, B<T>, ns.C — keep the last identifier of each base, drop type arguments */
        var bases = [];
        if (p.isKW('extends')) {
          p.next();
          var base = null;
          while (p.pv() !== '{' && p.pt() !== 'EOF') {
            if (p.pv() === '<') { skipAngle(p); continue; }
            if (p.pv() === ',') { if (base) bases.push(base); base = null; p.next(); continue; }
            if (p.pt() === 'IDENT' || p.pt() === 'KW') base = p.pv();
            p.next();
          }
          if (base) bases.push(base);
        }
        p.eat('{');
        var members = parseMembers(p);
        p.eat('}');
        return { kind: 'interface', name: name, bases: bases, members: members, text: sliceSource(p, from) };
      }

      function parseTypeAlias(p) {
        var from = p.pos;
        p.next(); /* type */
        var name = expectIdent(p);
        /* skip type params */
        if (p.pv() === '<') skipAngle(p);
        p.eat('=');
        var te = parseTypeExpr(p);
        p.maybe(';');
        return { kind: 'type', name: name, te: te, text: sliceSource(p, from) };
      }

      /* enum E { A, B = 5, C = "c" } — constant members only; anything else marks the enum computed */
      function parseEnum(p) {
        p.next(); /* enum */
        var name = expectIdent(p);
        p.eat('{');
        var members = [];
        var computed = null;
        var next = 0; /* value of the next auto-numbered member; null after a string member */
        while (p.pv() !== '}' && p.pt() !== 'EOF') {
          var mt = p.next();
          var mname = mt.v;
          var value;
          if (p.maybe('=')) {
            var init = [];
            while (p.pv() !== ',' && p.pv() !== '}' && p.pt() !== 'EOF') init.push(p.next());
            if (init.length === 1 && init[0].t === 'STRING') value = init[0].v;
            else if (init.length === 1 && init[0].t === 'NUMBER' && isFinite(Number(init[0].v))) value = Number(init[0].v);
            else if (init.length === 2 && init[0].v === '-' && init[1].t === 'NUMBER' && isFinite(Number(init[1].v))) value = -Number(init[1].v);
            else if (computed === null) computed = mname;
          } else {
            value = next;
          }
          if (typeof value === 'number') next = value + 1;
          else if (value !== undefined) next = null;
          if (value === null && computed === null) computed = mname;
          members.push({ name: mname, value: value });
          p.maybe(',');
        }
        p.eat('}');
        return { kind: 'enum', name: name, members: members, computed: computed };
      }

      function expectIdent(p) {
        var t = p.peek();
        if (t.t !== 'IDENT' && t.t !== 'KW') throw new Error('Expected identifier, got "' + t.v + '"');
        p.next();
        return t.v;
      }

      function skipAngle(p) {
        /* skip <...> balanced */
        p.eat('<');
        var d = 1;
        while (p.pt() !== 'EOF' && d > 0) {
          if (p.pv() === '<') d++;
          else if (p.pv() === '>') d--;
          p.next();
        }
      }

      function parseMembers(p) {
        var members = [];
        while (p.pv() !== '}' && p.pt() !== 'EOF') {
          /* readonly modifier (a property may also be named readonly) */
          if (p.isKW('readonly') && ':?('.indexOf(p.tok[p.pos + 1].v) === -1) p.next();
          /* index / mapped type signature: [key: T]: V */
          if (p.pv() === '[') {
            p.next(); /* [ */
            /* distinguish index sig vs computed property vs mapped type */
            var t1 = p.peek();
            var t2 = p.pos + 1 < p.tok.length ? p.tok[p.pos + 1] : null;
            if ((t1.t === 'IDENT' || t1.t === 'KW') && t2 && t2.v === ':') {
              /* index signature: [key: string]: value */
              p.next(); /* key name */
              p.eat(':');
              parseTypeExpr(p); /* key type: every key of a JSON object is a string */
              p.eat(']');
              p.eat(':');
              var vte = parseTypeExpr(p);
              p.maybe(';'); p.maybe(',');
              members.push({ kind: 'index', vte: vte });
            } else {
              /* computed / mapped — skip until ]: */
              var d = 1;
              while (p.pt() !== 'EOF' && d > 0) {
                if (p.pv() === '[') d++;
                else if (p.pv() === ']') d--;
                p.next();
              }
              if (p.pv() === ':') {
                p.next();
                parseTypeExpr(p);
              }
              p.maybe(';'); p.maybe(',');
            }
            continue;
          }

          /* call signature (x: T): R or <T>(x: T): R — skip */
          if (p.pv() === '(' || p.pv() === '<') { skipSignature(p); continue; }

          /* property key */
          var kt = p.peek();
          if (kt.t !== 'IDENT' && kt.t !== 'KW' && kt.t !== 'STRING' && kt.t !== 'NUMBER') {
            p.next(); continue;
          }
          var key = p.next().v;
          if (kt.t === 'STRING') key = '"' + key + '"';

          /* get / set accessor: get name(): T, set [k](v: T) — skip */
          var nt = p.peek();
          if (kt.t === 'IDENT' && (key === 'get' || key === 'set') &&
              (nt.v === '[' || nt.t === 'IDENT' || nt.t === 'KW' || nt.t === 'STRING' || nt.t === 'NUMBER')) {
            if (p.pv() === '[') skipBrackets(p); else p.next();
            skipSignature(p);
            continue;
          }

          /* optional */
          var opt = p.maybe('?');

          /* method signature foo(args): R, generic foo<T>(args): R, construct signature new (args): R — skip */
          if (p.pv() === '(' || p.pv() === '<') { skipSignature(p); continue; }

          if (!p.maybe(':')) {
            var at = position(p.tok.src, kt.p);
            throw new Error(MSG_NO_COLON.replace('{line}', at.line).replace('{col}', at.col).replace('{name}', kt.v));
          }

          var te = parseTypeExpr(p);
          p.maybe(';'); p.maybe(',');
          members.push({ kind: 'prop', key: key, opt: opt, te: te });
        }
        return members;
      }

      /* <T>(args): R — type parameters, parameters, return type, separator */
      function skipSignature(p) {
        if (p.pv() === '<') skipAngle(p);
        if (p.pv() === '(') skipParens(p);
        if (p.pv() === ':') { p.next(); parseTypeExpr(p); }
        p.maybe(';'); p.maybe(',');
      }

      function skipBrackets(p) {
        p.eat('[');
        var d = 1;
        while (p.pt() !== 'EOF' && d > 0) {
          if (p.pv() === '[') d++;
          else if (p.pv() === ']') d--;
          p.next();
        }
      }

      function skipParens(p) {
        p.eat('(');
        var d = 1;
        while (p.pt() !== 'EOF' && d > 0) {
          if (p.pv() === '(') d++;
          else if (p.pv() === ')') d--;
          p.next();
        }
      }

      function parseTypeExpr(p) { return parseUnion(p); }

      function parseUnion(p) {
        p.maybe('|'); /* leading | */
        var types = [parseIntersection(p)];
        while (p.pv() === '|') { p.next(); types.push(parseIntersection(p)); }
        return types.length === 1 ? types[0] : { kind: 'union', types: types };
      }

      function parseIntersection(p) {
        var types = [parseArray(p)];
        while (p.pv() === '&') { p.next(); types.push(parseArray(p)); }
        return types.length === 1 ? types[0] : { kind: 'inter', types: types };
      }

      function parseArray(p) {
        var base = parsePrimary(p);
        while (p.pv() === '[' && p.pos + 1 < p.tok.length && p.tok[p.pos + 1].v === ']') {
          p.next(); p.next(); /* [ ] */
          base = { kind: 'array', elem: base };
        }
        return base;
      }

      function parsePrimary(p) {
        var t = p.peek();

        /* parenthesized */
        if (t.v === '(') { p.next(); var inner = parseTypeExpr(p); p.maybe(')'); return inner; }

        /* tuple */
        if (t.v === '[') {
          p.next();
          var items = [];
          while (p.pv() !== ']' && p.pt() !== 'EOF') {
            items.push(parseTypeExpr(p));
            p.maybe(',');
          }
          p.maybe(']');
          return { kind: 'tuple', items: items };
        }

        /* inline object */
        if (t.v === '{') {
          p.next();
          var members = parseMembers(p);
          p.maybe('}');
          return { kind: 'obj', members: members };
        }

        /* string literal */
        if (t.t === 'STRING') { p.next(); return { kind: 'lit', v: JSON.stringify(t.v), lt: 's' }; }

        /* number literal */
        if (t.t === 'NUMBER') { p.next(); return { kind: 'lit', v: t.v, lt: 'n' }; }
        if (t.v === '-' && p.tok[p.pos + 1].t === 'NUMBER') { p.next(); return { kind: 'lit', v: '-' + p.next().v, lt: 'n' }; }

        /* template literal → treat as string */
        if (t.t === 'TEMPLATE') { p.next(); return { kind: 'prim', n: 'string' }; }

        /* identifier or keyword */
        if (t.t === 'IDENT' || t.t === 'KW') {
          var nm = p.next().v;

          if (nm === 'true')  return { kind: 'lit', v: 'true', lt: 'b' };
          if (nm === 'false') return { kind: 'lit', v: 'false', lt: 'b' };

          var PRIMS = Object.assign(Object.create(null), { string:1, number:1, boolean:1, null:1, undefined:1,
                        any:1, unknown:1, void:1, never:1, object:1, bigint:1, symbol:1 });
          if (PRIMS[nm]) return { kind: 'prim', n: nm };

          /* generic */
          if (p.pv() === '<') {
            if (nm === 'Array' || nm === 'ReadonlyArray') {
              p.next(); /* < */
              var elem = parseTypeExpr(p);
              while (p.pv() === ',') { p.next(); parseTypeExpr(p); }
              p.maybe('>');
              return { kind: 'array', elem: elem };
            }
            if (nm === 'Partial') {
              p.next();
              var inner = parseTypeExpr(p);
              p.maybe('>');
              return { kind: 'partial', inner: inner };
            }
            if (nm === 'Required') {
              p.next();
              var inner = parseTypeExpr(p);
              p.maybe('>');
              return inner;
            }
            if (nm === 'Promise') {
              p.next();
              var inner = parseTypeExpr(p);
              p.maybe('>');
              return { kind: 'promise', inner: inner };
            }
            if (nm === 'Record') {
              p.next();
              var ktype = parseTypeExpr(p);
              p.maybe(',');
              var vtype = parseTypeExpr(p);
              p.maybe('>');
              return { kind: 'record', kt: ktype, vt: vtype };
            }
            /* other generics — skip params, return typeref */
            skipAngle(p);
            return { kind: 'ref', name: nm };
          }

          return { kind: 'ref', name: nm };
        }

        /* fallback */
        if (t.t !== 'EOF') p.next();
        return { kind: 'prim', n: 'unknown' };
      }

      /* ── CODE GENERATOR ── */

      /* Declarations are written dependencies first (otherwise a schema would read a const before
         its initialization). References that close a cycle use z.lazy(), and every declaration in a
         cycle gets its TypeScript type written out and a z.ZodType<T> annotation, as the Zod
         documentation shows for recursive types. */
      function generate(ast) {
        if (ast.decls.length === 0) throw new Error(MSG_NO_DECL);

        var byName = Object.create(null);
        ast.decls.forEach(function (d) { if (!Object.prototype.hasOwnProperty.call(byName, d.name)) byName[d.name] = d; });
        ast.decls.forEach(function (d) { d.deps = declDeps(d, byName); });
        var cyclic = cyclicNames(ast.decls, byName);

        var order = [];
        function visit(d) {
          if (d.state) return;
          d.state = 1;
          d.deps.forEach(function (n) { visit(byName[n]); });
          d.state = 2;
          order.push(d);
        }
        ast.decls.forEach(visit);

        var ctx = { names: byName, defined: Object.create(null), cyclic: cyclic, isObject: Object.create(null) };
        var parts = ['import { z } from "zod";'];
        order.forEach(function (d) {
          parts.push('');
          var expr = genDecl(d, ctx);
          if (cyclic[d.name]) {
            parts.push('export ' + d.text);
            parts.push('export const ' + d.name + 'Schema: z.ZodType<' + d.name + '> = ' + expr + ';');
          } else {
            parts.push('export const ' + d.name + 'Schema = ' + expr + ';');
            parts.push('export type ' + d.name + ' = z.infer<typeof ' + d.name + 'Schema>;');
          }
          ctx.defined[d.name] = true;
        });

        return parts.join('\n');
      }

      function declDeps(d, byName) {
        var out = [];
        function add(n) { if (Object.prototype.hasOwnProperty.call(byName, n) && out.indexOf(n) === -1) out.push(n); }
        function walk(node) {
          if (!node || typeof node !== 'object') return;
          if (node.kind === 'ref') add(node.name);
          ['elem', 'inner', 'kt', 'vt', 'te', 'vte'].forEach(function (k) { walk(node[k]); });
          (node.types || node.items || node.members || []).forEach(walk);
        }
        if (d.kind === 'interface') { d.bases.forEach(add); d.members.forEach(walk); }
        else if (d.kind === 'type') walk(d.te);
        return out;
      }

      /* Names in a dependency cycle (Tarjan's strongly connected components) */
      function cyclicNames(decls, byName) {
        var index = 0, stack = [], idx = Object.create(null), low = Object.create(null), on = Object.create(null), out = Object.create(null);
        function strong(d) {
          idx[d.name] = low[d.name] = index++;
          stack.push(d.name); on[d.name] = true;
          d.deps.forEach(function (n) {
            if (!(n in idx)) { strong(byName[n]); low[d.name] = Math.min(low[d.name], low[n]); }
            else if (on[n]) low[d.name] = Math.min(low[d.name], idx[n]);
          });
          if (low[d.name] === idx[d.name]) {
            var comp = [], w;
            do { w = stack.pop(); on[w] = false; comp.push(w); } while (w !== d.name);
            if (comp.length > 1 || d.deps.indexOf(d.name) !== -1) comp.forEach(function (n) { out[n] = true; });
          }
        }
        decls.forEach(function (d) { if (!(d.name in idx)) strong(d); });
        return out;
      }

      function genDecl(d, ctx) {
        if (d.kind === 'enum') return genEnum(d);
        if (d.kind === 'type') {
          ctx.isObject[d.name] = d.te && d.te.kind === 'obj' && !isRecordOnly(d.te.members) && !ctx.cyclic[d.name];
          return genType(d.te, '', ctx);
        }
        var declared = d.bases.filter(function (b) { return Object.prototype.hasOwnProperty.call(ctx.names, b); });
        var missing = d.bases.filter(function (b) { return !Object.prototype.hasOwnProperty.call(ctx.names, b); });
        var note = missing.length ? ' /* extends ' + missing.join(', ') + ': not declared in the input */' : '';
        if (!declared.length) {
          ctx.isObject[d.name] = !isRecordOnly(d.members) && !ctx.cyclic[d.name];
          return genObj(d.members, '', ctx) + note;
        }
        var allObjects = declared.every(function (b) { return ctx.defined[b] && ctx.isObject[b]; });
        if (allObjects) {
          var expr = declared[0] + 'Schema';
          for (var i = 1; i < declared.length; i++) expr += '.extend(' + declared[i] + 'Schema.shape)';
          expr += '.extend(' + genShape(d.members, '', ctx) + ')';
          var ix = indexValue(d.members, '', ctx);
          if (ix) expr += '.catchall(' + ix + ')';
          ctx.isObject[d.name] = !ctx.cyclic[d.name];
          return expr + note;
        }
        var own = genObj(d.members, '', ctx, true);
        for (var j = declared.length - 1; j >= 0; j--) own = 'z.intersection(' + genRef(declared[j], ctx) + ', ' + own + ')';
        ctx.isObject[d.name] = false;
        return own + note;
      }

      function genEnum(d) {
        if (d.computed !== null) return 'z.unknown() /* enum ' + d.name + ': computed member ' + d.computed + ' */';
        if (!d.members.length) return 'z.never()';
        var lits = d.members.map(function (m) { return typeof m.value === 'string' ? JSON.stringify(m.value) : String(m.value); });
        if (d.members.every(function (m) { return typeof m.value === 'string'; })) return 'z.enum([' + lits.join(', ') + '])';
        if (lits.length === 1) return 'z.literal(' + lits[0] + ')';
        return 'z.union([' + lits.map(function (l) { return 'z.literal(' + l + ')'; }).join(', ') + '])';
      }

      function genRef(name, ctx) {
        return ctx.defined[name] ? name + 'Schema' : 'z.lazy(() => ' + name + 'Schema)';
      }

      function isRecordOnly(members) {
        var props = members.filter(function (m) { return m.kind === 'prop'; });
        return props.length === 0 && members.some(function (m) { return m.kind === 'index'; });
      }

      function indexValue(members, ind, ctx) {
        for (var i = 0; i < members.length; i++) {
          if (members[i].kind === 'index') return genType(members[i].vte, ind, ctx);
        }
        return null;
      }

      function genShape(members, ind, ctx) {
        var pi = ind + '  ';
        var lines = ['{'];
        members.forEach(function (m) {
          if (m.kind !== 'prop') return;
          var expr = genType(m.te, pi + '  ', ctx);
          if (m.opt) expr += '.optional()';
          /* `__proto__: x` in an object literal sets the prototype; a computed key defines the property */
          lines.push(pi + (m.key === '__proto__' || m.key === '"__proto__"' ? '["__proto__"]' : m.key) + ': ' + expr + ',');
        });
        lines.push(ind + '}');
        return lines.join('\n');
      }

      /* An object type. Index signatures: with properties → .catchall(V), on their own → z.record. */
      function genObj(members, ind, ctx, keepObject) {
        var ix = indexValue(members, ind, ctx);
        if (ix && !keepObject && isRecordOnly(members)) return 'z.record(z.string(), ' + ix + ')';
        return 'z.object(' + genShape(members, ind, ctx) + ')' + (ix ? '.catchall(' + ix + ')' : '');
      }

      function genType(node, ind, ctx) {
        if (!node) return 'z.unknown()';
        switch (node.kind) {
          case 'prim': return genPrim(node.n);
          case 'lit':
            return 'z.literal(' + node.v + ')';
          case 'union': {
            var allStrLit = node.types.every(function (t) { return t.kind === 'lit' && t.lt === 's'; });
            if (allStrLit && node.types.length >= 2) {
              return 'z.enum([' + node.types.map(function (t) { return t.v; }).join(', ') + '])';
            }
            var exprs = node.types.map(function (t) { return genType(t, ind + '  ', ctx); });
            if (exprs.join(', ').length < 80) return 'z.union([' + exprs.join(', ') + '])';
            return 'z.union([\n' + exprs.map(function (e) { return ind + '  ' + e; }).join(',\n') + ',\n' + ind + '])';
          }
          case 'inter': {
            if (node.types.length === 2) {
              return 'z.intersection(' + genType(node.types[0], ind, ctx) + ', ' + genType(node.types[1], ind, ctx) + ')';
            }
            var r = genType(node.types[0], ind, ctx);
            for (var i = 1; i < node.types.length; i++) r = 'z.intersection(' + r + ', ' + genType(node.types[i], ind, ctx) + ')';
            return r;
          }
          case 'array': return 'z.array(' + genType(node.elem, ind, ctx) + ')';
          case 'obj': return genObj(node.members, ind, ctx);
          case 'tuple': return 'z.tuple([' + node.items.map(function (t) { return genType(t, ind, ctx); }).join(', ') + '])';
          case 'ref':
            return Object.prototype.hasOwnProperty.call(ctx.names, node.name) ? genRef(node.name, ctx) : 'z.unknown() /* ' + node.name + ' */';
          case 'partial': return genType(node.inner, ind, ctx) + '.partial()';
          /* Zod 4 needs the key schema; Zod 3 accepts it too */
          case 'record': return 'z.record(' + genType(node.kt, ind, ctx) + ', ' + genType(node.vt, ind, ctx) + ')';
          case 'promise': return 'z.promise(' + genType(node.inner, ind, ctx) + ')';
          default: return 'z.unknown()';
        }
      }

      function genPrim(n) {
        var map = Object.assign(Object.create(null), {
          string: 'z.string()', number: 'z.number()', boolean: 'z.boolean()',
          null: 'z.null()', undefined: 'z.undefined()', any: 'z.any()',
          unknown: 'z.unknown()', void: 'z.void()', never: 'z.never()',
          object: 'z.object({})', bigint: 'z.bigint()', symbol: 'z.symbol()',
        });
        return map[n] || 'z.unknown()';
      }

      /* ── engine:end ── */

      /* ── MAIN CONVERT ── */

      function convert() {
        clearTimeout(_liveTimer);
        resetCopy();
        inputEl.classList.remove('error');
        /* the untrimmed input goes to the tokenizer, so error lines and columns match the text box */
        var raw = inputEl.value;
        if (!raw.trim()) { clearStatus(); outputCodeEl.textContent = ''; return; }

        inputEl.classList.remove('error');

        var result;
        try {
          var tokens = tokenize(raw);
          var ast = parse(tokens);
          var code = generate(ast);
          result = { code: code, count: ast.decls.length };
        } catch (e) {
          inputEl.classList.add('error');
          outputCodeEl.textContent = '';
          setStatus(MSG_ERROR + e.message, true);
          return;
        }

        inputEl.classList.remove('error');
        outputCodeEl.textContent = result.code;
        outputCodeEl.removeAttribute('data-highlighted');
        outputCodeEl.className = 'language-typescript';
        hljs.highlightElement(outputCodeEl);
        var n = result.count;
        var msg = n === 1 ? MSG_GEN_ONE : MSG_GEN_MANY.replace('{n}', n);
        setStatus(msg, false);
      }

      /* Analytics: one event per committed change (textarea change, Example), not on load or per typing pause.
         The same input is sent once. */
      var lastTracked = null;
      function trackChange() {
        if (!outputCodeEl.textContent || inputEl.value === lastTracked) return;
        lastTracked = inputEl.value;
        window.trackTool && window.trackTool('typescript-to-zod', 'generate');
      }

      /* ── EVENTS ── */

      var _liveTimer = null;
      inputEl.addEventListener('input', function () {
        resetCopy();
        clearTimeout(_liveTimer);
        _liveTimer = setTimeout(convert, 300);
        clearTimeout(_hlInputTimer);
        _hlInputTimer = setTimeout(syncInputHL, 80);
      });
      inputEl.addEventListener('change', function () {
        convert();
        trackChange();
      });

      inputEl.addEventListener('scroll', function () {
        var pre = hlInputCodeEl.parentElement;
        pre.scrollTop = inputEl.scrollTop;
        pre.scrollLeft = inputEl.scrollLeft;
      });

      document.getElementById('ttz-example').addEventListener('click', function () {
        clearTimeout(_hlInputTimer);
        inputEl.value = EXAMPLE;
        inputEl.classList.remove('error');
        clearStatus();
        syncInputHL();
        convert();
        trackChange();
      });

      function clearAll() {
        lastTracked = null;
        clearTimeout(_liveTimer);
        clearTimeout(_hlInputTimer);
        resetCopy();
        inputEl.value = '';
        outputCodeEl.textContent = '';
        hlInputCodeEl.textContent = '';
        inputEl.classList.remove('error');
        clearStatus();
        inputEl.focus();
      }
      document.getElementById('ttz-clear').addEventListener('click', clearAll);
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
          e.preventDefault();
          clearAll();
        }
      });

      copyBtn.addEventListener('click', function () {
        var text = outputCodeEl.textContent;
        if (!text) return;
        resetCopy();
        var revision = copyRevision;
        function failed() {
          if (revision === copyRevision) copyBtn.textContent = COPY_FAILED;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            copyBtn.textContent = COPIED;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = COPY;
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });
    })();
  </script>
</div>

<style>
  .ttz-wrap { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; gap: 0.75rem; }
  .ttz-actions { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .ttz-control-label { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .ttz-panel-header { display: flex; align-items: center; justify-content: space-between; min-height: 44px; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .ttz-input-wrap textarea, .ttz-output { width: 100%; min-width: 0; font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.5; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-secondary); color: var(--color-text); }
  .ttz-input-wrap textarea { flex: 1 1 0; min-height: 0; resize: none; overflow: auto; transition: border-color 0.15s; }
  .ttz-input-wrap textarea:focus { outline: none; border-color: var(--color-primary); }
  .ttz-input-wrap textarea.error { border-color: #c0392b; }
  .ttz-input-wrap {
    position: relative;
    display: flex;
    min-width: 0;
    resize: none;
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
  }

  .ttz-input-wrap textarea {
    position: relative;
    z-index: 1;
    color: transparent;
    background: transparent;
    caret-color: var(--color-text);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .ttz-input-wrap textarea:focus { background: transparent; }

  .ttz-input-hl {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.5;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    pointer-events: none;
    overflow: hidden;
    white-space: pre-wrap;
    word-break: break-word;
    background: transparent;
    z-index: 0;
  }

  .ttz-input-hl code {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    background: none;
    padding: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .ttz-output { margin: 0; overflow: auto; white-space: pre; }
  .ttz-output:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .ttz-empty { display: none; margin: 0; padding: 2rem; align-items: center; justify-content: center; text-align: center; color: var(--color-text-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .ttz-output-pane:has(#ttz-output-code:empty) .ttz-output { display: none; }
  .ttz-output-pane:has(#ttz-output-code:empty) .ttz-empty { display: flex; }
  .ttz-status { font-size: 0.85rem; line-height: 1.4; height: 2.4rem; flex: none; overflow: auto; overflow-wrap: anywhere; }
  .ttz-status.success { color: #057a55; }
  .ttz-status.error { color: #c0392b; }
  @media (max-width: 860px) {
    .ttz-wrap { gap: 0.5rem; }
    .ttz-input-wrap { height: 144px; min-height: 144px; flex: none; }
    .ttz-output { height: 22rem; min-height: 160px; resize: none; }
    .ttz-output-pane:has(#ttz-output-code:empty) { display: none; }
  }
  @media (max-width: 640px) {
    .ttz-actions button, .ttz-panel-header button { min-height: 44px; }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .ttz-status.success { color: #34d399; }
    :global(:root:not([data-theme="light"])) .ttz-status.error { color: #f87171; }
    :global(:root:not([data-theme="light"])) .ttz-input-wrap textarea.error { border-color: #f87171; }
  }
  :global([data-theme="dark"]) .ttz-status.success { color: #34d399; }
  :global([data-theme="dark"]) .ttz-status.error { color: #f87171; }
  :global([data-theme="dark"]) .ttz-input-wrap textarea.error { border-color: #f87171; }
</style>
