const { tips: TIPS, ...CLIENT_T } = T;
---
<div class="mtl-wrap">
  <div class="mtl-tabs zt-segmented" role="tablist">
    <button id="mtl-tab-search" class="mtl-tab is-active" role="tab" aria-selected="true" aria-controls="mtl-panel-search">{T.tabSearch}</button>
    <button id="mtl-tab-sniff" class="mtl-tab" role="tab" aria-selected="false" aria-controls="mtl-panel-sniff">{T.tabSniff}</button>
  </div>

  <section id="mtl-panel-search" class="mtl-panel" role="tabpanel" aria-labelledby="mtl-tab-search">
    <div class="mtl-field-head">
      <label for="mtl-search">{T.searchLabel}</label>
      <Toggletip id="mtl-tip-search" lang={lang} about={T.searchLabel}>{TIPS.search}</Toggletip>
    </div>
    <input id="mtl-search" type="search" class="tool-input mtl-input" placeholder={T.searchPh} autocomplete="off" spellcheck="false" />
    <div class="mtl-group-control">
      <div class="mtl-field-head">
        <span id="mtl-group-label">{T.group}</span>
        <Toggletip id="mtl-tip-group" lang={lang} about={T.group}>{TIPS.group}</Toggletip>
      </div>
      <div id="mtl-chips" class="mtl-chips" role="tablist" aria-labelledby="mtl-group-label"></div>
    </div>
    <div class="mtl-search-status" aria-live="polite">
      <div id="mtl-empty" class="mtl-empty" style="display:none">{T.empty}</div>
    </div>
    <div class="mtl-output-head">
      <span>{T.resultsLabel}</span>
      <Toggletip id="mtl-tip-copy" lang={lang} about={T.copy}>{TIPS.copy}</Toggletip>
    </div>
    <div id="mtl-results" class="mtl-results" tabindex="0" role="region" aria-label={T.resultsLabel}></div>
  </section>

  <section id="mtl-panel-sniff" class="mtl-panel" role="tabpanel" aria-labelledby="mtl-tab-sniff" hidden>
    <div class="mtl-field-head">
      <span>{T.fileLabel}</span>
      <Toggletip id="mtl-tip-file" lang={lang} about={T.fileLabel}>{TIPS.file}</Toggletip>
    </div>
    <div id="mtl-sniff-status" class="tool-status none" aria-live="polite"></div>
    <label class="mtl-drop zt-empty-drop" id="mtl-drop">
      <input type="file" id="mtl-file" class="mtl-file" aria-label={T.fileLabel} />
      <div class="mtl-drop-body">
        <strong>{T.dropTitle}</strong>
        <span>{T.dropHint}</span>
      </div>
    </label>
    <div id="mtl-sniff-result" class="mtl-sniff-result" tabindex="0" role="region" aria-label={T.tabSniff} hidden>
      <div class="tool-result-row">
        <div class="mtl-field-head tool-result-label">
          <span>{T.detectedMime}</span>
          <Toggletip id="mtl-tip-detected" lang={lang} about={T.detectedMime}>{TIPS.detected}</Toggletip>
        </div>
        <span class="tool-result-value" id="mtl-sniff-mime"></span>
        <button class="btn-copy mtl-copy" data-target="mtl-sniff-mime">{T.copy}</button>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">{T.likelyExt}</span>
        <span class="tool-result-value" id="mtl-sniff-ext"></span>
        <button class="btn-copy mtl-copy" data-target="mtl-sniff-ext">{T.copy}</button>
      </div>
      <div class="tool-result-row">
        <div class="mtl-field-head tool-result-label">
          <span>{T.magicBytes}</span>
          <Toggletip id="mtl-tip-bytes" lang={lang} about={T.magicBytes}>{TIPS.bytes}</Toggletip>
        </div>
        <span class="tool-result-value" id="mtl-sniff-bytes"></span>
        <button class="btn-copy mtl-copy" data-target="mtl-sniff-bytes">{T.copy}</button>
      </div>
      <div class="tool-result-row">
        <div class="mtl-field-head tool-result-label">
          <span>{T.browserType}</span>
          <Toggletip id="mtl-tip-browser" lang={lang} about={T.browserType}>{TIPS.browser}</Toggletip>
        </div>
        <span class="tool-result-value" id="mtl-sniff-browser"></span>
      </div>
      <div class="tool-result-row mtl-note-row" id="mtl-sniff-note-row" hidden>
        <span class="tool-result-label">{T.note}</span>
        <span class="tool-result-value" id="mtl-sniff-note"></span>
      </div>
    </div>
  </section>

