---
import Toggletip from '../Toggletip.astro';
// CssFlexboxGeneratorTool — visual Flexbox layout builder
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: {
    direction: 'flex-direction',
    wrap: 'flex-wrap',
    justifyContent: 'justify-content',
    alignItems: 'align-items',
    alignContent: 'align-content',
    gap: 'gap',
    itemCount: 'Items',
    preview: 'Preview',
    outputLabel: 'Generated CSS',
    copy: 'Copy',
    copied: 'Copied!',
    copyFailed: "Copy failed",
    options: "Alignment",
    empty: "Adjust a control to preview the flex layout.",
    tips: {"direction": "Choose row, row-reverse, column or column-reverse. The preview and CSS update immediately.", "wrap": "Choose nowrap, wrap or wrap-reverse to control whether items form additional lines.", "justifyContent": "Choose how items share space along the main axis set by flex-direction. The initial selection is normal.", "alignItems": "Choose the item alignment on the cross axis. The initial selection is normal. This sets the container property, not individual items.", "alignContent": "Choose how wrapped lines align on the cross axis. This property has no effect with nowrap. The initial selection is normal.", "gap": "Enter a CSS gap. One value sets both gaps; two values are row gap then column gap. Empty uses 1rem, and values are copied without validation.", "itemCount": "Set 1–8 preview items. This changes the number of boxes; the exported rule contains container properties only.", "copy": "Copy the complete .container rule with seven declarations. Ctrl/⌘+L clears the gap text, CSS and preview while keeping selects and item count. Retry a failed copy or select the CSS manually."},
  },
  zh: {
    direction: 'flex-direction',
    wrap: 'flex-wrap',
    justifyContent: 'justify-content',
    alignItems: 'align-items',
    alignContent: 'align-content',
    gap: '间距',
    itemCount: '子项数量',
    preview: '预览',
    outputLabel: '生成的 CSS',
    copy: '复制',
    copied: '已复制！',
    copyFailed: "复制失败",
    options: "对齐设置",
    empty: "调整控件即可预览弹性布局。",
    tips: {"direction": "选择 row、row-reverse、column 或 column-reverse，预览和 CSS 会立即更新。", "wrap": "选择 nowrap、wrap 或 wrap-reverse，控制子项是否形成多行。", "justifyContent": "选择子项沿 flex-direction 所定义主轴的空间分配方式。初始选项为 normal。", "alignItems": "选择子项沿交叉轴的对齐方式。初始选项为 normal，设置的是容器属性。", "alignContent": "选择换行后的各行沿交叉轴的对齐方式。nowrap 时不生效。初始选项为 normal。", "gap": "输入 CSS 间距。一个值设置两个方向，两个值依次为行间距、列间距。空值使用 1rem，输入值不经校验。", "itemCount": "设置 1–8 个预览子项。这会改变方框数量；导出的规则只包含容器属性。", "copy": "复制含七条声明的完整 .container 规则。Ctrl/⌘+L 清空间距文本、CSS 和预览，保留下拉选项及子项数量。失败时可重试或手动选中 CSS。"},
  },
  ja: {
    direction: 'flex-direction',
    wrap: 'flex-wrap',
    justifyContent: 'justify-content',
    alignItems: 'align-items',
    alignContent: 'align-content',
    gap: 'ギャップ',
    itemCount: 'アイテム数',
    preview: 'プレビュー',
    outputLabel: '生成された CSS',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyFailed: "コピーに失敗しました",
    options: "配置設定",
    empty: "コントロールを調整するとフレックス配置をプレビューできます。",
    tips: {"direction": "row、row-reverse、column、column-reverse を選択します。プレビューと CSS が即座に更新されます。", "wrap": "nowrap、wrap、wrap-reverse を選び、アイテムが複数行になるか設定します。", "justifyContent": "flex-direction で定まる主軸上のスペース配分を選びます。初期選択は normal です。", "alignItems": "交差軸上のアイテム配置を選びます。初期選択は normal で、コンテナのプロパティを設定します。", "alignContent": "折り返した行の交差軸上の配置を選びます。nowrap では効果がありません。初期選択は normal です。", "gap": "CSS のギャップを入力します。1値は両方向、2値は行間・列間の順です。空欄は1remになり、入力値は検証しません。", "itemCount": "プレビューのアイテム数を1〜8に設定します。ボックス数が変わり、出力はコンテナのプロパティのみです。", "copy": "7宣言の完全な .container ルールをコピーします。Ctrl/⌘+L はギャップ、CSS、プレビューを消去し、選択と個数を保持します。失敗したら再試行するか CSS を選択してください。"},
  },
  ko: {
    direction: 'flex-direction',
    wrap: 'flex-wrap',
    justifyContent: 'justify-content',
    alignItems: 'align-items',
    alignContent: 'align-content',
    gap: '간격',
    itemCount: '아이템 수',
    preview: '미리보기',
    outputLabel: '생성된 CSS',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: "복사 실패",
    options: "정렬 설정",
    empty: "컨트롤을 조정하면 플렉스 배치를 미리 볼 수 있습니다.",
    tips: {"direction": "row, row-reverse, column, column-reverse를 선택하세요. 미리보기와 CSS가 즉시 업데이트됩니다.", "wrap": "nowrap, wrap, wrap-reverse를 선택해 아이템이 여러 줄을 만드는지 설정하세요.", "justifyContent": "flex-direction이 정하는 주축을 따라 공간을 나누는 방식을 선택하세요. 기본값은 normal입니다.", "alignItems": "교차 축에서 아이템을 정렬하는 방식을 선택하세요. 기본값은 normal이며 컨테이너 속성을 설정합니다.", "alignContent": "줄바꿈된 줄을 교차 축에서 정렬하는 방식을 선택하세요. nowrap에서는 효과가 없습니다. 기본값은 normal입니다.", "gap": "CSS 간격을 입력하세요. 한 값은 양방향, 두 값은 행 간격·열 간격 순서입니다. 빈 값은1rem이며 검증하지 않습니다.", "itemCount": "미리보기 아이템 수를1~8로 설정하세요. 상자 수가 바뀌며 출력 규칙은 컨테이너 속성만 포함합니다.", "copy": "일곱 선언의 전체 .container 규칙을 복사하세요. Ctrl/⌘+L은 간격, CSS, 미리보기를 지우고 선택과 수는 유지합니다. 실패하면 다시 시도하거나 CSS를 선택하세요."},
  },
};

// strings:end
const L = STRINGS[lang] ?? STRINGS.en;
---

<div
  class="cfg-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
>
  <div class="cfg-body">
    <div class="cfg-rail zt-rail">
      <div class="cfg-controls">
<div class="cfg-field">
      <div class="cfg-field-header"><label class="cfg-label" for="cfg-direction">{L.direction}</label><Toggletip id="cfg-tip-direction" lang={lang} about={L.direction}>{L.tips.direction}</Toggletip></div>
      <select id="cfg-direction" class="cfg-select">
        <option value="row" selected>row</option>
        <option value="row-reverse">row-reverse</option>
        <option value="column">column</option>
        <option value="column-reverse">column-reverse</option>
      </select>
    </div>
<div class="cfg-field">
      <div class="cfg-field-header"><label class="cfg-label" for="cfg-wrap">{L.wrap}</label><Toggletip id="cfg-tip-wrap" lang={lang} about={L.wrap}>{L.tips.wrap}</Toggletip></div>
      <select id="cfg-wrap" class="cfg-select">
        <option value="nowrap" selected>nowrap</option>
        <option value="wrap">wrap</option>
        <option value="wrap-reverse">wrap-reverse</option>
      </select>
    </div>
<div class="cfg-field">
      <div class="cfg-field-header"><label class="cfg-label" for="cfg-gap">{L.gap}</label><Toggletip id="cfg-tip-gap" lang={lang} about={L.gap}>{L.tips.gap}</Toggletip></div>
      <input id="cfg-gap" class="cfg-text-input" type="text" value="1rem" spellcheck="false" autocomplete="off" />
    </div>
<div class="cfg-field">
      <div class="cfg-field-header"><label class="cfg-label" for="cfg-items">{L.itemCount}</label><Toggletip id="cfg-tip-itemCount" lang={lang} about={L.itemCount}>{L.tips.itemCount}</Toggletip></div>
      <input id="cfg-items" class="cfg-num-input" type="number" min="1" max="8" value="4" />
    </div>
      </div>
      <details class="cfg-options"><summary>{L.options}</summary><div class="cfg-secondary"><div class="cfg-field">
      <div class="cfg-field-header"><label class="cfg-label" for="cfg-justify">{L.justifyContent}</label><Toggletip id="cfg-tip-justifyContent" lang={lang} about={L.justifyContent}>{L.tips.justifyContent}</Toggletip></div>
      <select id="cfg-justify" class="cfg-select">
        <option value="normal" selected>normal</option>
        <option value="flex-start">flex-start</option>
        <option value="flex-end">flex-end</option>
        <option value="center">center</option>
        <option value="space-between">space-between</option>
        <option value="space-around">space-around</option>
        <option value="space-evenly">space-evenly</option>
      </select>
    </div><div class="cfg-field">
      <div class="cfg-field-header"><label class="cfg-label" for="cfg-align-items">{L.alignItems}</label><Toggletip id="cfg-tip-alignItems" lang={lang} about={L.alignItems}>{L.tips.alignItems}</Toggletip></div>
      <select id="cfg-align-items" class="cfg-select">
        <option value="normal" selected>normal</option>
        <option value="flex-start">flex-start</option>
        <option value="flex-end">flex-end</option>
        <option value="center">center</option>
        <option value="stretch">stretch</option>
        <option value="baseline">baseline</option>
      </select>
    </div><div class="cfg-field">
      <div class="cfg-field-header"><label class="cfg-label" for="cfg-align-content">{L.alignContent}</label><Toggletip id="cfg-tip-alignContent" lang={lang} about={L.alignContent}>{L.tips.alignContent}</Toggletip></div>
      <select id="cfg-align-content" class="cfg-select">
        <option value="normal" selected>normal</option>
        <option value="flex-start">flex-start</option>
        <option value="flex-end">flex-end</option>
        <option value="center">center</option>
        <option value="stretch">stretch</option>
        <option value="space-between">space-between</option>
        <option value="space-around">space-around</option>
      </select>
    </div></div></details>
      <div class="cfg-section">
        <div class="cfg-output-header"><div class="cfg-output-label"><span class="cfg-section-label">{L.outputLabel}</span><Toggletip id="cfg-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip></div><button id="cfg-copy" class="btn-copy" type="button">{L.copy}</button></div>
        <p id="cfg-status" class="tool-status" role="status"></p>
        <pre id="cfg-pre" class="cfg-pre" tabindex="0" role="region" aria-label={L.outputLabel}><code id="cfg-code" class="cfg-code"></code></pre>
      </div>
    </div>
    <div id="cfg-result" class="cfg-section cfg-result" data-empty="false"><span class="cfg-section-label">{L.preview}</span><p id="cfg-empty" class="cfg-empty" hidden>{L.empty}</p><div id="cfg-preview" class="cfg-preview"></div></div>
  </div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.cfg-wrap')
        : document.querySelector('.cfg-wrap');

      var COPY_LABEL   = wrap.dataset.copy;
      var COPY_FAILED_LABEL = wrap.dataset.copyFailed;
      var COPIED_LABEL = wrap.dataset.copied;

      var dirEl     = document.getElementById('cfg-direction');
      var wrapEl    = document.getElementById('cfg-wrap');
      var justEl    = document.getElementById('cfg-justify');
      var aItemsEl  = document.getElementById('cfg-align-items');
      var aContEl   = document.getElementById('cfg-align-content');
      var gapEl     = document.getElementById('cfg-gap');
      var itemsEl   = document.getElementById('cfg-items');
      var previewEl = document.getElementById('cfg-preview');
      var codeEl    = document.getElementById('cfg-code');
      var copyBtn   = document.getElementById('cfg-copy');
      var statusEl = document.getElementById('cfg-status');
      var resultEl = document.getElementById('cfg-result');
      var emptyEl = document.getElementById('cfg-empty');

      var CELL_COLORS = [
        '#bfdbfe','#bbf7d0','#fde68a','#fecaca',
        '#ddd6fe','#fed7aa','#a7f3d0','#e9d5ff',
      ];

      /* ── engine:start ── */
      // The gap field is free text; escape every value before wrapping it in highlight spans
      // (the old regex highlighter put it into innerHTML as written).
      function escHtml(v) {
        return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
      function highlightCss(decls) {
        return '<span class="cfg-hl-sel">.container</span> <span class="cfg-hl-brace">{</span>\n' +
          decls.map(function (d) {
            return '  <span class="cfg-hl-prop">' + escHtml(d[0]) + '</span>: <span class="cfg-hl-val">' + escHtml(d[1]) +
              '</span><span class="cfg-hl-semi">;</span>';
          }).join('\n') +
          '\n<span class="cfg-hl-brace">}</span>';
      }
      /* ── engine:end ── */

      function update() {
        var dir        = dirEl.value;
        var flexWrap   = wrapEl.value;
        var justify    = justEl.value;
        var alignItems = aItemsEl.value;
        var alignCont  = aContEl.value;
        var gap        = gapEl.value.trim() || '1rem';
        var count      = Math.max(1, Math.min(8, parseInt(itemsEl.value) || 4));

        /* Update preview */
        previewEl.style.display        = 'flex';
        previewEl.style.flexDirection  = dir;
        previewEl.style.flexWrap       = flexWrap;
        previewEl.style.justifyContent = justify;
        previewEl.style.alignItems     = alignItems;
        previewEl.style.alignContent   = alignCont;
        previewEl.style.gap            = gap;

        /* Rebuild children */
        var existing = previewEl.querySelectorAll('.cfg-cell');
        while (existing.length > count) {
          previewEl.removeChild(previewEl.lastChild);
          existing = previewEl.querySelectorAll('.cfg-cell');
        }
        while (existing.length < count) {
          var cell = document.createElement('div');
          cell.className = 'cfg-cell';
          cell.style.background = CELL_COLORS[existing.length % CELL_COLORS.length];
          cell.textContent = existing.length + 1;
          previewEl.appendChild(cell);
          existing = previewEl.querySelectorAll('.cfg-cell');
        }

        /* Build CSS */
        codeEl.innerHTML = highlightCss([
          ['display', 'flex'],
          ['flex-direction', dir],
          ['flex-wrap', flexWrap],
          ['justify-content', justify],
          ['align-items', alignItems],
          ['align-content', alignCont],
          ['gap', gap],
        ]);

        window.trackTool && window.trackTool('css-flexbox-generator', 'generate');
      }

      var copyRequest = 0;
      var copyTimer = 0;
      function resetCopyFeedback() {
        copyRequest++;
        if (copyTimer) clearTimeout(copyTimer);
        copyTimer = 0;
        copyBtn.textContent = COPY_LABEL;
        copyBtn.classList.remove('copied');
        statusEl.textContent = '';
      }
      function refresh(event) {
        resetCopyFeedback();
        update();
        copyBtn.disabled = !codeEl.textContent;
        resultEl.dataset.empty = 'false';
        emptyEl.hidden = true;
        previewEl.hidden = false;
        if (event && window.matchMedia('(max-width: 640px)').matches) resultEl.scrollIntoView({ block: 'nearest' });
      }
      document.addEventListener('keydown', function (event) {
        if (!(event.ctrlKey || event.metaKey) || event.key.toLowerCase() !== 'l' || !wrap.contains(document.activeElement)) return;
        event.preventDefault();
        resetCopyFeedback();
        wrap.querySelectorAll('input[type="text"]').forEach(function (el) { el.value = ''; });
        codeEl.innerHTML = '';
        copyBtn.disabled = true;
        resultEl.dataset.empty = 'true';
        emptyEl.hidden = false;
        previewEl.hidden = true;
        previewEl.innerHTML = '';
        previewEl.style.display = '';
        previewEl.style.flexDirection = '';
        previewEl.style.flexWrap = '';
        previewEl.style.justifyContent = '';
        previewEl.style.alignItems = '';
        previewEl.style.alignContent = '';
        previewEl.style.gap = '';
      });


      [dirEl, wrapEl, justEl, aItemsEl, aContEl].forEach(function (el) {
        el.addEventListener('change', refresh);
      });
      gapEl.addEventListener('input', refresh);
      itemsEl.addEventListener('input', refresh);

      copyBtn.addEventListener('click', async function () {
        var text = codeEl.textContent;
        if (!text) return;
        resetCopyFeedback();
        var request = copyRequest;
        try {
          await navigator.clipboard.writeText(text);
          if (request !== copyRequest) return;
          copyBtn.textContent = COPIED_LABEL;
          copyTimer = setTimeout(function () {
            if (request !== copyRequest) return;
            copyTimer = 0;
            copyBtn.textContent = COPY_LABEL;
          }, 1500);
          window.trackTool && window.trackTool('css-flexbox-generator', 'copy');
        } catch (_) {
          if (request !== copyRequest) return;
          copyBtn.textContent = COPY_FAILED_LABEL;
          statusEl.textContent = COPY_FAILED_LABEL;
        }
      });

      refresh();
    })();
  </script>
</div>

<style>
  .cfg-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .cfg-body { display: grid; grid-template-columns: clamp(270px, 24vw, 320px) minmax(0, 1fr); gap: 1.5rem; flex: 1 1 0; min-height: 0; }
  .cfg-rail { overflow: auto; padding-right: 0.3rem; }
  .cfg-field-header, .cfg-output-label { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
  .cfg-field-header label { flex: 1; min-width: 0; }
  .cfg-options summary { cursor: pointer; padding: 0.5rem 0; min-height: 44px; font-size: 0.85rem; font-weight: 600; }
  .cfg-secondary { display: grid; gap: 0.5rem; }
  #cfg-copy { min-width: 0; height: 44px; white-space: normal; line-height: 1.2; }
  #cfg-status { height: 2.8em; flex: none; margin: 0; overflow: auto; }
  .cfg-result { min-width: 0; min-height: 0; }
  .cfg-empty { color: var(--color-text-muted); font-size: 0.9rem; }
  .cfg-preview[hidden], .cfg-empty[hidden] { display: none; }
  .cfg-wrap :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }

  .cfg-controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .cfg-field { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }

  .cfg-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
  }

  .cfg-select,
  .cfg-text-input,
  .cfg-num-input {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    width: 100%;
    box-sizing: border-box;
  }

  .cfg-select:focus,
  .cfg-text-input:focus,
  .cfg-num-input:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .cfg-section { display: flex; flex-direction: column; gap: 0.4rem; }

  .cfg-section-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .cfg-output-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.5rem;
    align-items: center;
  }

  /* Preview */
  .cfg-preview {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    background: var(--color-bg-secondary);
    flex: 1 1 0;
    min-height: 220px;
    overflow: auto;
  }

  .cfg-wrap :global(.cfg-cell) {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    min-width: 60px;
    min-height: 60px;
    padding: 0.3rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #374151;
  }

  /* Code output */
  .cfg-pre {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    overflow: auto;
    max-height: 10rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .cfg-code { font-family: inherit; }

  .cfg-wrap :global(.cfg-hl-sel)   { color: #7c3aed; font-weight: 600; }
  .cfg-wrap :global(.cfg-hl-brace) { color: var(--color-text-secondary); }
  .cfg-wrap :global(.cfg-hl-prop)  { color: #0369a1; }
  .cfg-wrap :global(.cfg-hl-val)   { color: #057a55; }
  .cfg-wrap :global(.cfg-hl-semi)  { color: var(--color-text-secondary); }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .cfg-wrap :global(.cfg-hl-sel)  { color: #a78bfa; }
    :global(:root:not([data-theme="light"])) .cfg-wrap :global(.cfg-hl-prop) { color: #38bdf8; }
    :global(:root:not([data-theme="light"])) .cfg-wrap :global(.cfg-hl-val)  { color: #34d399; }
  }
  :global([data-theme="dark"]) .cfg-wrap :global(.cfg-hl-sel)  { color: #a78bfa; }
  :global([data-theme="dark"]) .cfg-wrap :global(.cfg-hl-prop) { color: #38bdf8; }
  :global([data-theme="dark"]) .cfg-wrap :global(.cfg-hl-val)  { color: #34d399; }

  @media (max-width: 860px) {
    .cfg-body { display: flex; flex-direction: column; flex: none; gap: 0.5rem; }
    .cfg-rail { overflow: visible; padding-right: 0; gap: 0.5rem; }
    .cfg-preview { height: 180px; min-height: 0; flex: none; }
    .cfg-result[data-empty="true"] { display: none; }
    .cfg-pre { height: 5rem; max-height: 5rem; }
  }
  @media (max-width: 640px) {
