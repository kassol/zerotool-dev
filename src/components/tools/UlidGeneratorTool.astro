---
import Toggletip from '../Toggletip.astro';
// UlidGeneratorTool — ULID generator and decoder (Crockford Base32, no deps)
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const labels = {
  en: {
    copyFailed: 'Copy failed. Try again.',
    generate: 'Generate',
    batchLabel: 'Batch Count',
    copy: 'Copy',
    copied: 'Copied!',
    copyAll: 'Copy All',
    copyAllDone: 'Copied!',
    clear: 'Clear',
    colUlid: 'ULID',
    colTimestamp: 'Timestamp (UTC)',
    colRandom: 'Random Component',
    decoderLabel: 'ULID Decoder',
    decoderPlaceholder: 'Paste a ULID to decode…',
    decodedTimestamp: 'Timestamp',
    decodedMs: 'Milliseconds (epoch)',
    invalidUlid: 'Invalid ULID',
    outOfRange: 'Out of range: the first character must be 0–7 (the largest ULID is 7ZZZZZZZZZZZZZZZZZZZZZZZZZ)',
    overflow: 'The random part overflowed within one millisecond. Wait a moment and generate again.',
  },
  zh: {
    copyFailed: '复制失败，请重试。',
    generate: '生成',
    batchLabel: '批量数量',
    copy: '复制',
    copied: '已复制！',
    copyAll: '复制全部',
    copyAllDone: '已复制！',
    clear: '清空',
    colUlid: 'ULID',
    colTimestamp: '时间戳（UTC）',
    colRandom: '随机部分',
    decoderLabel: 'ULID 解码器',
    decoderPlaceholder: '粘贴 ULID 进行解码…',
    decodedTimestamp: '时间戳',
    decodedMs: '毫秒（epoch）',
    invalidUlid: '无效的 ULID',
    outOfRange: '超出范围：第一个字符必须是 0–7（最大的 ULID 是 7ZZZZZZZZZZZZZZZZZZZZZZZZZ）',
    overflow: '同一毫秒内随机部分已溢出，请稍后再生成。',
  },
  ja: {
    copyFailed: 'コピーに失敗しました。再試行してください。',
    generate: '生成',
    batchLabel: 'バッチ数',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyAll: 'すべてコピー',
    copyAllDone: 'コピーしました！',
    clear: 'クリア',
    colUlid: 'ULID',
    colTimestamp: 'タイムスタンプ（UTC）',
    colRandom: 'ランダム部分',
    decoderLabel: 'ULIDデコーダー',
    decoderPlaceholder: 'デコードするULIDを貼り付け…',
    decodedTimestamp: 'タイムスタンプ',
    decodedMs: 'ミリ秒（epoch）',
    invalidUlid: '無効なULID',
    outOfRange: '範囲外です：先頭の文字は 0〜7 でなければなりません（最大の ULID は 7ZZZZZZZZZZZZZZZZZZZZZZZZZ）',
    overflow: '同じミリ秒内でランダム部分が桁あふれしました。少し待ってから生成してください。',
  },
  ko: {
    copyFailed: '복사하지 못했습니다. 다시 시도하세요.',
    generate: '생성',
    batchLabel: '일괄 수',
    copy: '복사',
    copied: '복사됨!',
    copyAll: '모두 복사',
    copyAllDone: '복사됨!',
    clear: '지우기',
    colUlid: 'ULID',
    colTimestamp: '타임스탬프 (UTC)',
    colRandom: '랜덤 컴포넌트',
    decoderLabel: 'ULID 디코더',
    decoderPlaceholder: 'ULID를 붙여넣어 디코딩…',
    decodedTimestamp: '타임스탬프',
    decodedMs: '밀리초 (epoch)',
    invalidUlid: '유효하지 않은 ULID',
    outOfRange: '범위를 벗어났습니다: 첫 글자는 0–7이어야 합니다(가장 큰 ULID는 7ZZZZZZZZZZZZZZZZZZZZZZZZZ)',
    overflow: '같은 밀리초 안에서 무작위 부분이 넘쳤습니다. 잠시 후 다시 생성하세요.',
  },
};

// strings:start
const STRINGS = {
  "en": {
    "empty": "Generate ULIDs or decode one to view its timestamp.",
    "tips": {
      "generate": "Generate creates a new list with the selected count. Existing decoder input and its result remain unchanged.",
      "count": "Generate reads Batch Count when clicked and keeps it between 1 and 100; an empty value uses 1.",
      "copy": "Copy All copies the complete list with one ULID per line. Each row also has its own Copy button.",
      "clear": "Clear removes only the generated list and its copy feedback. Ctrl or Command + L also clears the decoder.",
      "decode": "Paste a 26-character ULID to decode automatically. Lowercase is accepted; the first character must be 0–7. The result shows UTC and epoch milliseconds."
    }
  },
  "zh": {
    "empty": "生成 ULID 或解码一个 ULID 后，这里显示结果。",
    "tips": {
      "generate": "生成按所选数量建立新列表，保留解码器输入和结果。",
      "count": "点击生成时读取批量数量，范围为 1–100，留空时使用 1。",
      "copy": "复制全部把完整列表按每行一个 ULID 复制；每一行也有独立复制按钮。",
      "clear": "清空只移除生成列表及其复制反馈。Ctrl 或 Command + L 还会清除解码器。",
      "decode": "粘贴 26 个字符的 ULID 自动解码，接受小写，首字符必须为 0–7。结果显示 UTC 时间与 epoch 毫秒。"
    }
  },
  "ja": {
    "empty": "ULID を生成するか、デコードすると結果を表示します。",
    "tips": {
      "generate": "生成は選択した数で新しいリストを作ります。デコーダーの入力と結果は保持します。",
      "count": "生成を押すとバッチ数を読み、1〜100 に収めます。空欄は 1 として扱います。",
      "copy": "すべてコピーはリスト全体を 1 行 1 ULID でコピーします。各行のコピーも使えます。",
      "clear": "クリアは生成リストとコピー表示だけを消します。Ctrl または Command + L はデコーダーも消します。",
      "decode": "26 文字の ULID を貼ると自動デコードします。小文字も使えますが、先頭は 0〜7 が必要です。結果は UTC と epoch ミリ秒です。"
    }
  },
  "ko": {
    "empty": "ULID를 생성하거나 하나를 디코딩하면 결과가 표시됩니다.",
    "tips": {
      "generate": "생성은 선택한 개수로 새 목록을 만듭니다. 디코더 입력과 결과는 유지됩니다.",
      "count": "생성을 누를 때 일괄 수를 읽고 1–100 범위로 제한합니다. 빈 값은 1을 사용합니다.",
      "copy": "모두 복사는 전체 목록을 한 줄에 ULID 하나씩 복사합니다. 각 행의 복사 버튼도 사용할 수 있습니다.",
      "clear": "지우기는 생성 목록과 복사 피드백만 지웁니다. Ctrl 또는 Command + L은 디코더도 지웁니다.",
      "decode": "26자 ULID를 붙여넣으면 자동 디코딩됩니다. 소문자도 허용하며 첫 글자는 0–7이어야 합니다. 결과는 UTC와 epoch 밀리초입니다."
    }
  }
};
// strings:end
const U = STRINGS[lang];

const L = labels[lang] ?? labels['en'];
---

<div
  class="ulid-wrap"
  data-copy={L.copy}
  data-copy-failed={L.copyFailed}
  data-copied={L.copied}
  data-copy-all={L.copyAll}
  data-copy-all-done={L.copyAllDone}
  data-col-ulid={L.colUlid}
  data-col-ts={L.colTimestamp}
  data-col-rand={L.colRandom}
  data-decoded-ts={L.decodedTimestamp}
  data-decoded-ms={L.decodedMs}
  data-invalid={L.invalidUlid}
  data-out-of-range={L.outOfRange}
  data-overflow={L.overflow}
>
  <div class="ulid-main">
    <aside class="ulid-rail zt-rail">
      <div class="ulid-controls">
        <div class="ulid-batch-row">
          <div class="ulid-label-row"><label class="ulid-label" for="ulid-count">{L.batchLabel}</label><Toggletip id="ulid-tip-count" lang={lang} about={L.batchLabel}>{U.tips.count}</Toggletip></div>
          <input id="ulid-count" class="ulid-count-input" type="number" min="1" max="100" value="1" />
        </div>
    <div class="ulid-btn-row">
      <button id="ulid-generate" class="btn-primary" type="button">{L.generate}</button><Toggletip id="ulid-tip-generate" lang={lang} about={L.generate}>{U.tips.generate}</Toggletip>
      <button id="ulid-copy-all" class="btn-copy" type="button" disabled>{L.copyAll}</button><Toggletip id="ulid-tip-copy" lang={lang} about={L.copyAll}>{U.tips.copy}</Toggletip>
      <button id="ulid-clear" class="btn-ghost" type="button" disabled>{L.clear}</button><Toggletip id="ulid-tip-clear" lang={lang} about={L.clear}>{U.tips.clear}</Toggletip>
    </div>
      </div>
      <div class="ulid-status" aria-live="polite"><p id="ulid-gen-error" class="ulid-decode-error" role="alert" hidden></p></div>
      <div class="ulid-decoder-section">
        <div class="ulid-label-row"><label class="ulid-label" for="ulid-decode-input">{L.decoderLabel}</label><Toggletip id="ulid-tip-decode" lang={lang} about={L.decoderLabel}>{U.tips.decode}</Toggletip></div>
    <input
      id="ulid-decode-input"
      class="ulid-decode-input"
      type="text"
      placeholder={L.decoderPlaceholder}
      spellcheck="false"
      autocomplete="off"
      maxlength="26"
    />
      </div>
    </aside>
    <div class="ulid-result-pane">
      <p class="ulid-empty">{U.empty}</p>
  <div id="ulid-results" class="ulid-results" style="display:none;">
    <table class="ulid-table">
      <thead>
        <tr>
          <th class="ulid-th-ulid">{L.colUlid}</th>
          <th class="ulid-th-ts">{L.colTimestamp}</th>
          <th class="ulid-th-rand">{L.colRandom}</th>
          <th class="ulid-th-act"></th>
        </tr>
      </thead>
      <tbody id="ulid-tbody"></tbody>
    </table>
  </div>
    <div id="ulid-decode-result" class="ulid-decode-result" style="display:none;"></div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.ulid-wrap')
        : document.querySelector('.ulid-wrap');

      var COPY_LABEL     = wrap.dataset.copy;
      var COPIED_LABEL   = wrap.dataset.copied;
      var COPY_ALL_LABEL = wrap.dataset.copyAll;
      var COPY_ALL_DONE  = wrap.dataset.copyAllDone;
      var COPY_FAILED    = wrap.dataset.copyFailed;
      var INVALID_LABEL  = wrap.dataset.invalid;
      var LABEL_TS       = wrap.dataset.decodedTs;
      var LABEL_MS       = wrap.dataset.decodedMs;
      var OUT_OF_RANGE_LABEL = wrap.dataset.outOfRange;
      var OVERFLOW_LABEL = wrap.dataset.overflow;
      var genError   = document.getElementById('ulid-gen-error');

      var countEl    = document.getElementById('ulid-count');
      var genBtn     = document.getElementById('ulid-generate');
      var copyAllBtn = document.getElementById('ulid-copy-all');
      var clearBtn   = document.getElementById('ulid-clear');
      var resultsEl  = document.getElementById('ulid-results');
      var tbodyEl    = document.getElementById('ulid-tbody');
      var decodeInput = document.getElementById('ulid-decode-input');
      var decodeResult = document.getElementById('ulid-decode-result');

      /* ── engine:start ── */
      /* ── Crockford Base32 ── */
      var ENCODING = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';

      function encodeBase32(n, len) {
        var s = '';
        for (var i = 0; i < len; i++) {
          s = ENCODING[n & 31] + s;
          n = Math.floor(n / 32);
        }
        return s;
      }

      function encodeTime(ms) {
        /* 48-bit timestamp → 10 chars */
        var hi = Math.floor(ms / 0x100000000);
        var lo = ms >>> 0;
        var s = '';
        /* Build 10 groups of 5 bits from the 48-bit value */
        var chars = [];
        for (var i = 0; i < 10; i++) {
          /* shift 5 bits out from the right of the 48-bit number */
          var shift = (9 - i) * 5;
          var idx;
          if (shift >= 32) {
            idx = (hi >>> (shift - 32)) & 31;
          } else if (shift >= 0) {
            if (shift > 0) {
              idx = ((lo >>> shift) | (hi << (32 - shift))) & 31;
            } else {
              idx = lo & 31;
            }
          }
          s += ENCODING[idx];
        }
        return s;
      }

      function encodeRandom(bytes) {
        /* 10 bytes (80 bits) → 16 chars */
        /* Treat as 80-bit big-endian integer, encode 5 bits at a time */
        var s = '';
        /* Simple: loop through 16 5-bit groups from 80 bits */
        for (var i = 0; i < 16; i++) {
          var byteIdx = Math.floor((i * 5) / 8);
          var bitOff  = (i * 5) % 8;
          var b0 = bytes[byteIdx] || 0;
          var b1 = bytes[byteIdx + 1] || 0;
          /* Extract 5 bits starting at bitOff across b0 and b1 */
          var combined = (b0 << 8) | b1;
          var val = (combined >>> (11 - bitOff)) & 31;
          s += ENCODING[val];
        }
        return s;
      }

      /* Random part + 1 with carry (ULID spec, Monotonicity); null when it overflows */
      function incrementBase32(str) {
        var chars = str.split('');
        for (var i = chars.length - 1; i >= 0; i--) {
          var idx = ENCODING.indexOf(chars[i]);
          if (idx < 31) {
            chars[i] = ENCODING[idx + 1];
            return chars.join('');
          }
          chars[i] = '0';
        }
        return null;
      }

      /* Monotonic generator (ULID spec, Monotonicity; same as ulid/javascript monotonicFactory):
         within the same millisecond, or when the clock goes back, the previous timestamp is
         kept and the random part is incremented by 1. Throws when the random part overflows. */
      function createUlidFactory(now, fillRandom) {
        var lastMs = -1;
        var lastRand = '';
        return function next() {
          var ms = now();
          var randStr;
          if (ms <= lastMs) {
            ms = lastMs;
            randStr = incrementBase32(lastRand);
            if (randStr === null) throw new Error('ULID random component overflow');
          } else {
            var randBytes = new Uint8Array(10);
            fillRandom(randBytes);
            randStr = encodeRandom(randBytes);
          }
          lastMs = ms;
          lastRand = randStr;
          return { ulid: encodeTime(ms) + randStr, ms: ms, randStr: randStr };
        };
      }

      /* ── Decode ── { ms } or { error: 'invalid' | 'range' }
         The largest ULID is 7ZZZZZZZZZZZZZZZZZZZZZZZZZ (128 bits); a first character above
         7 needs 130 bits and is rejected (ULID spec, Overflow Errors when Parsing). */
      function decodeUlid(str) {
        var s = String(str).toUpperCase();
        if (!/^[0-9A-HJKMNP-TV-Z]{26}$/.test(s)) return { error: 'invalid' };
        if (ENCODING.indexOf(s[0]) > 7) return { error: 'range' };
        var ms = 0;
        for (var i = 0; i < 10; i++) ms = ms * 32 + ENCODING.indexOf(s[i]);
        return { ms: ms };
      }

      /* ── Format timestamp ── years after 9999 are written +YYYYYY by toISOString, so
         replace T and Z instead of cutting at a fixed length */
      function formatMs(ms) {
        try {
          return new Date(ms).toISOString().replace('T', ' ').replace('Z', ' UTC');
        } catch (e) {
          return String(ms);
        }
      }
      /* ── engine:end ── */

      var generateUlid = createUlidFactory(Date.now, function (a) { crypto.getRandomValues(a); });


      var copyStates = new Map();
      function resetCopy(btn, label) {
        var previous = copyStates.get(btn);
        if (previous) clearTimeout(previous.timer);
        var state = { timer: null };
        copyStates.set(btn, state);
        btn.textContent = label;
        return state;
      }
      function copyText(btn, text, label, copied, delay, action) {
        if (!text || btn.disabled) return;
        var state = resetCopy(btn, label);
        function current() { return copyStates.get(btn) === state; }
        function failed() { if (current()) btn.textContent = COPY_FAILED; }
        try {
          if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') { failed(); return; }
          Promise.resolve(navigator.clipboard.writeText(text)).then(function () {
            if (!current()) return;
            btn.textContent = copied;
            state.timer = setTimeout(function () { if (current()) btn.textContent = label; }, delay);
            if (action) window.trackTool && window.trackTool('ulid-generator', action);
          }, failed);
        } catch (e) { failed(); }
      }
      function resetCopies() {
        copyStates.forEach(function (state, btn) {
          clearTimeout(state.timer);
          btn.textContent = btn === copyAllBtn ? COPY_ALL_LABEL : COPY_LABEL;
        });
        copyStates.clear();
        copyAllBtn.textContent = COPY_ALL_LABEL;
      }

      /* ── Render row ── */
      function buildRow(item) {
        var tr = document.createElement('tr');
        tr.className = 'ulid-row';

        var tdUlid = document.createElement('td');
        tdUlid.className = 'ulid-td ulid-td-ulid';
        tdUlid.textContent = item.ulid;
        tr.appendChild(tdUlid);

        var tdTs = document.createElement('td');
        tdTs.className = 'ulid-td ulid-td-ts';
        tdTs.textContent = formatMs(item.ms);
        tr.appendChild(tdTs);

        var tdRand = document.createElement('td');
        tdRand.className = 'ulid-td ulid-td-rand';
        tdRand.textContent = item.randStr;
        tr.appendChild(tdRand);

        var tdAct = document.createElement('td');
        tdAct.className = 'ulid-td ulid-td-act';
        var copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'ulid-copy-btn btn-ghost';
        copyBtn.textContent = COPY_LABEL;
        copyBtn.addEventListener('click', function () {
          copyText(copyBtn, item.ulid, COPY_LABEL, COPIED_LABEL, 1200, 'copy_single');
        });
        tdAct.appendChild(copyBtn);
        tr.appendChild(tdAct);

        return tr;
      }

      /* ── Store generated ULIDs ── */
      var generated = [];

      /* ── Generate ── */
      genBtn.addEventListener('click', function () {
        resetCopies();
        var count = Math.max(1, Math.min(100, parseInt(countEl.value) || 1));
        var newItems = [];
        genError.hidden = true;
        for (var i = 0; i < count; i++) {
          try {
            newItems.push(generateUlid());
          } catch (e) {
            genError.textContent = OVERFLOW_LABEL;
            genError.hidden = false;
            break;
          }
        }
        generated = newItems;
        tbodyEl.innerHTML = '';
        generated.forEach(function (item) {
          tbodyEl.appendChild(buildRow(item));
        });
        resultsEl.style.display = '';
        copyAllBtn.disabled = false;
        clearBtn.disabled = false;
        window.trackTool && window.trackTool('ulid-generator', 'generate');
      });

      /* ── Copy All ── */
      copyAllBtn.addEventListener('click', function () {
        var text = generated.map(function (item) { return item.ulid; }).join('\n');
        copyText(copyAllBtn, text, COPY_ALL_LABEL, COPY_ALL_DONE, 1500, 'copy_all');
      });

      /* ── Clear ── */
      function clearResults() {
        resetCopies();
        generated = [];
        tbodyEl.innerHTML = '';
        resultsEl.style.display = 'none';
        copyAllBtn.disabled = true;
        clearBtn.disabled = true;
      }
      clearBtn.addEventListener('click', clearResults);

      /* ── Decoder ── */
      decodeInput.addEventListener('input', function () {
        var val = decodeInput.value.trim().toUpperCase();
        decodeResult.innerHTML = '';
        if (!val) { decodeResult.style.display = 'none'; return; }
        decodeResult.style.display = '';
        var decoded = decodeUlid(val);
        if (decoded.error) {
          var err = document.createElement('span');
          err.className = 'ulid-decode-error';
          err.textContent = decoded.error === 'range' ? OUT_OF_RANGE_LABEL : INVALID_LABEL;
          decodeResult.appendChild(err);
          return;
        }
        var ms = decoded.ms;
        var rows = [
          [LABEL_TS, formatMs(ms)],
          [LABEL_MS, String(ms)],
        ];
        var table = document.createElement('table');
        table.className = 'ulid-decode-table';
        rows.forEach(function (r) {
          var tr = document.createElement('tr');
          var th = document.createElement('th');
          th.textContent = r[0];
          var td = document.createElement('td');
          td.textContent = r[1];
          tr.appendChild(th);
          tr.appendChild(td);
          table.appendChild(tr);
        });
        decodeResult.appendChild(table);
        window.trackTool && window.trackTool('ulid-generator', 'decode');
      });
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l') return;
        var tool = document.querySelector('.ulid-wrap');
        if (!tool || !tool.contains(document.activeElement)) return;
        clearResults();
        genError.hidden = true;
        genError.textContent = '';
        decodeInput.value = '';
        decodeResult.innerHTML = '';
        decodeResult.style.display = 'none';
      });
    })();
  </script>
</div>

<style>
  .ulid-wrap { display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; min-height: 0; }

  /* ── Controls ── */
  .ulid-controls { display: flex; gap: 0.75rem; align-items: flex-end; flex-wrap: wrap; }

  .ulid-batch-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ulid-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .ulid-count-input {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    width: 72px;
    text-align: center;
  }

  .ulid-count-input:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .ulid-btn-row { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }

  /* ── Results table ── */
  .ulid-results {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .ulid-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }

  .ulid-table thead tr {
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .ulid-table th {
    padding: 0.45rem 0.75rem;
    text-align: left;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
