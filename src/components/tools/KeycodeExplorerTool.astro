---
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
// strings:start
const STRINGS = {
  en: {
    prompt: 'Click here, then press any key',
    countLabel: 'keys captured',
    eventProps: 'Event properties',
    modifiers: 'Modifier keys',
    snippet: 'Ready-to-copy JS snippet',
    recentKeys: 'Recent keys',
    deprecated: '(deprecated)',
    copy: 'Copy',
    copied: 'Snippet copied to clipboard.',
    copyFailed: 'Copy failed.',
    clear: 'Clear',
    padFocused: 'Pad focused. Press any key.',
    padBlurred: 'Pad blurred. Click the pad to resume capture.',
    mobileNote:
      'Physical keyboard events differ on mobile. Use a desktop browser for full signal, or type a character below: on-screen keyboards report only the typed text, so code, keyCode, which and charCode stay empty.',
    mobileInputLabel: 'Character input',
    capturePad: "Capture pad",
    tips: {
      pad: "Click the pad, then press a key; it also takes focus on first load. Tab, Space, Backspace, arrows and F1–F12 prevent their default actions here. Some browser or system shortcuts never reach the page.",
      mobile: 'Physical keyboard events differ on mobile. Use a desktop browser for full signal, or type a character below: on-screen keyboards report only the typed text, so code, keyCode, which and charCode stay empty.',
      properties: "Read the raw key, physical code, legacy keyCode/which/charCode, location, repeat and isComposing values from the latest keydown. The legacy numeric properties are deprecated.",
      modifiers: "Shift, Ctrl, Alt and Meta indicators reflect the modifiers on the latest captured keydown. They update on the next captured key.",
      snippet: "The snippet matches event.key and the captured modifiers. It changes immediately with each captured key; it does not use event.code.",
      copy: "Copy copies the complete JS snippet shown in the result area.",
      history: "Recent keys keeps the latest eight captures, newest first. The pad count includes every capture since Clear.",
      clear: "Clear resets the event fields, count, history, modifier indicators and snippet. Ctrl/⌘+L clears when focus is elsewhere in this tool; while the pad has focus it captures that shortcut as a key.",
    },
  },
  zh: {
    prompt: '点击此处，然后按任意键',
    countLabel: '次按键',
    eventProps: '事件属性',
    modifiers: '修饰键',
    snippet: '可复制的 JS 代码片段',
    recentKeys: '最近按键',
    deprecated: '（已废弃）',
    copy: '复制',
    copied: '代码片段已复制到剪贴板。',
    copyFailed: '复制失败。',
    clear: '清除',
    padFocused: '已聚焦捕获区，按任意键。',
    padBlurred: '已离开捕获区，点击区域恢复监听。',
    mobileNote:
      '移动端物理键盘事件不一致。建议使用桌面浏览器获取完整信号；或在下方输入一个字符：软键盘只报告输入的文字，code、keyCode、which、charCode 留空。',
    mobileInputLabel: '字符输入',
    capturePad: "按键捕获区",
    tips: {
      pad: "点击捕获区后按键；首次载入也会自动聚焦。区域内会阻止 Tab、空格、退格、方向键和 F1–F12 的默认操作；部分浏览器或系统快捷键不会传到页面。",
      mobile: '移动端物理键盘事件不一致。建议使用桌面浏览器获取完整信号；或在下方输入一个字符：软键盘只报告输入的文字，code、keyCode、which、charCode 留空。',
      properties: "显示最近一次 keydown 的原始 key、物理 code、旧 keyCode/which/charCode、location、repeat 和 isComposing 值；旧数字属性已弃用。",
      modifiers: "Shift、Ctrl、Alt、Meta 指示器显示最近一次捕获的 keydown 中的修饰键状态，下次捕获按键时更新。",
      snippet: "代码片段匹配 event.key 及捕获的修饰键，每次捕获后立即更新，不使用 event.code。",
      copy: "「复制」复制结果区显示的完整 JS 代码片段。",
      history: "「最近按键」保留最近八次捕获，最新的在前。捕获区计数包含自上次「清除」以来的全部捕获。",
      clear: "「清除」重置事件字段、计数、历史、修饰键指示器与代码片段。焦点在工具内其他位置时，Ctrl/⌘+L 清空；焦点在捕获区时，会将这个快捷键作为按键捕获。",
    },
  },
  ja: {
    prompt: 'ここをクリックしてキーを押してください',
    countLabel: 'キー入力',
    eventProps: 'イベントプロパティ',
    modifiers: '修飾キー',
    snippet: 'コピー可能な JS スニペット',
    recentKeys: '最近のキー',
    deprecated: '（非推奨）',
    copy: 'コピー',
    copied: 'スニペットをコピーしました。',
    copyFailed: 'コピーに失敗しました。',
    clear: 'クリア',
    padFocused: 'パッドにフォーカスしました。キーを押してください。',
    padBlurred: 'パッドからフォーカスが外れました。クリックして再開してください。',
    mobileNote:
      'モバイル端末では物理キーボードイベントが一貫しません。完全な情報はデスクトップブラウザで確認するか、下記で 1 文字入力してください。ソフトキーボードが伝えるのは入力した文字だけなので、code・keyCode・which・charCode は空欄になります。',
    mobileInputLabel: '文字入力',
    capturePad: "キーキャプチャパッド",
    tips: {
      pad: "パッドをクリックしてキーを押します。初回読み込み時にも自動でフォーカスします。ここでは Tab、Space、Backspace、矢印、F1–F12 の既定動作を止めます。一部のブラウザ・システムショートカットはページに届きません。",
      mobile: 'モバイル端末では物理キーボードイベントが一貫しません。完全な情報はデスクトップブラウザで確認するか、下記で 1 文字入力してください。ソフトキーボードが伝えるのは入力した文字だけなので、code・keyCode・which・charCode は空欄になります。',
      properties: "直近の keydown の key、物理位置の code、旧 keyCode/which/charCode、location、repeat、isComposing をそのまま表示します。旧数値プロパティは非推奨です。",
      modifiers: "Shift、Ctrl、Alt、Meta は直近の keydown の修飾キー状態を示します。次のキーを捕捉すると更新します。",
      snippet: "スニペットは event.key と捕捉した修飾キーに一致する条件です。キーを捕捉するたびに更新し、event.code は使いません。",
      copy: "「コピー」は結果欄に表示された JS スニペット全体をコピーします。",
      history: "「最近のキー」は直近八回の入力を新しい順に保持します。パッドの件数は前回の「クリア」以降の全入力を含みます。",
      clear: "「クリア」でイベント値、件数、履歴、修飾キー表示、スニペットをリセットします。このツールのパッド以外にフォーカスがあると Ctrl/⌘+L でも消去します。パッド内ではそのショートカットをキーとして捕捉します。",
    },
  },
  ko: {
    prompt: '여기를 클릭한 후 아무 키나 누르세요',
    countLabel: '회 키 입력',
    eventProps: '이벤트 속성',
    modifiers: '수정자 키',
    snippet: '복사 가능한 JS 스니펫',
    recentKeys: '최근 키',
    deprecated: '(폐지됨)',
    copy: '복사',
    copied: '스니펫이 클립보드에 복사되었습니다.',
    copyFailed: '복사 실패.',
    clear: '지우기',
    padFocused: '캡처 패드가 포커스되었습니다. 키를 누르세요.',
    padBlurred: '캡처 패드 포커스가 해제되었습니다. 패드를 클릭하여 재개하세요.',
    mobileNote:
      '모바일에서는 물리적 키보드 이벤트가 일관되지 않습니다. 데스크톱 브라우저를 사용하거나 아래에 한 글자를 입력하세요. 소프트 키보드는 입력한 글자만 알려 주므로 code, keyCode, which, charCode는 비워 둡니다.',
    mobileInputLabel: '문자 입력',
    capturePad: "키 캡처 패드",
    tips: {
      pad: "패드를 클릭한 뒤 키를 누릅니다. 처음 로드할 때도 자동으로 포커스합니다. 여기서는 Tab, Space, Backspace, 방향키, F1–F12의 기본 동작을 막습니다. 일부 브라우저 및 시스템 단축키는 페이지에 전달되지 않습니다.",
      mobile: '모바일에서는 물리적 키보드 이벤트가 일관되지 않습니다. 데스크톱 브라우저를 사용하거나 아래에 한 글자를 입력하세요. 소프트 키보드는 입력한 글자만 알려 주므로 code, keyCode, which, charCode는 비워 둡니다.',
      properties: "최근 keydown의 key, 물리적 위치인 code, 기존 keyCode/which/charCode, location, repeat, isComposing 원래 값을 표시합니다. 기존 숫자 속성은 폐지되었습니다.",
      modifiers: "Shift, Ctrl, Alt, Meta 표시기는 최근 캡처한 keydown의 수정자 상태를 나타내며 다음 키 캡처 때 갱신됩니다.",
      snippet: "스니펫은 event.key와 캡처한 수정자에 맞는 조건입니다. 키를 캡처할 때마다 갱신하며 event.code는 사용하지 않습니다.",
      copy: "「복사」는 결과 영역에 표시된 전체 JS 스니펫을 복사합니다.",
      history: "「최근 키」는 최근 8회 캡처를 최신순으로 보관합니다. 패드 횟수에는 마지막 「지우기」 이후 모든 캡처가 포함됩니다.",
      clear: "「지우기」는 이벤트 필드, 횟수, 기록, 수정자 표시기와 스니펫을 초기화합니다. 도구의 패드 이외 영역에 포커스하면 Ctrl/⌘+L로 지웁니다. 패드에서는 해당 단축키를 키로 캡처합니다.",
    },
  },
};
// strings:end
const T = STRINGS[lang] ?? STRINGS.en;
const { tips: TIPS, capturePad, mobileNote, ...CLIENT_T } = T;
---

<div class="kce-wrap">
  <div class="kce-toolbar">
    <span class="kce-action"><button id="kce-copy" class="btn-copy" type="button">{T.copy}</button><Toggletip id="kce-tip-copy" lang={lang} about={T.copy}>{TIPS.copy}</Toggletip></span>
    <span class="kce-action"><button id="kce-clear" class="btn-ghost" type="button">{T.clear}</button><Toggletip id="kce-tip-clear" lang={lang} about={T.clear}>{TIPS.clear}</Toggletip></span>
  </div>
  <div id="kce-status" class="tool-status" aria-live="polite"></div>
  <div class="kce-heading"><span class="tool-label">{T.capturePad}</span><Toggletip id="kce-tip-pad" lang={lang} about={T.capturePad}>{TIPS.pad}</Toggletip></div>

    <div
      id="kce-pad"
      class="kce-pad"
      tabindex="0"
      role="application"
      aria-label={T.capturePad}
    >
      <div class="kce-pad-prompt" id="kce-pad-prompt">{T.prompt}</div>
      <div class="kce-pad-display" id="kce-pad-display" aria-live="polite">
        <span class="kce-pad-glyph" id="kce-pad-glyph">⌨</span>
        <span class="kce-pad-key" id="kce-pad-key"></span>
      </div>
      <div class="kce-pad-meta" id="kce-pad-meta">
        <span class="kce-pad-count" id="kce-pad-count">0</span>
        <span class="kce-pad-count-label">{T.countLabel}</span>
      </div>
    </div>

    <div class="kce-mobile-fallback" id="kce-mobile-fallback" hidden>
<div class="kce-heading"><label class="tool-label" for="kce-mobile-input">{T.mobileInputLabel}</label><Toggletip id="kce-tip-mobile" lang={lang} about={T.mobileInputLabel}>{TIPS.mobile}</Toggletip></div>
      <input
        id="kce-mobile-input"
        class="tool-input"
        type="text"
        maxlength="1"
        autocapitalize="none"
        autocomplete="off"
        spellcheck="false"
      />
    </div>

  <div id="kce-results" class="kce-results" tabindex="0" aria-label={T.eventProps}>
    <section class="kce-section" aria-labelledby="kce-section-event">
      <div class="kce-heading"><h2 id="kce-section-event" class="kce-section-title">{T.eventProps}</h2><Toggletip id="kce-tip-properties" lang={lang} about={T.eventProps}>{TIPS.properties}</Toggletip></div>
      <div class="kce-grid">
        <div class="tool-result-row kce-row">
          <span class="tool-result-label kce-row-label">event.key</span>
          <code class="tool-result-value kce-row-value" id="kce-key">—</code>
        </div>
        <div class="tool-result-row kce-row">
          <span class="tool-result-label kce-row-label">event.code</span>
          <code class="tool-result-value kce-row-value" id="kce-code">—</code>
        </div>
        <div class="tool-result-row kce-row">
          <span class="tool-result-label kce-row-label">keyCode <em>{T.deprecated}</em></span>
          <code class="tool-result-value kce-row-value" id="kce-keycode">—</code>
        </div>
        <div class="tool-result-row kce-row">
          <span class="tool-result-label kce-row-label">which <em>{T.deprecated}</em></span>
          <code class="tool-result-value kce-row-value" id="kce-which">—</code>
        </div>
        <div class="tool-result-row kce-row">
          <span class="tool-result-label kce-row-label">charCode <em>{T.deprecated}</em></span>
          <code class="tool-result-value kce-row-value" id="kce-charcode">—</code>
        </div>
        <div class="tool-result-row kce-row">
          <span class="tool-result-label kce-row-label">location</span>
          <code class="tool-result-value kce-row-value" id="kce-location">—</code>
        </div>
        <div class="tool-result-row kce-row">
          <span class="tool-result-label kce-row-label">repeat</span>
          <code class="tool-result-value kce-row-value" id="kce-repeat">—</code>
        </div>
        <div class="tool-result-row kce-row">
          <span class="tool-result-label kce-row-label">isComposing</span>
          <code class="tool-result-value kce-row-value" id="kce-composing">—</code>
        </div>
      </div>
    </section>

    <section class="kce-section" aria-labelledby="kce-section-mod">
      <div class="kce-heading"><h2 id="kce-section-mod" class="kce-section-title">{T.modifiers}</h2><Toggletip id="kce-tip-modifiers" lang={lang} about={T.modifiers}>{TIPS.modifiers}</Toggletip></div>
      <div class="kce-mods" id="kce-mods">
        <span class="kce-mod" data-mod="shift">Shift</span>
        <span class="kce-mod" data-mod="ctrl">Ctrl</span>
        <span class="kce-mod" data-mod="alt">Alt</span>
        <span class="kce-mod" data-mod="meta">Meta</span>
      </div>
    </section>

    <section class="kce-section" aria-labelledby="kce-section-snippet">
      <div class="kce-snippet-header">
        <div class="kce-heading"><h2 id="kce-section-snippet" class="kce-section-title">{T.snippet}</h2><Toggletip id="kce-tip-snippet" lang={lang} about={T.snippet}>{TIPS.snippet}</Toggletip></div>

      </div>
      <pre class="kce-snippet" tabindex="0" aria-label={T.snippet}><code id="kce-snippet-code"></code></pre>
    </section>

    <section class="kce-section" aria-labelledby="kce-section-history">
      <div class="kce-history-header">
        <div class="kce-heading"><h2 id="kce-section-history" class="kce-section-title">{T.recentKeys}</h2><Toggletip id="kce-tip-history" lang={lang} about={T.recentKeys}>{TIPS.history}</Toggletip></div>

      </div>
      <div class="kce-history" id="kce-history" aria-live="polite" tabindex="0" aria-label={T.recentKeys}></div>
    </section>


  </div>
</div>

  <script is:inline define:vars={{ CLIENT_T }}>
    (function () {
      var PREVENT_DEFAULT_KEYS = new Set([
        'Tab',
        ' ',
        'Backspace',
        'ArrowUp',
        'ArrowDown',
        'ArrowLeft',
        'ArrowRight',
        'F1', 'F2', 'F3', 'F4', 'F5', 'F6', 'F7', 'F8', 'F9', 'F10', 'F11', 'F12',
      ]);
      var MAX_HISTORY = 8;

      var t = CLIENT_T;

      var pad = document.getElementById('kce-pad');
      var padGlyph = document.getElementById('kce-pad-glyph');
      var padKey = document.getElementById('kce-pad-key');
      var padCount = document.getElementById('kce-pad-count');
      var statusEl = document.getElementById('kce-status');
      var historyEl = document.getElementById('kce-history');
      var snippetEl = document.getElementById('kce-snippet-code');
      var copyBtn = document.getElementById('kce-copy');
      var clearBtn = document.getElementById('kce-clear');
      var modsEl = document.getElementById('kce-mods');
      var mobileFallback = document.getElementById('kce-mobile-fallback');
      var mobileInput = document.getElementById('kce-mobile-input');
      mobileInput.setAttribute('aria-label', t.mobileInputLabel);

      var fields = {
        key: document.getElementById('kce-key'),
        code: document.getElementById('kce-code'),
        keyCode: document.getElementById('kce-keycode'),
        which: document.getElementById('kce-which'),
        charCode: document.getElementById('kce-charcode'),
        location: document.getElementById('kce-location'),
        repeat: document.getElementById('kce-repeat'),
        composing: document.getElementById('kce-composing'),
      };

      var capturedCount = 0;
      var history = [];

      var copyRevision = 0;
      var copyTimer = null;
      var copyError = false;

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.classList.remove('copied');
        copyBtn.textContent = t.copy;
        if (copyError && statusEl.textContent === t.copyFailed) setStatus('', '');
        copyError = false;
      }

      function setStatus(msg, type) {
        copyError = false;
        statusEl.textContent = msg || '';
        statusEl.className = 'tool-status ' + (type || '');
      }

      function setText(el, val) {
        el.textContent = val == null ? '—' : String(val);
      }

      function escapeForString(str) {
        return String(str).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
      }

      function formatKeyLabel(key) {
        if (key === ' ') return 'Space';
        if (key.length === 1) return key;
        return key;
      }

      function setMods(e) {
        var states = { shift: e.shiftKey, ctrl: e.ctrlKey, alt: e.altKey, meta: e.metaKey };
        Object.keys(states).forEach(function (m) {
          var el = modsEl.querySelector('[data-mod="' + m + '"]');
          if (!el) return;
          if (states[m]) {
            el.classList.add('active');
          } else {
            el.classList.remove('active');
          }
        });
      }

      function buildSnippet(e) {
        if (!e || e.key == null) {
          snippetEl.textContent =
            "document.addEventListener('keydown', (e) => {\n  // press a key in the pad above to generate a snippet\n});";
          return;
        }
        var mods = [];
        var modifierKeys = new Set(['Shift', 'Control', 'Alt', 'Meta']);
        if (!modifierKeys.has(e.key)) {
          if (e.ctrlKey) mods.push('e.ctrlKey');
          if (e.shiftKey) mods.push('e.shiftKey');
          if (e.altKey) mods.push('e.altKey');
          if (e.metaKey) mods.push('e.metaKey');
        }
        var modClause = mods.length ? ' && ' + mods.join(' && ') : '';
        var keyExpr = "e.key === '" + escapeForString(e.key) + "'";
        snippetEl.textContent =
          "document.addEventListener('keydown', (e) => {\n" +
          '  if (' + keyExpr + modClause + ') {\n' +
          '    // your handler\n' +
          '  }\n' +
          '});';
      }

      function pushHistory(label) {
        history.unshift(label);
        if (history.length > MAX_HISTORY) history.length = MAX_HISTORY;
        renderHistory();
      }

      function renderHistory() {
        historyEl.innerHTML = '';
        history.forEach(function (k) {
          var chip = document.createElement('span');
          chip.className = 'kce-history-chip';
          chip.textContent = k;
          historyEl.appendChild(chip);
        });
      }

      function captureFromKeyboardEvent(e) {
        if (PREVENT_DEFAULT_KEYS.has(e.key)) {
          e.preventDefault();
        }
        capturedCount += 1;
        padCount.textContent = String(capturedCount);
        padKey.textContent = formatKeyLabel(e.key);
        padGlyph.classList.add('kce-pad-glyph-flash');
        window.setTimeout(function () {
          padGlyph.classList.remove('kce-pad-glyph-flash');
        }, 140);

        setText(fields.key, JSON.stringify(e.key));
        setText(fields.code, JSON.stringify(e.code));
        setText(fields.keyCode, e.keyCode);
        setText(fields.which, e.which);
        setText(fields.charCode, e.charCode);
        setText(fields.location, e.location);
        setText(fields.repeat, e.repeat);
        setText(fields.composing, e.isComposing);

        setMods(e);
        buildSnippet(e);
        pushHistory(formatKeyLabel(e.key));

        window.trackTool && window.trackTool('keycode-explorer', 'keydown');
      }

      /* ── engine:start ── */
      function captureFromMobileInput(ev) {
        var ch = (ev && ev.data) || (mobileInput.value || '');
        if (!ch) return;
        capturedCount += 1;
        padCount.textContent = String(capturedCount);
        padKey.textContent = ch;
        padGlyph.classList.add('kce-pad-glyph-flash');
        window.setTimeout(function () {
          padGlyph.classList.remove('kce-pad-glyph-flash');
        }, 140);

        // An input event carries only the inserted text (InputEvent.data). It has no key
        // position, so code / keyCode / which / charCode are not shown: guessing "KeyA" from
        // the letter "a" is wrong on AZERTY, Dvorak and other layouts.
        setText(fields.key, JSON.stringify(ch));
        setText(fields.code, '—');
        setText(fields.keyCode, '—');
        setText(fields.which, '—');
        setText(fields.charCode, '—');
        setText(fields.location, '—');
        setText(fields.repeat, '—');
        setText(fields.composing, '—');

        setMods({ shiftKey: false, ctrlKey: false, altKey: false, metaKey: false });
        buildSnippet({ key: ch, ctrlKey: false, shiftKey: false, altKey: false, metaKey: false });
        pushHistory(ch);

        mobileInput.value = '';

        window.trackTool && window.trackTool('keycode-explorer', 'mobile_input');
      }
      /* ── engine:end ── */

      function isCoarsePointer() {
        return typeof window.matchMedia === 'function' && window.matchMedia('(pointer: coarse)').matches;
      }

      if (isCoarsePointer()) {
        mobileFallback.hidden = false;
      }

      pad.addEventListener('keydown', function (e) {
        invalidateCopy();
        captureFromKeyboardEvent(e);
      });
      pad.addEventListener('focus', function () {
        pad.classList.add('kce-pad-active');
        setStatus(t.padFocused, 'info');
      });
      pad.addEventListener('blur', function () {
        pad.classList.remove('kce-pad-active');
        setStatus(t.padBlurred, 'none');
      });

      mobileInput.addEventListener('input', function (e) {
        invalidateCopy();
        captureFromMobileInput(e);
      });

      copyBtn.addEventListener('click', function () {
        var text = snippetEl.textContent || '';
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        function done() {
          if (revision !== copyRevision) return;
          copyBtn.classList.add('copied');
          copyBtn.textContent = t.copied;
          if (copyError && statusEl.textContent === t.copyFailed) setStatus('', '');
          copyTimer = setTimeout(function () {
            if (revision !== copyRevision) return;
            copyBtn.classList.remove('copied');
            copyBtn.textContent = t.copy;
          }, 1500);
        }
        function failed() {
          if (revision !== copyRevision) return;
          copyBtn.classList.remove('copied');
          copyBtn.textContent = t.copy;
          setStatus(t.copyFailed, 'error');
          copyError = true;
        }
        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
          try { navigator.clipboard.writeText(text).then(done, failed); }
          catch (err) { failed(); }
        } else {
          var ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          try {
            if (document.execCommand('copy')) done();
            else failed();
          } catch (err) {
            failed();
          }
          document.body.removeChild(ta);
        }
        window.trackTool && window.trackTool('keycode-explorer', 'copy_snippet');
      });

      function clearAll() {
        invalidateCopy();
        history = [];
        renderHistory();
        capturedCount = 0;
        padCount.textContent = '0';
        padKey.textContent = '';
        Object.keys(fields).forEach(function (k) { setText(fields[k], null); });
        setMods({ shiftKey: false, ctrlKey: false, altKey: false, metaKey: false });
        buildSnippet(null);
        setStatus('', '');
      }
      clearBtn.addEventListener('click', clearAll);
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        if (!document.querySelector('.kce-wrap').contains(document.activeElement) || pad.contains(document.activeElement)) return;
        e.preventDefault();
        pad.focus();
        clearAll();
      });

      buildSnippet(null);
      window.setTimeout(function () { pad.focus(); }, 60);
    })();
  </script>

