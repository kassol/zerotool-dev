---
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  "en": {
    "width": "Width",
    "height": "Height",
    "lockRatio": "Lock Ratio",
    "aspectRatio": "Aspect Ratio",
    "decimal": "Decimal",
    "preview": "Preview",
    "presets": "Presets",
    "resizeTitle": "Resize (maintains ratio)",
    "newWidth": "New Width",
    "newHeight": "New Height",
    "ratioLocked": "Ratio locked at ",
    "errEnterDims": "Enter width and height first to lock ratio.",
    "errSetDims": "Set original width and height first.",
    "presetApplied": " applied",
    "tips": {
      "dimensions": "Enter positive whole numbers for Width and Height. The ratio and the width ÷ height decimal update as you type; the decimal has four places. Ctrl/⌘+L inside the tool clears dimensions, results, the ratio lock and the selected preset.",
      "lock": "Set both dimensions before locking. The tool keeps their current width ÷ height ratio, then rounds the other dimension to a whole number when you change one side.",
      "presets": "Each preset multiplies its ratio numbers by 120. The result is simplified: 21:9 sets 2520 × 1080 and displays 7:3. A preset clears Resize fields and updates an active ratio lock.",
      "resize": "New Width and New Height use the current original dimensions. Enter either new dimension to calculate the other, rounded to a whole number. The original size stays unchanged, and Lock Ratio is not required.",
      "preview": "The preview shows the ratio as a box within 300 × 200 pixels, with each side at least 20 pixels. Very narrow or wide ratios are only approximate. Image files stay unchanged."
    }
  },
  "zh": {
    "width": "宽度",
    "height": "高度",
    "lockRatio": "锁定比例",
    "aspectRatio": "宽高比",
    "decimal": "小数",
    "preview": "预览",
    "presets": "预设",
    "resizeTitle": "缩放（保持比例）",
    "newWidth": "新宽度",
    "newHeight": "新高度",
    "ratioLocked": "已锁定比例：",
    "errEnterDims": "请先输入宽度和高度再锁定比例。",
    "errSetDims": "请先设置原始宽度和高度。",
    "presetApplied": " 已应用",
    "tips": {
      "dimensions": "输入正整数宽度和高度，比例与宽度 ÷ 高度的小数随输入更新，小数保留四位。在工具内按 Ctrl/⌘+L 会清空尺寸、结果、比例锁和选中的预设。",
      "lock": "先设置宽度和高度再锁定。工具保留此时的宽度 ÷ 高度，修改任一边时，按这个比例计算另一边并四舍五入为整数。",
      "presets": "预设将比例中的两个数各乘以 120。结果会约分：21:9 设置为 2520 × 1080，显示 7:3。选预设会清空缩放字段，并更新已启用的比例锁。",
      "resize": "新宽度和新高度使用当前原始尺寸的比例。输入任一新尺寸，另一边会自动计算并四舍五入为整数。原始尺寸保持不变，无需开启锁定比例。",
      "preview": "预览以方框展示比例形状，最多为 300 × 200 像素，每边至少 20 像素，因此极宽或极窄的比例只作近似展示。图片文件保持原样。"
    }
  },
  "ja": {
    "width": "幅",
    "height": "高さ",
    "lockRatio": "比率をロック",
    "aspectRatio": "アスペクト比",
    "decimal": "小数",
    "preview": "プレビュー",
    "presets": "プリセット",
    "resizeTitle": "リサイズ（比率を維持）",
    "newWidth": "新しい幅",
    "newHeight": "新しい高さ",
    "ratioLocked": "比率をロックしました：",
    "errEnterDims": "先に幅と高さを入力してください。",
    "errSetDims": "先に元の幅と高さを設定してください。",
    "presetApplied": " を適用",
    "tips": {
      "dimensions": "幅と高さに正の整数を入力します。比率と幅 ÷ 高さの小数は入力に合わせて更新され、小数は4桁です。ツール内で Ctrl/⌘+L を押すと寸法、結果、比率ロック、プリセットの選択を消去します。",
      "lock": "両方の寸法を設定してからロックします。その時点の幅 ÷ 高さを保持し、片方を変更すると他方を計算して整数に丸めます。",
      "presets": "プリセットは比率の数値をそれぞれ120倍します。結果は約分され、21:9 は 2520 × 1080 に設定されて7:3と表示されます。リサイズ欄を消去し、有効な比率ロックも更新します。",
      "resize": "新しい幅と新しい高さは現在の元寸法の比率を使います。片方を入力すると他方を計算して整数に丸めます。元の寸法は変わらず、比率ロックも不要です。",
      "preview": "形状のプレビューであり、画像ファイルのサイズは変えません。最大300 × 200ピクセル、各辺は最低20ピクセルなので、極端に縦長・横長の比率は近似表示です。"
    }
  },
  "ko": {
    "width": "너비",
    "height": "높이",
    "lockRatio": "비율 잠금",
    "aspectRatio": "화면 비율",
    "decimal": "소수",
    "preview": "미리보기",
    "presets": "프리셋",
    "resizeTitle": "크기 조정 (비율 유지)",
    "newWidth": "새 너비",
    "newHeight": "새 높이",
    "ratioLocked": "비율 잠금: ",
    "errEnterDims": "먼저 너비와 높이를 입력하세요.",
    "errSetDims": "먼저 원본 너비와 높이를 설정하세요.",
    "presetApplied": " 적용됨",
    "tips": {
      "dimensions": "너비와 높이에 양의 정수를 입력합니다. 비율과 너비 ÷ 높이의 소수는 입력에 따라 갱신되며 소수는 네 자리까지 표시합니다. 도구 안에서 Ctrl/⌘+L을 누르면 치수, 결과, 비율 잠금과 프리셋 선택을 지웁니다.",
      "lock": "두 치수를 설정한 뒤 잠급니다. 그때의 너비 ÷ 높이를 유지하며 한쪽을 바꾸면 다른 쪽을 계산해 정수로 반올림합니다.",
      "presets": "프리셋은 비율의 두 수에 각각 120을 곱합니다. 결과는 약분되어 21:9는 2520 × 1080으로 설정되고 7:3으로 표시됩니다. 크기 조정 필드를 지우고 활성화된 비율 잠금도 갱신합니다.",
      "resize": "새 너비와 새 높이는 현재 원본 치수의 비율을 사용합니다. 한쪽을 입력하면 다른 쪽을 계산해 정수로 반올림합니다. 원본 치수는 바뀌지 않으며 비율 잠금은 필요하지 않습니다.",
      "preview": "이미지 파일의 크기를 바꾸지 않는 모양 미리보기입니다. 최대 300 × 200픽셀, 각 변은 최소 20픽셀이므로 아주 넓거나 좁은 비율은 근사하여 표시합니다."
    }
  }
} as const;
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---
<div class="ar-wrap">
  <div class="ar-options">
    <div class="ar-lock-row">
      <label class="ar-toggle">
        <input id="ar-lock" type="checkbox" />
        <span class="ar-toggle-slider"></span>
        <span class="ar-toggle-label">{T.lockRatio}</span>
      </label>
      <Toggletip id="ar-tip-lock" lang={lang} about={T.lockRatio}>{TIPS.lock}</Toggletip>
    </div>
    <div class="ar-presets">
      <div class="ar-label-row">
        <span class="ar-presets-label">{T.presets}</span>
        <Toggletip id="ar-tip-presets" lang={lang} about={T.presets}>{TIPS.presets}</Toggletip>
      </div>
      <div class="ar-preset-chips" id="ar-preset-chips">
        <button class="ar-chip" data-w="16" data-h="9">16:9</button>
        <button class="ar-chip" data-w="4" data-h="3">4:3</button>
        <button class="ar-chip" data-w="21" data-h="9">21:9</button>
        <button class="ar-chip" data-w="1" data-h="1">1:1</button>
        <button class="ar-chip" data-w="9" data-h="16">9:16</button>
        <button class="ar-chip" data-w="3" data-h="2">3:2</button>
        <button class="ar-chip" data-w="2" data-h="3">2:3</button>
      </div>
    </div>
  </div>
  <div id="ar-status" class="tool-status" aria-live="polite" tabindex="0"></div>
  <div class="ar-work">
    <div class="ar-calculation">
      <div class="ar-inputs">
        <div class="ar-field">
          <div class="ar-label-row">
            <label for="ar-width">{T.width}</label>
            <Toggletip id="ar-tip-dimensions" lang={lang} about={T.aspectRatio}>{TIPS.dimensions}</Toggletip>
          </div>
          <input id="ar-width" type="number" class="tool-input" value="1920" placeholder="1920" min="1" step="1" />
        </div>
        <span class="ar-times">&times;</span>
        <div class="ar-field">
          <div class="ar-label-row"><label for="ar-height">{T.height}</label></div>
          <input id="ar-height" type="number" class="tool-input" value="1080" placeholder="1080" min="1" step="1" />
        </div>
      </div>
      <div class="ar-result" id="ar-result">
        <div class="ar-ratio-display">
          <span class="ar-ratio-value" id="ar-ratio" tabindex="0" aria-labelledby="ar-ratio-label">—</span>
          <span class="ar-ratio-label" id="ar-ratio-label">{T.aspectRatio}</span>
        </div>
        <div class="ar-ratio-display">
          <span class="ar-ratio-value ar-decimal" id="ar-decimal" tabindex="0" aria-labelledby="ar-decimal-label">—</span>
          <span class="ar-ratio-label" id="ar-decimal-label">{T.decimal}</span>
        </div>
      </div>
      <div class="ar-resize">
        <div class="ar-label-row">
          <span class="ar-resize-title">{T.resizeTitle}</span>
          <Toggletip id="ar-tip-resize" lang={lang} about={T.resizeTitle}>{TIPS.resize}</Toggletip>
        </div>
        <div class="ar-resize-inputs">
          <div class="ar-field">
            <label for="ar-new-width">{T.newWidth}</label>
            <input id="ar-new-width" type="number" class="tool-input" placeholder={T.width} min="1" step="1" />
          </div>
          <span class="ar-times">&times;</span>
          <div class="ar-field">
            <label for="ar-new-height">{T.newHeight}</label>
            <input id="ar-new-height" type="number" class="tool-input" placeholder={T.height} min="1" step="1" />
          </div>
        </div>
      </div>
    </div>
    <div class="ar-preview-wrap">
      <div class="ar-label-row">
        <span class="ar-preview-label">{T.preview}</span>
        <Toggletip id="ar-tip-preview" lang={lang} about={T.preview}>{TIPS.preview}</Toggletip>
      </div>
      <div class="ar-preview-container"><div id="ar-preview" class="ar-preview"></div></div>
    </div>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var widthEl = document.getElementById('ar-width');
      var heightEl = document.getElementById('ar-height');
      var lockEl = document.getElementById('ar-lock');
      var ratioEl = document.getElementById('ar-ratio');
      var decimalEl = document.getElementById('ar-decimal');
      var previewEl = document.getElementById('ar-preview');
      var newWidthEl = document.getElementById('ar-new-width');
      var newHeightEl = document.getElementById('ar-new-height');
      var statusEl = document.getElementById('ar-status');
      var chips = document.querySelectorAll('.ar-chip');

      var lockedRatio = 0; // w/h

      function gcd(a, b) {
        a = Math.abs(Math.round(a));
        b = Math.abs(Math.round(b));
        while (b) {
          var t = b;
          b = a % b;
          a = t;
        }
        return a;
      }

      function setStatus(msg, type) {
        statusEl.textContent = msg;
        statusEl.className = 'tool-status ' + (type || '');
      }

      function clearStatus() {
        statusEl.textContent = '';
        statusEl.className = 'tool-status';
      }

      function updatePreview(w, h) {
        if (!w || !h || w <= 0 || h <= 0) {
          previewEl.style.width = '0';
          previewEl.style.height = '0';
          return;
        }
        var maxW = 300;
        var maxH = 200;
        var scale = Math.min(maxW / w, maxH / h);
        var pw = Math.max(Math.round(w * scale), 20);
        var ph = Math.max(Math.round(h * scale), 20);
        previewEl.style.width = pw + 'px';
        previewEl.style.height = ph + 'px';
      }

      function updateRatioDisplay(w, h) {
        if (!w || !h || w <= 0 || h <= 0) {
          ratioEl.textContent = '\u2014';
          decimalEl.textContent = '\u2014';
          updatePreview(0, 0);
          return;
        }
        var d = gcd(w, h) || 1;
        var rw = w / d;
        var rh = h / d;
        ratioEl.textContent = rw + ':' + rh;
        decimalEl.textContent = (w / h).toFixed(4);
        updatePreview(w, h);
        clearStatus();
      }

      function getVal(el) {
        var v = parseFloat(el.value);
        if (isNaN(v) || v <= 0) return 0;
        return v;
      }

      function onWidthChange() {
        var w = getVal(widthEl);
        if (lockEl.checked && lockedRatio > 0 && w > 0) {
          var h = Math.round(w / lockedRatio);
          heightEl.value = h;
          updateRatioDisplay(w, h);
        } else {
          updateRatioDisplay(w, getVal(heightEl));
          updateLockedRatio();
        }
        clearResize();
      }

      function onHeightChange() {
        var h = getVal(heightEl);
        if (lockEl.checked && lockedRatio > 0 && h > 0) {
          var w = Math.round(h * lockedRatio);
          widthEl.value = w;
          updateRatioDisplay(w, h);
        } else {
          updateRatioDisplay(getVal(widthEl), h);
          updateLockedRatio();
        }
        clearResize();
      }

      function updateLockedRatio() {
        if (!lockEl.checked) return;
        var w = getVal(widthEl);
        var h = getVal(heightEl);
        if (w > 0 && h > 0) {
          lockedRatio = w / h;
        }
      }

      function clearResize() {
        newWidthEl.value = '';
        newHeightEl.value = '';
      }

      // Lock toggle
      lockEl.addEventListener('change', function () {
        var w = getVal(widthEl);
        var h = getVal(heightEl);
        if (this.checked) {
          if (w > 0 && h > 0) {
            lockedRatio = w / h;
            setStatus(t.ratioLocked + ratioEl.textContent, 'info');
          } else {
            setStatus(t.errEnterDims, 'error');
            this.checked = false;
          }
        } else {
          lockedRatio = 0;
          clearStatus();
        }
      });

      // Dimension inputs
      widthEl.addEventListener('input', onWidthChange);
      heightEl.addEventListener('input', onHeightChange);

      /* Analytics: one event per committed change (as in css-triangle-generator), not per input event. */
      function trackCalculate() {
        if (getVal(widthEl) > 0 && getVal(heightEl) > 0) window.trackTool && window.trackTool('aspect_ratio', 'calculate');
      }
      widthEl.addEventListener('change', trackCalculate);
      heightEl.addEventListener('change', trackCalculate);

      // Presets
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          var pw = parseInt(chip.getAttribute('data-w'));
          var ph = parseInt(chip.getAttribute('data-h'));
          // Set a reasonable default size using the ratio
          var scale = Math.max(Math.ceil(1920 / Math.max(pw, ph)), 100);
          widthEl.value = pw * Math.round(scale / pw) || pw * 120;
          heightEl.value = ph * Math.round(scale / ph) || ph * 120;
          // Simpler: just use the ratio numbers scaled up
          widthEl.value = pw * 120;
          heightEl.value = ph * 120;
          updateRatioDisplay(pw * 120, ph * 120);
          if (lockEl.checked) {
            lockedRatio = pw / ph;
          }
          clearResize();

          // Highlight active chip
          chips.forEach(function (c) { c.classList.remove('ar-chip-active'); });
          chip.classList.add('ar-chip-active');

          setStatus('Preset ' + pw + ':' + ph + t.presetApplied, 'success');
          window.trackTool && window.trackTool('aspect_ratio', 'calculate');
        });
      });

      // Resize inputs
      newWidthEl.addEventListener('input', function () {
        var w = getVal(widthEl);
        var h = getVal(heightEl);
        var nw = getVal(newWidthEl);
        if (w <= 0 || h <= 0) {
          setStatus(t.errSetDims, 'error');
          return;
        }
        if (nw <= 0) { newHeightEl.value = ''; return; }
        var ratio = h / w;
        newHeightEl.value = Math.round(nw * ratio);
        clearStatus();
      });

      newHeightEl.addEventListener('input', function () {
        var w = getVal(widthEl);
        var h = getVal(heightEl);
        var nh = getVal(newHeightEl);
        if (w <= 0 || h <= 0) {
          setStatus(t.errSetDims, 'error');
          return;
        }
        if (nh <= 0) { newWidthEl.value = ''; return; }
        var ratio = w / h;
        newWidthEl.value = Math.round(nh * ratio);
        clearStatus();
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var root = document.querySelector('.ar-wrap');
        if (!root || !root.contains(document.activeElement)) return;
        e.preventDefault();
        widthEl.value = '';
        heightEl.value = '';
        clearResize();
        lockEl.checked = false;
        lockedRatio = 0;
        chips.forEach(function (chip) { chip.classList.remove('ar-chip-active'); });
        updateRatioDisplay(0, 0);
        clearStatus();
      });

      // Init with 16:9 default
      widthEl.value = 1920;
      heightEl.value = 1080;
      updateRatioDisplay(1920, 1080);
    })();
  </script>
</div>

<style>
  .ar-wrap {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    gap: 0.75rem;
  }

  .ar-options { display: flex; align-items: flex-start; gap: 1rem; }
  .ar-work { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.25rem; }
  .ar-calculation { display: flex; flex-direction: column; min-width: 0; gap: 1rem; }
  .ar-label-row { display: flex; align-items: center; min-height: 28px; gap: 0.35rem; }
  .ar-wrap #ar-status { height: 3em; min-height: 3em; line-height: 1.5; overflow: auto; overflow-wrap: anywhere; }
  .ar-ratio-value:focus-visible, #ar-status:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

  /* Dimension inputs row */
  .ar-inputs,
  .ar-resize-inputs {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .ar-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
    min-width: 0;
  }

  .ar-field label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ar-field .tool-input {
    width: 100%;
  }

  .ar-times {
    font-size: 1.2rem;
    color: var(--color-text-secondary);
    padding-bottom: 0.45rem;
    flex-shrink: 0;
  }

  /* Lock toggle */
  .ar-lock-row {
    display: flex;
    align-items: center;
    flex: none;
    gap: 0.35rem;
    min-height: 44px;
  }

  .ar-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
  }

  .ar-toggle input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .ar-toggle-slider {
    width: 36px;
    height: 20px;
    background: var(--color-border);
    border-radius: 10px;
    position: relative;
    transition: background 0.2s ease;
    flex-shrink: 0;
  }

  .ar-toggle-slider::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    background: #fff;
    border-radius: 50%;
    transition: transform 0.2s ease;
  }

  .ar-toggle input:checked + .ar-toggle-slider {
    background: var(--color-primary);
  }

  .ar-toggle input:checked + .ar-toggle-slider::after {
    transform: translateX(16px);
  }

  .ar-toggle-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  /* Result display */
  .ar-result {
    display: flex;
    gap: 1rem;
  }

  .ar-ratio-display {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.65rem;
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    flex: 1;
    transition: border-color 0.15s ease;
  }

  .ar-ratio-display:hover {
    border-color: var(--color-primary);
  }

  .ar-ratio-value {
    display: block;
    width: 100%;
    height: 3rem;
    line-height: 2.5rem;
    overflow: auto;
    white-space: nowrap;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    font-family: var(--font-mono);
  }

  .ar-ratio-value.ar-decimal {
    font-size: 1.25rem;
  }

  .ar-ratio-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Visual preview */
  .ar-preview-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ar-preview-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ar-preview-container {
    display: flex;
    align-items: center;
