---
// OpenapiValidatorTool — pure client-side OpenAPI 3.x validator
---
<div>
  <div class="ov-wrap">
    <div class="ov-field">
      <label for="ov-input" data-i18n="inputLabel">OpenAPI Spec (YAML or JSON)</label>
      <textarea
        id="ov-input"
        rows="16"
        spellcheck="false"
        autocomplete="off"
        placeholder="openapi: &quot;3.0.3&quot;
info:
  title: My API
  version: &quot;1.0.0&quot;
paths:
  /users:
    get:
      summary: List users
      responses:
        &quot;200&quot;:
          description: OK"
      ></textarea>
    </div>

    <div class="ov-actions">
      <button id="ov-validate" type="button" data-i18n="validate">Validate</button>
      <button id="ov-clear" type="button" data-i18n="clear">Clear</button>
    </div>

    <div id="ov-result" class="ov-result" aria-live="polite"></div>
  </div>

  <script is:inline>
    /* Apply i18n synchronously to prevent FOUC */
    (function () {
      var STRINGS = {
        en: { inputLabel: 'OpenAPI Spec (YAML or JSON)', clear: 'Clear', validate: 'Validate' },
        zh: { inputLabel: 'OpenAPI 规范（YAML 或 JSON）', clear: '清空', validate: '验证' },
        ja: { inputLabel: 'OpenAPI 仕様（YAML または JSON）', clear: 'クリア', validate: '検証' },
        ko: { inputLabel: 'OpenAPI 스펙 (YAML 또는 JSON)', clear: '지우기', validate: '검증' }
      };
      var pageLang = (document.documentElement.lang || 'en').slice(0, 2);
      var t = STRINGS[pageLang] || STRINGS.en;
      document.querySelectorAll('.ov-wrap [data-i18n]').forEach(function (el) {
        var key = el.getAttribute('data-i18n');
        if (t[key]) el.textContent = t[key];
      });
    })();
  </script>

  <script>
    import jsyaml from 'js-yaml';

    /* Ajv and the schemas (about 100 KB of JSON) load on the first validation. */
    let validatorsPromise: Promise<any> | null = null;
    function loadValidators(): Promise<any> {
      if (!validatorsPromise) {
        validatorsPromise = Promise.all([
          import('ajv'),
          import('ajv/dist/2020'),
          import('ajv-formats'),
          import('../../data/openapi-schemas/oas-3.0-2024-10-18.json'),
          import('../../data/openapi-schemas/oas-3.1-2026-08-03.json'),
          import('../../data/openapi-schemas/oas-3.2-2026-08-30.json'),
        ]).then(function (m: any[]) {
          return createValidators(
            { Ajv: m[0].default, Ajv2020: m[1].default, addFormats: m[2].default },
            { '3.0': m[3].default, '3.1': m[4].default, '3.2': m[5].default }
          );
        });
      }
      return validatorsPromise;
    }

    const STRINGS = {
      en: {
        msgEmpty: 'Paste an OpenAPI spec above and click Validate.',
        msgValid: 'Valid OpenAPI spec',
        msgInvalid: 'Invalid OpenAPI spec',
        specTitle: 'API Title',
        specVersion: 'Version',
        specOas: 'OpenAPI Version',
        specPaths: 'Paths',
        specOps: 'Operations',
        specServers: 'Servers',
        errorsFound: 'error(s) found',
        errPath: 'Path',
        errMessage: 'Message',
        notices: 'Not checked',
        loadFailed: 'Could not load the validator. Check your connection and try again.'
      },
      zh: {
        msgEmpty: '请在上方粘贴 OpenAPI 规范，然后点击验证。',
        msgValid: 'OpenAPI 规范有效',
        msgInvalid: 'OpenAPI 规范无效',
        specTitle: 'API 名称',
        specVersion: '版本',
        specOas: 'OpenAPI 版本',
        specPaths: '路径数',
        specOps: '接口数',
        specServers: '服务器',
        errorsFound: '个错误',
        errPath: '路径',
        errMessage: '信息',
        notices: '未检查',
        loadFailed: '校验器加载失败，请检查网络后重试。'
      },
      ja: {
        msgEmpty: '上にOpenAPI仕様を貼り付けて検証をクリックしてください。',
        msgValid: '有効なOpenAPI仕様',
        msgInvalid: '無効なOpenAPI仕様',
        specTitle: 'API タイトル',
        specVersion: 'バージョン',
        specOas: 'OpenAPI バージョン',
        specPaths: 'パス数',
        specOps: 'オペレーション数',
        specServers: 'サーバー',
        errorsFound: '件のエラー',
        errPath: 'パス',
        errMessage: 'メッセージ',
        notices: '未確認',
        loadFailed: '検証プログラムを読み込めませんでした。接続を確認して再試行してください。'
      },
      ko: {
        msgEmpty: '위에 OpenAPI 스펙을 붙여넣고 검증을 클릭하세요.',
        msgValid: '유효한 OpenAPI 스펙',
        msgInvalid: '유효하지 않은 OpenAPI 스펙',
        specTitle: 'API 제목',
        specVersion: '버전',
        specOas: 'OpenAPI 버전',
        specPaths: '경로',
        specOps: '오퍼레이션',
        specServers: '서버',
        errorsFound: '개 오류 발견',
        errPath: '경로',
        errMessage: '메시지',
        notices: '확인하지 않음',
        loadFailed: '검증기를 불러오지 못했습니다. 연결을 확인하고 다시 시도하세요.'
      }
    };

    const pageLang = (document.documentElement.lang || 'en').slice(0, 2);
    const t = (STRINGS as any)[pageLang] || STRINGS.en;

    const inputEl    = document.getElementById('ov-input') as HTMLTextAreaElement;
    const resultEl   = document.getElementById('ov-result')!;
    const validateBtn = document.getElementById('ov-validate')!;
    const clearBtn   = document.getElementById('ov-clear')!;

    /* ── engine:start ── */
    /* Structure: the official OpenAPI JSON Schemas (spec.openapis.org; 3.0 is draft-04 and is
       converted to draft-07 for Ajv, 3.1 / 3.2 are draft 2020-12). These schemas do not follow
       $ref and do not check rules written only in prose, so three checks are added: every
       internal $ref points to something, path template names match path parameters, and
       operationId values are unique. External references are listed, not fetched. */
    var METHODS = {
      '3.0': ['get', 'put', 'post', 'delete', 'options', 'head', 'patch', 'trace'],
      '3.1': ['get', 'put', 'post', 'delete', 'options', 'head', 'patch', 'trace'],
      '3.2': ['get', 'put', 'post', 'delete', 'options', 'head', 'patch', 'trace', 'query'],
    };

    /* draft-04 → draft-07: `id` becomes `$id`, boolean exclusiveMinimum / exclusiveMaximum
       become the numeric form. Keys under properties / patternProperties / definitions are
       names, not keywords, and are left alone. */
    function fromDraft04(schema) {
      function walk(node) {
        if (Array.isArray(node)) return node.map(walk);
        if (!node || typeof node !== 'object') return node;
        var out = {};
        Object.keys(node).forEach(function (k) {
          var v = node[k];
          if (k === 'properties' || k === 'patternProperties' || k === 'definitions') {
            var map = {};
            Object.keys(v).forEach(function (name) { map[name] = walk(v[name]); });
            out[k] = map;
          } else if (k === 'id' && typeof v === 'string') {
            out.$id = v;
          } else if (k === '$schema') {
            out.$schema = 'http://json-schema.org/draft-07/schema#';
          } else if ((k === 'exclusiveMinimum' || k === 'exclusiveMaximum') && typeof v === 'boolean') {
            // handled with minimum / maximum below
          } else {
            out[k] = walk(v);
          }
        });
        if (node.exclusiveMinimum === true && typeof node.minimum === 'number') { out.exclusiveMinimum = node.minimum; delete out.minimum; }
        if (node.exclusiveMaximum === true && typeof node.maximum === 'number') { out.exclusiveMaximum = node.maximum; delete out.maximum; }
        return out;
      }
      return walk(schema);
    }

    /* The 3.1 / 3.2 schemas point Schema Objects at `{ "$dynamicRef": "#meta" }`, whose anchor is
       $defs/schema. Only the schema-base variants override that anchor; on its own the dynamic
       reference resolves to $defs/schema. Ajv does not resolve this $dynamicRef correctly (it
       validated Schema Objects against the root), so it is replaced with the equivalent static $ref. */
    function staticDynamicRefs(schema) {
      var anchorPath = null;
      Object.keys(schema.$defs || {}).forEach(function (k) {
        if (schema.$defs[k] && schema.$defs[k].$dynamicAnchor === 'meta') anchorPath = '#/$defs/' + k;
      });
      function walk(node) {
        if (Array.isArray(node)) return node.map(walk);
        if (!node || typeof node !== 'object') return node;
        var out = {};
        Object.keys(node).forEach(function (k) {
          if (k === '$dynamicRef' && node[k] === '#meta' && anchorPath) out.$ref = anchorPath;
          else if (k === '$dynamicAnchor') return;
          else out[k] = walk(node[k]);
        });
        return out;
      }
      return walk(schema);
    }

    /* lib: { Ajv, Ajv2020, addFormats }; schemas: { '3.0', '3.1', '3.2' } (official JSON). */
    function createValidators(lib, schemas) {
      function prepare(ajv) {
        lib.addFormats(ajv);
        ajv.addFormat('media-range', true);
        return ajv;
      }
      var cache = {};
      return function (version) {
        if (!schemas[version]) return null;
        if (!cache[version]) {
          var ajv = version === '3.0'
            ? prepare(new lib.Ajv({ allErrors: true, strict: false }))
            : prepare(new lib.Ajv2020({ allErrors: true, strict: false }));
          cache[version] = ajv.compile(version === '3.0' ? fromDraft04(schemas[version]) : staticDynamicRefs(schemas[version]));
        }
        return cache[version];
      };
    }

    function versionOf(doc) {
      var v = doc.openapi;
      if (typeof v !== 'string') return null;
      var m = /^(3\.[0-2])\.\d+(-.+)?$/.exec(v);
      return m ? m[1] : null;
    }

    function pointerOf(segments) {
      return '#' + segments.map(function (s) { return '/' + String(s).replace(/~/g, '~0').replace(/\//g, '~1'); }).join('');
    }
    function segmentsOf(pointer) {
      if (pointer === '' ) return [];
      return pointer.slice(1).split('/').map(function (s) { return s.replace(/~1/g, '/').replace(/~0/g, '~'); });
    }

    /* Ajv reports every failed branch of a oneOf / anyOf. Keep the errors that explain the
       problem: drop the oneOf / anyOf summary and the "must have $ref" branch (Reference Object)
       when another error exists at the same place or deeper, and drop exact duplicates. */
    function simplifyErrors(errors) {
      function deeperOrSame(a, b) { return a === b || a.indexOf(b + '/') === 0 || b === ''; }
      var kept = errors.filter(function (e) {
        var isSummary = e.keyword === 'oneOf' || e.keyword === 'anyOf' || e.keyword === 'if' || e.keyword === 'not';
        var isRefBranch = e.keyword === 'required' && e.params && e.params.missingProperty === '$ref';
        if (!isSummary && !isRefBranch) return true;
        return !errors.some(function (o) {
          if (o === e) return false;
          var oSummary = o.keyword === 'oneOf' || o.keyword === 'anyOf' || o.keyword === 'if' || o.keyword === 'not';
          var oRef = o.keyword === 'required' && o.params && o.params.missingProperty === '$ref';
          return !oSummary && !oRef && deeperOrSame(o.instancePath, e.instancePath);
        });
      });
      var seen = {};
      return kept.filter(function (e) {
        var key = e.instancePath + '|' + e.keyword + '|' + JSON.stringify(e.params);
        if (seen[key]) return false;
        seen[key] = true;
        return true;
      });
    }
    function describe(e) {
      var p = e.params || {};
      var unknown = e.keyword === 'additionalProperties' ? p.additionalProperty : e.keyword === 'unevaluatedProperties' ? p.unevaluatedProperty : null;
      if (unknown !== null && e.instancePath === '/paths') return 'Path "' + unknown + '" must start with "/".';
      if (e.keyword === 'required') return 'Missing required field "' + p.missingProperty + '".';
      if (e.keyword === 'additionalProperties') return 'Unknown field "' + p.additionalProperty + '".';
      if (e.keyword === 'unevaluatedProperties') return 'Unknown field "' + p.unevaluatedProperty + '".';
      if (e.keyword === 'propertyNames') return 'Field name not allowed here.';
      if (e.keyword === 'type') return 'Must be ' + (Array.isArray(p.type) ? p.type.join(' or ') : p.type) + '.';
      if (e.keyword === 'enum') return 'Must be one of: ' + p.allowedValues.map(function (v) { return JSON.stringify(v); }).join(', ') + '.';
      if (e.keyword === 'const') return 'Must be ' + JSON.stringify(p.allowedValue) + '.';
      if (e.keyword === 'pattern') return 'Does not match the pattern ' + p.pattern + '.';
      if (e.keyword === 'format') return 'Not a valid ' + p.format + '.';
      if (e.keyword === 'oneOf' || e.keyword === 'anyOf') return 'Does not match any allowed form of this object.';
      return e.message ? e.message.charAt(0).toUpperCase() + e.message.slice(1) + '.' : e.keyword;
    }
    function schemaErrors(validate, doc) {
      if (validate(doc)) return [];
      return simplifyErrors(validate.errors || []).map(function (e) {
        var path = e.instancePath === '' ? '#' : '#' + e.instancePath;
        return { path: path, message: describe(e) };
      });
    }

    /* Value at a JSON Pointer fragment ("#/components/schemas/Pet"); undefined if absent. */
    function resolveLocal(doc, ref) {
      var frag;
      try { frag = decodeURIComponent(ref.slice(1)); } catch (_e) { return undefined; }
      if (frag !== '' && frag.charAt(0) !== '/') return undefined;
      var node = doc;
      var segs = segmentsOf(frag);
      for (var i = 0; i < segs.length; i++) {
        if (node === null || typeof node !== 'object' || !Object.prototype.hasOwnProperty.call(node, segs[i])) return undefined;
        node = node[segs[i]];
      }
      return node;
    }

    /* Keys whose values are example data, not part of the description. `examples` is data when
       it is an array (Schema Object) and a map of Example Objects otherwise, whose `value` is data. */
    var DATA_KEYS = { example: 1, default: 1, enum: 1, const: 1 };
    function refChecks(doc) {
      var errors = [], notices = [];
      function walk(node, segs) {
        if (Array.isArray(node)) { node.forEach(function (v, i) { walk(v, segs.concat(i)); }); return; }
        if (!node || typeof node !== 'object') return;
        Object.keys(node).forEach(function (k) {
          var v = node[k];
          if (k === '$ref' && typeof v === 'string') {
            var at = pointerOf(segs.concat('$ref'));
            if (v.charAt(0) !== '#') {
              notices.push({ path: at, message: 'External reference "' + v + '" was not checked (only references inside this document are resolved).' });
            } else if (v.length > 1 && v.charAt(1) !== '/') {
              notices.push({ path: at, message: 'Anchor reference "' + v + '" was not checked.' });
            } else if (resolveLocal(doc, v) === undefined) {
              errors.push({ path: at, message: 'Reference "' + v + '" does not point to anything in this document.' });
            }
            return;
          }
          if (DATA_KEYS[k] || /^x-/.test(k)) return;
          if (k === 'examples') {
            if (!v || typeof v !== 'object' || Array.isArray(v)) return;
            Object.keys(v).forEach(function (name) {
              var ex = v[name];
              if (!ex || typeof ex !== 'object') return;
              var copy = {};
              Object.keys(ex).forEach(function (ek) { if (ek !== 'value') copy[ek] = ex[ek]; });
              walk(copy, segs.concat(k, name));
            });
            return;
          }
          walk(v, segs.concat(k));
        });
      }
      walk(doc, []);
      return { errors: errors, notices: notices };
    }

    /* Follows internal $ref chains; returns undefined for external or broken references. */
    function deref(doc, node) {
      for (var i = 0; i < 20 && node && typeof node === 'object' && typeof node.$ref === 'string'; i++) {
        if (node.$ref.charAt(0) !== '#') return undefined;
        node = resolveLocal(doc, node.$ref);
      }
      return node;
    }

    function operationsOf(item, version) {
      var ops = [];
      (METHODS[version] || METHODS['3.0']).forEach(function (m) {
        if (item[m] && typeof item[m] === 'object') ops.push({ method: m, op: item[m] });
      });
      if (version === '3.2' && item.additionalOperations && typeof item.additionalOperations === 'object') {
        Object.keys(item.additionalOperations).forEach(function (m) {
          if (item.additionalOperations[m] && typeof item.additionalOperations[m] === 'object') ops.push({ method: m, op: item.additionalOperations[m], extra: true });
        });
      }
      return ops;
    }

    /* Path Templating: every {name} in a path needs an `in: path` parameter on the Path Item or
       the operation, and every `in: path` parameter must appear in the path. */
    function pathChecks(doc, version) {
      var errors = [];
      var paths = doc.paths;
      if (!paths || typeof paths !== 'object') return errors;
      Object.keys(paths).forEach(function (p) {
        var item = deref(doc, paths[p]);
        if (!item || typeof item !== 'object') return;
        var names = [];
        var re = /\{([^{}]+)\}/g, m;
        while ((m = re.exec(p))) if (names.indexOf(m[1]) < 0) names.push(m[1]);
        function collect(list, out) {
          if (!Array.isArray(list)) return true;
          for (var i = 0; i < list.length; i++) {
            var prm = deref(doc, list[i]);
            if (!prm || typeof prm !== 'object') return false;
            if (prm.in === 'path' && typeof prm.name === 'string') out[prm.name] = true;
          }
          return true;
        }
        var shared = {};
        if (!collect(item.parameters, shared)) return;
        operationsOf(item, version).forEach(function (o) {
          var declared = Object.assign({}, shared);
          if (!collect(o.op.parameters, declared)) return;
          var label = o.method.toUpperCase() + ' ' + p;
          var base = pointerOf(['paths', p]).slice(0);
          names.forEach(function (n) {
            if (!declared[n]) errors.push({ path: base + '/' + (o.extra ? 'additionalOperations/' : '') + o.method, message: label + ': path parameter "' + n + '" is not declared (add a parameter with in: path, name: ' + n + ').' });
          });
          Object.keys(declared).forEach(function (n) {
            if (names.indexOf(n) < 0) errors.push({ path: base + '/' + (o.extra ? 'additionalOperations/' : '') + o.method, message: label + ': parameter "' + n + '" is declared with in: path but the path has no {' + n + '}.' });
          });
        });
      });
      return errors;
    }

    function operationIdChecks(doc, version) {
      var errors = [], seen = {};
      function visit(item, segs) {
        item = deref(doc, item);
        if (!item || typeof item !== 'object') return;
        operationsOf(item, version).forEach(function (o) {
          var id = o.op.operationId;
          if (typeof id !== 'string') return;
          var at = pointerOf(segs.concat(o.extra ? ['additionalOperations', o.method] : [o.method], 'operationId'));
          if (seen[id]) errors.push({ path: at, message: 'operationId "' + id + '" is already used at ' + seen[id] + '; it must be unique.' });
          else seen[id] = at;
        });
      }
      ['paths', 'webhooks'].forEach(function (k) {
        var map = doc[k];
        if (map && typeof map === 'object') Object.keys(map).forEach(function (p) { visit(map[p], [k, p]); });
      });
      return errors;
    }

    function countOps(doc, version) {
      var count = 0;
      if (!doc.paths || typeof doc.paths !== 'object') return 0;
      Object.keys(doc.paths).forEach(function (p) {
        var item = deref(doc, doc.paths[p]);
        if (item && typeof item === 'object') count += operationsOf(item, version).length;
      });
      return count;
    }

    /* Returns { version, errors, notices }. getValidator(version) returns a compiled validator. */
    function validateOpenApi(doc, getValidator) {
      if (!doc || typeof doc !== 'object' || Array.isArray(doc)) {
        return { version: null, errors: [{ path: '#', message: 'Document must be a YAML/JSON object.' }], notices: [] };
      }
      if (doc.swagger !== undefined && doc.openapi === undefined) {
        return { version: null, notices: [], errors: [{ path: '#/swagger', message: 'Swagger 2.0 document. This tool checks OpenAPI 3.0, 3.1 and 3.2; convert it first (for example with swagger2openapi).' }] };
      }
      if (doc.openapi === undefined) {
        return { version: null, notices: [], errors: [{ path: '#', message: 'Missing required field "openapi".' }] };
      }
      var version = versionOf(doc);
      if (!version) {
        return { version: null, notices: [], errors: [{ path: '#/openapi', message: 'Field "openapi" must be a version string such as "3.0.4", "3.1.1" or "3.2.0" (quote it in YAML). Got: ' + JSON.stringify(doc.openapi) + '.' }] };
      }
      var errors = schemaErrors(getValidator(version), doc);
      var refs = refChecks(doc);
      errors = errors.concat(refs.errors, pathChecks(doc, version), operationIdChecks(doc, version));
      return { version: version, errors: errors, notices: refs.notices };
    }
    /* ── engine:end ── */

    function escHtml(s: string): string {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function renderNotices(notices: { path: string; message: string }[]): string {
      if (!notices.length) return '';
      let html = '<div class="ov-notices"><p class="ov-notices-title">' + escHtml(t.notices) + '</p><ul>';
      notices.forEach(function (n) {
        html += '<li><code class="ov-err-path">' + escHtml(n.path) + '</code> ' + escHtml(n.message) + '</li>';
      });
      return html + '</ul></div>';
    }

    function renderValid(doc: any, result: any): void {
      const title = (doc.info && doc.info.title) || '—';
      const version = (doc.info && doc.info.version) || '—';
      const oasVersion = doc.openapi || '—';
      const pathCount = doc.paths ? Object.keys(doc.paths).length : 0;
      const opCount = countOps(doc, result.version);
      const servers = doc.servers;

      let html = '<div class="ov-valid-header">';
      html += '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>';
      html += '<span>' + escHtml(t.msgValid) + '</span>';
      html += '</div>';

      html += '<div class="ov-info-grid">';
      html += '<div class="ov-info-row"><span class="ov-info-key">' + escHtml(t.specTitle) + '</span><span class="ov-info-val">' + escHtml(title) + '</span></div>';
      html += '<div class="ov-info-row"><span class="ov-info-key">' + escHtml(t.specVersion) + '</span><span class="ov-info-val">' + escHtml(String(version)) + '</span></div>';
      html += '<div class="ov-info-row"><span class="ov-info-key">' + escHtml(t.specOas) + '</span><span class="ov-info-val">' + escHtml(String(oasVersion)) + '</span></div>';
      html += '<div class="ov-info-row"><span class="ov-info-key">' + escHtml(t.specPaths) + '</span><span class="ov-info-val">' + pathCount + '</span></div>';
      html += '<div class="ov-info-row"><span class="ov-info-key">' + escHtml(t.specOps) + '</span><span class="ov-info-val">' + opCount + '</span></div>';

      if (servers && Array.isArray(servers) && servers.length > 0) {
        const serverUrls = servers.map((s: any) => s.url || '').filter(Boolean).join(', ');
        if (serverUrls) {
          html += '<div class="ov-info-row"><span class="ov-info-key">' + escHtml(t.specServers) + '</span><span class="ov-info-val">' + escHtml(serverUrls) + '</span></div>';
        }
      }

      html += '</div>';
      html += renderNotices(result.notices);
      resultEl.innerHTML = html;
      resultEl.className = 'ov-result ov-result--valid';
    }

    function renderErrors(errors: { path: string; message: string }[], notices: { path: string; message: string }[]): void {
      let html = '<div class="ov-invalid-header">';
      html += '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
      html += '<span>' + escHtml(t.msgInvalid) + ' — ' + errors.length + ' ' + escHtml(t.errorsFound) + '</span>';
      html += '</div>';

      html += '<table class="ov-err-table">';
      html += '<thead><tr><th>' + escHtml(t.errPath) + '</th><th>' + escHtml(t.errMessage) + '</th></tr></thead>';
      html += '<tbody>';
      errors.forEach(function (e) {
        html += '<tr>';
        html += '<td><code class="ov-err-path">' + escHtml(e.path) + '</code></td>';
        html += '<td>' + escHtml(e.message) + '</td>';
        html += '</tr>';
      });
      html += '</tbody></table>';

      resultEl.innerHTML = html;
      resultEl.className = 'ov-result ov-result--invalid';
    }

    function renderEmpty(): void {
      resultEl.innerHTML = '<p class="ov-empty">' + escHtml(t.msgEmpty) + '</p>';
      resultEl.className = 'ov-result';
    }

    let runId = 0;
    async function doValidate(): Promise<void> {
      const raw = inputEl.value.trim();
      const id = ++runId;
      if (!raw) {
        renderEmpty();
        return;
      }
      let doc: any;
      try {
        doc = jsyaml.load(raw);
      } catch (e: any) {
        renderErrors([{ path: '(parse)', message: 'Parse error: ' + e.message }], []);
        (window as any).trackTool?.('openapi-validator', 'validate_error');
        return;
      }
      let getValidator: any;
      try {
        getValidator = await loadValidators();
      } catch (e: any) {
        validatorsPromise = null;
        renderErrors([{ path: '(load)', message: t.loadFailed + ' ' + (e && e.message ? e.message : '') }], []);
        return;
      }
      if (id !== runId) return;
      const result = validateOpenApi(doc, getValidator);
      if (result.errors.length === 0) {
        renderValid(doc, result);
        (window as any).trackTool?.('openapi-validator', 'validate_success');
      } else {
        renderErrors(result.errors, result.notices);
        (window as any).trackTool?.('openapi-validator', 'validate_error');
      }
    }

    /* Prevent textarea blur before click fires (eliminates first-click race) */
    validateBtn.addEventListener('mousedown', (e) => e.preventDefault());
    validateBtn.addEventListener('click', doValidate);

    clearBtn.addEventListener('mousedown', (e) => e.preventDefault());
    clearBtn.addEventListener('click', () => {
      inputEl.value = '';
      renderEmpty();
    });

    inputEl.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        doValidate();
      }
    });

    renderEmpty();
  </script>
</div>

