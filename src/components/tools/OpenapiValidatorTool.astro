const EXAMPLE = `openapi: 3.1.0
info:
  title: Orders API
  version: 1.0.0
servers:
  - url: https://{region}.api.example.com/v1
    variables:
      region:
        default: eu
        enum: [us, eu]
security:
  - bearerAuth: []
paths:
  /orders/{orderId}:
    get:
      operationId: getOrder
      responses:
        "200":
          description: One order
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Order"
              example:
                id: 42
                status: shipped
                total: "19.90"
components:
  schemas:
    Order:
      type: object
      required: [id, status, total]
      properties:
        id: {type: integer}
        status: {type: string, enum: [pending, paid, shipped]}
        total: {type: number}
    Customer:
      type: object
  securitySchemes:
    bearer:
      type: http
      scheme: bearer
`;

const T = STRINGS[lang];
---

<div class="oav-wrap" id="oav-wrap" data-strings={JSON.stringify(T)} data-example={EXAMPLE}>
  <div class="oav-bar">
    <button id="oav-validate" class="btn-primary" type="button">{T.validate}</button>
    <button id="oav-open" class="btn-secondary" type="button">{T.open}</button>
    <button id="oav-folder" class="btn-ghost oav-desktop" type="button">{T.folder}</button>
    <button id="oav-example" class="btn-ghost" type="button">{T.example}</button>
    <button id="oav-clear" class="btn-ghost" type="button">{T.clear}</button>
    <input id="oav-file" type="file" multiple accept=".yaml,.yml,.json,application/json,application/yaml,text/yaml" hidden />
    <input id="oav-dir" type="file" webkitdirectory multiple hidden />
  </div>

  <div class="oav-main" id="oav-drop">
    <label for="oav-input" class="tool-label oav-label">{T.inputLabel} <span class="oav-rootname" id="oav-rootname"></span></label>
    <textarea id="oav-input" class="tool-textarea oav-input" rows="12" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder={T.inputPh} aria-describedby="oav-status"></textarea>
    <p class="oav-hint oav-desktop">{T.dropHint}</p>
  </div>

  <p id="oav-status" class="oav-status" role="status" aria-live="polite">{T.idle}</p>

  <div id="oav-results" class="oav-results" hidden>
    <div class="oav-filters" role="group">
      <button type="button" class="oav-filter" data-level="all" aria-pressed="true"></button>
      <button type="button" class="oav-filter" data-level="error" aria-pressed="false"></button>
      <button type="button" class="oav-filter" data-level="warning" aria-pressed="false"></button>
      <button type="button" class="oav-filter" data-level="info" aria-pressed="false"></button>
      <button type="button" id="oav-copy" class="btn-copy oav-copy">{T.copy}</button>
    </div>
    <ol id="oav-list" class="oav-list"></ol>
    <button type="button" id="oav-more" class="btn-ghost oav-more" hidden></button>
    <div id="oav-missing" class="oav-missing" hidden></div>
    <section id="oav-summary" class="oav-summary" hidden>
      <h3 class="oav-sub">{T.summaryTitle}</h3>
      <dl id="oav-summary-list"></dl>
    </section>
  </div>

  <details id="oav-files" class="oav-files">
    <summary id="oav-files-title"></summary>
    <p class="oav-hint">{T.filesHint}</p>
    <div id="oav-file-list" class="oav-file-list"></div>
    <button type="button" id="oav-add" class="btn-ghost oav-add">{T.addFile}</button>
  </details>
</div>

<script>
  // @ts-nocheck
  import ValidatorWorker from './openapi-validator.worker.js?worker';
  import { formatMessage, pickRoot } from './openapi-validator-format.js';

  var wrap = document.getElementById('oav-wrap');
  var T = JSON.parse(wrap.dataset.strings);
  var EXAMPLE = wrap.dataset.example;
  var $ = function (id) { return document.getElementById(id); };
  var input = $('oav-input'), statusEl = $('oav-status'), results = $('oav-results'), list = $('oav-list');
  var moreBtn = $('oav-more'), summaryBox = $('oav-summary'), summaryList = $('oav-summary-list');
  var filesBox = $('oav-files'), fileList = $('oav-file-list'), filesTitle = $('oav-files-title'), missingBox = $('oav-missing');
  var rootNameEl = $('oav-rootname');

  var AUTO_LIMIT = 2 * 1024 * 1024;
  var LOAD_LIMIT = 50 * 1024 * 1024;
  var LIST_LIMIT = 300;
  var state = { rootName: 'openapi.yaml', extra: [], last: null, filter: 'all', showAll: false };

  function fill(tpl, args) {
    return String(tpl).replace(/\{(\w+)\}/g, function (m, k) { return args && args[k] !== undefined ? String(args[k]) : m; });
  }
  function el(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }
  function setStatus(text, kind) {
    statusEl.textContent = text;
    statusEl.className = 'oav-status' + (kind ? ' oav-status--' + kind : '');
  }

  /* ── files ── */
  function normName(n) {
    var out = [];
    String(n || '').replace(/\\/g, '/').split('/').forEach(function (s) {
      if (s === '' || s === '.') return;
      if (s === '..' && out.length && out[out.length - 1] !== '..') out.pop(); else out.push(s);
    });
    return out.join('/');
  }
  function renderFiles() {
    filesTitle.textContent = fill(T.filesTitle, { n: state.extra.length });
    rootNameEl.textContent = state.extra.length ? '— ' + state.rootName : '';
    fileList.textContent = '';
    state.extra.forEach(function (f, i) {
      var box = el('div', 'oav-file');
      var row = el('div', 'oav-file-row');
      var nameId = 'oav-fname-' + i, textId = 'oav-ftext-' + i;
      var lab = el('label', 'tool-label oav-sr', T.fileName);
      lab.htmlFor = nameId;
      var name = el('input', 'tool-input oav-fname');
      name.id = nameId; name.type = 'text'; name.value = f.name; name.spellcheck = false; name.autocomplete = 'off';
      name.setAttribute('aria-label', T.fileName);
      name.addEventListener('change', function () { f.name = normName(name.value) || f.name; name.value = f.name; schedule(0); });
      var rm = el('button', 'btn-ghost oav-remove', T.remove);
      rm.type = 'button';
      rm.addEventListener('click', function () { state.extra.splice(i, 1); renderFiles(); schedule(0); });
      row.append(lab, name, rm);
      var ta = el('textarea', 'tool-textarea oav-ftext');
      ta.id = textId; ta.rows = 6; ta.spellcheck = false; ta.value = f.text;
      ta.setAttribute('aria-label', fill(T.fileText, { file: f.name }));
      ta.addEventListener('input', function () { f.text = ta.value; schedule(); });
      box.append(row, ta);
      fileList.append(box);
    });
  }
  function addExtra(name, text, open) {
    name = normName(name);
    var existing = state.extra.find(function (f) { return f.name === name; });
    if (existing) existing.text = text; else state.extra.push({ name: name, text: text });
    renderFiles();
    if (open) filesBox.open = true;
  }

  async function loadFiles(fileArr) {
    var picked = [], skipped = 0, total = 0;
    for (var i = 0; i < fileArr.length; i++) {
      var f = fileArr[i];
      var path = normName(f.webkitRelativePath || f.relPath || f.name);
      if (!/\.(ya?ml|json)$/i.test(path)) { skipped++; continue; }
      total += f.size;
      if (total > LOAD_LIMIT) { setStatus(fill(T.tooBig, { mb: LOAD_LIMIT / 1048576 }), 'error'); return; }
      picked.push({ path: path, file: f });
    }
    if (!picked.length) { if (skipped) setStatus(fill(T.skipped, { n: skipped }), 'error'); return; }
    // strip a common top folder (folder picker gives "folder/…")
    var parts = picked.map(function (p) { return p.path.split('/'); });
    while (parts.every(function (p) { return p.length > 1 && p[0] === parts[0][0]; })) parts.forEach(function (p) { p.shift(); });
    var files = {};
    for (var j = 0; j < picked.length; j++) {
      try { files[parts[j].join('/')] = await picked[j].file.text(); }
      catch (_e) { setStatus(fill(T.readFail, { file: picked[j].path }), 'error'); return; }
    }
    var root = pickRoot(files);
    state.rootName = root;
    input.value = files[root];
    state.extra = [];
    Object.keys(files).forEach(function (n) { if (n !== root) state.extra.push({ name: n, text: files[n] }); });
    renderFiles();
    if (state.extra.length) filesBox.open = false;
    if (skipped) setStatus(fill(T.skipped, { n: skipped }));
    run();
  }

  /* ── worker ── */
  var worker = null, seq = 0, pending = null, runFallback = null;
  function startWorker() {
    if (worker) return worker;
    try {
      worker = new ValidatorWorker();
      worker.onmessage = function (e) {
        var d = e.data || {};
        if (!pending || d.id !== pending.id) return;
        var p = pending; pending = null;
        p.resolve(d);
      };
      worker.onerror = function (e) {
        if (pending) { var p = pending; pending = null; p.resolve({ error: (e && e.message) || 'worker error' }); }
        stopWorker();
      };
    } catch (_e) { worker = null; }
    return worker;
  }
  function stopWorker() { if (worker) { worker.terminate(); worker = null; } }
  function validateIn(inputObj) {
    var id = ++seq;
    if (pending) { stopWorker(); pending.resolve(null); pending = null; }
    var w = startWorker();
    if (!w) {
      return (runFallback || (runFallback = import('./openapi-validator-run.js'))).then(function (m) {
        return id === seq ? m.runValidation(inputObj) : null;
      });
    }
    return new Promise(function (resolve) {
      pending = { id: id, resolve: resolve };
      w.postMessage({ id: id, input: inputObj });
    });
  }

  /* ── run ── */
  var timer = null, firstRun = true;
  function schedule(delay) {
    clearTimeout(timer);
    var size = input.value.length + state.extra.reduce(function (s, f) { return s + f.text.length; }, 0);
    if (!input.value.trim()) { showIdle(); return; }
    if (size > AUTO_LIMIT && delay !== 0) { setStatus(fill(T.autoOff, { mb: (size / 1048576).toFixed(1) })); return; }
    timer = setTimeout(run, delay === undefined ? 500 : delay);
  }
  function showIdle() {
    clearTimeout(timer);
    seq++;
    if (pending) { stopWorker(); pending.resolve(null); pending = null; }
    state.last = null;
    results.hidden = true;
    setStatus(T.idle);
  }

  async function run() {
    clearTimeout(timer);
    var text = input.value;
    if (!text.trim()) { showIdle(); return; }
    var files = {};
    files[state.rootName] = text;
    state.extra.forEach(function (f) { if (f.name && f.name !== state.rootName) files[f.name] = f.text; });
    setStatus(firstRun ? T.loading : T.running, 'busy');
    var myId = seq + 1;
    var started = performance.now();
    var res = await validateIn({ root: state.rootName, files: files });
    if (!res || myId !== seq) return;
    firstRun = false;
    if (res.error) { setStatus(fill(T.failed, { err: res.error }), 'error'); results.hidden = true; return; }
    state.last = res.result;
    state.showAll = false;
    render(res.result, (performance.now() - started) / 1000);
    var r = res.result;
    var errs = r.problems.filter(function (p) { return p.level === 'error'; }).length;
    window.trackTool && window.trackTool('openapi-validator', errs ? 'validate_error' : 'validate_success');
  }

  function counts(problems) {
    var c = { error: 0, warning: 0, info: 0 };
    problems.forEach(function (p) { c[p.level]++; });
    return c;
  }
  function levelLabel(l) { return l === 'error' ? T.levelError : l === 'warning' ? T.levelWarning : T.levelInfo; }

  function render(r, secs) {
    var c = counts(r.problems);
    var spec = r.kind === 'swagger' ? 'Swagger' : 'OpenAPI';
    var head;
    if (!r.version) head = T.resultParse;
    else head = fill(c.error ? T.resultBad : T.resultOk, { spec: spec, version: r.summary ? r.summary.specVersion : r.version, e: c.error });
    setStatus(head + ' ' + fill(T.counts, { e: c.error, w: c.warning, i: c.info }) + ' · ' + fill(T.took, { s: secs.toFixed(secs < 1 ? 2 : 1) }), c.error ? 'error' : 'ok');
    results.hidden = false;
    wrap.querySelectorAll('.oav-filter').forEach(function (b) {
      var l = b.dataset.level;
      b.textContent = l === 'all' ? T.filterAll + ' ' + r.problems.length : levelLabel(l) + ' ' + c[l];
      b.setAttribute('aria-pressed', String(state.filter === l));
      b.disabled = l !== 'all' && c[l] === 0;
    });
    renderList();
    renderMissing(r);
    renderSummary(r);
  }

  function renderList() {
    var r = state.last;
    if (!r) return;
    list.textContent = '';
    var items = r.problems.filter(function (p) { return state.filter === 'all' || p.level === state.filter; });
    var shown = state.showAll ? items : items.slice(0, LIST_LIMIT);
    var frag = document.createDocumentFragment();
    shown.forEach(function (p) {
      var li = el('li', 'oav-item oav-item--' + p.level);
      var badge = el('span', 'oav-badge oav-badge--' + p.level, levelLabel(p.level));
      var loc = el('button', 'oav-loc', (state.extra.length ? p.file + ':' : '') + p.line + ':' + p.col);
      loc.type = 'button';
      loc.setAttribute('aria-label', fill(T.jump, { line: p.line, file: p.file }));
      loc.addEventListener('click', function () { jump(p); });
      var msg = el('span', 'oav-msg', formatMessage(p, T));
      li.append(badge, loc, msg);
      if (p.code !== 'parse.yaml' && p.path && p.path !== '#') li.append(el('code', 'oav-ptr', p.path));
      if (p.code === 'parse.yaml') {
        var src = lineText(p.file, p.line);
        if (src !== null) li.append(el('code', 'oav-ptr oav-src', p.line + ' | ' + src));
      }
      frag.append(li);
    });
    list.append(frag);
    moreBtn.hidden = shown.length === items.length;
    moreBtn.textContent = fill(T.showAll, { n: items.length });
  }

  function textOf(file) {
    if (file === state.rootName) return input.value;
    var f = state.extra.find(function (x) { return x.name === file; });
    return f ? f.text : null;
  }
  function lineText(file, line) {
    var t = textOf(file);
    if (t === null) return null;
    var s = t.replace(/^\uFEFF/, '').split('\n')[line - 1];
    return s === undefined ? null : s.replace(/\r$/, '').slice(0, 200);
  }

  function jump(p) {
    var ta = input, t = input.value;
    if (p.file !== state.rootName) {
      var idx = state.extra.findIndex(function (x) { return x.name === p.file; });
      if (idx < 0) return;
      filesBox.open = true;
      ta = $('oav-ftext-' + idx);
      if (!ta) return;
      t = ta.value;
    }
    var bom = t.charCodeAt(0) === 0xfeff ? 1 : 0;
    var start = Math.min(t.length, (p.offset || 0) + bom);
    var end = t.indexOf('\n', start);
    if (end < 0) end = t.length;
    ta.focus({ preventScroll: true });
    ta.setSelectionRange(start, end);
    var lh = parseFloat(getComputedStyle(ta).lineHeight) || 20;
    var before = t.slice(0, start).split('\n').length - 1;
    ta.scrollTop = Math.max(0, before * lh - ta.clientHeight / 3);
    var rect = ta.getBoundingClientRect();
    if (rect.top < 0 || rect.bottom > window.innerHeight) ta.scrollIntoView({ block: 'center' });
  }

  function renderMissing(r) {
    missingBox.textContent = '';
    var need = [];
    r.problems.forEach(function (p) {
      if (p.code === 'ref.missingFile' && need.indexOf(p.args.file) < 0) need.push(p.args.file);
    });
    missingBox.hidden = !need.length;
    need.slice(0, 12).forEach(function (f) {
      var b = el('button', 'btn-ghost btn-sm oav-addmissing', fill(T.addMissing, { file: f }));
      b.type = 'button';
      b.addEventListener('click', function () {
        addExtra(f, '', true);
        var idx = state.extra.findIndex(function (x) { return x.name === normName(f); });
        var ta = $('oav-ftext-' + idx);
        if (ta) { ta.focus(); ta.scrollIntoView({ block: 'center' }); }
      });
      missingBox.append(b);
    });
  }

  function renderSummary(r) {
    var s = r.summary;
    summaryBox.hidden = !s;
    summaryList.textContent = '';
    if (!s) return;
    var rows = [
      [T.sumTitle, s.title || '—'], [T.sumVersion, s.apiVersion || '—'],
      [T.sumSpec, (r.kind === 'swagger' ? 'Swagger ' : 'OpenAPI ') + s.specVersion],
      [T.sumPaths, String(s.paths)], [T.sumOps, String(s.operations)],
    ];
    if (s.webhooks) rows.push([T.sumWebhooks, String(s.webhooks)]);
    rows.push([T.sumComponents, String(s.components)]);
    if (s.servers.length) rows.push([T.sumServers, s.servers.slice(0, 5).join('\n')]);
    if (r.files.length > 1) rows.push([T.sumFiles, String(r.files.length)]);
    rows.forEach(function (row) {
      var d = el('div', 'oav-sum-row');
      d.append(el('dt', '', row[0]), el('dd', '', row[1]));
      summaryList.append(d);
    });
  }

  function reportText() {
    var r = state.last;
    if (!r) return '';
    return r.problems.map(function (p) {
      return p.file + ':' + p.line + ':' + p.col + '\t' + levelLabel(p.level) + '\t' + formatMessage(p, T) + (p.path && p.path !== '#' ? '\t' + p.path : '');
    }).join('\n');
  }

  /* ── events ── */
  $('oav-validate').addEventListener('click', function () { run(); });
  input.addEventListener('input', function () { schedule(); });
  $('oav-example').addEventListener('click', function () {
    input.value = EXAMPLE;
    state.rootName = 'openapi.yaml';
    state.extra = [];
    renderFiles();
    run();
  });
  $('oav-clear').addEventListener('click', function () {
    input.value = '';
    state.extra = [];
    state.rootName = 'openapi.yaml';
    renderFiles();
    showIdle();
    input.focus();
  });
  $('oav-open').addEventListener('click', function () { $('oav-file').click(); });
  $('oav-folder').addEventListener('click', function () { $('oav-dir').click(); });
  $('oav-file').addEventListener('change', function (e) { loadFiles(Array.from(e.target.files || [])); e.target.value = ''; });
  $('oav-dir').addEventListener('change', function (e) { loadFiles(Array.from(e.target.files || [])); e.target.value = ''; });
  $('oav-add').addEventListener('click', function () {
    var n = 1;
    while (state.extra.some(function (f) { return f.name === 'schemas/file-' + n + '.yaml'; })) n++;
    addExtra('schemas/file-' + n + '.yaml', '', true);
    var ta = $('oav-ftext-' + (state.extra.length - 1));
    if (ta) ta.focus();
  });
  wrap.querySelectorAll('.oav-filter').forEach(function (b) {
    b.addEventListener('click', function () {
      state.filter = b.dataset.level;
      state.showAll = false;
      wrap.querySelectorAll('.oav-filter').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      renderList();
    });
  });
  moreBtn.addEventListener('click', function () { state.showAll = true; renderList(); });
  $('oav-copy').addEventListener('click', async function () {
    var btn = this, text = reportText();
    var ok = false;
    try { await navigator.clipboard.writeText(text); ok = true; } catch (_e) {
      var ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.append(ta); ta.select();
      try { ok = document.execCommand('copy'); } catch (_e2) { ok = false; }
      ta.remove();
    }
    btn.textContent = ok ? T.copied : T.copyFail;
    setTimeout(function () { btn.textContent = T.copy; }, 1500);
  });

  // drag and drop anywhere on the tool
  wrap.addEventListener('dragover', function (e) {
    if (e.dataTransfer && Array.from(e.dataTransfer.types || []).indexOf('Files') >= 0) { e.preventDefault(); wrap.classList.add('oav-dragging'); }
  });
  wrap.addEventListener('dragleave', function (e) { if (!wrap.contains(e.relatedTarget)) wrap.classList.remove('oav-dragging'); });
  wrap.addEventListener('drop', async function (e) {
    if (!e.dataTransfer || !e.dataTransfer.files || !e.dataTransfer.files.length) return;
    e.preventDefault();
    wrap.classList.remove('oav-dragging');
    var items = Array.from(e.dataTransfer.items || []);
    var entries = items.map(function (it) { return it.webkitGetAsEntry ? it.webkitGetAsEntry() : null; }).filter(Boolean);
    if (entries.length && entries.some(function (en) { return en.isDirectory; })) {
      var out = [];
      async function walk(entry, prefix) {
        if (entry.isFile) {
          var f = await new Promise(function (res, rej) { entry.file(res, rej); });
          f.relPath = prefix + entry.name;
          out.push(f);
        } else if (entry.isDirectory) {
          var reader = entry.createReader();
          var batch;
          do {
            batch = await new Promise(function (res, rej) { reader.readEntries(res, rej); });
            for (var k = 0; k < batch.length; k++) await walk(batch[k], prefix + entry.name + '/');
          } while (batch.length);
        }
      }
      for (var i = 0; i < entries.length; i++) await walk(entries[i], '');
      loadFiles(out);
    } else {
      loadFiles(Array.from(e.dataTransfer.files));
    }
  });

  // site-wide Ctrl/⌘+L clears the text fields; drop the extra files and the results with them
  document.addEventListener('keydown', function (e) {
    if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
      setTimeout(function () { state.extra = []; state.rootName = 'openapi.yaml'; renderFiles(); showIdle(); }, 0);
    }
  });

  renderFiles();
</script>

<style>
  .oav-wrap { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  .oav-wrap.oav-dragging { outline: 2px dashed var(--color-primary); outline-offset: 6px; border-radius: var(--radius-md); }
  .oav-bar { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .oav-main { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  .oav-label { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: baseline; }
  .oav-rootname { font-family: var(--font-mono); font-weight: 500; color: var(--color-text-muted); text-transform: none; letter-spacing: 0; }
  .oav-input { min-height: 260px; tab-size: 2; white-space: pre; overflow-wrap: normal; overflow-x: auto; }
  .oav-hint { margin: 0; font-size: 0.82rem; color: var(--color-text-muted); }
  .oav-status { margin: 0; font-size: 0.9rem; color: var(--color-text-secondary); min-height: 1.3rem; }
  .oav-status--ok { color: var(--color-success); font-weight: 650; }
  .oav-status--error { color: var(--color-danger); font-weight: 650; }
  .oav-status--busy { color: var(--color-primary); }

  .oav-results { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; }
  .oav-results[hidden] { display: none; }
  .oav-filters { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .oav-filter {
    min-height: 30px; padding: 0.2rem 0.75rem; border-radius: var(--radius-pill); border: 0;
    background: var(--color-bg-secondary); color: var(--color-text-secondary); font: inherit; font-size: 0.85rem; font-weight: 650;
    box-shadow: inset 0 0 0 1px var(--color-border-soft); cursor: pointer;
  }
  .oav-filter[aria-pressed="true"] { background: var(--color-primary); color: var(--color-primary-contrast); box-shadow: none; }
  .oav-filter:disabled { opacity: 0.5; cursor: default; }
  .oav-filter:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .oav-copy { margin-left: auto; }

  .oav-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .oav-list :global(.oav-item) {
    display: grid; grid-template-columns: auto auto minmax(0, 1fr); gap: 0.3rem 0.6rem; align-items: baseline;
    padding: 0.5rem 0.65rem; border-radius: var(--radius-md); background: var(--color-surface);
    box-shadow: inset 3px 0 0 var(--oav-level, var(--color-border)), inset 0 0 0 1px var(--color-border-soft);
