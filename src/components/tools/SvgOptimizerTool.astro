  .svgo-summary { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem 0.9rem; }
  .svgo-sizes { font-family: var(--font-mono); font-weight: 700; font-size: 1.05rem; color: var(--color-text); }
  .svgo-saved { font-family: var(--font-mono); font-weight: 800; color: var(--color-success); }
  .svgo-saved--up { color: var(--color-danger); }
  .svgo-gzip, .svgo-engine { font-family: var(--font-mono); font-size: 0.82rem; color: var(--color-text-secondary); }
  .svgo-engine { margin-left: auto; }
  .svgo-out-actions { display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: center; }
  .svgo-format { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.85rem; color: var(--color-text-secondary); }
  .svgo-format select { width: auto; min-width: 12rem; }

  .svgo-check {
    margin: 0; padding: 0.55rem 0.75rem; border-radius: var(--radius-md);
    font-size: 0.88rem; font-weight: 650;
    background: var(--color-surface); color: var(--color-text-secondary);
    box-shadow: inset 3px 0 0 var(--color-border);
  }
  .svgo-check--same { color: var(--color-success); box-shadow: inset 3px 0 0 var(--color-success); }
  .svgo-check--minor, .svgo-check--beforeFailed, .svgo-check--skipped { color: var(--color-text); box-shadow: inset 3px 0 0 var(--color-accent); }
  .svgo-check--changed, .svgo-check--afterFailed { color: var(--color-danger); box-shadow: inset 3px 0 0 var(--color-danger); }

  /* The previews take the height the pane has left; the notes follow them. */
  .svgo-compare { display: grid; flex: 1 0 auto; grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr)); gap: 0.75rem; }
  .svgo-fig { margin: 0; display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  .svgo-fig figcaption { font-size: 0.75rem; font-weight: 700; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.05em; }
  .svgo-preview {
    position: relative; flex: 1 1 auto; min-height: 150px; overflow: hidden;
    border-radius: var(--radius-sm); box-shadow: inset 0 0 0 1px var(--color-border-soft);
    background:
      repeating-conic-gradient(color-mix(in oklch, var(--color-text-muted) 22%, transparent) 0% 25%, transparent 0% 50%) 0 0 / 16px 16px,
      var(--color-surface);
  }
  .svgo-preview--plain { background: #fff; }
  /* Drawn at the compared size (long side 400 px) or smaller, never enlarged. */
  .svgo-preview img, .svgo-preview canvas { position: absolute; inset: 0.5rem; width: calc(100% - 1rem); height: calc(100% - 1rem); object-fit: scale-down; }

  .svgo-notes { margin: 0; padding: 0; list-style: none; display: flex; flex: none; flex-direction: column; gap: 0.35rem; }
  .svgo-notes :global(.svgo-note) {
    font-size: 0.85rem; line-height: 1.5; color: var(--color-text);
    padding: 0.45rem 0.7rem; border-radius: var(--radius-md);
    background: var(--color-surface-muted); box-shadow: inset 0 0 0 1px var(--color-border-soft);
