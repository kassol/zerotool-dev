  // ── copied verbatim from GifSplitterTool.astro (scripts/test-svg-optimizer.mjs compares the source) ──
  var crcTable = (function () {
    var table = new Uint32Array(256);
    for (var n = 0; n < 256; n++) {
      var c = n;
