const fill = (tpl: string, vars: Record<string, string | number>) => tpl.replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));
const RISKY = new Set(['removeViewBox', 'removeDimensions', 'removeTitle']);
---

<div class="svgo-wrap" id="svgo-wrap" data-lang={lang} data-strings={JSON.stringify(CLIENT_T)}>
  <div class="svgo-toolbar">
    <button id="svgo-example" class="btn-secondary" type="button">{T.example}</button>
    <button id="svgo-clear" class="btn-ghost" type="button">{T.clear}</button>
  </div>

  <div class="svgo-options" role="group" aria-labelledby="svgo-settings-h">
    <span class="svgo-opt">
      <span id="svgo-settings-h" class="svgo-label">{T.settings}</span>
      <Toggletip id="svgo-tip-settings" lang={lang} about={T.settings} wide>{TIPS.settings}</Toggletip>
    </span>
    {MAIN_PLUGINS.map((p) => (
      <label class="svgo-toggle"><input type="checkbox" data-plugin={p} /><span>{T.p[p]}</span>{RISKY.has(p) && <span class="svgo-warn" aria-hidden="true">!</span>}</label>
    ))}
    <label class="svgo-toggle"><input type="checkbox" id="svgo-multipass" /><span>{T.multipass}</span></label>
    <label class="svgo-toggle"><input type="checkbox" id="svgo-pretty" /><span>{T.pretty}</span></label>
    <span class="svgo-opt">
      <label for="svgo-precision" class="svgo-field">{T.precision} <output id="svgo-precision-val" class="svgo-num">3</output></label>
      <input id="svgo-precision" class="svgo-range" type="range" min="0" max="8" step="1" value="3" />
      <Toggletip id="svgo-tip-precision" lang={lang} about={T.precision} wide>{TIPS.precision}</Toggletip>
    </span>
    <span class="svgo-opt">
      <label for="svgo-prefix" class="svgo-field">{T.prefix}</label>
      <input id="svgo-prefix" class="tool-input svgo-prefix" type="text" maxlength="40" spellcheck="false" autocomplete="off" placeholder={T.prefixPh} />
      <Toggletip id="svgo-tip-prefix" lang={lang} about={T.prefix} wide>{TIPS.prefix}</Toggletip>
    </span>
    <button id="svgo-reset" class="btn-ghost svgo-reset" type="button">{T.reset}</button>
  </div>

  <div id="svgo-status" class="tool-status svgo-status" role="status" aria-live="polite"></div>
  <button id="svgo-retry" class="btn-secondary svgo-retry" type="button" hidden>{T.retry}</button>

  <div class="svgo-panels zt-io">
    <div class="svgo-input svgo-pane zt-io-pane">
      <label class="svgo-drop" id="svgo-drop" for="svgo-file">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        <span class="svgo-drop-text">
          <span class="svgo-drop-title">{T.dropTitle}</span>
          <span class="svgo-drop-hint">{T.dropHint}</span>
        </span>
      </label>
      <input id="svgo-file" class="svgo-sr" type="file" accept=".svg,.svgz,image/svg+xml" multiple />
      <div class="svgo-head">
        <label for="svgo-input" class="svgo-label">{T.codeLabel}</label>
        <Toggletip id="svgo-tip-input" lang={lang} about={T.codeLabel} wide>{TIPS.input}</Toggletip>
      </div>
      <textarea id="svgo-input" class="tool-textarea svgo-code-in zt-io-fill" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder={T.codePh}></textarea>

      <section id="svgo-batch" class="svgo-batch" hidden>
        <div class="svgo-table-wrap">
          <table class="svgo-table">
            <thead><tr><th scope="col">{T.thFile}</th><th scope="col">{T.thBefore}</th><th scope="col">{T.thAfter}</th><th scope="col">{T.thSaved}</th><th scope="col">{T.thCheck}</th><th scope="col"><span class="svgo-sr">{T.thSave}</span></th></tr></thead>
            <tbody id="svgo-rows"></tbody>
          </table>
        </div>
        <button id="svgo-zip" class="btn-secondary" type="button">{T.zip}</button>
      </section>
    </div>

    <div class="svgo-pane svgo-pane--out zt-io-pane">
      <div class="svgo-head">
        <span id="svgo-out-label" class="svgo-label">{T.outLabel}</span>
        <Toggletip id="svgo-tip-result" lang={lang} about={T.outLabel} wide>{TIPS.result}</Toggletip>
      </div>
      <div class="svgo-out zt-io-fill" role="group" aria-labelledby="svgo-out-label">
        <p class="svgo-empty">{T.outEmpty}</p>
        <section id="svgo-result" class="svgo-result" hidden>
          <div class="svgo-summary">
            <span id="svgo-sizes" class="svgo-sizes"></span>
            <span id="svgo-saved" class="svgo-saved"></span>
            <span id="svgo-gzip" class="svgo-gzip"></span>
            <span id="svgo-engine" class="svgo-engine"></span>
          </div>
          <div class="svgo-out-actions">
            <button id="svgo-download" class="btn-secondary" type="button">{T.download}</button>
            <button id="svgo-copy" class="btn-copy" type="button">{T.copy}</button>
            <span class="svgo-opt svgo-format-opt">
              <label class="svgo-format">
                <span>{T.copyAs}</span>
                <select id="svgo-format" class="tool-input">
                  <option value="svg">{T.fmtSvg}</option>
                  <option value="uri">{T.fmtUri}</option>
                  <option value="base64">{T.fmtBase64}</option>
                  <option value="css">{T.fmtCss}</option>
                  <option value="jsx">{T.fmtJsx}</option>
                </select>
              </label>
              <Toggletip id="svgo-tip-format" lang={lang} about={T.copyAs} wide>{TIPS.format}</Toggletip>
            </span>
          </div>
          <p id="svgo-jsx-refused" class="svgo-jsx-refused" hidden></p>
          <p id="svgo-check" class="svgo-check" aria-live="polite"></p>
          <div class="svgo-compare">
            <figure class="svgo-fig">
              <figcaption>{T.before}</figcaption>
              <div class="svgo-preview"><img id="svgo-img-before" alt={T.before} /></div>
            </figure>
            <figure class="svgo-fig">
              <figcaption>{T.after}</figcaption>
              <div class="svgo-preview"><img id="svgo-img-after" alt={T.after} /></div>
            </figure>
            <figure id="svgo-fig-diff" class="svgo-fig" hidden>
              <figcaption>{T.diff}</figcaption>
              <div class="svgo-preview svgo-preview--plain"><canvas id="svgo-diff"></canvas></div>
            </figure>
          </div>
          <ul id="svgo-notes" class="svgo-notes"></ul>
          <details class="svgo-code" id="svgo-code-box">
            <summary id="svgo-code-summary"></summary>
            <p id="svgo-jsx-note" class="svgo-jsx-note" hidden>{T.jsxNote}</p>
            <pre class="svgo-pre"><code id="svgo-code"></code></pre>
          </details>
        </section>
      </div>
    </div>
  </div>

  <div class="svgo-more">
    <details class="svgo-all">
      <summary>{T.allPlugins}</summary>
      <h3 class="svgo-sub">{fill(T.presetHead, { n: PRESET_PLUGINS.length })}</h3>
      <div class="svgo-plugin-grid">
        {PRESET_PLUGINS.map((p) => (
          <label class="svgo-plugin"><input type="checkbox" data-plugin={p} /><code>{p}</code></label>
        ))}
      </div>
      <h3 class="svgo-sub">{T.extraHead}</h3>
      <div class="svgo-plugin-grid">
        {EXTRA_PLUGINS.map((p) => (
          <label class="svgo-plugin"><input type="checkbox" data-plugin={p} /><code>{p}</code></label>
        ))}
      </div>
      <p class="svgo-hint">{fill(T.paramNote, { names: PARAM_PLUGINS.join(', ') })}</p>
    </details>
    <details class="svgo-all">
      <summary>{T.configHead}</summary>
      <pre class="svgo-pre"><code id="svgo-config"></code></pre>
      <button id="svgo-copy-config" class="btn-copy" type="button">{T.copyConfig}</button>
    </details>
  </div>
</div>

<script>
  // @ts-nocheck
  import SvgoWorker from './svg-optimizer.worker.js?worker';
  import { runSvgo } from './svg-optimizer-run.js';

  /* ── engine:start ── */
  // ── copied verbatim from SvgToPngConverterTool.astro (scripts/test-svg-optimizer.mjs compares the source) ──
  var SVG_NS = 'http://www.w3.org/2000/svg';

  var XLINK_NS = 'http://www.w3.org/1999/xlink';

  var ABS_UNITS = { '': 1, px: 1, in: 96, cm: 96 / 2.54, mm: 96 / 25.4, q: 96 / 101.6, pt: 4 / 3, pc: 16 };

  function hasOwn(o, k) { return Object.prototype.hasOwnProperty.call(o, k); }

  function parseLength(value, fontSize) {
    if (value == null) return null;
    var s = String(value).trim();
    if (s === '' || s.toLowerCase() === 'auto') return null;
    var m = /^([+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?)([a-z%]*)$/i.exec(s);
    if (!m) return { px: null, unit: s };
    var n = parseFloat(m[1]);
    var unit = m[2].toLowerCase();
    var px;
    if (hasOwn(ABS_UNITS, unit)) px = n * ABS_UNITS[unit];
    else if (unit === 'em') px = n * fontSize;
    else if (unit === 'rem') px = n * 16;
