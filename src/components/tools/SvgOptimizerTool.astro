  // An empty src resolves to the page URL and fires an error event, so a missing preview removes the attribute.
  function showPreview(img, url) {
    if (url) {
      if (img.getAttribute('src') !== url) img.src = url;
      img.hidden = false;
    } else {
      img.removeAttribute('src');
      img.hidden = true;
    }
  }

  function renderActive() {
    var item = items[active];
    if (!item || item.data == null) {
      resultEl.hidden = true;
      if (item && item.error && items.length > 1) setStatus(errorText(item.error), 'error');
      return;
    }
    resultEl.hidden = false;
    renderSummary(item);
    notesEl.replaceChildren();
    item.notes.forEach(function (n) {
      var li = document.createElement('li');
      li.textContent = noteText(n);
      li.className = 'svgo-note svgo-note--' + n.code;
      notesEl.appendChild(li);
    });
    notesEl.hidden = !item.notes.length;
    var c = item.check;
    var state = c ? c.state : 'pending';
    var vars = {};
    if (c && c.plan) { vars.w = c.plan.width; vars.h = c.plan.height; }
    if (c && c.cmp) vars.pct = nf(c.cmp.ratio * 100, 2);
    checkEl.textContent = fill(T.check[state], vars);
    checkEl.className = 'svgo-check svgo-check--' + state;
    showPreview(imgBefore, c && c.beforeUrl);
    showPreview(imgAfter, c && c.afterUrl);
    if (c && c.diff) {
      diffCanvas.width = c.plan.width; diffCanvas.height = c.plan.height;
      diffCanvas.getContext('2d').putImageData(new ImageData(c.diff, c.plan.width, c.plan.height), 0, 0);
      diffFig.hidden = false;
    } else diffFig.hidden = true;
    var out = outputText(item);
    // A refused JSX export clears the code and disables Copy; Download still saves item.data.
    copyBtn.disabled = !!out.error;
    jsxRefusedEl.hidden = !out.error;
    jsxRefusedEl.textContent = out.error ? refusalText(out.error) : '';
    codeEl.textContent = out.text.length > 200000 ? out.text.slice(0, 200000) + '\n…' : out.text;
    codeSummary.textContent = fill(T.code, { chars: nf(out.text.length) });
    jsxNote.hidden = settings.format !== 'jsx';
  }

  function checkLabel(item) {
    if (item.error) return T.rowError;
    var s = item.check ? item.check.state : 'pending';
    if (s === 'same') return T.rowSame;
    if (s === 'minor') return T.rowMinor;
    if (s === 'changed') return T.rowChanged;
    if (s === 'pending') return T.rowPending;
    return T.rowFailed;
  }

  function renderRow(item) {
    if (items.length < 2) return;
    var index = items.indexOf(item);
    if (index < 0) return;
    var tr = rowsEl.children[index];
    if (!tr || tr.dataset.index !== String(index)) { renderRows(); return; }
    var cells = tr.children;
    cells[1].textContent = item.text != null ? formatBytes(utf8Length(item.text)) : '—';
    cells[2].textContent = item.data != null ? formatBytes(item.after) : '—';
    cells[3].textContent = item.data != null ? formatDelta(item.before, item.after) : '';
    cells[4].textContent = checkLabel(item);
    cells[4].title = item.error ? errorText(item.error) : '';
    cells[5].firstChild.disabled = item.data == null;
  }

  function renderRows() {
    rowsEl.replaceChildren();
    if (items.length < 2) return;
    items.forEach(function (item, index) {
      var tr = document.createElement('tr');
      tr.dataset.index = String(index);
      if (index === active) tr.className = 'svgo-row--active';
      var nameTd = document.createElement('td');
      var pick = document.createElement('button');
      pick.type = 'button';
      pick.className = 'svgo-pick';
      pick.textContent = item.name;
      pick.addEventListener('click', function () { active = index; renderRows(); renderActive(); });
      nameTd.appendChild(pick);
      tr.appendChild(nameTd);
      for (var k = 0; k < 4; k++) tr.appendChild(document.createElement('td'));
      var dl = document.createElement('td');
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn-sm svgo-row-dl';
      btn.textContent = '.svg';
      btn.setAttribute('aria-label', T.download + ' ' + item.name);
      btn.addEventListener('click', function () { if (item.data != null) saveBlob(new Blob([item.data], { type: 'image/svg+xml' }), outputName(item.name)); });
      dl.appendChild(btn);
      tr.appendChild(dl);
      rowsEl.appendChild(tr);
    });
    items.forEach(renderRow);
  }

  function saveBlob(blob, name) {
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
