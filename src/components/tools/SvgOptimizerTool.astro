  downloadBtn.addEventListener('click', function () {
    var item = items[active];
    if (!item || item.data == null) return;
    saveBlob(new Blob([item.data], { type: 'image/svg+xml' }), outputName(item.name));
    if (window.trackTool) window.trackTool(SLUG, 'download');
  });
  copyBtn.addEventListener('click', function () {
    var item = items[active];
    if (!item || item.data == null) return;
    var out = outputText(item);
    if (out.error) { copyBtn.disabled = true; setStatus(refusalText(out.error), 'error'); return; }
