      if (failed) msg += ' ' + fill(T.failedMany, { n: failed });
      setStatus(msg, ok.length ? (failed ? 'info' : 'success') : 'error');
    }
    if (skipped.length) setStatus(statusEl.textContent + ' ' + fill(T.note.skipped, { names: shortList(skipped) }), 'info');
    // SVGO did not load (worker and main-thread import both failed): offer to run the same input again.
    retryBtn.hidden = !items.some(function (x) { return x.error && x.error.code === 'load'; });
    batchEl.hidden = items.length < 2;
    configEl.textContent = configSource(settings, svgoVersion);
    renderActive();
    if (ok.length && window.trackTool && Date.now() - lastTrack > 5000) { lastTrack = Date.now(); window.trackTool(SLUG, 'optimize'); }
    var r = resultEl.hidden ? statusEl : resultEl;
    var box = r.getBoundingClientRect();
    if (box.top > window.innerHeight - 80) r.scrollIntoView({ block: 'start', behavior: 'smooth' });
    // Rendering checks, one file at a time, the shown one first.
    var order = items.slice(active).concat(items.slice(0, active)).filter(function (x) { return x.data != null; });
    (function nextCheck() {
      if (my !== gen || !order.length) return;
      var item = order.shift();
      renderCheck(item).then(function () {
        if (my !== gen) return;
        renderRow(item);
        if (item === items[active]) renderActive();
        nextCheck();
      });
    })();
    if (ok.length) ok.forEach(function (x) {
      Promise.all([gzipSize(x.text), gzipSize(x.data)]).then(function (g) {
        if (my !== gen) return;
        x.gzipBefore = g[0]; x.gzipAfter = g[1];
        if (x === items[active]) renderSummary(x);
      });
    });
  }

  // ── rendering check ──
  function loadImage(svg) {
    return new Promise(function (resolve, reject) {
      var url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
      var img = new Image();
      img.onload = function () { resolve({ img: img, url: url }); };
      img.onerror = function () { URL.revokeObjectURL(url); reject(new Error('render')); };
      img.src = url;
    });
