  document.addEventListener('keydown', function (e) {
    if (!(e.metaKey || e.ctrlKey) || (e.key !== 'l' && e.key !== 'L')) return;
    if (!wrap.contains(document.activeElement)) return;
    setTimeout(function () { prefixEl.value = settings.prefix; resetView(); }, 0);
  });

  syncSettingsUi();
</script>

<style>
  /* v2 "convert" layout: the root is a flex column, so the two panes (.zt-io in
     tool-common.css) take the height that is left under the toolbar, the settings and
     the status line. Left: drop zone, code box and the file table. Right: the result. */
  .svgo-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; min-height: 0; }
  .svgo-wrap [hidden] { display: none !important; }
  .svgo-sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .svgo-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .svgo-options { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 1.1rem; font-size: 0.86rem; }
  .svgo-options > * { flex: none; }
  .svgo-opt { display: inline-flex; align-items: center; gap: 0.35rem; min-width: 0; }
  .svgo-label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .svgo-field { flex: none; font-size: 0.86rem; color: var(--color-text); white-space: nowrap; }
  .svgo-toggle { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 28px; font-size: 0.86rem; color: var(--color-text); cursor: pointer; }
  .svgo-toggle input { flex: none; }
  .svgo-warn {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--color-accent); color: var(--color-primary-contrast); font-size: 0.68rem; font-weight: 800;
  }
  .svgo-num { font-family: var(--font-mono); font-weight: 750; color: var(--color-primary); margin-left: 0.2rem; }
  /* Two classes: the shared .tool-widget input rules set width: 100%. */
  .svgo-opt .svgo-range { flex: none; width: 7rem; }
  .svgo-opt .svgo-prefix { flex: none; width: 8.5rem; min-height: 34px; padding: 0.25rem 0.5rem; font-size: 0.82rem; }
  .svgo-reset { margin-left: auto; font-size: 0.8rem; min-height: 32px; padding: 0.2rem 0.75rem; }
  .svgo-status { overflow-wrap: anywhere; }
  .svgo-status:empty { display: none; }
  .svgo-retry { align-self: flex-start; flex: none; }

  .svgo-head { display: flex; align-items: center; gap: 0.25rem; min-height: 32px; }

  /* Left pane */
  .svgo-drop {
    display: flex; align-items: center; gap: 0.8rem; flex: none;
    padding: 0.6rem 1rem;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }
  .svgo-drop:hover, .svgo-drop--over { border-color: var(--color-primary); background: var(--color-surface); }
  .svgo-wrap:has(.svgo-sr:focus-visible) .svgo-drop { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .svgo-drop svg { flex: none; color: var(--color-primary); }
  .svgo-drop-text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .svgo-drop-title { font-weight: 700; color: var(--color-text); font-size: 0.95rem; }
  .svgo-drop-hint { font-size: 0.8rem; line-height: 1.4; }
  .svgo-code-in { font-size: 0.82rem; }

  /* Several files: the table takes the pane's height and scrolls; the code box (empty
     after files are loaded) keeps a short strip for pasting. */
  .svgo-batch { display: flex; flex: 1 1 0; flex-direction: column; gap: 0.5rem; align-items: flex-start; min-height: 150px; }
  .svgo-input:has(.svgo-batch:not([hidden])) .svgo-code-in { flex: none; min-height: 0; height: 64px; }
  .svgo-table-wrap { position: relative; flex: 1 1 0; width: 100%; min-height: 0; overflow: auto; border-radius: var(--radius-sm); box-shadow: inset 0 0 0 1px var(--color-border-soft); }
  .svgo-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .svgo-table th, .svgo-table :global(td) { padding: 0.35rem 0.5rem; text-align: left; border-bottom: 1px solid var(--color-border-soft); white-space: nowrap; }
  .svgo-table th { position: sticky; top: 0; z-index: 1; background: var(--color-surface-muted); font-size: 0.75rem; color: var(--color-text-secondary); font-weight: 700; }
  .svgo-table :global(td:nth-child(2)), .svgo-table :global(td:nth-child(3)), .svgo-table :global(td:nth-child(4)) { font-family: var(--font-mono); }
  .svgo-table :global(.svgo-row--active td) { background: var(--color-surface-muted); }
  .svgo-table :global(.svgo-pick) {
    background: none; border: 0; padding: 0; font: inherit; color: var(--color-primary); cursor: pointer;
    text-decoration: underline; text-underline-offset: 2px; max-width: 14rem; overflow: hidden; text-overflow: ellipsis; text-align: left;
  }

  /* Right pane: one framed box that scrolls when the result is taller than the pane. */
  /* flex-basis 0: the result never makes the pane taller than the first screen leaves it. */
  .svgo-out {
    display: flex; flex-direction: column; overflow: auto;
    padding: 0.82rem; border-radius: var(--radius-md);
    background: var(--color-bg-secondary); box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }
  .svgo-out:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 1px; }
  /* Shown until there is a result (at 860px and below the whole pane is hidden instead). */
  .svgo-empty { max-width: 36ch; margin: auto; text-align: center; font-size: 0.88rem; line-height: 1.55; color: var(--color-text-muted); }
  .svgo-out:has(.svgo-result:not([hidden])) .svgo-empty { display: none; }
