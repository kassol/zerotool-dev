      var len = parseLength(raw, fontSize);
      if (len && len.px == null) notes.push({ code: 'relativeSize', attr: name, value: String(raw).trim() });
      return len && len.px != null ? len.px : null;
    }
    var w = dim('width');
    var h = dim('height');
    var vb = parseViewBox(attrs.viewBox);
    var source = 'size';
    if (w == null || h == null) {
