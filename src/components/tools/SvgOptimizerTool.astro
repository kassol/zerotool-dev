  // ── output ──
  // { text, error }: a JSX refusal is data here, so it cannot stop the batch or a download.
  function outputText(item) { return tryFormatOutput(settings.format, item.data, item.name || 'icon.svg'); }
  function refusalText(error) {
    return fill(T.jsxRefused, { position: error.position + 1, reason: T.jsxReasons[error.code] || T.jsxReasons.syntax });
  }

  function renderSummary(item) {
    sizesEl.textContent = formatBytes(item.before) + ' → ' + formatBytes(item.after);
    savedEl.textContent = formatDelta(item.before, item.after);
    savedEl.className = 'svgo-saved' + (item.after >= item.before ? ' svgo-saved--up' : '');
    gzipEl.textContent = item.gzipBefore && item.gzipAfter ? fill(T.gzip, { before: formatBytes(item.gzipBefore), after: formatBytes(item.gzipAfter) }) : '';
    engineEl.textContent = svgoVersion ? fill(T.engine, { v: svgoVersion }) : '';
