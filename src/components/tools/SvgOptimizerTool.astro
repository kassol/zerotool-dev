      else if (c === '[') depth++;
      else if (c === ']') depth--;
      else if (c === '>' && depth <= 0) return j + 1;
    }
    return src.length;
  }

  var TAG_NAME = /[A-Za-z_][\w.\-]*(?::[\w.\-]+)?/y;

  var ATTR_NAME = /[^\s=\/>]+/y;

  var SPACE = /\s/;

  function readStartTag(src, i) {
    TAG_NAME.lastIndex = i + 1;
    var m = TAG_NAME.exec(src);
    if (!m) return null;
    var n = src.length;
    var tag = { name: m[0], start: i, attrs: [], selfClosing: false, closeStart: n, end: n };
    var j = i + 1 + m[0].length;
