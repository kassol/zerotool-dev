    if (src.charCodeAt(0) === 0xFEFF) src = src.slice(1);
    if (!src.trim()) return { error: { code: 'empty' } };
    var tags = scanMarkup(src);
    if (!tags.length) return { error: { code: 'notSvg' } };
    var root = tags[0];
