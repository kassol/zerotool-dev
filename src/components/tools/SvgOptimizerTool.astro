  });
  copyConfigBtn.addEventListener('click', function () { copyText(configSource(settings, svgoVersion), copyConfigBtn, T.copyConfig); });
  zipBtn.addEventListener('click', function () {
    var ok = items.filter(function (x) { return x.data != null; });
    if (!ok.length) return;
    var enc = new TextEncoder();
    var names = uniqueNames(ok.map(function (x) { return outputName(x.name); }));
    saveBlob(new Blob([zipStore(ok.map(function (x, i) { return { name: names[i], data: enc.encode(x.data) }; }))], { type: 'application/zip' }), 'svgo-optimized.zip');
    if (window.trackTool) window.trackTool(SLUG, 'zip');
  });

  function resetView() {
    gen++;
    clearTimeout(timer);
    items = []; skipped = []; active = 0;
    blobUrls.forEach(function (u) { URL.revokeObjectURL(u); });
    blobUrls = [];
    resultEl.hidden = true;
    batchEl.hidden = true;
    rowsEl.replaceChildren();
    setStatus('', '');
    retryBtn.hidden = true;
  }

  // ── input ──
  var typing = null;
  inputEl.addEventListener('input', function () {
    clearTimeout(typing);
    typing = setTimeout(function () {
      if (!inputEl.value.trim()) { resetView(); return; }
      itemsFromText(inputEl.value);
      run();
