      while (j < n && SPACE.test(src.charAt(j))) j++;
      var c = src.charAt(j);
      if (c === '>') { tag.closeStart = j; tag.end = j + 1; return tag; }
      if (c === '/' && src.charAt(j + 1) === '>') { tag.closeStart = j; tag.end = j + 2; tag.selfClosing = true; return tag; }
      ATTR_NAME.lastIndex = j;
      var am = ATTR_NAME.exec(src);
      if (!am) { j++; continue; }
      var start = j;
      j += am[0].length;
      var k = j;
      while (k < n && SPACE.test(src.charAt(k))) k++;
      if (src.charAt(k) !== '=') { tag.attrs.push({ name: am[0], value: '', rawValue: '', quote: '', start: start, end: j }); continue; }
      k++;
      while (k < n && SPACE.test(src.charAt(k))) k++;
      var q = src.charAt(k), raw, end;
      if (q === '"' || q === "'") {
        var close = src.indexOf(q, k + 1);
        if (close < 0) close = n;
        raw = src.slice(k + 1, close);
        end = Math.min(n, close + 1);
      } else {
