    if (!(px > 0) || !isFinite(px)) return { px: null, unit: 'invalid' };
    return { px: px };
  }

  function parseStyle(style) {
    var out = {};
    String(style || '').split(';').forEach(function (decl) {
      var i = decl.indexOf(':');
      if (i < 0) return;
      var key = decl.slice(0, i).trim().toLowerCase();
      var value = decl.slice(i + 1).replace(/!important\s*$/i, '').trim();
      if (key) out[key] = value;
    });
    return out;
  }

  function parseViewBox(value) {
    if (value == null) return null;
    var parts = String(value).trim().split(/[\s,]+/);
    if (parts.length !== 4) return null;
    var n = parts.map(Number);
    if (n.some(function (x) { return !isFinite(x); })) return null;
    if (!(n[2] > 0) || !(n[3] > 0)) return null;
