  function pixels(img, w, h) {
    var c = document.createElement('canvas');
    c.width = w; c.height = h;
    var ctx = c.getContext('2d', { willReadFrequently: true });
    ctx.drawImage(img, 0, 0, w, h);
    return ctx.getImageData(0, 0, w, h).data;
  }
  function renderCheck(item) {
    item.check = { state: 'pending' };
    if (item.before > CHECK_MAX_BYTES || item.after > CHECK_MAX_BYTES) { item.check = { state: 'skipped' }; return Promise.resolve(); }
    var aBefore = item.prep.analysis;
    var aAfter = analyzeSvg(item.data);
    var plan = renderPlan(aBefore.size);
    var beforeSvg = buildSvg(item.prep.text, aBefore, plan);
    var afterSvg = aAfter.error ? null : buildSvg(item.data, aAfter, plan);
    return Promise.allSettled([loadImage(beforeSvg), afterSvg ? loadImage(afterSvg) : Promise.reject(new Error('render'))]).then(function (res) {
      var b = res[0].status === 'fulfilled' ? res[0].value : null;
      var a = res[1].status === 'fulfilled' ? res[1].value : null;
      item.check = { state: 'pending', plan: plan, beforeUrl: b && b.url, afterUrl: a && a.url };
      if (b) blobUrls.push(b.url);
      if (a) blobUrls.push(a.url);
      if (!b) { item.check.state = 'beforeFailed'; return; }
      if (!a) { item.check.state = 'afterFailed'; return; }
      try {
        var pa = pixels(b.img, plan.width, plan.height);
        var pb = pixels(a.img, plan.width, plan.height);
