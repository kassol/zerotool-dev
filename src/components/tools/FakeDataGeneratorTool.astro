---
import Toggletip from '../Toggletip.astro';
// FakeDataGeneratorTool — generate fake/mock data in JSON or CSV format
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
// strings:start
const STRINGS = {
    en: { empty: "Select fields and generate data to see the result here.", tips: {"fields": "Only checked fields are generated; fields use independent English lists or random values.", "count": "Each Generate creates 1–100 records. An empty value or zero uses 10; other values keep their whole-number part within 1–100, and the field then shows the number used.", "format": "JSON or CSV is used by the next Generate; changing the format keeps the current result and its download format.", "generate": "Generate creates fresh random values from the selected fields; select at least one field.", "export": "Copy copies the complete current result; Download saves the format used when that result was generated."}, dataFields: 'Data Fields', fullName: 'Full Name', firstName: 'First Name', lastName: 'Last Name', email: 'Email', phone: 'Phone', company: 'Company', street: 'Street', city: 'City', state: 'State', zip: 'Zip Code', country: 'Country', uuid: 'UUID', date: 'Date', ip: 'IP Address', url: 'URL', color: 'Color (Hex)', lorem: 'Lorem Sentence', count: 'Count', format: 'Format', generate: 'Generate', copy: 'Copy', download: 'Download', copied: 'Copied!', downloaded: 'Downloaded!', noField: '⚠ Select at least one field.', placeholder: 'Select fields and click Generate…', copyFailed: 'Copy failed', countNote: 'Enter a whole number from 1 to 100. Records generated: {n}.' },
    zh: { empty: "选择字段并生成数据，结果会显示在这里。", tips: {"fields": "只生成已勾选字段；各字段独立使用英文词表或随机值。", "count": "每次生成 1–100 条记录。空值或 0 使用 10；其他值取整数部分并限制在 1–100 内，输入框随后显示实际条数。", "format": "JSON 或 CSV 用于下次生成；切换格式会保留当前结果及其下载格式。", "generate": "生成会根据已选字段创建新的随机值；至少选择一个字段。", "export": "复制会复制完整当前结果；下载使用生成该结果时的格式。"}, dataFields: '数据字段', fullName: '全名', firstName: '名', lastName: '姓', email: '邮箱', phone: '电话', company: '公司', street: '街道', city: '城市', state: '州/省', zip: '邮编', country: '国家', uuid: 'UUID', date: '日期', ip: 'IP 地址', url: 'URL', color: '颜色 (Hex)', lorem: '示例句子', count: '数量', format: '格式', generate: '生成', copy: '复制', download: '下载', copied: '已复制！', downloaded: '已下载！', noField: '⚠ 请至少选择一个字段。', placeholder: '选择字段后点击生成…', copyFailed: '复制失败', countNote: '数量须为 1–100 的整数，本次生成了 {n} 条。' },
    ja: { empty: "フィールドを選び生成すると、ここに結果を表示します。", tips: {"fields": "選択したフィールドだけを生成します。各フィールドは独立した英語のリストや乱数を使います。", "count": "1回で1–100件を生成します。空欄や0は10件になり、ほかの値は整数部分を1–100の範囲に収めて使います。そのときは入力欄にも実際の件数が入ります。", "format": "JSONまたはCSVは次の生成に使われます。切り替えても現在の結果と保存形式は変わりません。", "generate": "選択したフィールドで新しい乱数データを生成します。1つ以上のフィールドを選択してください。", "export": "コピーは現在の結果全体を取得します。ダウンロードはその結果を生成した時の形式で保存します。"}, dataFields: 'データフィールド', fullName: 'フルネーム', firstName: '名', lastName: '姓', email: 'メール', phone: '電話', company: '会社', street: '番地', city: '市区町村', state: '都道府県', zip: '郵便番号', country: '国', uuid: 'UUID', date: '日付', ip: 'IPアドレス', url: 'URL', color: 'カラー (Hex)', lorem: 'サンプル文章', count: '件数', format: 'フォーマット', generate: '生成', copy: 'コピー', download: 'ダウンロード', copied: 'コピー済み！', downloaded: 'ダウンロード済み！', noField: '⚠ フィールドを1つ以上選択してください。', placeholder: 'フィールドを選択して生成をクリック…', copyFailed: 'コピーに失敗しました', countNote: '件数は 1〜100 の整数で指定してください。今回は {n} 件を生成しました。' },
    ko: { empty: "필드를 선택하고 생성하면 여기에 결과가 표시됩니다.", tips: {"fields": "선택한 필드만 생성합니다. 각 필드는 독립적인 영어 목록이나 난수를 사용합니다.", "count": "한 번에 1–100개를 생성합니다. 빈 값이나 0은 10개를 사용하고, 그 밖의 값은 정수 부분만 1–100 범위 안으로 맞춰 쓰며 입력란에도 실제 개수가 표시됩니다.", "format": "JSON 또는 CSV는 다음 생성에 적용됩니다. 형식을 바꿔도 현재 결과와 다운로드 형식은 유지됩니다.", "generate": "선택한 필드로 새 난수 데이터를 생성합니다. 필드를 하나 이상 선택하세요.", "export": "복사는 현재 결과 전체를 복사합니다. 다운로드는 그 결과를 생성할 때의 형식으로 저장합니다."}, dataFields: '데이터 필드', fullName: '전체 이름', firstName: '이름', lastName: '성', email: '이메일', phone: '전화', company: '회사', street: '거리', city: '도시', state: '주/도', zip: '우편번호', country: '국가', uuid: 'UUID', date: '날짜', ip: 'IP 주소', url: 'URL', color: '색상 (Hex)', lorem: '예시 문장', count: '개수', format: '형식', generate: '생성', copy: '복사', download: '다운로드', copied: '복사됨!', downloaded: '다운로드됨!', noField: '⚠ 필드를 하나 이상 선택하세요.', placeholder: '필드를 선택하고 생성을 클릭하세요…', copyFailed: '복사 실패', countNote: '개수는 1~100 사이의 정수로 입력하세요. 이번에는 {n}개를 생성했습니다.' }
  };
// strings:end
const L = STRINGS[lang] || STRINGS.en;
const CLIENT_T = Object.fromEntries(['copy','download','copied','downloaded','noField','copyFailed','countNote'].map(key => [key, L[key]]));
---

<div class="fdg-wrap" data-empty="true" data-strings={JSON.stringify(CLIENT_T)}>
  <div class="fdg-main">
    <div class="fdg-controls zt-rail">
      <div class="fdg-actions">
        <div class="fdg-action-group"><button id="fdg-generate" class="btn-primary">{L.generate}</button><Toggletip id="fdg-tip-generate" lang={lang} about={L.generate}>{L.tips.generate}</Toggletip></div>
        <div class="fdg-action-group"><button id="fdg-copy" class="btn-secondary">{L.copy}</button><Toggletip id="fdg-tip-export" lang={lang} about={L.copy}>{L.tips.export}</Toggletip></div>
        <button id="fdg-download" class="btn-ghost">{L.download}</button>
      </div>
      <div id="fdg-status" class="fdg-status" aria-live="polite"></div>
      <div class="fdg-row">
        <div class="fdg-field"><div class="fdg-label-row"><label class="fdg-label" for="fdg-count">{L.count}</label><Toggletip id="fdg-tip-count" lang={lang} about={L.count}>{L.tips.count}</Toggletip></div><input type="number" id="fdg-count" value="10" min="1" max="100" /></div>
        <div class="fdg-field"><div class="fdg-label-row"><span class="fdg-label">{L.format}</span><Toggletip id="fdg-tip-format" lang={lang} about={L.format}>{L.tips.format}</Toggletip></div><div class="fdg-format-btns"><button class="fdg-fmt active" data-fmt="json">JSON</button><button class="fdg-fmt" data-fmt="csv">CSV</button></div></div>
      </div>
      <div class="fdg-section">
        <div class="fdg-label-row"><span class="fdg-section-title">{L.dataFields}</span><Toggletip id="fdg-tip-fields" lang={lang} about={L.dataFields}>{L.tips.fields}</Toggletip></div>
      <div class="fdg-checkboxes" id="fdg-fields">
        <label class="fdg-cb"><input type="checkbox" value="fullName" checked /> <span>{L.fullName}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="firstName" /> <span>{L.firstName}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="lastName" /> <span>{L.lastName}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="email" checked /> <span>{L.email}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="phone" /> <span>{L.phone}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="company" /> <span>{L.company}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="street" /> <span>{L.street}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="city" /> <span>{L.city}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="state" /> <span>{L.state}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="zip" /> <span>{L.zip}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="country" /> <span>{L.country}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="uuid" /> <span>{L.uuid}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="date" /> <span>{L.date}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="ip" /> <span>{L.ip}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="url" /> <span>{L.url}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="color" /> <span>{L.color}</span></label>
        <label class="fdg-cb"><input type="checkbox" value="lorem" /> <span>{L.lorem}</span></label>
      </div>
      </div>
    </div>
    <div class="fdg-result">
      <p class="fdg-empty">{L.empty}</p>
      <textarea id="fdg-output" readonly spellcheck="false" placeholder={L.placeholder}></textarea>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  var root = document.querySelector('.fdg-wrap');
  var t = JSON.parse(root.dataset.strings);

  var FIRST = ['James','John','Robert','Michael','William','David','Richard','Joseph','Thomas','Charles','Mary','Patricia','Jennifer','Linda','Barbara','Susan','Jessica','Sarah','Karen','Lisa','Daniel','Matthew','Anthony','Mark','Donald','Steven','Paul','Andrew','Kenneth','Joshua','Emma','Olivia','Sophia','Ava','Isabella','Mia','Charlotte','Amelia','Harper','Evelyn'];
  var LAST = ['Smith','Johnson','Williams','Brown','Jones','Garcia','Miller','Davis','Rodriguez','Martinez','Hernandez','Lopez','Gonzalez','Wilson','Anderson','Thomas','Taylor','Moore','Jackson','Martin','Lee','Perez','Thompson','White','Harris','Sanchez','Clark','Ramirez','Lewis','Robinson'];
  var DOMAINS = ['gmail.com','yahoo.com','outlook.com','example.com','mail.com','proton.me','icloud.com','hotmail.com'];
  var COMPANIES = ['Acme Corp','Globex','Initech','Umbrella Ltd','Hooli','Pied Piper','Wayne Enterprises','Stark Industries','Cyberdyne Systems','Weyland-Yutani','Oscorp','Soylent Corp','Aperture Science','Black Mesa','InGen','Massive Dynamic','Veridian Dynamics'];
  var STREETS = ['Oak St','Maple Ave','Pine Rd','Elm Dr','Cedar Blvd','Birch Ln','Walnut Way','Spruce Ct','Ash St','Willow Ave','Main St','First Ave','Park Blvd','Lakeview Dr','Riverside Rd','Sunset Blvd','Highland Ave'];
  var CITIES = ['Springfield','Shelbyville','Riverside','Lakewood','Fairview','Greenville','Centerville','Georgetown','Franklin','Bristol','Arlington','Burlington','Clinton','Durham','Florence'];
  var STATES = ['AL','AK','AZ','AR','CA','CO','CT','DE','FL','GA','HI','ID','IL','IN','IA','KS','KY','LA','ME','MD','MA','MI','MN','MS','MO','MT','NE','NV','NH','NJ','NM','NY','NC','ND','OH','OK','OR','PA','RI','SC','SD','TN','TX','UT','VT','VA','WA','WV','WI','WY'];
  var COUNTRIES = ['United States','Canada','United Kingdom','Australia','Germany','France','Japan','Brazil','India','Mexico','Italy','Spain','Netherlands','Sweden','Norway','Denmark','Finland','Switzerland','Austria','Belgium'];
  var TLDS = ['com','org','net','io','dev','app','co'];
  var PATHS = ['dashboard','profile','settings','api','data','report','analytics','docs','blog','about','contact','signup','login'];
  var LOREM_WORDS = 'lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua ut enim ad minim veniam quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat duis aute irure dolor in reprehenderit voluptate velit esse cillum dolore eu fugiat nulla pariatur excepteur sint occaecat cupidatat non proident sunt in culpa qui officia deserunt mollit anim id est laborum'.split(' ');

  function rand(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
  function randInt(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }
  function pad(n, len) { return String(n).padStart(len, '0'); }

  function genUUID() {
    if (crypto.randomUUID) return crypto.randomUUID();
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
      var r = Math.random() * 16 | 0;
      return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
    });
  }

  var generators = {
    fullName:  function() { return rand(FIRST) + ' ' + rand(LAST); },
    firstName: function() { return rand(FIRST); },
    lastName:  function() { return rand(LAST); },
    email:     function() { return (rand(FIRST) + '.' + rand(LAST) + randInt(10,99)).toLowerCase() + '@' + rand(DOMAINS); },
    phone:     function() { return '(' + randInt(200,999) + ') ' + randInt(200,999) + '-' + pad(randInt(0,9999), 4); },
    company:   function() { return rand(COMPANIES); },
    street:    function() { return randInt(1, 9999) + ' ' + rand(STREETS); },
    city:      function() { return rand(CITIES); },
    state:     function() { return rand(STATES); },
    zip:       function() { return pad(randInt(10000, 99999), 5); },
    country:   function() { return rand(COUNTRIES); },
    uuid:      function() { return genUUID(); },
    date:      function() {
      var y = randInt(2020, 2026), m = randInt(1,12), d = randInt(1,28);
      return y + '-' + pad(m, 2) + '-' + pad(d, 2);
    },
    ip:        function() { return randInt(1,254)+'.'+randInt(0,255)+'.'+randInt(0,255)+'.'+randInt(1,254); },
    url:       function() { return 'https://' + (rand(FIRST)+rand(LAST)).toLowerCase() + '.' + rand(TLDS) + '/' + rand(PATHS); },
    color:     function() { return '#' + pad(randInt(0, 0xFFFFFF).toString(16), 6); },
    lorem:     function() {
      var len = randInt(6, 14);
      var words = [];
      for (var i = 0; i < len; i++) words.push(rand(LOREM_WORDS));
      return words[0].charAt(0).toUpperCase() + words[0].slice(1) + ' ' + words.slice(1).join(' ') + '.';
    }
  };

  var currentFmt = 'json';
  var currentOutput = '';

  function getSelectedFields() {
    var checkboxes = document.querySelectorAll('#fdg-fields input[type=checkbox]:checked');
    var fields = [];
    checkboxes.forEach(function(cb) { fields.push(cb.value); });
    return fields;
  }

  function generateData(fields, count) {
    var rows = [];
    for (var i = 0; i < count; i++) {
      var row = {};
      fields.forEach(function(f) { row[f] = generators[f](); });
      rows.push(row);
    }
    return rows;
  }

  function toCSV(rows, fields) {
    if (!rows.length) return '';
    var lines = [fields.join(',')];
    rows.forEach(function(row) {
      var vals = fields.map(function(f) {
        var v = String(row[f]);
        if (v.indexOf(',') >= 0 || v.indexOf('"') >= 0) v = '"' + v.replace(/"/g, '""') + '"';
        return v;
      });
      lines.push(vals.join(','));
    });
    return lines.join('\n');
  }

  var generatedFmt = 'json';
  var copyVersion = 0;
  var copyTimer;
  var downloadVersion = 0;
  var downloadTimer;
  var copyBtn = document.getElementById('fdg-copy');
  var downloadBtn = document.getElementById('fdg-download');

  /* Selecting the textarea moves focus; it goes back to the button so keyboard users stay in place. */
  function fallbackCopy(text, returnFocus) {
    var ta;
    try {
      ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      return document.execCommand('copy') === true;
    } catch (e) {
      return false;
    } finally {
      if (ta && ta.parentNode) ta.parentNode.removeChild(ta);
      if (returnFocus && typeof returnFocus.focus === 'function') returnFocus.focus();
    }
  }

  function resetCopy() {
    copyVersion++;
    clearTimeout(copyTimer);
    copyBtn.textContent = t.copy;
  }

  function resetExports() {
    resetCopy();
    downloadVersion++;
    clearTimeout(downloadTimer);
    downloadBtn.textContent = t.download;
  }

  document.querySelectorAll('.fdg-fmt').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.fdg-fmt').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      currentFmt = btn.getAttribute('data-fmt');
    });
  });

  document.getElementById('fdg-generate').addEventListener('click', function() {
    resetExports();
    root.dataset.empty = 'false';
    currentOutput = '';
    copyBtn.disabled = true;
    downloadBtn.disabled = true;
    var fields = getSelectedFields();
    if (!fields.length) {
      document.getElementById('fdg-status').textContent = '';
      document.getElementById('fdg-output').value = t.noField;
      return;
    }
    /* Count: whole-number part within 1–100, empty or 0 gives 10; show the number used. */
    var countEl = document.getElementById('fdg-count');
    var typed = countEl.value;
    var count = Math.min(100, Math.max(1, Math.trunc(Number(typed)) || 10));
    var statusEl = document.getElementById('fdg-status');
    if (typed === '' || Number(typed) !== count) {
      countEl.value = String(count);
      statusEl.textContent = t.countNote.replace('{n}', String(count));
    } else {
      /* Same number written differently (1e1, 007): show the plain form, no note. */
      if (typed !== String(count)) countEl.value = String(count);
      statusEl.textContent = '';
    }
    var rows = generateData(fields, count);
    if (currentFmt === 'json') {
      currentOutput = JSON.stringify(rows, null, 2);
    } else {
      currentOutput = toCSV(rows, fields);
    }
    document.getElementById('fdg-output').value = currentOutput;
    generatedFmt = currentFmt;
    copyBtn.disabled = false;
    downloadBtn.disabled = false;
    window.trackTool && window.trackTool('fake-data-generator', 'generate');
  });

  copyBtn.addEventListener('click', function() {
    if (!currentOutput || copyBtn.disabled) return;
    resetCopy();
    var request = copyVersion;
    var text = currentOutput;
    function current() { return request === copyVersion && currentOutput === text; }
    function succeeded() {
      if (!current()) return;
      copyBtn.textContent = t.copied;
      copyTimer = setTimeout(function() { if (current()) copyBtn.textContent = t.copy; }, 1500);
    }
    /* The Clipboard API is missing (non-secure context), throws or refuses: try a hidden textarea. */
    function fallback() {
      if (!current()) return;
      if (fallbackCopy(text, copyBtn)) succeeded(); else copyBtn.textContent = t.copyFailed;
    }
    try {
      if (!navigator.clipboard || !navigator.clipboard.writeText) { fallback(); return; }
      navigator.clipboard.writeText(text).then(succeeded, fallback);
    } catch (e) { fallback(); }
  });

  document.getElementById('fdg-download').addEventListener('click', function() {
    if (!currentOutput) return;
    var ext = generatedFmt === 'json' ? 'json' : 'csv';
    var mime = generatedFmt === 'json' ? 'application/json' : 'text/csv';
    var blob = new Blob([currentOutput], { type: mime });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'fake-data.' + ext;
    a.click();
    URL.revokeObjectURL(url);
    var dlBtn = document.getElementById('fdg-download');
    dlBtn.textContent = t.downloaded;
    downloadVersion++;
    clearTimeout(downloadTimer);
    var request = downloadVersion;
    downloadTimer = setTimeout(function() { if (request === downloadVersion) dlBtn.textContent = t.download; }, 1500);
  });
  copyBtn.disabled = true;
  downloadBtn.disabled = true;
  document.addEventListener('keydown', function(e) {
    if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
    var root = document.querySelector('.fdg-wrap');
    if (!root || !root.contains(document.activeElement)) return;
    currentOutput = '';
    document.getElementById('fdg-output').value = '';
    document.getElementById('fdg-status').textContent = '';
    root.dataset.empty = 'true';
    resetExports();
    copyBtn.disabled = true;
    downloadBtn.disabled = true;
  });
})();
</script>

<style>
  .fdg-wrap { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; }
  .fdg-main { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 1rem; flex: 1 1 0; min-width: 0; min-height: 0; }
  .fdg-controls { gap: 0.65rem; overflow: auto; }
  .fdg-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.4rem; flex: none; }
  .fdg-actions button { flex: 1; min-width: 0; padding: 0.45rem; font-size: 0.8rem; white-space: normal; line-height: 1.25; }
  .fdg-action-group, .fdg-label-row { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
  .fdg-status { flex: none; min-height: 2.8em; font-size: 0.85rem; line-height: 1.4; }
  .fdg-section { flex: none; min-width: 0; }
  .fdg-section-title { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; color: var(--color-text-muted); }
  .fdg-checkboxes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.35rem 0.5rem; margin-top: 0.5rem; }
  .fdg-cb { display: flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; color: var(--color-text-secondary); cursor: pointer; user-select: none; min-width: 0; }
  .fdg-cb input[type=checkbox] { cursor: pointer; accent-color: var(--color-accent, #6366f1); flex: none; }
  .fdg-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 0.65rem; align-items: end; flex: none; }
