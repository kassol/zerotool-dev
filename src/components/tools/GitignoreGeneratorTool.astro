---
// GitignoreGeneratorTool — pick stack templates and merge into a single .gitignore.
import { gitignoreTemplates } from '../../data/gitignore-templates';
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
// strings:start
const STRINGS = {
  "en": {
    "searchPlaceholder": "Search Node, macOS, JetBrains…",
    "clearAll": "Clear all",
    "groupLanguages": "Languages & Frameworks",
    "groupGlobals": "IDEs, OS & Tools",
    "customSummary": "Add custom rules (optional)",
    "customPlaceholder": "# Project-specific paths\nbuild/local-cache/\n.env.production",
    "copy": "Copy",
    "copied": "Copied!",
    "copyFailed": "Copy failed",
    "download": "Download",
    "emptyOutput": "Pick one or more templates above. The merged .gitignore appears here.",
    "noResults": "No templates match your search.",
    "selectedHint": "{n} selected",
    "searchLabel": "Search templates",
    "templatesLabel": "Templates",
    "removeTemplate": "Remove {name}",
    "tips": {
      "search": "Search filters template names without changing your selections or the merged file. Clearing the search shows every bundled template again.",
      "templates": "Select language, framework, IDE or OS templates to update the file immediately. Selected templates are sorted by name; click a selected chip to remove it.",
      "custom": "Custom rules update the file immediately and appear last under Custom additions. Identical trimmed rule lines are removed across templates and custom rules; comments and blank lines are kept.",
      "clear": "Clear all removes selected templates, custom rules and the search, and clears this tool’s saved input. Ctrl/⌘+L does the same while focus is inside the tool.",
      "copy": "Copy the complete merged file. Copy stays disabled until a template or nonblank custom rule produces output; retry directly if copying fails.",
      "download": "Download the complete current file as .gitignore with UTF-8 text. Templates are bundled locally; this action does not fetch or upload them."
    }
  },
  "zh": {
    "searchPlaceholder": "搜索 Node、macOS、JetBrains……",
    "clearAll": "清空所有",
    "groupLanguages": "编程语言与框架",
    "groupGlobals": "IDE、操作系统与工具",
    "customSummary": "追加自定义规则（可选）",
    "customPlaceholder": "# 项目特有的路径\nbuild/local-cache/\n.env.production",
    "copy": "复制",
    "copied": "已复制！",
    "copyFailed": "复制失败",
    "download": "下载",
    "emptyOutput": "在上方选择一个或多个模板，合并后的 .gitignore 将显示在这里。",
    "noResults": "没有匹配的模板。",
    "selectedHint": "已选 {n} 个",
    "searchLabel": "搜索模板",
    "templatesLabel": "模板",
    "removeTemplate": "移除 {name}",
    "tips": {
      "search": "搜索只过滤模板名称，不改变已选项或合并文件。清空搜索后重新显示全部内置模板。",
      "templates": "选择语言、框架、IDE 或操作系统模板，文件立即更新。已选模板按名称排序，点击已选项的 chip 可移除该模板。",
      "custom": "自定义规则立即更新文件，位于最后的 Custom additions 段。模板和自定义内容中两端去空白后相同的规则行只保留一次，注释和空行保留。",
      "clear": "清空所有会移除已选模板、自定义规则和搜索，并清除本工具保存的输入。在工具内聚焦时，Ctrl/⌘+L 执行相同操作。",
      "copy": "复制完整合并文件。选中模板或非空白自定义规则产生输出后才能复制，复制失败后可直接重试。",
      "download": "将当前完整文件下载为 UTF-8 文本 .gitignore。模板已打包在本地，此操作不请求或上传模板。"
    }
  },
  "ja": {
    "searchPlaceholder": "Node, macOS, JetBrains を検索…",
    "clearAll": "すべてクリア",
    "groupLanguages": "言語とフレームワーク",
    "groupGlobals": "IDE・OS・ツール",
    "customSummary": "カスタムルールを追加（任意）",
    "customPlaceholder": "# プロジェクト固有のパス\nbuild/local-cache/\n.env.production",
    "copy": "コピー",
    "copied": "コピー済み！",
    "copyFailed": "コピーに失敗しました",
    "download": "ダウンロード",
    "emptyOutput": "上のテンプレートを 1 つ以上選択すると、ここに統合された .gitignore が表示されます。",
    "noResults": "一致するテンプレートはありません。",
    "selectedHint": "{n} 件選択中",
    "searchLabel": "テンプレートを検索",
    "templatesLabel": "テンプレート",
    "removeTemplate": "{name} を削除",
    "tips": {
      "search": "検索はテンプレート名の表示だけを絞り込み、選択や統合ファイルを変更しません。検索を消すと同梱テンプレートがすべて再表示されます。",
      "templates": "言語、フレームワーク、IDE、OS のテンプレートを選ぶとファイルが即時更新されます。選択項目は名前順に並び、チップをクリックすると選択を解除できます。",
      "custom": "カスタムルールは即時反映され、末尾の Custom additions に入ります。前後の空白を除いた同一ルール行は全テンプレートとカスタム内容で一度だけ残し、コメントと空行は保持します。",
      "clear": "すべてクリアは選択、カスタムルール、検索と本ツールの保存入力を消去します。ツール内にフォーカスがあるときは Ctrl/⌘+L も同じ操作です。",
      "copy": "統合ファイル全体をコピーします。テンプレートまたは空白以外のカスタムルールで出力ができるまで無効です。失敗した場合はそのまま再試行できます。",
      "download": "現在のファイル全体を UTF-8 の .gitignore として保存します。テンプレートはローカルに同梱され、この操作で取得やアップロードは行いません。"
    }
  },
  "ko": {
    "searchPlaceholder": "Node, macOS, JetBrains 검색…",
    "clearAll": "모두 지우기",
    "groupLanguages": "언어와 프레임워크",
    "groupGlobals": "IDE, OS 및 도구",
    "customSummary": "사용자 정의 규칙 추가 (선택)",
    "customPlaceholder": "# 프로젝트 고유 경로\nbuild/local-cache/\n.env.production",
    "copy": "복사",
    "copied": "복사됨!",
    "copyFailed": "복사 실패",
    "download": "다운로드",
    "emptyOutput": "위에서 하나 이상의 템플릿을 선택하면 병합된 .gitignore가 여기 표시됩니다.",
    "noResults": "일치하는 템플릿이 없습니다.",
    "selectedHint": "{n}개 선택됨",
    "searchLabel": "템플릿 검색",
    "templatesLabel": "템플릿",
    "removeTemplate": "{name} 제거",
    "tips": {
      "search": "검색은 템플릿 이름만 필터링하며 선택 항목이나 병합 파일을 바꾸지 않습니다. 검색을 지우면 내장 템플릿이 모두 다시 표시됩니다.",
      "templates": "언어, 프레임워크, IDE 또는 OS 템플릿을 선택하면 파일이 즉시 갱신됩니다. 선택 항목은 이름순으로 정렬되며 칩을 누르면 해당 항목을 제거합니다.",
      "custom": "사용자 규칙은 즉시 반영되어 마지막 Custom additions에 들어갑니다. 양끝 공백을 제거한 동일 규칙 줄은 템플릿과 사용자 규칙 전체에서 한 번만 남기고 주석과 빈 줄은 유지합니다.",
      "clear": "모두 지우기는 선택 템플릿, 사용자 규칙, 검색과 이 도구의 저장 입력을 지웁니다. 도구 안에 포커스가 있으면 Ctrl/⌘+L도 같은 동작을 합니다.",
      "copy": "병합 파일 전체를 복사합니다. 템플릿이나 공백이 아닌 사용자 규칙으로 출력이 생겨야 활성화되며, 실패 후 바로 다시 시도할 수 있습니다.",
      "download": "현재 파일 전체를 UTF-8 텍스트 .gitignore로 다운로드합니다. 템플릿은 로컬에 포함되어 있으며 이 동작으로 가져오거나 업로드하지 않습니다."
    }
  }
};
// strings:end
const L = STRINGS[lang] || STRINGS.en;
const CLIENT_T = { copy: L.copy, copied: L.copied, copyFailed: L.copyFailed };
const templateMeta = gitignoreTemplates.map((t) => ({ id: t.id, name: t.name, group: t.group }));
const counts = {
  languages: templateMeta.filter((t) => t.group === 'languages').length,
  globals: templateMeta.filter((t) => t.group === 'globals').length,
};
const escapeAttribute = (value: string) => value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const templateHtml = (group: string) => templateMeta.filter((tpl) => tpl.group === group).map((tpl) => {
  const id = escapeAttribute(tpl.id), name = escapeAttribute(tpl.name);
  return `<label class="gig-item" for="gig-cb-${id}" data-id="${id}" data-name="${escapeAttribute(tpl.name.toLowerCase())}"><input type="checkbox" id="gig-cb-${id}" class="gig-item-cb" data-id="${id}"><span class="gig-item-name">${name}</span></label>`;
}).join('');
---
<div class="gig-wrap" data-strings={JSON.stringify(CLIENT_T)}>
  <div class="gig-actions">
    <div class="gig-action"><button id="gig-clear-all" class="btn-ghost gig-clear-all" type="button" hidden>{L.clearAll}</button><Toggletip id="gig-tip-clear" lang={lang} about={L.clearAll}>{L.tips.clear}</Toggletip></div>
    <div class="gig-action"><button id="gig-copy" class="btn-copy gig-copy" type="button" disabled>{L.copy}</button><Toggletip id="gig-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip></div>
    <div class="gig-action"><button id="gig-download" class="btn-secondary gig-download" type="button" disabled>{L.download}</button><Toggletip id="gig-tip-download" lang={lang} about={L.download}>{L.tips.download}</Toggletip></div>
  </div>
  <div id="gig-status" class="tool-status" aria-live="polite"></div>
  <div class="gig-body">
    <aside class="gig-rail zt-rail">
      <div class="gig-field">
        <div class="gig-field-head"><label class="tool-label" for="gig-search">{L.searchLabel}</label><Toggletip id="gig-tip-search" lang={lang} about={L.searchLabel}>{L.tips.search}</Toggletip></div>
        <input id="gig-search" class="tool-input gig-search" type="search" spellcheck="false" autocomplete="off" placeholder={L.searchPlaceholder} />
      </div>
      <div id="gig-chips" class="gig-chips" aria-live="polite" data-remove-label={L.removeTemplate}></div>
      <div class="gig-field-head"><span class="tool-label">{L.templatesLabel}</span><Toggletip id="gig-tip-templates" lang={lang} about={L.templatesLabel}>{L.tips.templates}</Toggletip></div>
      <div class="gig-groups" tabindex="0">
        <details class="gig-group" data-group="languages" open>
          <summary class="gig-group-summary"><span class="gig-group-arrow" aria-hidden="true">▾</span><span class="gig-group-title">{L.groupLanguages}</span><span class="gig-group-count"><span class="gig-group-selected" id="gig-selected-languages">0</span><span class="gig-group-divider">/</span><span class="gig-group-total">{counts.languages}</span></span></summary>
          <div class="gig-group-grid" id="gig-grid-languages" set:html={templateHtml('languages')}></div>
        </details>
        <details class="gig-group" data-group="globals" open>
          <summary class="gig-group-summary"><span class="gig-group-arrow" aria-hidden="true">▾</span><span class="gig-group-title">{L.groupGlobals}</span><span class="gig-group-count"><span class="gig-group-selected" id="gig-selected-globals">0</span><span class="gig-group-divider">/</span><span class="gig-group-total">{counts.globals}</span></span></summary>
          <div class="gig-group-grid" id="gig-grid-globals" set:html={templateHtml('globals')}></div>
        </details>
      </div>
      <p id="gig-no-results" class="gig-no-results" hidden>{L.noResults}</p>
      <div class="gig-custom-head"><details class="gig-custom-details"><summary class="gig-custom-summary">{L.customSummary}</summary><textarea id="gig-custom" class="tool-textarea gig-custom" rows="4" spellcheck="false" placeholder={L.customPlaceholder}></textarea></details><Toggletip id="gig-tip-custom" lang={lang} about={L.customSummary}>{L.tips.custom}</Toggletip></div>
    </aside>
    <div id="gig-result" class="gig-output-wrap" data-empty="true">
      <div class="gig-output-header"><span class="gig-output-label">.gitignore</span></div>
      <pre id="gig-output" class="gig-output is-empty" tabindex="0" data-placeholder={L.emptyOutput}>{L.emptyOutput}</pre>
    </div>
  </div>
  <script>
    import { gitignoreTemplates } from '../../data/gitignore-templates';

    (() => {
      const SLUG = 'gitignore-generator';

      const t = JSON.parse((document.querySelector('.gig-wrap') as HTMLElement).dataset.strings || '{}');

      const searchEl = document.getElementById('gig-search') as HTMLInputElement;
      const clearAllBtn = document.getElementById('gig-clear-all') as HTMLButtonElement;
      const chipsEl = document.getElementById('gig-chips') as HTMLDivElement;
      const grids = {
        languages: document.getElementById('gig-grid-languages') as HTMLDivElement,
        globals: document.getElementById('gig-grid-globals') as HTMLDivElement,
      };
      const counters = {
        languages: document.getElementById('gig-selected-languages') as HTMLSpanElement,
        globals: document.getElementById('gig-selected-globals') as HTMLSpanElement,
      };
      const noResultsEl = document.getElementById('gig-no-results') as HTMLParagraphElement;
      const customEl = document.getElementById('gig-custom') as HTMLTextAreaElement;
      const outputEl = document.getElementById('gig-output') as HTMLPreElement;
      const copyBtn = document.getElementById('gig-copy') as HTMLButtonElement;
      const downloadBtn = document.getElementById('gig-download') as HTMLButtonElement;

      const templatesById = new Map(gitignoreTemplates.map((tpl) => [tpl.id, tpl]));
      const selected = new Set<string>();

      function renderChips() {
        chipsEl.innerHTML = '';
        if (selected.size === 0) {
          clearAllBtn.hidden = true;
          return;
        }
        clearAllBtn.hidden = false;

        const sortedIds = Array.from(selected).sort((a, b) => {
          const an = templatesById.get(a)?.name || a;
          const bn = templatesById.get(b)?.name || b;
          return an.localeCompare(bn);
        });

        for (const id of sortedIds) {
          const tpl = templatesById.get(id);
          if (!tpl) continue;
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'gig-chip';
          chip.dataset.id = id;
          chip.setAttribute('aria-label', (chipsEl.dataset.removeLabel || '').replace('{name}', tpl.name));

          const label = document.createElement('span');
          label.className = 'gig-chip-label';
          label.textContent = tpl.name;

          const x = document.createElement('span');
          x.className = 'gig-chip-x';
          x.textContent = '×';
          x.setAttribute('aria-hidden', 'true');

          chip.appendChild(label);
          chip.appendChild(x);
          chipsEl.appendChild(chip);
        }
      }

      function syncCheckboxes() {
        document.querySelectorAll<HTMLInputElement>('.gig-item-cb').forEach((cb) => {
          cb.checked = selected.has(cb.dataset.id || '');
        });
        counters.languages.textContent = String(
          Array.from(selected).filter((id) => templatesById.get(id)?.group === 'languages').length
        );
        counters.globals.textContent = String(
          Array.from(selected).filter((id) => templatesById.get(id)?.group === 'globals').length
        );
      }

      function dedupePreservingComments(content: string, seen: Set<string>): string[] {
        const out: string[] = [];
        for (const rawLine of content.split('\n')) {
          const line = rawLine.replace(/\s+$/, '');
          const norm = line.trim();
          if (norm === '' || norm.startsWith('#')) {
            out.push(line);
            continue;
          }
          if (seen.has(norm)) continue;
          seen.add(norm);
          out.push(line);
        }
        return out;
      }

      function trimBlock(lines: string[]): string {
        let start = 0;
        let end = lines.length;
        while (start < end && lines[start].trim() === '') start++;
        while (end > start && lines[end - 1].trim() === '') end--;
        return lines.slice(start, end).join('\n');
      }

      function generate(): string {
        if (selected.size === 0 && customEl.value.trim() === '') return '';

        const sortedIds = Array.from(selected).sort((a, b) => {
          const an = templatesById.get(a)?.name || a;
          const bn = templatesById.get(b)?.name || b;
          return an.localeCompare(bn);
        });

        const seen = new Set<string>();
        const sections: string[] = [];

        for (const id of sortedIds) {
          const tpl = templatesById.get(id);
          if (!tpl) continue;
          const body = trimBlock(dedupePreservingComments(tpl.content, seen));
          if (!body) continue;
          sections.push(`### ${tpl.name}.gitignore\n${body}`);
        }

        const customRaw = customEl.value.trim();
        if (customRaw) {
          const customBody = trimBlock(dedupePreservingComments(customRaw, seen));
          if (customBody) sections.push(`### Custom additions\n${customBody}`);
        }

        const header = [
          '# .gitignore generated at https://zerotool.dev/tools/gitignore-generator/',
          '# Source templates: github/gitignore (CC0-1.0)',
        ].join('\n');

        return `${header}\n\n${sections.join('\n\n')}\n`;
      }

      let copyVersion = 0;
      let copyTimer: ReturnType<typeof setTimeout> | null = null;
      function resetCopy() {
        copyVersion++;
        if (copyTimer) clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = t.copy;
        copyBtn.classList.remove('copied');
      }

      function refreshOutput() {
        resetCopy();
        const text = generate();
        const result = document.getElementById('gig-result') as HTMLElement;
        result.dataset.empty = String(!text);
        if (text) {
          outputEl.textContent = text;
          outputEl.classList.remove('is-empty');
          copyBtn.disabled = false;
          downloadBtn.disabled = false;
        } else {
          outputEl.textContent = outputEl.dataset.placeholder || '';
          outputEl.classList.add('is-empty');
          copyBtn.disabled = true;
          downloadBtn.disabled = true;
        }
      }

      function revealResult() {
        if (window.matchMedia('(max-width: 640px)').matches && !copyBtn.disabled) {
          document.getElementById('gig-result')?.scrollIntoView({ block: 'start', behavior: 'auto' });
        }
      }

      function applyFilter() {
        const q = searchEl.value.trim().toLowerCase();
        let visible = 0;
        document.querySelectorAll<HTMLLabelElement>('.gig-item').forEach((label) => {
          const name = label.dataset.name || '';
          const match = !q || name.includes(q);
          label.hidden = !match;
          if (match) visible++;
        });
        noResultsEl.hidden = visible !== 0;
      }

      let saveTimer: ReturnType<typeof setTimeout> | null = null;
      let saveVersion = 0;
      function persist() {
        const request = ++saveVersion;
        if (saveTimer) clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
          if (request !== saveVersion) return;
          if (window.ztPersist) {
            window.ztPersist.save(SLUG, {
              selected: Array.from(selected),
              custom: customEl.value,
            });
          }
        }, 400);
      }

      function restore() {
        if (!window.ztPersist) return;
        const saved = window.ztPersist.load(SLUG) as { selected?: string[]; custom?: string };
        if (Array.isArray(saved.selected)) {
          for (const id of saved.selected) {
            if (templatesById.has(id)) selected.add(id);
          }
        }
        if (typeof saved.custom === 'string') customEl.value = saved.custom;
      }

      function update() {
        renderChips();
        syncCheckboxes();
        refreshOutput();
        persist();
      }

      function onCheckboxChange(e: Event) {
        const cb = e.target as HTMLInputElement;
        if (!cb.matches('.gig-item-cb')) return;
        const id = cb.dataset.id;
        if (!id) return;
        if (cb.checked) selected.add(id);
        else selected.delete(id);
        update();
        revealResult();
        window.trackTool && window.trackTool(SLUG, cb.checked ? 'select' : 'deselect');
      }

      function onChipClick(e: Event) {
        const target = e.target as HTMLElement;
        const chip = target.closest('.gig-chip') as HTMLButtonElement | null;
        if (!chip) return;
        const id = chip.dataset.id;
        if (!id) return;
        selected.delete(id);
        update();
        revealResult();
      }

      function onClearAll(skipStorageClear = false) {
        saveVersion++;
        if (saveTimer) {
          clearTimeout(saveTimer);
          saveTimer = null;
        }
        selected.clear();
        customEl.value = '';
        searchEl.value = '';
        applyFilter();
        renderChips();
        syncCheckboxes();
        refreshOutput();
        if (!skipStorageClear && window.ztPersist) window.ztPersist.clear(SLUG);
      }

      function onCopy() {
        const text = outputEl.textContent || '';
        if (!text || copyBtn.disabled) return;
        resetCopy();
        const request = copyVersion;
        const current = () => request === copyVersion && outputEl.textContent === text;
        const failed = () => { if (current()) copyBtn.textContent = t.copyFailed; };
        try {
          if (!navigator.clipboard || !navigator.clipboard.writeText) failed();
          else navigator.clipboard.writeText(text).then(() => {
            if (!current()) return;
            copyBtn.textContent = t.copied;
            copyBtn.classList.add('copied');
            copyTimer = setTimeout(() => {
              if (!current()) return;
              copyBtn.textContent = t.copy;
              copyBtn.classList.remove('copied');
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
        window.trackTool && window.trackTool(SLUG, 'copy');
      }

      function onDownload() {
        const text = outputEl.textContent || '';
        if (!text || downloadBtn.disabled) return;
        const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = '.gitignore';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        window.trackTool && window.trackTool(SLUG, 'download');
      }

      restore();
      update();
      applyFilter();

      searchEl.addEventListener('input', applyFilter);
      grids.languages.addEventListener('change', onCheckboxChange);
      grids.globals.addEventListener('change', onCheckboxChange);
      chipsEl.addEventListener('click', onChipClick);
      customEl.addEventListener('input', () => {
        const wasEmpty = copyBtn.disabled;
        refreshOutput();
        persist();
        if (wasEmpty) revealResult();
      });
      clearAllBtn.addEventListener('click', () => onClearAll());
      copyBtn.addEventListener('click', onCopy);
      downloadBtn.addEventListener('click', onDownload);
      document.addEventListener('keydown', (e) => {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        const root = document.querySelector('.gig-wrap');
        if (!root || !root.contains(document.activeElement)) return;
        onClearAll(true);
      });
    })();
  </script>

