const L = STRINGS[lang];

const EXAMPLE_SCHEMA = `syntax = "proto3";

package shop.v1;

import "google/protobuf/timestamp.proto";

message Order {
  int64 order_id = 1;
  string customer_name = 2;
  repeated LineItem items = 3;
  Status status = 4;
  google.protobuf.Timestamp created_at = 5;
  map<string, string> labels = 6;
}

message LineItem {
  string sku = 1;
  uint32 quantity = 2;
  double unit_price = 3;
}

enum Status {
  STATUS_UNSPECIFIED = 0;
  STATUS_PAID = 1;
  STATUS_SHIPPED = 2;
}
`;
// protoc --encode=shop.v1.Order of the order in the tool page examples
const EXAMPLE_BYTES = '08 81 80 80 80 80 80 80 10 12 0c 41 64 61 20 4c 6f 76 65 6c 61 63 65 1a 14 0a 07 42 4b 2d 31 38 34 33 10 02 19 3d 0a d7 a3 70 fd 33 40 20 01 2a 0b 08 88 b4 f8 d5 06 10 80 e5 9a 77 32 0e 0a 07 63 68 61 6e 6e 65 6c 12 03 77 65 62';
---
<div class="pbj" id="pbj">
  <script is:inline src="/vendor/long.min.js"></script>
  <script is:inline src="/vendor/protobuf.min.js"></script>

  <div class="pbj-bar">
    <div class="pbj-modes" role="group" aria-label={L.modesAria}>
      <button type="button" class="pbj-mode" data-mode="decode" aria-pressed="true">{L.modeDecode}</button>
      <button type="button" class="pbj-mode" data-mode="encode" aria-pressed="false">{L.modeEncode}</button>
      <button type="button" class="pbj-mode" data-mode="sample" aria-pressed="false">{L.modeSample}</button>
    </div>
    <div class="pbj-bar-actions">
      <button type="button" id="pbj-example" class="btn-ghost">{L.example}</button>
      <button type="button" id="pbj-clear" class="btn-ghost">{L.clear}</button>
    </div>
  </div>

  <div class="pbj-grid" data-mode="decode">
    <div class="pbj-input">
      <div class="pbj-only-decode">
        <div class="pbj-head pbj-head-in">
          <label class="tool-label" for="pbj-bytes">{L.bytesLabel}</label>
        </div>
        <textarea id="pbj-bytes" class="tool-textarea pbj-ta pbj-ta-bytes" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" placeholder={L.bytesPh}></textarea>
      </div>
      <div class="pbj-only-encode">
        <div class="pbj-head pbj-head-in">
          <label class="tool-label" for="pbj-json">{L.jsonLabel}</label>
        </div>
        <textarea id="pbj-json" class="tool-textarea pbj-ta pbj-ta-json" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" placeholder={L.jsonPh}></textarea>
      </div>
    </div>

    <div class="pbj-inopts">
      <label class="pbj-opt pbj-only-decode"><span>{L.fmtLabel}</span>
        <select id="pbj-fmt" class="tool-input pbj-select">
          <option value="auto">{L.fmtAuto}</option>
          <option value="hex">{L.fmtHex}</option>
          <option value="base64">{L.fmtBase64}</option>
          <option value="escaped">{L.fmtEscaped}</option>
          <option value="decimal">{L.fmtDecimal}</option>
        </select>
      </label>
      <label class="pbj-opt pbj-only-decode"><span>{L.grpcLabel}</span>
        <select id="pbj-grpc" class="tool-input pbj-select">
          <option value="auto">{L.grpcAuto}</option>
          <option value="yes">{L.grpcYes}</option>
          <option value="no">{L.grpcNo}</option>
        </select>
      </label>
      <button type="button" id="pbj-open-bin" class="btn-secondary btn-sm pbj-only-decode">{L.openBin}</button>
      <input type="file" id="pbj-bin-file" class="pbj-file" tabindex="-1" aria-hidden="true" />
      <label class="pbj-check pbj-only-encode"><input type="checkbox" id="pbj-ignore-unknown" /><span>{L.optIgnoreUnknown}</span></label>
    </div>

    <div class="pbj-run">
      <label class="tool-label pbj-type-label" for="pbj-type">{L.typeLabel}</label>
      <div class="pbj-run-row">
        <select id="pbj-type" class="tool-input pbj-select pbj-type"></select>
        <button type="button" id="pbj-go" class="btn-primary">{L.runDecode}</button>
      </div>
    </div>

    <div class="pbj-out">
      <div class="pbj-head">
        <span class="tool-label" id="pbj-out-label">{L.outLabel}</span>
        <button type="button" id="pbj-copy" class="btn-copy">{L.copy}</button>
      </div>
      <p id="pbj-status" class="tool-status pbj-status" role="status" aria-live="polite"></p>
      <pre id="pbj-output" class="pbj-output" tabindex="0" aria-labelledby="pbj-out-label"></pre>
      <div class="pbj-outopts">
        <label class="pbj-opt pbj-only-decode pbj-only-typed"><span>{L.optNames}</span>
          <select id="pbj-names" class="tool-input pbj-select">
            <option value="json">{L.optNamesJson}</option>
            <option value="proto">{L.optNamesProto}</option>
          </select>
        </label>
        <label class="pbj-check pbj-only-typed"><input type="checkbox" id="pbj-defaults" /><span>{L.optDefaults}</span></label>
        <label class="pbj-check pbj-only-typed"><input type="checkbox" id="pbj-enumnum" /><span>{L.optEnumNum}</span></label>
        <label class="pbj-opt pbj-only-decode pbj-only-raw"><span>{L.optRawView}</span>
          <select id="pbj-rawview" class="tool-input pbj-select">
            <option value="json">{L.optRawJson}</option>
            <option value="readings">{L.optRawReadings}</option>
            <option value="protoc">{L.optRawProtoc}</option>
          </select>
        </label>
        <label class="pbj-opt pbj-not-encode"><span>{L.optIndent}</span>
          <select id="pbj-indent" class="tool-input pbj-select">
            <option value="2">2</option>
            <option value="4">4</option>
            <option value="0">{L.optIndentNone}</option>
          </select>
        </label>
        <label class="pbj-opt pbj-only-encode"><span>{L.optOutFmt}</span>
          <select id="pbj-outfmt" class="tool-input pbj-select">
            <option value="hex">{L.fmtHex}</option>
            <option value="base64">{L.fmtBase64}</option>
            <option value="escaped">{L.fmtEscaped}</option>
            <option value="carray">C array</option>
          </select>
        </label>
        <label class="pbj-check pbj-only-encode"><input type="checkbox" id="pbj-frame" /><span>{L.optFrame}</span></label>
        <button type="button" id="pbj-download" class="btn-secondary btn-sm pbj-only-encode">{L.download}</button>
        <button type="button" id="pbj-use" class="btn-secondary btn-sm pbj-only-sample">{L.useAsInput}</button>
      </div>
      <div id="pbj-notes-wrap" class="pbj-notes-wrap" hidden>
        <p class="pbj-notes-title">{L.notesTitle}</p>
        <ul id="pbj-notes" class="pbj-notes"></ul>
      </div>
    </div>

    <div class="pbj-schema">
      <div class="pbj-head">
        <label class="tool-label" for="pbj-schema">{L.schemaLabel}</label>
        <button type="button" id="pbj-add-proto" class="btn-ghost btn-sm">{L.addProto}</button>
        <input type="file" id="pbj-proto-files" class="pbj-file" accept=".proto,text/plain" multiple tabindex="-1" aria-hidden="true" />
      </div>
      <p class="pbj-hint pbj-only-decode">{L.schemaHintDecode} {L.wktNote}</p>
      <p class="pbj-hint pbj-not-decode">{L.wktNote}</p>
      <textarea id="pbj-schema" class="tool-textarea pbj-ta pbj-ta-schema" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" placeholder={L.schemaPh}></textarea>
      <div id="pbj-files-wrap" class="pbj-files-wrap" hidden>
        <span class="pbj-files-title">{L.extraFiles}</span>
        <ul id="pbj-files" class="pbj-files"></ul>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ S: L, EXAMPLE_SCHEMA, EXAMPLE_BYTES }}>
    (function () {
      /* ── engine:start ── */
      // Wire format: protobuf.dev/programming-guides/encoding. JSON mapping:
      // protobuf.dev/programming-guides/json. Errors are thrown as pbErr(code, args); the page
      // turns the code into a sentence in its own language.
      function pbErr(code, args) {
        var e = new Error(code);
        e.pbCode = code;
        e.pbArgs = args || {};
        return e;
      }

      function lineColOf(text, index) {
        var line = 1, col = 1;
        for (var i = 0; i < index && i < text.length; i++) {
          if (text.charCodeAt(i) === 10) { line++; col = 1; } else col++;
        }
        return { line: line, col: col };
      }
      function atText(text, index, extra) {
        var lc = lineColOf(text, index);
        var o = { line: lc.line, col: lc.col, index: index };
        if (extra) for (var k in extra) o[k] = extra[k];
        return o;
      }

      // ---------- Base64 ----------
      var B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
      var B64V = {};
      for (var bi = 0; bi < 64; bi++) B64V[B64[bi]] = bi;
      B64V['-'] = 62; B64V['_'] = 63;

      function toBase64(bytes) {
        var out = '', i = 0, n = bytes.length;
        for (; i + 2 < n; i += 3) {
          var v = (bytes[i] << 16) | (bytes[i + 1] << 8) | bytes[i + 2];
          out += B64[v >> 18] + B64[(v >> 12) & 63] + B64[(v >> 6) & 63] + B64[v & 63];
        }
        if (i < n) {
          var w = bytes[i] << 16 | (i + 1 < n ? bytes[i + 1] << 8 : 0);
          out += B64[w >> 18] + B64[(w >> 12) & 63] + (i + 1 < n ? B64[(w >> 6) & 63] : '=') + '=';
        }
        return out;
      }

      // Standard or URL-safe alphabet, padding optional (RFC 4648 sections 4 and 5).
      function fromBase64(text, start) {
        var vals = [], pad = 0, std = false, url = false;
        for (var i = start || 0; i < text.length; i++) {
          var c = text[i];
          if (c === ' ' || c === '\n' || c === '\r' || c === '\t') continue;
          if (c === '=') { pad++; continue; }
          if (pad) throw pbErr('b64Pad', {});
          var v = B64V[c];
          if (v === undefined) throw pbErr('b64Char', atText(text, i, { ch: c }));
          if (c === '+' || c === '/') std = true;
          if (c === '-' || c === '_') url = true;
          vals.push(v);
        }
        if (std && url) throw pbErr('b64Mixed', {});
        if (vals.length % 4 === 1) throw pbErr('b64Length', { n: vals.length });
        if (pad > 2 || (pad && (vals.length + pad) % 4 !== 0)) throw pbErr('b64Pad', {});
        var out = new Uint8Array(Math.floor(vals.length * 3 / 4));
        var o = 0;
        for (var j = 0; j < vals.length; j += 4) {
          var a = vals[j], b = vals[j + 1], c2 = vals[j + 2], d = vals[j + 3];
          out[o++] = (a << 2) | (b >> 4);
          if (c2 !== undefined) out[o++] = ((b & 15) << 4) | (c2 >> 2);
          if (d !== undefined) out[o++] = ((c2 & 3) << 6) | d;
        }
        return out;
      }

      // ---------- byte input ----------
      function isHexDigit(c) { return /[0-9a-fA-F]/.test(c); }

      function fromHex(text) {
        var tokens = [], re = /[^\s,{}\[\]();]+/g, m;
        while ((m = re.exec(text))) tokens.push({ s: m[0], i: m.index });
