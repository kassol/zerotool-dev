.pbj-files :global(.pbj-file-chip) {
  display: inline-flex; align-items: center; gap: 0.25rem;
  padding: 0.1rem 0.2rem 0.1rem 0.6rem;
  border-radius: var(--radius-pill);
  background: var(--color-bg-secondary);
  outline: 1px solid var(--color-border-soft);
  outline-offset: -1px;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  max-width: 100%;
  overflow-wrap: anywhere;
}
.pbj-files :global(.pbj-file-x) {
  min-width: 24px; min-height: 24px;
  border: 0; border-radius: var(--radius-pill);
  background: transparent; color: var(--color-text-secondary);
  cursor: pointer; font-size: 1rem; line-height: 1;
}
.pbj-files :global(.pbj-file-x:hover) { color: var(--color-danger); }

/* visibility by mode and decoder kind */
.pbj-grid[data-mode="decode"] .pbj-only-encode,
.pbj-grid[data-mode="decode"] .pbj-only-sample,
.pbj-grid[data-mode="decode"] .pbj-not-decode,
.pbj-grid[data-mode="encode"] .pbj-only-decode,
.pbj-grid[data-mode="encode"] .pbj-only-sample,
.pbj-grid[data-mode="encode"] .pbj-only-typed,
.pbj-grid[data-mode="encode"] .pbj-not-encode,
.pbj-grid[data-mode="sample"] .pbj-only-decode,
.pbj-grid[data-mode="sample"] .pbj-only-encode,
.pbj-grid[data-mode="sample"] .pbj-only-raw,
.pbj-grid[data-raw="1"] .pbj-only-typed,
.pbj-grid[data-raw="0"] .pbj-only-raw { display: none; }
.pbj-grid[data-mode="sample"] .pbj-input,
.pbj-grid[data-mode="sample"] .pbj-inopts { display: none; }

@media (max-width: 860px) {
  .pbj-grid {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "input" "run" "out" "inopts" "schema";
