  .pbj-bar-actions { flex: 1 1 100%; }
  .pbj-bar-actions .btn-ghost { flex: 1 1 0; }
  .pbj-head-in { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .pbj-type-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .pbj-ta-bytes { min-height: 92px; }
  .pbj-ta-json { min-height: 140px; }
  .pbj-select { min-height: 44px; }
  .pbj-check { min-height: 44px; }
  .pbj-output { min-height: 200px; max-height: 480px; }
}
