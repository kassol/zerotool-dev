.pbj-output :global(.pbj-key) { color: #0b6a99; }
.pbj-output :global(.pbj-str) { color: #1d7a36; }
.pbj-output :global(.pbj-num) { color: #b0391a; }
.pbj-output :global(.pbj-bool) { color: #7a3fc4; }
