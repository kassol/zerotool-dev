}
:global([data-theme="dark"]) .pbj-output :global(.pbj-key) { color: #7dd3fc; }
:global([data-theme="dark"]) .pbj-output :global(.pbj-str) { color: #86efac; }
:global([data-theme="dark"]) .pbj-output :global(.pbj-num) { color: #fca5a5; }
:global([data-theme="dark"]) .pbj-output :global(.pbj-bool) { color: #c4b5fd; }

.pbj-notes-wrap { font-size: 0.82rem; color: var(--color-text-secondary); }
.pbj-notes-title { margin: 0.2rem 0 0.25rem; font-weight: 700; color: var(--color-text); }
