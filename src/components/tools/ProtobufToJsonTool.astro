---
// ProtobufToJsonTool — decodes Protobuf bytes to ProtoJSON (protobuf.dev/programming-guides/json)
// with or without a .proto schema, encodes ProtoJSON back to bytes, and prints a sample JSON
// for a message type. protobuf.js (public/vendor/protobuf.min.js) only parses the .proto text
// into reflection objects; the wire decoder, the ProtoJSON printer and parser, and the encoder
// are the engine block below, so 64-bit values use BigInt and every error carries a byte offset
// or a JSON line and column. Inputs are not stored or sent; ztPersist keeps only the options.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
