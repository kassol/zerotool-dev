        try { tree = sampleFor(ctx, els.type.value, { protoNames: prefs.names === 'proto', enumNumbers: prefs.enumNum }); }
        catch (e) { return showError(e, schemaNotes(ctx)); }
        showText(stringifyJson(tree, indentOf(), false), stringifyJson(tree, indentOf(), true));
        setStatus(fmt(S.st.sampled, { type: els.type.value }), 'success');
        setNotes(ctx.notes.map(noteText).concat(schemaNotes(ctx)));
        track();
      }

      function run() {
        clearTimeout(state.timer);
        var gen = ++state.gen;
        if (!pb) return showEmpty('protobuf.js failed to load.');
        if (prefs.mode === 'encode') runEncode();
        else if (prefs.mode === 'sample') runSample();
        else runDecode(gen);
      }
      function schedule(ms) { clearTimeout(state.timer); state.timer = setTimeout(run, ms); }

      // ---------- mode and options ----------
      function setMode(mode) {
        prefs.mode = mode;
        els.modes.forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-mode') === mode ? 'true' : 'false'); });
        els.grid.setAttribute('data-mode', mode);
        els.go.textContent = mode === 'encode' ? S.runEncode : mode === 'sample' ? S.runSample : S.runDecode;
        fillTypes();
      }
      els.modes.forEach(function (b) {
        b.addEventListener('click', function () {
          var mode = b.getAttribute('data-mode');
          if (mode === 'encode' && !els.json.value.trim()) fillJsonFromBytes();
          setMode(mode);
          savePrefs();
          run();
        });
      });

      // Prefills the JSON box from the decoded bytes, so switching to encode starts from data.
      function fillJsonFromBytes() {
        if (!state.ctx || !els.bytes.value.trim()) return;
        var typeName = els.type.value || state.ctx.defaultType;
        if (!typeName) return;
        try {
          var bytes = readBytes(els.bytes.value, prefs.fmt).bytes;
          var frames = unframe(bytes, prefs.grpc);
          if (frames) bytes = frames[0].payload;
          var msg = decodeTyped(state.ctx, typeName, bytes);
          els.json.value = stringifyJson(msgJson(state.ctx, msg, decodeOpts(), '', 0), 2, false);
        } catch (e) { /* leave empty */ }
      }

      function bindOpt(el, key, isCheck) {
        if (isCheck) el.checked = !!prefs[key]; else el.value = prefs[key];
        el.addEventListener('change', function () {
          prefs[key] = isCheck ? el.checked : el.value;
          savePrefs();
          run();
        });
      }
      bindOpt(els.fmt, 'fmt'); bindOpt(els.grpc, 'grpc'); bindOpt(els.names, 'names'); bindOpt(els.defaults, 'defaults', true);
      bindOpt(els.enumNum, 'enumNum', true); bindOpt(els.rawView, 'rawView'); bindOpt(els.indent, 'indent');
      bindOpt(els.outFmt, 'outFmt'); bindOpt(els.frame, 'frame', true); bindOpt(els.ignoreUnknown, 'ignoreUnknown', true);

      els.type.addEventListener('change', function () { syncRawFlag(); run(); });
      els.go.addEventListener('click', run);
      els.bytes.addEventListener('input', function () { schedule(250); });
      els.json.addEventListener('input', function () { schedule(300); });
      els.schema.addEventListener('input', function () {
        clearTimeout(state.schemaTimer);
        state.schemaTimer = setTimeout(function () { rebuildSchema(); run(); }, 400);
      });

      // ---------- files ----------
      function renderFiles() {
        els.files.innerHTML = '';
        state.files.forEach(function (f, i) {
          var li = document.createElement('li');
          li.className = 'pbj-file-chip';
          var name = document.createElement('span');
          name.textContent = f.name;
          var x = document.createElement('button');
          x.type = 'button';
          x.className = 'pbj-file-x';
          x.textContent = '×';
          x.setAttribute('aria-label', fmt(S.removeFile, { name: f.name }));
          x.addEventListener('click', function () { state.files.splice(i, 1); renderFiles(); rebuildSchema(); run(); });
          li.appendChild(name);
          li.appendChild(x);
          els.files.appendChild(li);
        });
        els.filesWrap.hidden = !state.files.length;
      }
      function addProtoFiles(list) {
        var arr = Array.prototype.slice.call(list || []);
        if (!arr.length) return;
        Promise.all(arr.map(function (file) {
          return file.text().then(function (text) { return { name: file.webkitRelativePath || file.name, text: text }; });
        })).then(function (loaded) {
          loaded.forEach(function (f) {
            var i = state.files.findIndex(function (g) { return g.name === f.name; });
            if (i >= 0) state.files[i] = f; else state.files.push(f);
          });
          if (!els.schema.value.trim() && state.files.length) {
            var first = state.files.shift();
            els.schema.value = first.text;
          }
          renderFiles();
          rebuildSchema();
          run();
        });
      }
      function loadBinary(file) {
        if (!file) return;
        if (file.size > 2 * 1024 * 1024) { showError(pbErr('fileTooBig', { name: file.name, size: file.size })); return; }
        file.arrayBuffer().then(function (buf) {
          els.bytes.value = formatBytes(new Uint8Array(buf), 'hex');
          if (prefs.fmt !== 'auto' && prefs.fmt !== 'hex') { prefs.fmt = 'auto'; els.fmt.value = 'auto'; savePrefs(); }
          if (prefs.mode !== 'decode') setMode('decode');
          run();
        });
      }
      els.openBin.addEventListener('click', function () { els.binFile.click(); });
      els.binFile.addEventListener('change', function () { loadBinary(els.binFile.files[0]); els.binFile.value = ''; });
      els.addProto.addEventListener('click', function () { els.protoFiles.click(); });
      els.protoFiles.addEventListener('change', function () { addProtoFiles(els.protoFiles.files); els.protoFiles.value = ''; });
      function dropZone(el, onFiles) {
        el.addEventListener('dragover', function (e) { if (e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types, 'Files') >= 0) e.preventDefault(); });
        el.addEventListener('drop', function (e) {
          if (!e.dataTransfer || !e.dataTransfer.files.length) return;
          e.preventDefault();
          onFiles(e.dataTransfer.files);
        });
      }
      dropZone(els.bytes, function (files) { loadBinary(files[0]); });
      dropZone(els.schema, addProtoFiles);

      // ---------- copy, download, buttons ----------
      function copyText(text) {
        function fallback() {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          var ok = false;
          try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
          document.body.removeChild(ta);
          return ok ? Promise.resolve() : Promise.reject();
        }
        if (navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(text).catch(fallback);
        return fallback();
      }
      els.copy.addEventListener('click', function () {
        if (!state.outText) return;
        copyText(state.outText).then(function () {
          els.copy.textContent = S.copied;
          setTimeout(function () { els.copy.textContent = S.copy; }, 1500);
        }, function () { setStatus(S.copyFailed, 'error'); });
      });
      els.download.addEventListener('click', function () {
        if (!state.lastBytes) return;
        var url = URL.createObjectURL(new Blob([state.lastBytes], { type: 'application/octet-stream' }));
        var a = document.createElement('a');
        a.href = url;
        a.download = (els.type.value || 'message').split('.').pop() + '.bin';
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      });
      els.use.addEventListener('click', function () {
        if (!state.outText) return;
        els.json.value = state.outText;
        setMode('encode');
        savePrefs();
        run();
        els.json.focus();
      });

      function loadExample() {
        els.schema.value = EXAMPLE_SCHEMA;
        els.bytes.value = EXAMPLE_BYTES;
        state.files = [];
        renderFiles();
        rebuildSchema();
        if (state.ctx) els.type.value = 'shop.v1.Order';
        syncRawFlag();
        els.json.value = '';
        fillJsonFromBytes();
        run();
      }
      els.example.addEventListener('click', loadExample);
      els.clear.addEventListener('click', function () {
        els.schema.value = '';
        els.bytes.value = '';
        els.json.value = '';
        state.files = [];
        renderFiles();
        rebuildSchema();
        run();
      });
      // The page-wide Ctrl/Cmd+L shortcut empties the text boxes; drop loaded files and refresh.
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && document.querySelector('.tool-widget') &&
          document.querySelector('.tool-widget').contains(document.activeElement)) {
          setTimeout(function () { state.files = []; renderFiles(); rebuildSchema(); run(); }, 0);
        }
      });

      setMode(prefs.mode);
      loadExample();
    })();
  </script>
</div>

<style>
.pbj { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }

.pbj-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; }
.pbj-bar-actions { display: flex; gap: 0.4rem; }
.pbj-modes {
  display: inline-flex;
  border-radius: var(--radius-pill);
  background: var(--color-bg-secondary);
  outline: 1px solid var(--color-border-soft);
  outline-offset: -1px;
  padding: 3px;
  gap: 2px;
}
.pbj-mode {
  min-height: 34px;
  padding: 0.3rem 0.85rem;
  border: 0;
  border-radius: var(--radius-pill);
  background: transparent;
  color: var(--color-text-secondary);
  font: 650 0.84rem/1.2 var(--font-sans);
  cursor: pointer;
  white-space: nowrap;
}
.pbj-mode:hover { color: var(--color-text); }
.pbj-mode[aria-pressed="true"] { background: var(--color-primary); color: var(--color-primary-contrast); }
.pbj-mode:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

.pbj-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  grid-template-areas:
    "input out"
    "inopts out"
    "run out"
    "schema out";
  grid-template-rows: auto auto auto 1fr;
  gap: 0.7rem 1rem;
  align-items: start;
}
.pbj-input { grid-area: input; min-width: 0; }
.pbj-inopts { grid-area: inopts; }
.pbj-run { grid-area: run; min-width: 0; }
.pbj-out { grid-area: out; min-width: 0; display: flex; flex-direction: column; gap: 0.4rem; }
.pbj-schema { grid-area: schema; min-width: 0; display: flex; flex-direction: column; gap: 0.35rem; }

.pbj-head { display: flex; align-items: center; gap: 0.5rem; min-height: 1.6rem; margin-bottom: 0.25rem; }
.pbj-head .tool-label { margin: 0; flex: 1 1 auto; }
.pbj-ta { width: 100%; box-sizing: border-box; font-family: var(--font-mono); font-size: 0.83rem; line-height: 1.5; resize: vertical; }
.pbj-ta-bytes { min-height: 116px; }
.pbj-ta-json { min-height: 220px; }
.pbj-ta-schema { min-height: 300px; }

.pbj-inopts, .pbj-outopts { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem 0.9rem; }
.pbj-opt { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; color: var(--color-text-secondary); }
.pbj-check { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.82rem; color: var(--color-text-secondary); cursor: pointer; }
.pbj-select { width: auto; min-height: 34px; padding-top: 0.25rem; padding-bottom: 0.25rem; font-size: 0.82rem; }
.pbj-file { display: none; }

.pbj-run-row { display: flex; gap: 0.5rem; align-items: stretch; }
.pbj-type { flex: 1 1 auto; min-width: 0; font-family: var(--font-mono); }
.pbj-run-row .btn-primary { flex: 0 0 auto; }

.pbj-status { margin: 0; overflow-wrap: anywhere; }
.pbj-output {
  margin: 0;
  min-height: 260px;
  max-height: 620px;
  overflow: auto;
  padding: 0.8rem 1rem;
  border-radius: var(--radius-md);
  background: var(--color-bg-secondary);
  box-shadow: inset 0 0 0 1px var(--color-border-soft);
  font-family: var(--font-mono);
  font-size: 0.82rem;
  line-height: 1.55;
  white-space: pre;
  color: var(--color-text);
  tab-size: 2;
}
.pbj-output:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
.pbj-output.pbj-output-error { white-space: pre-wrap; color: var(--color-danger); }
