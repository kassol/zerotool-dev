---
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  "en": {
    "value": "Value",
    "unit": "Unit",
    "rootFontSize": "Root Font Size (px)",
    "viewportWidth": "Viewport Width (px)",
    "enterValue": "Enter value...",
    "copy": "Copy",
    "copied": "Copied!",
    "copyFailed": "Copy failed.",
    "clear": "Clear",
    "converted": "Converted.",
    "invalid": "Invalid number.",
    "invalidSetting": "Root Font Size and Viewport Width must not be negative.",
    "settings": "Settings",
    "results": "Results",
    "tips": {
      "value": "Enter a number without its unit, such as 16 or 2.5. Results update as you type; negative numbers and zero are supported. Choose px, rem, em or vw from Unit.",
      "unit": "Unit sets the source unit. All four results update immediately. This tool treats em like rem, using Root Font Size; it does not read a real page or an element’s inherited font size.",
      "root": "Open Settings to enter your project’s root font size in pixels. The default is 16px. Both rem and em use this value; an empty field or zero uses 16px, and a negative value shows an error.",
      "viewport": "Enter the target viewport width in pixels. The default is 1920px; use 390 for a 390px phone layout. One vw is one percent of this width. An empty field or zero uses 1920px, and a negative value shows an error.",
      "results": "Results include their unit and are rounded to six significant digits. Copy next to a result copies that value and unit. The highlighted row is the source unit.",
      "clear": "Clear and Ctrl/⌘+L inside the tool empty Value, all results and the status. Unit, Root Font Size and Viewport Width stay as set."
    }
  },
  "zh": {
    "value": "数值",
    "unit": "单位",
    "rootFontSize": "根字体大小 (px)",
    "viewportWidth": "视口宽度 (px)",
    "enterValue": "请输入数值...",
    "copy": "复制",
    "copied": "已复制!",
    "copyFailed": "复制失败。",
    "clear": "清除",
    "converted": "已转换。",
    "invalid": "无效数字。",
    "invalidSetting": "根字体大小和视口宽度不能为负数。",
    "settings": "设置",
    "results": "结果",
    "tips": {
      "value": "只输入数字，不附单位，例如 16 或 2.5。结果随输入更新，也支持负数和零。请在单位菜单选择 px、rem、em 或 vw。",
      "unit": "单位菜单决定源单位，四项结果即时更新。本工具将 em 按 rem 处理，统一使用根字体大小，不会读取真实网页或元素继承的字号。",
      "root": "展开设置，填入项目的根字体大小，单位为像素，默认 16px。rem 和 em 都使用此值；输入为空或为零时按 16px 计算，填负数时报错。",
      "viewport": "填写目标视口的像素宽度，默认 1920px；390px 的手机布局可填 390。1vw 等于此宽度的百分之一。输入为空或为零时按 1920px 计算，填负数时报错。",
      "results": "结果包含单位，保留六位有效数字。点击结果旁的复制，会复制该数值和单位。高亮行表示源单位。",
      "clear": "点击清除，或在工具内按 Ctrl/⌘+L，会清空数值、全部结果和状态。单位、根字体大小和视口宽度保持当前设置。"
    }
  },
  "ja": {
    "value": "値",
    "unit": "単位",
    "rootFontSize": "ルートフォントサイズ (px)",
    "viewportWidth": "ビューポート幅 (px)",
    "enterValue": "値を入力...",
    "copy": "コピー",
    "copied": "コピー済み!",
    "copyFailed": "コピーに失敗しました。",
    "clear": "クリア",
    "converted": "変換済み。",
    "invalid": "無効な数値。",
    "invalidSetting": "ルートフォントサイズとビューポート幅に負の値は使えません。",
    "settings": "設定",
    "results": "結果",
    "tips": {
      "value": "16 や 2.5 のように単位を付けず数値を入力します。結果は入力に合わせて更新され、負数とゼロにも対応します。px、rem、em、vw は単位メニューで選びます。",
      "unit": "単位メニューで変換元を選ぶと4つの結果が即座に更新されます。このツールは em も rem と同じルートフォントサイズで換算し、実際のページや要素の継承されたサイズは読み取りません。",
      "root": "設定を開き、プロジェクトのルートフォントサイズをピクセルで入力します。既定値は16pxです。rem と em の両方に使用し、空欄またはゼロなら16pxで計算し、負の値はエラーになります。",
      "viewport": "対象のビューポート幅をピクセルで入力します。既定値は1920pxで、390pxのスマートフォン画面なら390にします。1vwはこの幅の1％です。空欄またはゼロなら1920pxで計算し、負の値はエラーになります。",
      "results": "結果には単位が付き、有効数字6桁に丸められます。各結果のコピーで値と単位をコピーできます。強調された行は変換元の単位です。",
      "clear": "クリア、またはツール内の Ctrl/⌘+L で値、すべての結果、ステータスを消去します。単位、ルートフォントサイズ、ビューポート幅は保持します。"
    }
  },
  "ko": {
    "value": "값",
    "unit": "단위",
    "rootFontSize": "루트 글꼴 크기 (px)",
    "viewportWidth": "뷰포트 너비 (px)",
    "enterValue": "값을 입력하세요...",
    "copy": "복사",
    "copied": "복사됨!",
    "copyFailed": "복사에 실패했습니다.",
    "clear": "지우기",
    "converted": "변환 완료.",
    "invalid": "유효하지 않은 숫자.",
    "invalidSetting": "루트 글꼴 크기와 뷰포트 너비는 음수일 수 없습니다.",
    "settings": "설정",
    "results": "결과",
    "tips": {
      "value": "16이나 2.5처럼 단위 없이 숫자만 입력하세요. 입력에 따라 결과가 갱신되며 음수와 0도 지원합니다. px, rem, em, vw는 단위 메뉴에서 선택합니다.",
      "unit": "단위 메뉴는 원본 단위를 정하며 네 결과가 즉시 갱신됩니다. 이 도구는 em도 rem처럼 루트 글꼴 크기로 계산하며 실제 페이지나 요소가 상속한 글꼴 크기를 읽지 않습니다.",
      "root": "설정을 열어 프로젝트의 루트 글꼴 크기를 픽셀로 입력하세요. 기본값은 16px이며 rem과 em에 모두 사용합니다. 비어 있거나 0이면 16px로 계산하고 음수는 오류로 표시합니다.",
      "viewport": "대상 뷰포트의 너비를 픽셀로 입력하세요. 기본값은 1920px이며 390px 휴대폰 레이아웃은 390을 사용합니다. 1vw는 이 너비의 1%입니다. 비어 있거나 0이면 1920px로 계산하고 음수는 오류로 표시합니다.",
      "results": "결과에는 단위가 포함되며 유효숫자 여섯 자리로 반올림됩니다. 결과 옆의 복사로 값과 단위를 복사합니다. 강조된 행은 원본 단위입니다.",
      "clear": "지우기 또는 도구 안의 Ctrl/⌘+L로 값, 모든 결과와 상태를 지웁니다. 단위, 루트 글꼴 크기, 뷰포트 너비는 유지됩니다."
    }
  }
} as const;
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---
<div class="cu-wrap">
  <div class="cu-toolbar">
    <div class="cu-unit-controls">
      <label for="cu-unit">{T.unit}</label>
      <select id="cu-unit" class="tool-input">
        <option value="px">px</option>
        <option value="rem">rem</option>
        <option value="em">em</option>
        <option value="vw">vw</option>
      </select>
      <Toggletip id="cu-tip-unit" lang={lang} about={T.unit}>{TIPS.unit}</Toggletip>
    </div>
    <div class="cu-actions">
      <button id="cu-clear" class="btn-ghost" type="button">{T.clear}</button>
      <Toggletip id="cu-tip-clear" lang={lang} about={T.clear}>{TIPS.clear}</Toggletip>
    </div>
  </div>
  <details class="cu-settings">
    <summary>{T.settings}</summary>
    <div class="cu-config">
      <div class="cu-field">
        <div class="cu-label-row">
          <label for="cu-root-size">{T.rootFontSize}</label>
          <Toggletip id="cu-tip-root" lang={lang} about={T.rootFontSize}>{TIPS.root}</Toggletip>
        </div>
        <input id="cu-root-size" class="tool-input" type="number" value="16" min="1" step="any" autocomplete="off" />
      </div>
      <div class="cu-field">
        <div class="cu-label-row">
          <label for="cu-viewport">{T.viewportWidth}</label>
          <Toggletip id="cu-tip-viewport" lang={lang} about={T.viewportWidth}>{TIPS.viewport}</Toggletip>
        </div>
        <input id="cu-viewport" class="tool-input" type="number" value="1920" min="1" step="any" autocomplete="off" />
      </div>
    </div>
  </details>
  <div id="cu-status" class="cu-status" aria-live="polite" tabindex="0"></div>
  <div class="cu-field cu-field-value">
    <div class="cu-label-row">
      <label for="cu-value">{T.value}</label>
      <Toggletip id="cu-tip-value" lang={lang} about={T.value}>{TIPS.value}</Toggletip>
    </div>
    <input id="cu-value" class="tool-input" type="number" placeholder={T.enterValue} step="any" autocomplete="off" />
  </div>
  <div class="cu-label-row">
    <span class="cu-results-label">{T.results}</span>
    <Toggletip id="cu-tip-results" lang={lang} about={T.results}>{TIPS.results}</Toggletip>
  </div>
  <div class="cu-results">
    <div class="cu-result">
      <label for="cu-out-px">px</label>
      <div class="cu-input-row">
        <input id="cu-out-px" class="cu-output" type="text" readonly spellcheck="false" />
        <button class="btn-copy" type="button" data-copy="cu-out-px">{T.copy}</button>
      </div>
    </div>
    <div class="cu-result">
      <label for="cu-out-rem">rem</label>
      <div class="cu-input-row">
        <input id="cu-out-rem" class="cu-output" type="text" readonly spellcheck="false" />
        <button class="btn-copy" type="button" data-copy="cu-out-rem">{T.copy}</button>
      </div>
    </div>
    <div class="cu-result">
      <label for="cu-out-em">em</label>
      <div class="cu-input-row">
        <input id="cu-out-em" class="cu-output" type="text" readonly spellcheck="false" />
        <button class="btn-copy" type="button" data-copy="cu-out-em">{T.copy}</button>
      </div>
    </div>
    <div class="cu-result">
      <label for="cu-out-vw">vw</label>
      <div class="cu-input-row">
        <input id="cu-out-vw" class="cu-output" type="text" readonly spellcheck="false" />
        <button class="btn-copy" type="button" data-copy="cu-out-vw">{T.copy}</button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var valueEl = document.getElementById('cu-value');
      var unitEl = document.getElementById('cu-unit');
      var rootSizeEl = document.getElementById('cu-root-size');
      var viewportEl = document.getElementById('cu-viewport');
      var statusEl = document.getElementById('cu-status');
      var outPx = document.getElementById('cu-out-px');
      var outRem = document.getElementById('cu-out-rem');
      var outEm = document.getElementById('cu-out-em');
      var outVw = document.getElementById('cu-out-vw');
      var copyRevision = 0;

      function resetCopyFeedback() {
        copyRevision++;
        document.querySelectorAll('.cu-wrap .btn-copy[data-copy]').forEach(function (btn) { btn.textContent = t.copy; });
      }

      function fmt(n) {
        // Round to 6 significant digits, strip trailing zeros
        if (n === 0) return '0';
        var s = parseFloat(n.toPrecision(6)).toString();
        return s;
      }

      function setStatus(msg, isError) {
        statusEl.textContent = msg;
        statusEl.className = 'cu-status ' + (isError ? 'error' : 'success');
      }

      function clearStatus() {
        statusEl.textContent = '';
        statusEl.className = 'cu-status';
      }

      function clearOutputs() {
        outPx.value = '';
        outRem.value = '';
        outEm.value = '';
        outVw.value = '';
      }

      function highlightActive(unit) {
        document.querySelectorAll('.cu-result').forEach(function (el) {
          var label = el.querySelector('label');
          el.classList.toggle('cu-active', label && label.textContent === unit);
        });
      }

      function convert() {
        resetCopyFeedback();
        var raw = valueEl.value.trim();
        if (raw === '' || raw === '-') {
          clearOutputs();
          clearStatus();
          return;
        }

        var val = parseFloat(raw);
        if (isNaN(val)) {
          clearOutputs();
          setStatus(t.invalid, true);
          return;
        }

        // An empty field or 0 falls back to the default; a negative setting would give negative
        // results, so it is reported instead.
        var rootInput = parseFloat(rootSizeEl.value);
        var viewportInput = parseFloat(viewportEl.value);
        if (rootInput < 0 || viewportInput < 0) {
          clearOutputs();
          setStatus(t.invalidSetting, true);
          return;
        }
        var rootSize = rootInput || 16;
        var viewport = viewportInput || 1920;
        var unit = unitEl.value;

        // Convert to px first
        var px;
        if (unit === 'px') {
          px = val;
        } else if (unit === 'rem' || unit === 'em') {
          px = val * rootSize;
        } else if (unit === 'vw') {
          px = (val / 100) * viewport;
        }

        outPx.value = fmt(px) + 'px';
        outRem.value = fmt(px / rootSize) + 'rem';
        outEm.value = fmt(px / rootSize) + 'em';
        outVw.value = fmt((px / viewport) * 100) + 'vw';

        setStatus(t.converted, false);
      }

      /* Analytics: one event per committed change (as in box-shadow-generator), not per input event. */
      function trackConvert() {
        if (outPx.value) window.trackTool && window.trackTool('css-unit-converter', 'convert');
      }

      valueEl.addEventListener('input', convert);
      unitEl.addEventListener('change', function () {
        highlightActive(unitEl.value);
        convert();
        trackConvert();
      });
      rootSizeEl.addEventListener('input', convert);
      viewportEl.addEventListener('input', convert);
      [valueEl, rootSizeEl, viewportEl].forEach(function (el) { el.addEventListener('change', trackConvert); });

      function clearAll() {
        resetCopyFeedback();
        valueEl.value = '';
        clearOutputs();
        clearStatus();
        valueEl.focus();
      }

      document.getElementById('cu-clear').addEventListener('click', clearAll);
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var wrap = document.querySelector('.cu-wrap');
        if (!wrap || !wrap.contains(document.activeElement)) return;
        e.preventDefault();
        clearAll();
      });

      document.querySelectorAll('.cu-wrap .btn-copy[data-copy]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-copy');
          var val = document.getElementById(id).value;
          if (!val) return;
          resetCopyFeedback();
          var revision = copyRevision;
          navigator.clipboard.writeText(val).then(function () {
            if (revision !== copyRevision) return;
            setStatus(t.converted, false);
            btn.textContent = t.copied;
            setTimeout(function () { if (revision === copyRevision) btn.textContent = t.copy; }, 1500);
          }, function () {
            if (revision === copyRevision) setStatus(t.copyFailed, true);
          });
          window.trackTool && window.trackTool('css-unit-converter', 'copy');
        });
      });

      // Init
      highlightActive(unitEl.value);
    })();
  </script>
</div>

<style>
  .cu-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; gap: 0.75rem; }
  .cu-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .cu-unit-controls, .cu-actions, .cu-label-row { display: flex; align-items: center; min-width: 0; gap: 0.35rem; }
  .cu-unit-controls label, .cu-label-row label, .cu-results-label { font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); }
  .cu-unit-controls select { width: 6rem; min-width: 0; }
  .cu-actions { flex: none; }
  .cu-settings summary { min-height: 44px; padding: 0.65rem 0; cursor: pointer; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .cu-config { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.75rem; padding: 0.25rem 0 0.5rem; }
  .cu-field { display: flex; flex-direction: column; min-width: 0; gap: 0.3rem; }
  .cu-label-row { min-height: 28px; }
  .cu-field .tool-input { width: 100%; }
  #cu-value { font-family: var(--font-mono); font-size: 1rem; }
  .cu-status { height: 3em; min-height: 3em; line-height: 1.5; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; }
  .cu-status.success { color: var(--color-success); }
  .cu-status.error { color: var(--color-danger); }
  .cu-results { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.5rem; }
  .cu-result { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); align-items: center; min-width: 0; height: 3.5rem; padding: 0 0.4rem 0 0.75rem; gap: 0.5rem; border-radius: var(--radius-md); background: var(--color-bg-secondary); box-shadow: inset 0 0 0 1px var(--color-border-soft); }
  .cu-result label { font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); }
  .cu-result.cu-active { box-shadow: inset 0 0 0 1px var(--color-primary); }
  .cu-result.cu-active label { color: var(--color-primary); }
  .cu-input-row { display: flex; align-items: center; min-width: 0; gap: 0.5rem; }
  .cu-output { flex: 1; width: 0; min-width: 0; height: 2.75rem; padding: 0; border: 0; font-family: var(--font-mono); font-size: 0.95rem; background: transparent; color: var(--color-text); overflow-x: auto; white-space: nowrap; }
  .cu-input-row .btn-copy { flex: none; }
  .cu-output:focus-visible, .cu-status:focus-visible, .cu-settings summary:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  @media (max-width: 860px) {
    .cu-results { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .cu-wrap { gap: 0.5rem; }
    .cu-config { grid-template-columns: minmax(0, 1fr); }
    .cu-toolbar { gap: 0.5rem; }
    .cu-unit-controls select { width: 5rem; }
    .cu-result { padding: 0 0.3rem 0 0.6rem; gap: 0.4rem; }
  }
</style>
