---
import Toggletip from '../Toggletip.astro';
// SqlFormatterTool — format & minify SQL queries (pure JS, no deps)
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  en: {
    sqlInput: 'SQL Input', indent: 'Indent:', indent2: '2 spaces', indent4: '4 spaces', indentTab: 'Tab',
    uppercaseKeywords: 'Uppercase keywords', format: 'Format', minify: 'Minify', clear: 'Clear',
    output: 'Output', copy: 'Copy', copied: 'Copied!', outputPlaceholder: 'Formatted SQL appears here...',
    copyFailed: 'Copy failed. Please try again.', formatted: 'Formatted.', minified: 'Minified.',
    tips: {"input": "Paste SQL here. Formatting runs 0.3 seconds after typing stops. This tool formats text and does not validate or execute SQL.", "indent": "Choose two spaces, four spaces or a tab. Click Format to apply an option change to the current query.", "uppercase": "Format writes recognized keywords in uppercase when checked and lowercase when unchecked. Quoted names, strings and other identifiers keep their spelling.", "format": "Format the input with the current indentation and keyword case. Ctrl+Enter (⌘+Enter on Mac) in the input also runs Format.", "minify": "Minify reads the input and produces one line. It removes comments and unnecessary spaces.", "clear": "Clear both text areas, the status and pending formatting. Indentation and keyword options stay selected. Ctrl+L (⌘+L on Mac) works while focus is inside this tool.", "copy": "Copy all current output text, including content outside the visible area."}
  },
  zh: {
    sqlInput: 'SQL 输入', indent: '缩进：', indent2: '2 个空格', indent4: '4 个空格', indentTab: 'Tab',
    uppercaseKeywords: '关键字大写', format: '格式化', minify: '压缩', clear: '清除',
    output: '输出', copy: '复制', copied: '已复制！', outputPlaceholder: '格式化后的 SQL 显示在此处...',
    copyFailed: '复制失败，请重试。', formatted: '已格式化。', minified: '已压缩。',
    tips: {"input": "在此粘贴 SQL。停止输入 0.3 秒后自动格式化。本工具只整理文本，不验证或执行 SQL。", "indent": "选择两个空格、四个空格或制表符。修改选项后，点击“格式化”应用到当前查询。", "uppercase": "勾选时，格式化将识别的关键字转为大写；取消勾选时转为小写。引号包裹的名称、字符串和其他标识符保持原样。", "format": "按当前缩进和关键字大小写格式化输入。在输入框按 Ctrl+Enter（Mac 为 ⌘+Enter）也会运行格式化。", "minify": "从输入生成单行 SQL，并删除注释和多余空白。", "clear": "清空两个文本框、状态和等待执行的格式化。缩进与关键字选项保持原值。焦点在工具内时，也可按 Ctrl+L（Mac 为 ⌘+L）。", "copy": "复制当前的完整输出，包括可见区域之外的内容。"}
  },
  ja: {
    sqlInput: 'SQL 入力', indent: 'インデント：', indent2: '2スペース', indent4: '4スペース', indentTab: 'タブ',
    uppercaseKeywords: 'キーワードを大文字', format: '整形', minify: '圧縮', clear: 'クリア',
    output: '出力', copy: 'コピー', copied: 'コピー済み！', outputPlaceholder: '整形された SQL がここに表示されます...',
    copyFailed: 'コピーに失敗しました。もう一度お試しください。', formatted: '整形しました。', minified: '圧縮しました。',
    tips: {"input": "SQL を貼り付けます。入力を止めて0.3秒後に自動整形します。SQL の構文チェックや実行は行いません。", "indent": "スペース2個、4個、タブから選びます。設定変更後に「整形」を押すと、現在のクエリに適用します。", "uppercase": "オンでは認識したキーワードを大文字、オフでは小文字に整形します。引用符付きの名前、文字列、その他の識別子はそのままです。", "format": "現在のインデントと大文字・小文字の設定で整形します。入力欄の Ctrl+Enter（Mac は ⌘+Enter）でも実行できます。", "minify": "入力から1行の SQL を作ります。コメントと不要な空白を除去します。", "clear": "両方のテキスト欄、ステータス、待機中の整形をクリアします。インデントとキーワードの設定は保持します。ツール内では Ctrl+L（Mac は ⌘+L）も使えます。", "copy": "表示範囲の外も含め、現在の出力をすべてコピーします。"}
  },
  ko: {
    sqlInput: 'SQL 입력', indent: '들여쓰기:', indent2: '공백 2개', indent4: '공백 4개', indentTab: '탭',
    uppercaseKeywords: '키워드 대문자', format: '서식 지정', minify: '최소화', clear: '지우기',
    output: '출력', copy: '복사', copied: '복사됨!', outputPlaceholder: '서식이 지정된 SQL이 여기에 표시됩니다...',
    copyFailed: '복사하지 못했습니다. 다시 시도하세요.', formatted: '서식 지정 완료.', minified: '최소화 완료.',
    tips: {"input": "SQL을 붙여 넣으세요. 입력을 멈추고 0.3초 뒤 자동으로 서식을 지정합니다. SQL 문법을 검사하거나 실행하지는 않습니다.", "indent": "공백 두 개, 네 개 또는 탭을 고르세요. 옵션을 바꾼 뒤 “서식 지정”을 누르면 현재 쿼리에 적용됩니다.", "uppercase": "선택하면 인식한 키워드를 대문자로, 해제하면 소문자로 바꿉니다. 따옴표로 묶인 이름, 문자열 및 다른 식별자는 그대로 둡니다.", "format": "현재 들여쓰기와 키워드 대소문자 설정으로 입력의 서식을 지정합니다. 입력창에서 Ctrl+Enter(Mac은 ⌘+Enter)로도 실행합니다.", "minify": "입력에서 한 줄 SQL을 만듭니다. 주석과 불필요한 공백을 제거합니다.", "clear": "두 텍스트 칸과 상태를 지우고 대기 중인 서식 지정을 취소합니다. 들여쓰기와 키워드 옵션은 유지됩니다. 도구 안에서 Ctrl+L(Mac은 ⌘+L)로도 지웁니다.", "copy": "화면 밖의 내용까지 현재 출력 전체를 복사합니다."}
  }
};
const T = STRINGS[lang] || STRINGS.en;
const TIPS = T.tips;
const CLIENT_T = { copy: T.copy, copied: T.copied, copyFailed: T.copyFailed, formatted: T.formatted, minified: T.minified };
---

<div class="sf-wrap" data-strings={JSON.stringify(CLIENT_T)}>
  <div class="sf-options">
    <div class="sf-control">
      <label for="sf-indent">{T.indent}</label>
      <select id="sf-indent">
        <option value="2">{T.indent2}</option>
        <option value="4">{T.indent4}</option>
        <option value="tab">{T.indentTab}</option>
      </select>
      <Toggletip id="sf-tip-indent" about={T.indent} lang={lang}>{TIPS.indent}</Toggletip>
    </div>
    <div class="sf-control">
      <label class="sf-opt"><input type="checkbox" id="sf-uppercase" checked /> {T.uppercaseKeywords}</label>
      <Toggletip id="sf-tip-uppercase" about={T.uppercaseKeywords} lang={lang}>{TIPS.uppercase}</Toggletip>
    </div>
  </div>
  <div class="sf-toolbar">
    <div class="sf-control"><button id="sf-format" class="btn-primary" type="button">{T.format}</button><Toggletip id="sf-tip-format" about={T.format} lang={lang}>{TIPS.format}</Toggletip></div>
    <div class="sf-control"><button id="sf-minify" class="btn-secondary" type="button">{T.minify}</button><Toggletip id="sf-tip-minify" about={T.minify} lang={lang}>{TIPS.minify}</Toggletip></div>
    <div class="sf-control"><button id="sf-clear" class="btn-ghost" type="button">{T.clear}</button><Toggletip id="sf-tip-clear" about={T.clear} lang={lang}>{TIPS.clear}</Toggletip></div>
  </div>
  <div id="sf-status" class="sf-status" aria-live="polite"></div>
  <div class="sf-panels zt-io">
    <div class="sf-pane zt-io-pane">
      <div class="sf-head sf-control"><label for="sf-input">{T.sqlInput}</label><Toggletip id="sf-tip-input" about={T.sqlInput} lang={lang}>{TIPS.input}</Toggletip></div>
      <textarea id="sf-input" class="tool-textarea sf-box zt-io-fill" placeholder="SELECT u.id, u.name FROM users u WHERE u.active = 1 ORDER BY u.name;" spellcheck="false"></textarea>
    </div>
    <div class="sf-pane sf-result zt-io-pane">
      <div class="sf-head">
        <label for="sf-output">{T.output}</label>
        <div class="sf-control"><button id="sf-copy" class="btn-copy" type="button">{T.copy}</button><Toggletip id="sf-tip-copy" about={T.copy} lang={lang}>{TIPS.copy}</Toggletip></div>
      </div>
      <p class="sf-empty">{T.outputPlaceholder}</p>
      <textarea id="sf-output" class="tool-textarea sf-box zt-io-fill" placeholder={T.outputPlaceholder} readonly spellcheck="false"></textarea>
    </div>
  </div>

  <script is:inline>
    (function () {
      var t = JSON.parse(document.querySelector('.sf-wrap').dataset.strings || '{}');

      var input = document.getElementById('sf-input');
      var output = document.getElementById('sf-output');
      var statusEl = document.getElementById('sf-status');
      var copyBtn = document.getElementById('sf-copy');
      var indentSel = document.getElementById('sf-indent');
      var uppercaseCb = document.getElementById('sf-uppercase');

      var copyRevision = 0, copyTimer = null, copyFailure = false;

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = t.copy;
        copyFailure = false;
      }

      function setStatus(msg, isError) {
        copyFailure = false;
        statusEl.textContent = msg;
        statusEl.className = 'sf-status ' + (isError ? 'error' : 'success');
      }

      function clearStatus() {
        copyFailure = false;
        statusEl.textContent = '';
        statusEl.className = 'sf-status';
      }

      /* ── engine:start ── */
      /* ── SQL Keywords ── */
      var KEYWORDS = [
        'SELECT','FROM','WHERE','AND','OR','NOT','IN','JOIN','LEFT','RIGHT',
        'INNER','OUTER','FULL','CROSS','ON','AS','ORDER','BY','GROUP',
        'HAVING','LIMIT','OFFSET','INSERT','INTO','VALUES','UPDATE','SET',
        'DELETE','CREATE','TABLE','ALTER','DROP','INDEX','UNION','ALL',
        'DISTINCT','CASE','WHEN','THEN','ELSE','END','EXISTS','BETWEEN',
        'LIKE','IS','NULL','ASC','DESC','COUNT','SUM','AVG','MIN','MAX','WITH'
      ];
      var kwSet = {};
      for (var i = 0; i < KEYWORDS.length; i++) kwSet[KEYWORDS[i]] = true;

      /* ── Tokenizer ── */
      /* backslash: read \ as an escape inside '...' and "..." (MySQL and MariaDB by default).
         Without the argument, use that reading when it closes every quoted text, else the
         standard reading, where a backslash is an ordinary character. */
      function tokenize(sql, backslash) {
        if (backslash === undefined) {
          var escaped = tokenize(sql, true);
          return escaped.closed ? escaped : tokenize(sql, false);
        }
        var tokens = [];
        tokens.closed = true;
        var len = sql.length;
        var pos = 0;

        /* end of a quoted text that starts at `from`; a doubled closing character is kept inside */
        function quotedEnd(from, close, escapes) {
          var p = from + 1;
          while (p < len) {
            if (escapes && sql[p] === '\\') { p += 2; continue; }
            if (sql[p] === close) {
              if (sql[p + 1] === close) { p += 2; continue; }
              return p + 1;
            }
            p++;
          }
          tokens.closed = false;
          return len;
        }

        while (pos < len) {
          var ch = sql[pos];

          /* whitespace — skip */
          if (/\s/.test(ch)) { pos++; continue; }

          /* single-line comment -- */
          if (ch === '-' && pos + 1 < len && sql[pos + 1] === '-') {
            var end = sql.indexOf('\n', pos);
            if (end === -1) end = len;
            tokens.push({ type: 'comment', value: sql.slice(pos, end) });
            pos = end;
            continue;
          }

          /* multi-line comment */
          if (ch === '/' && pos + 1 < len && sql[pos + 1] === '*') {
            var end = sql.indexOf('*/', pos + 2);
            if (end === -1) end = len; else end += 2;
            tokens.push({ type: 'comment', value: sql.slice(pos, end) });
            pos = end;
            continue;
          }

          /* N'...', X'...', B'...' and E'...' (PostgreSQL escape string): the prefix stays on the string */
          if (/[NnXxBbEe]/.test(ch) && sql[pos + 1] === "'") {
            var pEnd = quotedEnd(pos + 1, "'", backslash || ch === 'E' || ch === 'e');
            tokens.push({ type: 'string', value: sql.slice(pos, pEnd) });
            pos = pEnd;
            continue;
          }

          /* [bracketed name] (SQL Server, SQLite); ]] stands for ] */
          if (ch === '[') {
            var bEnd = quotedEnd(pos, ']', false);
            tokens.push({ type: 'ident', value: sql.slice(pos, bEnd) });
            pos = bEnd;
            continue;
          }

          /* $tag$ ... $tag$ (PostgreSQL dollar quoting) */
          if (ch === '$') {
            var dqRe = /\$(?:[\p{L}_][\p{L}\p{N}_]*)?\$/uy;
            dqRe.lastIndex = pos;
            var dq = dqRe.exec(sql);
            var dqClose = dq ? sql.indexOf(dq[0], pos + dq[0].length) : -1;
            if (dqClose !== -1) {
              tokens.push({ type: 'string', value: sql.slice(pos, dqClose + dq[0].length) });
              pos = dqClose + dq[0].length;
              continue;
            }
          }

          /* parameters and variables: $1, ?1, :name, @name, $name, @@name */
          var paramRe = /[$?][0-9]+|@@[\p{L}_][\p{L}\p{M}\p{N}_$]*|[:@$][\p{L}_][\p{L}\p{M}\p{N}_$]*/uy;
          paramRe.lastIndex = pos;
          var param = paramRe.exec(sql);
          if (param) {
            tokens.push({ type: 'word', value: param[0] });
            pos += param[0].length;
            continue;
          }

          /* string literal (single-quoted, with '' escape) */
          if (ch === "'") {
            var qEnd = quotedEnd(pos, "'", backslash);
            tokens.push({ type: 'string', value: sql.slice(pos, qEnd) });
            pos = qEnd;
            continue;
          }

          /* double-quoted identifier (a string in MySQL) or backtick-quoted identifier */
          if (ch === '"' || ch === '`') {
            var qEnd = quotedEnd(pos, ch, backslash && ch === '"');
            tokens.push({ type: 'ident', value: sql.slice(pos, qEnd) });
            pos = qEnd;
            continue;
          }

          /* number */
          if (/[0-9]/.test(ch) || (ch === '.' && pos + 1 < len && /[0-9]/.test(sql[pos + 1]))) {
            var s = '';
            while (pos < len && /[0-9.eE\-+]/.test(sql[pos])) { s += sql[pos]; pos++; }
            tokens.push({ type: 'number', value: s });
            continue;
          }

          /* operators: >=, <=, <>, !=, ||, ::, => */
          if (pos + 1 < len) {
            var two = sql.slice(pos, pos + 2);
            if (two === '>=' || two === '<=' || two === '<>' || two === '!=' || two === '||' || two === '::' || two === '=>') {
              tokens.push({ type: 'operator', value: two });
              pos += 2;
              continue;
            }
          }

          /* punctuation and single-char operators */
          if ('(),.;=<>+-*/%&|^~!@#'.indexOf(ch) !== -1) {
            tokens.push({ type: ch === '(' || ch === ')' || ch === ',' || ch === ';' || ch === '.' ? 'punct' : 'operator', value: ch });
            pos++;
            continue;
          }

          /* word (keyword or identifier) */
          var wordRe = /[\p{L}_][\p{L}\p{M}\p{N}_$]*/uy;
          wordRe.lastIndex = pos;
          var wordMatch = wordRe.exec(sql);
          if (wordMatch) {
            var s = wordMatch[0];
            pos += s.length;
            var upper = s.toUpperCase();
            if (kwSet[upper] && /^[A-Za-z]+$/.test(s)) {
              tokens.push({ type: 'keyword', value: upper, raw: s });
            } else {
              tokens.push({ type: 'word', value: s });
            }
            continue;
          }

          /* fallback — push single char */
          tokens.push({ type: 'other', value: ch });
          pos++;
        }

        return tokens;
      }

      /* ── Clause detection ── */
      var CLAUSE_HEADS = {
        'SELECT': true, 'FROM': true, 'WHERE': true,
        'HAVING': true, 'LIMIT': true, 'OFFSET': true,
        'INSERT': true, 'UPDATE': true, 'DELETE': true,
        'CREATE': true, 'VALUES': true, 'SET': true, 'UNION': true
      };
      var JOIN_KW = { 'JOIN': true, 'LEFT': true, 'RIGHT': true, 'INNER': true, 'OUTER': true, 'FULL': true, 'CROSS': true };

      function isJoinStart(tokens, idx) {
        var kw = tokens[idx].value;
        if (kw === 'JOIN') return true;
        if (JOIN_KW[kw] && idx + 1 < tokens.length) {
          /* LEFT JOIN, LEFT OUTER JOIN, etc. */
          for (var j = idx + 1; j < tokens.length && j <= idx + 3; j++) {
            if (tokens[j].type === 'keyword' && tokens[j].value === 'JOIN') return true;
            if (tokens[j].type !== 'keyword' || !JOIN_KW[tokens[j].value]) break;
          }
        }
        return false;
      }

      function isOrderOrGroupBy(tokens, idx) {
        return ((tokens[idx].value === 'ORDER' || tokens[idx].value === 'GROUP') &&
                idx + 1 < tokens.length && tokens[idx + 1].type === 'keyword' && tokens[idx + 1].value === 'BY');
      }

      /* ── Formatter ── */
      function formatSQL(sql, indentStr, toUpper) {
        var tokens = tokenize(sql);
        if (tokens.length === 0) return '';

        var lines = [];
        var curLine = '';
        var depth = 0;
        var inSelect = false;
        var afterClause = false;
        var parens = [];

        function indent(d) {
          var s = '';
          for (var i = 0; i < d; i++) s += indentStr;
          return s;
        }

        function lineLevel(line) {
          var n = 0;
          while (line.startsWith(indentStr, n * indentStr.length)) n++;
          return n;
        }

        function pushLine() {
          if (curLine.length > 0) lines.push(curLine);
          curLine = '';
        }

        function kwText(tok) {
          return toUpper ? tok.value : tok.value.toLowerCase();
        }

        function tokText(tok) {
          if (tok.type === 'keyword') return kwText(tok);
          return tok.value;
        }

        var i = 0;
        while (i < tokens.length) {
          var tok = tokens[i];

          /* ── open paren: a subquery starts a deeper block; any other paren (function call,
                expression, list) stays inline. Every paren is pushed so that its ")" closes
                the right one and restores the SELECT-list state. ── */
          if (tok.type === 'punct' && tok.value === '(') {
            if (afterClause && inSelect) {
              pushLine();
              curLine = indent(depth + 1);
            }
            afterClause = false;
            /* Check if this starts a subquery */
            var nextReal = null;
            for (var ni = i + 1; ni < tokens.length; ni++) {
              if (tokens[ni].type !== 'comment') { nextReal = tokens[ni]; break; }
            }
            var isSubquery = nextReal && nextReal.type === 'keyword' && CLAUSE_HEADS[nextReal.value];
            if (isSubquery) {
              var openLevel = lineLevel(curLine);
              curLine += curLine.trim().length > 0 ? ' (' : '(';
              pushLine();
              parens.push({ subquery: true, inSelect: inSelect, depth: depth, level: openLevel });
              depth = openLevel + 1;
            } else {
              parens.push({ subquery: false, inSelect: inSelect });
              curLine += tok.value;
            }
            inSelect = false;
            i++;
            continue;
          }

          /* ── close paren ── */
          if (tok.type === 'punct' && tok.value === ')') {
            var frame = parens.pop();
            if (frame && frame.subquery) {
              pushLine();
              depth = frame.depth;
              curLine = indent(frame.level) + ')';
            } else {
              curLine += ')';
            }
            if (frame) inSelect = frame.inSelect;
            afterClause = false;
            i++;
            continue;
          }

          /* ── ORDER BY / GROUP BY inside a function call, e.g. OVER (... ORDER BY ...), stays inline ── */
          if (tok.type === 'keyword' && isOrderOrGroupBy(tokens, i) && parens.length > 0 && !parens[parens.length - 1].subquery) {
            curLine += ' ' + kwText(tok) + ' ' + kwText(tokens[i + 1]);
            i += 2;
            continue;
          }

          /* ── ORDER BY / GROUP BY ── */
          if (tok.type === 'keyword' && isOrderOrGroupBy(tokens, i)) {
            pushLine();
            inSelect = false;
            curLine = indent(depth) + kwText(tok) + ' ' + kwText(tokens[i + 1]);
            afterClause = true;
            i += 2;
            continue;
          }

          /* ── JOIN keywords ── */
          if (tok.type === 'keyword' && isJoinStart(tokens, i)) {
            pushLine();
            inSelect = false;
            var joinParts = kwText(tok);
            i++;
            while (i < tokens.length && tokens[i].type === 'keyword' && (JOIN_KW[tokens[i].value] || tokens[i].value === 'JOIN')) {
              joinParts += ' ' + kwText(tokens[i]);
              if (tokens[i].value === 'JOIN') { i++; break; }
              i++;
            }
            curLine = indent(depth) + joinParts;
            afterClause = false;
            continue;
          }

          /* ── Major clause head ── */
          if (tok.type === 'keyword' && CLAUSE_HEADS[tok.value]) {
            pushLine();
            inSelect = (tok.value === 'SELECT');
            curLine = indent(depth) + kwText(tok);
            afterClause = true;
            i++;

            /* DISTINCT right after SELECT */
            if (inSelect && i < tokens.length && tokens[i].type === 'keyword' && tokens[i].value === 'DISTINCT') {
              curLine += ' ' + kwText(tokens[i]);
              i++;
            }

            /* INSERT INTO — keep together */
            if (tok.value === 'INSERT' && i < tokens.length && tokens[i].type === 'keyword' && tokens[i].value === 'INTO') {
              curLine += ' ' + kwText(tokens[i]);
              i++;
            }

            /* CREATE TABLE — keep together */
            if (tok.value === 'CREATE' && i < tokens.length && tokens[i].type === 'keyword' && tokens[i].value === 'TABLE') {
              curLine += ' ' + kwText(tokens[i]);
              i++;
            }

            /* UNION ALL — keep together */
            if (tok.value === 'UNION' && i < tokens.length && tokens[i].type === 'keyword' && tokens[i].value === 'ALL') {
              curLine += ' ' + kwText(tokens[i]);
              i++;
            }

            continue;
          }

          /* ── AND / OR under WHERE/HAVING ── */
          if (tok.type === 'keyword' && (tok.value === 'AND' || tok.value === 'OR')) {
            pushLine();
            curLine = indent(depth + 1) + kwText(tok);
            i++;
            continue;
          }

          /* ── Comma in SELECT: end of field ── */
          if (tok.type === 'punct' && tok.value === ',' && inSelect) {
            curLine += ',';
            pushLine();
            curLine = indent(depth + 1);
            afterClause = false;
            i++;
            continue;
          }

          /* ── Comma elsewhere ── */
          if (tok.type === 'punct' && tok.value === ',') {
            curLine += ',';
            i++;
            continue;
          }

          /* ── Semicolon ── */
          if (tok.type === 'punct' && tok.value === ';') {
            curLine += ';';
            pushLine();
            i++;
            continue;
          }

          /* ── After a clause head, first token goes indented on new line (for SELECT) ── */
          if (afterClause && inSelect) {
            pushLine();
            curLine = indent(depth + 1) + tokText(tok);
            afterClause = false;
            i++;
            continue;
          }

          /* ── Default: append with space ── */
          if (curLine.trim().length > 0 && curLine[curLine.length - 1] !== '(' && tok.value !== '.') {
            var prevChar = curLine[curLine.length - 1];
            if (prevChar !== '.' && prevChar !== '(') {
              curLine += ' ';
            }
          }
          curLine += tokText(tok);
          afterClause = false;
          i++;
        }

        pushLine();

        /* trim trailing whitespace from each line */
        for (var k = 0; k < lines.length; k++) {
          lines[k] = lines[k].replace(/\s+$/, '');
        }

        return lines.join('\n');
      }

      /* ── Minifier ── */
      function minifySQL(sql) {
        var tokens = tokenize(sql);
        var parts = [];
        for (var i = 0; i < tokens.length; i++) {
          var tok = tokens[i];
          if (tok.type === 'comment') continue;
          if (parts.length > 0) {
            var last = parts[parts.length - 1];
            var needsSpace =
              (tok.type === 'punct' && (tok.value === '(' || tok.value === ')' || tok.value === ',' || tok.value === ';' || tok.value === '.')) ||
              (last === '(' || last === '.' || last === ')');
            if (!needsSpace) parts.push(' ');
          }
          parts.push(tok.value);
        }
        return parts.join('');
      }

      /* ── engine:end ── */

      function getIndent() {
        var v = indentSel.value;
        if (v === 'tab') return '\t';
        return v === '4' ? '    ' : '  ';
      }

      var lastValidSqlOutput = '';

      /* ── Real-time format on input (debounced 300ms) ── */
      var _sfLiveTimer = null;
      input.addEventListener('input', function () {
        clearTimeout(_sfLiveTimer);
        invalidateCopy();
        _sfLiveTimer = setTimeout(function () {
          _sfLiveTimer = null;
          invalidateCopy();
          var raw = input.value.trim();
          if (!raw) { output.value = ''; lastValidSqlOutput = ''; clearStatus(); return; }
          try {
            var result = formatSQL(raw, getIndent(), uppercaseCb.checked);
            output.value = result;
            lastValidSqlOutput = result;
            setStatus(t.formatted, false);
          } catch (e) {
            output.value = '';
            lastValidSqlOutput = '';
            setStatus('Error: ' + e.message, true);
          }
        }, 300);
      });

      /* ── Button handlers ── */
      document.getElementById('sf-format').addEventListener('click', function () {
        clearTimeout(_sfLiveTimer);
        _sfLiveTimer = null;
        invalidateCopy();
        var raw = input.value.trim();
        if (!raw) { output.value = ''; lastValidSqlOutput = ''; clearStatus(); return; }
        try {
          output.value = formatSQL(raw, getIndent(), uppercaseCb.checked);
          lastValidSqlOutput = output.value;
          setStatus(t.formatted, false);
          window.trackTool && window.trackTool('sql_formatter', 'format');
        } catch (e) {
          output.value = '';
          lastValidSqlOutput = '';
          setStatus('Error: ' + e.message, true);
        }
      });

      document.getElementById('sf-minify').addEventListener('click', function () {
        clearTimeout(_sfLiveTimer);
        _sfLiveTimer = null;
        invalidateCopy();
        var raw = input.value.trim();
        if (!raw) { output.value = ''; lastValidSqlOutput = ''; clearStatus(); return; }
        try {
          output.value = minifySQL(raw);
          lastValidSqlOutput = output.value;
          setStatus(t.minified, false);
          window.trackTool && window.trackTool('sql_formatter', 'minify');
        } catch (e) {
          output.value = '';
          lastValidSqlOutput = '';
          setStatus('Error: ' + e.message, true);
        }
      });

      document.getElementById('sf-clear').addEventListener('click', function () {
        clearTimeout(_sfLiveTimer);
        _sfLiveTimer = null;
        invalidateCopy();
        input.value = '';
        output.value = '';
        lastValidSqlOutput = '';
        clearStatus();
        input.focus();
      });

      copyBtn.addEventListener('click', function () {
        var text = output.value;
        if (!text) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = t.copy;
        function current() { return revision === copyRevision && output.value === text; }
        function failed() {
          if (!current()) return;
          setStatus(t.copyFailed, true);
          copyFailure = true;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (!current()) return;
            if (copyFailure && statusEl.textContent === t.copyFailed) clearStatus();
            copyBtn.textContent = t.copied;
            copyTimer = setTimeout(function () {
              if (current()) copyBtn.textContent = t.copy;
            }, 1500);
          }, failed);
        } catch (_) { failed(); }
      });

      /* ── Keyboard shortcut: Ctrl/Cmd+Enter ── */
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault();
          e.stopPropagation();
          document.getElementById('sf-format').click();
        }
      });
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'l' && document.querySelector('.sf-wrap').contains(document.activeElement)) {
          e.preventDefault();
          document.getElementById('sf-clear').click();
        }
      });
    })();
  </script>
</div>

<style>
  .sf-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; min-height: 0; }
  .sf-options, .sf-toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem; flex: none; }
  .sf-control { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .sf-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; min-height: 32px; }
  .sf-head.sf-control { justify-content: flex-start; }
  .sf-head label, .sf-options label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .sf-opt { display: flex; align-items: center; gap: 0.35rem; }
  .sf-opt input { accent-color: var(--color-primary); }
  .sf-options select { min-height: 44px; font-size: 0.85rem; }
  .sf-box { min-width: 0; overflow: auto; tab-size: 2; }
  .sf-status { height: 2.6rem; min-height: 2.6rem; flex: none; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; line-height: 1.5; color: var(--color-text-secondary); }
  .sf-status.success { color: var(--color-success); }
  .sf-status.error { color: var(--color-danger); }
  .sf-empty { display: none; flex: 1; align-items: center; justify-content: center; margin: 0; padding: 1rem; color: var(--color-text-secondary); text-align: center; }
  .sf-result:has(#sf-output:placeholder-shown) .sf-empty { display: flex; }
  #sf-output:placeholder-shown { display: none; }

  @media (max-width: 860px) {
    .sf-box { height: 180px; }
    .sf-result:has(#sf-output:placeholder-shown) { display: none; }
    .sf-status { height: 3.25rem; min-height: 3.25rem; }
  }
  @media (max-width: 640px) {
    .sf-wrap { gap: 0.5rem; }
    .sf-toolbar { gap: 0.4rem; }
    .sf-toolbar button { padding-inline: 0.55rem; }
    .sf-head { min-height: 44px; }
    .sf-box { height: 120px; }
  }
</style>
