---
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const labels = {
  en: {
    tabManual: 'Manual Editor',
    tabCsv: 'CSV Paste',
    tabJson: 'JSON Paste',
    addRow: '+ Row',
    addCol: '+ Column',
    removeRow: '− Row',
    removeCol: '− Column',
    csvLabel: 'Paste CSV (comma, tab, or semicolon separated):',
    jsonLabel: 'Paste JSON array of objects:',
    copy: 'Copy',
    copied: 'Copied!',
    outputPlaceholder: 'Markdown table will appear here...',
    header: 'Header',
    markdownOutput: 'Markdown Output',
    importedCsv: function(n: number) { return 'Imported ' + n + ' row(s) from CSV.'; },
    importedJson: function(n: number) { return 'Imported ' + n + ' row(s) from JSON.'; },
  },
  zh: {
    tabManual: '手动编辑',
    tabCsv: 'CSV 粘贴',
    tabJson: 'JSON 粘贴',
    addRow: '+ 行',
    addCol: '+ 列',
    removeRow: '− 行',
    removeCol: '− 列',
    csvLabel: '粘贴 CSV（逗号、制表符或分号分隔）：',
    jsonLabel: '粘贴 JSON 对象数组：',
    copy: '复制',
    copied: '已复制！',
    outputPlaceholder: 'Markdown 表格将在此处显示...',
    header: '表头',
    markdownOutput: 'Markdown 输出',
    importedCsv: function(n: number) { return '已从 CSV 导入 ' + n + ' 行。'; },
    importedJson: function(n: number) { return '已从 JSON 导入 ' + n + ' 行。'; },
  },
  ja: {
    tabManual: '手動編集',
    tabCsv: 'CSV 貼り付け',
    tabJson: 'JSON 貼り付け',
    addRow: '+ 行',
    addCol: '+ 列',
    removeRow: '− 行',
    removeCol: '− 列',
    csvLabel: 'CSV を貼り付け（カンマ・タブ・セミコロン区切り）：',
    jsonLabel: 'JSONオブジェクト配列を貼り付け：',
    copy: 'コピー',
    copied: 'コピーしました！',
    outputPlaceholder: 'Markdownテーブルがここに表示されます...',
    header: 'ヘッダー',
    markdownOutput: 'Markdown 出力',
    importedCsv: function(n: number) { return 'CSV から ' + n + ' 行をインポートしました。'; },
    importedJson: function(n: number) { return 'JSON から ' + n + ' 行をインポートしました。'; },
  },
  ko: {
    tabManual: '수동 편집',
    tabCsv: 'CSV 붙여넣기',
    tabJson: 'JSON 붙여넣기',
    addRow: '+ 행',
    addCol: '+ 열',
    removeRow: '− 행',
    removeCol: '− 열',
    csvLabel: 'CSV 붙여넣기 (쉼표, 탭, 세미콜론 구분):',
    jsonLabel: 'JSON 객체 배열 붙여넣기:',
    copy: '복사',
    copied: '복사됨!',
    outputPlaceholder: 'Markdown 테이블이 여기에 표시됩니다...',
    header: '헤더',
    markdownOutput: 'Markdown 출력',
    importedCsv: function(n: number) { return 'CSV에서 ' + n + '개 행을 가져왔습니다.'; },
    importedJson: function(n: number) { return 'JSON에서 ' + n + '개 행을 가져왔습니다.'; },
  },
};

const L = labels[lang] ?? labels['en'];
---

<div
  class="mdt-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-header={L.header}
  data-imported-csv-prefix={lang === 'en' ? 'Imported' : (lang === 'zh' ? '已从 CSV 导入' : (lang === 'ja' ? 'CSV から' : 'CSV에서'))}
  data-imported-json-prefix={lang === 'en' ? 'Imported' : (lang === 'zh' ? '已从 JSON 导入' : (lang === 'ja' ? 'JSON から' : 'JSON에서'))}
  data-lang={lang}
>

  {/* Tab Bar */}
  <div class="mdt-tabs" role="tablist">
    <button class="mdt-tab active" data-tab="manual" role="tab" aria-selected="true">{L.tabManual}</button>
    <button class="mdt-tab" data-tab="csv" role="tab" aria-selected="false">{L.tabCsv}</button>
    <button class="mdt-tab" data-tab="json" role="tab" aria-selected="false">{L.tabJson}</button>
  </div>

  {/* Manual Editor Tab */}
  <div class="mdt-tabpanel" id="mdt-panel-manual">
    <div class="mdt-toolbar">
      <button id="mdt-add-row" class="btn-ghost" type="button">{L.addRow}</button>
      <button id="mdt-add-col" class="btn-ghost" type="button">{L.addCol}</button>
      <button id="mdt-remove-row" class="btn-ghost" type="button">{L.removeRow}</button>
      <button id="mdt-remove-col" class="btn-ghost" type="button">{L.removeCol}</button>
    </div>
    <div class="mdt-table-wrap">
      <table class="mdt-table" id="mdt-table" aria-label="Editable table">
        <thead id="mdt-thead"></thead>
        <tbody id="mdt-tbody"></tbody>
      </table>
    </div>
  </div>

  {/* CSV Paste Tab */}
  <div class="mdt-tabpanel hidden" id="mdt-panel-csv">
    <label for="mdt-csv-input" class="mdt-label">{L.csvLabel}</label>
    <textarea
      id="mdt-csv-input"
      class="mdt-textarea"
      placeholder="name,age,city&#10;Alice,30,New York&#10;Bob,25,London"
      spellcheck="false"
      rows="8"
    ></textarea>
  </div>

  {/* JSON Paste Tab */}
  <div class="mdt-tabpanel hidden" id="mdt-panel-json">
    <label for="mdt-json-input" class="mdt-label">{L.jsonLabel}</label>
    <textarea
      id="mdt-json-input"
      class="mdt-textarea"
      placeholder='[{"name":"Alice","age":30},{"name":"Bob","age":25}]'
      spellcheck="false"
      rows="8"
    ></textarea>
  </div>

  {/* Markdown Output */}
  <div class="mdt-output-section">
    <label class="mdt-label" for="mdt-output">
      <span>{L.markdownOutput}</span>
      <button id="mdt-copy" class="btn-copy" type="button">{L.copy}</button>
    </label>
    <textarea
      id="mdt-output"
      class="mdt-textarea mdt-output"
      readonly
      spellcheck="false"
      rows="6"
      placeholder={L.outputPlaceholder}
    ></textarea>
  </div>

  <div id="mdt-status" class="mdt-status" aria-live="polite"></div>

  <script is:inline>
    (function () {
      /* ── Labels from data attributes ── */
      var wrap = document.currentScript
        ? document.currentScript.closest('.mdt-wrap')
        : document.querySelector('.mdt-wrap');
      var COPY_LABEL = wrap ? wrap.dataset.copy : 'Copy';
      var COPIED_LABEL = wrap ? wrap.dataset.copied : 'Copied!';
      var HEADER_LABEL = wrap ? wrap.dataset.header : 'Header';
      var pageLang = wrap ? (wrap.dataset.lang || 'en') : 'en';

      /* ── i18n status messages ── */
      var STATUS_STRINGS = {
        en: {
          csvImported: function(n) { return 'Imported ' + n + ' row(s) from CSV.'; },
          jsonImported: function(n) { return 'Imported ' + n + ' row(s) from JSON.'; },
          csvError: 'CSV error: ', jsonError: 'JSON error: '
        },
        zh: {
          csvImported: function(n) { return '已从 CSV 导入 ' + n + ' 行。'; },
          jsonImported: function(n) { return '已从 JSON 导入 ' + n + ' 行。'; },
          csvError: 'CSV 错误：', jsonError: 'JSON 错误：'
        },
        ja: {
          csvImported: function(n) { return 'CSV から ' + n + ' 行をインポートしました。'; },
          jsonImported: function(n) { return 'JSON から ' + n + ' 行をインポートしました。'; },
          csvError: 'CSV エラー：', jsonError: 'JSON エラー：'
        },
        ko: {
          csvImported: function(n) { return 'CSV에서 ' + n + '개 행을 가져왔습니다.'; },
          jsonImported: function(n) { return 'JSON에서 ' + n + '개 행을 가져왔습니다.'; },
          csvError: 'CSV 오류: ', jsonError: 'JSON 오류: '
        }
      };
      var ts = STATUS_STRINGS[pageLang] || STATUS_STRINGS.en;

      /* ── State ── */
      var COLS = 3;
      var ROWS = 3;
      var alignments = []; // 'left' | 'center' | 'right' per column

      var thead = document.getElementById('mdt-thead');
      var tbody = document.getElementById('mdt-tbody');
      var outputEl = document.getElementById('mdt-output');
      var statusEl = document.getElementById('mdt-status');
      var copyBtn = document.getElementById('mdt-copy');

      /* ── Helpers ── */
      function setStatus(msg, isError) {
        statusEl.textContent = msg;
        statusEl.className = 'mdt-status ' + (isError ? 'error' : 'success');
      }

      function clearStatus() {
        statusEl.textContent = '';
        statusEl.className = 'mdt-status';
      }

      function getCellText(td) {
        return td.textContent.trim();
      }

      function escapePipe(str) {
        return str.replace(/\|/g, '\\|');
      }

      /* ── Build markdown from the editor table ── */
      function generateMarkdown() {
        var headers = [];
        var ths = thead.querySelectorAll('th.mdt-cell');
        for (var i = 0; i < ths.length; i++) {
          headers.push(escapePipe(getCellText(ths[i])));
        }

        if (headers.length === 0) { outputEl.value = ''; return; }

        var sep = [];
        for (var c = 0; c < headers.length; c++) {
          var al = alignments[c] || 'left';
          if (al === 'center') sep.push(':---:');
          else if (al === 'right') sep.push('---:');
          else sep.push('---');
        }

        var lines = [];
        lines.push('| ' + headers.join(' | ') + ' |');
        lines.push('| ' + sep.join(' | ') + ' |');

        var trs = tbody.querySelectorAll('tr');
        for (var r = 0; r < trs.length; r++) {
          var tds = trs[r].querySelectorAll('td.mdt-cell');
          var cells = [];
          for (var ci = 0; ci < tds.length; ci++) {
            cells.push(escapePipe(getCellText(tds[ci])));
          }
          lines.push('| ' + cells.join(' | ') + ' |');
        }

        outputEl.value = lines.join('\n');
      }

      /* ── Alignment selector in each header ── */
      function buildAlignSelect(colIdx) {
        var wrap = document.createElement('span');
        wrap.className = 'mdt-align-wrap';

        var options = [
          { val: 'left', label: '⇤' },
          { val: 'center', label: '⇔' },
          { val: 'right', label: '⇥' },
        ];

        options.forEach(function (opt) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.dataset.alignVal = opt.val;
          btn.className = 'mdt-align-btn' + (alignments[colIdx] === opt.val ? ' active' : '');
          btn.title = opt.val;
          btn.textContent = opt.label;
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            alignments[colIdx] = opt.val;
            // update active state for siblings
            var siblings = wrap.querySelectorAll('.mdt-align-btn');
            siblings.forEach(function (s) {
              s.classList.toggle('active', s.dataset.alignVal === opt.val);
            });
            generateMarkdown();
            window.trackTool && window.trackTool('markdown_table_generator', 'align_' + opt.val);
          });
          wrap.appendChild(btn);
        });

        return wrap;
      }

      /* ── Wire up a header <th>: input regenerates markdown, focus selects all ── */
      function attachHeaderCell(th) {
        th.addEventListener('input', function () { generateMarkdown(); });
        th.addEventListener('focus', function () {
          var el = this;
          setTimeout(function () {
            var range = document.createRange();
            range.selectNodeContents(el);
            var sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
          }, 0);
        });
      }

      /* ── Build/rebuild the editor table ── */
      function buildTable(data) {
        // data: { headers: string[], rows: string[][] }
        COLS = data.headers.length;
        ROWS = data.rows.length;

        // Ensure alignments array is correct length
        while (alignments.length < COLS) alignments.push('left');
        alignments.length = COLS;

        // Build header: row 1 = alignment controls, row 2 = editable text
        thead.innerHTML = '';

        var trAlign = document.createElement('tr');
        trAlign.className = 'mdt-align-row';
        data.headers.forEach(function (h, ci) {
          var thAlign = document.createElement('th');
          thAlign.className = 'mdt-align-cell';
          thAlign.appendChild(buildAlignSelect(ci));
          trAlign.appendChild(thAlign);
        });
        thead.appendChild(trAlign);

        var trHead = document.createElement('tr');
        trHead.className = 'mdt-header-row';
        data.headers.forEach(function (h, ci) {
          var th = document.createElement('th');
          th.className = 'mdt-cell';
          th.contentEditable = 'true';
          th.spellcheck = false;
          th.textContent = h;
          attachHeaderCell(th);
          trHead.appendChild(th);
        });
        thead.appendChild(trHead);

        // Build body rows
        tbody.innerHTML = '';
        data.rows.forEach(function (row) {
          var tr = document.createElement('tr');
          for (var ci = 0; ci < COLS; ci++) {
            var td = document.createElement('td');
            td.className = 'mdt-cell';
            td.contentEditable = 'true';
            td.spellcheck = false;
            td.textContent = row[ci] !== undefined ? row[ci] : '';
            td.addEventListener('input', function () { generateMarkdown(); });
            tr.appendChild(td);
          }
          tbody.appendChild(tr);
        });

        generateMarkdown();
      }

      function defaultHeaders(n) {
        var h = [];
        for (var i = 1; i <= n; i++) h.push(HEADER_LABEL + ' ' + i);
        return h;
      }

      function defaultRows(r, c) {
        var rows = [];
        for (var i = 0; i < r; i++) {
          var row = [];
          for (var j = 0; j < c; j++) row.push('');
          rows.push(row);
        }
        return rows;
      }

      /* ── Init with default 3×3 ── */
      alignments = ['left', 'left', 'left'];
      buildTable({ headers: defaultHeaders(3), rows: defaultRows(3, 3) });

      /* ── Toolbar actions ── */
      document.getElementById('mdt-add-row').addEventListener('click', function () {
        var tr = document.createElement('tr');
        for (var ci = 0; ci < COLS; ci++) {
          var td = document.createElement('td');
          td.className = 'mdt-cell';
          td.contentEditable = 'true';
          td.spellcheck = false;
          td.addEventListener('input', function () { generateMarkdown(); });
          tr.appendChild(td);
        }
        tbody.appendChild(tr);
        ROWS++;
        generateMarkdown();
      });

      document.getElementById('mdt-remove-row').addEventListener('click', function () {
        if (ROWS <= 1) return;
        tbody.removeChild(tbody.lastElementChild);
        ROWS--;
        generateMarkdown();
      });

      document.getElementById('mdt-add-col').addEventListener('click', function () {
        alignments.push('left');
        COLS++;

        // Add align cell to the align row
        var trAlign = thead.querySelector('tr.mdt-align-row');
        var thAlign = document.createElement('th');
        thAlign.className = 'mdt-align-cell';
        thAlign.appendChild(buildAlignSelect(COLS - 1));
        trAlign.appendChild(thAlign);

        // Add header text cell to the header row
        var trHead = thead.querySelector('tr.mdt-header-row');
        var th = document.createElement('th');
        th.className = 'mdt-cell';
        th.contentEditable = 'true';
        th.spellcheck = false;
        th.textContent = HEADER_LABEL + ' ' + COLS;
        attachHeaderCell(th);
        trHead.appendChild(th);

        // Add body cells
        var trs = tbody.querySelectorAll('tr');
        trs.forEach(function (tr) {
          var td = document.createElement('td');
          td.className = 'mdt-cell';
          td.contentEditable = 'true';
          td.spellcheck = false;
          td.addEventListener('input', function () { generateMarkdown(); });
          tr.appendChild(td);
        });

        generateMarkdown();
      });

      document.getElementById('mdt-remove-col').addEventListener('click', function () {
        if (COLS <= 1) return;
        alignments.pop();
        COLS--;

        var trAlign = thead.querySelector('tr.mdt-align-row');
        if (trAlign && trAlign.lastElementChild) trAlign.removeChild(trAlign.lastElementChild);

        var trHead = thead.querySelector('tr.mdt-header-row');
        if (trHead && trHead.lastElementChild) trHead.removeChild(trHead.lastElementChild);

        var trs = tbody.querySelectorAll('tr');
        trs.forEach(function (tr) {
          if (tr.lastElementChild) tr.removeChild(tr.lastElementChild);
        });

        generateMarkdown();
      });

      /* ── Tabs ── */
      var tabs = document.querySelectorAll('.mdt-tab');
      var panels = document.querySelectorAll('.mdt-tabpanel');

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.dataset.tab;

          tabs.forEach(function (t) {
            t.classList.toggle('active', t.dataset.tab === target);
            t.setAttribute('aria-selected', t.dataset.tab === target ? 'true' : 'false');
          });

          panels.forEach(function (p) {
            p.classList.toggle('hidden', p.id !== 'mdt-panel-' + target);
          });

          clearStatus();
        });
      });

      /* ── Auto-detect delimiter for CSV ── */
      function detectDelimiter(text) {
        var firstLine = text.split('\n')[0];
        var counts = {
          ',': (firstLine.match(/,/g) || []).length,
          '\t': (firstLine.match(/\t/g) || []).length,
          ';': (firstLine.match(/;/g) || []).length,
        };
        if (counts['\t'] >= counts[','] && counts['\t'] >= counts[';']) return '\t';
        if (counts[';'] > counts[',']) return ';';
        return ',';
      }

      /* ── Simple CSV parser supporting quoted fields ── */
      function parseCsv(text, delim) {
        var rows = [];
        var row = [];
        var field = '';
        var inQuote = false;
        var i = 0;
        var len = text.length;

        while (i < len) {
          var ch = text[i];
          if (inQuote) {
            if (ch === '"') {
              if (i + 1 < len && text[i + 1] === '"') { field += '"'; i += 2; }
              else { inQuote = false; i++; }
            } else { field += ch; i++; }
          } else {
            if (ch === '"') { inQuote = true; i++; }
            else if (ch === delim) { row.push(field); field = ''; i++; }
            else if (ch === '\r') {
              row.push(field); field = ''; rows.push(row); row = []; i++;
              if (i < len && text[i] === '\n') i++;
            } else if (ch === '\n') {
              row.push(field); field = ''; rows.push(row); row = []; i++;
            } else { field += ch; i++; }
          }
        }
        if (field || row.length > 0) { row.push(field); rows.push(row); }
        if (rows.length > 0) {
          var last = rows[rows.length - 1];
          if (last.length === 1 && last[0] === '') rows.pop();
        }
        return rows;
      }

      /* ── CSV Paste: parse on input ── */
      document.getElementById('mdt-csv-input').addEventListener('input', function () {
        var raw = this.value.trim();
        if (!raw) { clearStatus(); return; }
        try {
          var delim = detectDelimiter(raw);
          var parsed = parseCsv(raw, delim);
          if (parsed.length < 1) throw new Error('No data found.');

          var headers = parsed[0].map(function (h) { return h.trim(); });
          var rows = parsed.slice(1).map(function (r) {
            return r.map(function (c) { return c.trim(); });
          });

          alignments = headers.map(function () { return 'left'; });
          buildTable({ headers: headers, rows: rows });
          setStatus(ts.csvImported(rows.length), false);
          window.trackTool && window.trackTool('markdown_table_generator', 'csv_import');
        } catch (e) {
          setStatus(ts.csvError + e.message, true);
        }
      });

      /* ── JSON Paste: parse on input ── */
      document.getElementById('mdt-json-input').addEventListener('input', function () {
        var raw = this.value.trim();
        if (!raw) { clearStatus(); return; }
        try {
          var data = JSON.parse(raw);
          if (!Array.isArray(data)) throw new Error('JSON must be an array of objects.');
          if (data.length === 0) throw new Error('JSON array is empty.');
          if (typeof data[0] !== 'object' || data[0] === null || Array.isArray(data[0])) {
            throw new Error('Each item must be a plain object.');
          }

          var headers = Object.keys(data[0]);
          var rows = data.map(function (obj) {
            return headers.map(function (k) {
              var v = obj[k];
              return v == null ? '' : String(v);
            });
          });

          alignments = headers.map(function () { return 'left'; });
          buildTable({ headers: headers, rows: rows });
          setStatus(ts.jsonImported(rows.length), false);
          window.trackTool && window.trackTool('markdown_table_generator', 'json_import');
        } catch (e) {
          setStatus(ts.jsonError + e.message, true);
        }
      });

      /* ── Copy button ── */
      copyBtn.addEventListener('click', function () {
        if (!outputEl.value) return;
        navigator.clipboard.writeText(outputEl.value).then(function () {
          copyBtn.textContent = COPIED_LABEL;
          setTimeout(function () { copyBtn.textContent = COPY_LABEL; }, 1500);
          window.trackTool && window.trackTool('markdown_table_generator', 'copy');
        });
      });

    })();
  </script>
</div>

<style is:global>
  .mdt-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  /* ── Tabs ── */
  .mdt-tabs {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0;
  }

  .mdt-tab {
    padding: 0.4rem 0.9rem;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    background: none;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    cursor: pointer;
    position: relative;
    bottom: -1px;
  }

  .mdt-tab:hover { color: var(--color-text); }

  .mdt-tab.active {
    background: var(--color-bg);
    border-color: var(--color-border);
    border-bottom-color: var(--color-bg);
    color: var(--color-text);
    font-weight: 600;
  }

  /* ── Tab panels ── */
  .mdt-tabpanel { display: flex; flex-direction: column; gap: 0.5rem; }
  .mdt-tabpanel.hidden { display: none; }

  /* ── Toolbar ── */
  .mdt-toolbar { display: flex; gap: 0.4rem; flex-wrap: wrap; }

  /* ── Editable table ── */
  .mdt-table-wrap { overflow-x: auto; }

  .mdt-table {
    border-collapse: collapse;
    min-width: 100%;
    font-size: 0.88rem;
  }

  .mdt-table thead tr { background: var(--color-bg-secondary); }

  .mdt-align-row { background: var(--color-bg); }

  .mdt-align-cell {
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.4rem;
    text-align: center;
    white-space: nowrap;
  }

  .mdt-cell {
    border: 1px solid var(--color-border);
    padding: 0.4rem 0.6rem;
    min-width: 80px;
    vertical-align: top;
    white-space: pre-wrap;
    word-break: break-word;
    position: relative;
  }

  th.mdt-cell {
    font-weight: 600;
  }

  .mdt-cell[contenteditable]:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: -1px;
