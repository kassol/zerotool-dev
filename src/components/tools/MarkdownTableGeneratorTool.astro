      table: { headers: headers, rows: rows, align: alignOut },
      tables: tables,
      startLine: found.startLine,
      endLine: found.endLine,
      extraRows: extraRows,
      addedColumns: added,
      doubleBackslash: doubleBackslash,
    };
  }

