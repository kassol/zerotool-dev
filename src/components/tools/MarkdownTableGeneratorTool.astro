const L = STRINGS[lang] ?? STRINGS.en;
// The script gets every string except the toggletip text, which is in the HTML.
const { tips: TIPS, ...CLIENT_L } = L;
const FORMATS = [['auto', L.fmtAuto], ['csv', L.fmtCsv], ['csv-semicolon', L.fmtCsvSemicolon], ['tsv', L.fmtTsv], ['json', L.fmtJson], ['html', L.fmtHtml], ['markdown', L.fmtMarkdown]];
const ACTIONS = [['rowAbove', L.rowAbove], ['rowBelow', L.rowBelow], ['deleteRow', L.deleteRow], ['colLeft', L.colLeft], ['colRight', L.colRight], ['deleteCol', L.deleteCol], ['moveLeft', L.moveLeft], ['moveRight', L.moveRight], ['sortAsc', L.sortAsc], ['sortDesc', L.sortDesc], ['transpose', L.transpose], ['undo', L.undo], ['clear', L.clear]];
---

<div class="mdt-wrap" data-lang={lang} data-strings={JSON.stringify(CLIENT_L)}>
  <div class="mdt-bar">
    <button type="button" id="mdt-copy" class="btn-primary mdt-copy">{L.copy}</button>
    <button type="button" id="mdt-download" class="btn-ghost">{L.download}</button>
  </div>

  <div class="mdt-out-opts">
    <span class="mdt-optwrap">
      <label class="mdt-opt"><span>{L.optStyle}</span>
        <select id="mdt-style" class="mdt-select"><option value="aligned">{L.styleAligned}</option><option value="compact">{L.styleCompact}</option></select>
      </label>
      <Toggletip id="mdt-tip-style" lang={lang} about={L.optStyle} wide>{TIPS.style}</Toggletip>
    </span>
    <span class="mdt-optwrap">
      <label class="mdt-opt"><span>{L.optCellText}</span>
        <select id="mdt-cell" class="mdt-select"><option value="markdown">{L.cellMarkdown}</option><option value="plain">{L.cellPlain}</option></select>
      </label>
      <Toggletip id="mdt-tip-cell" lang={lang} about={L.optCellText} wide>{TIPS.cell}</Toggletip>
    </span>
    <span class="mdt-optwrap">
      <label class="mdt-opt"><span>{L.optBreaks}</span>
        <select id="mdt-breaks" class="mdt-select"><option value="br">{L.breaksBr}</option><option value="space">{L.breaksSpace}</option></select>
      </label>
      <Toggletip id="mdt-tip-breaks" lang={lang} about={L.optBreaks}>{TIPS.breaks}</Toggletip>
    </span>
    <span class="mdt-optwrap">
      <label class="mdt-opt"><input type="checkbox" id="mdt-ambiguous" /><span>{L.optAmbiguous}</span></label>
      <Toggletip id="mdt-tip-ambiguous" lang={lang} about={L.optAmbiguous} wide>{TIPS.ambiguous}</Toggletip>
    </span>
  </div>

  <p id="mdt-status" class="tool-status mdt-status" role="status" aria-live="polite"></p>

  <div class="mdt-panels zt-io">
    <div class="mdt-in zt-io-pane">
      <div class="mdt-in-head">
        <div class="mdt-tabs" role="tablist">
          <button type="button" class="mdt-tab" role="tab" id="mdt-tab-edit" aria-selected="true" aria-controls="mdt-panel-edit" data-tab="edit">{L.tabEdit}</button>
          <button type="button" class="mdt-tab" role="tab" id="mdt-tab-import" aria-selected="false" aria-controls="mdt-panel-import" data-tab="import" tabindex="-1">{L.tabImport}</button>
        </div>
        <Toggletip id="mdt-tip-grid" lang={lang} about={L.tabEdit} wide>{TIPS.grid}</Toggletip>
      </div>

      <div class="mdt-panel" id="mdt-panel-edit" role="tabpanel" aria-labelledby="mdt-tab-edit">
        <div class="mdt-acts">
          <div class="mdt-toolbar" role="toolbar" aria-label={L.toolbar}>
            {ACTIONS.map(([id, label]) => <button type="button" class="mdt-act" data-act={id}>{label}</button>)}
          </div>
          <Toggletip id="mdt-tip-actions" lang={lang} about={L.toolbar} wide>{TIPS.actions}</Toggletip>
        </div>
        <div class="mdt-grid-wrap zt-io-fill" id="mdt-grid-wrap">
          <table class="mdt-grid" id="mdt-grid">
            <thead id="mdt-thead"></thead>
            <tbody id="mdt-tbody"></tbody>
          </table>
        </div>
      </div>

      <div class="mdt-panel" id="mdt-panel-import" role="tabpanel" aria-labelledby="mdt-tab-import" hidden>
        <div class="mdt-import-head">
          <label for="mdt-import" class="tool-label">{L.importLabel}</label>
          <Toggletip id="mdt-tip-import" lang={lang} about={L.tabImport} wide>{TIPS.import}</Toggletip>
        </div>
        <textarea id="mdt-import" class="tool-textarea mdt-import zt-io-fill" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder={L.importPlaceholder}></textarea>
        <div class="mdt-import-opts">
          <label class="mdt-opt"><span>{L.formatLabel}</span>
            <select id="mdt-format" class="mdt-select">
              {FORMATS.map(([v, label]) => <option value={v}>{label}</option>)}
            </select>
          </label>
          <span class="mdt-optwrap">
            <label class="mdt-opt"><input type="checkbox" id="mdt-first-header" checked /><span>{L.firstRowHeader}</span></label>
            <Toggletip id="mdt-tip-header" lang={lang} about={L.firstRowHeader}>{TIPS.header}</Toggletip>
          </span>
          <button type="button" id="mdt-import-example" class="btn-ghost btn-sm">{L.importExample}</button>
          <label class="btn-ghost btn-sm mdt-file-btn">{L.fileOpen}<input type="file" id="mdt-file" class="mdt-file-input" accept=".csv,.tsv,.tab,.txt,.json,.md,.markdown,.html,.htm,text/csv,text/tab-separated-values,text/plain,application/json,text/markdown,text/html" /></label>
          <span class="mdt-drop-hint">{L.fileDropHint}</span>
        </div>
      </div>
    </div>

    <section class="mdt-out zt-io-pane" aria-labelledby="mdt-out-label">
      <div class="mdt-out-head">
        <span id="mdt-out-label" class="tool-label">{L.outputLabel}</span>
        <Toggletip id="mdt-tip-output" lang={lang} about={L.outputLabel} wide>{TIPS.output}</Toggletip>
        <div class="mdt-view" role="group">
          <button type="button" class="mdt-view-btn" data-view="markdown" aria-pressed="true">{L.viewMarkdown}</button>
          <button type="button" class="mdt-view-btn" data-view="preview" aria-pressed="false">{L.viewPreview}</button>
        </div>
      </div>
      <textarea id="mdt-output" class="tool-textarea mdt-output zt-io-fill" readonly spellcheck="false" aria-labelledby="mdt-out-label"></textarea>
      <div id="mdt-preview" class="mdt-preview zt-io-fill" hidden></div>
      <p id="mdt-notes" class="mdt-notes"></p>
    </section>
  </div>
</div>

<script>
