  var AMBIGUOUS_RANGES = decodeRanges(EAW_AMBIGUOUS);

  function inRanges(ranges, cp) {
    var lo = 0;
    var hi = ranges.length / 2 - 1;
    while (lo <= hi) {
      var mid = (lo + hi) >> 1;
      if (cp < ranges[mid * 2]) hi = mid - 1;
      else if (cp > ranges[mid * 2 + 1]) lo = mid + 1;
      else return true;
    }
    return false;
