const L = STRINGS[lang] ?? STRINGS.en;
const FORMATS = [['auto', L.fmtAuto], ['csv', L.fmtCsv], ['csv-semicolon', L.fmtCsvSemicolon], ['tsv', L.fmtTsv], ['json', L.fmtJson], ['html', L.fmtHtml], ['markdown', L.fmtMarkdown]];
const ACTIONS = [['rowAbove', L.rowAbove], ['rowBelow', L.rowBelow], ['deleteRow', L.deleteRow], ['colLeft', L.colLeft], ['colRight', L.colRight], ['deleteCol', L.deleteCol], ['moveLeft', L.moveLeft], ['moveRight', L.moveRight], ['sortAsc', L.sortAsc], ['sortDesc', L.sortDesc], ['transpose', L.transpose], ['undo', L.undo], ['clear', L.clear]];
---

<div class="mdt-wrap" data-lang={lang} data-strings={JSON.stringify(L)}>
  <div class="mdt-bar">
    <div class="mdt-tabs" role="tablist">
      <button type="button" class="mdt-tab" role="tab" id="mdt-tab-edit" aria-selected="true" aria-controls="mdt-panel-edit" data-tab="edit">{L.tabEdit}</button>
      <button type="button" class="mdt-tab" role="tab" id="mdt-tab-import" aria-selected="false" aria-controls="mdt-panel-import" data-tab="import" tabindex="-1">{L.tabImport}</button>
    </div>
    <button type="button" id="mdt-copy" class="btn-primary mdt-copy">{L.copy}</button>
  </div>

  <div class="mdt-panel" id="mdt-panel-edit" role="tabpanel" aria-labelledby="mdt-tab-edit">
    <div class="mdt-toolbar" role="toolbar" aria-label={L.toolbar}>
