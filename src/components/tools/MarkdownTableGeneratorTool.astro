      table = transpose(table);
      msg = fmt(T.transposed, { rows: table.rows.length, cols: table.headers.length });
      next = { r: 0, c: 0 };
    } else if (act === 'clear') {
      table = emptyTable(3, 3, T.header);
      msg = T.cleared;
      next = { r: 0, c: 0 };
    }
    cur = next;
    clampCur();
    renderGrid();
    updateOutput();
    if (msg) setStatus(msg, 'success');
    if (act !== 'clear' && act !== 'transpose') focusCell(cur.r, cur.c);
    track(act || '');
  });

  /* ── Tabs ── */
  const tabs = Array.prototype.slice.call(wrap.querySelectorAll('.mdt-tab')) as HTMLElement[];
  function selectTab(name: string, focus: boolean) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === name;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    $('mdt-panel-edit').hidden = name !== 'edit';
    $('mdt-panel-import').hidden = name !== 'import';
    if (name === 'edit' && importFailed) { clearImportFailure(); updateOutput(); }
  }
  tabs.forEach((t) => {
    t.addEventListener('click', () => selectTab(t.dataset.tab!, false));
    t.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      selectTab(t.dataset.tab === 'edit' ? 'import' : 'edit', true);
    });
  });

  /* ── Import ── */
  const FORMAT_NAMES: Record<string, string> = { csv: 'CSV', 'csv-semicolon': 'CSV', tsv: 'TSV', json: 'JSON', html: 'HTML', markdown: 'Markdown' };
  let importTimer: any = null;

  // An import that fails clears the output and turns Copy and Download off, so the Markdown of
  // an earlier import cannot be taken for this text. The grid keeps its table; opening Edit,
  // a successful import, emptying the import box or Ctrl/Cmd+L brings the output back.
  function failImport(msg: string) {
    importFailed = true;
    setStatus(msg, 'error');
    updateOutput();
  }
  function clearImportFailure() {
    importFailed = false;
  }
  function importError(code: string, args: Record<string, any>) {
    return Object.assign(new Error(code), { code: code, args: args });
  }

  function runImport() {
    const text = importEl.value;
    if (!text.trim()) { setStatus('', 'none'); if (importFailed) { clearImportFailure(); updateOutput(); } return; }
    let format = formatEl.value;
    if (format === 'auto') {
      format = detectFormat(text);
      if ((format === 'csv' || format === 'tsv') && looksLikeJson(text)) format = 'json';
    }
    const notes: string[] = [];
    let next: any;
    try {
      if (format === 'json') {
        let data: any;
        const src = text.replace(/^\uFEFF/, '');
        try { data = JSON.parse(src); }
        catch (err: any) {
          const e = jsonSyntaxError(src);
          const at = lineCol(src, e ? e.offset : src.length);
          const P = (T as any).jsonParse || {};
          const reason = e ? fmt(P[e.code] || P.unexpectedChar, { ch: e.ch === undefined ? '' : e.ch }) : String(err && err.message);
          throw importError('jsonSyntax', { line: at.line, col: at.col, reason: reason });
        }
        const j = jsonToTable(data);
        if (j.headers) next = { headers: j.headers, rows: j.rows, align: j.headers.map(() => 'none') };
        else { const t2 = rowsToTable(j.rows, firstHeaderEl.checked, T.column); next = t2.table; if (t2.addedColumns.length) notes.push(fmt(T.addedCols, { cols: t2.addedColumns.map((n: number) => T.column + ' ' + n).join(', ') })); }
      } else if (format === 'html') {
        const doc = new DOMParser().parseFromString(text, 'text/html');
        const res = htmlTableRows(doc, DOM_ADAPTER);
        if (!res || !res.rows.length) throw Object.assign(new Error('htmlNoTable'), { code: 'htmlNoTable', args: {} });
        const g = gridFromHtmlRows(res.rows);
        const t2 = rowsToTable(g.rows, firstHeaderEl.checked, T.column);
        next = t2.table;
        if (g.spans) notes.push(fmt(T.spans, { n: g.spans }));
        if (t2.addedColumns.length) notes.push(fmt(T.addedCols, { cols: t2.addedColumns.map((n: number) => T.column + ' ' + n).join(', ') }));
      } else if (format === 'markdown') {
        const p = parseMarkdownTable(text) || parseFullwidthTable(text);
        if (!p) {
          const bad = markdownColumnMismatch(text);
          throw bad ? importError('mdCols', bad) : importError('mdNotFound', {});
        }
        next = p.table;
        if (p.fullwidth) notes.push(T.mdFullwidth);
        if (p.tables > 1) notes.push(fmt(T.mdMoreTables, { n: p.tables, from: p.startLine, to: p.endLine }));
        if (p.extraRows) notes.push(fmt(T.mdExtra, { n: p.extraRows, cols: p.addedColumns.map((n: number) => 'Column ' + n).join(', ') }));
        if (p.doubleBackslash) notes.push(fmt(T.mdDoubleBackslash, { n: p.doubleBackslash }));
      } else {
        if (formatEl.value === 'auto') {
          const bad = markdownColumnMismatch(text);
          if (bad) throw importError('mdCols', bad);
        }
        const delim = format === 'tsv' ? '\t' : format === 'csv-semicolon' ? ';' : formatEl.value === 'auto' ? detectDelimiter(text) : ',';
        const rows = parseDelimited(text, delim).filter((r: string[]) => !(r.length === 1 && r[0] === ''));
        const t2 = rowsToTable(rows, firstHeaderEl.checked, T.column);
        next = t2.table;
        if (t2.addedColumns.length) notes.push(fmt(T.addedCols, { cols: t2.addedColumns.map((n: number) => T.column + ' ' + n).join(', ') }));
        if (delim === '\t') format = 'tsv';
        const q = openQuote(text, delim);
        if (q) notes.push(fmt(T.csvQuote, q));
      }
    } catch (err: any) {
      const code = err && err.code;
      failImport(code && T[code] ? fmt(T[code], err.args || {}) : String(err && err.message));
      return;
    }
    clearImportFailure();
    pushUndo();
    table = next;
    cur = { r: 0, c: 0 };
    clampCur();
    renderGrid();
    updateOutput();
    setStatus([fmt(T.imported, { rows: table.rows.length, cols: table.headers.length, format: FORMAT_NAMES[format] || format })].concat(notes).join(' '), 'success');
    track('import_' + format);
  }
  importEl.addEventListener('input', () => { clearTimeout(importTimer); importTimer = setTimeout(runImport, 250); });
  formatEl.addEventListener('change', runImport);
  firstHeaderEl.addEventListener('change', runImport);
  $('mdt-import-example').addEventListener('click', () => { importEl.value = importEl.placeholder; runImport(); });

  /* ── Open file / drop a file ── */
  // An opened file must be UTF-8 text: file.text() would turn every byte that is not UTF-8
  // into U+FFFD (a GBK or Shift_JIS CSV saved by Excel, an image picked by mistake).
  // firstBadUtf8 is copied from json-formatter-engine.js and decodeTextFile from
  // MarkdownToWordTool.astro; test-markdown-table-generator.mjs checks that the copies are the same.
  function firstBadUtf8(u8) {
    for (var x = 0; x < u8.length;) {
      var b = u8[x], need, min;
      if (b < 0x80) { x++; continue; }
      if (b >= 0xc2 && b <= 0xdf) { need = 1; min = 0x80; }
      else if (b >= 0xe0 && b <= 0xef) { need = 2; min = 0x800; }
      else if (b >= 0xf0 && b <= 0xf4) { need = 3; min = 0x10000; }
      else return x;
      var cp = b & (0x3f >> need);
      for (var y = 1; y <= need; y++) {
        var c = u8[x + y];
        if (c === undefined || (c & 0xc0) !== 0x80) return x;
        cp = (cp << 6) | (c & 0x3f);
      }
      if (cp < min || cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff)) return x;
      x += need + 1;
    }
    return -1;
  }
  function decodeTextFile(u8: Uint8Array): { text?: string; error?: string; offset?: number } {
    if ((u8[0] === 0xff && u8[1] === 0xfe) || (u8[0] === 0xfe && u8[1] === 0xff)) return { error: 'fileUtf16', offset: 0 };
    const nul = u8.indexOf(0);
    if (nul >= 0) {
      // UTF-16 text without a byte order mark: many NUL bytes, all on even or all on odd
      // offsets. Other NUL bytes mean a binary file (an image, an archive).
      const head = Math.min(u8.length, 64);
      let even = 0, odd = 0;
      for (let x = 0; x < head; x++) if (u8[x] === 0) { if (x % 2) odd++; else even++; }
      if ((even + odd) * 4 >= head && (even === 0 || odd === 0)) return { error: 'fileUtf16', offset: 0 };
      return { error: 'fileBinary', offset: nul };
    }
    const bad = firstBadUtf8(u8);
    if (bad >= 0) return { error: 'fileNotUtf8', offset: bad };
    // A UTF-8 byte order mark at the start is removed, as file.text() did.
    return { text: new TextDecoder('utf-8', { fatal: true }).decode(u8) };
  }
  const FILE_LIMIT = 10 * 1024 * 1024;
  const FORMAT_BY_EXT: Record<string, string> = { tsv: 'tsv', tab: 'tsv', json: 'json', md: 'markdown', markdown: 'markdown', html: 'html', htm: 'html' };
  let fileSeq = 0;
  async function openFile(file: File) {
    const seq = ++fileSeq;
    if (file.size > FILE_LIMIT) { setStatus(T.fileTooBig, 'error'); return; }
    let read: { text?: string; error?: string; offset?: number };
    try { read = decodeTextFile(new Uint8Array(await file.arrayBuffer())); }
    catch { if (seq === fileSeq) setStatus(T.fileError, 'error'); return; }
    // A later file or drop wins over this one.
    if (seq !== fileSeq) return;
    if (read.error) { setStatus(fmt(T[read.error], { offset: read.offset ?? 0 }), 'error'); return; }
    const ext = (/\.([a-z0-9]+)$/i.exec(file.name) || ['', ''])[1].toLowerCase();
    formatEl.value = FORMAT_BY_EXT[ext] || 'auto';
    selectTab('import', false);
    clearTimeout(importTimer);
    importEl.value = read.text as string;
    runImport();
  }
  const fileInput = $('mdt-file') as HTMLInputElement;
  fileInput.addEventListener('change', () => {
    const file = fileInput.files && fileInput.files[0];
    if (file) openFile(file);
    fileInput.value = '';
  });
  // Only drags that carry files are taken; text dragged into a cell or the import box is left
  // to the browser.
  const hasFiles = (ev: any) => !!(ev.dataTransfer && Array.from(ev.dataTransfer.types || []).includes('Files'));
  wrap.addEventListener('dragover', (ev: any) => { if (hasFiles(ev)) { ev.preventDefault(); wrap.classList.add('mdt-dragging'); } });
  wrap.addEventListener('dragleave', (ev: any) => { if (ev.target === wrap) wrap.classList.remove('mdt-dragging'); });
  wrap.addEventListener('drop', (ev: any) => {
    wrap.classList.remove('mdt-dragging');
    if (!hasFiles(ev)) return;
    ev.preventDefault();
    const file = ev.dataTransfer.files && ev.dataTransfer.files[0];
    if (file) openFile(file);
  });

  /* ── Output ── */
  let outputTimer: any = null;
  function scheduleOutput() { clearTimeout(outputTimer); outputTimer = setTimeout(updateOutput, 120); }

  function updateOutput() {
    clearTimeout(outputTimer);
    copyBtn.disabled = importFailed;
    downloadBtn.disabled = importFailed;
    if (importFailed) {
      checkSeq++;
      lastMarkdown = '';
      outputEl.value = '';
      notesEl.textContent = T.importCleared;
      if (view === 'preview') renderPreview();
      return;
    }
    const opts = options();
    const res = buildMarkdown(table, opts);
    lastMarkdown = res.markdown;
    outputEl.value = res.markdown;
    const notes = [fmt(T.stats, { rows: table.rows.length, cols: table.headers.length })];
    if (res.stats.breaks) notes.push(fmt(opts.newline === 'space' ? T.noteBreaksSpace : T.noteBreaks, { n: res.stats.breaks }));
    if (res.stats.tabs) notes.push(fmt(T.noteTabs, { n: res.stats.tabs }));
    if (res.stats.pipes) notes.push(fmt(T.notePipes, { n: res.stats.pipes }));
    if (table.rows.length > GRID_LIMIT) notes.push(fmt(T.gridLimit, { n: GRID_LIMIT, total: table.rows.length }));
    notesEl.textContent = notes.join(' ');
    if (view === 'preview') renderPreview();
    if (!opts.plain) checkMarkdownCells(res.markdown);
  }

  let mm: any = null;
  function loadMicromark() {
    if (!mm) {
      mm = Promise.all([import('micromark'), import('micromark-extension-gfm')]).then(([a, b]) => ({
        render: (src: string) => a.micromark(src, { extensions: [b.gfm()], htmlExtensions: [b.gfmHtml()], allowDangerousHtml: false, allowDangerousProtocol: false }),
      }));
    }
    return mm;
  }

  // Cells whose Markdown renders differently from the same text escaped as plain text.
  let checkSeq = 0;
  function checkMarkdownCells(markdown: string) {
    const seq = ++checkSeq;
    const cells: string[] = table.headers.slice();
    table.rows.forEach((r: string[]) => { for (let i = 0; i < r.length; i++) cells.push(r[i]); });
    const suspects = cells.filter((s) => s && /[*_`~\[<&$\\!:]/.test(s)).slice(0, 5000);
    if (!suspects.length) return;
    loadMicromark().then((lib: any) => {
      if (seq !== checkSeq || markdown !== lastMarkdown) return;
      let n = 0;
      suspects.forEach((s) => {
        const md = encodeCell(s, { plain: false, newline: 'br' }).md;
        const plain = encodeCell(s, { plain: true, newline: 'br' }).md;
        if (lib.render('|' + md + '|\n|-|') !== lib.render('|' + plain + '|\n|-|')) n++;
      });
      if (n) notesEl.textContent += ' ' + fmt(T.noteMarkdown, { n: n });
    });
  }

  function renderPreview() {
    const md = lastMarkdown;
    if (!md) { previewEl.textContent = T.previewEmpty; return; }
    loadMicromark().then((lib: any) => {
      if (md !== lastMarkdown) return;
      previewEl.innerHTML = lib.render(md);
      // micromark escapes raw HTML, so <br> arrives as text. Turn it back into a line break
      // outside code; nothing else from the cells becomes markup.
      const walker = document.createTreeWalker(previewEl, NodeFilter.SHOW_TEXT);
      const texts: Text[] = [];
      for (let n = walker.nextNode(); n; n = walker.nextNode()) texts.push(n as Text);
      texts.forEach((t) => {
        if (!/<br\s*\/?>/i.test(t.data) || (t.parentElement && t.parentElement.closest('code'))) return;
        const parts = t.data.split(/<br\s*\/?>/i);
        const frag = document.createDocumentFragment();
        parts.forEach((p, i) => { if (i) frag.appendChild(document.createElement('br')); frag.appendChild(document.createTextNode(p)); });
        t.replaceWith(frag);
      });
      previewEl.querySelectorAll('a[href]').forEach((a) => { a.setAttribute('target', '_blank'); a.setAttribute('rel', 'noopener noreferrer'); });
    });
  }

  function setView(v: string) {
    view = v;
    wrap.querySelectorAll('.mdt-view-btn').forEach((b) => b.setAttribute('aria-pressed', (b as HTMLElement).dataset.view === v ? 'true' : 'false'));
    outputEl.hidden = v !== 'markdown';
    previewEl.hidden = v !== 'preview';
    if (v === 'preview') renderPreview();
  }
  wrap.querySelectorAll('.mdt-view-btn').forEach((b) => b.addEventListener('click', () => { setView((b as HTMLElement).dataset.view!); savePrefs(); }));

  [styleEl, cellEl, breaksEl, ambiguousEl].forEach((el) => el.addEventListener('change', () => { updateOutput(); savePrefs(); }));

  /* ── Copy and download ── */
  copyBtn.addEventListener('click', () => {
    const text = lastMarkdown;
    if (!text) return;
    const done = () => {
      copyBtn.textContent = T.copied;
      setTimeout(() => { copyBtn.textContent = T.copy; }, 1500);
      track('copy');
    };
    const fallback = () => {
      outputEl.hidden = false;
      outputEl.focus();
      outputEl.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      if (view !== 'markdown') outputEl.hidden = true;
      if (ok) done(); else setStatus(T.copyFailed, 'error');
    };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fallback);
    else fallback();
  });

  $('mdt-download').addEventListener('click', () => {
    if (!lastMarkdown) return;
    const blob = new Blob([lastMarkdown + '\n'], { type: 'text/markdown;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'table.md';
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    track('download');
  });

  /* ── Site-wide Ctrl/Cmd+L clears the tool ── */
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (!(e.metaKey || e.ctrlKey) || (e.key !== 'l' && e.key !== 'L')) return;
    const widget = document.querySelector('.tool-widget');
    if (!widget || !document.activeElement || !widget.contains(document.activeElement)) return;
    setTimeout(() => {
      clearImportFailure();
      pushUndo();
      table = emptyTable(3, 3, T.header);
      cur = { r: 0, c: 0 };
      renderGrid();
      updateOutput();
      setStatus(T.cleared, 'success');
    }, 0);
  });

  renderGrid();
  setView(view);
  updateOutput();
</script>

<style is:global>
  /* v2 "convert" layout: the root is a flex column, so the two panes (.zt-io in tool-common.css)
     take the height that is left under the buttons, the options and the status line. Global
     because the grid and the preview are created by the script; every selector has the mdt- prefix. */
  .mdt-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-height: 0; }

  .mdt-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }

  .mdt-out-opts, .mdt-import-opts { display: flex; flex-wrap: wrap; gap: 0.35rem 1.1rem; align-items: center; }
  /* Open file: the input stays focusable (visually hidden), the label is the visible button. */
  .mdt-file-btn { position: relative; display: inline-flex; align-items: center; cursor: pointer; }
  .mdt-file-btn:focus-within { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .mdt-file-input { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .mdt-drop-hint { font-size: 0.8rem; color: var(--color-text-muted); }
  .mdt-wrap.mdt-dragging { outline: 2px dashed var(--color-primary); outline-offset: 4px; }
  .mdt-optwrap { display: inline-flex; align-items: center; gap: 0.3rem; }
  .mdt-opt { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.86rem; color: var(--color-text-secondary); }
  .mdt-select { min-height: 34px; padding: 0.2rem 0.5rem; font-size: 0.86rem; border: 1px solid var(--color-border); }

  .mdt-status { margin: 0; overflow-wrap: anywhere; }

  /* Segmented controls: the Table / Import data tabs and the Markdown / Preview switch. */
  .mdt-tabs, .mdt-view {
    display: inline-flex;
    padding: 3px;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }
  .mdt-tab, .mdt-view-btn {
    min-height: 32px;
    padding: 0.25rem 0.75rem;
    border: 0;
    border-radius: calc(var(--radius-md) - 2px);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }
  .mdt-view-btn { min-height: 26px; padding: 0.1rem 0.6rem; font-size: 0.82rem; }
  .mdt-tab[aria-selected="true"], .mdt-view-btn[aria-pressed="true"] { background: var(--color-surface); color: var(--color-primary); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12); }
  .mdt-tab:focus-visible, .mdt-view-btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 1px; }

  .mdt-in-head, .mdt-out-head, .mdt-import-head { display: flex; align-items: center; gap: 0.3rem; min-height: 38px; }
  /* A long label (ja) keeps to one line; the Markdown / Preview switch wraps under it on a phone. */
  .mdt-out-head { flex-wrap: wrap; }
  .mdt-out-head .tool-label { white-space: nowrap; }
  .mdt-out-head .mdt-view { margin-left: auto; }

  /* The tab panel passes the pane's height on to the grid or the import box. */
  .mdt-panel { display: flex; flex: 1 1 auto; flex-direction: column; gap: 0.5rem; min-height: 0; }
  .mdt-panel[hidden] { display: none; }

  .mdt-acts { display: flex; align-items: flex-start; gap: 0.25rem; }
  .mdt-toolbar {
    display: flex;
    flex: 1 1 auto;
    gap: 0.35rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .mdt-act {
    flex: 0 0 auto;
    min-height: 30px;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    white-space: nowrap;
    cursor: pointer;
  }
  .mdt-act:hover { color: var(--color-text); background: var(--color-bg-secondary); }
  .mdt-act:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 1px; }
  .mdt-act:active { transform: scale(0.96); }

  .mdt-grid-wrap { overflow: auto; border-radius: var(--radius-sm); }
  .mdt-grid { border-collapse: collapse; min-width: 100%; font-size: 0.88rem; }
  .mdt-grid td, .mdt-grid th { border: 1px solid var(--color-border); padding: 0; vertical-align: top; }
  .mdt-rn {
    width: 2.2rem;
    min-width: 2.2rem;
    padding: 0.35rem 0.3rem !important;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 400;
    text-align: right;
    background: var(--color-bg-secondary);
    user-select: none;
  }
  .mdt-align-cell { background: var(--color-bg-secondary); padding: 0.2rem !important; }
  .mdt-align {
    width: 100%;
    min-height: 26px;
    padding: 0.1rem 0.3rem;
    font-size: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .mdt-th { background: var(--color-bg-secondary); }
  .mdt-ce {
    min-width: 6rem;
    min-height: 2.2rem;
    padding: 0.45rem 0.6rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    outline: none;
    color: var(--color-text);
  }
  .mdt-th .mdt-ce { font-weight: 650; }
  .mdt-td.is-current { box-shadow: inset 0 0 0 2px var(--color-primary-light); }
  .mdt-ce:focus { box-shadow: inset 0 0 0 2px var(--color-primary); }

  .mdt-output {
    white-space: pre;
    overflow-x: auto;
    overflow-wrap: normal;
    font-size: 0.82rem;
  }
  .mdt-output[hidden], .mdt-preview[hidden] { display: none; }
  .mdt-preview {
    padding: 0.75rem;
    overflow: auto;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
    font-size: 0.9rem;
