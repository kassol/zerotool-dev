---
// MarkdownToWordTool — Markdown (CommonMark + GFM) to .docx in the browser.
// Parser: mdast-util-from-markdown + GFM + CJK-friendly emphasis; writer: docx.js.
interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;

/* ── strings:start ── */
