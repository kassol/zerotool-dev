/* ── strings:end ── */

const S = STRINGS[lang as keyof typeof STRINGS] || STRINGS.en;
const FONT_KEYS = ['zh-song', 'zh-yahei', 'ja-mincho', 'ja-gothic', 'ko-malgun', 'ko-batang'] as const;
const DEFAULT_FONT: Record<string, string> = { zh: 'zh-song', ja: 'ja-mincho', ko: 'ko-malgun' };
const defaultFont = DEFAULT_FONT[lang] || 'zh-yahei';

const SAMPLES: Record<string, string> = {
