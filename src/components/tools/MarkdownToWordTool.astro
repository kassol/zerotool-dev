    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .mw-editor { flex: 1; min-height: 420px; resize: vertical; tab-size: 2; }
  .mw-preview {
    flex: 1;
    min-height: 420px;
    max-height: 640px;
    overflow: auto;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .mw-preview :global(.mw-preview-empty) { color: var(--color-text-muted); margin: 0; }
  .mw-preview :global(h1) { font-size: 1.5rem; margin: 0 0 0.5rem; }
  .mw-preview :global(h2) { font-size: 1.25rem; margin: 1rem 0 0.4rem; }
  .mw-preview :global(h3) { font-size: 1.1rem; margin: 0.8rem 0 0.3rem; }
  .mw-preview :global(h4),
  .mw-preview :global(h5),
  .mw-preview :global(h6) { font-size: 0.98rem; margin: 0.6rem 0 0.25rem; }
  .mw-preview :global(p) { margin: 0 0 0.6rem; }
  .mw-preview :global(ul),
  .mw-preview :global(ol) { margin: 0.3rem 0 0.6rem; padding-left: 1.5rem; }
  .mw-preview :global(li.mw-task) { list-style: none; margin-left: -1.3rem; }
  .mw-preview :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-bg-secondary);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .mw-preview :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    background: var(--color-bg-secondary);
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius-sm);
    overflow-x: auto;
    margin: 0 0 0.6rem;
    line-height: 1.5;
  }
  .mw-preview :global(pre code) { background: none; padding: 0; }
  .mw-preview :global(blockquote) {
    margin: 0.4rem 0 0.6rem;
    padding: 0.2rem 0.9rem;
    border-left: 3px solid var(--color-border);
    color: var(--color-text-secondary);
  }
  .mw-preview :global(hr) { border: none; border-top: 1px solid var(--color-border); margin: 0.75rem 0; }
  .mw-preview :global(.mw-table-wrap) { overflow-x: auto; margin-bottom: 0.6rem; }
  .mw-preview :global(table) { border-collapse: collapse; font-size: 0.88rem; min-width: 60%; }
