  .mw-status { margin: 0; min-height: 1.2em; font-size: 0.84rem; font-weight: 550; color: var(--color-text-secondary); }
  .mw-status-ok { color: var(--color-success, oklch(50% 0.12 150)); }
  .mw-status-warn { color: var(--color-warning, oklch(50% 0.11 70)); }
  .mw-status-err { color: var(--color-error, oklch(52% 0.17 28)); }

  .mw-panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.75rem;
  }
  .mw-pane { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
