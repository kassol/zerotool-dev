  .mw-privacy svg { flex-shrink: 0; margin-top: 0.2em; }

  @media (max-width: 640px) {
    .mw-convert { flex: 1 1 100%; }
    .mw-filename-group { flex: 1 1 100%; min-height: 44px; }
    .mw-filename-input { width: 100%; }
    .mw-field { flex: 1 1 40%; }
    .mw-select { width: 100%; }
    .mw-bar-end { flex: 1 1 100%; margin-left: 0; }
    .mw-bar-end > * { flex: 1 1 0; }
    .mw-panes { grid-template-columns: minmax(0, 1fr); }
    .mw-editor { min-height: 220px; }
    .mw-preview { min-height: 200px; max-height: 420px; }
