  .mw-preview :global(td) { padding: 0.35rem 0.6rem; border: 1px solid var(--color-border); }
  .mw-preview :global(th) { background: var(--color-bg-secondary); font-weight: 650; }
  .mw-preview :global(a) { color: var(--color-primary); }
  .mw-preview :global(img) { max-width: 100%; height: auto; }
  .mw-preview :global(.mw-img-ph) {
