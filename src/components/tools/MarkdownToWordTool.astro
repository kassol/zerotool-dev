---

<div class="mw-wrap" data-lang={lang} data-strings={JSON.stringify(CLIENT_S)}>
  <div class="mw-bar">
    <button id="mw-convert" type="button" class="btn-primary mw-convert">{S.download}</button>
    <span class="mw-opt mw-opt-name">
      <label class="mw-filename-group">
        <span class="mw-sr">{S.filenameLabel}</span>
        <input type="text" id="mw-filename" class="mw-filename-input" maxlength="80" spellcheck="false" autocomplete="off" placeholder="document" />
        <span class="mw-filename-ext" aria-hidden="true">.docx</span>
      </label>
      <Toggletip id="mw-tip-filename" lang={lang} about={S.filenameLabel} wide>{TIPS.filename}</Toggletip>
    </span>
    <div class="mw-bar-end">
      <label class="btn-secondary mw-open">
        {S.openFile}
        <input type="file" id="mw-file" accept=".md,.markdown,.mdown,.mkd,.txt,text/markdown,text/plain" class="mw-sr" />
      </label>
      <Toggletip id="mw-tip-open" lang={lang} about={S.openFile} wide>{TIPS.open}</Toggletip>
      <button id="mw-clear" type="button" class="btn-ghost">{S.clear}</button>
    </div>
  </div>

  <div class="mw-options">
    <span class="mw-opt">
      <label class="mw-field-label" for="mw-paper">{S.paperLabel}</label>
      <select id="mw-paper" class="tool-input mw-select">
        <option value="a4">{S.paperA4}</option>
        <option value="letter">{S.paperLetter}</option>
      </select>
      <Toggletip id="mw-tip-paper" lang={lang} about={S.paperLabel} wide>{TIPS.paper}</Toggletip>
    </span>
    <span class="mw-opt">
      <label class="mw-field-label" for="mw-font">{S.fontLabel}</label>
      <select id="mw-font" class="tool-input mw-select">
        {FONT_KEYS.map((k) => <option value={k} selected={k === defaultFont}>{S[`font_${k}` as keyof typeof S]}</option>)}
      </select>
      <Toggletip id="mw-tip-font" lang={lang} about={S.fontLabel} wide>{TIPS.font}</Toggletip>
    </span>
    <span class="mw-opt">
      <label class="mw-embed">
        <input type="checkbox" id="mw-embed-remote" aria-describedby="mw-embed-note mw-tip-embed" />
        <span>{S.embedRemote}</span>
      </label>
      <Toggletip id="mw-tip-embed" lang={lang} about={S.embedRemote} wide>{TIPS.embed}</Toggletip>
    </span>
  </div>

  <p id="mw-status" class="mw-status" role="status" aria-live="polite"></p>

  <div class="mw-panes zt-io">
    <div class="mw-pane mw-pane-editor zt-io-pane">
      <div class="mw-pane-head">
        <label class="mw-pane-label" for="mw-editor">{S.inputLabel}</label>
        <Toggletip id="mw-tip-editor" lang={lang} about={S.inputLabel} wide>{TIPS.editor}</Toggletip>
      </div>
      <textarea id="mw-editor" class="tool-textarea mw-editor zt-io-fill" spellcheck="false" placeholder={S.placeholder}>{sample}</textarea>
      <div id="mw-doc-large" class="mw-doc-large" hidden>
        <span id="mw-doc-large-text"></span>
        <button id="mw-show-text" type="button" class="btn-ghost btn-sm"></button>
      </div>
    </div>
    <div class="mw-pane mw-pane-preview zt-io-pane">
      <div class="mw-pane-head">
        <div class="mw-pane-label" id="mw-preview-label">{S.previewLabel}</div>
        <Toggletip id="mw-tip-preview" lang={lang} about={S.previewLabel} wide>{TIPS.preview}</Toggletip>
      </div>
      <div id="mw-preview" class="mw-preview zt-io-fill" aria-labelledby="mw-preview-label" data-empty={S.previewEmpty}></div>
      <p id="mw-preview-note" class="mw-preview-note" hidden></p>
      <p class="mw-privacy">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>{S.privacyNote}</span>
      </p>
      <p id="mw-embed-note" class="mw-embed-note" hidden>{S.embedRemoteNote}</p>
    </div>
  </div>
</div>

<script>
  import { fromMarkdown } from 'mdast-util-from-markdown';
  import { gfmFromMarkdown } from 'mdast-util-gfm';
  import { gfm } from 'micromark-extension-gfm';
  import { cjkFriendlyExtension } from 'micromark-extension-cjk-friendly';
  import { gfmStrikethroughCjkFriendly } from 'micromark-extension-cjk-friendly-gfm-strikethrough';
  import {
    parseMarkdown, renderHtml, prepareImages, firstHeadingText, safeFilename,
    defaultPaper, defaultFontFor, collectImageUrls, escHtml, sniffImage, PREVIEW_BLOCKS,
  } from './markdown-to-word-engine.js';
  import ExportWorker from './markdown-to-word.worker.js?worker';

  /* The parser, .docx builder and preview renderer live in markdown-to-word-engine.js so
     the export Worker runs the same code. */


  const lib = { fromMarkdown, gfm, gfmFromMarkdown, cjkFriendlyExtension, gfmStrikethroughCjkFriendly };

  const wrap = document.querySelector('.mw-wrap') as HTMLElement;
  const T = JSON.parse(wrap.dataset.strings || '{}');
  const pageLang = wrap.dataset.lang || 'en';
  const editor = document.getElementById('mw-editor') as HTMLTextAreaElement;
  const preview = document.getElementById('mw-preview') as HTMLElement;
  const previewNote = document.getElementById('mw-preview-note') as HTMLElement;
  const statusEl = document.getElementById('mw-status') as HTMLElement;
  const convertBtn = document.getElementById('mw-convert') as HTMLButtonElement;
  const clearBtn = document.getElementById('mw-clear') as HTMLButtonElement;
  const fileInput = document.getElementById('mw-file') as HTMLInputElement;
  const filenameInput = document.getElementById('mw-filename') as HTMLInputElement;
  const paperSel = document.getElementById('mw-paper') as HTMLSelectElement;
  const fontSel = document.getElementById('mw-font') as HTMLSelectElement;

  const embedRemoteBox = document.getElementById('mw-embed-remote') as HTMLInputElement;
  const embedNote = document.getElementById('mw-embed-note') as HTMLElement;
  // What turning the switch on sends over the network is shown while it is on.
  function syncEmbedNote() { embedNote.hidden = !embedRemoteBox.checked; }
  const SLUG = 'markdown-to-word';

  paperSel.value = defaultPaper(pageLang, navigator.language);
  // Off unless the user turned it on; saved through ztPersist, which applies this
  // tool's policy from src/data/persistence.ts.
  embedRemoteBox.checked = ((window as any).ztPersist?.load(SLUG) || {}).embedRemoteImages === true;
  syncEmbedNote();
  embedRemoteBox.addEventListener('change', () => {
    syncEmbedNote();
    (window as any).ztPersist?.save(SLUG, { embedRemoteImages: embedRemoteBox.checked });
  });
  fontSel.value = defaultFontFor(pageLang);

  function fmt(key: string, vars: Record<string, string | number>) {
    return String(T[key] || key).replace(/\{(\w+)\}/g, (_m, k) => String(vars[k] ?? ''));
  }

  function setStatus(msg: string, kind = '') {
    statusEl.textContent = msg;
    statusEl.className = 'mw-status' + (kind ? ' mw-status-' + kind : '');
  }

  let currentTree: any = null;
  let treeMd: string | null = null;
  let previewMd: string | null = null;
  function previewTree(tree: any) {
    if (!tree || !Array.isArray(tree.children) || tree.children.length <= PREVIEW_BLOCKS) return tree;
    return Object.assign({}, tree, { children: tree.children.slice(0, PREVIEW_BLOCKS) });
  }
  // The document being exported and previewed. It differs from the textarea for a
  // document too large to show (see LARGE_DOC).
  let docSource = editor.value;
  let largeDoc = false;
  let previewUrls: string[] = [];
  let previewHeading = '';
  const LARGE_DOC = 200000;
  const docLarge = document.getElementById('mw-doc-large') as HTMLElement;
  const docLargeText = document.getElementById('mw-doc-large-text') as HTMLElement;
  const showTextBtn = document.getElementById('mw-show-text') as HTMLButtonElement;
  showTextBtn.textContent = T.showText;

  function setDocument(text: string) {
    docSource = text;
    if (text.length > LARGE_DOC) {
      largeDoc = true;
      editor.value = '';
      editor.classList.add('mw-editor-hidden');
      editor.blur();
      docLargeText.textContent = fmt('largeDoc', { chars: new Intl.NumberFormat(pageLang).format(text.length) });
      docLarge.hidden = false;
    } else {
      largeDoc = false;
      editor.value = text;
      editor.classList.remove('mw-editor-hidden');
      docLarge.hidden = true;
    }
    refresh();
  }

  showTextBtn.addEventListener('click', () => {
    if (!largeDoc) return;
    largeDoc = false;
    editor.value = docSource;
    editor.classList.remove('mw-editor-hidden');
    docLarge.hidden = true;
    editor.focus();
  });

  let previewJob = 0;
  function refresh() {
    const md = docSource;
    if (!md.trim()) {
      currentTree = null;
      treeMd = null;
      previewMd = null;
      previewUrls = [];
      previewHeading = '';
      preview.innerHTML = '<p class="mw-preview-empty">' + escHtml(preview.dataset.empty || '') + '</p>';
      filenameInput.placeholder = 'document';
      previewNote.hidden = true;
      return;
    }
    filenameInput.placeholder = safeFilename(previewHeading);
    // Above LARGE_DOC the parse and preview HTML are built in the Worker.
    if (largeDoc) {
      currentTree = null;
      const id = ++previewJob;
      if (!exportWorker) exportWorker = new ExportWorker();
      const worker = exportWorker;
      const onMessage = (e: MessageEvent) => {
        if (e.data.id !== id || e.data.kind !== 'preview') return;
        worker.removeEventListener('message', onMessage);
        if (!e.data.ok || docSource !== md) return;
        preview.innerHTML = e.data.html;
        previewUrls = e.data.urls || [];
        previewHeading = e.data.heading || '';
        filenameInput.placeholder = safeFilename(previewHeading);
        const blocks = e.data.blocks || 0;
        if (blocks > PREVIEW_BLOCKS) {
          previewNote.textContent = fmt('previewMore', { shown: PREVIEW_BLOCKS, total: blocks });
          previewNote.hidden = false;
        } else {
          previewNote.hidden = true;
        }
      };
      worker.addEventListener('message', onMessage);
      worker.postMessage({ id, kind: 'preview', md });
      return;
    }
    if (md !== treeMd) {
      currentTree = parseMarkdown(md, lib);
      treeMd = md;
      previewHeading = firstHeadingText(currentTree);
      previewUrls = collectImageUrls(currentTree, true);
    }
    if (md !== previewMd) {
      preview.innerHTML = renderHtml(previewTree(currentTree));
      previewMd = md;
    }
    const blocks = currentTree && Array.isArray(currentTree.children) ? currentTree.children.length : 0;
    if (blocks > PREVIEW_BLOCKS) {
      previewNote.textContent = fmt('previewMore', { shown: PREVIEW_BLOCKS, total: blocks });
      previewNote.hidden = false;
    } else {
      previewNote.hidden = true;
    }
    filenameInput.placeholder = safeFilename(firstHeadingText(currentTree));
  }

  let timer: number | undefined;
  editor.addEventListener('input', () => {
    if (largeDoc) return;
    docSource = editor.value;
    clearTimeout(timer);
    timer = window.setTimeout(refresh, editor.value.length > 200000 ? 800 : 200);
  });

  // Re-encode formats Word cannot embed directly (SVG, WebP, AVIF) as PNG.
  async function toDocxImage(bytes: Uint8Array, mime: string) {
    const direct = sniffImage(bytes);
    if (direct) return { type: direct.type, data: bytes, width: direct.width, height: direct.height };
    const url = URL.createObjectURL(new Blob([bytes], { type: mime || 'image/png' }));
    try {
      const img = new Image();
      img.src = url;
      await img.decode();
      const scale = Math.min(1, 4096 / Math.max(img.naturalWidth || 1, img.naturalHeight || 1));
      const w = Math.max(1, Math.round((img.naturalWidth || 300) * scale));
      const h = Math.max(1, Math.round((img.naturalHeight || 150) * scale));
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      canvas.getContext('2d')!.drawImage(img, 0, 0, w, h);
      const blob: Blob | null = await new Promise((res) => canvas.toBlob(res, 'image/png'));
      if (!blob) return null;
      return { type: 'png', data: new Uint8Array(await blob.arrayBuffer()), width: w, height: h };
    } catch {
      return null;
    } finally {
      URL.revokeObjectURL(url);
    }
  }

  // The document is built and zipped in a Worker: 10,000 paragraphs take about
  // 1.5 seconds on the main thread, which blocks typing and scrolling.
  let exportWorker: Worker | null = null;
  let exportJob = 0;
  function buildInWorker(md: string, opts: any): Promise<{ bytes: ArrayBuffer; report: any }> {
    if (!exportWorker) exportWorker = new ExportWorker();
    const worker = exportWorker;
    const id = ++exportJob;
    return new Promise((resolve, reject) => {
      const onMessage = (e: MessageEvent) => {
        if (e.data.id !== id) return;
        worker.removeEventListener('message', onMessage);
        worker.removeEventListener('error', onError);
        if (e.data.ok) resolve({ bytes: e.data.bytes, report: e.data.report });
        else reject(new Error(e.data.error || 'export failed'));
      };
      const onError = (e: ErrorEvent) => {
        worker.removeEventListener('message', onMessage);
        worker.removeEventListener('error', onError);
        reject(new Error(e.message || 'export failed'));
      };
      worker.addEventListener('message', onMessage);
      worker.addEventListener('error', onError);
      worker.postMessage({ id, md, opts });
    });
  }

  async function convertAndDownload() {
    if (!docSource.trim()) {
      setStatus(T.emptyError, 'err');
      return;
    }
    convertBtn.disabled = true;
    try {
      refresh();
      const tree = currentTree;
      const embedRemote = embedRemoteBox.checked;
      const urls = tree ? collectImageUrls(tree, embedRemote) : previewUrls;
      const remoteCount = urls.filter((u: string) => /^https?:/i.test(u)).length;
      setStatus(remoteCount ? fmt('fetchingImages', { n: remoteCount }) : T.converting);
      const heading = tree ? firstHeadingText(tree) : previewHeading;
      const name = safeFilename(filenameInput.value.trim() || heading);
      const opts = await prepareImages(tree || urls, { paper: paperSel.value, font: fontSel.value, title: name, embedRemote }, {
        fetch: (url: string, init: RequestInit) => window.fetch(url, init),
        toImage: toDocxImage,
      });
      const { bytes, report } = await buildInWorker(docSource, opts);
      const blob = new Blob([bytes], { type: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' });
      const href = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = href;
      a.download = name + '.docx';
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(href), 60000);
      const parts = [fmt('done', { file: name + '.docx' })];
      if (report.imagesEmbedded) parts.push(fmt('imagesEmbedded', { n: report.imagesEmbedded }));
      if (report.imagesMissing) parts.push(fmt('imagesMissing', { n: report.imagesMissing }));
      if (report.imagesSkipped) parts.push(fmt('imagesSkipped', { n: report.imagesSkipped }));
      setStatus(parts.join(' · '), report.imagesMissing || report.imagesSkipped ? 'warn' : 'ok');
      (window as any).trackTool && (window as any).trackTool('markdown_to_word', 'convert');
    } catch (err) {
      setStatus(fmt('error', { msg: String((err as Error)?.message || err) }), 'err');
    } finally {
      convertBtn.disabled = false;
    }
  }

  convertBtn.addEventListener('click', convertAndDownload);

  clearBtn.addEventListener('click', () => {
    editor.value = '';
    docSource = '';
    largeDoc = false;
    editor.classList.remove('mw-editor-hidden');
    docLarge.hidden = true;
    filenameInput.value = '';
    embedRemoteBox.checked = false;
    syncEmbedNote();
    (window as any).ztPersist?.clear(SLUG);
    setStatus('');
    refresh();
    editor.focus();
  });

  // ToolLayout's Ctrl/Cmd+L empties the editor and the file name without input events and
  // clears the saved switch; drop the stale preview, status and switch state too.
  document.addEventListener('keydown', (e) => {
    if (!(e.metaKey || e.ctrlKey) || (e.key !== 'l' && e.key !== 'L')) return;
    setTimeout(() => {
      if (editor.value) return;
      clearTimeout(timer);
      docSource = '';
      largeDoc = false;
      editor.classList.remove('mw-editor-hidden');
      docLarge.hidden = true;
      embedRemoteBox.checked = false;
      syncEmbedNote();
      setStatus('');
      refresh();
    }, 0);
  });

  // An opened file must be UTF-8 text. file.text() would turn every byte that is not
  // UTF-8 into U+FFFD and put the result in the editor without a word (a GBK or
  // Shift_JIS file, or an image picked by mistake). firstBadUtf8 is copied from
  // json-formatter-engine.js; test-markdown-to-word.mjs checks that the two are the same.
  function firstBadUtf8(u8) {
    for (var x = 0; x < u8.length;) {
      var b = u8[x], need, min;
      if (b < 0x80) { x++; continue; }
      if (b >= 0xc2 && b <= 0xdf) { need = 1; min = 0x80; }
      else if (b >= 0xe0 && b <= 0xef) { need = 2; min = 0x800; }
      else if (b >= 0xf0 && b <= 0xf4) { need = 3; min = 0x10000; }
      else return x;
      var cp = b & (0x3f >> need);
      for (var y = 1; y <= need; y++) {
        var c = u8[x + y];
        if (c === undefined || (c & 0xc0) !== 0x80) return x;
        cp = (cp << 6) | (c & 0x3f);
      }
      if (cp < min || cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff)) return x;
      x += need + 1;
    }
    return -1;
  }
  function decodeTextFile(u8: Uint8Array): { text?: string; error?: string; offset?: number } {
    if ((u8[0] === 0xff && u8[1] === 0xfe) || (u8[0] === 0xfe && u8[1] === 0xff)) return { error: 'fileUtf16', offset: 0 };
    const nul = u8.indexOf(0);
    if (nul >= 0) {
      // UTF-16 text without a byte order mark: many NUL bytes, all on even or all on odd
      // offsets. Other NUL bytes mean a binary file (an image, an archive).
      const head = Math.min(u8.length, 64);
      let even = 0, odd = 0;
      for (let x = 0; x < head; x++) if (u8[x] === 0) { if (x % 2) odd++; else even++; }
      if ((even + odd) * 4 >= head && (even === 0 || odd === 0)) return { error: 'fileUtf16', offset: 0 };
      return { error: 'fileBinary', offset: nul };
    }
    const bad = firstBadUtf8(u8);
    if (bad >= 0) return { error: 'fileNotUtf8', offset: bad };
    // A UTF-8 byte order mark at the start is removed, as file.text() did.
    return { text: new TextDecoder('utf-8', { fatal: true }).decode(u8) };
  }

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files && fileInput.files[0];
    if (!file) return;
    try {
      const read = decodeTextFile(new Uint8Array(await file.arrayBuffer()));
      if (read.error) {
        setStatus(fmt(read.error, { offset: read.offset ?? 0 }), 'err');
        fileInput.value = '';
        return;
      }
      if (!filenameInput.value.trim()) filenameInput.value = safeFilename(file.name.replace(/\.(md|markdown|mdown|mkd|txt)$/i, ''));
      setStatus('');
      setDocument(read.text as string);
    } catch {
      setStatus(T.fileError, 'err');
    }
    fileInput.value = '';
  });

  refresh();
</script>

