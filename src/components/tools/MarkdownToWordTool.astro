    box-shadow: 0 0 0 3px color-mix(in oklch, var(--color-primary) 18%, transparent);
  }
  .mw-filename-input {
    border: none;
    background: transparent;
    padding: 0.35rem 0.2rem 0.35rem 0.65rem;
