            copyBtn.setAttribute('aria-label', COPY_LABEL);
          }, 1500);
      });

      /* ── Init ── */
      tabs.forEach(function (tab) {tab.setAttribute('aria-pressed', String(tab.dataset.shape === 'polygon'));});
      wrap.querySelectorAll('.cpg-num-input, .cpg-range').forEach(function (input) {
        input.step = '0.01';
        if (input.min === '5') input.min = '0';
        if (input.max === '49') input.max = '100';
      });
      renderVertexList();
      renderHandles();
      renderPolyShape();
      applyBackground();
      update();
    })();
  </script>
</div>

