const extra = {
  en: { raw: 'CSS value', ratio: 'Preview ratio', reference: 'Reference box', valid: 'Supported in this browser. Preview size: ', invalid: 'Invalid or unsupported clip-path value in this browser.', localOnly: 'Use a basic shape or reference box. URL references, variables and escaped CSS need a page context.', dragHint: 'Drag a vertex, or use arrow keys (Shift: 10%).', reset: 'Reset', copyFailed: 'Copy failed. Select and copy the CSS.', image: 'Sample image', frame: 'Show reference boxes (12px border, 16px padding)', rawExample: 'Example', prefixed: 'Include -webkit-clip-path', vertices: 'Vertex', delete: 'Delete vertex' },
  zh: { raw: 'CSS 原值', ratio: '预览比例', reference: '参考框', valid: '当前浏览器支持。预览尺寸：', invalid: '当前浏览器不支持此值，或 clip-path 语法无效。', localOnly: '请输入基本形状或参考框。URL 引用、变量和转义 CSS 需要页面上下文。', dragHint: '拖动顶点，或用方向键调整（Shift：10%）。', reset: '重置', copyFailed: '复制失败，请选中 CSS 手动复制。', image: '示例图片', frame: '显示参考框（12px 边框、16px 内边距）', rawExample: '示例', prefixed: '包含 -webkit-clip-path', vertices: '顶点', delete: '删除顶点' },
  ja: { raw: 'CSS 値', ratio: 'プレビュー比率', reference: '参照ボックス', valid: 'このブラウザーで対応。プレビューサイズ：', invalid: 'このブラウザーでは未対応、または clip-path の構文が無効です。', localOnly: '基本図形か参照ボックスを入力してください。URL、変数、エスケープはページ側の設定が必要です。', dragHint: '頂点をドラッグ、または矢印キー（Shift：10%）。', reset: 'リセット', copyFailed: 'コピーできません。CSS を選択してコピーしてください。', image: 'サンプル画像', frame: '参照ボックスを表示（枠12px・余白16px）', rawExample: '例', prefixed: '-webkit-clip-path を含める', vertices: '頂点', delete: '頂点を削除' },
  ko: { raw: 'CSS 값', ratio: '미리보기 비율', reference: '기준 상자', valid: '이 브라우저에서 지원합니다. 미리보기 크기: ', invalid: '이 브라우저에서 지원하지 않거나 clip-path 문법이 잘못되었습니다.', localOnly: '기본 도형이나 기준 상자를 입력하세요. URL, 변수, 이스케이프는 페이지 설정이 필요합니다.', dragHint: '꼭짓점을 드래그하거나 방향키 사용 (Shift: 10%).', reset: '초기화', copyFailed: '복사하지 못했습니다. CSS를 선택해 복사하세요.', image: '예제 이미지', frame: '기준 상자 표시 (테두리 12px, 안쪽 여백 16px)', rawExample: '예제', prefixed: '-webkit-clip-path 포함', vertices: '꼭짓점', delete: '꼭짓점 삭제' },
};
const STRINGS = {
  "en": {
    "tips": {
      "shape": "Choose Polygon, Circle, Ellipse, Inset or CSS value. The preview and generated CSS update as you edit.",
      "vertices": "Polygons have 3–12 vertices. Enter decimal X/Y percentages or drag a numbered handle; dragging keeps two decimals. Focus a handle and use arrow keys for 1% steps, or Shift for 10%.",
      "geometry": "Sliders and number fields update the shape immediately. Circle and ellipse radii use 5–100%, centers use 0–100%, inset edges use 0–49%, and inset corner radius uses 0–50%.",
      "raw": "Enter only a basic shape or reference-box value. path() uses CSS pixels; shape() can use percentages. Browser support is checked locally. URL references, variables, comments and escaped CSS are rejected; raw values do not create handles.",
      "preview": "Choose 1:1, 2:1 or 1:2 to compare square, wide and tall previews. The background is a local sample. Ratio and background do not change the generated CSS.",
      "reference": "Show the preview with a 12px border and 16px padding. Dashed outlines mark its border, padding and content boxes.",
      "copy": "Copy CSS copies the complete generated rule. Include -webkit-clip-path adds a second declaration. In CSS value mode, Ctrl/⌘+L clears the input and makes the old result unavailable.",
