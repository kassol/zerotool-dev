---
import Toggletip from '../Toggletip.astro';
// CssVariablesGeneratorTool — generates CSS custom properties from design tokens
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: {
    prefix: 'Variable Prefix',
    prefixPlaceholder: '--',
    colors: 'Colors',
    typography: 'Typography',
    spacing: 'Spacing',
    borderRadius: 'Border Radius',
    addToken: '+ Add Token',
    varName: 'Variable Name',
    colorSwatch: 'Color value',
    value: 'Value',
    outputLabel: 'Generated CSS',
    copy: 'Copy',
    copied: 'Copied!',
    copyFailed: "Copy failed",
    remove: '×',
    editor: "Edit tokens",
    removeLabel: "Remove token",
    empty: "Edit a token to generate CSS.",
    tips: {"prefix": "Use a prefix such as --brand-. Missing leading hyphens are added; changing the prefix updates every declaration.", "name": "Enter a variable name. Spaces become hyphens and rows with an empty name are skipped. Names are case-sensitive.", "value": "Enter any CSS value, including var() or calc(). Values are copied as typed and duplicate names remain in row order.", "color": "Choose a native color or type a three- or six-digit HEX value to synchronize the swatch. Other CSS colors keep the current swatch.", "add": "Add an empty row to any of the four groups. Give it a name and value to include it in the :root block.", "remove": "Remove the selected row and update the CSS immediately. Ctrl/⌘+L clears text and CSS while keeping rows and native colors.", "copy": "Copy the complete :root block. If copying fails, retry or select the CSS and copy it by hand."},
  },
  zh: {
    prefix: '变量前缀',
    prefixPlaceholder: '--',
    colors: '颜色',
    typography: '字体排版',
    spacing: '间距',
    borderRadius: '圆角',
    addToken: '+ 添加 Token',
    varName: '变量名',
    colorSwatch: '颜色值',
    value: '值',
    outputLabel: '生成的 CSS',
    copy: '复制',
    copied: '已复制！',
    copyFailed: "复制失败",
    remove: '×',
    editor: "编辑 Token",
    removeLabel: "删除 Token",
    empty: "编辑 Token 即可生成 CSS。",
    tips: {"prefix": "输入 --brand- 等前缀。缺少开头的双连字符时会自动补上；修改前缀会更新全部声明。", "name": "输入变量名。空格会改为连字符，变量名为空的行会跳过。名称区分大小写。", "value": "输入任意 CSS 值，包括 var() 或 calc()。值按输入原样复制，重名变量仍按行顺序保留。", "color": "选择原生颜色或输入三位、六位 HEX 值可同步色块。其他 CSS 颜色值保留当前色块。", "add": "在四个分组中任意添加空行。填写名称和值后，这行会加入 :root 代码块。", "remove": "删除当前行后 CSS 立即更新。Ctrl/⌘+L 清空文本和 CSS，并保留行和原生颜色。", "copy": "复制完整的 :root 代码块。复制失败时可重试，或选中 CSS 手动复制。"},
  },
  ja: {
    prefix: '変数プレフィックス',
    prefixPlaceholder: '--',
    colors: 'カラー',
    typography: 'タイポグラフィ',
    spacing: 'スペーシング',
    borderRadius: '角丸',
    addToken: '+ トークン追加',
    varName: '変数名',
    colorSwatch: 'カラー値',
    value: '値',
    outputLabel: '生成された CSS',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyFailed: "コピーに失敗しました",
    remove: '×',
    editor: "トークンを編集",
    removeLabel: "トークンを削除",
    empty: "トークンを編集すると CSS が生成されます。",
    tips: {"prefix": "--brand- などのプレフィックスを入力します。先頭のハイフンが足りなければ追加され、変更は全宣言に反映されます。", "name": "変数名を入力します。空白はハイフンになり、空の名前の行はスキップされます。大文字と小文字を区別します。", "value": "var() や calc() を含む任意の CSS 値を入力します。値は入力どおりにコピーされ、同名の変数も行順に残ります。", "color": "色を選択するか3桁・6桁の HEX を入力するとスウォッチが同期します。他の CSS 色値では現在のスウォッチを保持します。", "add": "4つのグループに空行を追加できます。名前と値を入力すると :root ブロックに含まれます。", "remove": "行を削除すると CSS が即座に更新されます。Ctrl/⌘+L はテキストと CSS を消去し、行とネイティブカラーを保持します。", "copy": "完全な :root ブロックをコピーします。失敗したら再試行するか、CSS を選択して手動でコピーしてください。"},
  },
  ko: {
    prefix: '변수 접두사',
    prefixPlaceholder: '--',
    colors: '색상',
    typography: '타이포그래피',
    spacing: '간격',
    borderRadius: '테두리 반경',
    addToken: '+ 토큰 추가',
    varName: '변수명',
    colorSwatch: '색상 값',
    value: '값',
    outputLabel: '생성된 CSS',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: "복사 실패",
    remove: '×',
    editor: "토큰 편집",
    removeLabel: "토큰 삭제",
    empty: "토큰을 편집하면 CSS가 생성됩니다.",
    tips: {"prefix": "--brand- 같은 접두사를 입력하세요. 앞의 하이픈이 부족하면 추가되며 변경 사항은 모든 선언에 적용됩니다.", "name": "변수명을 입력하세요. 공백은 하이픈으로 바뀌고 이름이 빈 행은 건너뜁니다. 이름은 대소문자를 구분합니다.", "value": "var()나 calc()를 포함한 CSS 값을 입력하세요. 값은 입력한 대로 복사되며 같은 이름의 변수도 행 순서대로 남습니다.", "color": "색상을 선택하거나 3자리·6자리 HEX를 입력하면 색상 견본이 동기화됩니다. 다른 CSS 색상 값은 현재 견본을 유지합니다.", "add": "네 그룹에 빈 행을 추가할 수 있습니다. 이름과 값을 입력하면 :root 블록에 포함됩니다.", "remove": "행을 삭제하면 CSS가 즉시 업데이트됩니다. Ctrl/⌘+L은 텍스트와 CSS를 지우고 행과 기본 색상은 유지합니다.", "copy": "전체 :root 블록을 복사하세요. 실패하면 다시 시도하거나 CSS를 선택해 직접 복사하세요."},
  },
};

// strings:end
const L = STRINGS[lang] ?? STRINGS.en;
---

<div
  class="cvg-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-label-colors={L.colors}
  data-label-typography={L.typography}
  data-label-spacing={L.spacing}
  data-label-radius={L.borderRadius}
  data-label-varname={L.varName}
  data-label-color-swatch={L.colorSwatch}
  data-label-value={L.value}
  data-label-add={L.addToken}
  data-label-remove={L.remove}
  data-label-remove-title={L.removeLabel}
>

  <div class="cvg-body">
    <div class="cvg-rail zt-rail">
      <div class="cvg-prefix-row">
        <div class="cvg-field-header"><label class="cvg-field-label" for="cvg-prefix">{L.prefix}</label><Toggletip id="cvg-tip-prefix" lang={lang} about={L.prefix}>{L.tips.prefix}</Toggletip></div>
        <input id="cvg-prefix" class="cvg-prefix-input tool-input" type="text" value="--" spellcheck="false" autocomplete="off" />
      </div>
      <details class="cvg-editor">
        <summary>{L.editor}</summary>
        <div class="cvg-token-help">
          <span>{L.varName}<Toggletip id="cvg-tip-name" lang={lang} about={L.varName}>{L.tips.name}</Toggletip></span>
          <span>{L.value}<Toggletip id="cvg-tip-value" lang={lang} about={L.value}>{L.tips.value}</Toggletip></span>
          <span>{L.colors}<Toggletip id="cvg-tip-color" lang={lang} about={L.colors}>{L.tips.color}</Toggletip></span>
          <span>{L.addToken}<Toggletip id="cvg-tip-add" lang={lang} about={L.addToken}>{L.tips.add}</Toggletip></span>
          <span>{L.removeLabel}<Toggletip id="cvg-tip-remove" lang={lang} about={L.removeLabel}>{L.tips.remove}</Toggletip></span>
        </div>
        <div id="cvg-groups" class="cvg-groups"></div>
      </details>
      <div class="cvg-copy-row"><Toggletip id="cvg-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip><button id="cvg-copy" class="btn-copy" type="button">{L.copy}</button></div>
      <p id="cvg-status" class="tool-status" role="status"></p>
    </div>
    <div id="cvg-result" class="cvg-output-section" data-empty="false">
      <span class="cvg-output-label">{L.outputLabel}</span>
      <p id="cvg-empty" class="cvg-empty" hidden>{L.empty}</p>
      <pre id="cvg-pre" class="cvg-pre" tabindex="0" role="region" aria-label={L.outputLabel}><code id="cvg-code" class="cvg-code"></code></pre>
    </div>
  </div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.cvg-wrap')
        : document.querySelector('.cvg-wrap');

      /* ── Labels from data attributes ── */
      var COPY_LABEL    = wrap.dataset.copy;
      var COPY_FAILED_LABEL = wrap.dataset.copyFailed;
      var COPIED_LABEL  = wrap.dataset.copied;
      var ADD_LABEL     = wrap.dataset.labelAdd;
      var REMOVE_LABEL  = wrap.dataset.labelRemove;
      var REMOVE_TITLE_LABEL = wrap.dataset.labelRemoveTitle;
      var VARNAME_LABEL = wrap.dataset.labelVarname;
      var COLOR_SWATCH_LABEL = wrap.dataset.labelColorSwatch;
      var VALUE_LABEL   = wrap.dataset.labelValue;

      /* ── Group definitions ── */
      var GROUPS = [
        {
          id: 'colors',
          label: wrap.dataset.labelColors,
          type: 'color',
          defaults: [
            { name: 'primary', value: '#3b82f6' },
            { name: 'secondary', value: '#6366f1' },
            { name: 'bg', value: '#ffffff' },
            { name: 'text', value: '#111827' },
          ],
        },
        {
          id: 'typography',
          label: wrap.dataset.labelTypography,
          type: 'text',
          defaults: [
            { name: 'font-sans', value: 'Inter, system-ui, sans-serif' },
            { name: 'font-mono', value: '"Fira Code", monospace' },
            { name: 'font-size-base', value: '16px' },
            { name: 'font-size-lg', value: '18px' },
          ],
        },
        {
          id: 'spacing',
          label: wrap.dataset.labelSpacing,
          type: 'text',
          defaults: [
            { name: 'space-1', value: '4px' },
            { name: 'space-2', value: '8px' },
            { name: 'space-4', value: '16px' },
            { name: 'space-8', value: '32px' },
          ],
        },
        {
          id: 'radius',
          label: wrap.dataset.labelRadius,
          type: 'text',
          defaults: [
            { name: 'radius-sm', value: '4px' },
            { name: 'radius-md', value: '8px' },
            { name: 'radius-lg', value: '16px' },
            { name: 'radius-full', value: '9999px' },
          ],
        },
      ];

      var prefixEl = document.getElementById('cvg-prefix');
      var groupsEl = document.getElementById('cvg-groups');
      var codeEl   = document.getElementById('cvg-code');
      var copyBtn  = document.getElementById('cvg-copy');
      var statusEl = document.getElementById('cvg-status');
      var resultEl = document.getElementById('cvg-result');
      var emptyEl = document.getElementById('cvg-empty');
      var preEl = document.getElementById('cvg-pre');

      /* ── Build token row ── */
      function buildRow(groupEl, type, name, value) {
        var row = document.createElement('div');
        row.className = 'cvg-token-row';

        /* Color swatch + input */
        if (type === 'color') {
          var swatch = document.createElement('input');
          swatch.type = 'color';
          swatch.className = 'cvg-swatch';
          swatch.value = value || '#000000';
          swatch.setAttribute('aria-label', COLOR_SWATCH_LABEL);
          row.appendChild(swatch);
        }

        /* Variable name input */
        var nameInput = document.createElement('input');
        nameInput.type = 'text';
        nameInput.className = 'cvg-token-name';
        nameInput.placeholder = VARNAME_LABEL;
        nameInput.setAttribute('aria-label', VARNAME_LABEL);
        nameInput.value = name || '';
        nameInput.spellcheck = false;
        nameInput.autocomplete = 'off';
        row.appendChild(nameInput);

        /* Value input */
        var valueInput = document.createElement('input');
        valueInput.type = 'text';
        valueInput.className = 'cvg-token-value';
        valueInput.placeholder = VALUE_LABEL;
        valueInput.setAttribute('aria-label', VALUE_LABEL);
        valueInput.value = value || '';
        valueInput.spellcheck = false;
        valueInput.autocomplete = 'off';
        row.appendChild(valueInput);

        /* Remove button */
        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'cvg-remove-btn';
        removeBtn.textContent = REMOVE_LABEL;
        removeBtn.title = REMOVE_TITLE_LABEL;
        removeBtn.setAttribute('aria-label', REMOVE_TITLE_LABEL);
        row.appendChild(removeBtn);

        /* Sync color swatch ↔ value input */
        if (type === 'color') {
          swatch.addEventListener('input', function () {
            valueInput.value = swatch.value;
            refresh(true);
          });
          valueInput.addEventListener('input', function () {
            var v = valueInput.value.trim();
            if (/^#[0-9a-fA-F]{6}$/.test(v)) swatch.value = v;
            else if (/^#[0-9a-fA-F]{3}$/.test(v)) swatch.value = '#' + v[1] + v[1] + v[2] + v[2] + v[3] + v[3];
            refresh(true);
          });
        } else {
          valueInput.addEventListener('input', refresh);
        }

        nameInput.addEventListener('input', refresh);
        removeBtn.addEventListener('click', function () {
          row.parentNode.removeChild(row);
          refresh(true);
        });

        groupEl.querySelector('.cvg-token-list').appendChild(row);
      }

      /* ── Build group ── */
      function buildGroup(g) {
        var section = document.createElement('div');
        section.className = 'cvg-group';
        section.dataset.groupId = g.id;
        section.dataset.groupType = g.type;

        var header = document.createElement('div');
        header.className = 'cvg-group-header';

        var title = document.createElement('span');
        title.className = 'cvg-group-title';
        title.textContent = g.label;
        header.appendChild(title);

        var addBtn = document.createElement('button');
        addBtn.type = 'button';
        addBtn.className = 'btn-ghost cvg-add-btn';
        addBtn.textContent = ADD_LABEL;
        header.appendChild(addBtn);

        section.appendChild(header);

        var list = document.createElement('div');
        list.className = 'cvg-token-list';
        section.appendChild(list);

        g.defaults.forEach(function (d) {
          buildRow(section, g.type, d.name, d.value);
        });

        addBtn.addEventListener('click', function () {
          buildRow(section, g.type, '', '');
          refresh(true);
          window.trackTool && window.trackTool('css-variables-generator', 'add_token');
        });

        groupsEl.appendChild(section);
      }

      GROUPS.forEach(buildGroup);

      /* ── CSS generation ── */
      /* ── engine:start ── */
      // Names, values and the prefix are free text. Every piece is escaped before it is wrapped in
      // highlight spans; the old version built the string first and put it into innerHTML unescaped.
      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      // A custom property name starts with -- (CSS Custom Properties Level 1 §2): the prefix gets
      // the missing hyphens, and spaces inside a name, which would make the declaration invalid,
      // become hyphens.
      function tokenDecls(prefix, tokens) {
        prefix = String(prefix || '').trim().replace(/^-*/, '--');
        var sep = prefix.endsWith('-') ? '' : '-';
        var decls = [];
        tokens.forEach(function (t) {
          var name = (t.name || '').trim().replace(/\s+/g, '-');
          if (!name) return;
          decls.push([prefix + sep + name, (t.value || '').trim()]);
        });
        return decls;
      }

      function plainCss(decls) {
        return [':root {'].concat(decls.map(function (d) { return '  ' + d[0] + ': ' + d[1] + ';'; }), ['}']).join('\n');
      }

      function highlightCss(decls) {
        return '<span class="cvg-hl-sel">:root</span> <span class="cvg-hl-brace">{</span>\n' +
          decls.map(function (d) {
            return '  <span class="cvg-hl-var">' + escapeHtml(d[0]) + '</span><span class="cvg-hl-colon">:</span> ' +
              '<span class="cvg-hl-val">' + escapeHtml(d[1]) + '</span><span class="cvg-hl-semi">;</span>';
          }).join('\n') +
          (decls.length ? '\n' : '') + '<span class="cvg-hl-brace">}</span>';
      }
      /* ── engine:end ── */

      function generate() {
        var tokens = [];
        groupsEl.querySelectorAll('.cvg-token-row').forEach(function (row) {
          var nameEl  = row.querySelector('.cvg-token-name');
          var valueEl = row.querySelector('.cvg-token-value');
          tokens.push({ name: nameEl ? nameEl.value : '', value: valueEl ? valueEl.value : '' });
        });
        var decls = tokenDecls(prefixEl.value, tokens);
        var lines = plainCss(decls).split('\n');
        codeEl.innerHTML = highlightCss(decls);

        copyBtn.disabled = lines.length <= 2;
        window.trackTool && window.trackTool('css-variables-generator', 'generate');
      }

      var copyRequest = 0;
      var copyTimer = 0;
      function resetCopyFeedback() {
        copyRequest++;
        if (copyTimer) clearTimeout(copyTimer);
        copyTimer = 0;
        copyBtn.textContent = COPY_LABEL;
        copyBtn.classList.remove('copied');
        statusEl.textContent = '';
      }
      function refresh(event) {
        resetCopyFeedback();
        generate();
        resultEl.dataset.empty = 'false';
        emptyEl.hidden = true;
        preEl.hidden = false;
        if (event && window.matchMedia('(max-width: 640px)').matches) resultEl.scrollIntoView({ block: 'nearest' });
      }
      document.addEventListener('keydown', function (event) {
        if (!(event.ctrlKey || event.metaKey) || event.key.toLowerCase() !== 'l' || !wrap.contains(document.activeElement)) return;
        event.preventDefault();
        resetCopyFeedback();
        wrap.querySelectorAll('input[type="text"]').forEach(function (el) { el.value = ''; });
        codeEl.innerHTML = '';
        copyBtn.disabled = true;
        resultEl.dataset.empty = 'true';
        emptyEl.hidden = false;
        preEl.hidden = true;
      });


      prefixEl.addEventListener('input', refresh);

      /* ── Copy ── */
      copyBtn.addEventListener('click', async function () {
        var text = codeEl.textContent;
        if (!text) return;
        resetCopyFeedback();
        var request = copyRequest;
        try {
          await navigator.clipboard.writeText(text);
          if (request !== copyRequest) return;
          copyBtn.textContent = COPIED_LABEL;
          copyTimer = setTimeout(function () {
            if (request !== copyRequest) return;
            copyTimer = 0;
            copyBtn.textContent = COPY_LABEL;
          }, 1500);
          window.trackTool && window.trackTool('css-variables-generator', 'copy');
        } catch (_) {
          if (request !== copyRequest) return;
          copyBtn.textContent = COPY_FAILED_LABEL;
          statusEl.textContent = COPY_FAILED_LABEL;
        }
      });

      /* ── Initial render ── */
      refresh();
    })();
  </script>
</div>

<style is:global>
  .cvg-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .cvg-body { display: grid; grid-template-columns: clamp(270px, 24vw, 320px) minmax(0, 1fr); gap: 1.5rem; flex: 1 1 0; min-height: 0; }
  .cvg-rail { overflow: auto; padding-right: 0.3rem; }
  .cvg-field-header, .cvg-copy-row, .cvg-token-help > span { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
  .cvg-field-header { flex-wrap: wrap; }
  .cvg-prefix-row { flex-wrap: nowrap; }
  .cvg-prefix-input { flex: 1; min-width: 0; }
  .cvg-editor summary { cursor: pointer; padding: 0.5rem 0; min-height: 44px; font-weight: 600; }
  .cvg-token-help { display: flex; flex-wrap: wrap; gap: 0.4rem 0.7rem; padding-bottom: 0.5rem; font-size: 0.78rem; }
  .cvg-groups { max-height: 28rem; overflow: auto; }
  #cvg-copy { flex: 1; min-width: 0; height: 44px; white-space: normal; line-height: 1.2; }
  #cvg-status { height: 2.8em; flex: none; margin: 0; overflow: auto; }
  .cvg-empty { color: var(--color-text-muted); font-size: 0.9rem; }
  .cvg-pre[hidden], .cvg-empty[hidden] { display: none; }
  .cvg-wrap :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }

  /* ── Prefix row ── */
  .cvg-prefix-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: nowrap;
  }

  .cvg-field-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .cvg-prefix-input {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    width: 160px;
  }

  .cvg-prefix-input:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  /* ── Groups ── */
  .cvg-groups { display: flex; flex-direction: column; gap: 0.75rem; }

  .cvg-group {
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .cvg-group-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.45rem 0.75rem;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .cvg-group-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
