const T = STRINGS[lang] || STRINGS.en;
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="jx-wrap">
  <div class="jx-toolbar">
    <div class="jx-control"><button id="jx-to-xml" class="btn-primary" type="button">{T.jsonToXml}</button><Toggletip id="jx-tip-to-xml" about={T.jsonToXml} lang={lang}>{TIPS.toXml}</Toggletip></div>
    <div class="jx-control"><button id="jx-to-json" class="btn-primary" type="button">{T.xmlToJson}</button><Toggletip id="jx-tip-to-json" about={T.xmlToJson} lang={lang}>{TIPS.toJson}</Toggletip></div>
    <div class="jx-control"><button id="jx-clear" class="btn-ghost" type="button">{T.clear}</button><Toggletip id="jx-tip-clear" about={T.clear} lang={lang}>{TIPS.clear}</Toggletip></div>
    <details class="jx-options">
      <summary class="btn-ghost">{T.options}</summary>
      <div class="jx-option-fields">
        <div class="jx-control jx-root-control"><label for="jx-root">{T.rootElement}</label><input id="jx-root" class="tool-input" type="text" value="root" maxlength="64" spellcheck="false" /><Toggletip id="jx-tip-root" about={T.rootElement} lang={lang}>{TIPS.root}</Toggletip></div>
        <div class="jx-control"><label class="jx-check"><input id="jx-pretty" type="checkbox" checked /><span>{T.prettyPrint}</span></label><Toggletip id="jx-tip-pretty" about={T.prettyPrint} lang={lang}>{TIPS.pretty}</Toggletip></div>
      </div>
    </details>
  </div>
  <div id="jx-status" class="jx-status" aria-live="polite"></div>
  <div class="jx-panels zt-io">
    <div class="jx-panel zt-io-pane">
      <div class="jx-head">
        <div class="jx-control"><label for="jx-json">JSON</label><Toggletip id="jx-tip-json" about="JSON" lang={lang}>{TIPS.json}</Toggletip></div>
        <div class="jx-control"><button id="jx-copy-json" class="btn-copy" type="button" disabled>{T.copy}</button><Toggletip id="jx-tip-copy-json" about={T.copy + ' JSON'} lang={lang}>{TIPS.copyJson}</Toggletip></div>
      </div>
      <textarea id="jx-json" class="tool-textarea jx-box zt-io-fill" placeholder='{"name":"Alice","age":30,"hobbies":["reading","hiking"]}' spellcheck="false"></textarea>
    </div>
    <div class="jx-panel zt-io-pane">
      <div class="jx-head">
        <div class="jx-control"><label for="jx-xml">XML</label><Toggletip id="jx-tip-xml" about="XML" lang={lang}>{TIPS.xml}</Toggletip></div>
        <div class="jx-control"><button id="jx-copy-xml" class="btn-copy" type="button" disabled>{T.copy}</button><Toggletip id="jx-tip-copy-xml" about={T.copy + ' XML'} lang={lang}>{TIPS.copyXml}</Toggletip></div>
      </div>
      <textarea id="jx-xml" class="tool-textarea jx-box zt-io-fill" placeholder="<root><name>Alice</name><age>30</age></root>" spellcheck="false"></textarea>
    </div>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var jsonEl = document.getElementById('jx-json');
      var xmlEl = document.getElementById('jx-xml');
      var rootEl = document.getElementById('jx-root');
      var prettyEl = document.getElementById('jx-pretty');
      var statusEl = document.getElementById('jx-status');
      var copyJsonBtn = document.getElementById('jx-copy-json');
      var copyXmlBtn = document.getElementById('jx-copy-xml');
      copyJsonBtn.disabled = copyXmlBtn.disabled = true;

      var copyRevision = 0;
      var copyErrorOwner = null;
      var copyStates = [{ btn: copyJsonBtn, request: 0, timer: null }, { btn: copyXmlBtn, request: 0, timer: null }];
      function invalidateCopies() {
        copyRevision++;
        copyStates.forEach(function (state) {
          clearTimeout(state.timer);
          state.timer = null;
          state.btn.textContent = t.copy;
        });
        copyErrorOwner = null;
      }

      function setStatus(msg, isError) {
        copyErrorOwner = null;
        statusEl.textContent = msg;
        statusEl.className = 'jx-status ' + (isError ? 'error' : 'success');
      }
      function clearStatus() {
        copyErrorOwner = null;
        statusEl.textContent = '';
        statusEl.className = 'jx-status';
      }

      /* ── engine:start ── */
      // Valid input that this element-only mapping cannot represent (not a syntax error).
      function lossError(message) {
        var e = new Error(message);
        e.loss = true;
        return e;
      }

      /* ── JSON → XML ── */
      // XML 1.0 §2.3 NCName ranges: preserve names verbatim; namespaces need a separate mapping.
      function xmlName(key, path) {
        var n = String(key);
        if (!/^[A-Z_a-z\u00C0-\u00D6\u00D8-\u00F6\u00F8-\u02FF\u0370-\u037D\u037F-\u1FFF\u200C-\u200D\u2070-\u218F\u2C00-\u2FEF\u3001-\uD7FF\uF900-\uFDCF\uFDF0-\uFFFD\u{10000}-\u{EFFFF}][A-Z_a-z\u00C0-\u00D6\u00D8-\u00F6\u00F8-\u02FF\u0370-\u037D\u037F-\u1FFF\u200C-\u200D\u2070-\u218F\u2C00-\u2FEF\u3001-\uD7FF\uF900-\uFDCF\uFDF0-\uFFFD\u{10000}-\u{EFFFF}0-9.\-\u00B7\u0300-\u036F\u203F-\u2040]*$/u.test(n)) {
          throw lossError(t.nameLoss.replace('{path}', path));
        }
        return n;
      }

      function xmlText(value, path) {
        var text = String(value);
        if (/[^\u0009\u000A\u000D\u0020-\uD7FF\uE000-\uFFFD\u{10000}-\u{10FFFF}]/u.test(text)) {
          throw lossError(t.charLoss.replace('{path}', path));
        }
        return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\r/g, '&#13;');
      }

      function jsonToXml(val, tagName, indent, pretty, path) {
        var pad = pretty ? indent : '';
        var nl = pretty ? '\n' : '';
        var childIndent = pretty ? indent + '  ' : '';
        var open = '<' + tagName + '>';
        var close = '</' + tagName + '>';

        if (val === null || val === undefined) {
          return pad + open + close;
        }
        if (Array.isArray(val)) {
          if (!val.length) throw lossError(t.arrayLoss.replace('{path}', path));
          return val.map(function (item, index) {
            var itemPath = path + '[' + index + ']';
            if (Array.isArray(item)) throw lossError(t.arrayLoss.replace('{path}', itemPath));
            return jsonToXml(item, tagName, indent, pretty, itemPath);
          }).join(nl);
        }
        if (typeof val === 'object') {
          var children = Object.keys(val).map(function (key) {
            var childPath = path + '[' + JSON.stringify(key) + ']';
            return jsonToXml(val[key], xmlName(key, childPath), childIndent, pretty, childPath);
          }).join(nl);
          if (!children) return pad + open + close;
          return pad + open + nl + children + nl + pad + close;
        }
        return pad + open + xmlText(val, path) + close;
      }

      function buildXml(data, rootInput, pretty) {
        var rootName = xmlName(String(rootInput || '').trim() || 'root', '$');
        var inner;
        var nl = pretty ? '\n' : '';
        var decl = '<?xml version="1.0" encoding="UTF-8"?>' + nl;
        // A scalar, null or {} root has no child elements: indentation would become its text.
        if (data === null || typeof data !== 'object') {
          return decl + jsonToXml(data, rootName, '', pretty, '$');
        }
        if (Array.isArray(data)) {
          inner = jsonToXml(data, 'item', pretty ? '  ' : '', pretty, '$');
        } else {
          inner = Object.keys(data).map(function (key) {
            var path = '$[' + JSON.stringify(key) + ']';
            return jsonToXml(data[key], xmlName(key, path), pretty ? '  ' : '', pretty, path);
          }).join(nl);
          if (!inner) return decl + '<' + rootName + '></' + rootName + '>';
        }
        return decl + '<' + rootName + '>' + nl + inner + nl + '</' + rootName + '>';
      }
      /* ── engine:end ── */

      /* ── json-reason:start ── */
      // Why the JSON pane is not JSON, in the page language, without the browser's English message.
      // lineCol and jsonSyntaxError are copied verbatim from json-formatter-engine.js (the test
      // compares the source); jsonSyntaxError runs only after JSON.parse has failed. The tool parses
      // the trimmed text, so the leading whitespace is added back to count lines from the pane.
      function lineCol(text, offset) {
        var line = 1, last = -1;
        for (var i = text.indexOf('\n'); i !== -1 && i < offset; i = text.indexOf('\n', i + 1)) { line++; last = i; }
        return { line: line, col: offset - last };
      }
      function jsonSyntaxError(text) {
        var i = 0, n = text.length;
        var SMART = '\u201c\u201d\u2018\u2019\u300c\u300d';
        var WIDE = '\u3000\uff1a\uff0c\uff5b\uff5d\uff3b\uff3d\uff02';
        function fail(code, at, ch) { throw { jsonErr: true, code: code, offset: at === undefined ? i : at, ch: ch }; }
        function special(c) {
          if (SMART.indexOf(c) >= 0) fail('smartQuote', i, c);
          if (WIDE.indexOf(c) >= 0) fail('fullWidth', i, c);
        }
        function ws() {
          while (i < n) {
            var c = text[i];
            if (c === ' ' || c === '\t' || c === '\n' || c === '\r') { i++; continue; }
            if (c === '/' && (text[i + 1] === '/' || text[i + 1] === '*')) fail('comment');
            if (c === '#') fail('comment');
            break;
          }
        }
        var NUM = /-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?/y;
        var WORD = /[A-Za-z_$][\w$]*/y;
        function str() {
          var s = i; i++;
          while (i < n) {
            var c = text.charCodeAt(i);
            if (c === 34) { i++; return; }
            if (c === 92) {
              var e = text[i + 1];
              if (e !== undefined && '"\\/bfnrt'.indexOf(e) >= 0) { i += 2; continue; }
              if (e === 'u' && /^[0-9a-fA-F]{4}$/.test(text.substr(i + 2, 4))) { i += 6; continue; }
              fail('badEscape');
            }
            if (c < 0x20) fail('controlChar');
            i++;
          }
          fail('unterminatedString', s);
        }
        function num() {
          NUM.lastIndex = i;
          var m = NUM.exec(text);
          if (!m || m[0] === '-' || m[0] === '') fail('badNumber');
          i += m[0].length;
          if (i < n && /[0-9.eE]/.test(text[i])) fail('badNumber');
        }
        function startsValue(c) { return c === '{' || c === '[' || c === '"' || c === '-' || (c >= '0' && c <= '9') || c === 't' || c === 'f' || c === 'n'; }
        function value(depth) {
          if (depth > 3000) fail('unexpectedChar');
          ws();
          if (i >= n) fail('unexpectedEnd');
          var c = text[i];
          if (c === '{') return obj(depth);
          if (c === '[') return arr(depth);
          if (c === '"') return str();
          if (c === "'") fail('singleQuote');
          special(c);
          if (c === '-' || (c >= '0' && c <= '9')) return num();
          if (c === '+' || c === '.') fail('badNumber');
          WORD.lastIndex = i;
          var m = WORD.exec(text);
          if (m) {
            if (m[0] === 'true' || m[0] === 'false' || m[0] === 'null') { i += m[0].length; return; }
            if (m[0] === 'NaN' || m[0] === 'Infinity') fail('badNumber');
            fail('badLiteral');
          }
          fail('unexpectedChar', i, c);
        }
        function obj(depth) {
          i++; ws();
          if (text[i] === '}') { i++; return; }
          for (;;) {
            ws();
            if (i >= n) fail('unexpectedEnd');
            var c = text[i];
            if (c === "'") fail('singleQuote');
            special(c);
            if (c !== '"') { if (/[A-Za-z_$0-9]/.test(c)) fail('unquotedKey'); fail('unexpectedChar', i, c); }
            str(); ws();
            if (i >= n) fail('unexpectedEnd');
            if (text[i] !== ':') { special(text[i]); fail('missingColon'); }
            i++;
            value(depth + 1); ws();
            if (i >= n) fail('unexpectedEnd');
            c = text[i];
            if (c === ',') { var comma = i; i++; ws(); if (text[i] === '}') fail('trailingComma', comma); continue; }
            if (c === '}') { i++; return; }
            special(c);
            if (c === '"' || /[A-Za-z_$]/.test(c)) fail('missingComma');
            fail('unexpectedChar', i, c);
          }
        }
        function arr(depth) {
          i++; ws();
          if (text[i] === ']') { i++; return; }
          for (;;) {
            value(depth + 1); ws();
            if (i >= n) fail('unexpectedEnd');
            var c = text[i];
            if (c === ',') { var comma = i; i++; ws(); if (text[i] === ']') fail('trailingComma', comma); continue; }
            if (c === ']') { i++; return; }
            special(c);
            if (startsValue(c)) fail('missingComma');
            fail('unexpectedChar', i, c);
          }
        }
        try {
          ws();
          if (i >= n) return { code: 'empty', offset: 0 };
          value(0);
          ws();
          if (i < n) fail('extraData');
          return null;
        } catch (e) {
          if (e && e.jsonErr) return { code: e.code, offset: e.offset, ch: e.ch };
          throw e;
        }
      }
      function jsonErrorText(value) {
        var e = jsonSyntaxError(value.trim());
        if (!e) return t.errJson;
        var at = lineCol(value, value.length - value.trimStart().length + e.offset);
        var reason = String(t.jsonParse[e.code] || t.jsonParse.unexpectedChar || e.code).replace('{ch}', function () { return e.ch == null ? '' : e.ch; });
        return t.errJsonAt.replace(/\{(line|col|reason)\}/g, function (m, k) { return k === 'line' ? String(at.line) : k === 'col' ? String(at.col) : reason; });
      }
      /* ── json-reason:end ── */

      function convertJsonToXml() {
        cancelPending();
        xmlEl.value = '';
        copyXmlBtn.disabled = true;
        var raw = jsonEl.value.trim();
        if (!raw) { clearStatus(); return; }
        var data;
        try {
          data = JSON.parse(raw);
        } catch (e) {
          setStatus(e && e.name === 'SyntaxError' ? jsonErrorText(jsonEl.value) : t.invalidJson + ': ' + e.message, true);
          return;
        }
        try {
          xmlEl.value = buildXml(data, rootEl.value, prettyEl.checked);
          copyXmlBtn.disabled = false;
          setStatus(t.convertedToXml, false);
        } catch (e) {
          setStatus((e.loss ? t.cannotToXml : t.invalidJson) + ': ' + e.message, true);
        }
      }

      /* ── XML → JSON ── */
      function xmlNodeToJson(node, path) {
        if (node.attributes.length) {
          throw lossError(t.attributeLoss.replace('{path}', path + '/@' + node.attributes[0].name));
        }
        var obj = Object.create(null);
        var children = Array.from(node.childNodes);
        var elemChildren = children.filter(function (n) { return n.nodeType === 1; });
        if (!elemChildren.length) return node.textContent;
        if (children.some(function (n) { return (n.nodeType === 3 || n.nodeType === 4) && n.nodeValue.trim() !== ''; })) {
          throw lossError(t.mixedLoss.replace('{path}', path));
        }
        var indices = Object.create(null);
        elemChildren.forEach(function (child) {
          var tag = child.tagName;
          indices[tag] = (indices[tag] || 0) + 1;
          var childVal = xmlNodeToJson(child, path + '/' + tag + '[' + indices[tag] + ']');
          if (Object.prototype.hasOwnProperty.call(obj, tag)) {
            if (!Array.isArray(obj[tag])) obj[tag] = [obj[tag]];
            obj[tag].push(childVal);
          } else {
            obj[tag] = childVal;
          }
        });

        return obj;
      }

      function convertXmlToJson() {
        cancelPending();
        jsonEl.value = '';
        copyJsonBtn.disabled = true;
        var raw = xmlEl.value.trim();
        if (!raw) { clearStatus(); return; }
        var pretty = prettyEl.checked;
        try {
          var parser = new DOMParser();
          var doc = parser.parseFromString(raw, 'application/xml');
          var parseErr = doc.querySelector('parsererror');
          if (parseErr) throw new Error(((parseErr.querySelector('div') || parseErr).textContent || '').trim().split('\n')[0]);
          var root = doc.documentElement;
          var result = Object.create(null);
          result[root.tagName] = xmlNodeToJson(root, '/' + root.tagName);
          jsonEl.value = JSON.stringify(result, null, pretty ? 2 : undefined);
          copyJsonBtn.disabled = false;
          setStatus(t.convertedToJson, false);
        } catch (e) {
          setStatus((e.loss ? t.cannotToJson : t.invalidXml) + ': ' + e.message, true);
        }
      }

      /* ── Real-time (debounced 400ms) ── */
      var _jxJsonTimer = null;
      var _jxXmlTimer = null;
      function cancelPending() {
        invalidateCopies();
        clearTimeout(_jxJsonTimer);
        clearTimeout(_jxXmlTimer);
      }
      jsonEl.addEventListener('input', function () {
        cancelPending();
        xmlEl.value = '';
        copyXmlBtn.disabled = true;
        copyJsonBtn.disabled = !jsonEl.value;
        clearStatus();
        _jxJsonTimer = setTimeout(convertJsonToXml, 400);
      });

      xmlEl.addEventListener('input', function () {
        cancelPending();
        jsonEl.value = '';
        copyJsonBtn.disabled = true;
        copyXmlBtn.disabled = !xmlEl.value;
        clearStatus();
        _jxXmlTimer = setTimeout(convertXmlToJson, 400);
      });

      /* ── Buttons ── */
      document.getElementById('jx-to-xml').addEventListener('click', function () {
        convertJsonToXml();
        window.trackTool && window.trackTool('json-xml-converter', 'json_to_xml');
      });

      document.getElementById('jx-to-json').addEventListener('click', function () {
        convertXmlToJson();
        window.trackTool && window.trackTool('json-xml-converter', 'xml_to_json');
      });

      function clearAll() {
        cancelPending();
        jsonEl.value = '';
        xmlEl.value = '';
        copyJsonBtn.disabled = true;
        copyXmlBtn.disabled = true;
        clearStatus();
        jsonEl.focus();
      }
      document.getElementById('jx-clear').addEventListener('click', clearAll);

      function copyFrom(el, btn, state) {
        if (btn.disabled || !el.value) return;
        var revision = copyRevision;
        var request = ++state.request;
        var text = el.value;
        clearTimeout(state.timer);
        state.timer = null;
        btn.textContent = t.copy;
        function current() { return revision === copyRevision && request === state.request && el.value === text && !btn.disabled; }
        function failed() {
          if (!current()) return;
          setStatus(t.copyFailed, true);
          copyErrorOwner = btn;
        }
        function done() {
          if (!current()) return;
          if (copyErrorOwner === btn && statusEl.textContent === t.copyFailed) clearStatus();
          btn.textContent = t.copied;
          state.timer = setTimeout(function () { if (current()) btn.textContent = t.copy; }, 1500);
        }
        try {
          if (!navigator.clipboard || !navigator.clipboard.writeText) { failed(); return; }
          navigator.clipboard.writeText(text).then(done, failed);
        } catch (e) { failed(); }
      }
      copyJsonBtn.addEventListener('click', function () { copyFrom(jsonEl, copyJsonBtn, copyStates[0]); });
      copyXmlBtn.addEventListener('click', function () { copyFrom(xmlEl, copyXmlBtn, copyStates[1]); });

      /* ── Keyboard shortcuts ── */
      // stopPropagation: ToolLayout's page-wide Ctrl/Cmd+Enter would also click the first
      // primary button (JSON → XML) and convert the fresh JSON output back over the XML input.
      jsonEl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault(); e.stopPropagation();
          document.getElementById('jx-to-xml').click();
        }
      });
      xmlEl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault(); e.stopPropagation();
          document.getElementById('jx-to-json').click();
        }
      });
      // ToolLayout's Ctrl/Cmd+L empties the text fields without input events.
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && document.querySelector('.jx-wrap').contains(document.activeElement)) {
          e.preventDefault();
          clearAll();
        }
      });
    })();
  </script>
</div>

<style>
  .jx-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; min-height: 0; }
  .jx-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; flex: none; }
  .jx-control { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .jx-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; min-height: 32px; }
  .jx-head label, .jx-option-fields label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .jx-box { min-width: 0; overflow: auto; tab-size: 2; }
  .jx-status { height: 2.6rem; min-height: 2.6rem; flex: none; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; line-height: 1.5; color: var(--color-text-secondary); }
  .jx-status.success { color: var(--color-success); }
  .jx-status.error { color: var(--color-danger); }
  .jx-options[open] { flex-basis: 100%; }
  .jx-option-fields { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; padding-top: 0.5rem; }
  .jx-root-control { flex-wrap: wrap; }
  .jx-root-control input { width: 8rem; min-width: 0; }
  .jx-check { display: flex; align-items: center; gap: 0.4rem; }
  @media (max-width: 860px) {
    .jx-box { height: 180px; }
    .jx-status { height: 3.25rem; min-height: 3.25rem; }
  }
  @media (max-width: 640px) {
    .jx-wrap { gap: 0.5rem; }
    .jx-head, .jx-check { min-height: 44px; }
    .jx-box { height: 120px; }
  }
</style>
