---
// JwtGeneratorTool — client-side JWT signing via Web Crypto API (HS256/HS384/HS512)
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  en: {
    algorithm: 'Algorithm', headerLabel: 'Header', payloadLabel: 'Payload',
    secretLabel: 'Secret', secretPlaceholder: 'your-256-bit-secret',
    generatedToken: 'Generated Token', copy: 'Copy', copied: 'Copied!',
    generating: 'Generating token...', generated: 'Token generated.',
    errHeaderAlgo: 'Header alg must match the selected algorithm ({algo}).',
    copyFail: 'Could not copy. Try again or copy the token manually.',
    errHeaderJson: 'Header is not valid JSON.', errPayloadJson: 'Payload is not valid JSON.',
    errBase64Secret: 'Secret is not valid Base64.',
    errEmptySecret: 'Secret is required to sign the token.',
    errEmptyKey: 'The Base64 secret decodes to 0 bytes. Enter key data to sign the token.',
    errPayloadObject: 'Payload must be a JSON object, for example {"sub": "42"}. RFC 7519 requires the claims to be an object.',
    errSign: 'The browser could not sign the token. Edit a field to try again.',
