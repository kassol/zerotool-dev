      header: '展开 Header 可编辑 JSON。alg 必须与所选算法一致。签名前去掉 Header 和 Payload 首尾的空白，内部换行与缩进保留。',
      payload: '输入有效的 JSON 对象。iat、exp、nbf 等声明按原样保留，工具不会添加或检查时间戳。停止修改字段 0.5 秒后生成新签名。',
      secret: '请使用测试密钥。字节数按 UTF-8 编码或 Base64 解码后计算。HS256、HS384、HS512 分别要求至少 32、48、64 字节；更短的密钥仍会签名，并直接显示警告。',
      format: 'UTF-8 把输入文本编码为密钥字节。Base64 会先解码，支持标准和 URL 安全字母表，忽略空白，填充符可省略。',
      copy: '复制当前完整 Token。空输入或无效输入会清除旧 Token。焦点在工具内时，Ctrl+L（Mac 为 ⌘+L）清空三个字段和结果，保留所选算法与密钥格式。',
    },
  },
  ja: {
    algorithm: 'アルゴリズム', headerLabel: 'ヘッダー', payloadLabel: 'ペイロード',
    secretLabel: '秘密鍵', secretPlaceholder: '256ビットの秘密鍵',
    generatedToken: '生成されたトークン', copy: 'コピー', copied: 'コピー済み！',
    generating: '生成中...', generated: 'トークンが生成されました。',
    errHeaderAlgo: 'ヘッダーの alg は選択したアルゴリズム（{algo}）と一致する必要があります。',
    copyFail: 'コピーできませんでした。再試行するか、トークンを選択して手動でコピーしてください。',
    errHeaderJson: 'ヘッダーが有効なJSONではありません。', errPayloadJson: 'ペイロードが有効なJSONではありません。',
