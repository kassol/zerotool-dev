      header: 'ヘッダーを開くと JSON を編集できます。alg は選択したアルゴリズムと一致させます。署名前にヘッダーとペイロードの前後の空白を除き、内部の改行とインデントは保持します。',
      payload: '有効な JSON オブジェクトを入力します。iat、exp、nbf などはそのまま使い、タイムスタンプを追加・検証しません。フィールドの変更を止めてから 0.5 秒後に新しい署名を作ります。',
      secret: 'テスト用の秘密鍵を使ってください。長さは UTF-8 エンコードまたは Base64 デコード後のバイト数です。HS256、HS384、HS512にはそれぞれ32、48、64バイト以上が必要です。短くても署名し、警告を表示します。',
      format: 'UTF-8 は入力文字列を鍵のバイト列にします。Base64 は先にデコードし、標準・URLセーフの両形式に対応します。空白は無視し、パディングは省略できます。',
      copy: '現在のトークン全体をコピーします。空または無効な入力では以前のトークンを消します。ツール内で Ctrl+L（Macは⌘+L）を押すと、3つの欄と結果を消し、アルゴリズムと秘密鍵の形式は保持します。',
    },
  },
  ko: {
    algorithm: '알고리즘', headerLabel: '헤더', payloadLabel: '페이로드',
    secretLabel: '비밀 키', secretPlaceholder: '256비트 비밀 키',
    generatedToken: '생성된 토큰', copy: '복사', copied: '복사됨!',
    generating: '생성 중...', generated: '토큰이 생성되었습니다.',
    errHeaderAlgo: '헤더의 alg는 선택한 알고리즘({algo})과 일치해야 합니다.',
    copyFail: '복사하지 못했습니다. 다시 시도하거나 토큰을 선택하여 직접 복사하세요.',
    errHeaderJson: '헤더가 유효한 JSON이 아닙니다.', errPayloadJson: '페이로드가 유효한 JSON이 아닙니다.',
    errBase64Secret: '비밀 키가 유효한 Base64가 아닙니다.',
    errEmptySecret: '토큰에 서명하려면 비밀 키를 입력해야 합니다.',
    errEmptyKey: 'Base64 비밀 키를 디코딩하면 0바이트입니다. 키 내용을 입력하세요.',
    errPayloadObject: '페이로드는 JSON 객체여야 합니다(예: {"sub": "42"}). RFC 7519는 클레임을 객체로 표현하도록 정합니다.',
    errSign: '브라우저가 토큰에 서명하지 못했습니다. 아무 필드나 수정하면 다시 시도합니다.',
    warnShortKey: '키가 {bytes}바이트입니다. RFC 7518은 {algo}에 {min}바이트 이상을 요구합니다. 서명은 하지만 이 키는 너무 짧습니다.',
    privacyNote: '모든 처리는 브라우저에서 로컬로 수행됩니다.',
    secretFormat: '비밀 키 형식',
    empty: '유효한 헤더와 페이로드 JSON, 비밀 키를 입력하면 서명된 토큰이 표시됩니다.',
    tips: {
      algorithm: 'HS256, HS384 또는 HS512를 선택하면 JSON 객체 헤더의 alg가 갱신됩니다. 직접 편집한 alg는 선택한 알고리즘과 같아야 합니다. 수정을 멈춘 뒤 0.5초 후에 서명합니다.',
      header: '헤더를 펼쳐 JSON을 편집하세요. alg는 선택한 알고리즘과 같아야 합니다. 서명 전에 헤더와 페이로드 양끝의 공백을 제거하며 내부 줄바꿈과 들여쓰기는 유지합니다.',
      payload: '유효한 JSON 객체를 입력하세요. iat, exp, nbf 등은 입력한 그대로 유지하며 타임스탬프를 추가하거나 검사하지 않습니다. 필드 수정을 멈춘 뒤 0.5초 후 새 서명을 생성합니다.',
      secret: '테스트용 비밀 키를 사용하세요. 길이는 UTF-8 인코딩 또는 Base64 디코딩 후 바이트 수입니다. HS256, HS384, HS512는 각각 최소 32, 48, 64바이트가 필요합니다. 더 짧아도 서명하며 경고를 표시합니다.',
      format: 'UTF-8은 입력 텍스트를 키 바이트로 인코딩합니다. Base64는 먼저 디코딩하며 표준 및 URL 안전 알파벳을 지원합니다. 공백은 무시하고 패딩은 생략할 수 있습니다.',
      copy: '현재 토큰 전체를 복사합니다. 입력이 비었거나 유효하지 않으면 이전 토큰을 지웁니다. 도구 안에서 Ctrl+L(Mac은 ⌘+L)을 누르면 세 필드와 결과가 지워지고 알고리즘과 비밀 키 형식은 유지됩니다.',
    },
  }
} as const;
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="jg-wrap">
  <div class="jg-toolbar">
    <span id="jg-algo-label" class="jg-label">{T.algorithm}</span>
    <div class="jg-algo-btns zt-segmented" role="group" aria-labelledby="jg-algo-label">
      <button class="jg-algo-btn active" data-algo="HS256" type="button">HS256</button>
      <button class="jg-algo-btn" data-algo="HS384" type="button">HS384</button>
      <button class="jg-algo-btn" data-algo="HS512" type="button">HS512</button>
    </div>
    <Toggletip id="jg-tip-algorithm" lang={lang} about={T.algorithm} wide>{TIPS.algorithm}</Toggletip>
  </div>
  <div id="jg-status" class="jg-status" role="status" aria-live="polite"></div>
  <div class="jg-panels zt-io">
    <div class="jg-input-pane zt-io-pane">
      <div class="jg-pane-head">
        <label for="jg-payload" class="jg-label">{T.payloadLabel}</label>
        <Toggletip id="jg-tip-payload" lang={lang} about={T.payloadLabel} wide>{TIPS.payload}</Toggletip>
      </div>
      <textarea id="jg-payload" class="tool-textarea jg-payload zt-io-fill" spellcheck="false" aria-describedby="jg-payload-err"></textarea>
      <div id="jg-payload-err" class="jg-field-err" aria-live="polite"></div>
      <div class="jg-secret-field">
        <div class="jg-secret-hdr">
          <span class="jg-field-label">
            <label for="jg-secret" class="jg-label">{T.secretLabel}</label>
            <Toggletip id="jg-tip-secret" lang={lang} about={T.secretLabel} wide>{TIPS.secret}</Toggletip>
          </span>
          <span class="jg-secret-fmt" role="radiogroup" aria-label={T.secretFormat}>
            <label class="jg-radio"><input type="radio" name="jg-fmt" value="utf8" checked /> UTF-8</label>
            <label class="jg-radio"><input type="radio" name="jg-fmt" value="base64" /> Base64</label>
            <Toggletip id="jg-tip-format" lang={lang} about={T.secretFormat} wide>{TIPS.format}</Toggletip>
          </span>
        </div>
        <input id="jg-secret" class="tool-input" type="text" placeholder={T.secretPlaceholder} spellcheck="false" autocomplete="off" aria-describedby="jg-secret-warn" />
        <div id="jg-secret-warn" class="jg-secret-warn" aria-live="polite"></div>
      </div>
      <details id="jg-header-details" class="jg-header-details">
        <summary>{T.headerLabel}</summary>
        <div class="jg-header-body">
          <div class="jg-pane-head">
            <label for="jg-header" class="jg-label">{T.headerLabel}</label>
            <Toggletip id="jg-tip-header" lang={lang} about={T.headerLabel} wide>{TIPS.header}</Toggletip>
          </div>
          <textarea id="jg-header" class="tool-textarea jg-header" spellcheck="false" aria-describedby="jg-header-err"></textarea>
          <div id="jg-header-err" class="jg-header-err jg-field-err" aria-live="polite"></div>
        </div>
      </details>
    </div>
    <div id="jg-result-pane" class="jg-output-pane zt-io-pane" data-empty="true">
      <div class="jg-pane-head">
        <span id="jg-result-label" class="jg-label">{T.generatedToken}</span>
        <span class="jg-copy">
          <button id="jg-copy" class="btn-copy" type="button">{T.copy}</button>
          <Toggletip id="jg-tip-copy" lang={lang} about={T.copy} wide>{TIPS.copy}</Toggletip>
        </span>
      </div>
      <p class="jg-empty zt-io-fill">{T.empty}</p>
      <div id="jg-result-wrap" class="jg-result-wrap zt-io-fill" style="display:none" tabindex="0" role="region" aria-labelledby="jg-result-label">
        <code id="jg-result" class="jg-result"></code>
      </div>
      <p class="jg-privacy">{T.privacyNote}</p>
    </div>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var DEFAULT_HEADER = JSON.stringify({ alg: 'HS256', typ: 'JWT' }, null, 2);
      var DEFAULT_PAYLOAD = JSON.stringify({
        sub: '1234567890',
        name: 'John Doe',
        iat: 1516239022
      }, null, 2);

      var headerEl = document.getElementById('jg-header');
      var payloadEl = document.getElementById('jg-payload');
      var secretEl = document.getElementById('jg-secret');
      var statusEl = document.getElementById('jg-status');
      var resultWrap = document.getElementById('jg-result-wrap');
      var resultPane = document.getElementById('jg-result-pane');
      var headerDetails = document.getElementById('jg-header-details');
      var resultEl = document.getElementById('jg-result');
      var copyBtn = document.getElementById('jg-copy');
      var headerErrEl = document.getElementById('jg-header-err');
      var payloadErrEl = document.getElementById('jg-payload-err');
      var secretWarnEl = document.getElementById('jg-secret-warn');

      headerEl.value = DEFAULT_HEADER;
      payloadEl.value = DEFAULT_PAYLOAD;
      // Pre-fill a sample secret so first-load auto-generate produces a real
      // signed token. Empty secret is treated as an error (not silently unsigned).
      secretEl.value = 'your-256-bit-secret';

      var currentAlgo = 'HS256';
      var currentFmt = 'utf8';

      document.querySelectorAll('.jg-algo-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.querySelectorAll('.jg-algo-btn').forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active');
          currentAlgo = btn.getAttribute('data-algo');
          syncHeaderAlg(currentAlgo);
          scheduleGenerate();
          trackWanted = true;
        });
      });

      document.querySelectorAll('input[name="jg-fmt"]').forEach(function (radio) {
        radio.addEventListener('change', function () {
          currentFmt = radio.value;
          scheduleGenerate();
          trackWanted = true;
        });
      });

      function syncHeaderAlg(algo) {
        try {
          var obj = JSON.parse(headerEl.value);
          obj.alg = algo;
          headerEl.value = JSON.stringify(obj, null, 2);
        } catch (e) { /* leave as-is if invalid JSON */ }
      }

      /* ── engine:start ── */
      function base64urlFromBuf(buf) {
        var bytes = new Uint8Array(buf);
        var str = '';
        bytes.forEach(function (b) { str += String.fromCharCode(b); });
        return btoa(str).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      }

      function algoToWebCrypto(algo) {
        return { 'HS256': 'SHA-256', 'HS384': 'SHA-384', 'HS512': 'SHA-512' }[algo] || 'SHA-256';
      }

      /* RFC 7518 §3.2: a key of the same size as the hash output (or larger) MUST be used
         with this algorithm — 32 bytes for HS256, 48 for HS384, 64 for HS512. */
      function minKeyBytes(algo) {
        return { 'HS256': 32, 'HS384': 48, 'HS512': 64 }[algo] || 32;
      }

      /* Secret text → key bytes. fmt 'utf8' encodes the text; 'base64' accepts standard and
         URL-safe Base64 with or without padding. Returns null for invalid Base64. */
      function decodeSecret(secretStr, fmt) {
        if (fmt !== 'base64') return new TextEncoder().encode(secretStr);
        var b64 = secretStr.replace(/\s+/g, '').replace(/-/g, '+').replace(/_/g, '/');
        while (b64.length % 4) b64 += '=';
        try {
          var bStr = atob(b64);
          var out = new Uint8Array(bStr.length);
          for (var i = 0; i < bStr.length; i++) out[i] = bStr.charCodeAt(i);
          return out;
        } catch (e) {
          return null;
        }
      }

      /* headerStr / payloadStr are signed exactly as written (UTF-8). */
      async function signJwt(headerStr, payloadStr, keyBytes, algo, subtle) {
        var enc = new TextEncoder();
        var signingInput = base64urlFromBuf(enc.encode(headerStr)) + '.' + base64urlFromBuf(enc.encode(payloadStr));
        var cryptoKey = await subtle.importKey('raw', keyBytes, { name: 'HMAC', hash: algoToWebCrypto(algo) }, false, ['sign']);
        var sigBuf = await subtle.sign('HMAC', cryptoKey, enc.encode(signingInput));
        return signingInput + '.' + base64urlFromBuf(sigBuf);
      }
      /* ── engine:end ── */

      var debounceTimer = null;
      var generation = 0;
      var copyRevision = 0;
      var copyTimer = null;
      var copyError = false;

      /* Analytics: one event per committed edit (change event, algorithm or format), sent once
         that state has a token; not per typing pause and not for the automatic first token. The
         same inputs are sent once; Ctrl+L starts over. */
      var trackWanted = false;
      var lastTracked = null;
      function trackKey() {
        return [currentAlgo, currentFmt, headerEl.value.trim(), payloadEl.value.trim(), secretEl.value].join('\u0000');
      }
      function maybeTrack() {
        if (!trackWanted || debounceTimer || !resultEl.textContent) return;
        trackWanted = false;
        var key = trackKey();
        if (key === lastTracked) return;
        lastTracked = key;
        window.trackTool && window.trackTool('jwt-generator', 'generate');
      }
      function commitEdit() {
        trackWanted = true;
        if (debounceTimer) {
          clearTimeout(debounceTimer);
          debounceTimer = null;
          generate();
        } else {
          maybeTrack();
        }
      }

      // Copy fallback when the Clipboard API is missing or refuses: a hidden textarea and execCommand.
      function fallbackCopy(text) {
        var ta;
        try {
          ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          return document.execCommand('copy') === true;
        } catch (e) {
          return false;
        } finally {
          if (ta && ta.parentNode) ta.parentNode.removeChild(ta);
        }
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        if (copyError) {
          statusEl.textContent = t.generated;
          statusEl.className = 'jg-status success';
        }
        copyError = false;
      }

      function clearOutput() {
        invalidateCopy();
        resultEl.textContent = '';
        resultWrap.style.display = 'none';
        resultPane.setAttribute('data-empty', 'true');
        headerErrEl.textContent = '';
        payloadErrEl.textContent = '';
        secretWarnEl.textContent = '';
        statusEl.textContent = '';
        statusEl.className = 'jg-status';
      }

      function scheduleGenerate() {
        generation++;
        trackWanted = false;
        clearTimeout(debounceTimer);
        clearOutput();
        debounceTimer = setTimeout(function () { debounceTimer = null; generate(); }, 500);
      }

      async function generate() {
        var current = ++generation;
        clearOutput();

        var headerStr = headerEl.value.trim();
        var payloadStr = payloadEl.value.trim();
        var secretStr = secretEl.value;

        if (!headerStr && !payloadStr && !secretStr) return;
        var headerOk = true, payloadOk = true, header;
        try { header = JSON.parse(headerStr); } catch (e) { headerErrEl.textContent = t.errHeaderJson; headerOk = false; }
        if (headerOk && (!header || header.alg !== currentAlgo)) {
          headerErrEl.textContent = t.errHeaderAlgo.replace('{algo}', currentAlgo);
          headerOk = false;
        }
        var payload;
        try { payload = JSON.parse(payloadStr); } catch (e) { payloadErrEl.textContent = t.errPayloadJson; payloadOk = false; }
        /* RFC 7519 §7.2 step 10: the claims set must be a JSON object; libraries such as PyJWT reject
           an array, string, number or null payload. */
        if (payloadOk && (payload === null || typeof payload !== 'object' || Array.isArray(payload))) {
          payloadErrEl.textContent = t.errPayloadObject;
          payloadOk = false;
        }
        if (!headerOk || !payloadOk) {
          if (!headerOk) headerDetails.open = true;
          resultWrap.style.display = 'none';
          return;
        }

        statusEl.textContent = t.generating;

        if (!secretStr) {
          secretWarnEl.textContent = t.errEmptySecret;
          resultWrap.style.display = 'none';
          statusEl.textContent = '';
          statusEl.className = 'jg-status';
          return;
        }

        var keyBytes = decodeSecret(secretStr, currentFmt);
        if (!keyBytes) {
          secretWarnEl.textContent = t.errBase64Secret;
          resultWrap.style.display = 'none';
          statusEl.textContent = '';
          return;
        }
        if (keyBytes.length === 0) {
          secretWarnEl.textContent = t.errEmptyKey;
          resultWrap.style.display = 'none';
          statusEl.textContent = '';
          return;
        }
        var minBytes = minKeyBytes(currentAlgo);
        if (keyBytes.length < minBytes) {
          secretWarnEl.textContent = t.warnShortKey
            .replace('{bytes}', keyBytes.length).replace('{min}', minBytes).replace('{algo}', currentAlgo);
        }

        try {
          var token = await signJwt(headerStr, payloadStr, keyBytes, currentAlgo, crypto.subtle);
          if (current !== generation) return;
          resultEl.textContent = token;
          resultWrap.style.display = '';
          resultPane.setAttribute('data-empty', 'false');
          statusEl.textContent = t.generated;
          statusEl.className = 'jg-status success';
          maybeTrack();
        } catch (e) {
          if (current !== generation) return;
          console.error(e);
          statusEl.textContent = t.errSign;
          statusEl.className = 'jg-status error';
          resultWrap.style.display = 'none';
        }
      }

      headerEl.addEventListener('input', scheduleGenerate);
      payloadEl.addEventListener('input', scheduleGenerate);
      secretEl.addEventListener('input', scheduleGenerate);
      headerEl.addEventListener('change', commitEdit);
      payloadEl.addEventListener('change', commitEdit);
      secretEl.addEventListener('change', commitEdit);

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var root = document.querySelector('.jg-wrap');
        if (!root || !root.contains(document.activeElement)) return;
        e.preventDefault();
        if (resultPane.contains(document.activeElement)) payloadEl.focus();
        generation++;
        clearTimeout(debounceTimer);
        debounceTimer = null;
        trackWanted = false;
        lastTracked = null;
        headerEl.value = payloadEl.value = secretEl.value = '';
        clearOutput();
      });

      copyBtn.addEventListener('click', function () {
        var val = resultEl.textContent;
        if (!val) return;
        invalidateCopy();
        var revision = copyRevision;
        function done() {
          if (revision !== copyRevision) return;
          copyBtn.textContent = t.copied;
          copyTimer = setTimeout(function () {
            if (revision === copyRevision) copyBtn.textContent = t.copy;
          }, 1500);
        }
        function failed() {
          if (revision !== copyRevision) return;
          statusEl.textContent = t.copyFail;
          statusEl.className = 'jg-status error';
          copyError = true;
        }
        function fallback() {
          if (revision !== copyRevision) return;
          if (fallbackCopy(val)) done(); else failed();
        }
        try {
          navigator.clipboard.writeText(val).then(done, fallback);
        } catch (e) { fallback(); }
      });

      // Auto-generate on load
      generate();
    })();
  </script>
</div>

