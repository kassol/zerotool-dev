    secretFormat: 'Secret format',
    empty: 'Enter valid Header and Payload JSON and a secret to see a signed token.',
    tips: {
      algorithm: 'Choose HS256, HS384 or HS512. Selecting an algorithm updates alg in a JSON object Header. A manually edited alg must match the selection. Changes trigger signing after 0.5 seconds.',
      header: 'Expand Header to edit its JSON. Its alg must match the selected algorithm. Outer whitespace is trimmed before signing; line breaks and indentation inside the Header and Payload are preserved.',
      payload: 'Enter a valid JSON object. Claims such as iat, exp and nbf stay as written; this tool does not add or check timestamps. Editing a field signs a new token after 0.5 seconds.',
      secret: 'Use a test secret. Key length is measured after UTF-8 encoding or Base64 decoding. HS256, HS384 and HS512 require at least 32, 48 and 64 bytes respectively. Shorter keys still sign and show a warning.',
      format: 'UTF-8 uses the entered text as key bytes. Base64 decodes the key first; standard and URL-safe alphabets are accepted, whitespace is ignored and padding is optional.',
      copy: 'Copy copies the entire current token. Empty or invalid input clears the previous token. Ctrl+L (⌘+L on Mac) inside the tool clears all three fields and results, keeping the algorithm and secret format.',
    },
  },
  zh: {
    algorithm: '算法', headerLabel: 'Header', payloadLabel: 'Payload',
    secretLabel: '密钥', secretPlaceholder: '你的 256 位密钥',
    generatedToken: '生成的 Token', copy: '复制', copied: '已复制！',
    generating: '正在生成...', generated: 'Token 已生成。',
    errHeaderAlgo: 'Header 的 alg 必须与所选算法（{algo}）一致。',
    copyFail: '复制失败。请重试，或选中 Token 后手动复制。',
    errHeaderJson: 'Header 不是有效的 JSON。', errPayloadJson: 'Payload 不是有效的 JSON。',
    errBase64Secret: '密钥不是有效的 Base64。',
    errEmptySecret: '请输入密钥以生成签名 Token。',
    errEmptyKey: 'Base64 密钥解码后为 0 字节。请输入密钥内容后再签名。',
    errPayloadObject: 'Payload 必须是 JSON 对象，例如 {"sub": "42"}。RFC 7519 要求声明集是对象。',
    errSign: '浏览器未能签名 Token。修改任一字段后会重试。',
    warnShortKey: '密钥只有 {bytes} 字节；RFC 7518 要求 {algo} 至少 {min} 字节。Token 照常签名，但这个密钥太短，不宜使用。',
    privacyNote: '所有处理均在浏览器本地完成。',
    secretFormat: '密钥格式',
    empty: '输入有效的 Header、Payload JSON 和密钥后，这里会显示签名后的 Token。',
