        if (raw.hasAuthority) {
          var rawHost = raw.host;
          var lower = rawHost.toLowerCase();
          if (res.hostType === 'ipv4' && lower !== url.hostname) note('ipv4', { raw: rawHost, host: url.hostname }, 'warn');
          else if (res.hostType === 'ipv6' && lower !== url.hostname) note('ipv6', { raw: rawHost, host: url.hostname });
          else if (res.hostType === 'domain' && lower !== url.hostname && rawHost !== uni.unicode) note('hostChanged', { raw: rawHost, host: url.hostname });
          if (raw.port !== null && url.port === '' && res.special) note('defaultPort', { raw: raw.port, port: res.defaultPort });
          else if (raw.port !== null && raw.port !== url.port) note('portChanged', { raw: raw.port, port: url.port });
        }
        var segs = raw.path.split(raw.special ? /[\/\\]/ : /\//);
        if (segs.some(function (s) { return /^(\.|%2e){1,2}$/i.test(s); }) && raw.path !== url.pathname) {
          note('dotSegments', { raw: raw.path, path: url.pathname });
        }
        var list = encodedChars(raw.hasAuthority || raw.path.charAt(0) === '/' ? raw.path : '', 'path', url.protocol)
          .concat(encodedChars(raw.query, 'query', url.protocol))
          .concat(encodedChars(raw.fragment, 'fragment', url.protocol));
        var seenCh = {};
        list = list.filter(function (x) { if (seenCh[x.ch]) return false; seenCh[x.ch] = 1; return true; });
        if (list.length) note('encoded', { list: list });
        /* An RFC 3986 parser reads the authority with Appendix B; compare the host it gets. */
        if (raw.hasAuthority && rfc.authority !== null) {
          var same;
          try { same = new URL(url.protocol + '//' + rfc.host + '/').hostname === url.hostname; } catch (e) { same = false; }
          if (!same) note('rfcHost', { rfcHost: rfc.host, host: url.hostname }, 'warn');
        } else if (raw.hasAuthority && url.hostname !== '') {
          note('rfcNoAuthority', { host: url.hostname });
        }
      }
      var badPct = /%(?![0-9A-Fa-f]{2})/.exec(text);
      if (badPct) note('badPercent', { pos: cpPos(text, badPct.index) }, 'warn');
      if (res.params.some(function (p) { return p.badUtf8; }) || res.segments.some(function (s) { return s.badUtf8; }) || (fragment && fragment.badUtf8)) {
        note('badUtf8', {}, 'warn');
      }
      if (res.params.some(function (p) { return p.semicolon; })) note('semicolon');
      return res;
    }

    /* JSON summary of a successful analysis (Copy as JSON). */
    function toJson(res) {
      var obj = {};
      FIELDS.forEach(function (f) { obj[f] = res.fields[f]; });
      if (res.hostUnicode !== res.fields.hostname) obj.hostnameUnicode = res.hostUnicode;
      obj.effectivePort = res.effectivePort;
      obj.pathSegments = res.segments.map(function (s) { return s.text; });
      obj.query = res.params.map(function (p) { return [p.key, p.value]; });
      obj.fragment = res.fragmentText;
      return JSON.stringify(obj, null, 2);
    }
    /* ── engine:end ── */

    var MAX_PARAMS = 500;
    var $ = function (id) { return document.getElementById(id); };
    var inputEl = $('up-input');
    var baseBox = $('up-base-box');
    var baseEl = $('up-base');
    var statusEl = $('up-status');
    var suggestBtn = $('up-suggest');
    var notesEl = $('up-notes');
    var resultsEl = $('up-results');
    var hrefEl = $('up-href');
    var paramsEl = $('up-params');
    var queryTitle = $('up-query-title');
    var queryNote = $('up-query-note');
    var segSection = $('up-seg-section');
    var segTitle = $('up-seg-title');
    var segList = $('up-segments');
    var rfcSummary = $('up-rfc-summary');
    var rfcParts = $('up-rfc-parts');
    var revealBtn = $('up-reveal');
    var current = null;
    var editMessage = null;
    var suggestion = null;
    var trackTimer = null;

    function fmt(s, vars) {
      return String(s).replace(/\{(\w+)\}/g, function (m, k) { return vars && vars[k] !== undefined ? vars[k] : m; });
    }
    function el(tag, cls, text) {
      var e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    }
    function showChar(ch) { return ch === ' ' ? S.space : ch; }

    function copyText(text, btn) {
      function done(ok) {
        if (!ok) { setStatus(S.copyFailed, 'error'); return; }
        btn.textContent = S.copied;
        setTimeout(function () { btn.textContent = btn.getAttribute('data-label') || S.copy; }, 1500);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(fallbackCopy(text)); });
      } else {
        done(fallbackCopy(text));
      }
    }
    function fallbackCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      document.body.removeChild(ta);
      return ok;
    }

    function setStatus(text, kind) {
      statusEl.textContent = text;
      statusEl.className = 'tool-status ' + kind;
    }

    function noteText(n) {
      var d = n.data;
      if (n.code === 'encoded') {
        return fmt(S.notes.encoded, { list: d.list.slice(0, 8).map(function (x) { return '“' + showChar(x.ch) + '” → ' + x.enc; }).join(', ') + (d.list.length > 8 ? ' …' : '') });
      }
      return fmt(S.notes[n.code], d);
    }

    function renderNotes(res) {
      notesEl.textContent = '';
      var sorted = res.notes.filter(function (n) { return n.level === 'warn'; }).concat(res.notes.filter(function (n) { return n.level !== 'warn'; }));
      sorted.forEach(function (n) {
        var li = el('li', 'up-note up-note--' + n.level, noteText(n));
        if (n.code === 'schemeLooksLikeHost') {
          var b = el('button', 'btn-ghost btn-sm up-note-btn', fmt(S.parseAs, { url: n.data.suggestion }));
          b.type = 'button';
          b.addEventListener('click', function () { inputEl.value = n.data.suggestion; render(); });
          li.appendChild(b);
        }
        notesEl.appendChild(li);
      });
      notesEl.hidden = sorted.length === 0;
    }

    function renderFields(res) {
      var f = res.fields;
      hrefEl.textContent = f.href;
      document.querySelectorAll('#up-wrap .up-value').forEach(function (inp) {
        var field = inp.getAttribute('data-field');
        if (document.activeElement !== inp) inp.value = f[field];
        var row = inp.closest('.up-row');
        row.classList.toggle('up-row--empty', f[field] === '' || (field === 'origin' && f[field] === 'null'));
        var sub = row.querySelector('[data-sub]');
        var subText = '';
        if (field === 'hostname' && res.hostUnicode !== f.hostname) subText = fmt(S.unicodeHost, { host: res.hostUnicode });
        if (field === 'hash' && f.hash && res.fragmentText !== f.hash.slice(1)) subText = fmt(S.decodedHash, { text: res.fragmentText });
        sub.textContent = subText;
        sub.hidden = subText === '';
        if (field === 'port') inp.placeholder = res.defaultPort ? fmt(S.portDefault, { port: res.defaultPort }) : S.portNone;
      });
    }

    function badge(text, warn) { return el('span', 'up-badge' + (warn ? ' up-badge--warn' : ''), text); }

    function applyQuery(pairs) {
      var q = serializeQuery(pairs);
      var r = setComponent(current.fields.href, 'search', q ? '?' + q : '');
      inputEl.value = r.href;
      render();
    }

    function paramRow(p, index, isNew) {
      var row = el('div', 'up-param' + (isNew ? ' up-param--new' : ''));
      var num = el('span', 'up-param-num', isNew ? '+' : String(index + 1));
      row.appendChild(num);
      var keyIn = el('input', 'up-param-input up-param-key');
      var valIn = el('input', 'up-param-input up-param-val');
      [keyIn, valIn].forEach(function (inp) {
        inp.type = 'text';
        inp.spellcheck = false;
        inp.setAttribute('autocomplete', 'off');
        inp.setAttribute('autocapitalize', 'off');
      });
      keyIn.value = isNew ? '' : p.key;
      valIn.value = isNew ? '' : p.value;
      keyIn.placeholder = S.key;
      valIn.placeholder = S.value;
      keyIn.setAttribute('aria-label', S.key + ' ' + (index + 1));
      valIn.setAttribute('aria-label', S.value + ' ' + (index + 1));
      var committed = false;
      /* Commit when Enter is pressed or focus leaves the row, so key and value can both be
         edited before the URL is rebuilt. */
      function commit() {
        if (committed) return;
        var pairs = current.params.map(function (x) { return Object.assign({}, x); });
        if (isNew) {
          addingParam = false;
          if (keyIn.value === '' && valIn.value === '') { renderParams(current); return; }
          pairs.push({ key: keyIn.value, value: valIn.value, edited: true });
        } else {
          if (keyIn.value === p.key && valIn.value === p.value) return;
          pairs[index].key = keyIn.value;
          pairs[index].value = valIn.value;
          pairs[index].edited = true;
        }
        committed = true;
        applyQuery(pairs);
      }
      row.addEventListener('focusout', function (e) {
        if (!e.relatedTarget || !row.contains(e.relatedTarget)) commit();
      });
      [keyIn, valIn].forEach(function (inp) {
        inp.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') { e.preventDefault(); commit(); }
          if (e.key === 'Escape') { keyIn.value = isNew ? '' : p.key; valIn.value = isNew ? '' : p.value; }
        });
      });
      var cells = el('div', 'up-param-cells');
      cells.appendChild(keyIn);
      cells.appendChild(valIn);
      if (!isNew) {
        var meta = el('div', 'up-param-meta');
        if (p.raw !== p.key + (p.hasEq ? '=' : '') + p.value) meta.appendChild(el('code', 'up-param-raw', fmt(S.rawLabel, { raw: p.raw })));
        if (p.plus) meta.appendChild(badge(S.flagPlus));
        if (!p.hasEq) meta.appendChild(badge(S.flagNoEq));
        if (p.total > 1) meta.appendChild(badge(fmt(S.flagRepeat, { i: p.occurrence, n: p.total })));
        if (p.badPercent) meta.appendChild(badge(S.flagBadPercent, true));
        if (p.badUtf8) meta.appendChild(badge(S.flagBadUtf8, true));
        if (meta.childNodes.length) cells.appendChild(meta);
      }
      row.appendChild(cells);
      var actions = el('div', 'up-param-btns');
      if (!isNew) {
        var copy = el('button', 'btn-copy', S.copy);
        copy.type = 'button';
        copy.addEventListener('click', function () { copyText(p.value, copy); });
        var rm = el('button', 'btn-ghost btn-sm up-param-rm', '×');
        rm.type = 'button';
        rm.title = S.remove;
        rm.setAttribute('aria-label', fmt(S.removeAria, { n: index + 1 }));
        rm.addEventListener('click', function () {
          var pairs = current.params.map(function (x) { return Object.assign({}, x); });
          pairs[index].removed = true;
          applyQuery(pairs);
        });
        actions.appendChild(copy);
        actions.appendChild(rm);
      }
      row.appendChild(actions);
      return row;
    }

    var addingParam = false;
    function renderParams(res) {
      paramsEl.textContent = '';
      var n = res.params.length;
      queryTitle.textContent = fmt(S.queryTitle, { n: n });
      var shown = Math.min(n, MAX_PARAMS);
      for (var i = 0; i < shown; i++) paramsEl.appendChild(paramRow(res.params[i], i, false));
      if (addingParam) {
        var nr = paramRow(null, n, true);
        paramsEl.appendChild(nr);
      }
      if (n === 0 && !addingParam) { queryNote.textContent = S.queryEmpty; queryNote.hidden = false; }
      else if (n > MAX_PARAMS) { queryNote.textContent = fmt(S.queryLimit, { shown: MAX_PARAMS, n: n }); queryNote.hidden = false; }
      else queryNote.hidden = true;
    }

    function renderSegments(res) {
      segList.textContent = '';
      segSection.hidden = res.segments.length === 0;
      segTitle.textContent = fmt(S.segmentsTitle, { n: res.segments.length });
      res.segments.forEach(function (s) {
        var li = el('li', 'up-seg');
        li.appendChild(el('code', 'up-seg-text', s.text === '' ? '∅' : s.text));
        if (s.raw !== s.text) li.appendChild(el('code', 'up-param-raw', fmt(S.rawLabel, { raw: s.raw })));
        if (s.encodedSlash) li.appendChild(badge(S.flagSlash, true));
        if (s.badUtf8) li.appendChild(badge(S.flagBadUtf8, true));
        segList.appendChild(li);
      });
    }

    function renderRfc(res) {
      var e = res.rfc.error;
      rfcSummary.textContent = S.rfcTitle + ' · ' + (e ? fmt(S.rfcInvalid, { reason: S.rfcReasons[e.reason], pos: e.pos, ch: showChar(e.ch) }) : S.rfcValid);
      rfcParts.textContent = '';
      var sp = res.rfc.split;
      ['scheme', 'authority', 'userinfo', 'host', 'port', 'path', 'query', 'fragment'].forEach(function (k) {
        rfcParts.appendChild(el('dt', '', S.rfcParts[k]));
        var v = sp[k];
        rfcParts.appendChild(el('dd', v === null ? 'up-muted' : '', v === null ? S.rfcAbsent : (v === '' ? '""' : v)));
      });
    }

    function render() {
      var res = analyze(inputEl.value, baseEl.value);
      current = res;
      suggestion = null;
      suggestBtn.hidden = true;
      if (!res.ok) {
        resultsEl.hidden = true;
        notesEl.hidden = true;
        notesEl.textContent = '';
        addingParam = false;
        if (res.error.code === 'empty') { setStatus('', 'none'); return; }
        var err = res.error;
        setStatus(fmt(S.errors[err.code], { detail: showChar(err.detail || ''), scheme: err.scheme || '' }), 'error');
        if (err.suggestion) {
          suggestion = err.suggestion;
          suggestBtn.textContent = fmt(S.parseAs, { url: err.suggestion });
          suggestBtn.hidden = false;
        }
        if (err.code === 'relative' || err.code === 'schemeRelative') baseBox.open = true;
        return;
      }
      setStatus(editMessage || (res.usedBase ? S.okBase : S.ok), editMessage ? 'info' : 'success');
      editMessage = null;
      renderNotes(res);
      renderFields(res);
      renderParams(res);
      renderSegments(res);
      renderRfc(res);
      resultsEl.hidden = false;
      clearTimeout(trackTimer);
      trackTimer = setTimeout(function () { window.trackTool && window.trackTool('url-parser', 'parse'); }, 1500);
    }

    function applyField(field, value) {
      if (!current || !current.ok) return;
      if (value === current.fields[field]) return;
      var r = setComponent(current.fields.href, field, value);
      if (r.status === 'ignored') editMessage = fmt(S.editIgnored, { field: S.fields[field], value: value });
      else if (r.status === 'adjusted') editMessage = fmt(S.editAdjusted, { field: S.fields[field], value: value, actual: r.actual });
      inputEl.value = r.href;
      render();
    }

    inputEl.addEventListener('input', function () { addingParam = false; render(); });
    baseEl.addEventListener('input', render);
    document.querySelectorAll('#up-wrap .up-value').forEach(function (inp) {
      if (inp.readOnly) return;
      inp.addEventListener('change', function () { applyField(inp.getAttribute('data-field'), inp.value); });
      inp.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); applyField(inp.getAttribute('data-field'), inp.value); }
        if (e.key === 'Escape' && current && current.ok) { inp.value = current.fields[inp.getAttribute('data-field')]; }
      });
    });
    document.querySelectorAll('#up-wrap [data-copy]').forEach(function (btn) {
      btn.setAttribute('data-label', btn.textContent);
      btn.addEventListener('click', function () {
        if (current && current.ok) copyText(current.fields[btn.getAttribute('data-copy')], btn);
      });
    });
    var jsonBtn = $('up-copy-json');
    jsonBtn.setAttribute('data-label', jsonBtn.textContent);
    jsonBtn.addEventListener('click', function () { if (current && current.ok) copyText(toJson(current), jsonBtn); });
    $('up-add').addEventListener('click', function () {
      if (!current || !current.ok) return;
      addingParam = true;
      renderParams(current);
      var inputs = paramsEl.querySelectorAll('.up-param--new input');
      if (inputs.length) inputs[0].focus();
    });
    revealBtn.addEventListener('click', function () {
      var pw = $('up-f-password');
      var showing = pw.type === 'text';
      pw.type = showing ? 'password' : 'text';
      revealBtn.textContent = showing ? S.show : S.hide;
      revealBtn.setAttribute('aria-pressed', showing ? 'false' : 'true');
    });
    suggestBtn.addEventListener('click', function () {
      if (!suggestion) return;
      inputEl.value = suggestion;
      render();
    });
    $('up-example').addEventListener('click', function () {
      inputEl.value = S.exampleUrl;
      baseEl.value = '';
      render();
    });
    $('up-clear').addEventListener('click', function () {
      inputEl.value = '';
      baseEl.value = '';
      render();
      inputEl.focus();
    });
    /* ToolLayout clears text inputs on Ctrl/⌘+L; re-render once it has. */
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L')) setTimeout(render, 0);
    });
    if (inputEl.value) render();
  })();
</script>

<style>
  .up-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; min-height: 0; }
  .up-start { display: flex; flex-direction: column; gap: 0.6rem; }
  @media (min-width: 861px) {
    .up-wrap:has(#up-results[hidden]) .up-result-empty { flex: 1 1 0; display: flex; align-items: center; justify-content: center; min-height: 220px; padding: 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-secondary); text-align: center; }
  }
  .up-label-row { display: flex; align-items: center; gap: 0.3rem; min-width: 0; }
  .up-result-empty { margin: 0; font-size: 0.88rem; color: var(--color-text-muted); }
  .up-wrap:has(#up-results:not([hidden])) .up-result-empty { display: none; }
  .up-wrap [hidden] { display: none !important; }

  .up-input-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .up-input-head .tool-label { margin: 0; }
  .up-head-btns { display: flex; gap: 0.4rem; flex-wrap: nowrap; }

  .up-input { height: 80px; min-height: 80px; resize: none; word-break: break-all; }

  .up-base { min-width: 0; }
  .up-base-label { display: inline-flex; align-items: center; gap: 0.3rem; vertical-align: middle; }

  .up-base summary {
    cursor: pointer;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    width: fit-content;
  }
  .up-base .tool-input { margin-top: 0.4rem; width: 100%; }

  .up-status-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; min-height: 44px; }
  #up-suggest { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
  .up-status-row .tool-status { margin: 0; overflow-wrap: anywhere; }

  .up-notes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .up-notes :global(.up-note) {
    font-size: 0.82rem;
    line-height: 1.45;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
    overflow-wrap: anywhere;
    background: color-mix(in oklch, var(--color-primary) 7%, transparent);
    color: var(--color-text);
  }
  .up-notes :global(.up-note--warn) {
    background: color-mix(in oklch, var(--color-danger) 9%, transparent);
    color: var(--color-danger);
  }
  .up-notes :global(.up-note-btn) { margin-left: 0.5rem; }

  .up-results { display: flex; flex: 1 1 0; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 300px; overflow: auto; }
  .up-results > * { flex: 0 0 auto; }

  .up-href {
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }
  .up-href-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .up-href-label { font-size: 0.78rem; font-weight: 700; color: var(--color-text-secondary); }
  .up-href-text {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    word-break: break-all;
    background: none;
    padding: 0;
  }

  .up-hint { margin: 0; font-size: 0.78rem; color: var(--color-text-muted); }

  .up-fields {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
    overflow: hidden;
  }
  .up-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.6rem;
    border-top: 1px solid var(--color-border-light);
  }
  .up-row:first-child { border-top: 0; }
  .up-field { margin: 0; font-size: 0.8rem; font-weight: 600; color: var(--color-text-secondary); }
  .up-cell { display: flex; flex-direction: column; min-width: 0; }
  .up-wrap .up-value {
    width: 100%;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    padding: 0.3rem 0.45rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text);
  }
  .up-wrap .up-value:not([readonly]):hover { border-color: var(--color-border); }
  .up-wrap .up-value:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); box-shadow: 0 0 0 3px color-mix(in oklch, var(--color-primary) 18%, transparent); }
  .up-wrap .up-value[readonly] { color: var(--color-text-secondary); }
  .up-row--empty .up-field { color: var(--color-text-muted); }
  .up-sub { font-size: 0.76rem; color: var(--color-text-muted); padding: 0 0.45rem; overflow-wrap: anywhere; }
  .up-row-btns { display: flex; gap: 0.3rem; align-items: center; }

  .up-section { display: flex; flex-direction: column; gap: 0.45rem; min-width: 0; }
  .up-section-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .up-section-title { margin: 0; font-family: var(--font-sans); font-size: 0.88rem; font-weight: 700; color: var(--color-text-secondary); }
  .up-muted { margin: 0; font-size: 0.82rem; color: var(--color-text-muted); }

  .up-params { display: flex; flex-direction: column; gap: 0.4rem; }
  .up-params :global(.up-param) {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: start;
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
