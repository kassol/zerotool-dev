const L = STRINGS[lang];
const { tips: TIPS, ...CLIENT_L } = L;
const F = L.fields;
const ROWS: Array<{ field: string; editable: boolean }> = [
  { field: 'protocol', editable: true },
  { field: 'hostname', editable: true },
  { field: 'port', editable: true },
  { field: 'pathname', editable: true },
  { field: 'search', editable: false },
  { field: 'hash', editable: true },
  { field: 'username', editable: true },
  { field: 'password', editable: true },
  { field: 'host', editable: false },
  { field: 'origin', editable: false },
];
---
<div class="up-wrap" id="up-wrap">
  <div class="up-start">
  <div class="up-input-head">
    <div class="up-label-row"><label class="tool-label" for="up-input">{L.label}</label><Toggletip id="up-tip-input" lang={lang} about={L.label} wide>{TIPS.input}</Toggletip></div>
    <div class="up-head-btns">
      <button id="up-example" class="btn-ghost btn-sm" type="button">{L.example}</button>
      <button id="up-clear" class="btn-ghost btn-sm" type="button">{L.clear}</button>
    </div>
  </div>
  <details id="up-base-box" class="up-base">
    <summary><span class="up-base-label">{L.baseSummary}<Toggletip id="up-tip-base" lang={lang} about={L.baseSummary} wide>{TIPS.base}</Toggletip></span></summary>
    <input id="up-base" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" placeholder={L.basePlaceholder} aria-label={L.baseSummary} />
  </details>
  <div class="up-status-row">
    <p id="up-status" class="tool-status none" role="status" aria-live="polite"></p>
    <button id="up-suggest" class="btn-secondary btn-sm" type="button" hidden></button>
  </div>
  <textarea
    id="up-input"
    class="tool-textarea up-input"
    rows="2"
    spellcheck="false"
    autocapitalize="off"
    autocorrect="off"
    autocomplete="off"
    placeholder={L.placeholder}
  ></textarea>
  </div>
  <p class="up-result-empty">{L.resultEmpty}</p>

  <div id="up-results" class="up-results" hidden>
    <div class="up-href">
      <div class="up-href-head">
        <div class="up-label-row"><span class="up-href-label">{L.normalized}</span><Toggletip id="up-tip-normalized" lang={lang} about={L.normalized} wide>{TIPS.normalized}</Toggletip></div>
        <button class="btn-copy" type="button" data-copy="href">{L.copy}</button>
      </div>
      <code id="up-href" class="up-href-text"></code>
    </div>
    <ul id="up-notes" class="up-notes" hidden></ul>

    <div class="up-label-row"><p class="up-hint">{L.editHint}</p><Toggletip id="up-tip-fields" lang={lang} about={L.fieldsLabel} wide>{TIPS.fields}</Toggletip></div>
    <div class="up-fields" role="group" aria-label={L.normalized}>
      {ROWS.map(({ field, editable }) => (
        <div class="up-row" data-row={field}>
          <label class="up-field" for={`up-f-${field}`}>{F[field as keyof typeof F]}</label>
          <div class="up-cell">
            <input
              id={`up-f-${field}`}
              class="up-value"
              data-field={field}
              type={field === 'password' ? 'password' : 'text'}
              readonly={!editable}
              spellcheck="false"
              autocapitalize="off"
              autocorrect="off"
              autocomplete="off"
              data-1p-ignore
              data-lpignore="true"
              title={editable ? undefined : L.readOnly}
            />
            <span class="up-sub" data-sub={field} hidden></span>
          </div>
          <div class="up-row-btns">
            {field === 'password' && <button id="up-reveal" class="btn-ghost btn-sm" type="button" aria-pressed="false">{L.show}</button>}
            <button class="btn-copy" type="button" data-copy={field}>{L.copy}</button>
          </div>
        </div>
      ))}
    </div>

    <section class="up-section">
      <div class="up-section-head">
