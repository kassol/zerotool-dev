---
// UrlParserTool — splits a URL with the browser's own parser (WHATWG URL Standard), explains
// what the parser changed, compares the host with an RFC 3986 reading, decodes the query with
// the application/x-www-form-urlencoded rules and lets the user edit components and parameters.
// Nothing is stored or sent: no ztPersist, no network requests. A password in the URL is
// masked until the user reveals it.
import Toggletip from '../Toggletip.astro';

