      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.5rem 0.6rem;
      background: var(--color-bg-secondary);
      border-radius: var(--radius-md);
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
      flex-wrap: wrap;
    }
    .csp-hash-value {
      flex: 1;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--color-text);
      word-break: break-all;
      min-width: 0;
    }

    .csp-tab-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin-bottom: 0.6rem;
    }
    .csp-tab {
      min-height: 32px;
      padding: 0.3rem 0.85rem;
      border: 0;
      border-radius: var(--radius-pill);
      background: transparent;
      color: var(--color-text-secondary);
      font-weight: 700;
      font-size: 0.8rem;
      cursor: pointer;
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
      transition: background-color var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast);
    }
    @media (hover: hover) {
      .csp-tab:hover:not(.is-active) { color: var(--color-text); }
    }
    .csp-tab.is-active {
      background: var(--color-primary-light);
      color: var(--color-primary);
      box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-primary) 45%, transparent);
    }

    .csp-output { display: flex; flex-direction: column; gap: 0.6rem; flex: 1; min-width: 0; min-height: 0; }
    .csp-output-panel {
      flex: 1; min-width: 0; min-height: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .csp-output-pre {
      margin: 0;
      padding: 0.85rem 0.95rem;
      background: var(--color-surface);
      color: var(--color-text);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      line-height: 1.55;
      border-radius: var(--radius-md);
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      max-width: 100%;
      overflow: auto;
      flex: 1 1 0;
      min-height: 120px;
    }

    .csp-validation {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      max-height: 12rem;
      overflow: auto;
      flex: none;
    }
    .csp-validation-item {
      padding: 0.5rem 0.7rem;
      border-radius: var(--radius-md);
      font-size: 0.85rem;
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
      background: var(--color-bg-secondary);
    }
    .csp-validation-item.is-warn {
      color: var(--color-danger);
      box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-danger) 45%, transparent);
      background: color-mix(in oklch, var(--color-danger) 8%, var(--color-bg-secondary));
    }
    .csp-validation-item.is-info {
      color: var(--color-text-secondary);
    }

    @media (max-width: 860px) {
      .csp-body { display: flex; flex-direction: column; flex: none; }
      .csp-rail { overflow: visible; }
      .csp-editor-area { flex: none; overflow: visible; }
      .csp-directive-grid { max-height: 16rem; overflow: auto; }
      .csp-result[data-empty="true"] { display: none; }
      .csp-output, .csp-output-panel { flex: none; }
      .csp-output-pre { flex: none; height: 22rem; }
    }
    @media (max-width: 640px) {
      .csp-settings { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.6rem; }
      .csp-rail { gap: 0.6rem; }
      .csp-actions button, .csp-select, .csp-source-input, #csp-hash-input, #csp-hash-add, #csp-hash-copy { min-height: 44px; }
      .csp-mode-toggle { flex-wrap: wrap; }
      .csp-mode-btn, .csp-tab, .csp-directive-remove, .csp-source-add-btn, .csp-keyword-chip, .csp-section-summary, .csp-flag { min-height: 24px; min-width: 24px; }
      .csp-directive-grid { max-height: 9rem; }
      .csp-hash-actions { margin-left: 0; width: 100%; }
      .csp-hash-actions .btn-primary { width: 100%; }
      .csp-output-pre { height: 20rem; font-size: 0.78rem; }

      .csp-source-remove {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
        min-height: 24px;
      }
