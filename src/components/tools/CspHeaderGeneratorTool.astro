    .csp-source-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.3rem 0.55rem;
      border-radius: var(--radius-pill);
      background: var(--color-surface-muted);
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--color-text);
      max-width: 100%;
    }
    .csp-source-tag-text {
      overflow-wrap: anywhere;
    }
    .csp-source-tag.is-keyword {
      color: var(--color-primary);
      box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-primary) 45%, transparent);
      background: var(--color-primary-light);
    }
    .csp-source-tag.is-hash,    .csp-source-tag.is-nonce {
      color: var(--color-accent);
      box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-accent) 45%, transparent);
    }
    .csp-source-remove {
      background: transparent;
      border: 0;
      color: inherit;
      cursor: pointer;
      font-size: 0.85rem;
      padding: 0;
      line-height: 1;
      opacity: 0.65;
    }
    @media (hover: hover) {
      .csp-source-remove:hover { opacity: 1; }
    }
    .csp-source-add-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      align-items: center;
    }
    .csp-source-input {
      flex: 1 1 140px;
      min-width: 0;
      min-height: 32px;
      padding: 0.32rem 0.6rem;
      border: 0;
      border-radius: var(--radius-md);
      background: var(--color-bg-secondary);
      color: var(--color-text);
      font-family: var(--font-mono);
      font-size: 0.8rem;
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
    }
    .csp-source-input:focus {
      outline: none;
      background: var(--color-surface);
      box-shadow: inset 0 0 0 1px var(--color-primary), 0 0 0 4px var(--color-primary-light);
    }
    .csp-source-add-btn {
      min-height: 32px;
      padding: 0.25rem 0.7rem;
      font-size: 0.78rem;
      border: 0;
      background: var(--color-surface-muted);
      color: var(--color-text-secondary);
      border-radius: var(--radius-pill);
      cursor: pointer;
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
      font-weight: 700;
      white-space: nowrap;
      transition: background-color var(--transition-fast), color var(--transition-fast);
    }
    @media (hover: hover) {
      .csp-source-add-btn:hover {
        color: var(--color-primary);
        box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-primary) 45%, transparent);
      }
    }
    .csp-keyword-pool {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
    }
    .csp-keyword-chip {
      background: transparent;
      border: 0;
      padding: 0.2rem 0.55rem;
      font-family: var(--font-mono);
      font-size: 0.74rem;
      color: var(--color-text-muted);
      border-radius: var(--radius-pill);
      cursor: pointer;
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
      transition: color var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
    }
    @media (hover: hover) {
      .csp-keyword-chip:hover:not(:disabled) {
        color: var(--color-primary);
        background: var(--color-primary-light);
        box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-primary) 45%, transparent);
      }
    }
    .csp-keyword-chip:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .csp-pool-row {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .csp-pool-label {
      font-size: 0.72rem;
      color: var(--color-text-muted);
      font-weight: 700;
    }

    .csp-add-row {
      display: flex;
      gap: 0.6rem;
      align-items: flex-end;
      flex-wrap: wrap;
    }

    .csp-flag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      flex-direction: column;
      padding: 0.4rem 0.2rem 0;
      font-size: 0.85rem;
    }
    .csp-flag {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      cursor: pointer;
      color: var(--color-text-secondary);
      font-family: var(--font-mono);
    }

    .csp-section-summary {
      cursor: pointer;
      list-style: none;
      font-weight: 700;
      color: var(--color-text);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
