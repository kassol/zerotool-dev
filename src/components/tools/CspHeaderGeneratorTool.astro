      content: '';
      width: 8px;
      height: 8px;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(-45deg);
      transition: transform var(--transition-fast);
    }
    details[open] > .csp-section-summary::after {
      transform: rotate(45deg);
    }
    .csp-section-body {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      padding-top: 0.7rem;
    }
    .csp-hash-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: flex-end;
    }
    .csp-hash-actions { margin-left: auto; }
