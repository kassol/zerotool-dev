            });
            /* Earlier versions offered 'script' for trusted-types too; it is valid only in
               require-trusted-types-for (Trusted Types §4.2). An empty value means "no
               policies", so keep that meaning with 'none'. */
            var tt = state.directives['trusted-types'];
            if (tt && tt.indexOf("'script'") >= 0) {
              tt = tt.filter(function (src) { return src !== "'script'"; });
              state.directives['trusted-types'] = tt.length ? tt : ["'none'"];
              removedTtScript = true;
            }
          }
          if (typeof data.preset === 'string' && PRESETS[data.preset]) state.preset = data.preset;
          if (data.mode === 'enforce' || data.mode === 'report-only') state.mode = data.mode;
          /* Nothing saved yet (first visit): keep the preset's flags. */
          if (typeof data.upgrade === 'boolean') state.upgrade = data.upgrade;
          if (typeof data.block === 'boolean') state.block = data.block;
        }
      }

      // ── DOM refs ─────────────────────────────────────────────────────
      var presetSel = document.getElementById('csp-preset');
      var modeBtns = document.querySelectorAll('.csp-mode-btn');
      var resetBtn = document.getElementById('csp-reset');
      var directivesEl = document.getElementById('csp-directives');
      var addSelect = document.getElementById('csp-add-select');
      var addBtn = document.getElementById('csp-add-btn');
      var flagUpgrade = document.getElementById('csp-flag-upgrade');
      var flagBlock = document.getElementById('csp-flag-block');
      var hashInput = document.getElementById('csp-hash-input');
      var hashAlgo = document.getElementById('csp-hash-algo');
      var hashTarget = document.getElementById('csp-hash-target');
      var hashAddBtn = document.getElementById('csp-hash-add');
      var hashValueEl = document.getElementById('csp-hash-value');
      var hashCopyBtn = document.getElementById('csp-hash-copy');
      var tabBtns = document.querySelectorAll('.csp-tab');
      var outputEl = document.getElementById('csp-output');
      var copyBtn = document.getElementById('csp-copy');
      var validationEl = document.getElementById('csp-validation');

      // ── Renderers ────────────────────────────────────────────────────
      function renderAddSelect() {
        addSelect.innerHTML = '';
        DIRECTIVE_DEFS.forEach(function (d) {
          if (state.directives[d.name]) return;
          var opt = document.createElement('option');
          opt.value = d.name;
          opt.textContent = d.name;
          addSelect.appendChild(opt);
        });
        addBtn.disabled = addSelect.options.length === 0;
      }

      function classForSource(src) {
        if (/^'sha(256|384|512)-/.test(src)) return 'is-hash';
        if (/^'nonce-/.test(src)) return 'is-nonce';
        if (/^'[^']+'$/.test(src)) return 'is-keyword';
        return '';
      }

      function renderDirectives() {
        directivesEl.innerHTML = '';
        var names = Object.keys(state.directives);
        names.forEach(function (name) {
          var def = DIRECTIVE_INDEX[name] || { name: name, kind: 'fetch' };
          var card = document.createElement('div');
          card.className = 'csp-directive';
          card.dataset.directive = name;

          var head = document.createElement('div');
          head.className = 'csp-directive-head';
          var nameEl = document.createElement('span');
          nameEl.className = 'csp-directive-name';
          nameEl.textContent = name;
          var removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'csp-directive-remove';
          removeBtn.setAttribute('aria-label', T.removeDirective);
          removeBtn.textContent = '×';
          removeBtn.addEventListener('click', function () {
            delete state.directives[name];
            renderAll();
            update();
          });
          head.appendChild(nameEl);
          head.appendChild(removeBtn);
          card.appendChild(head);

          // Selected sources
          var sourceList = document.createElement('div');
          sourceList.className = 'csp-source-list';
          (state.directives[name] || []).forEach(function (src, idx) {
            var tag = document.createElement('span');
            tag.className = 'csp-source-tag ' + classForSource(src);
            var text = document.createElement('span');
            text.className = 'csp-source-tag-text';
            text.textContent = src;
            var rm = document.createElement('button');
            rm.type = 'button';
            rm.className = 'csp-source-remove';
            rm.setAttribute('aria-label', T.removeSource);
            rm.textContent = '×';
            rm.addEventListener('click', function () {
              state.directives[name].splice(idx, 1);
              renderAll();
              update();
            });
            tag.appendChild(text);
            tag.appendChild(rm);
            sourceList.appendChild(tag);
          });
          card.appendChild(sourceList);

          // Keyword pool
          var keywords = KEYWORDS_BY_KIND[def.kind] || [];
          if (keywords.length > 0) {
            var kwRow = document.createElement('div');
            kwRow.className = 'csp-pool-row';
            var kwLabel = document.createElement('span');
            kwLabel.className = 'csp-pool-label';
            kwLabel.textContent = def.kind === 'sandbox' ? U.sandboxTokens : T.poolKeywords;
            kwRow.appendChild(kwLabel);
            var kwPool = document.createElement('div');
            kwPool.className = 'csp-keyword-pool';
            keywords.forEach(function (kw) {
              var chip = document.createElement('button');
              chip.type = 'button';
              chip.className = 'csp-keyword-chip';
              chip.textContent = kw;
              if ((state.directives[name] || []).indexOf(kw) >= 0) chip.disabled = true;
              chip.addEventListener('click', function () {
                addSource(name, kw);
              });
              kwPool.appendChild(chip);
            });
            kwRow.appendChild(kwPool);
            card.appendChild(kwRow);
          }

          // Scheme pool (only fetch directives)
          if (def.kind === 'fetch') {
            var schRow = document.createElement('div');
            schRow.className = 'csp-pool-row';
            var schLabel = document.createElement('span');
            schLabel.className = 'csp-pool-label';
            schLabel.textContent = T.poolSchemes;
            schRow.appendChild(schLabel);
            var schPool = document.createElement('div');
            schPool.className = 'csp-keyword-pool';
            SCHEMES.forEach(function (s) {
              var chip = document.createElement('button');
              chip.type = 'button';
              chip.className = 'csp-keyword-chip';
              chip.textContent = s;
              if ((state.directives[name] || []).indexOf(s) >= 0) chip.disabled = true;
              chip.addEventListener('click', function () {
                addSource(name, s);
              });
              schPool.appendChild(chip);
            });
            schRow.appendChild(schPool);
            card.appendChild(schRow);
          }

          // Custom host / nonce / policy-name input (require-trusted-types-for has only 'script')
          if (def.kind !== 'ttRequire') {
            var hostRow = document.createElement('div');
            hostRow.className = 'csp-pool-row';
            var hostLabel = document.createElement('span');
            hostLabel.className = 'csp-pool-label';
            hostLabel.textContent = def.kind === 'report' ? U.reportTargets : def.kind === 'tt' ? U.ttPolicies : T.poolHosts;
            hostRow.appendChild(hostLabel);

            var addRow = document.createElement('div');
            addRow.className = 'csp-source-add-row';
            var input = document.createElement('input');
            input.type = 'text';
            input.className = 'csp-source-input';
            input.placeholder = def.kind === 'report' ? '/csp-reports' : def.kind === 'tt' ? 'my-policy' : T.inputPlaceholder;
            input.spellcheck = false;

            var addHostBtn = document.createElement('button');
            addHostBtn.type = 'button';
            addHostBtn.className = 'csp-source-add-btn';
            addHostBtn.textContent = T.addBtn;
            addHostBtn.addEventListener('click', function () {
              if (!input.value.trim()) return;
              /* A refused value stays in the box so it can be fixed; the status line says why. */
              if (!addSource(name, input.value.trim())) {
                input.setAttribute('aria-invalid', 'true');
                input.focus();
                return;
              }
              input.value = '';
              input.focus();
            });
            input.setAttribute('aria-describedby', 'csp-status');
            input.addEventListener('input', function () { input.removeAttribute('aria-invalid'); });
            input.addEventListener('keydown', function (ev) {
              if (ev.key === 'Enter') {
                ev.preventDefault();
                ev.stopPropagation();
                addHostBtn.click();
              }
            });
            addRow.appendChild(input);
            addRow.appendChild(addHostBtn);

            if (def.kind === 'fetch') {
              var nonceBtn = document.createElement('button');
              nonceBtn.type = 'button';
              nonceBtn.className = 'csp-source-add-btn';
              nonceBtn.textContent = T.addNonceBtn;
              nonceBtn.addEventListener('click', function () {
                addSource(name, NONCE_PLACEHOLDER);
              });
              addRow.appendChild(nonceBtn);
            }

            hostRow.appendChild(addRow);
            card.appendChild(hostRow);
          }

          directivesEl.appendChild(card);
        });
      }

      /* CSP3 §2.3.1: host-char is ALPHA / DIGIT / "-", so a host such as 日本語.jp or a
         full-width host is not a valid source. Convert the host with the URL parser
         (IDNA / punycode, NFKC) and percent-encode the path; return null if that fails. */
      function asciiSource(raw) {
        if (!/[^\x00-\x7f]/.test(raw)) return raw;
        /* CSP3 path-part is path-absolute: no query or fragment. The URL parser would drop
           them and resolve . / .. segments, so refuse instead of changing the value. */
        if (/[?#]/.test(raw) || /\/\.{1,2}(?:\/|$)/.test(raw)) return null;
        var m = /^([A-Za-z][A-Za-z0-9+.-]*:\/\/)?(\*\.)?([^\/:']+)(:(?:[0-9]+|\*))?(\/[^']*)?$/.exec(raw);
        if (!m) return null;
        try {
          var u = new URL('http://' + m[3] + (m[5] || '/'));
          var out = (m[1] || '') + (m[2] || '') + u.hostname + (m[4] || '') + (m[5] ? u.pathname : '');
          return /[^\x00-\x7f]/.test(out) ? null : out;
        } catch (e) { return null; }
      }

      var TT_POLICY_NAME = /^[A-Za-z0-9\-#=_\/@.%]+$/;

      function addSource(name, value) {
        var raw = String(value).trim();
        if (!raw) return true;
        if (raw.indexOf(';') >= 0) {
          showStatus(T.warnSemicolon, 'error');
          return false;
        }
        /* Whitespace (including U+3000 from an IME) separates sources in a policy. */
        var parts = raw.split(/\s+/), clean = [], converted = [];
        var kind = (DIRECTIVE_INDEX[name] || { kind: 'fetch' }).kind;
        /* Only host sources (fetch / navigation / document directives and report-uri URLs)
           are converted to punycode. Trusted Types policy names follow tt-policy-name
           (Trusted Types §4.2.2); sandbox tokens and report-to endpoint names stay as typed
           and must be ASCII. */
        var hostLike = kind === 'fetch' || kind === 'navigation' || kind === 'document' || name === 'report-uri';
        for (var i = 0; i < parts.length; i++) {
          if (kind === 'tt' && KEYWORDS_BY_KIND.tt.indexOf(parts[i]) < 0 && !TT_POLICY_NAME.test(parts[i])) {
            showStatus(U.ttNameInvalid + parts[i], 'error');
            return false;
          }
          var src = hostLike ? asciiSource(parts[i]) : (/[^\x00-\x7f]/.test(parts[i]) ? null : parts[i]);
          if (src === null) {
            showStatus(U.srcNotAscii + parts[i], 'error');
            return false;
          }
          if (src !== parts[i]) converted.push(src);
          clean.push(src);
        }
        state.directives[name] = state.directives[name] || [];
        var added = false;
        clean.forEach(function (src) {
          if (state.directives[name].indexOf(src) >= 0) return;
          state.directives[name].push(src);
          added = true;
        });
        if (converted.length) showStatus(U.srcConverted + converted.join(' '), 'info');
        if (!added) return true;
        renderDirectives();
        renderAddSelect();
        update();
        return true;
      }


      function renderTabs() {
        tabBtns.forEach(function (btn) {
          var active = btn.getAttribute('data-format') === state.format;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
        });
      }

      function renderOutput() {
        resetCopies();
        var text = buildOutput(state, state.format, T);
        outputEl.textContent = text;
        copyBtn.disabled = !text || text === T.warnEmpty;
        document.getElementById('csp-result').dataset.empty = String(copyBtn.disabled);
      }

      function renderValidation() {
        validationEl.innerHTML = '';
        validatePolicy(state).forEach(function (w) {
          var item = document.createElement('li');
          item.className = 'csp-validation-item ' + (w.level === 'warn' ? 'is-warn' : 'is-info');
          item.textContent = (w.level === 'warn' ? '⚠ ' : 'ℹ ') + (w.directive ? w.directive + ': ' : '') + T[w.key];
          validationEl.appendChild(item);
        });
      }

      function renderAll() {
        presetSel.value = state.preset;
        modeBtns.forEach(function (btn) {
          var active = btn.getAttribute('data-mode') === state.mode;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-checked', active ? 'true' : 'false');
        });
        flagUpgrade.checked = !!state.upgrade;
        flagBlock.checked = !!state.block;
        renderDirectives();
        renderAddSelect();
        renderTabs();
      }

      function revealResult() {
        if (window.matchMedia('(max-width: 640px)').matches && !copyBtn.disabled) {
          document.getElementById('csp-result').scrollIntoView({ block: 'start', behavior: 'auto' });
        }
      }

      function update(reveal) {
        renderOutput();
        renderValidation();
        persist();
        /* update(false) is the boot render, not a user change. */
        if (reveal !== false && window.trackTool) window.trackTool('csp-header-generator', 'generate');
        if (reveal !== false) revealResult();
      }

      var statusTimer = 0;
      var statusRequest = 0;
      var copyStatus = false;
      function showStatus(msg, level, fromCopy) {
        var el = document.getElementById('csp-status');
        if (!el) return;
        window.clearTimeout(statusTimer);
        var request = ++statusRequest;
        copyStatus = !!fromCopy;
        el.textContent = msg || '';
        el.className = 'tool-status ' + (level || 'none');
        if (msg) {
          statusTimer = window.setTimeout(function () {
            if (request !== statusRequest) return;
            el.textContent = '';
            el.className = 'tool-status none';
            copyStatus = false;
          }, 3000);
        }
      }

      var copyRequest = 0;
      var copyTimers = [];
      function resetCopies() {
        copyRequest++;
        copyTimers.forEach(function (timer) { window.clearTimeout(timer); });
        copyTimers = [];
        [copyBtn, hashCopyBtn].forEach(function (btn) {
          btn.textContent = T.copy;
          btn.classList.remove('copied');
        });
        if (copyStatus) showStatus('', 'none');
      }

      // ── Hash calculator ──────────────────────────────────────────────
      var lastHash = '';
      var hashRequest = 0;
      function invalidateHash() {
        hashRequest++;
        lastHash = '';
        hashValueEl.textContent = T.hashEmpty;
        hashCopyBtn.disabled = true;
        hashAddBtn.disabled = !hashInput.value;
        resetCopies();
      }
      hashInput.addEventListener('input', invalidateHash);
      hashAlgo.addEventListener('change', invalidateHash);
      hashTarget.addEventListener('change', invalidateHash);

      async function computeHash() {
        var algo = hashAlgo.value;
        var content = hashInput.value;
        if (!content) return;
        var encoder = new TextEncoder();
        var data = encoder.encode(content);
        var digest = await window.crypto.subtle.digest(algo, data);
        var bytes = new Uint8Array(digest);
        var bin = '';
        for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
        var b64 = btoa(bin);
        var prefix = algo.toLowerCase().replace('-', '');
        return "'" + prefix + '-' + b64 + "'";
      }

      hashAddBtn.addEventListener('click', async function () {
        invalidateHash();
        var request = hashRequest;
        var target = hashTarget.value;
        try {
          var value = await computeHash();
          if (request !== hashRequest || !value) return;
          lastHash = value;
          hashValueEl.textContent = value;
          hashCopyBtn.disabled = false;
          if (!state.directives[target]) state.directives[target] = ["'self'"];
          addSource(target, value);
        } catch (e) {
          if (request !== hashRequest) return;
          showStatus(U.hashFailed + e.message, 'error');
        }
      });

      function fallbackCopy(text, btn) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.body.removeChild(ta);
        /* select() moved focus to the textarea; give it back to the button. */
        if (btn && btn.focus) btn.focus();
        return !!ok;
      }

      function attachCopy(btn, getter) {
        btn.addEventListener('click', async function () {
          var value = getter();
          if (btn.disabled || !value) return;
          resetCopies();
          var request = copyRequest;
          var ok;
          try {
            await navigator.clipboard.writeText(value);
            ok = true;
          } catch (e) {
            ok = false;
          }
          if (request !== copyRequest) return;
          /* Clipboard API missing or refused: hidden textarea + execCommand('copy'), as in
             ColorPaletteGeneratorTool.astro; both failing shows the copy failure. */
          if (!ok) ok = fallbackCopy(value, btn);
          if (!ok) {
            showStatus(U.copyFailed, 'error', true);
            return;
          }
          btn.classList.add('copied');
          btn.textContent = T.copied;
          copyTimers.push(window.setTimeout(function () {
            if (request !== copyRequest) return;
            btn.classList.remove('copied');
            btn.textContent = T.copy;
          }, 1500));
        });
      }

      attachCopy(copyBtn, function () { return outputEl.textContent || ''; });
      attachCopy(hashCopyBtn, function () { return lastHash; });

      // ── Wiring ───────────────────────────────────────────────────────
      presetSel.addEventListener('change', function () {
        applyPreset(presetSel.value);
        renderAll();
        update();
      });

      modeBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.mode = btn.getAttribute('data-mode');
          renderAll();
          update();
        });
      });

      resetBtn.addEventListener('click', function () {
        applyPreset(state.preset);
        renderAll();
        update();
      });

      addBtn.addEventListener('click', function () {
        var name = addSelect.value;
        if (!name || state.directives[name]) return;
        var def = DIRECTIVE_INDEX[name];
        var defaultValue;
        if (name === 'sandbox' || (def && def.kind === 'report')) defaultValue = [];
        else if (name === 'require-trusted-types-for') defaultValue = ["'script'"];
        else if (name === 'trusted-types') defaultValue = ["'none'"];
        else defaultValue = ["'self'"];
        state.directives[name] = defaultValue;
        renderAll();
        update();
      });

      flagUpgrade.addEventListener('change', function () {
        state.upgrade = flagUpgrade.checked;
        update();
      });
      flagBlock.addEventListener('change', function () {
        state.block = flagBlock.checked;
        update();
      });

      tabBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.format = btn.getAttribute('data-format');
          renderTabs();
          renderOutput();
          renderValidation();
          revealResult();
        });
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var wrap = document.querySelector('.csp-wrap');
        if (!wrap || !document.activeElement || !wrap.contains(document.activeElement)) return;
        wrap.querySelectorAll('textarea, input[type="text"]').forEach(function (el) { el.value = ''; });
        invalidateHash();
        showStatus('', 'none');
      });

      // ── Boot ─────────────────────────────────────────────────────────
      loadPersisted();
      var strictApplied = false;
      if (Object.keys(state.directives).length === 0) {
        applyPreset('strict');
        /* Only removed directives were saved: say that the preset replaced them. */
        strictApplied = removedOnLoad.length > 0;
      }
      renderAll();
      update(false);
      var loadNotes = [];
      if (removedOnLoad.length) loadNotes.push(U.removedDirectives + removedOnLoad.join(', '));
      if (removedTtScript) loadNotes.push(U.removedTtScript);
      if (strictApplied) loadNotes.push(U.strictApplied);
      if (loadNotes.length) showStatus(loadNotes.join(' '), 'info');
    })();
  </script>
</div>
