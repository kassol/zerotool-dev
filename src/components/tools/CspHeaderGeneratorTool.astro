// strings:end
const L = STRINGS[lang] || STRINGS.en;
---
<div class="csp-wrap">
  <div class="csp-actions">
    <div class="csp-action"><button type="button" id="csp-reset" class="btn-secondary">{L.resetBtn}</button><Toggletip id="csp-tip-reset" lang={lang} about={L.resetBtn}>{L.tips.reset}</Toggletip></div>
    <div class="csp-action"><button type="button" id="csp-copy" class="btn-copy" disabled>{L.copy}</button><Toggletip id="csp-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip></div>
  </div>
  <div id="csp-status" class="tool-status" aria-live="polite"></div>
  <div class="csp-body">
    <aside class="csp-rail zt-rail">
      <div class="csp-settings">
        <div class="csp-toolbar-field"><div class="csp-field-head"><label class="tool-label" for="csp-preset">{L.presetLabel}</label><Toggletip id="csp-tip-preset" lang={lang} about={L.presetLabel}>{L.tips.preset}</Toggletip></div><select id="csp-preset" class="tool-input csp-select"><option value="strict">{L.presetStrict}</option><option value="moderate">{L.presetModerate}</option><option value="basic">{L.presetBasic}</option><option value="empty">{L.presetEmpty}</option></select></div>
        <div class="csp-toolbar-field"><div class="csp-field-head"><span class="tool-label">{L.modeLabel}</span><Toggletip id="csp-tip-mode" lang={lang} about={L.modeLabel}>{L.tips.mode}</Toggletip></div><div class="csp-mode-toggle zt-segmented" role="radiogroup" aria-label={L.modeLabel}><button type="button" class="csp-mode-btn is-active" data-mode="enforce" role="radio" aria-checked="true">{L.modeEnforce}</button><button type="button" class="csp-mode-btn" data-mode="report-only" role="radio" aria-checked="false">{L.modeReport}</button></div></div>
      </div>
      <div class="csp-add-row"><label class="csp-toolbar-field csp-add-field"><span class="tool-label">{L.addDirectiveLabel}</span><select id="csp-add-select" class="tool-input csp-select"></select></label><button type="button" id="csp-add-btn" class="btn-secondary">{L.addDirectiveBtn}</button></div>
      <div class="csp-field-head"><span class="tool-label">{L.flagsLabel}</span><Toggletip id="csp-tip-flags" lang={lang} about={L.flagsLabel}>{L.tips.flags}</Toggletip></div>
      <div class="csp-flag-row"><label class="csp-flag"><input type="checkbox" id="csp-flag-upgrade" /><span>{L.upgradeInsecure}</span></label><label class="csp-flag"><input type="checkbox" id="csp-flag-block" /><span>{L.blockAllMixed}</span></label></div>
      <div class="csp-editor-area" tabindex="0">
        <div class="csp-field-head"><span class="tool-label">{L.directivesLabel}</span><Toggletip id="csp-tip-directives" lang={lang} about={L.directivesLabel}>{L.tips.directives}</Toggletip></div>
        <div id="csp-directives" class="csp-directive-grid" aria-live="polite"></div>
        <div class="csp-hash-head"><details class="csp-section"><summary class="csp-section-summary"><span>{L.hashCalcTitle}</span></summary><div class="csp-section-body">
          <textarea id="csp-hash-input" class="tool-textarea" rows="3" placeholder={L.hashInputPh} spellcheck="false"></textarea>
          <div class="csp-hash-controls"><label class="csp-toolbar-field"><span class="tool-label">{L.hashAlgoLabel}</span><select id="csp-hash-algo" class="tool-input csp-select"><option value="SHA-256">sha256</option><option value="SHA-384">sha384</option><option value="SHA-512">sha512</option></select></label><label class="csp-toolbar-field"><span class="tool-label">{L.hashTargetLabel}</span><select id="csp-hash-target" class="tool-input csp-select"><option value="script-src">script-src</option><option value="style-src">style-src</option></select></label><div class="csp-hash-actions"><button type="button" id="csp-hash-add" class="btn-primary" disabled>{L.hashAddBtn}</button></div></div>
          <div class="csp-hash-output"><code id="csp-hash-value" class="csp-hash-value">{L.hashEmpty}</code><button type="button" id="csp-hash-copy" class="btn-copy" disabled>{L.copy}</button></div>
        </div></details><Toggletip id="csp-tip-hash" lang={lang} about={L.hashCalcTitle}>{L.tips.hash}</Toggletip></div>
      </div>
    </aside>
    <div id="csp-result" class="csp-result" data-empty="false">
      <div class="csp-output">
        <div class="csp-field-head"><span class="tool-label">{L.formatLabel}</span><Toggletip id="csp-tip-format" lang={lang} about={L.formatLabel}>{L.tips.format}</Toggletip></div>
        <div class="csp-tab-row" role="tablist"><button type="button" class="csp-tab is-active" data-format="header" role="tab" aria-selected="true">{L.formatHeader}</button><button type="button" class="csp-tab" data-format="meta" role="tab" aria-selected="false">{L.formatMeta}</button><button type="button" class="csp-tab" data-format="express" role="tab" aria-selected="false">{L.formatExpress}</button><button type="button" class="csp-tab" data-format="nginx" role="tab" aria-selected="false">{L.formatNginx}</button></div>
        <div class="csp-output-panel"><pre id="csp-output" class="csp-output-pre" tabindex="0">{L.warnEmpty}</pre></div>
      </div>
      <div id="csp-validation" class="csp-validation" aria-live="polite"></div>
    </div>
  </div>
  <style is:global>
    .csp-wrap {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      flex: 1;
      min-width: 0;
      min-height: 0;
    }
    .csp-body { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 1rem; flex: 1; min-width: 0; min-height: 0; }
    .csp-rail { overflow: hidden; }
    .csp-actions, .csp-action, .csp-field-head { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
    .csp-actions { gap: 0.65rem; }
    #csp-status { min-height: 2.8em; margin: 0; }
    .csp-settings { display: flex; flex-direction: column; gap: 0.75rem; }
    .csp-editor-area { flex: 1 1 0; min-height: 120px; overflow: auto; display: flex; flex-direction: column; gap: 0.65rem; }
    .csp-hash-head { display: flex; align-items: flex-start; gap: 0.4rem; flex: none; }
    .csp-hash-head .csp-section { flex: 1; min-width: 0; }
    .csp-result { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; }

    .csp-section,
    .csp-output {
      background: var(--color-bg-secondary);
      border-radius: var(--radius-md);
      padding: 0.95rem 1rem;
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
    }

    .csp-toolbar-field {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      min-width: 0;
    }
    .csp-add-field { flex: 1 1 140px; }

    .csp-select {
      padding: 0.5rem 0.75rem;
      border-radius: var(--radius-md);
      border: 0;
      background: var(--color-surface);
      color: var(--color-text);
      font-family: var(--font-sans);
      font-size: 0.9rem;
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
      transition: background-color var(--transition-fast), box-shadow var(--transition-fast);
    }
    .csp-select:focus {
      outline: none;
      box-shadow: inset 0 0 0 1px var(--color-primary), 0 0 0 4px var(--color-primary-light);
    }

    .csp-mode-toggle {
      display: inline-flex;
      gap: 0.25rem;
      padding: 0.25rem;
      border-radius: var(--radius-pill);
      background: var(--color-surface-muted);
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
    }
    .csp-mode-btn {
      min-height: 32px;
      padding: 0.3rem 0.95rem;
      border: 0;
      background: transparent;
      color: var(--color-text-secondary);
      border-radius: var(--radius-pill);
      cursor: pointer;
      font-weight: 700;
      font-size: 0.82rem;
      transition: background-color var(--transition-fast), color var(--transition-fast);
    }
    .csp-mode-btn.is-active {
      background: var(--color-surface);
      color: var(--color-primary);
      box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-primary) 45%, transparent);
    }
    @media (hover: hover) {
      .csp-mode-btn:hover:not(.is-active) { color: var(--color-text); }
    }

    .csp-directive-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      flex: none;
      gap: 0.85rem;
    }
    .csp-directive {
      background: var(--color-surface);
