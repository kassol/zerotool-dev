const ORDER = {
  en: ['custom', 'github', 'stripe', 'slack', 'shopify', 'svix', 'twilio', 'line', 'chatwork', 'feishu', 'dingtalk', 'ncp'],
  zh: ['custom', 'dingtalk', 'feishu', 'github', 'stripe', 'slack', 'shopify', 'svix', 'twilio', 'line', 'chatwork', 'ncp'],
  ja: ['custom', 'line', 'chatwork', 'github', 'stripe', 'slack', 'shopify', 'svix', 'twilio', 'feishu', 'dingtalk', 'ncp'],
  ko: ['custom', 'ncp', 'github', 'stripe', 'slack', 'shopify', 'svix', 'twilio', 'line', 'chatwork', 'feishu', 'dingtalk'],
};

const L = STRINGS[lang];
const order = ORDER[lang];
---
<div class="hmac-wrap">
  <div class="hmac-top">
    <label class="hmac-sel hmac-sel-preset">
      <span class="hmac-cap">{L.format}</span>
      <select id="hmac-preset" class="tool-input">
        {order.map((id) => <option value={id}>{L.presets[id]}</option>)}
      </select>
    </label>
    <label class="hmac-sel">
      <span class="hmac-cap">{L.algorithm}</span>
      <select id="hmac-algo" class="tool-input">
        <option value="SHA-256">SHA-256</option>
        <option value="SHA-512">SHA-512</option>
        <option value="SHA-384">SHA-384</option>
        <option value="SHA-224">SHA-224</option>
        <option value="SHA-1">SHA-1</option>
        <option value="MD5">MD5</option>
      </select>
    </label>
    <button id="hmac-example" class="btn-ghost btn-sm" type="button">{L.example}</button>
  </div>
  <div class="hmac-field" id="hmac-msg-field">
    <div class="hmac-head">
      <label for="hmac-msg" id="hmac-msg-label" class="hmac-name">{L.message}</label>
      <select id="hmac-msg-enc" class="hmac-mini" aria-label={L.msgEnc}>
        <option value="text">{L.encText}</option>
        <option value="hex">{L.encHex}</option>
        <option value="base64">{L.encB64}</option>
      </select>
      <select id="hmac-eol" class="hmac-mini" aria-label={L.eol}>
        <option value="lf">LF</option>
        <option value="crlf">CRLF</option>
      </select>
      <span id="hmac-msg-bytes" class="hmac-meta"></span>
    </div>
    <textarea id="hmac-msg" class="tool-textarea hmac-msg" rows="3" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off"></textarea>
  </div>

  <div class="hmac-extra">
    <div class="hmac-field" data-field="url" hidden>
      <label for="hmac-url" class="hmac-name">{L.url}</label>
      <input id="hmac-url" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" />
    </div>
    <div class="hmac-field" data-field="method" hidden>
      <label for="hmac-method" class="hmac-name">{L.method}</label>
      <select id="hmac-method" class="tool-input">
        <option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option><option>DELETE</option>
      </select>
    </div>
    <div class="hmac-field" data-field="uri" hidden>
      <label for="hmac-uri" class="hmac-name">{L.uri}</label>
      <input id="hmac-uri" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" />
    </div>
    <div class="hmac-field" data-field="id" hidden>
      <label for="hmac-id" class="hmac-name">{L.webhookId}</label>
      <input id="hmac-id" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" />
    </div>
    <div class="hmac-field" data-field="timestamp" hidden>
      <label for="hmac-ts" class="hmac-name" id="hmac-ts-label">{L.timestamp}</label>
      <div class="hmac-inline">
        <input id="hmac-ts" class="tool-input" type="text" inputmode="numeric" spellcheck="false" autocomplete="off" />
        <button id="hmac-now" class="btn-ghost btn-sm" type="button">{L.now}</button>
      </div>
    </div>
    <div class="hmac-field" data-field="accessKey" hidden>
      <label for="hmac-access" class="hmac-name">{L.accessKey}</label>
      <input id="hmac-access" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" />
