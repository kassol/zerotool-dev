    .hmac-msg { min-height: 76px; height: 76px; }

    .hmac-mini { min-height: 32px; }

    .hmac-head .hmac-meta { display: none; }

    .hmac-row {
      grid-template-columns: 4.4rem minmax(0, 1fr) auto;
      gap: 0.4rem;
      padding: 0.35rem 0.5rem;
    }

    .hmac-row-main {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .hmac-row-main .hmac-row-label { grid-column: 1 / -1; }

    .hmac-details summary { min-height: 44px; align-items: center; }
  }
</style>
