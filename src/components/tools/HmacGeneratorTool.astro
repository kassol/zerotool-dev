    </div>
    <div class="hmac-inline">
      <input id="hmac-key" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" />
      <button id="hmac-generate" class="btn-primary" type="button">{L.generate}</button>
    </div>
  </div>

  <div id="hmac-results" class="hmac-results" hidden>
    <div class="hmac-row hmac-row-main" id="hmac-row-preset" hidden>
      <span class="hmac-row-label">{L.outPreset}</span>
      <code id="hmac-out-preset" class="hmac-out"></code>
      <button class="btn-copy" type="button" data-copy="hmac-out-preset">{L.copy}</button>
    </div>
    <div class="hmac-row">
      <span class="hmac-row-label">Hex</span>
      <code id="hmac-out-hex" class="hmac-out"></code>
      <button class="btn-copy" type="button" data-copy="hmac-out-hex">{L.copy}</button>
    </div>
    <div class="hmac-row">
      <span class="hmac-row-label">Base64</span>
      <code id="hmac-out-b64" class="hmac-out"></code>
      <button class="btn-copy" type="button" data-copy="hmac-out-b64">{L.copy}</button>
    </div>
    <div class="hmac-row">
      <span class="hmac-row-label">Base64url</span>
      <code id="hmac-out-b64url" class="hmac-out"></code>
      <button class="btn-copy" type="button" data-copy="hmac-out-b64url">{L.copy}</button>
    </div>
  </div>

  <p id="hmac-status" class="tool-status none" role="status" aria-live="polite"></p>

  <p id="hmac-preset-note" class="hmac-note" hidden></p>

  <div class="hmac-options" id="hmac-options">
    <label class="hmac-check"><input type="checkbox" id="hmac-upper" /><span>{L.upper}</span></label>
    <label class="hmac-trunc">
      <span>{L.truncate}</span>
      <input id="hmac-trunc" class="tool-input" type="number" min="8" step="8" inputmode="numeric" placeholder={L.full} />
      <span>{L.bits}</span>
    </label>
  </div>

  <div class="hmac-field hmac-verify">
    <label for="hmac-expected" class="hmac-name">{L.compareLabel}</label>
    <input id="hmac-expected" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" placeholder={L.comparePh} />
    <p id="hmac-verdict" class="tool-status none" role="status" aria-live="polite" hidden></p>
  </div>

  <ul id="hmac-notes" class="hmac-notes" hidden></ul>

  <details class="hmac-details" id="hmac-signed-wrap" hidden>
