    var rowPreset = $('hmac-row-preset');
    var outPreset = $('hmac-out-preset');
    var outHex = $('hmac-out-hex');
    var outB64 = $('hmac-out-b64');
    var outB64url = $('hmac-out-b64url');
    var optionsEl = $('hmac-options');
    var upperEl = $('hmac-upper');
    var truncEl = $('hmac-trunc');
    var expectedEl = $('hmac-expected');
    var verdictEl = $('hmac-verdict');
    var notesEl = $('hmac-notes');
    var signedWrap = $('hmac-signed-wrap');
    var signedTitle = $('hmac-signed-title');
    var signedEl = $('hmac-signed');
    var subtle = window.crypto && window.crypto.subtle;
    var seq = 0;
    var tracked = false;

    function fmt(s, o) {
      return String(s).replace(/\{(\w+)\}/g, function (m, k) {
        return o && Object.prototype.hasOwnProperty.call(o, k) ? o[k] : m;
      });
    }

    function setStatus(el, msg, kind) {
      el.textContent = msg || '';
      el.className = 'tool-status ' + (kind || 'none');
      if (el !== statusEl) el.hidden = !msg;
    }

    function duration(sec) {
      if (sec < 120) return fmt(S.durS, { n: sec });
      if (sec < 3600) return fmt(S.durMin, { n: Math.round(sec / 60) });
      if (sec < 172800) return fmt(S.durH, { n: Math.round(sec / 3600) });
      return fmt(S.durD, { n: Math.round(sec / 86400) });
    }

    function fieldName(field, presetId) {
      if (field === 'msg') return presetId === 'custom' ? S.fMsg : S.fBody;
      return { key: S.fKey, timestamp: S.fTimestamp, id: S.fId, accessKey: S.fAccessKey }[field] || field;
    }

    function errorText(e, presetId) {
      var o = { field: fieldName(e.field, presetId), pos: e.pos, ch: e.ch, n: e.n, max: e.max };
      switch (e.code) {
        case 'hexChar': return fmt(S.errHexChar, o);
        case 'hexOdd': return fmt(S.errHexOdd, o);
        case 'b64Char': return fmt(S.errB64Char, o);
        case 'b64Pad': return fmt(S.errB64Pad, o);
        case 'b64Len': return fmt(S.errB64Len, o);
        case 'missing': return fmt(S.errMissing, o);
        case 'tsFormat': return fmt(S.errTsFormat, { unit: e.unit === 'ms' ? S.unitMs : S.unitS });
        case 'url': return S.errUrl;
        case 'uri': return S.errUri;
        case 'formDecode': return fmt(S.errFormDecode, o);
        case 'trunc': return fmt(S.errTrunc, o);
        default: return S.errSubtle;
      }
    }

    function noteText(n, presetId) {
      var o = { field: fieldName(n.field, presetId), n: n.n, size: n.size, block: n.block, hex: n.hex, algo: n.algo };
      switch (n.code) {
        case 'fullwidth': return fmt(S.nFullwidth, o);
        case 'surrogate': return fmt(S.nSurrogate, o);
        case 'trailingNewline': return fmt(S.nTrailingNewline, o);
        case 'edgeSpace': return fmt(S.nEdgeSpace, o);
        case 'keyEmpty': return S.nKeyEmpty;
        case 'keyShort': return fmt(S.nKeyShort, o);
        case 'keyLong': return fmt(S.nKeyLong, o);
        case 'truncShort': return S.nTruncShort;
        case 'legacy': return fmt(S.nLegacy, o);
        case 'twilioJson': return S.nTwilioJson;
        case 'bodyHashOk': return S.nBodyHashOk;
        case 'bodyHashBad': return fmt(S.nBodyHashBad, o);
        case 'svixKeyLen': return fmt(S.nSvixKeyLen, o);
        case 'tsOld': return fmt(S.nTsOld, { age: duration(n.age), limit: duration(n.limit) });
        case 'tsFuture': return fmt(S.nTsFuture, { age: duration(n.age), limit: duration(n.limit) });
        case 'tsLooksMs': return S.nTsLooksMs;
        case 'tsLooksS': return S.nTsLooksS;
        case 'tsFromHeader': return S.nTsFromHeader;
        default: return '';
      }
    }

    function encName(enc) { return enc === 'hex' ? S.encHex : enc === 'base64' ? S.encB64 : S.encText; }

    function diagnosisText(d) {
      var key = d.code === 'eolCrlf' || d.code === 'eolLf' ? 'd_' + d.code : 'd_' + d.code;
      var other = d.other ? S.presets[d.other] : '';
      return S.dPrefix + ' ' + fmt(S[key] || '', { enc: encName(d.enc), algo: (d.algo || '').replace('-', ''), other: other, ts: d.ts });
    }

    function currentPreset() { return presetEl.value; }

    function readFields() {
      return {
        algo: algoEl.value,
        key: keyEl.value,
        keyEnc: keyEncEl.value,
        msg: msgEl.value,
        msgEnc: msgEncEl.value,
        eol: eolEl.value,
        timestamp: tsEl.value,
        id: idEl.value,
        url: urlEl.value,
        method: methodEl.value,
        uri: uriEl.value,
        accessKey: accessEl.value,
      };
    }

    function applyPreset() {
      var id = currentPreset();
      var p = PRESETS[id];
      var custom = id === 'custom';
      wrap.querySelectorAll('.hmac-extra [data-field]').forEach(function (el) {
        el.hidden = p.fields.indexOf(el.getAttribute('data-field')) < 0;
      });
      msgField.hidden = !custom && p.fields.indexOf('body') < 0;
      msgLabel.textContent = custom ? S.message : id === 'twilio' ? S.formBody : S.body;
      msgEncEl.hidden = !custom;
      keyEncEl.hidden = !custom;
      if (!custom) { msgEncEl.value = 'text'; keyEncEl.value = 'text'; }
      eolEl.hidden = !custom ? false : msgEncEl.value !== 'text';
      algoEl.disabled = !custom;
      if (!custom) algoEl.value = p.algo;
      keyLabel.textContent = S.keyLabels[id] || S.keyLabels.custom;
      presetNote.textContent = S.notes[id] || '';
      presetNote.hidden = custom;
      optionsEl.hidden = !custom;
      tsLabel.textContent = S.timestamp + (p.unit ? ' (' + (p.unit === 'ms' ? S.unitMs : S.unitS) + ')' : '');
      exampleBtn.hidden = !EXAMPLES[id];
      signedTitle.textContent = id === 'feishu' ? S.keyStringTitle : S.signedTitle;
    }

    function clearOutputs() {
      results.hidden = true;
      notesEl.hidden = true;
      notesEl.textContent = '';
      signedWrap.hidden = true;
      setStatus(verdictEl, '');
    }

    function renderNotes(list, presetId) {
      notesEl.textContent = '';
      var seen = {};
      list.forEach(function (n) {
        var text = noteText(n, presetId);
        if (!text || seen[text]) return;
        seen[text] = true;
        var li = document.createElement('li');
        li.textContent = text;
        notesEl.appendChild(li);
      });
      notesEl.hidden = !notesEl.childNodes.length;
    }

    function bodyHashParam(url) {
      var m = String(url).match(/[?&]bodySHA256=([0-9a-fA-F]{64})(?:&|$)/);
      return m ? m[1].toLowerCase() : null;
    }

    async function recompute() {
      var my = ++seq;
      var id = currentPreset();
      var p = PRESETS[id];
      var f = readFields();
      var parsed = parseSignature(expectedEl.value);
      var extraNotes = [];
      if (id === 'stripe' && !f.timestamp.trim() && parsed.ts) {
        tsEl.value = parsed.ts;
        f.timestamp = parsed.ts;
        extraNotes.push({ code: 'tsFromHeader' });
      }
      var msgShown = !msgField.hidden;
      msgBytes.textContent = msgShown && f.msg ? fmt(S.bytes, { n: utf8(f.eol === 'crlf' ? f.msg.replace(/\r?\n/g, '\r\n') : f.msg).length }) : '';
      keyBytes.textContent = '';

      var empty = !f.key && (!msgShown || !f.msg);
      if (empty) {
        clearOutputs();
        setStatus(statusEl, '');
        return;
      }
      var built = buildSigning(id, f);
      if (!built.ok) {
        clearOutputs();
        setStatus(statusEl, errorText(built, id), 'error');
        return;
      }
      if (custom(id) && f.msgEnc !== 'text') msgBytes.textContent = fmt(S.bytes, { n: built.message.length });
      keyBytes.textContent = fmt(S.bytes, { n: id === 'feishu' ? utf8(f.key).length : built.key.length });

      var sig;
      try {
        sig = await computeHmac(built.algo, built.key, built.message, subtle);
      } catch (e) {
        if (my !== seq) return;
        clearOutputs();
        setStatus(statusEl, S.errSubtle, 'error');
        return;
      }
      if (my !== seq) return;

      var shown = sig;
      var notes = built.notes.concat(extraNotes);
      if (custom(id)) {
        var t = truncateBits(sig, truncEl.value);
        if (!t.ok) {
          clearOutputs();
          setStatus(statusEl, errorText(t, id), 'error');
          return;
        }
        shown = t.bytes;
        if (t.short) notes.push({ code: 'truncShort' });
      }

      var upper = custom(id) && upperEl.checked;
      outHex.textContent = toHex(shown, upper);
      outB64.textContent = toBase64(shown);
      outB64url.textContent = toBase64url(shown);
      var header = formatSignature(id, sig, f);
      rowPreset.hidden = !header;
      outPreset.textContent = header || '';
      results.hidden = false;
      setStatus(statusEl, fmt(S.stOk, {
        algo: built.algo.replace('-', ''), bits: shown.length * 8,
        key: built.key.length, msg: built.message.length,
      }), 'success');

      notes = notes.concat(keyNotes(built.algo, built.key));
      if (built.algo === 'MD5' || built.algo === 'SHA-1') {
        if (id === 'custom') notes.push({ code: 'legacy', algo: built.algo.replace('-', '') });
      }
      if (msgShown && (id === 'custom' ? f.msgEnc === 'text' : true)) notes = notes.concat(textNotes(f.msg, 'msg'));
      if (id === 'custom' ? f.keyEnc === 'text' : p.key === 'text') notes = notes.concat(textNotes(f.key, 'key'));
      var tsCheck = checkTimestamp(id, f.timestamp, Date.now());
      if (tsCheck) notes = notes.concat(tsCheck.notes);
      if (id === 'twilio' && /^\s*[{[]/.test(f.msg)) {
        var want = bodyHashParam(f.url);
        if (want && subtle) {
          var digest = new Uint8Array(await subtle.digest('SHA-256', utf8(f.msg)));
          if (my !== seq) return;
          var got = toHex(digest);
          notes.push(got === want ? { code: 'bodyHashOk' } : { code: 'bodyHashBad', hex: got });
        }
      }
      renderNotes(notes, id);

      var signedText = id === 'feishu' ? built.keyString : built.signed;
      signedWrap.hidden = signedText == null || id === 'custom' && signedText === f.msg && !/[\r\n\t]/.test(signedText);
      signedEl.textContent = signedText == null ? '' : visible(signedText);

      if (!tracked && window.trackTool) { tracked = true; window.trackTool('hmac-generator', 'generate'); }

      if (parsed.empty) { setStatus(verdictEl, ''); return; }
      var r = matchSignature(sig, parsed);
      if (r.status === 'match') {
        var enc = r.encoding === 'hex' ? S.encHex : S.encB64;
        var text = r.count > 1 ? fmt(S.vMatchOf, { i: r.index + 1, n: r.count, enc: enc }) : fmt(S.vMatch, { enc: enc });
        if (r.upper && !upper) text += ' ' + S.vUpper;
        setStatus(verdictEl, text, 'success');
        if (window.trackTool) window.trackTool('hmac-generator', 'verify');
        return;
      }
      if (r.status === 'truncated') { setStatus(verdictEl, fmt(S.vTruncated, { bits: r.bits }), 'success'); return; }
      if (r.status === 'unreadable') { setStatus(verdictEl, S.vUnreadable, 'error'); return; }
      var size = ALGOS[built.algo].size;
      var len = r.lengths[0];
      var base = len !== size ? fmt(S.vNoneLen, { len: len, algo: built.algo.replace('-', ''), size: size }) : S.vNone;
      setStatus(verdictEl, base, 'error');
      var d = await diagnose(id, f, parsed, subtle);
      if (my !== seq) return;
      if (d) setStatus(verdictEl, base + ' ' + diagnosisText(d), 'error');
    }

    function custom(id) { return id === 'custom'; }

    var timer = null;
    function schedule() {
      clearTimeout(timer);
      timer = setTimeout(recompute, 150);
    }

    function nowFor(id) {
      var p = PRESETS[id];
      return p && p.unit === 'ms' ? String(Date.now()) : String(Math.floor(Date.now() / 1000));
    }

    function loadExample() {
      var id = currentPreset();
      var ex = EXAMPLES[id];
      if (!ex) return;
      if (ex.algo) algoEl.value = ex.algo;
      keyEncEl.value = 'text';
      msgEncEl.value = 'text';
      eolEl.value = 'lf';
      keyEl.value = ex.key || '';
      msgEl.value = ex.msg || '';
      tsEl.value = ex.timestamp === 'now' ? nowFor(id) : ex.timestamp || '';
      expectedEl.value = ex.expected || '';
      upperEl.checked = false;
      truncEl.value = '';
      applyPreset();
      recompute();
    }

    wrap.querySelectorAll('.btn-copy[data-copy]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var val = $(btn.getAttribute('data-copy')).textContent;
        if (!val) return;
        var done = function () {
          btn.textContent = S.copied;
          btn.classList.add('copied');
          setTimeout(function () { btn.textContent = S.copy; btn.classList.remove('copied'); }, 1500);
        };
        var fallback = function () {
          var ta = document.createElement('textarea');
          ta.value = val;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          var ok = false;
          try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
          document.body.removeChild(ta);
          if (ok) done(); else setStatus(statusEl, S.copyFail, 'error');
        };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(val).then(done, fallback);
        else fallback();
      });
    });

    presetEl.addEventListener('change', function () {
      var id = currentPreset();
      applyPreset();
      if (PRESETS[id].unit && !tsEl.value.trim()) tsEl.value = nowFor(id);
      if (id === 'ncp' && !uriEl.value.trim()) uriEl.value = '/';
      recompute();
    });
    msgEncEl.addEventListener('change', function () { applyPreset(); recompute(); });
    [algoEl, keyEncEl, eolEl, methodEl, upperEl].forEach(function (el) { el.addEventListener('change', recompute); });
    [msgEl, keyEl, tsEl, idEl, urlEl, uriEl, accessEl, truncEl, expectedEl].forEach(function (el) { el.addEventListener('input', schedule); });
    $('hmac-now').addEventListener('click', function () { tsEl.value = nowFor(currentPreset()); recompute(); });
    exampleBtn.addEventListener('click', loadExample);
    $('hmac-generate').addEventListener('click', recompute);

    // The site-wide Ctrl/⌘+L shortcut empties text fields without input events.
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
        setTimeout(recompute, 0);
      }
    });

    applyPreset();
    recompute();
  })();
</script>

<style>
  .hmac-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-width: 0;
  }

  .hmac-top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto;
    gap: 0.6rem;
    align-items: end;
  }

  .hmac-sel {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .hmac-sel select { width: 100%; }

  .hmac-wrap select.tool-input { font-family: var(--font-sans); }

  .hmac-cap,
  .hmac-name {
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--color-text-secondary);
  }

  .hmac-note {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
