    min-width: 0;
  }

  .hmac-field[hidden],
  .hmac-row[hidden],
  .hmac-options[hidden] { display: none; }

  .hmac-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .hmac-head .hmac-name { margin-right: auto; }

  .hmac-mini {
    font-size: 0.78rem;
    padding: 0.15rem 0.4rem;
    min-height: 28px;
    border-radius: var(--radius-sm);
  }

  .hmac-mini[hidden] { display: none; }

  .hmac-meta {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .hmac-msg {
    min-height: 96px;
  }

  .hmac-extra {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 0.6rem;
  }

  .hmac-extra:not(:has(.hmac-field:not([hidden]))) { display: none; }

  .hmac-inline {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
    min-width: 0;
  }

  .hmac-inline .tool-input {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hmac-inline .btn-primary { flex: 0 0 auto; }

  .hmac-results {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .hmac-row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    gap: 0.6rem;
    align-items: center;
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }

  .hmac-row-main { box-shadow: inset 0 0 0 1px var(--color-primary); }

  .hmac-row-label {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.02em;
  }

  .hmac-out {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text);
    overflow-wrap: anywhere;
    word-break: break-all;
    line-height: 1.5;
    background: transparent;
  }

  .hmac-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  .hmac-check,
  .hmac-trunc {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hmac-trunc .tool-input {
    width: 6.5rem;
  }

  .hmac-verify { padding-top: 0.2rem; }

  .hmac-notes {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .hmac-notes[hidden] { display: none; }

  .hmac-details {
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }

  .hmac-details[hidden] { display: none; }

  .hmac-details summary {
    cursor: pointer;
    padding: 0.55rem 0.75rem;
