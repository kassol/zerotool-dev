    <pre id="hmac-signed" class="hmac-signed"></pre>
  </details>

  <p class="hmac-privacy">{L.privacy}</p>
</div>

<script is:inline define:vars={{ S: L }}>
  (function () {
    /* ── engine:start ── */
    var ALGOS = {
      'SHA-256': { block: 64, size: 32, subtle: 'SHA-256' },
      'SHA-512': { block: 128, size: 64, subtle: 'SHA-512' },
      'SHA-384': { block: 128, size: 48, subtle: 'SHA-384' },
      'SHA-224': { block: 64, size: 28, subtle: null },
      'SHA-1': { block: 64, size: 20, subtle: 'SHA-1' },
      'MD5': { block: 64, size: 16, subtle: null },
    };
    var ALGO_ORDER = ['SHA-256', 'SHA-512', 'SHA-384', 'SHA-224', 'SHA-1', 'MD5'];

    // Signing formats. key: how the secret field becomes key bytes; out: encoding the platform sends.
    var PRESETS = {
      custom: { fields: [] },
      github: { algo: 'SHA-256', key: 'text', out: 'hex', fields: ['body'] },
      stripe: { algo: 'SHA-256', key: 'text', out: 'hex', fields: ['body', 'timestamp'], unit: 's', tolerance: 300 },
      slack: { algo: 'SHA-256', key: 'text', out: 'hex', fields: ['body', 'timestamp'], unit: 's', tolerance: 300 },
      svix: { algo: 'SHA-256', key: 'whsec', out: 'base64', fields: ['body', 'id', 'timestamp'], unit: 's', tolerance: 300 },
      shopify: { algo: 'SHA-256', key: 'text', out: 'base64', fields: ['body'] },
      line: { algo: 'SHA-256', key: 'text', out: 'base64', fields: ['body'] },
      chatwork: { algo: 'SHA-256', key: 'base64', out: 'base64', fields: ['body'] },
      twilio: { algo: 'SHA-1', key: 'text', out: 'base64', fields: ['url', 'body'] },
      feishu: { algo: 'SHA-256', key: 'text', out: 'base64', fields: ['timestamp'], unit: 's', tolerance: 3600 },
      dingtalk: { algo: 'SHA-256', key: 'text', out: 'base64', fields: ['timestamp'], unit: 'ms', tolerance: 3600 },
      ncp: { algo: 'SHA-256', key: 'text', out: 'base64', fields: ['method', 'uri', 'timestamp', 'accessKey'], unit: 'ms', tolerance: 300 },
    };

    var MD5_K = [0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501, 0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821, 0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8, 0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a, 0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70, 0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665, 0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1, 0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391];
    var MD5_S = [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21];
    var SHA256_K = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2];
    // FIPS 180-4 §5.3.2 initial hash value for SHA-224.
    var SHA224_IV = [0xc1059ed8, 0x367cd507, 0x3070dd17, 0xf70e5939, 0xffc00b31, 0x68581511, 0x64f98fa7, 0xbefa4fa4];

    // RFC 1321. Web Crypto has no MD5, so HMAC-MD5 runs on this.
    function md5(msg) {
      var len = msg.length;
      var nWords = (((len + 8) >>> 6) + 1) * 16;
      var w = new Int32Array(nWords);
      for (var i = 0; i < len; i++) w[i >> 2] |= msg[i] << ((i % 4) * 8);
      w[len >> 2] |= 0x80 << ((len % 4) * 8);
      w[nWords - 2] = (len * 8) | 0;
      w[nWords - 1] = Math.floor(len / 0x20000000);
      var a0 = 0x67452301, b0 = 0xefcdab89 | 0, c0 = 0x98badcfe | 0, d0 = 0x10325476;
      for (var blk = 0; blk < nWords; blk += 16) {
        var A = a0, B = b0, C = c0, D = d0;
        for (var j = 0; j < 64; j++) {
          var F, g;
          if (j < 16) { F = (B & C) | (~B & D); g = j; }
          else if (j < 32) { F = (D & B) | (~D & C); g = (5 * j + 1) % 16; }
          else if (j < 48) { F = B ^ C ^ D; g = (3 * j + 5) % 16; }
          else { F = C ^ (B | ~D); g = (7 * j) % 16; }
          var s = MD5_S[(j >> 4) * 4 + (j % 4)];
          var x = (A + F + MD5_K[j] + w[blk + g]) | 0;
          A = D; D = C; C = B;
          B = (B + ((x << s) | (x >>> (32 - s)))) | 0;
        }
        a0 = (a0 + A) | 0; b0 = (b0 + B) | 0; c0 = (c0 + C) | 0; d0 = (d0 + D) | 0;
      }
      var out = new Uint8Array(16);
      [a0, b0, c0, d0].forEach(function (v, k) {
        for (var b = 0; b < 4; b++) out[k * 4 + b] = (v >>> (b * 8)) & 0xff;
      });
      return out;
    }

    // FIPS 180-4 SHA-256 compression with the SHA-224 initial value, truncated to 224 bits.
    // Web Crypto has no SHA-224.
    function sha224(msg) {
      var len = msg.length;
      var nWords = (((len + 8) >>> 6) + 1) * 16;
      var w = new Int32Array(nWords);
      for (var i = 0; i < len; i++) w[i >> 2] |= msg[i] << (24 - (i % 4) * 8);
      w[len >> 2] |= 0x80 << (24 - (len % 4) * 8);
      w[nWords - 2] = Math.floor(len / 0x20000000);
      w[nWords - 1] = (len * 8) | 0;
      var H = SHA224_IV.map(function (v) { return v | 0; });
      var W = new Int32Array(64);
      for (var blk = 0; blk < nWords; blk += 16) {
        for (var t = 0; t < 64; t++) {
          if (t < 16) W[t] = w[blk + t];
          else {
            var x = W[t - 15], y = W[t - 2];
            var s0 = ((x >>> 7) | (x << 25)) ^ ((x >>> 18) | (x << 14)) ^ (x >>> 3);
            var s1 = ((y >>> 17) | (y << 15)) ^ ((y >>> 19) | (y << 13)) ^ (y >>> 10);
            W[t] = (W[t - 16] + s0 + W[t - 7] + s1) | 0;
          }
        }
        var a = H[0], b = H[1], c = H[2], d = H[3], e = H[4], f = H[5], g = H[6], h = H[7];
        for (var r = 0; r < 64; r++) {
          var S1 = ((e >>> 6) | (e << 26)) ^ ((e >>> 11) | (e << 21)) ^ ((e >>> 25) | (e << 7));
          var ch = (e & f) ^ (~e & g);
          var t1 = (h + S1 + ch + SHA256_K[r] + W[r]) | 0;
          var S0 = ((a >>> 2) | (a << 30)) ^ ((a >>> 13) | (a << 19)) ^ ((a >>> 22) | (a << 10));
          var maj = (a & b) ^ (a & c) ^ (b & c);
          var t2 = (S0 + maj) | 0;
          h = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;
        }
        H[0] = (H[0] + a) | 0; H[1] = (H[1] + b) | 0; H[2] = (H[2] + c) | 0; H[3] = (H[3] + d) | 0;
        H[4] = (H[4] + e) | 0; H[5] = (H[5] + f) | 0; H[6] = (H[6] + g) | 0; H[7] = (H[7] + h) | 0;
      }
      var out = new Uint8Array(28);
      for (var k = 0; k < 7; k++) {
        for (var bb = 0; bb < 4; bb++) out[k * 4 + bb] = (H[k] >>> (24 - bb * 8)) & 0xff;
      }
      return out;
    }

    function concatBytes(a, b) {
      var out = new Uint8Array(a.length + b.length);
      out.set(a, 0);
      out.set(b, a.length);
      return out;
    }

    // RFC 2104 §2: keys longer than the block are hashed first, shorter keys are zero-padded.
    function hmacWith(hash, block, key, msg) {
      var k = key.length > block ? hash(key) : key;
      var ipad = new Uint8Array(block), opad = new Uint8Array(block);
      for (var i = 0; i < block; i++) {
        var kb = i < k.length ? k[i] : 0;
        ipad[i] = kb ^ 0x36;
        opad[i] = kb ^ 0x5c;
      }
      return hash(concatBytes(opad, hash(concatBytes(ipad, msg))));
    }

    async function computeHmac(algo, key, msg, subtle) {
      var a = ALGOS[algo];
      if (!a) throw new Error('unknown algorithm ' + algo);
      if (!a.subtle) return hmacWith(algo === 'MD5' ? md5 : sha224, a.block, key, msg);
      if (!subtle) throw new Error('subtle');
      // Web Crypto rejects a zero-length raw key. A block of zero bytes gives the same padded
      // key K0 (RFC 2104 §2), so it gives the same HMAC.
      var raw = key.length ? key : new Uint8Array(a.block);
      var ck = await subtle.importKey('raw', raw, { name: 'HMAC', hash: a.subtle }, false, ['sign']);
      return new Uint8Array(await subtle.sign('HMAC', ck, msg));
    }

    function utf8(text) { return new TextEncoder().encode(text); }

    function hasLoneSurrogate(text) {
      return /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(^|[^\uD800-\uDBFF])[\uDC00-\uDFFF]/.test(text);
    }

    // Full-width ASCII (U+FF01–FF5E) as typed by Japanese / Chinese / Korean IMEs.
    function foldWidth(ch) {
      var c = ch.charCodeAt(0);
      if (c >= 0xff01 && c <= 0xff5e) return String.fromCharCode(c - 0xfee0);
      if (c === 0x3000) return ' ';
      return ch;
    }

    function isSpace(ch) { return /\s/.test(ch); }

    function parseHex(text) {
      var chars = Array.from(String(text));
      var digits = '';
      var fullwidth = false;
      var start = 0;
      var trimmed = String(text).replace(/^\s+/, '');
      if (/^(0x|0X)/.test(trimmed)) start = chars.length - Array.from(trimmed).length + 2;
      for (var i = start; i < chars.length; i++) {
        var ch = chars[i];
        var f = foldWidth(ch);
        if (f !== ch) fullwidth = true;
        if (isSpace(f) || f === ':') continue;
        if (!/^[0-9a-fA-F]$/.test(f)) return { ok: false, code: 'hexChar', pos: i + 1, ch: ch };
