  }

  @media (max-width: 640px) {
    .hmac-top {
      grid-template-columns: minmax(0, 1fr) 6.6rem auto;
      gap: 0.4rem;
    }

    .hmac-top #hmac-example { padding-inline: 0.7rem; }

    .hmac-top .hmac-cap {
      position: absolute;
