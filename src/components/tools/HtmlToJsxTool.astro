---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
// strings:start
const STRINGS = {
  "en": {
    "inputLabel": "HTML Input",
    "outputLabel": "JSX Output",
    "copy": "Copy",
    "copied": "Copied!",
    "copyFailed": "Copy failed. Please try again.",
    "placeholder": "<!-- paste your HTML here -->",
    "refused": "Cannot convert style at position {position}: {reason}. Output cleared.",
    "reasons": {
      "syntax": "invalid declaration or unclosed CSS syntax",
      "property": "unsupported or escaped property name",
      "duplicate": "repeated property cannot preserve CSS fallback order",
      "priority": "!important cannot be preserved in a React style object",
      "comment": "CSS comments require manual conversion"
    },
    "empty": "Converted JSX will appear here.",
    "tips": {
      "input": "Paste HTML. Conversion runs 200 ms after you stop typing. With focus in this tool, Ctrl/⌘+L clears both panels and the status.",
      "output": "The output is JSX markup without a component wrapper. Styles that cannot be preserved stop conversion, clear the output and disable Copy; the status gives the position and reason.",
      "copy": "Copy the complete displayed JSX. Empty output is not copied."
    }
  },
  "zh": {
    "inputLabel": "HTML 输入",
    "outputLabel": "JSX 输出",
    "copy": "复制",
    "copied": "已复制！",
    "copyFailed": "复制失败，请重试。",
    "placeholder": "<!-- 粘贴 HTML 到这里 -->",
    "refused": "样式第 {position} 个字符无法转换：{reason}。已清空输出。",
    "reasons": {
      "syntax": "声明无效或 CSS 语法未闭合",
      "property": "属性名不支持或含转义",
      "duplicate": "重复属性无法保留 CSS 回退顺序",
      "priority": "React 样式对象无法保留 !important",
      "comment": "CSS 注释需要手动转换"
    },
    "empty": "转换后的 JSX 会显示在这里。",
    "tips": {
      "input": "粘贴 HTML，停止输入 200 毫秒后自动转换。焦点在工具内时，Ctrl/⌘+L 清空两栏与状态。",
      "output": "输出是 JSX 标记，不包含组件外壳。无法保留的样式会停止转换、清空输出并停用复制；状态栏给出位置与原因。",
      "copy": "复制完整显示的 JSX。输出为空时不复制。"
    }
  },
  "ja": {
    "inputLabel": "HTML 入力",
    "outputLabel": "JSX 出力",
    "copy": "コピー",
    "copied": "コピー済み！",
    "copyFailed": "コピーに失敗しました。再試行してください。",
    "placeholder": "<!-- HTMLをここに貼り付け -->",
    "refused": "スタイルの {position} 文字目を変換できません：{reason}。出力を消去しました。",
    "reasons": {
      "syntax": "宣言が無効、または CSS 構文が閉じていません",
      "property": "未対応またはエスケープされたプロパティ名",
      "duplicate": "重複プロパティの CSS フォールバック順序を保持できません",
      "priority": "React のスタイルオブジェクトでは !important を保持できません",
      "comment": "CSS コメントは手動で変換してください"
    },
    "empty": "変換された JSX がここに表示されます。",
    "tips": {
      "input": "HTML を貼り付けます。入力が止まってから 200 ミリ秒後に変換します。ツール内で Ctrl/⌘+L を押すと両欄と状態を消去します。",
      "output": "出力はコンポーネントの外枠を含まない JSX マークアップです。保持できないスタイルがあると変換を止め、出力を消去してコピーを無効にします。位置と理由はステータス欄に表示します。",
      "copy": "表示中の JSX 全体をコピーします。空の出力はコピーしません。"
    }
  },
  "ko": {
    "inputLabel": "HTML 입력",
    "outputLabel": "JSX 출력",
    "copy": "복사",
    "copied": "복사됨!",
    "copyFailed": "복사하지 못했습니다. 다시 시도하세요.",
    "placeholder": "<!-- HTML을 여기에 붙여넣기 -->",
    "refused": "스타일 {position}번째 문자를 변환할 수 없습니다: {reason}. 출력을 지웠습니다.",
    "reasons": {
      "syntax": "잘못된 선언 또는 닫히지 않은 CSS 구문",
      "property": "지원하지 않거나 이스케이프된 속성 이름",
      "duplicate": "중복 속성의 CSS 대체 순서를 보존할 수 없습니다",
      "priority": "React 스타일 객체는 !important를 보존할 수 없습니다",
      "comment": "CSS 주석은 직접 변환해야 합니다"
    },
    "empty": "변환된 JSX가 여기에 표시됩니다.",
    "tips": {
      "input": "HTML을 붙여 넣으세요. 입력을 멈춘 뒤 200밀리초 후에 변환합니다. 도구 안에서 Ctrl/⌘+L을 누르면 두 패널과 상태를 지웁니다.",
      "output": "출력은 컴포넌트 틀을 포함하지 않는 JSX 마크업입니다. 보존할 수 없는 스타일은 변환을 멈추고 출력을 지우며 복사를 끕니다. 상태 줄에 위치와 이유를 표시합니다.",
      "copy": "표시된 JSX 전체를 복사합니다. 빈 출력은 복사하지 않습니다."
    }
  }
};
// strings:end
const T = STRINGS[lang as keyof typeof STRINGS] || STRINGS.en;
const TIPS = T.tips;
const CLIENT_T = { copy: T.copy, copied: T.copied, copyFailed: T.copyFailed, refused: T.refused, reasons: T.reasons };
---
<div class="htj-wrap" data-strings={JSON.stringify(CLIENT_T)}>
  <div class="htj-toolbar">
    <button id="htj-copy" class="htj-copy-btn btn-secondary" type="button">{T.copy}</button>
    <Toggletip id="htj-tip-copy" lang={lang} about={T.copy}>{TIPS.copy}</Toggletip>
  </div>
  <p id="htj-status" role="status" aria-live="polite"></p>
  <div class="htj-panes zt-io">
    <div class="htj-pane zt-io-pane">
      <div class="htj-pane-header">
        <label class="htj-label" for="htj-input">{T.inputLabel}</label>
        <Toggletip id="htj-tip-input" lang={lang} about={T.inputLabel}>{TIPS.input}</Toggletip>
      </div>
      <textarea
        id="htj-input"
        class="htj-textarea zt-io-fill"
        spellcheck="false"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        placeholder={T.placeholder}
      ></textarea>
    </div>
    <div class="htj-pane htj-result-pane zt-io-pane">
      <div class="htj-pane-header">
        <label class="htj-label" for="htj-output">{T.outputLabel}</label>
        <Toggletip id="htj-tip-output" lang={lang} about={T.outputLabel}>{TIPS.output}</Toggletip>
      </div>
      <textarea
        id="htj-output"
        class="htj-textarea htj-textarea--output zt-io-fill"
        spellcheck="false"
        placeholder={T.empty}
        readonly
      ></textarea>
    </div>
  </div>

  <script is:inline>
    (function () {
      var t = JSON.parse(document.querySelector('.htj-wrap').dataset.strings);

      var inputEl  = document.getElementById('htj-input');
      var outputEl = document.getElementById('htj-output');
      var copyBtn  = document.getElementById('htj-copy');
      var statusEl = document.getElementById('htj-status');

      /* ── engine:start ── */
      // ---- Void elements that need explicit self-closing slash ----
      var VOID_TAGS = [
        'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input',
        'link', 'meta', 'param', 'source', 'track', 'wbr',
      ];
      var VOID_RE = new RegExp(
        '<(' + VOID_TAGS.join('|') + ')(\\s[^>]*)?>(?!\\s*</)',
        'gi'
      );

      // ---- Attribute rename map ----
      var ATTR_MAP = {
        'class':           'className',
        'for':             'htmlFor',
        'tabindex':        'tabIndex',
        'readonly':        'readOnly',
        'maxlength':       'maxLength',
        'minlength':       'minLength',
        'colspan':         'colSpan',
        'rowspan':         'rowSpan',
        'crossorigin':     'crossOrigin',
        'contenteditable': 'contentEditable',
        'autofocus':       'autoFocus',
        'accesskey':       'accessKey',
        'enctype':         'encType',
        'usemap':          'useMap',
        'frameborder':     'frameBorder',
        'allowfullscreen': 'allowFullScreen',
        // more HTML attribute names from react-dom possibleStandardNames.js
        'accept-charset':  'acceptCharset',
        'autocapitalize':  'autoCapitalize',
        'autocomplete':    'autoComplete',
        'autoplay':        'autoPlay',
        'cellpadding':     'cellPadding',
        'cellspacing':     'cellSpacing',
        'charset':         'charSet',
        'controlslist':    'controlsList',
        'datetime':        'dateTime',
        'enterkeyhint':    'enterKeyHint',
        'fetchpriority':   'fetchPriority',
        'formaction':      'formAction',
        'formenctype':     'formEncType',
        'formmethod':      'formMethod',
        'formnovalidate':  'formNoValidate',
        'formtarget':      'formTarget',
        'hreflang':        'hrefLang',
        'http-equiv':      'httpEquiv',
        'inputmode':       'inputMode',
        'itemprop':        'itemProp',
        'itemscope':       'itemScope',
        'itemtype':        'itemType',
        'nomodule':        'noModule',
        'novalidate':      'noValidate',
        'playsinline':     'playsInline',
        'popovertarget':   'popoverTarget',
        'referrerpolicy':  'referrerPolicy',
        'spellcheck':      'spellCheck',
        'srcdoc':          'srcDoc',
        'srclang':         'srcLang',
        'srcset':          'srcSet',
      };

      // ---- Event attributes: HTML on* name → React prop name ----
      // React derives its prop names from the camelCase event list in react-dom
      // (DOMEventProperties.js); the lowercase HTML name is the key.
      var REACT_EVENTS = [
        'abort', 'animationEnd', 'animationIteration', 'animationStart', 'auxClick',
        'beforeInput', 'blur', 'cancel', 'canPlay', 'canPlayThrough', 'change', 'click',
        'close', 'compositionEnd', 'compositionStart', 'compositionUpdate', 'contextMenu',
        'copy', 'cut', 'drag', 'dragEnd', 'dragEnter', 'dragExit', 'dragLeave', 'dragOver',
        'dragStart', 'drop', 'durationChange', 'emptied', 'encrypted', 'ended', 'error',
        'focus', 'gotPointerCapture', 'input', 'invalid', 'keyDown', 'keyPress', 'keyUp',
        'load', 'loadedData', 'loadedMetadata', 'loadStart', 'lostPointerCapture',
        'mouseDown', 'mouseEnter', 'mouseLeave', 'mouseMove', 'mouseOut', 'mouseOver',
        'mouseUp', 'paste', 'pause', 'play', 'playing', 'pointerCancel', 'pointerDown',
        'pointerEnter', 'pointerLeave', 'pointerMove', 'pointerOut', 'pointerOver',
        'pointerUp', 'progress', 'rateChange', 'reset', 'resize', 'scroll', 'scrollEnd',
        'seeked', 'seeking', 'select', 'stalled', 'submit', 'suspend', 'timeUpdate',
        'toggle', 'touchCancel', 'touchEnd', 'touchMove', 'touchStart', 'transitionEnd',
        'volumeChange', 'waiting', 'wheel',
      ];
      var EVENT_MAP = { ondblclick: 'onDoubleClick' };
      REACT_EVENTS.forEach(function (name) {
        EVENT_MAP['on' + name.toLowerCase()] = 'on' + name.charAt(0).toUpperCase() + name.slice(1);
      });

      // ---- Decode the entities an attribute value may use (for JS contexts) ----
      var NAMED_ENTITIES = { quot: '"', apos: "'", amp: '&', lt: '<', gt: '>', nbsp: '\u00a0' };
      function decodeEntities(str) {
        return str.replace(/&(#[xX][0-9a-fA-F]+|#[0-9]+|[a-zA-Z]+);/g, function (m, ref) {
          if (ref.charAt(0) === '#') {
            var code = ref.charAt(1) === 'x' || ref.charAt(1) === 'X'
              ? parseInt(ref.slice(2), 16)
              : parseInt(ref.slice(1), 10);
            return code > 0 && code <= 0x10ffff ? String.fromCodePoint(code) : m;
          }
          return Object.prototype.hasOwnProperty.call(NAMED_ENTITIES, ref) ? NAMED_ENTITIES[ref] : m;
        });
      }

      // ---- Inline handler code → arrow function (React needs a function, not a string) ----
      function handlerToFunction(code) {
        code = decodeEntities(code).trim();
        if (!code) return '{(event) => {}}';
        var end = code.indexOf('//') !== -1 || code.indexOf('\n') !== -1 ? '\n' : ' ';
        return '{(event) => { ' + code + end + '}}';
      }

      // CSS declarations split only at top-level semicolons. Preserve JS string bytes.
      function jsxString(value) {
        return JSON.stringify(value).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
      }
      function styleError(code, position) {
        var error = new Error(code + ' at style position ' + (position + 1));
        error.code = code;
        error.position = position;
        throw error;
      }
      function styleStringToObject(styleStr) {
        var props = [];
        var seen = Object.create(null);
        var start = 0, colon = -1, valueEnd = 0, quote = '', stack = [];
        function declaration(end) {
          if (/^[ \t\n\r\f]*$/.test(styleStr.slice(start, end))) return;
          if (colon < start) styleError('syntax', start);
          var prop = styleStr.slice(start, colon).replace(/^[ \t\n\r\f]+|[ \t\n\r\f]+$/g, '');
          var val = styleStr.slice(colon + 1, valueEnd).replace(/^[ \t\n\r\f]+/, '');
          if (!val) styleError('syntax', colon + 1);
          if (!/^(?:--[a-zA-Z0-9_-]+|-?[a-zA-Z][a-zA-Z0-9-]*)$/.test(prop)) styleError('property', start);
          var custom = prop.indexOf('--') === 0;
          var key = custom ? prop : prop.toLowerCase();
          if (seen[key]) styleError('duplicate', start);
          seen[key] = true;
          var jsProp = custom ? prop : key.replace(/^-ms-/, 'ms-').replace(/-([a-z])/g, function (_, c) { return c.toUpperCase(); });
          props.push(jsxString(jsProp) + ': ' + jsxString(val));
        }
        for (var i = 0; i < styleStr.length; i++) {
          var c = styleStr[i];
          if (c === '\\') {
            if (i + 1 === styleStr.length) styleError('syntax', i);
            i++;
            if (/[\n\r\f]/.test(styleStr[i])) {
              if (!quote) styleError('syntax', i - 1);
              if (styleStr[i] === '\r' && styleStr[i + 1] === '\n') i++;
            } else if (/[0-9a-fA-F]/.test(styleStr[i])) {
              var count = 1;
              while (count < 6 && /[0-9a-fA-F]/.test(styleStr[i + 1] || '')) { i++; count++; }
              if (/[ \t\n\r\f]/.test(styleStr[i + 1] || '')) {
                i++;
                if (styleStr[i] === '\r' && styleStr[i + 1] === '\n') i++;
              }
            }
            if (colon >= start) valueEnd = i + 1;
            continue;
          }
          if (colon >= start && !/[ \t\n\r\f]/.test(c) && (c !== ';' || quote || stack.length)) valueEnd = i + 1;
          if (quote) {
            if (c === quote) quote = '';
            else if (/[\n\r\f]/.test(c)) styleError('syntax', i);
            continue;
          }
          if (c === '"' || c === "'") { quote = c; continue; }
          if (c === '/' && styleStr[i + 1] === '*') styleError('comment', i);
          if (c === '(' || c === '[' || c === '{') { stack.push(c); continue; }
          if (c === ')' || c === ']' || c === '}') {
            if (stack.pop() !== { ')': '(', ']': '[', '}': '{' }[c]) styleError('syntax', i);
            continue;
          }
          if (!stack.length) {
            if (c === '!') styleError('priority', i);
            if (c === ':' && colon < start) { colon = i; valueEnd = i + 1; }
            if (c === ';') { declaration(i); start = i + 1; colon = -1; }
          }
        }
        if (quote || stack.length) styleError('syntax', styleStr.length);
        declaration(styleStr.length);
        return '{{ ' + props.join(', ') + ' }}';
      }

      // Encode original text only; generated handler/style expressions stay executable.
      function jsxText(text) {
        return text.replace(/[{}<>]/g, function (c) { return { '{': '&#123;', '}': '&#125;', '<': '&lt;', '>': '&gt;' }[c]; });
      }

      // ---- Process a single tag's attributes ----
      // Only attribute names are converted. Values are copied as written (htmltojsx does the
      // same), except style (→ object) and on* handlers (→ arrow function).
      function jsxAttrName(name) {
        var lower = name.toLowerCase();
        return Object.prototype.hasOwnProperty.call(ATTR_MAP, lower) ? ATTR_MAP[lower] : name;
      }
      var ATTR_RE = /(\s+)([^\s"'>\/=]+)(?:\s*=\s*("[^"]*"|'[^']*'|[^\s"'=<>`]+))?/g;
      function processAttrs(attrStr) {
        if (!attrStr) return '';
        return attrStr.replace(ATTR_RE, function (_, space, name, rawValue) {
          var lower = name.toLowerCase();
          if (rawValue === undefined) {
            return space + jsxAttrName(name);
          }
          var quote = rawValue.charAt(0);
          var quoted = quote === '"' || quote === "'";
          var value = quoted ? rawValue.slice(1, -1) : rawValue;
          if (lower === 'style') {
            return space + 'style=' + styleStringToObject(decodeEntities(value));
          }
          if (Object.prototype.hasOwnProperty.call(EVENT_MAP, lower)) {
            return space + EVENT_MAP[lower] + '=' + handlerToFunction(value);
          }
          return space + jsxAttrName(name) + '=' + (quoted ? rawValue : '"' + value + '"');
        });
      }

      // ---- Main conversion function ----
      var TAG_RE = /<([a-zA-Z][a-zA-Z0-9-]*)((?:\s+[^\s"'>\/=]+(?:\s*=\s*(?:"[^"]*"|'[^']*'|[^\s"'=<>`]+))?)*)\s*(\/?)>/g;
      function htmlToJsx(html) {
        var tokens = new RegExp('<!--[\\s\\S]*?-->|<\\/[a-zA-Z][a-zA-Z0-9-]*\\s*>|' + TAG_RE.source, 'g');
        var result = '', cursor = 0, match;
        while ((match = tokens.exec(html))) {
          result += jsxText(html.slice(cursor, match.index));
          cursor = tokens.lastIndex;
          if (match[0].indexOf('<!--') === 0) {
            result += '{/*' + match[0].slice(4, -3).replace(/\*\//g, '* /') + '*/}';
            continue;
          }
          if (match[0].indexOf('</') === 0) { result += match[0]; continue; }
          var tag = match[1], attrs = match[2], selfClose = match[3];
          var processedAttrs = processAttrs(attrs || '');
          var isVoid = VOID_TAGS.indexOf(tag.toLowerCase()) !== -1;
          var close = (isVoid || selfClose) ? ' />' : '>';
          result += '<' + tag + processedAttrs + close;
        }
        return result + jsxText(html.slice(cursor));
      }
      /* ── engine:end ── */

      var copyRevision = 0;
      var copyTimer;
      var copyError = false;

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        if (copyError && statusEl.textContent === t.copyFailed) statusEl.textContent = '';
        copyError = false;
      }

      function convert() {
        invalidateCopy();
        clearTimeout(_debounce);
        var html = inputEl.value;
        statusEl.textContent = '';
        try {
          outputEl.value = html ? htmlToJsx(html) : '';
          copyBtn.disabled = !outputEl.value;
          if (html) window.trackTool && window.trackTool('html_to_jsx', 'convert');
        } catch (error) {
          outputEl.value = '';
          copyBtn.disabled = true;
          statusEl.textContent = t.refused.replace('{position}', error.position + 1).replace('{reason}', t.reasons[error.code] || t.reasons.syntax);
        }
      }

      var _debounce;
      inputEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_debounce);
        _debounce = setTimeout(convert, 200);
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l') return;
        var widget = document.querySelector('.tool-widget');
        if (!widget || !widget.contains(document.activeElement)) return;
        e.preventDefault();
        invalidateCopy();
        clearTimeout(_debounce);
        inputEl.value = '';
        outputEl.value = '';
        statusEl.textContent = '';
        copyBtn.disabled = true;
        inputEl.focus();
      });

      copyBtn.addEventListener('click', function () {
        var text = outputEl.value;
        if (!text) return;
        invalidateCopy();
        var revision = copyRevision;
        function current() { return revision === copyRevision && outputEl.value === text; }
        function failed() {
          if (!current()) return;
          statusEl.textContent = t.copyFailed;
          copyError = true;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (!current()) return;
            copyBtn.textContent = t.copied;
            copyTimer = setTimeout(function () { if (current()) copyBtn.textContent = t.copy; }, 1500);
          }, failed);
        } catch (error) { failed(); }
      });
    })();
  </script>
</div>

<style>
  .htj-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; gap: 0.5rem; }
  .htj-toolbar, .htj-pane-header { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
  .htj-copy-btn { min-height: 44px; min-width: 6rem; }
  .htj-pane-header { min-height: 28px; flex: none; }
  .htj-label { font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); }
  #htj-status { margin: 0; height: 1.5rem; min-height: 1.5rem; flex: none; overflow: auto; font-size: 0.85rem; line-height: 1.5; }
  .htj-textarea { width: 100%; min-width: 0; overflow: auto; font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.55; padding: 0.65rem 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-secondary); color: var(--color-text); box-sizing: border-box; tab-size: 2; }
  .htj-textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }
  .htj-textarea--output { color: var(--color-text-secondary); cursor: default; }
  @media (max-width: 860px) {
    .htj-textarea { height: 180px; }
    .htj-result-pane:has(#htj-output:placeholder-shown) { display: none; }
    #htj-status { height: 2.5rem; min-height: 2.5rem; }
  }
  @media (max-width: 640px) {
    .htj-textarea { height: 144px; }
    .htj-result-pane textarea { height: 240px; }
  }
</style>
