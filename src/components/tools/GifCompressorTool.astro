    }
    .gc-preview { display: flex; flex-direction: column; gap: 0.35rem; margin: 0; min-width: 0; }
    .gc-preview figcaption {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--color-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .gc-preview-box {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 120px;
      max-height: 360px;
      overflow: hidden;
      border-radius: var(--radius-md);
      background: repeating-conic-gradient(color-mix(in oklch, var(--color-text-muted) 22%, transparent) 0% 25%, transparent 0% 50%) 0 0 / 16px 16px;
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
    }
    .gc-preview-box img {
      display: block;
      max-width: 100%;
      max-height: 360px;
      object-fit: contain;
    }
    .gc-summary {
      margin: 0;
      font-family: var(--font-mono);
      font-size: 0.88rem;
      color: var(--color-text);
      overflow-wrap: anywhere;
    }

    @media (max-width: 640px) {
      /* Keep the summary and Download inside a 390×844 first screen. */
      .gc-workspace { gap: 0.6rem; }
      .gc-info { gap: 0.4rem; }
      .gc-info-item { flex-basis: calc(50% - 0.2rem); padding: 0.4rem 0.65rem; }
      .gc-settings { grid-template-columns: minmax(0, 1fr); }
      .gc-previews { grid-template-columns: minmax(0, 1fr); }
      .gc-check { min-height: 44px; }
    }
  </style>
</div>
