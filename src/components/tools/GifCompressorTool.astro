            if (progress.stage === 'decode') setStatus(fmt(t.statusDecoding, { i: Math.min(progress.frame + 1, progress.frames), n: progress.frames }), 'info');
            else if (progress.stage === 'palette') setStatus(t.statusPalette, 'info');
            else setStatus(fmt(t.statusEncoding, { i: progress.frame, n: progress.frames }), 'info');
            if (r.done) break;
            await yieldToBrowser();
            if (token !== runToken) return;
          }
        } catch (e) {
          if (token !== runToken) return;
          progressEl.hidden = true;
          setStatus(t.statusFailed, 'error');
          return;
        }
        var res = r.value;
        progressEl.hidden = true;
        resultBytes = res.bytes;
        resultUrl = URL.createObjectURL(new Blob([res.bytes], { type: 'image/gif' }));
        imgCompressed.src = resultUrl;
        var change = (res.bytes.length - fileSize) / fileSize * 100;
        var pct = (change > 0 ? '+' : change < 0 ? '−' : '') + Math.abs(change).toFixed(0) + '%';
        summaryEl.textContent = fmt(t.summary, {
          from: formatBytes(fileSize), to: formatBytes(res.bytes.length), pct: pct,
          w: res.width, h: res.height, n: res.frameCount, c: res.colorCount,
        });
        resultEl.hidden = false;
        if (!res.complete) setStatus(fmt(t.statusTruncated, { n: gif.frames.length }), 'info');
        else if (res.bytes.length >= fileSize) setStatus(t.statusBigger, 'info');
        else setStatus(t.statusDone, 'success');
        if (window.trackTool) window.trackTool(SLUG, 'compress');
      }

      function resetCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyTimer = 0;
        if (copyButton) copyButton.textContent = t[copyRestoreKey];
        copyButton = null;
      }

      function copyText(text, btn, restoreKey) {
        resetCopy();
        var request = copyRevision, token = runToken;
        copyButton = btn;
        copyRestoreKey = restoreKey;
        function current() { return request === copyRevision && token === runToken; }
        function failed() { if (current()) setStatus(t.statusCopyFailed, 'error'); }
        function done() {
          if (!current()) return;
          btn.textContent = t.copied;
          if (statusEl.textContent === t.statusCopyFailed) setStatus('', 'none');
          copyTimer = setTimeout(function () {
            if (!current()) return;
            btn.textContent = t[restoreKey];
            copyTimer = 0;
          }, 1500);
        }
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            Promise.resolve(navigator.clipboard.writeText(text)).then(done, failed);
          } else {
            failed();
          }
        } catch (e) { failed(); }
      }

      /* ── Input: drop zone click / keyboard / drag / paste ── */
      dropEl.addEventListener('click', function (e) {
        if (e.target !== fileInput) fileInput.click();
      });
      dropEl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
      });
      dropEl.addEventListener('dragover', function (e) { e.preventDefault(); dropEl.classList.add('drag-over'); });
      dropEl.addEventListener('dragleave', function () { dropEl.classList.remove('drag-over'); });
      fileInput.addEventListener('change', function () {
        if (this.files && this.files[0]) loadFile(this.files[0]);
        this.value = '';
      });
      wrapEl.addEventListener('dragover', function (e) { e.preventDefault(); });
      wrapEl.addEventListener('drop', function (e) {
        e.preventDefault();
        dropEl.classList.remove('drag-over');
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) loadFile(e.dataTransfer.files[0]);
      });
      document.addEventListener('paste', function (e) {
        if (!e.clipboardData || !e.clipboardData.files || !e.clipboardData.files.length) return;
        e.preventDefault();
        loadFile(e.clipboardData.files[0]);
      });

      /* ── Settings (persisted as preferences; width is per file) ── */
      lossyInput.addEventListener('input', function () {
        prefs.lossy = normalizeLossy(lossyInput.value);
        lossyVal.textContent = String(prefs.lossy);
        savePrefs();
      });
      colorsSelect.addEventListener('change', function () {
        prefs.colors = normalizeColors(colorsSelect.value);
        savePrefs();
      });
      stepSelect.addEventListener('change', function () {
        prefs.step = normalizeStep(stepSelect.value);
        savePrefs();
      });
      ditherInput.addEventListener('change', function () {
        prefs.dither = ditherInput.checked;
        savePrefs();
      });
      widthInput.addEventListener('input', updateWidthHint);
      widthInput.addEventListener('change', function () {
        if (!gif) return;
        widthInput.value = String(normalizeWidth(widthInput.value, gif.width));
        updateWidthHint();
      });

      /* ── Actions ── */
      runBtn.addEventListener('click', function () { runCompress(); });
      downloadBtn.addEventListener('click', function () {
        if (!resultBytes) return;
        downloadBlob(new Blob([resultBytes], { type: 'image/gif' }), base + '-compressed.gif');
        if (window.trackTool) window.trackTool(SLUG, 'download');
      });
      limitCopyBtn.addEventListener('click', function () {
        copyText(limitCmdEl.textContent, limitCopyBtn, 'copyCommand');
      });
      resetBtn.addEventListener('click', function () {
        resetState();
        setStatus('', 'none');
        dropEl.focus();
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l' || !wrapEl.contains(document.activeElement)) return;
        e.preventDefault();
        resetState();
        setStatus('', 'none');
      });

      loadPrefs();
      applyPrefsToUI();
    })();
  </script>

  <style is:global>
    .gc-wrap { display: flex; flex-direction: column; gap: 0.85rem; }
    /* Author display rules beat the UA [hidden] rule; restore it. */
    .gc-wrap [hidden] { display: none; }

    .gc-drop {
      position: relative;
      border: 2px dashed var(--color-border);
      border-radius: var(--radius-md);
      padding: 2rem 1rem;
      text-align: center;
      cursor: pointer;
      transition: border-color var(--transition-fast), background var(--transition-fast);
      background: var(--color-bg-secondary);
    }
    .gc-drop:hover,
    .gc-drop.drag-over {
      border-color: var(--color-primary);
      background: var(--color-surface);
    }
    .gc-drop:focus-visible {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 4px var(--color-primary-light);
    }
    .gc-drop-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      color: var(--color-text-secondary);
      pointer-events: none;
    }
    .gc-drop-inner p { margin: 0; font-size: 0.95rem; }
    .gc-drop-inner .gc-hint { font-size: 0.8rem; }
    .gc-file-input {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }

    .gc-limit {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      padding: 0.85rem 1rem;
      border-radius: var(--radius-md);
      background: var(--color-bg-secondary);
      box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-danger) 45%, transparent);
    }
    .gc-limit-msg { margin: 0; font-size: 0.88rem; color: var(--color-text); }
    .gc-limit-cmd-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .gc-limit-cmd {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      padding: 0.35rem 0.6rem;
      border-radius: var(--radius-sm);
      background: var(--color-surface);
      color: var(--color-text);
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
      overflow-wrap: anywhere;
    }

    .gc-workspace { display: flex; flex-direction: column; gap: 0.85rem; }

    .gc-info { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; }
    .gc-info-item {
      flex: 1 1 120px;
      padding: 0.5rem 0.75rem;
      border-radius: var(--radius-md);
      background: var(--color-bg-secondary);
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
    }
    .gc-info-item dt {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--color-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .gc-info-item dd {
      margin: 0.15rem 0 0;
      font-family: var(--font-mono);
      font-size: 0.9rem;
      color: var(--color-text);
    }

    .gc-panel {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 0.9rem 1rem;
      border-radius: var(--radius-md);
      background: var(--color-bg-secondary);
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
    }
    .gc-panel-title {
      margin: 0;
      font-family: var(--font-sans);
      font-size: 0.95rem;
      font-weight: 760;
      color: var(--color-text);
    }
    .gc-settings {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
      gap: 0.75rem 1rem;
    }
    .gc-field { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
    .gc-field-lossy { grid-column: 1 / -1; }
    .gc-range-label {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text-secondary);
    }
    .gc-range-label strong { font-family: var(--font-mono); color: var(--color-text); }
    .gc-field-hint {
      margin: 0;
      font-size: 0.78rem;
      color: var(--color-text-muted);
    }
    .gc-select-input,
    .gc-num { width: 100%; }
    .gc-check {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      grid-column: 1 / -1;
      justify-self: start;
      min-height: 40px;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--color-text-secondary);
      cursor: pointer;
    }
    .gc-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .gc-progress {
      width: 100%;
