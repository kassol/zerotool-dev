      function fmt(str, vars) {
        return str.replace(/\{(\w+)\}/g, function (m, k) { return vars[k] !== undefined ? String(vars[k]) : m; });
      }

      /* ── engine:start ── */
      // Pure, DOM-free GIF decoding and compression — extracted verbatim by
      // scripts/test-gif-compressor.mjs. Keep this block free of DOM/canvas
      // APIs. The decoder functions (GS_LIMITS through checkBudget) are a
      // copy of the GifSplitterTool engine block; change both together.

      // Decoding budget. Frames are kept as RGBA in memory: 50M px = 200 MB.
      // 16,777,216 px (4096²) is the iOS Safari per-canvas area limit.
      var GS_LIMITS = { maxPixels: 50000000, maxFrames: 1000, maxCanvasArea: 16777216, maxSide: 16384 };

      function isGif(bytes) {
        if (!bytes || bytes.length < 6) return false;
        return bytes[0] === 0x47 && bytes[1] === 0x49 && bytes[2] === 0x46 && bytes[3] === 0x38 &&
          (bytes[4] === 0x37 || bytes[4] === 0x39) && bytes[5] === 0x61;
      }

      // Walk a chain of data sub-blocks starting at `p` without copying.
      // Tolerates a file that ends mid-chain: `size` counts the data bytes
      // that are present and complete=false. `end` is just past the chain.
      function scanSubBlocks(bytes, p) {
        var len = bytes.length, q = p, size = 0;
        while (q < len) {
          var n = bytes[q];
          if (n === 0) return { size: size, end: q + 1, complete: true };
          size += Math.min(n, len - q - 1);
          q += 1 + n;
        }
        return { size: size, end: len, complete: false };
      }

      // Concatenate a chain of data sub-blocks starting at `p` (used for the
      // small extension blocks; image data is read in place by lzwRun).
      function readSubBlocks(bytes, p) {
        var len = bytes.length, q = p;
        var scan = scanSubBlocks(bytes, p);
        var data = new Uint8Array(scan.size), o = 0;
        while (q < len) {
          var n2 = bytes[q];
          if (n2 === 0) { q++; break; }
          var take = Math.min(n2, len - q - 1);
          data.set(bytes.subarray(q + 1, q + 1 + take), o);
          o += take;
          q += 1 + n2;
        }
        return { data: data, end: scan.end, complete: scan.complete };
      }

