---
// GifCompressorTool — shrinks an animated GIF in the browser: frame skipping,
// area-average resizing, a global palette (exact or median cut), optional
// Floyd–Steinberg dithering, frame differencing and a lossy LZW encoder.
// The GIF decoder is a verbatim copy of the one in GifSplitterTool
// (scripts/test-gif-compressor.mjs checks that both copies match).
// No upload. Only settings are persisted (policy: preference).
---

<div>
  <div class="gc-wrap" id="gc-wrap">
    <div id="gc-drop" class="gc-drop" role="button" tabindex="0">
      <div class="gc-drop-inner">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
        </svg>
        <p data-i18n="dropHint">Drop a GIF here, or <strong>click to select</strong></p>
        <p class="gc-hint" data-i18n="pasteHint">You can also paste a copied GIF file with Ctrl/Cmd+V</p>
        <p class="gc-hint" data-i18n="formatsHint">Animated or static GIF (GIF87a / GIF89a)</p>
      </div>
      <input type="file" id="gc-file" accept="image/gif,.gif" class="gc-file-input" tabindex="-1" aria-label="Select a GIF file" data-i18n-aria="dropAria" />
    </div>

    <div id="gc-limit" class="gc-limit" hidden>
      <p id="gc-limit-msg" class="gc-limit-msg"></p>
      <div class="gc-limit-cmd-row">
        <code id="gc-limit-cmd" class="gc-limit-cmd">gifsicle -O3 --lossy=80 --colors 128 input.gif -o output.gif</code>
        <button type="button" id="gc-limit-copy" class="btn-copy" data-i18n="copyCommand">Copy command</button>
      </div>
    </div>

    <div id="gc-workspace" class="gc-workspace" hidden>
      <dl class="gc-info">
        <div class="gc-info-item"><dt data-i18n="infoSize">Size</dt><dd id="gc-info-size"></dd></div>
        <div class="gc-info-item"><dt data-i18n="infoFrames">Frames</dt><dd id="gc-info-frames"></dd></div>
        <div class="gc-info-item"><dt data-i18n="infoDuration">Duration</dt><dd id="gc-info-duration"></dd></div>
        <div class="gc-info-item"><dt data-i18n="infoLoop">Repeats after first play</dt><dd id="gc-info-loop"></dd></div>
        <div class="gc-info-item"><dt data-i18n="infoFile">File size</dt><dd id="gc-info-file"></dd></div>
      </dl>

      <progress id="gc-progress" class="gc-progress" max="1" value="0" aria-label="Compression progress" data-i18n-aria="progressAria" hidden></progress>

      <section id="gc-result" class="gc-panel" hidden>
        <p id="gc-summary" class="gc-summary"></p>
        <div class="gc-actions">
          <button type="button" id="gc-download" class="btn-primary" data-i18n="download">Download GIF</button>
        </div>
        <div class="gc-previews">
          <figure class="gc-preview">
            <figcaption data-i18n="originalTitle">Original</figcaption>
            <div class="gc-preview-box"><img id="gc-img-original" alt="Original GIF" data-i18n-alt="originalAlt" /></div>
          </figure>
          <figure class="gc-preview">
            <figcaption data-i18n="compressedTitle">Compressed</figcaption>
            <div class="gc-preview-box"><img id="gc-img-compressed" alt="Compressed GIF" data-i18n-alt="compressedAlt" /></div>
          </figure>
        </div>
      </section>

      <section class="gc-panel">
        <h2 class="gc-panel-title" data-i18n="settingsTitle">Compression settings</h2>
        <div class="gc-settings">
          <div class="gc-field gc-field-lossy">
            <label for="gc-lossy" class="gc-range-label">
              <span data-i18n="lossyLabel">Lossy</span> <strong id="gc-lossy-val">40</strong>
            </label>
            <input type="range" id="gc-lossy" min="0" max="100" step="1" value="40" aria-describedby="gc-lossy-hint" />
            <p id="gc-lossy-hint" class="gc-field-hint" data-i18n="lossyHint">0 = lossless. Higher values allow larger color shifts for a smaller file.</p>
          </div>
          <label class="gc-field">
            <span class="tool-label" data-i18n="colorsLabel">Colors</span>
            <select id="gc-colors" class="tool-input gc-select-input">
              <option value="256">256</option>
              <option value="128">128</option>
              <option value="64">64</option>
              <option value="32">32</option>
              <option value="16">16</option>
              <option value="8">8</option>
              <option value="4">4</option>
            </select>
          </label>
          <div class="gc-field">
            <label for="gc-width" class="tool-label" data-i18n="widthLabel">Width (px)</label>
            <input type="number" id="gc-width" class="tool-input gc-num" min="1" step="1" inputmode="numeric" aria-describedby="gc-width-hint" />
            <p id="gc-width-hint" class="gc-field-hint"></p>
          </div>
          <label class="gc-field">
            <span class="tool-label" data-i18n="framesLabel">Frames</span>
            <select id="gc-step" class="tool-input gc-select-input">
              <option value="1" data-i18n="stepAll">Keep all</option>
              <option value="2" data-i18n="step2">Every 2nd frame</option>
              <option value="3" data-i18n="step3">Every 3rd frame</option>
              <option value="4" data-i18n="step4">Every 4th frame</option>
            </select>
          </label>
          <label class="gc-check">
            <input type="checkbox" id="gc-dither" />
            <span data-i18n="ditherLabel">Dithering</span>
          </label>
        </div>
        <div class="gc-actions">
          <button type="button" id="gc-run" class="btn-primary" data-i18n="compress">Compress</button>
          <button type="button" id="gc-reset" class="btn-ghost" data-i18n="reset">Open another GIF</button>
        </div>
      </section>
    </div>

    <div id="gc-status" class="tool-status" aria-live="polite"></div>
  </div>

