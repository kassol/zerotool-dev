---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: {
    empty: "Enter JSON or load the example to generate Kotlin.",
    tips: {
      "input": "Enter valid JSON without comments or trailing commas. Generation runs 300 ms after typing stops; invalid JSON clears the output and shows an error.",
      "rootName": "A blank name uses RootObject. Spaces and symbols are removed and the name becomes PascalCase. Click Generate Kotlin to apply a changed name.",
      "generate": "Generate now with the current JSON and root name. Ctrl/⌘+Enter also generates.",
      "example": "Replace JSON with a sample containing nested objects, arrays and null, then generate immediately with the current settings.",
      "clear": "Clear JSON, output and status. Keep the root name. Ctrl/⌘+L with focus in the tool also clears the root name.",
      "copy": "Copy the complete displayed Kotlin output, including imports, into a .kt file. Empty output is not copied."
    },
    rootName: 'Root class name',
    jsonInput: 'JSON Input',
    kotlinOutput: 'Kotlin Output',
    example: 'Example',
    clear: 'Clear',
    copy: 'Copy',
    copied: 'Copied!',
    copyFailed: 'Copy failed. Please copy the output manually.',
    generate: 'Generate Kotlin',
    msgInvalidJson: 'Invalid JSON: ',
    msgGenerated: 'Generated.',
    msgGenOne: 'Generated 1 data class.',
    msgGenMany: 'Generated {n} data classes.',
    msgRootList: 'The root is an array: decode it as {type}.',
  },
  zh: {
    empty: "输入 JSON 或载入示例以生成 Kotlin。",
    tips: {
      "input": "输入合法 JSON，不能带注释或末尾逗号。停止输入 300 毫秒后自动生成；JSON 无效时会清空输出并显示错误。",
      "rootName": "留空时使用 RootObject。空格与符号会被去掉，名称转为 PascalCase。修改后点击「生成 Kotlin」应用。",
      "generate": "立即按当前 JSON 和根名生成，也可按 Ctrl/⌘+Enter 生成。",
      "example": "用含嵌套对象、数组和 null 的示例替换 JSON，并按当前设置立即生成。",
      "clear": "清空 JSON、输出和状态，保留根名。在工具内按 Ctrl/⌘+L 还会清空根名。",
      "copy": "复制当前显示的完整 Kotlin 输出（含 import），可粘贴到 .kt 文件。输出为空时不复制。"
    },
    rootName: '根类名称',
    jsonInput: 'JSON 输入',
    kotlinOutput: 'Kotlin 输出',
    example: '示例',
    clear: '清空',
    copy: '复制',
    copied: '已复制！',
    copyFailed: '复制失败，请手动复制输出。',
    generate: '生成 Kotlin',
    msgInvalidJson: 'JSON 格式错误：',
    msgGenerated: '已生成。',
    msgGenOne: '已生成 1 个 data class。',
    msgGenMany: '已生成 {n} 个 data class。',
    msgRootList: '根是数组：按 {type} 解码。',
  },
  ja: {
    empty: "JSON を入力するかサンプルを読み込むと、Kotlin を生成します。",
    tips: {
      "input": "コメントや末尾のカンマを含まない有効な JSON を入力します。入力を止めてから 300 ミリ秒後に生成します。無効な JSON では出力を消去し、エラーを表示します。",
      "rootName": "空欄では RootObject を使います。空白や記号を取り除き、名前を PascalCase にします。変更後は「Kotlin を生成」をクリックして適用します。",
      "generate": "現在の JSON とルート名で生成します。Ctrl/⌘+Enter でも生成できます。",
      "example": "JSON を、ネストされたオブジェクト、配列、null を含むサンプルに置き換え、現在の設定ですぐに生成します。",
      "clear": "JSON、出力、ステータスを消去し、ルート名を保持します。ツール内で Ctrl/⌘+L を押すとルート名も消去します。",
      "copy": "import を含む Kotlin 出力を全文コピーし、.kt ファイルに貼り付けます。出力が空の場合はコピーしません。"
    },
    rootName: 'ルートクラス名',
    jsonInput: 'JSON 入力',
    kotlinOutput: 'Kotlin 出力',
    example: 'サンプル',
    clear: 'クリア',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyFailed: 'コピーに失敗しました。出力を手動でコピーしてください。',
    generate: 'Kotlin を生成',
    msgInvalidJson: '無効なJSON：',
    msgGenerated: '生成しました。',
    msgGenOne: '1 個のデータクラスを生成しました。',
    msgGenMany: '{n} 個のデータクラスを生成しました。',
    msgRootList: 'ルートが配列なので {type} としてデコードしてください。',
  },
  ko: {
    empty: "JSON을 입력하거나 예시를 불러와 Kotlin 코드를 생성하세요.",
    tips: {
      "input": "주석이나 끝 쉼표가 없는 유효한 JSON을 입력하세요. 입력을 멈춘 뒤 300밀리초 후 생성합니다. JSON이 잘못되면 출력을 지우고 오류를 표시합니다.",
      "rootName": "비워 두면 RootObject를 사용합니다. 공백과 기호를 제거하고 이름을 PascalCase로 바꿉니다. 이름을 바꾼 뒤 Kotlin 생성 버튼을 눌러 적용하세요.",
      "generate": "현재 JSON과 루트 이름으로 즉시 생성합니다. Ctrl/⌘+Enter로도 생성할 수 있습니다.",
      "example": "JSON을 중첩 객체, 배열, null이 포함된 예시로 바꾸고 현재 설정으로 즉시 생성합니다.",
      "clear": "JSON, 출력, 상태를 지우고 루트 이름은 유지합니다. 도구 안에서 Ctrl/⌘+L을 누르면 루트 이름도 지웁니다.",
      "copy": "import를 포함한 Kotlin 출력 전체를 복사해 .kt 파일에 붙여 넣으세요. 출력이 비어 있으면 복사하지 않습니다."
    },
    rootName: '루트 클래스 이름',
    jsonInput: 'JSON 입력',
    kotlinOutput: 'Kotlin 출력',
    example: '예시',
    clear: '지우기',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사하지 못했습니다. 출력을 직접 복사하세요.',
    generate: 'Kotlin 생성',
    msgInvalidJson: '잘못된 JSON: ',
    msgGenerated: '생성 완료.',
    msgGenOne: '데이터 클래스 1개를 생성했습니다.',
    msgGenMany: '데이터 클래스 {n}개를 생성했습니다.',
    msgRootList: '루트가 배열이므로 {type}로 디코딩하세요.',
  },
};

const L = STRINGS[lang];
---

<div
  class="jkt-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-msg-invalid-json={L.msgInvalidJson}
  data-msg-generated={L.msgGenerated}
  data-msg-gen-one={L.msgGenOne}
  data-msg-gen-many={L.msgGenMany}
  data-msg-root-list={L.msgRootList}
>
  <div class="jkt-config">
    <div class="jkt-name-field">
      <div class="jkt-control-label">
        <label for="jkt-root-name">{L.rootName}</label>
        <Toggletip id="jkt-tip-root-name" lang={lang} about={L.rootName}>{L.tips.rootName}</Toggletip>
      </div>
      <input id="jkt-root-name" type="text" value="RootObject" spellcheck="false" />
    </div>
  </div>
  <div class="jkt-actions">
    <div class="jkt-control-label">
      <button id="jkt-convert" class="btn-primary" type="button">{L.generate}</button>
      <Toggletip id="jkt-tip-generate" lang={lang} about={L.generate}>{L.tips.generate}</Toggletip>
    </div>
    <div class="jkt-control-label">
      <button id="jkt-example" class="btn-ghost" type="button">{L.example}</button>
      <Toggletip id="jkt-tip-example" lang={lang} about={L.example}>{L.tips.example}</Toggletip>
    </div>
    <div class="jkt-control-label">
      <button id="jkt-clear" class="btn-ghost" type="button">{L.clear}</button>
      <Toggletip id="jkt-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip>
    </div>
  </div>
  <div id="jkt-status" class="jkt-status" aria-live="polite"></div>
  <div class="jkt-panels zt-io">
    <div class="jkt-panel zt-io-pane">
      <div class="jkt-panel-header">
        <div class="jkt-control-label">
          <label for="jkt-input">{L.jsonInput}</label>
          <Toggletip id="jkt-tip-input" lang={lang} about={L.jsonInput}>{L.tips.input}</Toggletip>
        </div>
      </div>
      <textarea id="jkt-input" class="zt-io-fill" placeholder='{"name": "Alice", "age": 30}' spellcheck="false"></textarea>
    </div>
    <div class="jkt-panel jkt-output-pane zt-io-pane">
      <div class="jkt-panel-header">
        <span id="jkt-output-label">{L.kotlinOutput}</span>
        <div class="jkt-output-actions">
    <div class="jkt-control-label">
      <button id="jkt-copy" class="btn-ghost" type="button">{L.copy}</button>
      <Toggletip id="jkt-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip>
    </div>
        </div>
      </div>
      <p class="jkt-empty zt-io-fill">{L.empty}</p>
      <pre id="jkt-output" class="jkt-output zt-io-fill" tabindex="0" aria-labelledby="jkt-output-label"><code id="jkt-output-code"></code></pre>
    </div>
  </div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.jkt-wrap')
        : document.querySelector('.jkt-wrap');

      var COPY = wrap ? wrap.dataset.copy : 'Copy';
      var COPIED = wrap ? wrap.dataset.copied : 'Copied!';
      var COPY_FAILED = wrap ? wrap.dataset.copyFailed : 'Copy failed. Please copy the output manually.';
      var MSG_INVALID = wrap ? wrap.dataset.msgInvalidJson : 'Invalid JSON: ';
      var MSG_GENERATED = wrap ? wrap.dataset.msgGenerated : 'Generated.';
      var MSG_GEN_ONE = wrap ? wrap.dataset.msgGenOne : 'Generated 1 data class.';
      var MSG_GEN_MANY = wrap ? wrap.dataset.msgGenMany : 'Generated {n} data classes.';
      var MSG_ROOT_LIST = wrap ? wrap.dataset.msgRootList : 'The root is an array: decode it as {type}.';

      var inputEl = document.getElementById('jkt-input');
      var outputCodeEl = document.getElementById('jkt-output-code');
      var statusEl = document.getElementById('jkt-status');
      var rootNameEl = document.getElementById('jkt-root-name');
      var copyBtn = document.getElementById('jkt-copy');
      var copyRevision = 0;
      var copyTimer = null;
      var copyFailure = false;

      var EXAMPLE = JSON.stringify({
        id: 1,
        name: "Alice",
        isActive: true,
        score: 9.5,
        tags: ["kotlin", "json"],
        address: {
          city: "London",
          zip: "EC1A 1BB"
        },
        friends: [
          { id: 2, name: "Bob" },
          { id: 3, name: "Carol" }
        ],
        metadata: null
      }, null, 2);

      function setStatus(msg, isError) {
        copyFailure = false;
        statusEl.textContent = msg;
        statusEl.className = 'jkt-status ' + (isError ? 'error' : 'success');
      }
      function clearStatus() {
        copyFailure = false;
        statusEl.textContent = '';
        statusEl.className = 'jkt-status';
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        if (copyFailure) clearStatus();
      }

      /* ── engine:start ── */
      /* Generates kotlinx.serialization data classes that compile with the
         serialization plugin and decode the sample with the default Json
         configuration. Values whose type cannot be fixed from the sample
         (null, an empty array, mixed types) become JsonElement, the type
         kotlinx.serialization provides for arbitrary JSON (Any has no serializer). */
      function hasOwn(o, k) { return Object.prototype.hasOwnProperty.call(o, k); }

      // JSON.parse turns 19.0 into 19. Where the browser passes the source text to the reviver
      // (JSON.parse source text access; Chrome 114+, Firefox 135+, Safari 18.4+), a number
      // written with "." or an exponent is kept as a JsonFloat so it maps to Double.
      function JsonFloat(value) { this.value = value; }
      function parseJson(raw) {
        return JSON.parse(raw, function (k, v, ctx) {
          if (typeof v === 'number' && ctx && typeof ctx.source === 'string' && /[.eE]/.test(ctx.source)) return new JsonFloat(v);
          return v;
        });
      }
      function isObject(v) {
        return v !== null && typeof v === 'object' && !Array.isArray(v) && !(v instanceof JsonFloat);
      }

      // Hard keywords cannot be used as names without backticks (Kotlin grammar, "Keywords and operators").
      var HARD_KEYWORDS = ['as', 'break', 'class', 'continue', 'do', 'else', 'false', 'for', 'fun', 'if', 'in',
        'interface', 'is', 'null', 'object', 'package', 'return', 'super', 'this', 'throw', 'true', 'try',
        'typealias', 'typeof', 'val', 'var', 'when', 'while'];
      // Class names that would hide a type the generated code uses.
      var RESERVED_TYPES = ['Any', 'Boolean', 'Double', 'Int', 'Long', 'String', 'List', 'Unit', 'Nothing',
        'JsonElement', 'JsonNull', 'Serializable', 'SerialName'];

      function words(str) {
        return String(str).split(/[^\p{L}\p{N}]+/u).filter(Boolean);
      }
      function toPascalCase(str) {
        var name = words(str).map(function (w) { return w.charAt(0).toUpperCase() + w.slice(1); }).join('');
        if (!/^\p{L}/u.test(name)) name = 'X' + name;
        return name;
      }
      function toCamelCase(str) {
        var ws = words(str);
        var name = ws.map(function (w, i) {
          return i === 0 ? w.charAt(0).toLowerCase() + w.slice(1) : w.charAt(0).toUpperCase() + w.slice(1);
        }).join('');
        if (!/^\p{L}/u.test(name)) name = '_' + name;
        return name;
      }
      function className(str) {
        var name = toPascalCase(str);
        return RESERVED_TYPES.indexOf(name) >= 0 ? name + 'Value' : name;
      }

      // Kotlin string literal: \t \b \n \r \" \\ \$ are escapes; other control characters use \uXXXX.
      function kotlinString(s) {
        var out = '"';
        for (var i = 0; i < s.length; i++) {
          var c = s.charAt(i), code = s.charCodeAt(i);
          if (c === '"') out += '\\"';
          else if (c === '\\') out += '\\\\';
          else if (c === '$') out += '\\$';
          else if (c === '\n') out += '\\n';
          else if (c === '\r') out += '\\r';
          else if (c === '\t') out += '\\t';
          else if (c === '\b') out += '\\b';
          else if (code < 0x20 || code === 0x7f || code === 0x2028 || code === 0x2029) out += '\\u' + ('000' + code.toString(16)).slice(-4);
          else out += c;
        }
        return out + '"';
      }

      function newState(rootName) {
        var reserved = {};
        reserved[rootName] = true;
        RESERVED_TYPES.forEach(function (t) { reserved[t] = true; });
        return { list: [], byName: Object.create(null), reserved: reserved, uses: {} };
      }
      function openSlot(state) {
        var slot = { name: null, base: null, sig: null, fields: null };
        state.list.push(slot);
        return slot;
      }
      // A nested object gets the PascalCase of its key; when that name is taken by a class with
      // different fields, the parent's name is put in front (meta in Payment → PaymentMeta), then
      // a number is added. An object with the same fields as an earlier one of the same key
      // reuses that class.
      function closeSlot(state, slot, base, parent, fields, fixedName) {
        var sig = JSON.stringify(fields);
        if (fixedName) {
          slot.name = fixedName; slot.base = base; slot.sig = sig; slot.fields = fields;
          state.byName[fixedName] = slot;
          return fixedName;
        }
        for (var i = 0; i < state.list.length; i++) {
          var other = state.list[i];
          if (other !== slot && other.base === base && other.sig === sig) {
            state.list.splice(state.list.indexOf(slot), 1);
            return other.name;
          }
        }
        var candidates = [base];
        if (parent) candidates.push(parent + base);
        var name = null;
        for (var c = 0; c < candidates.length && !name; c++) {
          if (!state.byName[candidates[c]] && !state.reserved[candidates[c]]) name = candidates[c];
        }
        for (var n = 2; !name; n++) {
          if (!state.byName[base + n] && !state.reserved[base + n]) name = base + n;
        }
        slot.name = name; slot.base = base; slot.sig = sig; slot.fields = fields;
        state.byName[name] = slot;
        return name;
      }

      var NUMERIC = ['Int', 'Long', 'Double'];
      function numberType(v) {
        if (v instanceof JsonFloat) return 'Double';
        if (!Number.isInteger(v)) return 'Double';
        if (v >= -2147483648 && v <= 2147483647) return 'Int';
        if (Math.abs(v) <= 9223372036854775807) return 'Long';
        return 'Double';
      }
      // Several types for one value: numbers widen (Int < Long < Double); anything else mixed is JsonElement.
      function combineTypes(types, state) {
        if (types.length === 0) { state.uses.JsonElement = true; return 'JsonElement'; }
        if (types.length === 1) return types[0];
        if (types.every(function (t) { return NUMERIC.indexOf(t) >= 0; })) {
          return NUMERIC[Math.max.apply(null, types.map(function (t) { return NUMERIC.indexOf(t); }))];
        }
        state.uses.JsonElement = true;
        return 'JsonElement';
      }
      function addType(types, t) { if (types.indexOf(t) < 0) types.push(t); }

      /* Base type (without ?) of a non-null value. */
      function inferType(value, key, parent, state) {
        if (value instanceof JsonFloat || typeof value === 'number') return numberType(value);
        if (typeof value === 'boolean') return 'Boolean';
        if (typeof value === 'string') return 'String';
        if (Array.isArray(value)) {
          var types = [], objects = [], hasNull = false;
          value.forEach(function (item) {
            if (item === null) hasNull = true;
            else if (isObject(item)) objects.push(item);
            else addType(types, inferType(item, key, parent, state));
          });
          if (objects.length) addType(types, mergeObjects(objects, className(key) + 'Item', parent, state, null));
          return 'List<' + combineTypes(types, state) + (hasNull ? '?' : '') + '>';
        }
        if (isObject(value)) return buildClass([value], className(key), parent, state, null);
        state.uses.JsonElement = true;
        return 'JsonElement';
      }

      function defaultValue(type, nullable, state) {
        if (nullable) return 'null';
        if (type === 'Int') return '0';
        if (type === 'Long') return '0L';
        if (type === 'Double') return '0.0';
        if (type === 'Boolean') return 'false';
        if (type === 'String') return '""';
        if (type.indexOf('List<') === 0) return 'emptyList()';
        if (type === 'JsonElement') { state.uses.JsonNull = true; return 'JsonNull'; }
        return type + '()';
      }

      function fieldLines(entries, state) {
        var used = Object.create(null);
        return entries.map(function (e) {
          var name = toCamelCase(e.key);
          if (used[name]) {
            var n = 2;
            while (used[name + n]) n++;
            name = name + n;
          }
          used[name] = true;
          var lines = [];
          if (name !== e.key) {
            state.uses.SerialName = true;
            lines.push('    @SerialName(' + kotlinString(e.key) + ')');
          }
          var ident = HARD_KEYWORDS.indexOf(name) >= 0 ? '`' + name + '`' : name;
          lines.push('    val ' + ident + ': ' + e.type + (e.nullable ? '?' : '') + ' = ' + defaultValue(e.type, e.nullable, state));
          return lines.join('\n');
        });
      }

      /* One class from one or more sample objects. A key is nullable when it is null in any sample
         or missing from some samples. */
      function buildClass(objects, base, parent, state, fixedName) {
        return mergeObjects(objects, base, parent, state, fixedName);
      }
      function mergeObjects(objects, base, parent, state, fixedName) {
        var slot = openSlot(state);
        var context = fixedName || base;
        var info = Object.create(null);
        var order = [];
        objects.forEach(function (o) {
          Object.keys(o).forEach(function (k) {
            if (!(k in info)) { info[k] = { count: 0, hasNull: false }; order.push(k); }
            info[k].count++;
            if (o[k] === null) info[k].hasNull = true;
          });
        });
        var entries = order.map(function (k) {
          var types = [], nested = [];
          objects.forEach(function (o) {
            if (!hasOwn(o, k) || o[k] === null) return;
            if (isObject(o[k])) nested.push(o[k]);
            else addType(types, inferType(o[k], k, context, state));
          });
          if (nested.length) addType(types, mergeObjects(nested, className(k), context, state, null));
          return {
            key: k,
            type: combineTypes(types, state),
            nullable: info[k].hasNull || info[k].count < objects.length,
          };
        });
        return closeSlot(state, slot, base, parent, fieldLines(entries, state), fixedName);
      }

      function render(state, body) {
        var imports = [];
        if (state.uses.SerialName) imports.push('import kotlinx.serialization.SerialName');
        if (state.uses.Serializable) imports.push('import kotlinx.serialization.Serializable');
        if (state.uses.JsonElement) imports.push('import kotlinx.serialization.json.JsonElement');
        if (state.uses.JsonNull) imports.push('import kotlinx.serialization.json.JsonNull');
        return (imports.length ? imports.join('\n') + '\n\n' : '') + body;
      }

      /* Returns { code, count, rootType }. count is the number of classes; rootType is the type
         to pass to Json.decodeFromString (List<Root> when the root is an array of objects). */
      function generateKotlin(parsed, rootInput) {
        var rootName = className(rootInput || 'RootObject');
        var state = newState(rootName);
        var rootType = rootName;
        if (isObject(parsed)) {
          buildClass([parsed], rootName, '', state, rootName);
        } else if (Array.isArray(parsed) && parsed.some(isObject)) {
          var hasOther = parsed.some(function (v) { return !isObject(v); });
          mergeObjects(parsed.filter(isObject), rootName, '', state, rootName);
          rootType = 'List<' + rootName + '>';
          if (hasOther) {
            state.uses.JsonElement = true;
            rootType = 'List<JsonElement>';
          }
        } else {
          var t = parsed === null ? 'JsonElement?' : inferType(parsed, rootName, '', state);
          if (parsed === null) state.uses.JsonElement = true;
          return { code: render(state, 'typealias ' + rootName + ' = ' + t), count: 0, rootType: rootName };
        }
        state.uses.Serializable = true;
        var blocks = state.list.map(function (slot) {
          if (!slot.fields.length) return '@Serializable\nclass ' + slot.name;
          return '@Serializable\ndata class ' + slot.name + '(\n' + slot.fields.join(',\n') + '\n)';
        });
        return { code: render(state, blocks.join('\n\n')), count: state.list.length, rootType: rootType };
      }
      /* ── engine:end ── */

      function convert() {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = null;
        var raw = inputEl.value.trim();
        if (!raw) { inputEl.classList.remove('error'); clearStatus(); outputCodeEl.textContent = ''; return; }
        inputEl.classList.remove('error');

        var parsed;
        try {
          parsed = parseJson(raw);
        } catch (e) {
          inputEl.classList.add('error');
          outputCodeEl.textContent = '';
          setStatus(MSG_INVALID + e.message, true);
          return;
        }

        inputEl.classList.remove('error');
        var r = generateKotlin(parsed, rootNameEl.value.trim() || 'RootObject');
        outputCodeEl.textContent = r.code;
        var msg = r.count === 0 ? MSG_GENERATED
          : r.count === 1 ? MSG_GEN_ONE : MSG_GEN_MANY.replace('{n}', r.count);
        if (r.rootType.indexOf('List<') === 0) msg += ' ' + MSG_ROOT_LIST.replace('{type}', r.rootType);
        setStatus(msg, false);
        window.trackTool && window.trackTool('json-to-kotlin', 'generate');
      }

      var _liveTimer = null;
      inputEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = setTimeout(convert, 300);
      });

      document.getElementById('jkt-convert').addEventListener('click', convert);

      document.getElementById('jkt-example').addEventListener('click', function () {
        inputEl.value = EXAMPLE;
        inputEl.classList.remove('error');
        clearStatus();
        convert();
      });

      document.getElementById('jkt-clear').addEventListener('click', function () {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = null;
        inputEl.value = '';
        outputCodeEl.textContent = '';
        inputEl.classList.remove('error');
        clearStatus();
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l' || !wrap.contains(document.activeElement)) return;
        e.preventDefault();
        inputEl.focus();
        document.getElementById('jkt-clear').click();
      });

      copyBtn.addEventListener('click', function () {
        var text = outputCodeEl.textContent;
        if (!text) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(COPY_FAILED, true);
          copyFailure = true;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            if (copyFailure) clearStatus();
            copyBtn.textContent = COPIED;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = COPY;
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });
    })();
  </script>
</div>

