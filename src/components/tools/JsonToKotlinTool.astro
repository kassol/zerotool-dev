const L = STRINGS[lang];
---

<div
  class="jkt-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-msg-invalid-json={L.msgInvalidJson}
  data-msg-invalid-at={L.msgInvalidAt}
  data-json-parse={JSON.stringify(L.jsonParse)}
  data-msg-generated={L.msgGenerated}
  data-msg-gen-one={L.msgGenOne}
  data-msg-gen-many={L.msgGenMany}
  data-msg-root-list={L.msgRootList}
>
  <div class="jkt-config">
    <div class="jkt-name-field">
      <div class="jkt-control-label">
        <label for="jkt-root-name">{L.rootName}</label>
        <Toggletip id="jkt-tip-root-name" lang={lang} about={L.rootName}>{L.tips.rootName}</Toggletip>
      </div>
      <input id="jkt-root-name" type="text" value="RootObject" spellcheck="false" />
    </div>
  </div>
  <div class="jkt-actions">
    <div class="jkt-control-label">
      <button id="jkt-convert" class="btn-primary" type="button">{L.generate}</button>
      <Toggletip id="jkt-tip-generate" lang={lang} about={L.generate}>{L.tips.generate}</Toggletip>
    </div>
    <div class="jkt-control-label">
      <button id="jkt-example" class="btn-ghost" type="button">{L.example}</button>
      <Toggletip id="jkt-tip-example" lang={lang} about={L.example}>{L.tips.example}</Toggletip>
    </div>
    <div class="jkt-control-label">
      <button id="jkt-clear" class="btn-ghost" type="button">{L.clear}</button>
      <Toggletip id="jkt-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip>
    </div>
  </div>
  <div id="jkt-status" class="jkt-status" aria-live="polite"></div>
  <div class="jkt-panels zt-io">
    <div class="jkt-panel zt-io-pane">
      <div class="jkt-panel-header">
        <div class="jkt-control-label">
          <label for="jkt-input">{L.jsonInput}</label>
          <Toggletip id="jkt-tip-input" lang={lang} about={L.jsonInput}>{L.tips.input}</Toggletip>
        </div>
      </div>
      <textarea id="jkt-input" class="zt-io-fill" placeholder='{"name": "Alice", "age": 30}' spellcheck="false"></textarea>
    </div>
    <div class="jkt-panel jkt-output-pane zt-io-pane">
      <div class="jkt-panel-header">
        <span id="jkt-output-label">{L.kotlinOutput}</span>
        <div class="jkt-output-actions">
    <div class="jkt-control-label">
      <button id="jkt-copy" class="btn-ghost" type="button">{L.copy}</button>
      <Toggletip id="jkt-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip>
    </div>
        </div>
      </div>
      <p class="jkt-empty zt-io-fill">{L.empty}</p>
      <pre id="jkt-output" class="jkt-output zt-io-fill" tabindex="0" aria-labelledby="jkt-output-label"><code id="jkt-output-code"></code></pre>
    </div>
  </div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.jkt-wrap')
        : document.querySelector('.jkt-wrap');

      var COPY = wrap ? wrap.dataset.copy : 'Copy';
      var COPIED = wrap ? wrap.dataset.copied : 'Copied!';
      var COPY_FAILED = wrap ? wrap.dataset.copyFailed : 'Copy failed. Please copy the output manually.';
      var MSG_INVALID = wrap ? wrap.dataset.msgInvalidJson : 'Invalid JSON: ';
      var MSG_INVALID_AT = wrap ? wrap.dataset.msgInvalidAt : 'Invalid JSON: line {line}, column {col}, {reason}.';
      var JSON_PARSE = wrap && wrap.dataset.jsonParse ? JSON.parse(wrap.dataset.jsonParse) : {};
      var MSG_GENERATED = wrap ? wrap.dataset.msgGenerated : 'Generated.';
      var MSG_GEN_ONE = wrap ? wrap.dataset.msgGenOne : 'Generated 1 data class.';
      var MSG_GEN_MANY = wrap ? wrap.dataset.msgGenMany : 'Generated {n} data classes.';
      var MSG_ROOT_LIST = wrap ? wrap.dataset.msgRootList : 'The root is an array: decode it as {type}.';

      var inputEl = document.getElementById('jkt-input');
      var outputCodeEl = document.getElementById('jkt-output-code');
      var statusEl = document.getElementById('jkt-status');
      var rootNameEl = document.getElementById('jkt-root-name');
      var copyBtn = document.getElementById('jkt-copy');
      var copyRevision = 0;
      var copyTimer = null;
      var copyFailure = false;

      // Copy is enabled only while there is output to copy.
      function setOutput(text) {
        outputCodeEl.textContent = text;
        copyBtn.disabled = !text;
      }
      setOutput('');

      var EXAMPLE = JSON.stringify({
        id: 1,
        name: "Alice",
        isActive: true,
        score: 9.5,
        tags: ["kotlin", "json"],
        address: {
          city: "London",
          zip: "EC1A 1BB"
        },
        friends: [
          { id: 2, name: "Bob" },
          { id: 3, name: "Carol" }
        ],
        metadata: null
      }, null, 2);

      function setStatus(msg, isError) {
        copyFailure = false;
        statusEl.textContent = msg;
        statusEl.className = 'jkt-status ' + (isError ? 'error' : 'success');
      }
      function clearStatus() {
        copyFailure = false;
        statusEl.textContent = '';
        statusEl.className = 'jkt-status';
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        if (copyFailure) clearStatus();
      }

      /* ── engine:start ── */
      /* Generates kotlinx.serialization data classes that compile with the
         serialization plugin and decode the sample with the default Json
         configuration. Values whose type cannot be fixed from the sample
         (null, an empty array, mixed types) become JsonElement, the type
         kotlinx.serialization provides for arbitrary JSON (Any has no serializer). */
      function hasOwn(o, k) { return Object.prototype.hasOwnProperty.call(o, k); }

      // JSON.parse turns 19.0 into 19. Where the browser passes the source text to the reviver
      // (JSON.parse source text access; Chrome 114+, Firefox 135+, Safari 18.4+), a number
      // written with "." or an exponent is kept as a JsonFloat so it maps to Double.
      function JsonFloat(value) { this.value = value; }
      function parseJson(raw) {
        return JSON.parse(raw, function (k, v, ctx) {
          if (typeof v === 'number' && ctx && typeof ctx.source === 'string' && /[.eE]/.test(ctx.source)) return new JsonFloat(v);
          return v;
        });
      }
      function isObject(v) {
        return v !== null && typeof v === 'object' && !Array.isArray(v) && !(v instanceof JsonFloat);
      }

      // Hard keywords cannot be used as names without backticks (Kotlin grammar, "Keywords and operators").
      var HARD_KEYWORDS = ['as', 'break', 'class', 'continue', 'do', 'else', 'false', 'for', 'fun', 'if', 'in',
        'interface', 'is', 'null', 'object', 'package', 'return', 'super', 'this', 'throw', 'true', 'try',
        'typealias', 'typeof', 'val', 'var', 'when', 'while'];
      // Class names that would hide a type the generated code uses.
      var RESERVED_TYPES = ['Any', 'Boolean', 'Double', 'Int', 'Long', 'String', 'List', 'Unit', 'Nothing',
        'JsonElement', 'JsonNull', 'Serializable', 'SerialName'];

      function words(str) {
        return String(str).split(/[^\p{L}\p{N}]+/u).filter(Boolean);
      }
      function toPascalCase(str) {
        var name = words(str).map(function (w) { return w.charAt(0).toUpperCase() + w.slice(1); }).join('');
        if (!/^\p{L}/u.test(name)) name = 'X' + name;
        return name;
      }
      function toCamelCase(str) {
        var ws = words(str);
        // No letter or digit ("", "-", "__"): Kotlin reserves names made only of underscores.
        if (!ws.length) return 'field';
        var name = ws.map(function (w, i) {
          return i === 0 ? w.charAt(0).toLowerCase() + w.slice(1) : w.charAt(0).toUpperCase() + w.slice(1);
        }).join('');
        if (!/^\p{L}/u.test(name)) name = '_' + name;
        return name;
      }
      function className(str) {
        var name = toPascalCase(str);
        return RESERVED_TYPES.indexOf(name) >= 0 ? name + 'Value' : name;
      }

      // Kotlin string literal: \t \b \n \r \" \\ \$ are escapes; other control characters use \uXXXX.
      function kotlinString(s) {
        var out = '"';
        for (var i = 0; i < s.length; i++) {
          var c = s.charAt(i), code = s.charCodeAt(i);
          if (c === '"') out += '\\"';
          else if (c === '\\') out += '\\\\';
          else if (c === '$') out += '\\$';
          else if (c === '\n') out += '\\n';
          else if (c === '\r') out += '\\r';
          else if (c === '\t') out += '\\t';
          else if (c === '\b') out += '\\b';
          else if (code < 0x20 || code === 0x7f || code === 0x2028 || code === 0x2029) out += '\\u' + ('000' + code.toString(16)).slice(-4);
          else out += c;
        }
        return out + '"';
      }

      function newState(rootName) {
        var reserved = {};
        reserved[rootName] = true;
        RESERVED_TYPES.forEach(function (t) { reserved[t] = true; });
        return { list: [], byName: Object.create(null), reserved: reserved, uses: {} };
      }
      function openSlot(state) {
        var slot = { name: null, base: null, sig: null, fields: null };
        state.list.push(slot);
        return slot;
      }
      // A nested object gets the PascalCase of its key; when that name is taken by a class with
      // different fields, the parent's name is put in front (meta in Payment → PaymentMeta), then
      // a number is added. An object with the same fields as an earlier one of the same key
      // reuses that class.
      function closeSlot(state, slot, base, parent, fields, fixedName) {
        var sig = JSON.stringify(fields);
        if (fixedName) {
          slot.name = fixedName; slot.base = base; slot.sig = sig; slot.fields = fields;
          state.byName[fixedName] = slot;
          return fixedName;
        }
