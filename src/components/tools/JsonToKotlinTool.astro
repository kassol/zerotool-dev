      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l' || !wrap.contains(document.activeElement)) return;
        e.preventDefault();
        inputEl.focus();
        document.getElementById('jkt-clear').click();
      });

      copyBtn.addEventListener('click', function () {
        var text = outputCodeEl.textContent;
        if (!text) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(COPY_FAILED, true);
          copyFailure = true;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            if (copyFailure) clearStatus();
            copyBtn.textContent = COPIED;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = COPY;
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });
    })();
  </script>
</div>

<style>
  .jkt-wrap { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; gap: 0.75rem; }
  .jkt-config { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .jkt-name-field { display: flex; flex-direction: column; gap: 0.25rem; width: 18rem; max-width: 100%; }
  .jkt-control-label { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .jkt-config label { font-size: 0.85rem; color: var(--color-text-secondary); display: flex; align-items: center; gap: 0.4rem; }
  .jkt-name-field input {
    min-height: 44px; width: 100%; padding: 0.4rem 0.6rem; font-size: 0.85rem;
    font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg); color: var(--color-text);
  }
  .jkt-name-field input:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jkt-panel-header { display: flex; justify-content: space-between; align-items: center; min-height: 44px; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .jkt-panel textarea, .jkt-output {
    width: 100%; min-width: 0; font-family: var(--font-mono); font-size: 0.82rem; padding: 0.75rem;
    border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg-secondary); color: var(--color-text); line-height: 1.5;
  }
  .jkt-panel textarea { transition: border-color 0.15s; }
  .jkt-panel textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }
  .jkt-panel textarea.error { border-color: #c0392b; }
  .jkt-output { margin: 0; overflow: auto; white-space: pre; }
  .jkt-output:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jkt-empty { display: none; margin: 0; padding: 2rem; align-items: center; justify-content: center; text-align: center; color: var(--color-text-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .jkt-output-pane:has(#jkt-output-code:empty) .jkt-output { display: none; }
  .jkt-output-pane:has(#jkt-output-code:empty) .jkt-empty { display: flex; }
  .jkt-actions { display: flex; gap: 0.5rem 1rem; flex-wrap: wrap; }
  .jkt-status { font-size: 0.85rem; line-height: 1.4; height: 2.8rem; flex: none; overflow: auto; overflow-wrap: anywhere; }
  .jkt-status.success { color: #057a55; }
  .jkt-status.error { color: #c0392b; }
  .jkt-actions button, .jkt-panel-header button { min-height: 44px; }
  .jkt-panel-header button:disabled { opacity: 0.5; cursor: not-allowed; }
  .jkt-output-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 860px) {
    .jkt-wrap { gap: 0.5rem; }
    .jkt-name-field { width: 100%; flex-direction: row; align-items: center; gap: 0.5rem; }
    .jkt-name-field .jkt-control-label { flex: 1; }
    .jkt-name-field input { width: 45%; flex: none; }
    .jkt-actions button, .jkt-panel-header button { min-height: 44px; }
    .jkt-panel textarea { height: 144px; min-height: 144px; }
    .jkt-output { height: 22rem; min-height: 160px; resize: none; }
    .jkt-output-pane:has(#jkt-output-code:empty) { display: none; }
  }
  @media (max-width: 640px) {
    .jkt-status { height: 3.6rem; }
    .jkt-panel-header { flex-wrap: wrap; }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .jkt-status.success { color: #34d399; }
    :global(:root:not([data-theme="light"])) .jkt-status.error { color: #f87171; }
    :global(:root:not([data-theme="light"])) .jkt-panel textarea.error { border-color: #f87171; }
  }
  :global([data-theme="dark"]) .jkt-status.success { color: #34d399; }
  :global([data-theme="dark"]) .jkt-status.error { color: #f87171; }
  :global([data-theme="dark"]) .jkt-panel textarea.error { border-color: #f87171; }
</style>
