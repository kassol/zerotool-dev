        if (scratch) { scratch.width = 0; scratch.height = 0; }
        if (added) addNotes.push({ kind: 'success', text: fmt(t.statusAdded, { n: added }) });
        if (skipped.type.length) addNotes.push({ kind: 'error', text: fmt(t.statusSkippedType, { files: fileList(skipped.type) }) });
        if (skipped.size.length) addNotes.push({ kind: 'error', text: fmt(t.statusSkippedSize, { files: fileList(skipped.size) }) });
        if (skipped.svg.length) addNotes.push({ kind: 'error', text: fmt(t.statusSkippedSvg, { files: fileList(skipped.svg) }) });
