---
// SpriteSheetGeneratorTool — packs many images into one sprite sheet PNG
// (MaxRects packing or a uniform grid) with optional transparent-edge trim,
// spacing, margin, extrude and power-of-two size, and exports TexturePacker
// JSON Hash / JSON Array, Sparrow/Starling XML or CSS. No upload. Only the
// layout and export options are persisted (policy: preference).
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
---

<div>
  <div class="ssg-wrap" id="ssg-wrap" data-lang={lang}>
    <div id="ssg-drop" class="ssg-drop" role="button" tabindex="0">
      <div class="ssg-drop-inner">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
        </svg>
        <p data-i18n="dropHint">Drop images here, or <strong>click to select</strong></p>
        <p class="ssg-hint" data-i18n="pasteHint">You can also paste copied image files with Ctrl/Cmd+V</p>
        <p class="ssg-hint" data-i18n="formatsHint">PNG · JPG · WebP · GIF (first frame) · SVG · BMP · AVIF</p>
      </div>
      <input type="file" id="ssg-file" multiple accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,image/bmp,image/avif,.png,.jpg,.jpeg,.webp,.gif,.svg,.bmp,.avif" class="ssg-file-input" tabindex="-1" aria-label="Select images" data-i18n-aria="dropAria" />
    </div>

    <section id="ssg-list-panel" class="ssg-panel" hidden>
      <div class="ssg-list-head">
        <span id="ssg-count" class="ssg-count"></span>
        <label class="ssg-inline-field">
          <span class="tool-label" data-i18n="sortLabel">Sort</span>
          <select id="ssg-order" class="tool-input ssg-select">
            <option value="name" data-i18n="sortName">Name</option>
            <option value="added" data-i18n="sortAdded">Added</option>
          </select>
        </label>
        <button type="button" id="ssg-clear" class="btn-ghost" data-i18n="clearAll">Clear all</button>
      </div>
      <div id="ssg-list" class="ssg-list" role="list" aria-label="Images" data-i18n-aria="listAria"></div>
    </section>

    <section class="ssg-panel">
      <div class="ssg-options">
        <fieldset class="ssg-field ssg-fieldset">
          <legend class="tool-label" data-i18n="layoutLabel">Layout</legend>
          <div class="ssg-seg">
            <label><input type="radio" name="ssg-layout" value="packed" checked /><span data-i18n="layoutPacked">Packed</span></label>
            <label><input type="radio" name="ssg-layout" value="grid" /><span data-i18n="layoutGrid">Grid</span></label>
          </div>
        </fieldset>
        <label class="ssg-field" id="ssg-columns-field" hidden>
          <span class="tool-label" data-i18n="columnsLabel">Columns</span>
          <input type="number" id="ssg-columns" class="tool-input" min="1" max="1000" step="1" inputmode="numeric" placeholder="Auto" data-i18n-placeholder="columnsAuto" />
        </label>
        <label class="ssg-field" id="ssg-maxwidth-field">
          <span class="tool-label" data-i18n="maxWidthLabel">Max width</span>
          <select id="ssg-maxwidth" class="tool-input ssg-select">
            <option value="512">512 px</option>
            <option value="1024">1024 px</option>
            <option value="2048">2048 px</option>
            <option value="4096">4096 px</option>
            <option value="8192">8192 px</option>
          </select>
        </label>
        <label class="ssg-field">
          <span class="tool-label" data-i18n="spacingLabel">Spacing (px)</span>
          <input type="number" id="ssg-spacing" class="tool-input" min="0" max="64" step="1" inputmode="numeric" />
        </label>
        <label class="ssg-field">
          <span class="tool-label" data-i18n="marginLabel">Margin (px)</span>
          <input type="number" id="ssg-margin" class="tool-input" min="0" max="64" step="1" inputmode="numeric" />
        </label>
        <label class="ssg-field">
          <span class="tool-label" data-i18n="extrudeLabel">Extrude (px)</span>
          <input type="number" id="ssg-extrude" class="tool-input" min="0" max="8" step="1" inputmode="numeric" />
        </label>
        <label class="ssg-field">
          <span class="tool-label" data-i18n="formatLabel">Data format</span>
          <select id="ssg-format" class="tool-input ssg-select">
            <option value="hash" data-i18n="fmtHash">JSON Hash</option>
            <option value="array" data-i18n="fmtArray">JSON Array</option>
            <option value="xml" data-i18n="fmtXml">XML (Sparrow / Starling)</option>
            <option value="css" data-i18n="fmtCss">CSS</option>
          </select>
        </label>
        <label class="ssg-field">
          <span class="tool-label" data-i18n="sheetNameLabel">Sheet name</span>
          <input type="text" id="ssg-name" class="tool-input" maxlength="100" spellcheck="false" autocomplete="off" />
        </label>
      </div>
      <div class="ssg-checks">
        <label class="ssg-check" id="ssg-trim-field"><input type="checkbox" id="ssg-trim" /><span data-i18n="trimLabel">Trim transparent edges</span></label>
        <label class="ssg-check"><input type="checkbox" id="ssg-pot" /><span data-i18n="potLabel">Power of two size</span></label>
      </div>
    </section>

    <div id="ssg-status" class="tool-status" aria-live="polite"></div>

    <section id="ssg-output" class="ssg-panel" hidden>
      <div class="ssg-meta-row">
        <p id="ssg-meta" class="ssg-meta"></p>
        <label class="ssg-check"><input type="checkbox" id="ssg-bounds" /><span data-i18n="showBounds">Show bounds</span></label>
      </div>
      <div class="ssg-preview">
        <div class="ssg-stage">
          <canvas id="ssg-canvas" class="ssg-canvas" role="img" aria-label="Sprite sheet preview" data-i18n-aria="previewAria"></canvas>
          <svg id="ssg-bounds-layer" class="ssg-bounds" aria-hidden="true" preserveAspectRatio="none" hidden></svg>
        </div>
      </div>
      <div class="ssg-actions">
        <button type="button" id="ssg-dl-png" class="btn-primary" data-i18n="downloadPng">Download PNG</button>
        <button type="button" id="ssg-dl-data" class="btn-secondary">Download JSON</button>
        <button type="button" id="ssg-copy" class="btn-copy ssg-copy" data-i18n="copy">Copy</button>
      </div>
      <textarea id="ssg-data" class="tool-textarea ssg-data" rows="10" readonly spellcheck="false" aria-label="Sprite sheet data" data-i18n-aria="dataAria"></textarea>
    </section>
  </div>

  <script is:inline>
    (function () {
      var STRINGS = {
