---

<div>
  <div class="ssg-wrap" id="ssg-wrap">
    <div id="ssg-drop" class="ssg-drop">
      <svg class="ssg-drop-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
      </svg>
      <div class="ssg-drop-text">
        <p id="ssg-drop-hint" class="ssg-drop-hint">{T.dropHint}</p>
        <p class="ssg-hint">{T.formatsHint}</p>
      </div>
      <div class="ssg-drop-actions">
        <button type="button" id="ssg-pick" class="btn-primary ssg-pick">{T.selectFiles}</button>
        <button type="button" id="ssg-pick-dir" class="btn-secondary ssg-pick-dir">{T.selectFolder}</button>
      </div>
      <input type="file" id="ssg-file" multiple accept={ACCEPT} hidden />
      <input type="file" id="ssg-dir" webkitdirectory multiple hidden />
    </div>

    <div id="ssg-status" class="tool-status" role="status" aria-live="polite"></div>

    <section id="ssg-output" class="ssg-panel" hidden>
      <div class="ssg-actions">
        <button type="button" id="ssg-dl-img" class="btn-primary">{T.downloadImage.replace('{ext}', 'PNG')}</button>
        <button type="button" id="ssg-dl-data" class="btn-secondary">{T.downloadData.replace('{ext}', 'JSON')}</button>
        <button type="button" id="ssg-copy" class="btn-copy ssg-copy">{T.copy}</button>
      </div>
      <div class="ssg-meta-row">
        <p id="ssg-meta" class="ssg-meta"></p>
        <label class="ssg-check"><input type="checkbox" id="ssg-bounds" /><span>{T.showBounds}</span></label>
      </div>
      <div class="ssg-preview">
        <div class="ssg-stage">
          <canvas id="ssg-canvas" class="ssg-canvas" role="img" aria-label={T.previewAria}></canvas>
          <svg id="ssg-bounds-layer" class="ssg-bounds" aria-hidden="true" preserveAspectRatio="none" hidden></svg>
        </div>
      </div>
      <textarea id="ssg-data" class="tool-textarea ssg-data" rows="8" readonly spellcheck="false" aria-label={T.dataAria}></textarea>
    </section>

    <section id="ssg-list-panel" class="ssg-panel" hidden>
      <div class="ssg-list-head">
        <span id="ssg-count" class="ssg-count"></span>
        <div class="ssg-list-tools">
          <label class="ssg-inline-field">
            <span class="tool-label">{T.sortLabel}</span>
            <select id="ssg-order" class="tool-input ssg-select">
              <option value="name">{T.sortName}</option>
              <option value="added">{T.sortAdded}</option>
            </select>
          </label>
          <button type="button" id="ssg-clear" class="btn-ghost">{T.clearAll}</button>
        </div>
      </div>
      <div id="ssg-list" class="ssg-list" role="list" aria-label={T.listAria}></div>
    </section>

    <section class="ssg-panel" aria-label={T.optionsTitle}>
      <div class="ssg-options">
        <fieldset class="ssg-field ssg-fieldset">
          <legend class="tool-label">{T.layoutLabel}</legend>
          <div class="ssg-seg zt-segmented">
            <label><input type="radio" name="ssg-layout" value="packed" checked /><span>{T.layoutPacked}</span></label>
            <label><input type="radio" name="ssg-layout" value="grid" /><span>{T.layoutGrid}</span></label>
          </div>
        </fieldset>
        <label class="ssg-field" id="ssg-columns-field" hidden>
          <span class="tool-label">{T.columnsLabel}</span>
          <input type="number" id="ssg-columns" class="tool-input" min="1" max="1000" step="1" inputmode="numeric" placeholder={T.columnsAuto} />
        </label>
        <label class="ssg-field" id="ssg-maxwidth-field">
          <span class="tool-label">{T.maxWidthLabel}</span>
          <select id="ssg-maxwidth" class="tool-input ssg-select">
            <option value="512">512 px</option>
            <option value="1024">1024 px</option>
            <option value="2048">2048 px</option>
            <option value="4096">4096 px</option>
            <option value="8192">8192 px</option>
          </select>
        </label>
        <label class="ssg-field">
          <span class="tool-label">{T.spacingLabel}</span>
          <input type="number" id="ssg-spacing" class="tool-input" min="0" max="64" step="1" inputmode="numeric" />
        </label>
        <label class="ssg-field">
          <span class="tool-label">{T.marginLabel}</span>
          <input type="number" id="ssg-margin" class="tool-input" min="0" max="64" step="1" inputmode="numeric" />
        </label>
        <label class="ssg-field">
          <span class="tool-label">{T.extrudeLabel}</span>
          <input type="number" id="ssg-extrude" class="tool-input" min="0" max="8" step="1" inputmode="numeric" />
        </label>
        <label class="ssg-field">
          <span class="tool-label">{T.formatLabel}</span>
          <select id="ssg-format" class="tool-input ssg-select">
            <option value="hash">{T.fmtHash}</option>
            <option value="array">{T.fmtArray}</option>
            <option value="xml">{T.fmtXml}</option>
            <option value="css">{T.fmtCss}</option>
          </select>
        </label>
        <label class="ssg-field" id="ssg-ratio-field" hidden>
          <span class="tool-label">{T.cssRatioLabel}</span>
          <select id="ssg-ratio" class="tool-input ssg-select">
            <option value="1">1×</option>
            <option value="2">2×</option>
            <option value="3">3×</option>
          </select>
        </label>
        <label class="ssg-field">
          <span class="tool-label">{T.imageFormatLabel}</span>
          <select id="ssg-imgfmt" class="tool-input ssg-select">
            <option value="png">{T.imgPng}</option>
            <option value="webp" id="ssg-webp-option">{T.imgWebp}</option>
          </select>
        </label>
        <label class="ssg-field">
          <span class="tool-label">{T.svgScaleLabel}</span>
          <select id="ssg-svgscale" class="tool-input ssg-select">
            <option value="1">1×</option>
            <option value="2">2×</option>
            <option value="3">3×</option>
            <option value="4">4×</option>
          </select>
        </label>
        <label class="ssg-field">
          <span class="tool-label">{T.sheetNameLabel}</span>
          <input type="text" id="ssg-name" class="tool-input" maxlength="100" spellcheck="false" autocomplete="off" />
        </label>
      </div>
      <div class="ssg-checks">
        <label class="ssg-check" id="ssg-trim-field"><input type="checkbox" id="ssg-trim" /><span>{T.trimLabel}</span></label>
        <label class="ssg-check" id="ssg-alias-field"><input type="checkbox" id="ssg-alias" /><span>{T.aliasLabel}</span></label>
        <label class="ssg-check"><input type="checkbox" id="ssg-pot" /><span>{T.potLabel}</span></label>
        <label class="ssg-check"><input type="checkbox" id="ssg-keepext" /><span>{T.keepExtLabel}</span></label>
        <label class="ssg-check"><input type="checkbox" id="ssg-gifframes" /><span>{T.gifFramesLabel}</span></label>
      </div>
    </section>
  </div>

  <script is:inline define:vars={{ t: T, langPrefix }}>
    (function () {
      function fmt(str, vars) {
        return str.replace(/\{(\w+)\}/g, function (m, k) { return vars[k] !== undefined ? String(vars[k]) : m; });
      }

      /* ── engine:start ── */
      // Pure, DOM-free naming, trimming, hashing, layout and export helpers —
      // extracted verbatim by scripts/test-sprite-sheet-generator.mjs. Keep
      // this block free of DOM/canvas APIs.

      // 16,777,216 px (4096²) is the iOS Safari per-canvas area limit.
      // WEBP_MAX_DIMENSION in libwebp is 16,383. 4,096 px is the smallest
      // WebGL2 MAX_TEXTURE_SIZE that Web3D Survey reports.
      var SSG_LIMITS = { maxImages: 1000, maxImageSide: 8192, maxSide: 16384, maxArea: 16777216, webpMaxSide: 16383, gpuSafeSide: 4096 };
      var SSG_APP_URL = 'https://zerotool.dev/tools/sprite-sheet-generator/';

      // Case-insensitive natural order: digit runs compare by value, so
      // walk_2 < walk_10. Equal values with different zero padding put the
      // shorter run first; full ties fall back to a plain code-unit compare.
      // File names compare by stem first, so "dup.png" sorts before "dup (2).png".
      function naturalCompare(a, b) {
        var sa = String(a), sb = String(b);
        return naturalCompareText(fileStem(sa), fileStem(sb)) || naturalCompareText(sa, sb);
      }

      function fileStem(name) {
        var dot = name.lastIndexOf('.');
        return dot > 0 && name.indexOf('/', dot) < 0 && name.charAt(dot - 1) !== '/' ? name.slice(0, dot) : name;
      }

      function naturalCompareText(sa, sb) {
        var ax = sa.toLowerCase().match(/\d+|\D+/g) || [];
        var bx = sb.toLowerCase().match(/\d+|\D+/g) || [];
        var n = Math.min(ax.length, bx.length), tie = 0;
        for (var i = 0; i < n; i++) {
          var x = ax[i], y = bx[i];
          if (x === y) continue;
          var xd = x.charCodeAt(0) >= 48 && x.charCodeAt(0) <= 57;
          var yd = y.charCodeAt(0) >= 48 && y.charCodeAt(0) <= 57;
          if (xd && yd) {
            var xs = x.replace(/^0+/, ''), ys = y.replace(/^0+/, '');
            if (xs.length !== ys.length) return xs.length < ys.length ? -1 : 1;
            if (xs !== ys) return xs < ys ? -1 : 1;
            if (!tie) tie = x.length < y.length ? -1 : 1;
            continue;
          }
          return x < y ? -1 : 1;
        }
        if (ax.length !== bx.length) return ax.length < bx.length ? -1 : 1;
        if (tie) return tie;
        return sa < sb ? -1 : sa > sb ? 1 : 0;
      }

      // The first occurrence keeps its name; later duplicates get " (2)",
      // " (3)"… before the extension, skipping names already in the list.
      function uniqueNames(names) {
        var taken = new Set(names.map(String));
        var used = new Set();
        return names.map(function (raw) {
          var name = String(raw);
          if (!used.has(name)) { used.add(name); return name; }
          var stem = fileStem(name);
          var ext = name.slice(stem.length);
          for (var k = 2; ; k++) {
            var cand = stem + ' (' + k + ')' + ext;
            if (!taken.has(cand) && !used.has(cand)) {
              taken.add(cand);
              used.add(cand);
              return cand;
            }
          }
        });
      }

      // Path inside a dropped or selected folder, without the folder itself
      // ("/hero/walk/01.png" or "hero/walk/01.png" → "walk/01.png"), the
      // TexturePacker naming: sub-folder names are part of the sprite name.
      function folderPath(path) {
        var parts = String(path == null ? '' : path).split('/').filter(Boolean);
        return parts.length > 1 ? parts.slice(1).join('/') : parts.join('/');
      }

      function isImagePath(path) {
        return /\.(png|jpe?g|webp|gif|svg|bmp|avif)$/i.test(String(path));
      }

      // Hidden files and folders (".DS_Store", ".git/…") and the Finder /
      // Explorer helper files that end up in zipped asset folders.
      function isHiddenPath(path) {
        return String(path).split('/').some(function (p) {
          return p.charAt(0) === '.' || p === '__MACOSX' || /^(thumbs\.db|desktop\.ini)$/i.test(p);
        });
      }

      // The file extension of the last path segment ("walk/01.png" → "walk/01").
      // A name that is only an extension (".png") is kept.
      function stripExt(path) {
        var s = String(path);
        var out = s.replace(/\.[^./]*$/, '');
        return out && out.charAt(out.length - 1) !== '/' ? out : s;
      }

      // Frame names in list order: the path, without the extension when
      // keepExt is false (TexturePacker's "Trim sprite names"), made unique.
      function frameNames(paths, keepExt) {
        return uniqueNames(paths.map(function (p) { return keepExt ? String(p) : stripExt(p); }));
      }

      // ASCII letters, digits, ".", "_", "-", plus the "$" and "!" that RPG Maker
      // MZ reads at the start of a character file name.
      function sanitizeSheetName(name) {
        var out = String(name == null ? '' : name).trim()
          .replace(/[^A-Za-z0-9._$!-]+/g, '-')
          .replace(/-{2,}/g, '-')
          .replace(/^-+|-+$/g, '');
        return /[A-Za-z0-9]/.test(out) ? out : 'spritesheet';
      }

      // File name without its extension, as a kebab-case token of Unicode
      // letters, digits, _ and -. May be empty or start with a digit; buildCss
      // handles both.
      function cssClassName(fileName) {
        return String(fileName).replace(/\.[^./]*$/, '')
          .replace(/([a-z0-9])([A-Z])/g, '$1-$2')
          .toLowerCase()
          .replace(/[^\p{L}\p{N}_-]+/gu, '-')
          .replace(/-{2,}/g, '-')
          .replace(/^-+|-+$/g, '');
      }

      // Pixel size of an SVG drawn at `scale`, from analyzeSvg (absolute CSS
      // units, a missing side from the viewBox, as Chrome sizes an <img>).
      // null when the SVG gives no size of its own (Chrome would use
      // 300 × 150) or a side needs a layout (%, vw…) and there is no viewBox.
      function svgRasterSize(analysis, scale) {
        var s = analysis && analysis.size;
        if (!s || s.source === 'default') return null;
        if (!s.viewBox && s.notes.length) return null;
        var f = Number(scale) > 0 ? Number(scale) : 1;
        return { w: Math.max(1, Math.round(s.width * f)), h: Math.max(1, Math.round(s.height * f)) };
      }

      // Bounding box of pixels with alpha > 0 in RGBA data. A fully
      // transparent image keeps a 1×1 box at the origin (empty: true).
      function trimBounds(rgba, w, h) {
        var minX = w, minY = -1, maxX = -1, maxY = -1;
        for (var y = 0; y < h; y++) {
          var row = y * w * 4, first = -1, last = -1, x;
          for (x = 0; x < w; x++) if (rgba[row + x * 4 + 3] !== 0) { first = x; break; }
          if (first < 0) continue;
          for (x = w - 1; x >= first; x--) if (rgba[row + x * 4 + 3] !== 0) { last = x; break; }
          if (minY < 0) minY = y;
          maxY = y;
          if (first < minX) minX = first;
          if (last > maxX) maxX = last;
        }
        if (maxY < 0) return { x: 0, y: 0, w: 1, h: 1, empty: true };
        return { x: minX, y: minY, w: maxX - minX + 1, h: maxY - minY + 1, empty: false };
      }

      // Two independent 32-bit hashes (FNV-1a and MurmurHash3's mixing) over
      // RGBA pixels read as 32-bit words, fed row strip by row strip. With the
      // size in the key, two different images get the same key with odds of
      // about 1 in 2^64.
      function pixelHashStart() { return { a: 2166136261, b: 0x9747b28c }; }
      function pixelHashUpdate(state, words) {
        var a = state.a, b = state.b;
        for (var i = 0; i < words.length; i++) {
          var w = words[i];
          a = Math.imul(a ^ w, 16777619);
          var k = Math.imul(w, 0xcc9e2d51);
          k = (k << 15) | (k >>> 17);
          k = Math.imul(k, 0x1b873593);
          b ^= k;
          b = (b << 13) | (b >>> 19);
          b = (Math.imul(b, 5) + 0xe6546b64) | 0;
        }
        state.a = a; state.b = b;
        return state;
      }
      function pixelHashKey(state, w, h) {
        return w + 'x' + h + ':' + (state.a >>> 0).toString(16) + ':' + (state.b >>> 0).toString(16);
      }

      // For each item, the index of the first item with the same key (itself
      // when its key is new or null).
      function aliasIndex(keys) {
        var first = new Map();
        return keys.map(function (k, i) {
          if (k == null) return i;
          if (!first.has(k)) first.set(k, i);
          return first.get(k);
        });
      }

      function nextPow2(n) {
        var p = 1;
        while (p < n) p *= 2;
        return p;
      }

      function fitsLimits(w, h) {
        var L = SSG_LIMITS;
        return w >= 1 && h >= 1 && w <= L.maxSide && h <= L.maxSide && w * h <= L.maxArea;
      }

      // Drawn sprite pixels / sheet pixels.
      function fillRatio(sizes, w, h) {
        if (!(w > 0 && h > 0)) return 0;
        var sum = 0;
        for (var i = 0; i < sizes.length; i++) sum += sizes[i].w * sizes[i].h;
        return sum / (w * h);
      }

      function toInt(v, min, max, fallback) {
        var n = Math.floor(Number(v));
        if (!isFinite(n)) return fallback;
        return Math.min(max, Math.max(min, n));
      }

      function rectContains(a, b) {
        return b.x >= a.x && b.y >= a.y && b.x + b.w <= a.x + a.w && b.y + b.h <= a.y + a.h;
      }
      // MaxRects, Best Short Side Fit, into a binW × binH bin. Places items in
      // `order`; returns positions indexed like pw/ph, or null if one does
      // not fit. Free rects stay maximal: every split produces the up to 4
      // strips around the placed rect, and new strips contained in another
      // free rect are dropped (old free rects are never inside each other,
      // so they cannot be inside a strip cut from one of them either).
      function maxRectsPack(binW, binH, order, pw, ph) {
        var free = [{ x: 0, y: 0, w: binW, h: binH }];
        var pos = new Array(pw.length);
        for (var k = 0; k < order.length; k++) {
          var idx = order[k], w = pw[idx], h = ph[idx];
          var best = null, bestShort = Infinity, bestLong = Infinity;
          for (var f = 0; f < free.length; f++) {
            var fr = free[f];
            if (fr.w < w || fr.h < h) continue;
            var lh = fr.w - w, lv = fr.h - h;
            var s = lh < lv ? lh : lv, l = lh < lv ? lv : lh;
            if (s < bestShort || (s === bestShort && (l < bestLong ||
                (l === bestLong && (fr.y < best.y || (fr.y === best.y && fr.x < best.x)))))) {
              best = fr; bestShort = s; bestLong = l;
            }
          }
          if (!best) return null;
          var px = best.x, py = best.y;
          pos[idx] = { x: px, y: py };
          var kept = [], created = [];
          for (f = 0; f < free.length; f++) {
            var r = free[f];
            if (px >= r.x + r.w || px + w <= r.x || py >= r.y + r.h || py + h <= r.y) { kept.push(r); continue; }
            if (px > r.x) created.push({ x: r.x, y: r.y, w: px - r.x, h: r.h });
            if (px + w < r.x + r.w) created.push({ x: px + w, y: r.y, w: r.x + r.w - px - w, h: r.h });
            if (py > r.y) created.push({ x: r.x, y: r.y, w: r.w, h: py - r.y });
            if (py + h < r.y + r.h) created.push({ x: r.x, y: py + h, w: r.w, h: r.y + r.h - py - h });
          }
          for (var a = 0; a < created.length; a++) {
            var c = created[a], drop = false, b;
            for (b = 0; b < created.length && !drop; b++) {
              if (b !== a && rectContains(created[b], c) && (b < a || !rectContains(c, created[b]))) drop = true;
            }
            for (b = 0; b < kept.length && !drop; b++) if (rectContains(kept[b], c)) drop = true;
            if (!drop) kept.push(c);
          }
          free = kept;
        }
        return pos;
      }

      // Pack sizes [{w, h}] (sprite pixels, after any trim). Each sprite takes
      // w + 2·extrude + spacing by h + 2·extrude + spacing; the bin is
      // sheetWidth − 2·margin + spacing wide so the last column's spacing
      // falls outside the sheet. Tries several sheet widths between the
      // widest sprite and maxWidth (powers of two only when pot) and keeps
      // a result that fits the canvas limits with (near) the smallest area,
      // the squarest first. A sprite wider than maxWidth widens the sheet to it
      // (widened: true). Returns the sheet size and each sprite's top-left
      // pixel position (inside its extrude border).
      // Narrow bins often pack a few percent tighter but give sheets like
      // 92×15357, beyond the 4096/8192 px texture limit of many GPUs. Results
      // within 10% of the smallest area count as equal; the squarest wins.
      var AREA_SLACK = 1.1;
      function packMaxRects(sizes, opts) {
        var n = sizes.length;
        var s = toInt(opts.spacing, 0, 1e6, 0), m = toInt(opts.margin, 0, 1e6, 0), e = toInt(opts.extrude, 0, 1e6, 0);
        var maxWidth = toInt(opts.maxWidth, 1, 1e9, 2048), pot = !!opts.pot;
        if (!n) return { width: 0, height: 0, rects: [], widened: false };
        var pw = [], ph = [], order = [], maxPw = 0, maxPh = 0, area = 0, sumPh = 0;
        for (var i = 0; i < n; i++) {
          pw.push(sizes[i].w + 2 * e + s);
          ph.push(sizes[i].h + 2 * e + s);
          maxPw = Math.max(maxPw, pw[i]);
          maxPh = Math.max(maxPh, ph[i]);
          area += pw[i] * ph[i];
          sumPh += ph[i];
          order.push(i);
        }
        order.sort(function (a, b) {
          return Math.max(pw[b], ph[b]) - Math.max(pw[a], ph[a]) || pw[b] * ph[b] - pw[a] * ph[a] || a - b;
        });
        var minW = maxPw - s + 2 * m;
        var widened = (pot ? nextPow2(minW) : minW) > maxWidth;
        var cands = [];
        if (widened) cands.push(minW);
        else if (pot) {
          for (var p = nextPow2(minW); p <= maxWidth; p *= 2) cands.push(p);
        } else {
          for (var k = 0; k <= 10; k++) cands.push(Math.round(minW * Math.pow(maxWidth / minW, k / 10)));
          var ideal = Math.sqrt(area) - s + 2 * m;
          [0.9, 1, 1.1, 1.25, 1.5].forEach(function (f) {
            var cw = Math.round(ideal * f);
            if (cw >= minW && cw <= maxWidth) cands.push(cw);
          });
        }
        cands = cands.filter(function (c, j) { return cands.indexOf(c) === j; }).sort(function (a, b) { return a - b; });

        var results = [];
        cands.forEach(function (cw) {
          var binW = cw - 2 * m + s;
          var pos = null;
          var binH = Math.max(maxPh, Math.ceil(area / binW));
          for (var tries = 0; tries < 40 && !pos; tries++) {
            pos = maxRectsPack(binW, binH, order, pw, ph);
            binH = Math.max(binH + 1, Math.ceil(binH * 1.08));
          }
          if (!pos) {
            // Stacking in one column always fits.
            pos = [];
            for (var q = 0, y = 0; q < n; q++) { pos.push({ x: 0, y: y }); y += ph[q]; }
          }
          var usedW = 0, usedH = 0;
          for (var j = 0; j < n; j++) {
            usedW = Math.max(usedW, pos[j].x + pw[j]);
            usedH = Math.max(usedH, pos[j].y + ph[j]);
          }
          var W = usedW - s + 2 * m, H = usedH - s + 2 * m;
          if (pot) { W = nextPow2(W); H = nextPow2(H); }
          // Area is compared with the trailing spacing added back on both
          // axes: otherwise a single column, which has spacing on one axis
          // only, always looks smallest.
          var score = pot ? W * H : (W + s) * (H + s);
