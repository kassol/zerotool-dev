          sortLabel: '並び順', sortName: 'ファイル名', sortAdded: '追加順', clearAll: 'すべて削除', removeAria: '{name} を削除',
          layoutLabel: '配置', layoutPacked: '詰め込み', layoutGrid: 'グリッド',
          columnsLabel: '列数', columnsAuto: '自動', maxWidthLabel: '最大幅',
          spacingLabel: '間隔（px）', marginLabel: '外側余白（px）', extrudeLabel: 'エッジ拡張（px）',
          trimLabel: '透明な余白をトリム', potLabel: 'サイズを 2 のべき乗に',
          formatLabel: 'データ形式', fmtHash: 'JSON Hash', fmtArray: 'JSON Array', fmtXml: 'XML（Sparrow / Starling）', fmtCss: 'CSS',
          sheetNameLabel: 'シート名',
          meta: '{w}×{h} px · スプライト {n} 個 · 充填率 {fill}%', showBounds: '枠を表示', previewAria: 'スプライトシートのプレビュー',
          downloadPng: 'PNG をダウンロード', downloadData: '{ext} をダウンロード', copy: 'コピー', copied: 'コピーしました', dataAria: 'スプライトシートのデータ',
          statusLoading: '画像 {i} / {n} を読み込み中…',
          statusAdded: '{n} 枚の画像を追加しました',
