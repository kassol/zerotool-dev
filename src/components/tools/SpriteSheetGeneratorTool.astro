          listAria: '이미지 목록', listCount: '이미지 {n}개 · {size}',
          sortLabel: '정렬', sortName: '파일명', sortAdded: '추가 순서', clearAll: '모두 지우기', removeAria: '{name} 제거',
          layoutLabel: '배치', layoutPacked: '빈틈없이', layoutGrid: '그리드',
          columnsLabel: '열 수', columnsAuto: '자동', maxWidthLabel: '최대 너비',
          spacingLabel: '간격 (px)', marginLabel: '바깥 여백 (px)', extrudeLabel: '가장자리 확장 (px)',
          trimLabel: '투명 여백 트림', potLabel: '크기를 2의 거듭제곱으로',
          formatLabel: '데이터 형식', fmtHash: 'JSON Hash', fmtArray: 'JSON Array', fmtXml: 'XML (Sparrow / Starling)', fmtCss: 'CSS',
          sheetNameLabel: '시트 이름',
          meta: '{w}×{h} px · 스프라이트 {n}개 · 채움률 {fill}%', showBounds: '경계 표시', previewAria: '스프라이트 시트 미리보기',
          downloadPng: 'PNG 다운로드', downloadData: '{ext} 다운로드', copy: '복사', copied: '복사됨', dataAria: '스프라이트 시트 데이터',
          statusLoading: '이미지 {i} / {n} 읽는 중…',
          statusAdded: '이미지 {n}개 추가됨',
          statusSkippedType: '건너뜀(이미지가 아니거나 디코딩 실패): {files}',
          statusSkippedSize: '건너뜀(한 변이 8,192px 초과): {files}',
          statusSkippedSvg: '건너뜀(width, height, viewBox가 없는 SVG): {files}',
          statusSkippedCount: '파일 {n}개를 건너뛰었습니다. 한도는 이미지 1,000개입니다.',
          moreFiles: '{files} 외 {n}개',
          statusGif: 'GIF는 첫 프레임만 추가됩니다. 모든 프레임을 쓰려면 먼저 {link}로 분할하세요.',
          gifLink: 'GIF 프레임 추출기',
          statusTooBig: '스프라이트 시트가 {w}×{h} px가 되어 모바일 브라우저의 canvas 한도(16,777,216픽셀, 한 변 16,384px)를 넘습니다. 간격을 줄이거나 최대 너비·배치를 바꾸거나 이미지를 줄이세요.',
          statusWidened: '{name}이(가) 최대 너비보다 넓어 시트 너비를 {w} px로 늘렸습니다.',
          statusExportFailed: '내보내기 실패 — 브라우저가 PNG를 인코딩하지 못했습니다',
          statusCopyFailed: '복사가 차단되었습니다 — 텍스트를 선택해 직접 복사하세요',
        },
      };
      var wrapEl = document.getElementById('ssg-wrap');
      var lang = wrapEl.getAttribute('data-lang') || 'en';
      if (!STRINGS[lang]) lang = 'en';
      var t = STRINGS[lang];
      var langPrefix = lang === 'en' ? '' : '/' + lang;
      wrapEl.querySelectorAll('[data-i18n]').forEach(function (el) {
        var key = el.getAttribute('data-i18n');
        if (t[key]) el.innerHTML = t[key];
      });
      wrapEl.querySelectorAll('[data-i18n-aria]').forEach(function (el) {
        var key = el.getAttribute('data-i18n-aria');
        if (t[key]) el.setAttribute('aria-label', t[key]);
      });
      wrapEl.querySelectorAll('[data-i18n-placeholder]').forEach(function (el) {
        var key = el.getAttribute('data-i18n-placeholder');
        if (t[key]) el.setAttribute('placeholder', t[key]);
      });
      function fmt(str, vars) {
        return str.replace(/\{(\w+)\}/g, function (m, k) { return vars[k] !== undefined ? String(vars[k]) : m; });
      }

      /* ── engine:start ── */
      // Pure, DOM-free naming, trimming, layout and export helpers —
      // extracted verbatim by scripts/test-sprite-sheet-generator.mjs. Keep
      // this block free of DOM/canvas APIs.

      // 16,777,216 px (4096²) is the iOS Safari per-canvas area limit.
      var SSG_LIMITS = { maxImages: 1000, maxImageSide: 8192, maxSide: 16384, maxArea: 16777216 };
      var SSG_APP_URL = 'https://zerotool.dev/tools/sprite-sheet-generator/';

      // Case-insensitive natural order: digit runs compare by value, so
      // walk_2 < walk_10. Equal values with different zero padding put the
      // shorter run first; full ties fall back to a plain code-unit compare.
      function naturalCompare(a, b) {
        var sa = String(a), sb = String(b);
        var ax = sa.toLowerCase().match(/\d+|\D+/g) || [];
        var bx = sb.toLowerCase().match(/\d+|\D+/g) || [];
        var n = Math.min(ax.length, bx.length), tie = 0;
        for (var i = 0; i < n; i++) {
          var x = ax[i], y = bx[i];
          if (x === y) continue;
          var xd = x.charCodeAt(0) >= 48 && x.charCodeAt(0) <= 57;
          var yd = y.charCodeAt(0) >= 48 && y.charCodeAt(0) <= 57;
          if (xd && yd) {
            var xs = x.replace(/^0+/, ''), ys = y.replace(/^0+/, '');
            if (xs.length !== ys.length) return xs.length < ys.length ? -1 : 1;
            if (xs !== ys) return xs < ys ? -1 : 1;
            if (!tie) tie = x.length < y.length ? -1 : 1;
            continue;
          }
          return x < y ? -1 : 1;
        }
        if (ax.length !== bx.length) return ax.length < bx.length ? -1 : 1;
        if (tie) return tie;
        return sa < sb ? -1 : sa > sb ? 1 : 0;
      }

      // The first occurrence keeps its name; later duplicates get " (2)",
      // " (3)"… before the extension, skipping names already in the list.
      function uniqueNames(names) {
        var taken = new Set(names.map(String));
        var used = new Set();
        return names.map(function (raw) {
          var name = String(raw);
          if (!used.has(name)) { used.add(name); return name; }
          var dot = name.lastIndexOf('.');
          var stem = dot > 0 ? name.slice(0, dot) : name;
          var ext = dot > 0 ? name.slice(dot) : '';
          for (var k = 2; ; k++) {
            var cand = stem + ' (' + k + ')' + ext;
            if (!taken.has(cand) && !used.has(cand)) {
              taken.add(cand);
              used.add(cand);
              return cand;
            }
          }
        });
      }

      function sanitizeSheetName(name) {
        var out = String(name == null ? '' : name).trim()
          .replace(/[^A-Za-z0-9._-]+/g, '-')
          .replace(/-{2,}/g, '-')
          .replace(/^-+|-+$/g, '');
        return /[A-Za-z0-9]/.test(out) ? out : 'spritesheet';
      }

      // File name without its extension, as a kebab-case token of Unicode
      // letters, digits, _ and -. May be empty or start with a digit; buildCss
      // handles both.
      function cssClassName(fileName) {
        return String(fileName).replace(/\.[^.]*$/, '')
          .replace(/([a-z0-9])([A-Z])/g, '$1-$2')
          .toLowerCase()
          .replace(/[^\p{L}\p{N}_-]+/gu, '-')
          .replace(/-{2,}/g, '-')
          .replace(/^-+|-+$/g, '');
      }

      // Pixel size of an SVG from its root width/height/viewBox attributes.
      // Only unitless or px lengths count. A missing side follows the viewBox
      // aspect ratio; with neither width/height nor a viewBox, returns null.
      function svgIntrinsicSize(width, height, viewBox) {
        function len(v) {
          var m = /^\s*(\d*\.?\d+(?:e[+-]?\d+)?)\s*(px)?\s*$/i.exec(v == null ? '' : String(v));
          var n = m ? parseFloat(m[1]) : 0;
