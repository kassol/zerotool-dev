      function refreshData() {
        var fmtInfo = FORMATS[prefs.format];
        var img = imageInfo();
        dlDataBtn.textContent = fmt(t.downloadData, { ext: fmtInfo.ext.toUpperCase() });
        dlImgBtn.textContent = fmt(t.downloadImage, { ext: img.ext === 'webp' ? 'WebP' : 'PNG' });
        if (!built) return;
        dataEl.value = fmtInfo.build(built.frames, { image: sheetName() + '.' + img.ext, width: built.width, height: built.height, ratio: prefs.cssRatio });
        exportNoteList = exportNotes({ format: prefs.format, imageFormat: prefs.imageFormat, frames: built.frames, width: built.width, height: built.height, ratio: prefs.cssRatio });
      }

      function renderBounds() {
        boundsLayer.textContent = '';
        // SVG elements have no reflected `hidden` property; set the attribute.
        if (!built || !prefs.showBounds) { boundsLayer.setAttribute('hidden', ''); return; }
        boundsLayer.setAttribute('viewBox', '0 0 ' + built.width + ' ' + built.height);
        var frag = document.createDocumentFragment();
        built.frames.forEach(function (f) {
          var r = document.createElementNS(SVG_NS, 'rect');
          r.setAttribute('x', String(f.x + 0.5));
          r.setAttribute('y', String(f.y + 0.5));
          r.setAttribute('width', String(Math.max(0, f.w - 1)));
          r.setAttribute('height', String(Math.max(0, f.h - 1)));
          frag.appendChild(r);
        });
        boundsLayer.appendChild(frag);
        boundsLayer.removeAttribute('hidden');
      }

      function flushRebuild() {
        if (rebuildTimer) { clearTimeout(rebuildTimer); rebuild(); }
      }

      function downloadBlob(blob, name) {
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = name;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      }

      function showActionError(text) {
        actionNotes = [{ kind: 'error', text: text }];
        renderStatus();
      }

      /* ── Input: buttons, drop zone, folders, paste ── */
      pickBtn.addEventListener('click', function (e) { e.stopPropagation(); fileInput.click(); });
      pickDirBtn.addEventListener('click', function (e) { e.stopPropagation(); dirInput.click(); });
      dropEl.addEventListener('click', function (e) {
        if (e.target === dropEl || e.target.closest('.ssg-drop-text, .ssg-drop-icon')) fileInput.click();
      });
      dropEl.addEventListener('dragover', function (e) { e.preventDefault(); dropEl.classList.add('drag-over'); });
      dropEl.addEventListener('dragleave', function () { dropEl.classList.remove('drag-over'); });
      fileInput.addEventListener('change', function () {
        addEntries(filesToEntries(this.files));
        this.value = '';
      });
      dirInput.addEventListener('change', function () {
        addEntries(filesToEntries(this.files));
        this.value = '';
      });
      wrapEl.addEventListener('dragover', function (e) { e.preventDefault(); });
      wrapEl.addEventListener('drop', function (e) {
        e.preventDefault();
        dropEl.classList.remove('drag-over');
        if (e.dataTransfer) addFromDrop(e.dataTransfer);
      });
      document.addEventListener('paste', function (e) {
        if (!e.clipboardData || !e.clipboardData.files || !e.clipboardData.files.length) return;
        e.preventDefault();
        addEntries(filesToEntries(e.clipboardData.files));
      });
      // The page-wide Ctrl/Cmd+L empties text fields and the saved options;
      // here it also removes the images. Options stay as they are.
      document.addEventListener('keydown', function (e) {
        if (!(e.metaKey || e.ctrlKey) || (e.key !== 'l' && e.key !== 'L')) return;
        if (!wrapEl.contains(document.activeElement)) return;
        setTimeout(function () {
          clearAll();
          nameInput.value = prefs.sheetName;
          savePrefs();
        }, 0);
      });

      /* ── Image list ── */
      listEl.addEventListener('click', function (e) {
        var btn = e.target.closest('.ssg-remove');
        if (btn) removeItem(parseInt(btn.dataset.seq, 10));
      });
      clearBtn.addEventListener('click', function () {
        clearAll();
        pickBtn.focus();
      });
      orderSelect.addEventListener('change', function () {
        prefs.order = orderSelect.value === 'added' ? 'added' : 'name';
        savePrefs();
        renderList();
        scheduleRebuild();
      });

      /* ── Options (persisted as preferences) ── */
      layoutRadios.forEach(function (r) {
        r.addEventListener('change', function () {
          if (!r.checked) return;
          prefs.layout = r.value === 'grid' ? 'grid' : 'packed';
          toggleFields();
          savePrefs();
          scheduleRebuild();
        });
      });
      function bindNumber(input, key, min, max, fallback) {
        input.addEventListener('input', function () {
          prefs[key] = input.value === '' ? fallback : toInt(input.value, min, max, fallback);
          savePrefs();
          scheduleRebuild();
        });
        input.addEventListener('change', function () {
          input.value = key === 'columns' && !prefs[key] ? '' : String(prefs[key]);
        });
      }
      bindNumber(columnsInput, 'columns', 1, 1000, 0);
      bindNumber(spacingInput, 'spacing', 0, 64, 0);
      bindNumber(marginInput, 'margin', 0, 64, 0);
      bindNumber(extrudeInput, 'extrude', 0, 8, 0);
      maxWidthSelect.addEventListener('change', function () {
        var v = Number(maxWidthSelect.value);
        prefs.maxWidth = MAX_WIDTHS.indexOf(v) >= 0 ? v : 2048;
        savePrefs();
        scheduleRebuild();
      });
      function bindCheck(input, key, after) {
        input.addEventListener('change', function () {
          prefs[key] = input.checked;
          savePrefs();
          after();
        });
      }
      bindCheck(trimInput, 'trim', function () { scheduleRebuild(); });
      bindCheck(aliasInput, 'alias', function () { scheduleRebuild(); });
      bindCheck(potInput, 'pot', function () { scheduleRebuild(); });
      bindCheck(keepExtInput, 'keepExt', function () { renderList(); scheduleRebuild(0); });
      bindCheck(gifFramesInput, 'gifFrames', function () {});
      bindCheck(boundsInput, 'showBounds', function () { renderBounds(); });
      formatSelect.addEventListener('change', function () {
        prefs.format = FORMATS[formatSelect.value] ? formatSelect.value : 'hash';
        toggleFields();
        savePrefs();
        refreshData();
        renderStatus();
      });
      ratioSelect.addEventListener('change', function () {
        prefs.cssRatio = toInt(ratioSelect.value, 1, 3, 1);
        savePrefs();
        refreshData();
        renderStatus();
      });
      imgFmtSelect.addEventListener('change', function () {
        prefs.imageFormat = IMAGE_FORMATS[imgFmtSelect.value] && (imgFmtSelect.value !== 'webp' || webpOk) ? imgFmtSelect.value : 'png';
        imgFmtSelect.value = prefs.imageFormat;
        savePrefs();
        refreshData();
        renderStatus();
      });
      svgScaleSelect.addEventListener('change', function () {
        prefs.svgScale = toInt(svgScaleSelect.value, 1, 4, 1);
        savePrefs();
        if (!items.some(function (it) { return it.kind === 'svg'; })) return;
        var token = loadToken;
        addQueue = addQueue.then(function () { return rerasterSvgs(token); }).catch(function () {});
      });
      nameInput.addEventListener('input', function () {
        prefs.sheetName = nameInput.value;
        savePrefs();
        refreshData();
      });
      nameInput.addEventListener('change', function () {
        prefs.sheetName = sanitizeSheetName(nameInput.value);
        nameInput.value = prefs.sheetName;
        savePrefs();
        refreshData();
      });

      /* ── Output actions ── */
      dlImgBtn.addEventListener('click', function () {
        flushRebuild();
        if (!built) return;
        var img = imageInfo();
        var name = sheetName() + '.' + img.ext;
        var label = img.ext === 'webp' ? 'WebP' : 'PNG';
        if (exportNoteList.some(function (n) { return n.kind === 'error'; })) { renderStatus(); return; }
        try {
          canvas.toBlob(function (blob) {
            if (!blob || blob.type !== img.mime) { showActionError(fmt(t.statusExportFailed, { ext: label })); return; }
            downloadBlob(blob, name);
            if (window.trackTool) window.trackTool(SLUG, img.ext);
          }, img.mime, 1);
        } catch (e) {
          showActionError(fmt(t.statusExportFailed, { ext: label }));
        }
      });
      dlDataBtn.addEventListener('click', function () {
        flushRebuild();
        if (!built || !dataEl.value) return;
        var info = FORMATS[prefs.format];
        downloadBlob(new Blob([dataEl.value], { type: info.mime }), sheetName() + '.' + info.ext);
        if (window.trackTool) window.trackTool(SLUG, 'data');
      });
      copyBtn.addEventListener('click', function () {
        flushRebuild();
        if (!dataEl.value) return;
        function done() {
          copyBtn.textContent = t.copied;
          copyBtn.classList.add('copied');
          setTimeout(function () { copyBtn.textContent = t.copy; copyBtn.classList.remove('copied'); }, 1500);
          if (window.trackTool) window.trackTool(SLUG, 'copy');
        }
        function fallback() {
          var ok = false;
          try { dataEl.focus(); dataEl.select(); ok = document.execCommand('copy'); } catch (e) { ok = false; }
          if (ok) done(); else showActionError(t.statusCopyFailed);
        }
        if (!navigator.clipboard || !navigator.clipboard.writeText) { fallback(); return; }
        navigator.clipboard.writeText(dataEl.value).then(done, fallback);
      });

      loadPrefs();
      applyPrefsToUI();
      refreshData();
    })();
  </script>

  <style is:global>
    .ssg-wrap { display: flex; flex-direction: column; gap: 0.85rem; }
    /* Author display rules beat the UA [hidden] rule; restore it. */
    .ssg-wrap [hidden] { display: none; }

    .ssg-drop {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      border: 2px dashed var(--color-border);
      border-radius: var(--radius-md);
      padding: 1.25rem 1rem;
      text-align: center;
      cursor: pointer;
      transition: border-color var(--transition-fast), background var(--transition-fast);
      background: var(--color-bg-secondary);
    }
    .ssg-drop:hover,
    .ssg-drop.drag-over {
      border-color: var(--color-primary);
      background: var(--color-surface);
    }
    .ssg-drop-icon { color: var(--color-text-secondary); flex-shrink: 0; }
    .ssg-drop-text {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      color: var(--color-text-secondary);
      min-width: 0;
    }
    .ssg-drop-text p { margin: 0; }
    .ssg-drop-hint { font-size: 0.95rem; }
    .ssg-hint { font-size: 0.8rem; }
    .ssg-drop-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      cursor: default;
    }
    .ssg-drop.is-compact {
      flex-direction: row;
      flex-wrap: wrap;
      padding: 0.6rem 0.75rem;
      text-align: left;
    }
    .ssg-drop.is-compact .ssg-drop-icon,
    .ssg-drop.is-compact .ssg-hint { display: none; }
    .ssg-drop.is-compact .ssg-drop-text { flex: 1 1 14rem; }
    .ssg-drop.is-compact .ssg-drop-hint { font-size: 0.88rem; }

    .ssg-panel {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 0.9rem 1rem;
      border-radius: var(--radius-md);
      background: var(--color-bg-secondary);
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
    }

    .ssg-list-head {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem 0.75rem;
    }
    .ssg-count {
      margin-right: auto;
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--color-text);
    }
    .ssg-list-tools {
      display: flex;
      align-items: center;
      gap: 0.5rem 0.75rem;
      margin-left: auto;
    }
    .ssg-inline-field { display: inline-flex; align-items: center; gap: 0.5rem; }
    .ssg-select { cursor: pointer; }
    .ssg-inline-field .ssg-select { width: auto; }

    .ssg-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
      gap: 0.5rem;
      max-height: 340px;
      overflow-x: hidden;
      overflow-y: auto;
      padding: 0.2rem;
    }
    .ssg-item {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      min-width: 0;
      padding: 0.35rem;
      border-radius: var(--radius-md);
      background: var(--color-surface);
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
    }
    .ssg-thumb {
      display: flex;
      align-items: center;
      justify-content: center;
      aspect-ratio: 1;
      overflow: hidden;
      border-radius: var(--radius-sm);
      background: repeating-conic-gradient(color-mix(in oklch, var(--color-text-muted) 22%, transparent) 0% 25%, transparent 0% 50%) 0 0 / 12px 12px;
    }
    .ssg-thumb canvas {
      display: block;
      max-width: 100%;
      max-height: 100%;
    }
    .ssg-thumb canvas.ssg-pixelated { image-rendering: pixelated; }
    .ssg-item-name,
    .ssg-item-size {
      overflow: hidden;
      font-family: var(--font-mono);
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .ssg-item-name { font-size: 0.72rem; font-weight: 700; color: var(--color-text); }
    .ssg-item-size { font-size: 0.7rem; color: var(--color-text-secondary); }
    .ssg-remove {
      position: absolute;
      top: 0.2rem;
      right: 0.2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--color-surface);
      color: var(--color-text-secondary);
      box-shadow: inset 0 0 0 1px var(--color-border-soft), var(--shadow-subtle);
      cursor: pointer;
      transition: background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
    }
    /* 44px tap area around the 28px button. */
    .ssg-remove::before {
      content: '';
      position: absolute;
      inset: -8px;
    }
    @media (hover: hover) {
      .ssg-remove:hover { color: var(--color-danger); background: var(--color-surface-muted); }
    }
    .ssg-remove:active { transform: scale(0.96); }
    .ssg-remove:focus-visible {
      outline: none;
      box-shadow: 0 0 0 1px var(--color-primary), 0 0 0 4px var(--color-primary-light);
    }

    .ssg-options {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
      gap: 0.75rem 1rem;
    }
    .ssg-field {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      min-width: 0;
    }
    .ssg-field .tool-input { width: 100%; }
    .ssg-fieldset {
      margin: 0;
      padding: 0;
      border: 0;
      min-width: 0;
    }
    .ssg-fieldset legend { padding: 0; margin-bottom: 0.3rem; }
    .ssg-seg {
      padding: 3px;
      background: var(--color-surface-muted);
    }
    .ssg-seg label {
      position: relative;
      flex: 1 1 0;
      min-width: 0;
    }
    .ssg-seg input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
    }
    .ssg-seg span {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 38px;
      padding: 0 0.75rem;
      border-radius: var(--radius-pill);
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--color-text-secondary);
      cursor: pointer;
      transition: background-color var(--transition-fast), color var(--transition-fast);
    }
    .ssg-seg input:checked + span {
      background: var(--color-surface);
      color: var(--color-primary);
      box-shadow: var(--shadow-subtle);
    }
    .ssg-seg input:focus-visible + span {
      box-shadow: 0 0 0 1px var(--color-primary), 0 0 0 4px var(--color-primary-light);
    }

    .ssg-checks {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1.25rem;
    }
    .ssg-check {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 44px;
      font-size: 0.88rem;
      color: var(--color-text);
      cursor: pointer;
    }
    .ssg-check input { width: 18px; height: 18px; margin: 0; flex-shrink: 0; }

    .ssg-status-line { display: block; }
    .ssg-status-line.is-success { color: var(--color-success); }
    .ssg-status-line.is-error { color: var(--color-danger); }
    .ssg-status-line.is-info { color: var(--color-primary); }
    .ssg-status-line a { color: inherit; font-weight: 700; text-decoration: underline; }

    .ssg-meta-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0 1rem;
    }
    .ssg-meta {
      margin: 0 auto 0 0;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--color-text-secondary);
    }
    .ssg-preview {
      max-height: 480px;
      overflow: auto;
      border-radius: var(--radius-md);
      background: var(--color-surface);
      box-shadow: inset 0 0 0 1px var(--color-border-soft);
    }
    .ssg-stage {
      position: relative;
      display: inline-block;
      max-width: 100%;
      vertical-align: top;
      background: repeating-conic-gradient(color-mix(in oklch, var(--color-text-muted) 22%, transparent) 0% 25%, transparent 0% 50%) 0 0 / 16px 16px;
    }
    .ssg-canvas {
      display: block;
      max-width: 100%;
      height: auto;
    }
    .ssg-bounds {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .ssg-bounds rect {
      fill: none;
      stroke: var(--color-primary);
      stroke-width: 1;
      vector-effect: non-scaling-stroke;
    }
    .ssg-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .ssg-actions .ssg-copy { min-height: 40px; padding: 0.52rem 1.1rem; font-size: 0.9rem; }
    .ssg-data { min-height: 160px; }

    @media (max-width: 640px) {
      .ssg-drop { padding: 1rem 0.75rem; }
      .ssg-drop-icon { display: none; }
      .ssg-pick-dir { display: none; }
      .ssg-drop-actions .btn-primary,
      .ssg-drop-actions .btn-secondary { min-height: 44px; }
      .ssg-list {
        grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
        max-height: 50vh;
      }
      .ssg-seg span { min-height: 44px; }
      .ssg-actions .btn-primary,
      .ssg-actions .btn-secondary,
      .ssg-actions .ssg-copy { flex: 1 1 45%; min-height: 44px; }
      .ssg-preview { max-height: 360px; }
    }
  </style>
</div>
