          statusCopyFailed: 'コピーがブロックされました。テキストを選択して手動でコピーしてください',
        },
        ko: {
          dropAria: '이미지 선택',
          dropHint: '이미지를 여기로 드롭하거나 <strong>클릭해서 선택</strong>',
          pasteHint: '복사한 이미지 파일을 Ctrl/Cmd+V로 붙여넣을 수도 있습니다',
