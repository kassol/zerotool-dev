const L = STRINGS[lang];
---

<div
  class="jtm-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-err-json={L.errJson}
  data-err-json-at={L.errJsonAt}
  data-json-parse={JSON.stringify(L.jsonParse)}
  data-msg-gen-one={L.msgGenOne}
  data-msg-gen-many={L.msgGenMany}
  data-msg-ignored={L.msgIgnored}
  data-msg-skipped={L.msgSkipped}
  data-msg-reserved={L.msgReserved}
  data-msg-breaks={L.msgBreaks}
  data-msg-members={L.msgMembers}
  data-msg-too-deep={L.msgTooDeep}
>
  <div class="jtm-config">
    <div class="jtm-config-row jtm-model-row">
      <div class="jtm-control-label"><label for="jtm-model-name">{L.modelName}</label><Toggletip id="jtm-tip-model" lang={lang} about={L.modelName}>{L.tips.model}</Toggletip></div>
      <input id="jtm-model-name" type="text" value="User" spellcheck="false" />
    </div>
    <div class="jtm-config-row">
      <div class="jtm-control-label"><span id="jtm-language-label">{L.language}</span><Toggletip id="jtm-tip-language" lang={lang} about={L.language}>{L.tips.language}</Toggletip></div>
      <div class="jtm-tabs zt-segmented" id="jtm-lang-tabs" role="group" aria-labelledby="jtm-language-label">
        <button type="button" class="jtm-tab active" data-lang="javascript" aria-pressed="true">{L.langJs}</button>
        <button type="button" class="jtm-tab" data-lang="typescript" aria-pressed="false">{L.langTs}</button>
      </div>
    </div>
    <div class="jtm-config-row">
      <div class="jtm-control-label"><span id="jtm-timestamps-label">{L.timestamps}</span><Toggletip id="jtm-tip-timestamps" lang={lang} about={L.timestamps}>{L.tips.timestamps}</Toggletip></div>
      <div class="jtm-tabs zt-segmented" id="jtm-ts-tabs" role="group" aria-labelledby="jtm-timestamps-label">
        <button type="button" class="jtm-tab active" data-ts="true" aria-pressed="true">{L.on}</button>
        <button type="button" class="jtm-tab" data-ts="false" aria-pressed="false">{L.off}</button>
      </div>
    </div>
    <div class="jtm-config-row">
      <div class="jtm-control-label"><span id="jtm-required-label">{L.required}</span><Toggletip id="jtm-tip-required" lang={lang} about={L.required}>{L.tips.required}</Toggletip></div>
      <div class="jtm-tabs zt-segmented" id="jtm-req-tabs" role="group" aria-labelledby="jtm-required-label">
        <button type="button" class="jtm-tab" data-req="true" aria-pressed="false">{L.on}</button>
        <button type="button" class="jtm-tab active" data-req="false" aria-pressed="true">{L.off}</button>
      </div>
    </div>
  </div>
  <div class="jtm-actions">
    <div class="jtm-control-label"><button id="jtm-example" class="btn-ghost" type="button">{L.example}</button><Toggletip id="jtm-tip-example" lang={lang} about={L.example}>{L.tips.example}</Toggletip></div>
    <div class="jtm-control-label"><button id="jtm-clear" class="btn-ghost" type="button">{L.clear}</button><Toggletip id="jtm-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip></div>
  </div>
