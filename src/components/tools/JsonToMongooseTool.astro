        copyBtn.disabled = false;
      }

      // Analytics: one event per committed edit (change), Example or new option, only when a
      // schema is shown; not on page load or after each typing pause. An event that repeats the previous
      // one (same JSON, model name and options: Example clicked again, or a change after a click) is
      // skipped; switching back to earlier options sends again. Clear starts over.
      var lastTracked = null;
      function trackGenerate() {
        if (!outputCodeEl.textContent || copyBtn.disabled) return;
        var key = [inputEl.value, modelNameEl.value.trim() || 'User', currentLang, currentTimestamps, currentRequired].join('\u0000');
        if (key === lastTracked) return;
        lastTracked = key;
        window.trackTool && window.trackTool('json-to-mongoose', 'generate');
      }

      // Mongoose 9.10.3 members of a model document, a single nested subdocument and a document array
      // element that are not in Schema.reserved (lib/document.js, lib/model.js, lib/types/subdocument.js,
      // lib/types/arraySubdocument.js; the test rebuilds both lists with Mongoose 9.10.3). A field named as
      // in DOC_BREAKS makes model(), new Model(), validateSync(), toObject() or JSON.stringify() fail or
      // change; one named as in DOC_MEMBERS only replaces the member on the document. _id, __v and id are
      // real paths (Mongoose skips its id getter when the schema has an id path), constructor never is.
      var DOC_BREAKS = [
        '$__', '$__buildDoc', '$__getValue', '$__hasOnlyPrimitiveValues', '$__init', '$__middleware', '$__parent',
        '$__path', '$__pathRelativeToParent', '$__saveInitialState', '$__schema', '$__schemaTypeOptions', '$__set',
        '$__setSchema', '$__toObjectShallow', '$__validateSync', '$basePath', '$emit', '$get', '$isDefault',
        '$isModified', '$isSingleNested', '$isValid', '$markValid', '$parent', '$session', '$set', '$setIndex',
        '$toObject', '__index', '__parentArray', '_doc', 'get', 'isDirectModified', 'markModified', 'modifiedPaths',
        'schema', 'toBSON', 'toJSON', 'toObject', 'validateSync'
      ];
      var DOC_MEMBERS = [
        '$__delta', '$__dirty', '$__fullPath', '$__fullPathWithIndexes', '$__getArrayPathsToValidate',
        '$__handleReject', '$__isSelected', '$__removeFromParent', '$__reset', '$__resetAtomics', '$__save',
        '$__setParent', '$__setValue', '$__shouldModify', '$__undoReset', '$__version', '$__where', '$addListener',
        '$assertPopulated', '$clearModifiedPaths', '$clone', '$collection', '$createModifiedPathsSnapshot',
        '$getAllSubdocs', '$getChanges', '$getPopulatedDocs', '$ignore', '$inc', '$init', '$isDeleted',
        '$isDocumentArrayElement', '$isEmpty', '$isMongooseDocumentPrototype', '$isMongooseModelPrototype', '$isNew',
        '$isSubdocument', '$listeners', '$locals', '$model', '$on', '$once', '$op', '$populated',
        '$removeAllListeners', '$removeListener', '$restoreModifiedPathsSnapshot', '$save', '$setMaxListeners',
        '$timestamps', '$validate', '$where', '_applyVersionIncrement', '_execDocumentPostHooks',
        '_execDocumentPreHooks', 'addListener', 'db', 'deleteOne', 'depopulate', 'directModifiedPaths',
        'discriminators', 'equals', 'getChanges', 'increment', 'inspect', 'invalidate', 'isDirectSelected', 'isInit',
        'isSelected', 'model', 'on', 'once', 'overwrite', 'ownerDocument', 'parent', 'parentArray', 'populate',
        'removeAllListeners', 'replaceOne', 'set', 'setMaxListeners', 'toString', 'unmarkModified', 'updateOne'
      ];

      // A stack overflow while walking very deep JSON: RangeError "Maximum call stack size exceeded" in Chrome
      // and Safari, InternalError "too much recursion" in Firefox (MDN: "Too much recursion"). The generator
      // recurses per nesting level, so valid JSON can be too deep for it; never leave the previous schema then.
      function isTooDeep(e) {
        return !!e && (e.name === 'RangeError' || e.name === 'InternalError') && /call stack|recursion/i.test(String(e.message));
      }
      function convert() {
        try {
          convertNow();
        } catch (e) {
          if (!isTooDeep(e)) throw e;
          clearOutput();
          setStatus(MSG_TOO_DEEP, true);
        }
      }

      function convertNow() {
        clearTimeout(_liveTimer);
        _liveTimer = null;
        resetCopy();
        inputEl.classList.remove('error');
        var raw = inputEl.value.trim();
        if (!raw) { clearStatus(); clearOutput(); return; }
        inputEl.classList.remove('error');

        var parsed;
        try {
          parsed = JSON.parse(raw);
        } catch (e) {
          inputEl.classList.add('error');
          clearOutput();
          setStatus(jsonErrorText(inputEl.value), true);
          return;
        }

        inputEl.classList.remove('error');
        var rawModelName = modelNameEl.value.trim() || 'User';

        var schemas = [];
        var skippedNote = '';

        if (parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed)) {
          buildRootSchema([parsed], rawModelName, schemas);
        } else if (Array.isArray(parsed)) {
          var objItems = parsed.filter(function (v) {
            return v !== null && typeof v === 'object' && !Array.isArray(v);
          });
          if (objItems.length > 0) {
            buildRootSchema(objItems, rawModelName, schemas);
            // A schema describes the objects; report the other values instead of dropping them silently.
            var skippedTypes = [], skippedCounts = [];
            parsed.forEach(function (v) {
              if (objItems.indexOf(v) !== -1) return;
              var t = v === null ? 'null' : Array.isArray(v) ? 'array' : typeof v;
              var at = skippedTypes.indexOf(t);
              if (at === -1) { skippedTypes.push(t); skippedCounts.push(1); } else skippedCounts[at]++;
            });
            if (skippedTypes.length) {
              skippedNote = ' ' + MSG_SKIPPED.replace('{n}', String(parsed.length - objItems.length)).replace('{types}', skippedTypes.map(function (t, i) {
                return skippedCounts[i] > 1 ? t + ' × ' + skippedCounts[i] : t;
              }).join(', '));
            }
          } else {
            showOutput('// Array of primitives — no schema to generate');
            setStatus(MSG_GEN_ONE, false);
            return;
          }
        } else {
          showOutput('// Primitive value — no schema to generate');
          setStatus(MSG_GEN_ONE, false);
          return;
        }

        showOutput(renderOutput(schemas, rawModelName, currentLang, currentTimestamps, currentRequired));
        var count = schemas.length;
        var msg = count === 1 ? MSG_GEN_ONE : MSG_GEN_MANY.replace('{n}', String(count));
        // Mongoose skips these keys when it builds a schema (lib/schema.js, specialProperties).
        var ignored = ['__proto__', 'constructor', 'prototype'].filter(function (k) {
          return schemas.some(function (s) { return s.fields.some(function (f) { return f.key === k; }); });
        });
        if (ignored.length) msg += ' ' + MSG_IGNORED.replace('{keys}', ignored.join(', '));
        // Mongoose 9.10.3 Schema.reserved (lib/schema.js): kept as paths with a warning; the field
        // value replaces the document method of the same name. get and toObject also break a document,
        // so they are named once, with DOC_BREAKS below.
        var reservedKeys = ['collection', 'emit', 'errors', 'get', 'init', 'isModified', 'isNew', 'listeners', 'populated', 'remove', 'removeListener', 'save', 'toObject', 'validate'].filter(function (k) {
          return DOC_BREAKS.indexOf(k) === -1 && schemas.some(function (s) { return s.fields.some(function (f) { return f.key === k; }); });
        });
        if (reservedKeys.length) msg += ' ' + MSG_RESERVED.replace('{keys}', reservedKeys.join(', '));
        var hasField = function (k) { return schemas.some(function (s) { return s.fields.some(function (f) { return f.key === k; }); }); };
        var breakKeys = DOC_BREAKS.filter(hasField);
        var memberKeys = DOC_MEMBERS.filter(hasField);
        if (breakKeys.length) msg += ' ' + MSG_BREAKS.replace('{keys}', breakKeys.join(', '));
        if (memberKeys.length) msg += ' ' + MSG_MEMBERS.replace('{keys}', memberKeys.join(', '));
        setStatus(msg + skippedNote, false);
        if (breakKeys.length) statusEl.className = 'jtm-status warn';
      }

      var _liveTimer = null;
      inputEl.addEventListener('input', function () {
        resetCopy();
        clearTimeout(_liveTimer);
        _liveTimer = setTimeout(convert, 300);
      });
      modelNameEl.addEventListener('input', function () {
        resetCopy();
        clearTimeout(_liveTimer);
        _liveTimer = setTimeout(convert, 300);
      });
      // A committed edit runs a pending generation first, so the event matches the shown schema.
      function commitEdit() {
        if (_liveTimer) convert();
        trackGenerate();
      }
      inputEl.addEventListener('change', commitEdit);
      modelNameEl.addEventListener('change', commitEdit);

      document.getElementById('jtm-example').addEventListener('click', function () {
        inputEl.value = EXAMPLE;
        inputEl.classList.remove('error');
        clearStatus();
        convert();
        trackGenerate();
      });

      function clearAll() {
        clearTimeout(_liveTimer);
        _liveTimer = null;
        lastTracked = null;
        resetCopy();
        inputEl.value = '';
        clearOutput();
        inputEl.classList.remove('error');
        clearStatus();
        inputEl.focus();
      }
      document.getElementById('jtm-clear').addEventListener('click', clearAll);
      // ToolLayout clears text fields without input events; clear the result synchronously.
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
          e.preventDefault();
          clearAll();
        }
      });

      copyBtn.addEventListener('click', function () {
        var text = outputCodeEl.textContent;
        if (!text || copyBtn.disabled) return;
        resetCopy();
        var revision = copyRevision;
        function failed() {
          if (revision === copyRevision) copyBtn.textContent = COPY_FAILED;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            copyBtn.textContent = COPIED;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = COPY;
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });

      inputEl.value = EXAMPLE;
      convert();
    })();
  </script>
</div>

<style>
  .jtm-wrap { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; gap: 0.75rem; }
  .jtm-config, .jtm-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .jtm-config-row, .jtm-control-label { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .jtm-config-row { font-size: 0.85rem; color: var(--color-text-secondary); }
  .jtm-model-row { width: 18rem; }
  .jtm-model-row input { width: 8rem; min-width: 0; flex: 1; padding: 0.4rem 0.5rem; font-size: 0.85rem; font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg); color: var(--color-text); }
  .jtm-model-row input:focus { outline: none; border-color: var(--color-primary); }
  .jtm-tabs { flex: none; }
  .jtm-tab { padding: 0.35rem 0.6rem; font-size: 0.78rem; border: 0; border-radius: 999px; background: transparent; color: var(--color-text-secondary); cursor: pointer; }
  .jtm-tab.active { background: var(--color-text); color: var(--color-bg); }
  .jtm-tab:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jtm-panel-header { display: flex; align-items: center; justify-content: space-between; min-height: 44px; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .jtm-panel textarea, .jtm-output { width: 100%; min-width: 0; font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.5; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-secondary); color: var(--color-text); }
  .jtm-panel textarea { resize: none; overflow: auto; }
  .jtm-panel textarea:focus { outline: none; border-color: var(--color-primary); }
  .jtm-panel textarea.error { border-color: #c0392b; }
  .jtm-output { margin: 0; overflow: auto; white-space: pre; }
  .jtm-output:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jtm-empty { display: none; margin: 0; padding: 2rem; align-items: center; justify-content: center; text-align: center; color: var(--color-text-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .jtm-output-pane:has(#jtm-output-code:empty) .jtm-output { display: none; }
  .jtm-output-pane:has(#jtm-output-code:empty) .jtm-empty { display: flex; }
  .jtm-status { font-size: 0.85rem; line-height: 1.4; height: 2.4rem; flex: none; overflow: auto; overflow-wrap: anywhere; }
  .jtm-status.success { color: #057a55; }
  .jtm-status.error { color: #c0392b; }
  .jtm-status.warn { color: #b45309; }
  #jtm-copy:disabled { opacity: 0.45; cursor: not-allowed; }
  @media (max-width: 860px) {
    .jtm-wrap { gap: 0.5rem; }
    .jtm-model-row { width: 100%; }
    .jtm-model-row .jtm-control-label { flex: 1; }
    .jtm-model-row input { width: 45%; flex: none; }
    .jtm-panel textarea { height: 144px; min-height: 144px; flex: none; }
    .jtm-output { height: 22rem; min-height: 160px; }
    .jtm-output-pane:has(#jtm-output-code:empty) { display: none; }
  }
  @media (max-width: 640px) {
    .jtm-wrap { gap: 0.25rem; }
    .jtm-panel textarea { height: 100px; min-height: 100px; }
    .jtm-panel-header .jtm-control-label { flex: none; }
    .jtm-config { gap: 0.4rem 0.75rem; }
    .jtm-actions button, .jtm-panel-header button, .jtm-tab, .jtm-model-row input { min-height: 44px; }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .jtm-status.success { color: #34d399; }
    :global(:root:not([data-theme="light"])) .jtm-status.error { color: #f87171; }
    :global(:root:not([data-theme="light"])) .jtm-status.warn { color: #fbbf24; }
    :global(:root:not([data-theme="light"])) .jtm-panel textarea.error { border-color: #f87171; }
    :global(:root:not([data-theme="light"])) .jtm-tab.active { background: var(--color-text); color: var(--color-bg); }
  }
  :global([data-theme="dark"]) .jtm-status.success { color: #34d399; }
  :global([data-theme="dark"]) .jtm-status.error { color: #f87171; }
  :global([data-theme="dark"]) .jtm-status.warn { color: #fbbf24; }
  :global([data-theme="dark"]) .jtm-panel textarea.error { border-color: #f87171; }
  :global([data-theme="dark"]) .jtm-tab.active { background: var(--color-text); color: var(--color-bg); }
</style>
