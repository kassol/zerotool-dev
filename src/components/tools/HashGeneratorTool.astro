---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  "en": {
    "inputLabel": "Input Text",
    "inputPlaceholder": "Enter text to hash...",
    "generate": "Generate Hashes",
    "clear": "Clear",
    "copy": "Copy",
    "copied": "Copied!",
    "copyFail": "Could not copy. Please select the hash and copy it manually.",
    "hashing": "Hashing...",
    "hashesGenerated": "Hashes generated.",
    "errEmpty": "Please enter some text.",
    "outputLabel": "Hashes",
    "emptyOutput": "Your five hash values will appear here.",
    "tips": {
      "input": "Enter text to hash as UTF-8 bytes. Spaces and line breaks count. Empty input is not hashed. An unpaired surrogate is replaced with U+FFFD when encoded.",
      "generate": "Generate MD5, SHA-1, SHA-256, SHA-384 and SHA-512 from the current text. Editing does not calculate again. Use Ctrl/⌘+Enter to generate while focused in the tool. SHA uses the browser Web Crypto API; after an error, try Generate Hashes again.",
      "copy": "Each Copy button copies that row’s complete lowercase hexadecimal value. If copying fails, select the value and copy it manually.",
      "clear": "Clear empties the input and all results and discards pending results. Ctrl/⌘+L does the same while focused in the tool. This tool does not save its input or results."
    }
  },
  "zh": {
    "inputLabel": "输入文本",
    "inputPlaceholder": "输入要哈希的文本...",
    "generate": "生成哈希",
    "clear": "清除",
    "copy": "复制",
    "copied": "已复制！",
    "copyFail": "复制失败。请选中哈希值后手动复制。",
    "hashing": "计算中...",
    "hashesGenerated": "哈希已生成。",
    "errEmpty": "请输入文本。",
    "outputLabel": "哈希值",
    "emptyOutput": "五种哈希值会显示在这里。",
    "tips": {
      "input": "输入文本，按 UTF-8 字节计算哈希。空格和换行也计入；空输入不计算。编码时，孤立代理项会替换为 U+FFFD。",
      "generate": "根据当前文本计算 MD5、SHA-1、SHA-256、SHA-384 和 SHA-512。编辑文本后需要重新生成。在工具内按 Ctrl/⌘+Enter 也可生成。SHA 使用浏览器 Web Crypto API；出错后可再次点击「生成哈希」。",
      "copy": "每个「复制」按钮复制该行完整的小写十六进制哈希值。复制失败时，请选中哈希值后手动复制。",
      "clear": "「清除」清空输入和所有结果，并丢弃等待中的结果。在工具内按 Ctrl/⌘+L 也可清空。本工具不保存输入或结果。"
    }
  },
  "ja": {
    "inputLabel": "入力テキスト",
    "inputPlaceholder": "ハッシュするテキストを入力...",
    "generate": "ハッシュを生成",
    "clear": "クリア",
    "copy": "コピー",
    "copied": "コピー済み！",
    "copyFail": "コピーできませんでした。ハッシュを選択して手動でコピーしてください。",
    "hashing": "計算中...",
    "hashesGenerated": "ハッシュが生成されました。",
    "errEmpty": "テキストを入力してください。",
    "outputLabel": "ハッシュ値",
    "emptyOutput": "5種類のハッシュ値をここに表示します。",
    "tips": {
      "input": "テキストを UTF-8 のバイト列としてハッシュ化します。スペースや改行も含みます。空の入力は計算しません。単独のサロゲートはエンコード時に U+FFFD に置き換えます。",
      "generate": "現在のテキストから MD5、SHA-1、SHA-256、SHA-384、SHA-512 を計算します。編集後は再生成してください。ツール内で Ctrl/⌘+Enter を押しても生成できます。SHA はブラウザーの Web Crypto API を使います。エラー後は「ハッシュを生成」で再試行できます。",
      "copy": "各「コピー」ボタンは、その行の小文字の16進数をすべてコピーします。失敗した場合は値を選択し、手動でコピーしてください。",
      "clear": "「クリア」は入力とすべての結果を消し、処理中の結果を破棄します。ツール内の Ctrl/⌘+L でも消去できます。入力や結果は保存しません。"
    }
  },
  "ko": {
    "inputLabel": "입력 텍스트",
    "inputPlaceholder": "해시할 텍스트를 입력...",
    "generate": "해시 생성",
    "clear": "지우기",
    "copy": "복사",
    "copied": "복사됨!",
    "copyFail": "복사하지 못했습니다. 해시를 선택하여 직접 복사하세요.",
    "hashing": "계산 중...",
    "hashesGenerated": "해시가 생성되었습니다.",
    "errEmpty": "텍스트를 입력해 주세요.",
    "outputLabel": "해시 값",
    "emptyOutput": "다섯 가지 해시 값이 여기에 표시됩니다.",
    "tips": {
      "input": "텍스트를 UTF-8 바이트로 인코딩해 해시합니다. 공백과 줄바꿈도 포함합니다. 빈 입력은 계산하지 않습니다. 짝이 없는 서로게이트는 인코딩할 때 U+FFFD로 바꿉니다.",
      "generate": "현재 텍스트로 MD5, SHA-1, SHA-256, SHA-384, SHA-512를 계산합니다. 텍스트를 편집한 뒤에는 다시 생성하세요. 도구에 초점이 있을 때 Ctrl/⌘+Enter로도 생성합니다. SHA는 브라우저 Web Crypto API를 사용하며, 오류 후 해시 생성 버튼으로 다시 시도할 수 있습니다.",
      "copy": "각 복사 버튼은 해당 행의 소문자 16진수 값 전체를 복사합니다. 실패하면 값을 선택하여 직접 복사하세요.",
      "clear": "지우기는 입력과 모든 결과를 비우고 대기 중인 결과를 버립니다. 도구에 초점이 있을 때 Ctrl/⌘+L로도 지웁니다. 이 도구는 입력이나 결과를 저장하지 않습니다."
    }
  }
} as const;
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---
<div class="hg-wrap">
    <div class="hg-actions">
      <div class="hg-control">
        <button id="hg-hash" class="btn-primary" type="button">{T.generate}</button>
        <Toggletip id="hg-tip-generate" about={T.generate} lang={lang}>{TIPS.generate}</Toggletip>
      </div>
      <div class="hg-control">
        <button id="hg-clear" class="btn-ghost" type="button">{T.clear}</button>
        <Toggletip id="hg-tip-clear" about={T.clear} lang={lang}>{TIPS.clear}</Toggletip>
      </div>
    </div>
    <div id="hg-status" class="hg-status" aria-live="polite"></div>
    <div class="hg-panels zt-io">
      <div class="hg-field zt-io-pane">
        <div class="hg-head">
          <label for="hg-input">{T.inputLabel}</label>
          <Toggletip id="hg-tip-input" about={T.inputLabel} lang={lang}>{TIPS.input}</Toggletip>
        </div>
        <textarea id="hg-input" class="tool-textarea hg-input zt-io-fill" placeholder={T.inputPlaceholder} spellcheck="false"></textarea>
      </div>
      <div id="hg-output-pane" class="hg-output-pane zt-io-pane">
        <div class="hg-head">
          <span id="hg-output-label">{T.outputLabel}</span>
          <Toggletip id="hg-tip-copy" about={T.copy} lang={lang}>{TIPS.copy}</Toggletip>
        </div>
        <div class="hg-output-body zt-io-fill" role="region" aria-labelledby="hg-output-label" tabindex="0">
          <div id="hg-results" class="hg-results"></div>
          <p class="hg-empty">{T.emptyOutput}</p>
        </div>
      </div>
    </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      // Compact MD5 — public domain implementation
      function md5(str) {
        function safeAdd(x, y) { var lsw=(x&0xffff)+(y&0xffff); return (((x>>16)+(y>>16)+(lsw>>16))<<16)|(lsw&0xffff); }
        function bitRotateLeft(num, cnt) { return (num<<cnt)|(num>>>(32-cnt)); }
        function md5cmn(q,a,b,x,s,t) { return safeAdd(bitRotateLeft(safeAdd(safeAdd(a,q),safeAdd(x,t)),s),b); }
        function md5ff(a,b,c,d,x,s,t) { return md5cmn((b&c)|((~b)&d),a,b,x,s,t); }
        function md5gg(a,b,c,d,x,s,t) { return md5cmn((b&d)|(c&(~d)),a,b,x,s,t); }
        function md5hh(a,b,c,d,x,s,t) { return md5cmn(b^c^d,a,b,x,s,t); }
        function md5ii(a,b,c,d,x,s,t) { return md5cmn(c^(b|(~d)),a,b,x,s,t); }
        // Same UTF-8 bytes as TextEncoder for the SHA rows: a lone surrogate becomes EF BF BD
        function str2rstr_utf8(input) {
          var bytes = new TextEncoder().encode(input), output = '';
          for (var i = 0; i < bytes.length; i++) output += String.fromCharCode(bytes[i]);
          return output;
        }
        function rstr2binl(input) {
          var output=new Array(input.length>>2);
          for(var i=0;i<output.length;i++){output[i]=0;}
          for(var i=0;i<input.length*8;i+=8){output[i>>5]|=(input.charCodeAt(i/8)&0xff)<<(i%32);}
          return output;
        }
        function binl2rstr(input) {
          var output='';
          for(var i=0;i<input.length*32;i+=8){output+=String.fromCharCode((input[i>>5]>>>(i%32))&0xff);}
          return output;
        }
        function binlMD5(x,len) {
          x[len>>5]|=0x80<<(len%32);x[(((len+64)>>>9)<<4)+14]=len;
          var i,olda,oldb,oldc,oldd,a=1732584193,b=-271733879,c=-1732584194,d=271733878;
          for(i=0;i<x.length;i+=16){
            olda=a;oldb=b;oldc=c;oldd=d;
            a=md5ff(a,b,c,d,x[i],7,-680876936);d=md5ff(d,a,b,c,x[i+1],12,-389564586);c=md5ff(c,d,a,b,x[i+2],17,606105819);b=md5ff(b,c,d,a,x[i+3],22,-1044525330);
            a=md5ff(a,b,c,d,x[i+4],7,-176418897);d=md5ff(d,a,b,c,x[i+5],12,1200080426);c=md5ff(c,d,a,b,x[i+6],17,-1473231341);b=md5ff(b,c,d,a,x[i+7],22,-45705983);
            a=md5ff(a,b,c,d,x[i+8],7,1770035416);d=md5ff(d,a,b,c,x[i+9],12,-1958414417);c=md5ff(c,d,a,b,x[i+10],17,-42063);b=md5ff(b,c,d,a,x[i+11],22,-1990404162);
            a=md5ff(a,b,c,d,x[i+12],7,1804603682);d=md5ff(d,a,b,c,x[i+13],12,-40341101);c=md5ff(c,d,a,b,x[i+14],17,-1502002290);b=md5ff(b,c,d,a,x[i+15],22,1236535329);
            a=md5gg(a,b,c,d,x[i+1],5,-165796510);d=md5gg(d,a,b,c,x[i+6],9,-1069501632);c=md5gg(c,d,a,b,x[i+11],14,643717713);b=md5gg(b,c,d,a,x[i],20,-373897302);
            a=md5gg(a,b,c,d,x[i+5],5,-701558691);d=md5gg(d,a,b,c,x[i+10],9,38016083);c=md5gg(c,d,a,b,x[i+15],14,-660478335);b=md5gg(b,c,d,a,x[i+4],20,-405537848);
            a=md5gg(a,b,c,d,x[i+9],5,568446438);d=md5gg(d,a,b,c,x[i+14],9,-1019803690);c=md5gg(c,d,a,b,x[i+3],14,-187363961);b=md5gg(b,c,d,a,x[i+8],20,1163531501);
            a=md5gg(a,b,c,d,x[i+13],5,-1444681467);d=md5gg(d,a,b,c,x[i+2],9,-51403784);c=md5gg(c,d,a,b,x[i+7],14,1735328473);b=md5gg(b,c,d,a,x[i+12],20,-1926607734);
            a=md5hh(a,b,c,d,x[i+5],4,-378558);d=md5hh(d,a,b,c,x[i+8],11,-2022574463);c=md5hh(c,d,a,b,x[i+11],16,1839030562);b=md5hh(b,c,d,a,x[i+14],23,-35309556);
            a=md5hh(a,b,c,d,x[i+1],4,-1530992060);d=md5hh(d,a,b,c,x[i+4],11,1272893353);c=md5hh(c,d,a,b,x[i+7],16,-155497632);b=md5hh(b,c,d,a,x[i+10],23,-1094730640);
            a=md5hh(a,b,c,d,x[i+13],4,681279174);d=md5hh(d,a,b,c,x[i],11,-358537222);c=md5hh(c,d,a,b,x[i+3],16,-722521979);b=md5hh(b,c,d,a,x[i+6],23,76029189);
            a=md5hh(a,b,c,d,x[i+9],4,-640364487);d=md5hh(d,a,b,c,x[i+12],11,-421815835);c=md5hh(c,d,a,b,x[i+15],16,530742520);b=md5hh(b,c,d,a,x[i+2],23,-995338651);
            a=md5ii(a,b,c,d,x[i],6,-198630844);d=md5ii(d,a,b,c,x[i+7],10,1126891415);c=md5ii(c,d,a,b,x[i+14],15,-1416354905);b=md5ii(b,c,d,a,x[i+5],21,-57434055);
            a=md5ii(a,b,c,d,x[i+12],6,1700485571);d=md5ii(d,a,b,c,x[i+3],10,-1894986606);c=md5ii(c,d,a,b,x[i+10],15,-1051523);b=md5ii(b,c,d,a,x[i+1],21,-2054922799);
            a=md5ii(a,b,c,d,x[i+8],6,1873313359);d=md5ii(d,a,b,c,x[i+15],10,-30611744);c=md5ii(c,d,a,b,x[i+6],15,-1560198380);b=md5ii(b,c,d,a,x[i+13],21,1309151649);
            a=md5ii(a,b,c,d,x[i+4],6,-145523070);d=md5ii(d,a,b,c,x[i+11],10,-1120210379);c=md5ii(c,d,a,b,x[i+2],15,718787259);b=md5ii(b,c,d,a,x[i+9],21,-343485551);
            a=safeAdd(a,olda);b=safeAdd(b,oldb);c=safeAdd(c,oldc);d=safeAdd(d,oldd);
          }
          return [a,b,c,d];
        }
        function rstr2hex(input) {
          var hex='0123456789abcdef',output='';
          for(var i=0;i<input.length;i++){var x=input.charCodeAt(i);output+=hex.charAt((x>>>4)&0x0f)+hex.charAt(x&0x0f);}
          return output;
        }
        return rstr2hex(binl2rstr(binlMD5(rstr2binl(str2rstr_utf8(str)),str2rstr_utf8(str).length*8)));
      }

      async function sha(text, algo) {
        var enc = new TextEncoder();
        var buf = await crypto.subtle.digest(algo, enc.encode(text));
        return Array.from(new Uint8Array(buf)).map(function(b){ return ('0'+b.toString(16)).slice(-2); }).join('');
      }

      var inputEl = document.getElementById('hg-input');
      var statusEl = document.getElementById('hg-status');
      var resultsEl = document.getElementById('hg-results');
      var runRevision = 0;
      var running = false;
      var copyRevision = 0;
      var copyErrorBtn = null;

      function clearStatus() {
        copyErrorBtn = null;
        statusEl.textContent = '';
        statusEl.className = 'hg-status';
      }

      function invalidateCopies() {
        copyRevision++;
        resultsEl.querySelectorAll('.btn-copy').forEach(function (btn) {
          clearTimeout(btn._hgCopyTimer);
          btn.textContent = t.copy;
        });
        if (copyErrorBtn) clearStatus();
      }

      inputEl.addEventListener('input', function () {
        runRevision++;
        invalidateCopies();
        if (running) clearStatus();
        running = false;
      });

      function makeRow(label, value) {
        var row = document.createElement('div');
        row.className = 'hg-row';
        row.innerHTML = '<span class="hg-label">' + label + '</span><code class="hg-value" id="hg-val-' + label + '">' + value + '</code><button class="btn-copy" data-label="' + label + '">' + t.copy + '</button>';
        return row;
      }

      document.getElementById('hg-hash').addEventListener('click', async function () {
        var revision = ++runRevision;
        invalidateCopies();
        running = false;
        resultsEl.innerHTML = '';
        var text = inputEl.value;
        if (!text) {
          statusEl.textContent = t.errEmpty;
          statusEl.className = 'hg-status error';
          return;
        }
        running = true;
        statusEl.textContent = t.hashing;
        statusEl.className = 'hg-status';

        try {
          var md5val = md5(text);
          var sha1val = await sha(text, 'SHA-1');
          var sha256val = await sha(text, 'SHA-256');
          var sha384val = await sha(text, 'SHA-384');
          var sha512val = await sha(text, 'SHA-512');
          if (revision !== runRevision) return;
          running = false;

          [
            ['MD5', md5val],
            ['SHA-1', sha1val],
            ['SHA-256', sha256val],
            ['SHA-384', sha384val],
            ['SHA-512', sha512val],
          ].forEach(function(pair) {
            resultsEl.appendChild(makeRow(pair[0], pair[1]));
          });

          statusEl.textContent = t.hashesGenerated;
          statusEl.className = 'hg-status success';
          window.trackTool && window.trackTool('hash_generator', 'generate');

          resultsEl.querySelectorAll('.btn-copy').forEach(function (btn) {
            btn.addEventListener('click', function () {
              var label = btn.getAttribute('data-label');
              var val = document.getElementById('hg-val-' + label).textContent;
              var copy = copyRevision;
              var request = btn._hgCopyRequest = (btn._hgCopyRequest || 0) + 1;
              clearTimeout(btn._hgCopyTimer);
              btn.textContent = t.copy;
              function current() { return copy === copyRevision && request === btn._hgCopyRequest; }
              function done() {
                if (!current()) return;
                if (copyErrorBtn === btn) clearStatus();
                btn.textContent = t.copied;
                btn._hgCopyTimer = setTimeout(function () { if (current()) btn.textContent = t.copy; }, 1500);
              }
              function failed() {
                if (!current()) return;
                statusEl.textContent = t.copyFail;
                statusEl.className = 'hg-status error';
                copyErrorBtn = btn;
              }
              try { navigator.clipboard.writeText(val).then(done, failed); }
              catch (e) { failed(); }
            });
          });
        } catch (e) {
          if (revision !== runRevision) return;
          running = false;
          statusEl.textContent = 'Error: ' + e.message;
          statusEl.className = 'hg-status error';
        }
      });

      function clearTool() {
        runRevision++;
        running = false;
        invalidateCopies();
        inputEl.value = '';
        resultsEl.innerHTML = '';
        clearStatus();
      }

      document.getElementById('hg-clear').addEventListener('click', clearTool);
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var root = document.querySelector('.hg-wrap');
        if (root && root.contains(document.activeElement)) clearTool();
      });
    })();
  </script>
</div>

<style>
  .hg-wrap { display: flex; flex-direction: column; min-height: 0; gap: 0.75rem; }
  .hg-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; flex: none; }
  .hg-control { display: flex; align-items: center; gap: 0.25rem; }
  .hg-wrap .hg-actions button { flex: none; }
  .hg-status { flex: none; height: 2.8em; line-height: 1.4; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; }
  .hg-status.success { color: var(--color-success); }
  .hg-status.error { color: var(--color-danger); }
  .hg-head { display: flex; align-items: center; gap: 0.35rem; min-height: 32px; flex: none; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .hg-input { width: 100%; overflow: auto; font-family: var(--font-mono); font-size: 0.88rem; }
  .hg-output-body { overflow: auto; }
  .hg-results { display: flex; flex-direction: column; gap: 0.5rem; }
  .hg-empty { margin: 0; color: var(--color-text-secondary); font-size: 0.88rem; }
  .hg-output-pane:has(.hg-results:not(:empty)) .hg-empty { display: none; }
  :global(.hg-row) { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.35rem 0.75rem; padding: 0.6rem 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-secondary); flex: none; }
  :global(.hg-label) { grid-column: 1; grid-row: 1; font-size: 0.8rem; font-weight: 700; color: var(--color-primary); }
  :global(.hg-row .btn-copy) { grid-column: 2; grid-row: 1; }
  :global(.hg-value) { grid-column: 1 / -1; grid-row: 2; min-width: 0; font-family: var(--font-mono); font-size: 0.82rem; color: var(--color-text); overflow-wrap: anywhere; }
  @media (max-width: 860px) {
    .hg-output-pane:has(.hg-results:empty) { display: none; }
    .hg-input { height: 160px; }
    .hg-output-body { max-height: 420px; }
  }
  @media (max-width: 640px) {
    .hg-wrap .hg-actions button { min-height: 44px; }
    .hg-status { height: 4.2em; }
    .hg-input { height: 120px; }
  }
</style>
