const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="dnsl-wrap">
  <div class="dnsl-start">
    <div class="dnsl-input-section">
      <div class="dnsl-input-row">
        <div class="dnsl-field dnsl-domain-field">
          <div class="dnsl-label-row"><label for="dnsl-domain">{T.domainLabel}</label><Toggletip id="dnsl-tip-domain" lang={lang} about={T.domainLabel} wide>{TIPS.domain}</Toggletip></div>
        <input
          id="dnsl-domain"
          class="tool-input dnsl-domain"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          placeholder="example.com"
        />
        </div>
        <div class="dnsl-field">
          <div class="dnsl-label-row"><label for="dnsl-type">{T.typeLabel}</label><Toggletip id="dnsl-tip-type" lang={lang} about={T.typeLabel} wide>{TIPS.type}</Toggletip></div>
        <select id="dnsl-type" class="tool-input dnsl-select">
          <option value="ALL">ALL</option>
          <option value="A" selected>A</option>
          <option value="AAAA">AAAA</option>
          <option value="CNAME">CNAME</option>
          <option value="MX">MX</option>
          <option value="TXT">TXT</option>
          <option value="NS">NS</option>
          <option value="SOA">SOA</option>
          <option value="CAA">CAA</option>
          <option value="PTR">PTR</option>
          <option value="SRV">SRV</option>
        </select>
        </div>
        <div class="dnsl-field">
          <div class="dnsl-label-row"><label for="dnsl-resolver">{T.resolverLabel}</label><Toggletip id="dnsl-tip-resolver" lang={lang} about={T.resolverLabel} wide>{TIPS.resolver}</Toggletip></div>
        <select id="dnsl-resolver" class="tool-input dnsl-select">
          <option value="cloudflare" selected>Cloudflare (1.1.1.1)</option>
          <option value="google">Google (8.8.8.8)</option>
        </select>
        </div>
      </div>
      <div class="dnsl-examples">
        <span class="dnsl-examples-label">{T.try}</span>
        <button class="dnsl-chip" type="button" data-example="zerotool.dev">zerotool.dev</button>
        <button class="dnsl-chip" type="button" data-example="cloudflare.com">cloudflare.com</button>
        <button class="dnsl-chip" type="button" data-example="github.com">github.com</button>
        <button class="dnsl-chip" type="button" data-example="example.com">example.com</button>
      </div>
    </div>

    <div class="dnsl-actions">
      <button id="dnsl-lookup" class="btn-primary" type="button">{T.lookup}</button>
      <button id="dnsl-copy-json" class="btn-secondary" type="button" disabled>{T.copyJson}</button>
      <button id="dnsl-clear" class="btn-ghost" type="button">{T.clear}</button>
    </div>

  </div>

    <div class="dnsl-feedback"><div id="dnsl-status" class="tool-status" role="status" aria-live="polite"></div></div>
    <p class="dnsl-result-empty">{T.resultEmpty}</p>

    <div id="dnsl-result" class="dnsl-result" hidden>
      <div class="dnsl-summary">
        <span class="dnsl-summary-pill" id="dnsl-summary-status" data-kind="ok"></span>
        <span class="dnsl-summary-pill" id="dnsl-summary-count"></span>
        <span class="dnsl-summary-pill" id="dnsl-summary-dnssec"></span>
        <span class="dnsl-summary-pill" id="dnsl-summary-resolver"></span>
        <span class="dnsl-summary-pill" id="dnsl-summary-time"></span>
      </div>

      <div class="dnsl-result-head">
      <div class="dnsl-tabs" role="tablist" aria-label={T.resultLabel}>
        <button class="dnsl-tab dnsl-tab-active" id="dnsl-tab-records" role="tab" aria-selected="true" aria-controls="dnsl-panel-records" type="button">{T.tabRecords}</button>
        <button class="dnsl-tab" id="dnsl-tab-raw" role="tab" aria-selected="false" aria-controls="dnsl-panel-raw" type="button">{T.tabRaw}</button>
        <button class="dnsl-tab" id="dnsl-tab-json" role="tab" aria-selected="false" aria-controls="dnsl-panel-json" type="button">{T.tabJson}</button>
      </div>

        <Toggletip id="dnsl-tip-results" lang={lang} about={T.resultLabel} wide>{TIPS.results}</Toggletip>
      </div>

      <div id="dnsl-panel-records" class="dnsl-panel" role="tabpanel" aria-labelledby="dnsl-tab-records"></div>
      <div id="dnsl-panel-raw" class="dnsl-panel" role="tabpanel" aria-labelledby="dnsl-tab-raw" hidden><pre id="dnsl-raw-output" class="dnsl-pre"></pre></div>
      <div id="dnsl-panel-json" class="dnsl-panel" role="tabpanel" aria-labelledby="dnsl-tab-json" hidden><pre id="dnsl-json-output" class="dnsl-pre"></pre></div>
    </div>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {


      /* ── engine:start ── */
      // DNS record type code ↔ name: the UI selector types plus the DNSSEC records that do=1 returns.
      var TYPE_NAMES = {
        1: 'A', 2: 'NS', 5: 'CNAME', 6: 'SOA', 12: 'PTR',
        15: 'MX', 16: 'TXT', 28: 'AAAA', 33: 'SRV', 257: 'CAA',
        43: 'DS', 46: 'RRSIG', 47: 'NSEC', 48: 'DNSKEY', 50: 'NSEC3'
      };
      var RRSIG_TYPE = 46;
      var ALL_TYPES = ['A', 'AAAA', 'CNAME', 'MX', 'TXT', 'NS', 'SOA', 'CAA'];

      function typeNameFromCode(code) {
        return TYPE_NAMES[code] || ('TYPE' + code);
      }

      // Normalize user input → bare ASCII hostname for the DoH `name` param.
      // The URL parser drops scheme, user info, port and path, converts IDN to punycode,
      // and maps full-width letters and the ideographic full stop to ASCII.
      function normalizeDomain(raw) {
        var s = String(raw == null ? '' : raw).trim();
        if (!s) return '';
        try { s = new URL(s.indexOf('://') !== -1 ? s : 'http://' + s).hostname; }
        catch (e) { /* keep s; isValidDomain rejects it */ }
        return s.replace(/\.$/, '').toLowerCase();
      }

      // Hostname check: at least two labels of 1-63 letters, digits, hyphens or underscores.
      // Underscores are needed for _dmarc, selector._domainkey and SRV names (RFC 8552).
      function isValidDomain(d) {
        if (!d || d.length > 253) return false;
        return /^([a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9_])?)(\.[a-z0-9_]([a-z0-9_-]{0,61}[a-z0-9_])?)+$/.test(d);
      }

      // do=1 asks for DNSSEC data; Cloudflare sets AD only when it is present (RFC 6840 §5.8).
      function buildQueryUrl(domain, typeName, resolver) {
        var qs = '?name=' + encodeURIComponent(domain) + '&type=' + encodeURIComponent(typeName) + '&do=1&cd=0';
        if (resolver === 'google') return { url: 'https://dns.google/resolve' + qs, headers: {} };
        return { url: 'https://cloudflare-dns.com/dns-query' + qs, headers: { accept: 'application/dns-json' } };
      }

      // Records view and counts leave out the RRSIG signatures; Raw and JSON keep them.
      function displayAnswers(resp) {
        return (resp.Answer || []).filter(function (a) { return a.type !== RRSIG_TYPE; });
      }

      // RFC 8914 §4.2–4.13: Extended DNS Error codes defined as DNSSEC validation problems.
      var DNSSEC_EDE_CODES = [1, 2, 5, 6, 7, 8, 9, 10, 11, 12];

      // Google puts Extended DNS Errors in extended_dns_errors; write them as Cloudflare does: "EDE(9): text".
      function googleEdeNotes(resp) {
        var list = Array.isArray(resp.extended_dns_errors) ? resp.extended_dns_errors : [];
        var out = [];
        for (var i = 0; i < list.length; i++) {
          var e = list[i];
          if (!e || typeof e.info_code !== 'number') continue;
          var text = e.extra_text == null ? '' : String(e.extra_text).trim();
          out.push('EDE(' + e.info_code + ')' + (text ? ': ' + text : ''));
        }
        return out;
      }

      // Resolver notes: Google sends a string plus extended_dns_errors, Cloudflare an array of Extended DNS Errors.
      function resolverComments(resp) {
        var c = resp.Comment;
        var list = (c == null ? [] : (Array.isArray(c) ? c : [c])).concat(googleEdeNotes(resp));
        var out = [];
        for (var i = 0; i < list.length; i++) {
          var s = String(list[i]).trim();
          if (s && out.indexOf(s) === -1) out.push(s);
        }
        return out;
      }

      // validated: AD set. failed: SERVFAIL with a DNSSEC Extended DNS Error.
      // unknown: any other SERVFAIL; the resolver returned no answer, so AD false says nothing about signing.
      // unvalidated: an answer without AD (RFC 6840 §5.8).
      function dnssecStatus(resp) {
        if (resp.AD === true) return 'validated';
        if (resp.Status !== 2) return 'unvalidated';
        var notes = resolverComments(resp);
        for (var i = 0; i < notes.length; i++) {
          var m = /^EDE\((\d+)\)/.exec(notes[i]);
          if (m && DNSSEC_EDE_CODES.indexOf(Number(m[1])) !== -1) return 'failed';
        }
        return 'unknown';
      }

      // Merge multi-type ALL results into a single shape the renderer consumes.
      function mergeAllResults(results) {
        var merged = {
          Status: 0,
          AD: true,
          TC: false,
          Answer: [],
          Authority: [],
          Comment: [],
          _queries: [],
          _partialErrors: []
        };
        var statuses = [];
        for (var i = 0; i < results.length; i++) {
          var item = results[i];
          if (item.status === 'fulfilled') {
            var v = item.value;
            statuses.push(v.Status);
            merged._queries.push({ type: item.typeName });
            if (v.Answer && v.Answer.length) {
              for (var j = 0; j < v.Answer.length; j++) merged.Answer.push(v.Answer[j]);
            }
            if (v.Authority && v.Authority.length) {
              for (var k = 0; k < v.Authority.length; k++) merged.Authority.push(v.Authority[k]);
            }
            if (v.AD !== true) merged.AD = false;
            if (v.TC === true) merged.TC = true;
            merged.Comment = merged.Comment.concat(resolverComments(v));
          } else {
            merged._partialErrors.push({ type: item.typeName, message: item.reason && item.reason.message ? item.reason.message : String(item.reason) });
          }
        }
        merged.Comment = resolverComments(merged);
        // NOERROR if any type answered NOERROR; otherwise the shared RCODE (e.g. NXDOMAIN for every type).
        // Nothing answered at all → SERVFAIL so the UI shows an error pill.
        if (!statuses.length) { merged.Status = 2; merged.AD = false; }
        else if (statuses.indexOf(0) !== -1) merged.Status = 0;
        else merged.Status = statuses[0];
        return merged;
      }
      /* ── engine:end ── */

      /* ── diagnose:start ── */
      // Runs only after isValidDomain() rejects a name, so it never changes which names are
      // queried. It returns the first reason the user can fix: no host, a character that is not
      // allowed (position in code points of the raw input), then the label rules checked on the
      // ASCII name that would be sent (empty label, hyphen at an edge, 63 per label, two labels,
      // 253 in total). Null means "no specific reason found".
      function diagnoseDomain(raw) {
        var chars = Array.from(String(raw == null ? '' : raw));
        var a = 0;
        var b = chars.length;
        while (a < b && /\s/.test(chars[a])) a++;
        while (b > a && /\s/.test(chars[b - 1])) b--;
        var scheme = chars.slice(a, b).join('').match(/^[a-z][a-z0-9+.-]*:\/\//i);
        if (scheme) a += scheme[0].length;
        var stop = a;
        while (stop < b && '/?#\\'.indexOf(chars[stop]) === -1) stop++;
        for (var at = stop - 1; at >= a; at--) {
          if (chars[at] === '@') { a = at + 1; break; }
        }
        var host = chars.slice(a, stop).join('');
        var port = host.match(/:\d*$/);
        if (port) host = host.slice(0, host.length - port[0].length);
        if (!host) return { code: 'noHost' };

        var ascii = null;
        try { ascii = new URL('http://' + host).hostname.replace(/\.$/, '').toLowerCase(); }
        catch (e) { ascii = null; }

        if (ascii === null || !/^[a-z0-9_.-]*$/.test(ascii)) {
          var hostChars = Array.from(host);
          var foreign = null;
          var folded = '';
          for (var k = 0; k < hostChars.length; k++) {
            var c = hostChars[k];
            if (c === '\t' || c === '\n' || c === '\r') continue; // the URL parser removes these
            var mapped = c.normalize('NFKC').toLowerCase();
            if (mapped === '\u3002') mapped = '.';
            folded += mapped;
            var hit = { ch: c, cp: 'U+' + c.codePointAt(0).toString(16).toUpperCase().padStart(4, '0'), pos: a + k + 1 };
            if (/^[\x00-\x7f]*$/.test(mapped)) {
              if (!/^[a-z0-9_.-]*$/.test(mapped)) return { code: 'badChar', ch: hit.ch, cp: hit.cp, pos: hit.pos };
            } else if (ascii === null && !foreign) {
              foreign = hit;
            }
          }
          if (foreign) return { code: 'idnChar', ch: foreign.ch, cp: foreign.cp, pos: foreign.pos };
          if (ascii !== null) return null;
          // The parser rejected an all-ASCII name (for example ".0", read as a broken IPv4
          // address); the label rules below still name the problem.
          ascii = folded.replace(/\.$/, '');
        }

        function shortLabel(label) {
          var list = Array.from(label);
          return list.length > 24 ? list.slice(0, 24).join('') + '\u2026' : label;
        }
        var labels = ascii.split('.');
        for (var i = 0; i < labels.length; i++) {
          if (!labels[i]) return { code: 'emptyLabel', n: i + 1 };
        }
        for (var j = 0; j < labels.length; j++) {
          if (labels[j].charAt(0) === '-') return { code: 'hyphenStart', n: j + 1, label: shortLabel(labels[j]) };
          if (labels[j].charAt(labels[j].length - 1) === '-') return { code: 'hyphenEnd', n: j + 1, label: shortLabel(labels[j]) };
          if (labels[j].length > 63) return { code: 'labelTooLong', n: j + 1, label: shortLabel(labels[j]), len: labels[j].length };
        }
        if (labels.length < 2) return { code: 'singleLabel', name: ascii };
        if (ascii.length > 253) return { code: 'tooLong', len: ascii.length };
        return null;
      }
      /* ── diagnose:end ── */

      // DNS RCODE → friendly label. Only common values; others rendered as "RCODE N".
      var RCODE_LABEL = {
        0: 'summaryNoerror', 1: 'summaryFormerr', 2: 'summaryServfail',
        3: 'summaryNxdomain', 4: 'notImplemented', 5: 'summaryRefused'
      };

      var domainEl = document.getElementById('dnsl-domain');
      var typeSel = document.getElementById('dnsl-type');
      var resolverSel = document.getElementById('dnsl-resolver');
      var lookupBtn = document.getElementById('dnsl-lookup');
      var copyJsonBtn = document.getElementById('dnsl-copy-json');
      var clearBtn = document.getElementById('dnsl-clear');
      var statusEl = document.getElementById('dnsl-status');
      var resultEl = document.getElementById('dnsl-result');
      var summaryStatusEl = document.getElementById('dnsl-summary-status');
      var summaryCountEl = document.getElementById('dnsl-summary-count');
      var summaryDnssecEl = document.getElementById('dnsl-summary-dnssec');
      var summaryResolverEl = document.getElementById('dnsl-summary-resolver');
      var summaryTimeEl = document.getElementById('dnsl-summary-time');
      var tabRecords = document.getElementById('dnsl-tab-records');
      var tabRaw = document.getElementById('dnsl-tab-raw');
      var tabJson = document.getElementById('dnsl-tab-json');
      var panelRecords = document.getElementById('dnsl-panel-records');
      var panelRaw = document.getElementById('dnsl-panel-raw');
      var panelJson = document.getElementById('dnsl-panel-json');
      var rawOut = document.getElementById('dnsl-raw-output');
      var jsonOut = document.getElementById('dnsl-json-output');

      var lastSnapshot = null; // last lookup result for Copy JSON
      var lookupGeneration = 0;

      function clearResult() {
        lastSnapshot = null;
        resultEl.hidden = true;
        copyJsonBtn.disabled = true;
        panelRecords.innerHTML = '';
        rawOut.textContent = '';
        jsonOut.textContent = '';
      }

      function setStatus(text, kind) {
        statusEl.textContent = text || '';
        statusEl.className = 'tool-status' + (kind ? ' ' + kind : '');
      }

      function escapeHtml(s) {
        return String(s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      function rcodeLabel(code) {
        if (code === 4) return fillFormat(t.notImplemented, { code: 'NOTIMP' });
        if (RCODE_LABEL[code] != null) return t[RCODE_LABEL[code]];
        return 'RCODE ' + code;
      }

      function fillFormat(tpl, vars) {
        return tpl.replace(/\{(\w+)\}/g, function (_, k) { return vars[k] != null ? vars[k] : ('{' + k + '}'); });
      }

      function pluralS(n) { return n === 1 ? '' : 's'; }

      // Issue a single DoH JSON query. Returns the parsed response or throws.
      function query(domain, typeName, resolver) {
        var req = buildQueryUrl(domain, typeName, resolver);
        var controller = new AbortController();
        var timer = setTimeout(function () { controller.abort(); }, 5000);
        return fetch(req.url, { headers: req.headers, signal: controller.signal })
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          })
          .finally(function () { clearTimeout(timer); });
      }

      function renderRecords(snapshot) {
        var resp = snapshot.response;
        var byType = {};
        var answers = displayAnswers(resp);
        for (var i = 0; i < answers.length; i++) {
          var a = answers[i];
          var name = typeNameFromCode(a.type);
          if (!byType[name]) byType[name] = [];
          byType[name].push(a);
        }

        // Preserve UI order: ALL_TYPES first, then anything else.
        var orderedNames = [];
        for (var ti = 0; ti < ALL_TYPES.length; ti++) {
          if (byType[ALL_TYPES[ti]]) orderedNames.push(ALL_TYPES[ti]);
        }
        for (var bk in byType) {
          if (Object.prototype.hasOwnProperty.call(byType, bk) && orderedNames.indexOf(bk) === -1) {
            orderedNames.push(bk);
          }
        }

        var html = '';
        if (orderedNames.length === 0) {
          html = '<p class="dnsl-empty">' + escapeHtml(t.doneEmpty) + '</p>';
        } else {
          for (var oi = 0; oi < orderedNames.length; oi++) {
            var typeName = orderedNames[oi];
            var rows = byType[typeName];
            html += '<section class="dnsl-section">';
            html += '<h3 class="dnsl-section-title">' + escapeHtml(fillFormat(t.recordsHeading, { type: typeName, n: rows.length })) + '</h3>';
            for (var ri = 0; ri < rows.length; ri++) {
              var row = rows[ri];
              html += '<article class="dnsl-card">'
                + '<div class="dnsl-card-row"><span class="dnsl-card-key">' + escapeHtml(t.colType) + '</span><code class="dnsl-card-val dnsl-card-type">' + escapeHtml(typeNameFromCode(row.type)) + '</code></div>'
                + '<div class="dnsl-card-row"><span class="dnsl-card-key">' + escapeHtml(t.colName) + '</span><code class="dnsl-card-val">' + escapeHtml(row.name) + '</code></div>'
                + '<div class="dnsl-card-row"><span class="dnsl-card-key">' + escapeHtml(t.colTtl) + '</span><code class="dnsl-card-val">' + escapeHtml(String(row.TTL)) + 's</code></div>'
                + '<div class="dnsl-card-row dnsl-card-data"><span class="dnsl-card-key">' + escapeHtml(t.colData) + '</span><code class="dnsl-card-val dnsl-card-databig">' + escapeHtml(row.data) + '</code></div>'
                + '</article>';
            }
            html += '</section>';
          }
        }

        var comments = resolverComments(resp);
        for (var ci = 0; ci < comments.length; ci++) {
          html += '<p class="dnsl-note">' + escapeHtml(fillFormat(t.resolverNote, { msg: comments[ci] })) + '</p>';
        }

        // Partial errors (some types failed in ALL mode)
        if (resp._partialErrors && resp._partialErrors.length) {
          html += '<section class="dnsl-section dnsl-section-errors">';
          for (var ei = 0; ei < resp._partialErrors.length; ei++) {
            var err = resp._partialErrors[ei];
            html += '<p class="dnsl-partial-error">' + escapeHtml(fillFormat(t.partialError, { type: err.type, msg: err.message })) + '</p>';
          }
          html += '</section>';
        }

        panelRecords.innerHTML = html;
      }

      function renderRaw(snapshot) {
        // dig-like output: ; QUESTION / ANSWER sections.
        var resp = snapshot.response;
        var lines = [];
        lines.push('; <<>> ZeroTool DNS Lookup <<>> ' + snapshot.domain);
        lines.push(';; status: ' + rcodeLabel(resp.Status) + (resp.TC ? ' (truncated)' : '') + ', AD: ' + (resp.AD ? '1' : '0'));
        lines.push(';; resolver: ' + (snapshot.resolver === 'google' ? 'dns.google' : 'cloudflare-dns.com'));
        lines.push(';; time: ' + snapshot.elapsed + ' ms');
        var rawComments = resolverComments(resp);
        for (var rc = 0; rc < rawComments.length; rc++) lines.push(';; comment: ' + rawComments[rc]);
        lines.push('');
        lines.push(';; QUESTION SECTION:');
        if (resp._queries && resp._queries.length) {
          for (var i = 0; i < resp._queries.length; i++) {
            lines.push(';' + snapshot.domain + '.\tIN\t' + resp._queries[i].type);
          }
        } else {
          lines.push(';' + snapshot.domain + '.\tIN\t' + snapshot.requestedType);
        }
        lines.push('');
        var answers = resp.Answer || [];
        if (answers.length) {
          lines.push(';; ANSWER SECTION:');
          for (var ai = 0; ai < answers.length; ai++) {
            var a = answers[ai];
            lines.push(a.name + '\t' + a.TTL + '\tIN\t' + typeNameFromCode(a.type) + '\t' + a.data);
          }
        }
        var auths = resp.Authority || [];
        if (auths.length) {
          lines.push('');
          lines.push(';; AUTHORITY SECTION:');
          for (var auI = 0; auI < auths.length; auI++) {
            var au = auths[auI];
            lines.push(au.name + '\t' + au.TTL + '\tIN\t' + typeNameFromCode(au.type) + '\t' + au.data);
          }
        }
        if (resp._partialErrors && resp._partialErrors.length) {
          lines.push('');
          lines.push(';; PARTIAL ERRORS:');
          for (var pi = 0; pi < resp._partialErrors.length; pi++) {
            lines.push(';; ' + fillFormat(t.partialError, { type: resp._partialErrors[pi].type, msg: resp._partialErrors[pi].message }));
          }
        }
        rawOut.textContent = lines.join('\n');
      }

      function renderJson(snapshot) {
        jsonOut.textContent = JSON.stringify(snapshot.response, null, 2);
      }

      function renderSummary(snapshot) {
        var resp = snapshot.response;
        summaryStatusEl.textContent = rcodeLabel(resp.Status);
        summaryStatusEl.dataset.kind = resp.Status === 0 ? 'ok' : (resp.Status === 3 ? 'warn' : 'error');

        var count = displayAnswers(resp).length;
        if (resp.TC) {
          summaryCountEl.textContent = fillFormat(t.summaryCount, { n: count, s: pluralS(count) }) + ' · ' + t.summaryTruncated;
          summaryCountEl.dataset.kind = 'warn';
        } else {
          summaryCountEl.textContent = fillFormat(t.summaryCount, { n: count, s: pluralS(count) });
          summaryCountEl.dataset.kind = count > 0 ? 'ok' : 'neutral';
        }

        var dnssec = dnssecStatus(resp);
        summaryDnssecEl.hidden = dnssec === 'unknown';
        if (dnssec === 'validated') {
          summaryDnssecEl.textContent = t.summaryDnssec;
          summaryDnssecEl.dataset.kind = 'ok';
        } else if (dnssec === 'failed') {
          summaryDnssecEl.textContent = t.summaryDnssecFailed;
          summaryDnssecEl.dataset.kind = 'error';
        } else {
          summaryDnssecEl.textContent = t.summaryNoDnssec;
          summaryDnssecEl.dataset.kind = 'neutral';
        }

        summaryResolverEl.textContent = snapshot.resolver === 'google' ? 'Google DNS' : 'Cloudflare DNS';
        summaryResolverEl.dataset.kind = 'neutral';

        summaryTimeEl.textContent = fillFormat(t.summaryTime, { ms: snapshot.elapsed });
        summaryTimeEl.dataset.kind = 'neutral';
      }

      function runLookup() {
        var generation = ++lookupGeneration;
        clearResult();
        var raw = domainEl.value;
        var domain = normalizeDomain(raw);
        if (!domain) {
          setStatus(t.empty, '');
          resultEl.hidden = true;
          return;
        }
        if (!isValidDomain(domain)) {
          var reason = diagnoseDomain(raw);
          setStatus(reason && t.domainErrors[reason.code] ? fillFormat(t.domainErrors[reason.code], reason) : t.invalidDomain, 'error');
          resultEl.hidden = true;
          return;
        }

        var typeChoice = typeSel.value;
        var resolver = resolverSel.value;
        var t0 = (window.performance && window.performance.now) ? window.performance.now() : Date.now();

        if (typeChoice === 'ALL') {
          setStatus(fillFormat(t.pendingMulti, { n: ALL_TYPES.length }), 'info');
          var promises = ALL_TYPES.map(function (tn) {
            return query(domain, tn, resolver).then(
              function (v) { return { status: 'fulfilled', value: v, typeName: tn }; },
              function (e) { return { status: 'rejected', reason: e, typeName: tn }; }
            );
          });
          Promise.all(promises).then(function (results) {
            if (generation !== lookupGeneration) return;
            var elapsed = Math.round(((window.performance && window.performance.now) ? window.performance.now() : Date.now()) - t0);
            var merged = mergeAllResults(results);
            if (!merged._queries.length) { handleFailure(results[0].reason); return; }
            finalize({ response: merged, domain: domain, requestedType: 'ALL', resolver: resolver, elapsed: elapsed });
          });
        } else {
          setStatus(t.pending, 'info');
          query(domain, typeChoice, resolver).then(function (response) {
            if (generation !== lookupGeneration) return;
            var elapsed = Math.round(((window.performance && window.performance.now) ? window.performance.now() : Date.now()) - t0);
            // Stash request type so raw view can show the QUESTION section.
            response._queries = [{ type: typeChoice }];
            finalize({ response: response, domain: domain, requestedType: typeChoice, resolver: resolver, elapsed: elapsed });
          }, function (err) {
            if (generation !== lookupGeneration) return;
            handleFailure(err);
          });
        }
      }

      function handleFailure(err) {
        if (err && err.name === 'AbortError') {
          setStatus(t.timeout, 'error');
        } else {
          setStatus(t.netError + (err && err.message ? ' (' + err.message + ')' : ''), 'error');
        }
        resultEl.hidden = true;
      }

      function finalize(snapshot) {
        lastSnapshot = snapshot;
        copyJsonBtn.disabled = false;
        renderSummary(snapshot);
        renderRecords(snapshot);
        renderRaw(snapshot);
        renderJson(snapshot);
        resultEl.hidden = false;
        var count = displayAnswers(snapshot.response).length;
        if (count > 0) {
          setStatus(fillFormat(t.done, { n: count, s: pluralS(count) }), 'success');
        } else if (snapshot.response.Status !== 0) {
          setStatus(rcodeLabel(snapshot.response.Status), 'error');
        } else {
          setStatus(t.doneEmpty, '');
        }
        window.trackTool && window.trackTool('dns-lookup', 'lookup');
      }

      lookupBtn.addEventListener('click', runLookup);

      domainEl.addEventListener('keydown', function (ev) {
        if (ev.key === 'Enter') {
          ev.preventDefault();
          ev.stopPropagation();
          runLookup();
        }
      });

      clearBtn.addEventListener('click', function () {
        lookupGeneration++;
        domainEl.value = '';
        clearResult();
        setStatus('', '');
        domainEl.focus();
      });

      // The shared shortcut clears fields without input events; discard pending results too.
      document.addEventListener('keydown', function (ev) {
        if (!(ev.ctrlKey || ev.metaKey) || (ev.key !== 'l' && ev.key !== 'L')) return;
        if (!document.querySelector('.dnsl-wrap').contains(document.activeElement)) return;
        lookupGeneration++;
        clearResult();
        setStatus('', '');
      });

      copyJsonBtn.addEventListener('click', function () {
        if (!lastSnapshot) { setStatus(t.lookupFirst, 'error'); return; }
        var generation = lookupGeneration;
        var text = jsonOut.textContent;
        var done = function () { if (generation === lookupGeneration) setStatus(t.copied, 'success'); };
