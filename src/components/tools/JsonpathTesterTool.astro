    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 700px) {
    .jpt-layout { grid-template-columns: 1fr; }
  }

  .jpt-panel { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }

  .jpt-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .jpt-textarea {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    resize: vertical;
    min-height: 260px;
    line-height: 1.5;
  }

  .jpt-textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .jpt-expr-input {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    width: 100%;
    box-sizing: border-box;
  }

  .jpt-expr-input:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .jpt-examples-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .jpt-pills { display: flex; flex-wrap: wrap; gap: 0.35rem; }

  .jpt-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    cursor: pointer;
    white-space: nowrap;
  }

  .jpt-pill:hover { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }

  .jpt-results-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .jpt-count {
    font-size: 0.75rem;
    color: var(--color-primary);
    font-weight: 600;
    flex: 1;
  }

  .jpt-pre {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    overflow-x: auto;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.55;
    flex: 1;
    min-height: 140px;
  }

  .jpt-code { font-family: inherit; }

  /* Syntax highlight */
  .jpt-code :global(.jpt-hl-key)  { color: #0369a1; }
  .jpt-code :global(.jpt-hl-str)  { color: #057a55; }
  .jpt-code :global(.jpt-hl-num)  { color: #9a3412; }
  .jpt-code :global(.jpt-hl-bool) { color: #7c3aed; }
  .jpt-code :global(.jpt-hl-null) { color: var(--color-text-secondary); }

  .jpt-code :global(.jpt-error)    { color: #dc2626; }
  .jpt-code :global(.jpt-no-match) { color: var(--color-text-secondary); font-style: italic; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .jpt-code :global(.jpt-hl-key)  { color: #38bdf8; }
    :root:not([data-theme="light"]) .jpt-code :global(.jpt-hl-str)  { color: #34d399; }
    :root:not([data-theme="light"]) .jpt-code :global(.jpt-hl-num)  { color: #fb923c; }
    :root:not([data-theme="light"]) .jpt-code :global(.jpt-hl-bool) { color: #a78bfa; }
  }
  [data-theme="dark"] .jpt-code :global(.jpt-hl-key)  { color: #38bdf8; }
