  .cpal-wrap {
    display: grid;
    grid-template-columns: minmax(270px, 320px) minmax(0, 1fr);
    gap: 1.1rem;
    min-height: 0;
  }
  .cpal-export[open] { display: flex; flex: 1 1 auto; flex-direction: column; min-height: 0; }
  .cpal-export[open] > .cpal-export-body { display: flex; flex: 1 1 auto; min-height: 0; }
  .cpal-export[open] .cpal-export-pre { flex: 1 1 auto; max-height: none; min-height: 12rem; }
