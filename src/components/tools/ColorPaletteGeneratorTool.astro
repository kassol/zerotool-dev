    gap: 0.2rem 1rem;
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }
  .cpal-hint-mapped { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--color-text-muted); }
  .cpal-label-row { display: flex; align-items: center; gap: 0.25rem; }

  .cpal-panel {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 0.9rem 1rem;
    border-radius: 8px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border-soft), var(--shadow-card);
