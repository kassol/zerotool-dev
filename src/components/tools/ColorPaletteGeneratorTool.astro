      }
      function parseColor(input) {
        var s = String(input == null ? '' : input).normalize('NFKC').trim().replace(/;+$/, '').trim();
        if (/^(['"]).*\1$/.test(s)) s = s.slice(1, -1).trim();
        if (!s) return { ok: false, error: 'empty' };
        var lower = s.toLowerCase();
        if (Object.prototype.hasOwnProperty.call(NAMED, lower)) {
          var nrgb = hexDigitsToRgb(NAMED[lower]);
          return { ok: true, rgb: nrgb, hex: toHex(nrgb), notes: [] };
        }
        var fm = /^([a-z-]+)\(([\s\S]*)\)$/.exec(lower);
        if (fm) return parseFunction(fm[1], fm[2].trim());
        if (/^[a-z-]+\(/.test(lower)) return { ok: false, error: 'fnArgs', fn: lower.slice(0, lower.indexOf('(')) };
        var hasHash = lower.charAt(0) === '#';
        var digits = hasHash ? lower.slice(1) : lower;
        if (/^[0-9a-f]+$/.test(digits)) {
          if ([3, 4, 6, 8].indexOf(digits.length) < 0) return { ok: false, error: 'hexLength', n: digits.length };
          var rgb = hexDigitsToRgb(digits);
          var notes = [];
          if (digits.length === 4 && digits[3] !== 'f') notes.push('alphaIgnored');
          if (digits.length === 8 && digits.slice(6) !== 'ff') notes.push('alphaIgnored');
          return { ok: true, rgb: rgb, hex: toHex(rgb), notes: notes };
        }
        if (hasHash) {
          var chars = Array.from(s);
          for (var i = 1; i < chars.length; i++) {
            if (!/^[0-9a-fA-F]$/.test(chars[i])) return { ok: false, error: 'hexChar', ch: chars[i], pos: i + 1 };
          }
        }
        return { ok: false, error: 'unknown' };
      }

      /* ── Harmonies ── */
      function rotate(rgb, space, base, offset) {
        if (space === 'oklch') return oklchTo8bit({ l: base.l, c: base.c, h: mod360(base.h + offset) });
        return { rgb: round8(hslToRgbFloat(base.h + offset, base.s, base.l)), mapped: false };
      }
      function monoColors(rgb, space) {
        var steps = space === 'oklch' ? MONO_OKLCH : MONO_HSL;
        var base = space === 'oklch' ? rgbToOklch(rgb) : rgbToHsl(rgb[0], rgb[1], rgb[2]);
        var nearest = 0;
        for (var i = 1; i < steps.length; i++) {
          if (Math.abs(steps[i] - base.l) < Math.abs(steps[nearest] - base.l)) nearest = i;
        }
        var list = steps.map(function (l, i) {
          if (i === nearest) return { l: base.l, color: { rgb: rgb.slice(), mapped: false }, base: true };
          var c = space === 'oklch'
            ? oklchTo8bit({ l: l, c: base.c, h: base.h })
            : { rgb: round8(hslToRgbFloat(base.h, base.s, l)), mapped: false };
          return { l: l, color: c, base: false };
        });
        list.sort(function (a, b) { return a.l - b.l; });
        return list.map(function (x) {
          return { rgb: x.color.rgb, hex: toHex(x.color.rgb), base: x.base, mapped: x.color.mapped };
        });
      }
      function harmonies(rgb, space) {
        var base = space === 'oklch' ? rgbToOklch(rgb) : rgbToHsl(rgb[0], rgb[1], rgb[2]);
        var ok = rgbToOklch(rgb);
        var mapped = 0;
        var schemes = SCHEMES.map(function (scheme) {
          var colors = scheme.mono ? monoColors(rgb, space) : scheme.offsets.map(function (off) {
            if (off === 0) return { rgb: rgb.slice(), hex: toHex(rgb), base: true, mapped: false };
            var r = rotate(rgb, space, base, off);
            return { rgb: r.rgb, hex: toHex(r.rgb), base: false, mapped: r.mapped };
          });
          colors.forEach(function (c) { if (c.mapped) mapped++; });
          return { id: scheme.id, key: scheme.key, colors: colors };
        });
        var notes = [];
        if (rgb[0] === rgb[1] && rgb[1] === rgb[2]) notes.push('achromatic');
        else if (ok.c < LOW_CHROMA) notes.push('lowChroma');
        if (mapped) notes.push('mapped');
        return { schemes: schemes, notes: notes, mapped: mapped, chroma: ok.c };
      }

      /* ── Value formats: every string parses back to the same 8-bit color ── */
      function num(x, d) {
        var s = x.toFixed(d);
        if (s.indexOf('.') >= 0) s = s.replace(/0+$/, '').replace(/\.$/, '');
        return s === '-0' ? '0' : s;
      }
      function formatValue(rgb, fmt) {
        if (fmt === 'rgb') return 'rgb(' + rgb.join(', ') + ')';
        var hex = toHex(rgb);
        if (fmt === 'hsl') {
          var hsl = rgbToHsl(rgb[0], rgb[1], rgb[2]);
          for (var d = 1; d <= 4; d++) {
            var hs = num(mod360(Number(hsl.h.toFixed(d))), d), ss = num(hsl.s, d), ls = num(hsl.l, d);
            if (toHex(round8(hslToRgbFloat(+hs, +ss, +ls))) === hex) return 'hsl(' + hs + ', ' + ss + '%, ' + ls + '%)';
          }
          return 'hsl(' + num(hsl.h, 6) + ', ' + num(hsl.s, 6) + '%, ' + num(hsl.l, 6) + '%)';
        }
        if (fmt === 'oklch') {
          var o = rgbToOklch(rgb);
          for (var e = 0; e <= 3; e++) {
            var Ls = num(o.l * 100, 2 + e), Cs = num(o.c, 4 + e);
            var Hs = +Cs === 0 ? '0' : num(mod360(Number(o.h.toFixed(2 + e))), 2 + e);
            var back = oklchToRgbFloat({ l: +Ls / 100, c: +Cs, h: +Hs }).map(function (v) { return Math.round(clamp(v, 0, 1) * 255); });
            if (toHex(back) === hex) return 'oklch(' + Ls + '% ' + Cs + ' ' + Hs + ')';
          }
          return 'oklch(' + num(o.l * 100, 6) + '% ' + num(o.c, 8) + ' ' + num(o.h, 6) + ')';
        }
        return hex;
      }

      /* ── Code export ── */
      function exportCode(schemes, kind, fmt) {
        var groups = schemes.map(function (s) {
          return { key: s.key, values: s.colors.map(function (c) { return formatValue(c.rgb, fmt); }) };
        });
        var lines = [];
        if (kind === 'list') {
          if (groups.length === 1) return groups[0].values.join('\n');
          return groups.map(function (g) { return g.key + '\n' + g.values.join('\n'); }).join('\n\n');
        }
        if (kind === 'css' || kind === 'tw4') {
          var prefix = kind === 'tw4' ? '--color-' : '--';
          groups.forEach(function (g, gi) {
            if (gi > 0) lines.push('');
            g.values.forEach(function (v, i) { lines.push('  ' + prefix + g.key + '-' + (i + 1) + ': ' + v + ';'); });
          });
          return (kind === 'tw4' ? '@theme' : ':root') + ' {\n' + lines.join('\n') + '\n}';
        }
        if (kind === 'scss') {
          groups.forEach(function (g, gi) {
            if (gi > 0) lines.push('');
            g.values.forEach(function (v, i) { lines.push('$' + g.key + '-' + (i + 1) + ': ' + v + ';'); });
          });
          return lines.join('\n');
        }
        if (kind === 'tw3') {
          lines.push("/** @type {import('tailwindcss').Config} */", 'module.exports = {', '  theme: {', '    extend: {', '      colors: {');
          groups.forEach(function (g) {
            lines.push('        ' + (/-/.test(g.key) ? "'" + g.key + "'" : g.key) + ': {');
            g.values.forEach(function (v, i) { lines.push('          ' + (i + 1) + ": '" + v + "',"); });
            lines.push('        },');
          });
          lines.push('      },', '    },', '  },', '};');
          return lines.join('\n');
        }
        var obj = {};
        groups.forEach(function (g) { obj[g.key] = g.values; });
        return JSON.stringify(obj, null, 2);
      }

      /* ── WCAG 2.2 relative luminance and contrast ratio ── */
      function relativeLuminance(r, g, b) {
        var lin = [r, g, b].map(function (c) {
          c /= 255;
          return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
        });
        return 0.2126 * lin[0] + 0.7152 * lin[1] + 0.0722 * lin[2];
      }
      function contrastRatio(l1, l2) {
        var hi = Math.max(l1, l2), lo = Math.min(l1, l2);
        return (hi + 0.05) / (lo + 0.05);
      }
      var DARK_TEXT = '#000000', LIGHT_TEXT = '#F9FAFB';
      var LIGHT_TEXT_LUM = relativeLuminance(0xf9, 0xfa, 0xfb);
      function textColor(rgb) {
        var l = relativeLuminance(rgb[0], rgb[1], rgb[2]);
        return contrastRatio(l, 0) >= contrastRatio(l, LIGHT_TEXT_LUM) ? DARK_TEXT : LIGHT_TEXT;
      }

      /* Random base: mid lightness, clearly colored, any hue (OKLCH, then gamut mapped). */
      function randomBase(rand) {
        var lch = { l: 0.45 + 0.35 * rand(), c: 0.08 + 0.12 * rand(), h: 360 * rand() };
        return oklchTo8bit(lch).rgb;
      }
      /* ── engine:end ── */

      var SLUG = 'color-palette-generator';
      var wrap = document.currentScript ? document.currentScript.closest('.cpal-wrap') : document.querySelector('.cpal-wrap');
      var pickerEl = wrap.querySelector('#cpal-picker');
      var inputEl = wrap.querySelector('#cpal-input');
      var randomEl = wrap.querySelector('#cpal-random');
      var formatEl = wrap.querySelector('#cpal-format');
      var codeEl = wrap.querySelector('#cpal-code');
      var statusEl = wrap.querySelector('#cpal-status');
      var palettesEl = wrap.querySelector('#cpal-palettes');
      var exportCodeEl = wrap.querySelector('#cpal-export-code');
      var exportCopyEl = wrap.querySelector('#cpal-export-copy');
      var segBtns = Array.prototype.slice.call(wrap.querySelectorAll('.cpal-seg-btn'));

      var state = { rgb: [0x3b, 0x82, 0xf6], space: 'hsl', format: 'hex', code: 'list', inputNotes: [], readAs: '' };
      var current = null;
      var errorTimer = null;
      var noteTimer = null;

      function fill(template, vars) {
        return String(template).replace(/\{([a-z]+)\}/g, function (m, k) { return vars && vars[k] !== undefined ? vars[k] : m; });
      }
      function track(action) { if (window.trackTool) window.trackTool(SLUG, action); }

      var saved = (window.ztPersist && window.ztPersist.load(SLUG)) || {};
      if (saved.space === 'hsl' || saved.space === 'oklch') state.space = saved.space;
      if (['hex', 'rgb', 'hsl', 'oklch'].indexOf(saved.format) >= 0) state.format = saved.format;
      if (['list', 'css', 'scss', 'tw4', 'tw3', 'json'].indexOf(saved.code) >= 0) state.code = saved.code;
      formatEl.value = state.format;
      codeEl.value = state.code;
      function savePrefs() {
        if (window.ztPersist) window.ztPersist.save(SLUG, { space: state.space, format: state.format, code: state.code });
      }

      function setStatus(text, kind) {
        statusEl.textContent = text;
        statusEl.className = 'cpal-status' + (kind ? ' cpal-status--' + kind : '');
      }
      function showNotes() {
        var parts = [];
        if (state.readAs) parts.push(fill(t.readAs, { hex: state.readAs }));
        state.inputNotes.forEach(function (n) { parts.push(n === 'mapped' ? t.note_inputMapped : t['note_' + n]); });
        if (current) current.notes.forEach(function (n) {
          parts.push(fill(t['note_' + n], { n: current.mapped, c: current.chroma.toFixed(3) }));
        });
        setStatus(parts.join(' '), parts.length ? 'info' : '');
      }

      function copyText(text) {
        function fallback() {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          var ok = false;
          try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
          document.body.removeChild(ta);
          return ok;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          return navigator.clipboard.writeText(text).then(function () { return true; }, function () { return fallback(); });
        }
        return Promise.resolve(fallback());
      }
      function flash(el, text, ms) {
        var orig = el.textContent;
        el.textContent = text;
        setTimeout(function () { el.textContent = orig; }, ms);
      }

      function renderCards() {
        current = harmonies(state.rgb, state.space);
        while (palettesEl.firstChild) palettesEl.removeChild(palettesEl.firstChild);
        current.schemes.forEach(function (scheme) {
          var name = t['scheme_' + scheme.id];
          var card = document.createElement('section');
          card.className = 'cpal-card';
          card.setAttribute('aria-label', name);

          var header = document.createElement('div');
          header.className = 'cpal-card-header';
          var titles = document.createElement('div');
          titles.className = 'cpal-card-titles';
          var title = document.createElement('h3');
          title.className = 'cpal-card-title';
          title.textContent = name;
          var desc = document.createElement('p');
          desc.className = 'cpal-card-desc';
          desc.textContent = t['desc_' + scheme.id];
          titles.appendChild(title);
          titles.appendChild(desc);
          var copyBtn = document.createElement('button');
          copyBtn.type = 'button';
          copyBtn.className = 'btn-copy cpal-card-copy';
          copyBtn.textContent = t.copy;
          copyBtn.setAttribute('aria-label', fill(t.copySchemeAria, { name: name }));
          copyBtn.addEventListener('click', function () {
            copyText(exportCode([scheme], state.code, state.format)).then(function (ok) {
              if (ok) { flash(copyBtn, t.copied, 1400); track('copy_scheme_' + scheme.key); }
              else setStatus(t.copyFailed, 'error');
            });
          });
          header.appendChild(titles);
          header.appendChild(copyBtn);
          card.appendChild(header);

          var row = document.createElement('div');
          row.className = 'cpal-swatches';
          scheme.colors.forEach(function (c) {
            var value = formatValue(c.rgb, state.format);
            var sw = document.createElement('button');
            sw.type = 'button';
            sw.className = 'cpal-swatch';
            sw.style.background = c.hex;
            sw.style.color = textColor(c.rgb);
            sw.title = value + (c.mapped ? ' — ' + t.mappedTitle : '');
            sw.setAttribute('aria-label', fill(t.copyAria, { value: value }) + (c.base ? ' (' + t.base + ')' : '') + (c.mapped ? ' (' + t.mappedTitle + ')' : ''));
            if (c.base) {
              var tag = document.createElement('span');
              tag.className = 'cpal-swatch-tag';
              tag.textContent = t.base;
              tag.style.backgroundColor = textColor(c.rgb) === DARK_TEXT ? 'rgba(255,255,255,0.64)' : 'rgba(0,0,0,0.30)';
              sw.appendChild(tag);
            }
            var label = document.createElement('span');
            label.className = 'cpal-swatch-hex';
            label.textContent = c.hex + (c.mapped ? ' ◆' : '');
            label.style.backgroundColor = textColor(c.rgb) === DARK_TEXT ? 'rgba(255,255,255,0.64)' : 'rgba(0,0,0,0.30)';
            sw.appendChild(label);
            sw.addEventListener('click', function () {
              copyText(value).then(function (ok) {
                if (ok) {
                  flash(label, t.copied, 1200);
                  setStatus(fill(t.copiedValue, { value: value }), 'ok');
                  clearTimeout(noteTimer);
                  noteTimer = setTimeout(showNotes, 2500);
                  track('copy_swatch');
                }
                else setStatus(t.copyFailed, 'error');
              });
            });
            row.appendChild(sw);
          });
          card.appendChild(row);
          palettesEl.appendChild(card);
        });
        exportCodeEl.textContent = exportCode(current.schemes, state.code, state.format);
      }

      function render() {
        clearTimeout(noteTimer);
        renderCards();
        showNotes();
      }

      function applyInput(showErrors) {
        clearTimeout(errorTimer);
        var raw = inputEl.value;
        var res = parseColor(raw);
        if (res.ok) {
          inputEl.removeAttribute('aria-invalid');
          state.rgb = res.rgb;
          state.inputNotes = res.notes;
          state.readAs = /^#?[0-9a-f]{6}$/i.test(raw.trim()) ? '' : res.hex;
          pickerEl.value = res.hex.toLowerCase();
          render();
          return true;
        }
        function showError() {
          if (res.error === 'empty') { inputEl.removeAttribute('aria-invalid'); setStatus(t.err_empty, 'info'); return; }
          inputEl.setAttribute('aria-invalid', 'true');
          setStatus(fill(t['err_' + res.error], { n: res.n, ch: res.ch, pos: res.pos, fn: res.fn, value: res.value }), 'error');
        }
        if (showErrors) showError(); else errorTimer = setTimeout(showError, 700);
        return false;
      }

      inputEl.addEventListener('input', function () { applyInput(false); });
      inputEl.addEventListener('change', function () { if (applyInput(true)) track('generate'); });
      inputEl.addEventListener('keydown', function (e) { if (e.key === 'Enter') applyInput(true); });
      pickerEl.addEventListener('input', function () {
        inputEl.value = pickerEl.value.toUpperCase();
        applyInput(true);
      });
      pickerEl.addEventListener('change', function () { track('generate'); });
      randomEl.addEventListener('click', function () {
        var rgb = randomBase(Math.random);
        inputEl.value = toHex(rgb);
        applyInput(true);
        track('random');
      });
      segBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.space = btn.getAttribute('data-space');
          segBtns.forEach(function (b) { b.setAttribute('aria-pressed', String(b === btn)); });
          savePrefs();
          render();
        });
      });
      segBtns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-space') === state.space)); });
      formatEl.addEventListener('change', function () { state.format = formatEl.value; savePrefs(); render(); });
      codeEl.addEventListener('change', function () { state.code = codeEl.value; savePrefs(); render(); });
      exportCopyEl.addEventListener('click', function () {
        copyText(exportCodeEl.textContent).then(function (ok) {
          if (ok) { flash(exportCopyEl, t.copied, 1400); track('copy_export_' + state.code); }
          else setStatus(t.copyFailed, 'error');
        });
      });
      // The page-wide Ctrl/Cmd+L shortcut empties the text input; say so instead of keeping a stale "read as".
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L')) {
          setTimeout(function () { if (inputEl.value === '') setStatus(t.err_empty, 'info'); }, 0);
        }
      });

      /* Other tools (image-color-palette) link here with ?color=; a value that does not parse is ignored. */
      try {
        var linked = new URLSearchParams(location.search).get('color');
        if (linked && parseColor(linked).ok) inputEl.value = linked;
      } catch (e) {}
      applyInput(true);
    })();
  </script>
</div>

<style is:global>
  /* Preview first: a narrow control rail on the left, the palettes fill the rest of the
