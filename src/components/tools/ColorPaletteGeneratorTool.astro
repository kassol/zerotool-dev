    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }
  .cpal-picker::-webkit-color-swatch-wrapper { padding: 0; }
  .cpal-picker::-webkit-color-swatch { border: 0; border-radius: 6px; }
  .cpal-picker::-moz-color-swatch { border: 0; border-radius: 6px; }

  .cpal-input {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 30rem;
  }
  .cpal-input[aria-invalid="true"] {
    box-shadow: inset 0 0 0 1px var(--color-danger), 0 0 0 4px color-mix(in oklch, var(--color-danger) 14%, transparent);
  }

