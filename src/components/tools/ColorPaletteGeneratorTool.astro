  .cpal-option > .cpal-seg, .cpal-option > .cpal-select { grid-area: control; }
  .cpal-option > :global(.zt-tip) { grid-area: tip; }

  .cpal-option-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

