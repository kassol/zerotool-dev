---
// DiffCheckerTool — line-level text diff widget with unified + side-by-side views
---
<div>
  <div class="diff-wrap">
    <div class="diff-inputs">
      <div class="diff-panel">
        <label for="diff-original" data-i18n="original">Original</label>
        <textarea id="diff-original" data-i18n-ph="originalPh" placeholder="Paste original text here..." spellcheck="false"></textarea>
      </div>
      <div class="diff-panel">
        <label for="diff-modified" data-i18n="modified">Modified</label>
        <textarea id="diff-modified" data-i18n-ph="modifiedPh" placeholder="Paste modified text here..." spellcheck="false"></textarea>
      </div>
    </div>

    <div class="diff-actions">
      <button id="diff-compare" class="btn-primary" data-i18n="compare">Compare</button>
      <button id="diff-cancel" class="btn-secondary" data-i18n="cancel" hidden>Cancel</button>
      <button id="diff-swap" class="btn-secondary" data-i18n="swap">Swap</button>
      <button id="diff-clear" class="btn-ghost" data-i18n="clear">Clear</button>
      <div class="diff-view-toggle" role="group" aria-label="View mode">
        <button id="diff-view-unified" class="diff-view-btn active" data-i18n="unified">Unified</button>
        <button id="diff-view-side" class="diff-view-btn" data-i18n="side_by_side">Side-by-Side</button>
      </div>
    </div>

    <div id="diff-status" class="diff-status" aria-live="polite"></div>

    <div id="diff-output" class="diff-output" data-view="unified"></div>
    <div id="diff-pages" class="diff-actions" hidden>
      <button id="diff-prev" class="btn-secondary" data-i18n="previous">Previous</button>
      <span id="diff-page" aria-live="polite"></span>
      <button id="diff-next" class="btn-secondary" data-i18n="next">Next</button>
    </div>
  </div>

  <script is:inline>
    (function () {
      var STRINGS = {
        en: { compare: 'Compare', swap: 'Swap', clear: 'Clear', unified: 'Unified', side_by_side: 'Side-by-Side', identical: 'Files are identical.', swapped: 'Swapped.', empty: 'Please enter text in at least one panel.', no_diff: 'No differences found.', original: 'Original', modified: 'Modified', originalPh: 'Paste original text here...', modifiedPh: 'Paste modified text here...' },
        zh: { compare: '比较', swap: '互换', clear: '清除', unified: '合并视图', side_by_side: '双栏视图', identical: '两侧内容完全相同。', swapped: '已互换。', empty: '请至少在一侧输入内容。', no_diff: '未发现差异。', original: '原始', modified: '修改后', originalPh: '粘贴原始文本…', modifiedPh: '粘贴修改后文本…' },
        ja: { compare: '比較', swap: '入れ替え', clear: 'クリア', unified: '統合表示', side_by_side: '並列表示', identical: '内容は同一です。', swapped: '入れ替えました。', empty: 'いずれかのパネルにテキストを入力してください。', no_diff: '差分はありません。', original: '元テキスト', modified: '変更後', originalPh: '元のテキストを貼り付け…', modifiedPh: '変更後のテキストを貼り付け…' },
        ko: { compare: '비교', swap: '교체', clear: '지우기', unified: '통합 보기', side_by_side: '나란히 보기', identical: '내용이 동일합니다.', swapped: '교체되었습니다.', empty: '최소 한 쪽에 텍스트를 입력해 주세요.', no_diff: '차이점이 없습니다.', original: '원본', modified: '수정본', originalPh: '원본 텍스트를 붙여넣기…', modifiedPh: '수정된 텍스트를 붙여넣기…' }
      };

      var pageLang = (document.documentElement.lang || 'en').slice(0, 2);
      var RUN_STRINGS = {
        en: { cancel: 'Cancel', previous: 'Previous', next: 'Next', running: 'Comparing…', cancelled: 'Comparison cancelled.', unavailable: 'Comparison needs Web Workers. This browser could not start one.', failed: 'Comparison failed. Try again.' },
        zh: { cancel: '取消', previous: '上一页', next: '下一页', running: '正在比较…', cancelled: '已取消比较。', unavailable: '比较需要 Web Worker，当前浏览器无法启动。', failed: '比较失败，请重试。' },
        ja: { cancel: 'キャンセル', previous: '前へ', next: '次へ', running: '比較中…', cancelled: '比較を中止しました。', unavailable: '比較には Web Worker が必要です。このブラウザーでは起動できません。', failed: '比較に失敗しました。再試行してください。' },
        ko: { cancel: '취소', previous: '이전', next: '다음', running: '비교 중…', cancelled: '비교를 취소했습니다.', unavailable: '비교에 Web Worker가 필요합니다. 이 브라우저에서 시작할 수 없습니다.', failed: '비교에 실패했습니다. 다시 시도해 주세요.' }
      };
      Object.keys(STRINGS).forEach(function (lang) { Object.assign(STRINGS[lang], RUN_STRINGS[lang]); });
      var t = STRINGS[pageLang] || STRINGS.en;

      // Apply i18n to static buttons
      document.querySelectorAll('[data-i18n]').forEach(function (el) {
        var key = el.getAttribute('data-i18n');
        if (t[key]) el.textContent = t[key];
      });
      document.querySelectorAll('[data-i18n-ph]').forEach(function (el) {
        var key = el.getAttribute('data-i18n-ph');
        if (t[key]) el.placeholder = t[key];
      });

      /* ── engine:start ── */
      // CR LF, lone CR and LF all end a line. A textarea already returns LF only (HTML
      // "normalize newlines"), so this matters only for text that did not come from one.
      function splitLines(text) {
        return text.split(/\r\n|\r|\n/);
      }

      // Linear-space LCS. Carry the canonical traceback's middle-row crossing
      // forward with each score. Equality wins, then addition wins ties, as before.
      function lcs(a, b) {
        var result = [];
        function visit(a0, a1, b0, b1) {
          var m = a1 - a0, n = b1 - b0;
          if (!m) { for (var j = b0; j < b1; j++) result.push({ type: 'add', val: b[j] }); return; }
          if (!n) { for (var i = a0; i < a1; i++) result.push({ type: 'del', val: a[i] }); return; }
          if (m === 1) {
            var k = b1 - 1;
            while (k >= b0 && a[a0] !== b[k]) k--;
            if (k < b0) {
              result.push({ type: 'del', val: a[a0] });
              for (var j = b0; j < b1; j++) result.push({ type: 'add', val: b[j] });
            } else {
              for (var j = b0; j < k; j++) result.push({ type: 'add', val: b[j] });
              result.push({ type: 'equal', val: a[a0] });
              for (var j = k + 1; j < b1; j++) result.push({ type: 'add', val: b[j] });
            }
            return;
          }
          var mid = Math.floor(m / 2);
          var prev = new Uint32Array(n + 1), cur = new Uint32Array(n + 1);
          var old = new Uint32Array(n + 1), cross = new Uint32Array(n + 1);
          for (var i = 1; i <= m; i++) {
            for (var j = 1; j <= n; j++) {
              var equal = a[a0 + i - 1] === b[b0 + j - 1];
              cur[j] = equal ? prev[j - 1] + 1 : Math.max(prev[j], cur[j - 1]);
              if (i > mid) cross[j] = equal ? old[j - 1] : cur[j - 1] >= prev[j] ? cross[j - 1] : old[j];
            }
            if (i === mid) for (var j = 0; j <= n; j++) cross[j] = j;
            var tmp = prev; prev = cur; cur = tmp;
            if (i >= mid) { tmp = old; old = cross; cross = tmp; }
          }
          var k = old[n];
          // No recursive call keeps its parent's score rows alive.
          prev = cur = old = cross = tmp = null;
          visit(a0, a0 + mid, b0, b0 + k);
          visit(a0 + mid, a1, b0 + k, b1);
        }
        visit(0, a.length, 0, b.length);
        return result;
      }

      // Side-by-Side rows. Inside each block of consecutive changes, the i-th removed line is put
      // next to the i-th added line; the longer side gets empty partners for its extra lines.
      function pairRows(diff) {
        var rows = [];
        var origLn = 0, modLn = 0;
        var i = 0;
        while (i < diff.length) {
          if (diff[i].type === 'equal') {
            origLn++; modLn++;
            rows.push({ left: { type: 'equal', ln: origLn, val: diff[i].val }, right: { type: 'equal', ln: modLn, val: diff[i].val } });
            i++;
            continue;
          }
          var dels = [], adds = [];
          while (i < diff.length && diff[i].type !== 'equal') {
            if (diff[i].type === 'del') dels.push(diff[i].val); else adds.push(diff[i].val);
            i++;
          }
          for (var k = 0; k < Math.max(dels.length, adds.length); k++) {
            var left = k < dels.length ? { type: 'del', ln: ++origLn, val: dels[k] } : { type: 'empty', ln: null, val: '' };
            var right = k < adds.length ? { type: 'add', ln: ++modLn, val: adds[k] } : { type: 'empty', ln: null, val: '' };
            rows.push({ left: left, right: right });
          }
        }
        return rows;
      }
      /* ── engine:end ── */

      function esc(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function ln(n) {
        return n == null ? '' : String(n);
      }

      var currentView = 'unified';
      var lastDiff = null;
      var lastAddCount = 0, lastDelCount = 0;
      var worker = null, generation = 0, request = 0, page = 0, total = 0, ready = false;

      function diffWorker() {
        var unified = [], side = [], id, adds = 0, dels = 0;
        self.onmessage = function (event) {
          var data = event.data;
          if (data.type === 'compare') {
            id = data.id;
            unified = lcs(splitLines(data.original), splitLines(data.modified));
            var a = 0, b = 0;
            unified.forEach(function (op) {
              if (op.type !== 'add') a++;
              if (op.type !== 'del') b++;
              op.origLn = op.type === 'add' ? null : a;
              op.modLn = op.type === 'del' ? null : b;
              if (op.type === 'add') adds++;
              if (op.type === 'del') dels++;
            });
            side = pairRows(unified);
          }
          var rows = data.view === 'side' ? side : unified;
          // The page may have counted pages of the other view; clamp to this view's last page.
          var p = Math.max(0, Math.min(data.page, Math.ceil(rows.length / 100) - 1));
          var start = p * 100;
          self.postMessage({ id: id, request: data.request, view: data.view, page: p,
            total: rows.length, adds: adds, dels: dels, rows: rows.slice(start, start + 100) });
        };
      }

      function stop() {
        generation++; request++;
        if (worker) worker.terminate();
        worker = null; ready = false; lastDiff = null; page = 0; total = 0;
        document.getElementById('diff-cancel').hidden = true;
        document.getElementById('diff-compare').disabled = false;
        document.getElementById('diff-pages').hidden = true;
        document.getElementById('diff-page').textContent = '';
        document.getElementById('diff-output').innerHTML = '';
      }

      function requestPage() {
        if (!worker || !ready) return;
        worker.postMessage({ type: 'page', id: generation, request: ++request, view: currentView, page: page });
      }

      function renderUnified(diff) {
        var html = '';
        diff.forEach(function (op) {
          var origLn = op.origLn, modLn = op.modLn;
          if (op.type === 'equal') {
            html += '<div class="diff-line diff-equal">'
              + '<span class="diff-ln diff-ln-orig">' + origLn + '</span>'
              + '<span class="diff-ln diff-ln-mod">' + modLn + '</span>'
              + '<span class="diff-marker"> </span>'
              + '<span class="diff-text">' + esc(op.val) + '</span></div>';
          } else if (op.type === 'del') {
            html += '<div class="diff-line diff-del">'
              + '<span class="diff-ln diff-ln-orig">' + origLn + '</span>'
              + '<span class="diff-ln diff-ln-mod"></span>'
              + '<span class="diff-marker">-</span>'
              + '<span class="diff-text">' + esc(op.val) + '</span></div>';
          } else {
            html += '<div class="diff-line diff-add">'
              + '<span class="diff-ln diff-ln-orig"></span>'
              + '<span class="diff-ln diff-ln-mod">' + modLn + '</span>'
              + '<span class="diff-marker">+</span>'
              + '<span class="diff-text">' + esc(op.val) + '</span></div>';
          }
        });
        return html || '<div class="diff-empty">' + t.no_diff + '</div>';
      }

      function renderSideBySide(rows) {
        var left = rows.map(function (r) { return r.left; });
        var right = rows.map(function (r) { return r.right; });

        var leftHtml = '', rightHtml = '';
        for (var k = 0; k < left.length; k++) {
          var l = left[k], r = right[k];
          var lcls = l.type === 'del' ? 'diff-del' : l.type === 'empty' ? 'diff-empty-row' : 'diff-equal';
          var rcls = r.type === 'add' ? 'diff-add' : r.type === 'empty' ? 'diff-empty-row' : 'diff-equal';
          leftHtml += '<div class="diff-sbs-line ' + lcls + '">'
            + '<span class="diff-ln">' + ln(l.ln) + '</span>'
            + '<span class="diff-marker">' + (l.type === 'del' ? '-' : ' ') + '</span>'
            + '<span class="diff-text">' + esc(l.val) + '</span></div>';
          rightHtml += '<div class="diff-sbs-line ' + rcls + '">'
            + '<span class="diff-ln">' + ln(r.ln) + '</span>'
            + '<span class="diff-marker">' + (r.type === 'add' ? '+' : ' ') + '</span>'
            + '<span class="diff-text">' + esc(r.val) + '</span></div>';
        }
        if (!leftHtml) {
          leftHtml = '<div class="diff-empty">' + t.no_diff + '</div>';
          rightHtml = '<div class="diff-empty"></div>';
        }
        return '<div class="diff-sbs">'
          + '<div class="diff-sbs-panel diff-sbs-orig"><div class="diff-sbs-header">' + t.original + '</div>' + leftHtml + '</div>'
          + '<div class="diff-sbs-panel diff-sbs-mod"><div class="diff-sbs-header">' + t.modified + '</div>' + rightHtml + '</div>'
          + '</div>';
      }

      function renderOutput() {
        var outputEl = document.getElementById('diff-output');
        if (!lastDiff) { outputEl.innerHTML = ''; return; }
        outputEl.setAttribute('data-view', currentView);
        if (currentView === 'unified') {
          outputEl.innerHTML = renderUnified(lastDiff);
        } else {
          outputEl.innerHTML = renderSideBySide(lastDiff);
        }
      }

      function compare() {
        var origVal = document.getElementById('diff-original').value;
        var modVal = document.getElementById('diff-modified').value;
        var statusEl = document.getElementById('diff-status');

        stop();
        if (!origVal && !modVal) {
          statusEl.textContent = t.empty;
          statusEl.className = 'diff-status error';
          lastDiff = null;
          document.getElementById('diff-output').innerHTML = '';
          return;
        }

        var active = generation, url;
        try {
          url = URL.createObjectURL(new Blob([splitLines.toString(), lcs.toString(), pairRows.toString(),
            '(' + diffWorker.toString() + ')();'], { type: 'text/javascript' }));
          worker = new Worker(url);
        } catch (error) {
          stop(); statusEl.textContent = t.unavailable; statusEl.className = 'diff-status error'; return;
        } finally { if (url) URL.revokeObjectURL(url); }
        worker.onmessage = function (event) {
          var data = event.data;
          if (active !== generation || data.id !== active || data.request !== request) return;
          ready = true;
          if (data.view !== currentView) { page = 0; requestPage(); return; }
          lastDiff = data.rows; page = data.page; total = data.total;
          lastAddCount = data.adds; lastDelCount = data.dels;
          renderOutput();
          statusEl.textContent = lastAddCount || lastDelCount ? '+' + lastAddCount + ' / -' + lastDelCount : t.identical;
          statusEl.className = 'diff-status ' + (lastAddCount || lastDelCount ? 'info' : 'success');
          document.getElementById('diff-cancel').hidden = true;
          document.getElementById('diff-compare').disabled = false;
          document.getElementById('diff-pages').hidden = total <= 100;
          document.getElementById('diff-prev').disabled = page === 0;
          document.getElementById('diff-next').disabled = (page + 1) * 100 >= total;
          document.getElementById('diff-page').textContent = (page * 100 + 1) + '–' + Math.min(total, (page + 1) * 100) + ' / ' + total;
        };
        worker.onerror = function () {
          if (active !== generation) return;
          stop(); statusEl.textContent = t.failed; statusEl.className = 'diff-status error';
        };
        statusEl.textContent = t.running; statusEl.className = 'diff-status info';
        document.getElementById('diff-cancel').hidden = false;
        document.getElementById('diff-compare').disabled = true;
        worker.postMessage({ type: 'compare', id: active, request: ++request,
          original: origVal, modified: modVal, view: currentView, page: 0 });
        window.trackTool && window.trackTool('diff_checker', 'compare');
      }

      document.getElementById('diff-cancel').addEventListener('click', function () {
        stop(); document.getElementById('diff-status').textContent = t.cancelled;
      });
      ['diff-prev', 'diff-next'].forEach(function (id, index) {
        document.getElementById(id).addEventListener('click', function () {
          if (!ready) return;
          page = Math.max(0, Math.min(Math.ceil(total / 100) - 1, page + (index ? 1 : -1)));
          requestPage();
        });
      });
      window.addEventListener('pagehide', stop);
      // Auto-resize textarea
      function autoResize(ta) {
        ta.style.height = 'auto';
        ta.style.height = Math.min(500, Math.max(160, ta.scrollHeight)) + 'px';
      }

      ['diff-original', 'diff-modified'].forEach(function (id) {
        var ta = document.getElementById(id);
        ta.addEventListener('input', function () { stop(); document.getElementById('diff-status').textContent = ''; autoResize(ta); });
      });

      document.getElementById('diff-compare').addEventListener('click', compare);

      document.getElementById('diff-swap').addEventListener('click', function () {
        var orig = document.getElementById('diff-original');
        var mod = document.getElementById('diff-modified');
        var tmp = orig.value;
        orig.value = mod.value;
        mod.value = tmp;
        autoResize(orig); autoResize(mod);
        stop();
        document.getElementById('diff-output').innerHTML = '';
        document.getElementById('diff-status').textContent = t.swapped;
        document.getElementById('diff-status').className = 'diff-status';
      });

      document.getElementById('diff-clear').addEventListener('click', function () {
        var orig = document.getElementById('diff-original');
        var mod = document.getElementById('diff-modified');
        orig.value = ''; mod.value = '';
        autoResize(orig); autoResize(mod);
        stop();
        document.getElementById('diff-output').innerHTML = '';
        document.getElementById('diff-status').textContent = '';
        document.getElementById('diff-status').className = 'diff-status';
      });

      document.getElementById('diff-view-unified').addEventListener('click', function () {
        currentView = 'unified';
        document.getElementById('diff-view-unified').classList.add('active');
        document.getElementById('diff-view-side').classList.remove('active');
        page = 0; requestPage();
      });

      document.getElementById('diff-view-side').addEventListener('click', function () {
        currentView = 'side';
        document.getElementById('diff-view-side').classList.add('active');
        document.getElementById('diff-view-unified').classList.remove('active');
        page = 0; requestPage();
      });
    })();
  </script>
</div>

<style>
  .diff-wrap { display: flex; flex-direction: column; gap: 0.75rem; }
  .diff-wrap [hidden] { display: none; }

  .diff-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 600px) {
    .diff-inputs { grid-template-columns: 1fr; }
  }

  .diff-panel { display: flex; flex-direction: column; gap: 0.3rem; }

  .diff-panel label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .diff-panel textarea {
    width: 100%;
    min-height: 160px;
    max-height: 500px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    resize: none;
    overflow-y: auto;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    transition: border-color 0.15s;
  }
  .diff-panel textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .diff-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }

  .diff-view-toggle {
    display: flex;
    margin-left: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .diff-view-btn {
    padding: 0.3rem 0.75rem;
    font-size: 0.82rem;
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    border: none;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .diff-view-btn:not(:last-child) { border-right: 1px solid var(--color-border); }
  .diff-view-btn.active {
    background: var(--color-primary);
    color: #fff;
  }
  .diff-view-btn:hover:not(.active) {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .diff-status { font-size: 0.85rem; min-height: 1.2rem; }
  .diff-status.success { color: #057a55; }
  .diff-status.error { color: #c0392b; }
  .diff-status.info { color: var(--color-primary); }

  .diff-output {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    background: var(--color-bg);
  }

  @media (max-width: 640px) {
    .diff-view-toggle { margin-left: 0; }
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .diff-status.success { color: #34d399; }
    :root:not([data-theme="light"]) .diff-status.error { color: #f87171; }
  }
  [data-theme="dark"] .diff-status.success { color: #34d399; }
  [data-theme="dark"] .diff-status.error { color: #f87171; }
</style>

{/*
  Styles below target elements injected into `.diff-output` via innerHTML.
  Astro scoped CSS cannot match them (they lack the `data-astro-cid-*` attribute),
  so these rules must be global. Scoped via the `.diff-output` prefix to avoid leakage.
*/}
<style is:global>
  .diff-output .diff-line {
    display: flex;
    align-items: flex-start;
    min-height: 1.6rem;
  }
  .diff-output .diff-line:not(:last-child) { border-bottom: 1px solid var(--color-bg-secondary); }

  .diff-output .diff-equal { background: var(--color-bg); }
  .diff-output .diff-del { background: #ffd0d0; }
  .diff-output .diff-add { background: #c8f0d6; }

  .diff-output .diff-ln {
    min-width: 36px;
    text-align: right;
    padding: 0 0.4rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    user-select: none;
    flex-shrink: 0;
    line-height: 1.6rem;
    border-right: 1px solid var(--color-border-light);
  }

  .diff-output .diff-marker {
    width: 18px;
    text-align: center;
    flex-shrink: 0;
    font-weight: 700;
    line-height: 1.6rem;
