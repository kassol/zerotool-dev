const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="ivp-wrap">
  <div class="ivp-actions">
    <div class="ivp-heading">
      <details class="ivp-example-wrap">
        <summary class="btn-ghost ivp-example-summary">{T.loadExample}</summary>
        <div class="ivp-example-list" role="listbox"></div>
      </details>
      <Toggletip id="ivp-tip-examples" lang={lang} about={T.loadExample}>{TIPS.examples}</Toggletip>
    </div>
    <button id="ivp-clear" class="btn-ghost" type="button">{T.clear}</button>
  </div>
  <div id="ivp-status" class="tool-status none" role="status" aria-live="polite" tabindex="0"></div>
  <div class="ivp-input-section">
    <div class="ivp-heading">
      <label for="ivp-input" class="tool-label">{T.inputLabel}</label>
      <Toggletip id="ivp-tip-input" lang={lang} about={T.inputLabel}>{TIPS.input}</Toggletip>
    </div>
    <input id="ivp-input" class="tool-input ivp-input" type="text" placeholder={T.placeholder} spellcheck="false" autocomplete="off" autocapitalize="characters" autocorrect="off" maxlength="60" />
  </div>
  <div class="ivp-output">
    <p class="ivp-empty">{T.emptyResult}</p>
    <div class="ivp-result-head">
      <div class="ivp-heading"><span>{T.sectionStatus}</span><Toggletip id="ivp-tip-status" lang={lang} about={T.sectionStatus}>{TIPS.status}</Toggletip></div>
      <div class="ivp-heading"><span>{T.sectionBban}</span><Toggletip id="ivp-tip-bban" lang={lang} about={T.sectionBban}>{TIPS.bban}</Toggletip></div>
      <div class="ivp-heading"><span>{T.sectionFormats}</span><Toggletip id="ivp-tip-formats" lang={lang} about={T.sectionFormats}>{TIPS.formats}</Toggletip></div>
    </div>
    <div id="ivp-results" class="ivp-results" hidden tabindex="0" role="region" aria-label={T.resultsLabel}></div>
  </div>
  <p class="ivp-privacy">{T.privacy}</p>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      // ── SWIFT IBAN Registry snapshot (March 2024). Length is authoritative for
      //    checksum validation; field breakdown follows the published BBAN structure.
      //    Field roles: bank, branch, account, check (national), check2, type,
      //    holder, currency, id, kennitala, reserved, owner.
      /* ── engine:start ── */
      var REG = {
