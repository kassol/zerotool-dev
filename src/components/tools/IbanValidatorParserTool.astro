        SV: { len: 28, name: 'El Salvador', fields: [['bank',4,'a'],['account',20,'n']] },
        TL: { len: 23, name: 'Timor-Leste', fields: [['bank',3,'n'],['account',14,'n'],['check',2,'n']] },
        TN: { len: 24, name: 'Tunisia', fields: [['bank',2,'n'],['branch',3,'n'],['account',13,'n'],['check',2,'n']] },
