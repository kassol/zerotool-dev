---
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  en: { copyFailed: 'Copy failed. Please try again.', formatted: 'Formatted.', minified: 'Minified.', errorPrefix: 'Error: ', copy: 'Copy', copied: 'Copied!', clear: 'Clear', format: 'Format', minify: 'Minify', xmlInput: 'XML Input', formattedXml: 'Formatted XML', formattedXmlPh: 'Formatted XML will appear here…', indent: 'Indent:', indent2: "2 spaces", indent4: "4 spaces", indentTab: "Tab", tips: {"input": "Paste XML here. Formatting runs 0.3 seconds after typing stops. The browser checks XML well-formedness; DTD and XML Schema validation are not performed.", "indent": "Choose two spaces, four spaces or a tab. Click Format to apply the selected indentation to the current XML.", "format": "Format with the selected indentation. Leading and trailing whitespace in text is trimmed; check mixed text and elements before replacing the original.", "minify": "Minify the input without indentation. Text is trimmed, while comments, CDATA, processing instructions and the original declaration and DOCTYPE are retained.", "clear": "Clear both text areas, the status and pending formatting. The indentation stays selected. Ctrl+L (⌘+L on Mac) also works while focus is inside this tool.", "copyInput": "Copy all current XML input, exactly as it appears in the input field.", "copyOutput": "Copy all current formatted or minified output, including content outside the visible area."} },
  zh: { copyFailed: '复制失败，请重试。', formatted: '已格式化。', minified: '已压缩。', errorPrefix: '错误：', copy: '复制', copied: '已复制！', clear: '清除', format: '格式化', minify: '压缩', xmlInput: 'XML 输入', formattedXml: '格式化 XML', formattedXmlPh: '格式化后的 XML 显示在这里…', indent: '缩进：', indent2: "2 个空格", indent4: "4 个空格", indentTab: "制表符", tips: {"input": "在此粘贴 XML。停止输入 0.3 秒后自动格式化。浏览器检查 XML 格式良好性，不按 DTD 或 XML Schema 校验。", "indent": "选择两个空格、四个空格或制表符。点击“格式化”将当前缩进设置应用到 XML。", "format": "按所选缩进格式化。文本首尾空白会被删除；原文混有文本和元素时，替换前请核对结果。", "minify": "压缩输入并移除缩进。文本首尾空白会删除，注释、CDATA、处理指令、原始 XML 声明和 DOCTYPE 会保留。", "clear": "清空两个文本框、状态和等待执行的格式化。缩进选项保持原值。焦点在工具内时，也可按 Ctrl+L（Mac 为 ⌘+L）。", "copyInput": "复制当前 XML 输入框中的全部原文。", "copyOutput": "复制当前格式化或压缩后的完整输出，包括可见区域之外的内容。"} },
  ja: { copyFailed: 'コピーに失敗しました。もう一度お試しください。', formatted: '整形しました。', minified: '圧縮しました。', errorPrefix: 'エラー：', copy: 'コピー', copied: 'コピー済み！', clear: 'クリア', format: 'フォーマット', minify: '圧縮', xmlInput: 'XML 入力', formattedXml: 'フォーマット済み XML', formattedXmlPh: 'フォーマット済み XML がここに表示されます…', indent: 'インデント：', indent2: "2スペース", indent4: "4スペース", indentTab: "タブ", tips: {"input": "XML を貼り付けます。入力を止めて0.3秒後に自動整形します。ブラウザで整形式を確認します。DTD や XML Schema による検証はしません。", "indent": "スペース2個、4個、タブから選びます。「フォーマット」で現在の XML に適用します。", "format": "選択したインデントで整形します。テキスト前後の空白は削除されます。テキストと要素が混在する文書は、元の内容を置き換える前に結果を確認してください。", "minify": "インデントを除いて圧縮します。テキスト前後の空白は削除し、コメント、CDATA、処理命令、元の XML 宣言と DOCTYPE は保持します。", "clear": "両方の欄、ステータス、待機中の整形をクリアします。インデント設定は保持します。ツール内では Ctrl+L（Mac は ⌘+L）も使えます。", "copyInput": "XML 入力欄の現在のテキストをそのまますべてコピーします。", "copyOutput": "表示範囲の外も含め、現在の整形・圧縮済み出力をすべてコピーします。"} },
  ko: { copyFailed: '복사하지 못했습니다. 다시 시도하세요.', formatted: '포맷했습니다.', minified: '압축했습니다.', errorPrefix: '오류: ', copy: '복사', copied: '복사됨!', clear: '지우기', format: '포맷', minify: '압축', xmlInput: 'XML 입력', formattedXml: '포맷된 XML', formattedXmlPh: '포맷된 XML이 여기에 표시됩니다…', indent: '들여쓰기：', indent2: "공백 2개", indent4: "공백 4개", indentTab: "탭", tips: {"input": "XML을 붙여 넣으세요. 입력을 멈추고 0.3초 뒤 자동 포맷합니다. 브라우저가 well-formedness를 검사하며 DTD나 XML Schema 검증은 하지 않습니다.", "indent": "공백 두 개, 네 개 또는 탭을 고르세요. “포맷”을 누르면 현재 XML에 적용됩니다.", "format": "선택한 들여쓰기로 포맷합니다. 텍스트 앞뒤 공백은 제거됩니다. 텍스트와 요소가 섞인 문서는 원본을 바꾸기 전에 결과를 확인하세요.", "minify": "들여쓰기 없이 입력을 압축합니다. 텍스트 앞뒤 공백은 제거하고 주석, CDATA, 처리 명령, 원래 XML 선언과 DOCTYPE은 유지합니다.", "clear": "두 칸과 상태를 지우고 대기 중인 포맷을 취소합니다. 들여쓰기 옵션은 유지됩니다. 도구 안에서 Ctrl+L(Mac은 ⌘+L)로도 지웁니다.", "copyInput": "현재 XML 입력창의 텍스트 전체를 그대로 복사합니다.", "copyOutput": "화면 밖의 내용까지 현재 포맷 또는 압축한 출력 전체를 복사합니다."} },
};
const T = STRINGS[lang] || STRINGS.en;
const TIPS = T.tips;
const CLIENT_T = { copy: T.copy, copied: T.copied, copyFailed: T.copyFailed, formatted: T.formatted, minified: T.minified, errorPrefix: T.errorPrefix };
---

<div class="xf-wrap" data-strings={JSON.stringify(CLIENT_T)}>
  <div class="xf-options">
    <div class="xf-control">
      <label for="xf-indent">{T.indent}</label>
      <select id="xf-indent"><option value="2" selected>{T.indent2}</option><option value="4">{T.indent4}</option><option value="tab">{T.indentTab}</option></select>
      <Toggletip id="xf-tip-indent" about={T.indent} lang={lang}>{TIPS.indent}</Toggletip>
    </div>
  </div>
  <div class="xf-toolbar">
    <div class="xf-control"><button id="xf-format" class="btn-primary" type="button">{T.format}</button><Toggletip id="xf-tip-format" about={T.format} lang={lang}>{TIPS.format}</Toggletip></div>
    <div class="xf-control"><button id="xf-minify" class="btn-secondary" type="button">{T.minify}</button><Toggletip id="xf-tip-minify" about={T.minify} lang={lang}>{TIPS.minify}</Toggletip></div>
    <div class="xf-control"><button id="xf-clear" class="btn-ghost" type="button">{T.clear}</button><Toggletip id="xf-tip-clear" about={T.clear} lang={lang}>{TIPS.clear}</Toggletip></div>
  </div>
  <div id="xf-status" class="xf-status" aria-live="polite"></div>
  <div class="xf-panels zt-io">
    <div class="xf-panel zt-io-pane">
      <div class="xf-head">
        <div class="xf-control"><label for="xf-input">{T.xmlInput}</label><Toggletip id="xf-tip-input" about={T.xmlInput} lang={lang}>{TIPS.input}</Toggletip></div>
        <div class="xf-control"><button id="xf-copy-input" class="btn-copy" type="button">{T.copy}</button><Toggletip id="xf-tip-copy-input" about={T.copy + ' ' + T.xmlInput} lang={lang}>{TIPS.copyInput}</Toggletip></div>
      </div>
      <textarea id="xf-input" class="tool-textarea xf-box zt-io-fill" placeholder='<?xml version="1.0"?>&#10;<root><item id="1"><name>Example</name></item></root>' spellcheck="false"></textarea>
    </div>
    <div class="xf-panel xf-result zt-io-pane">
      <div class="xf-head">
        <label for="xf-output">{T.formattedXml}</label>
        <div class="xf-control"><button id="xf-copy-output" class="btn-copy" type="button">{T.copy}</button><Toggletip id="xf-tip-copy-output" about={T.copy + ' ' + T.formattedXml} lang={lang}>{TIPS.copyOutput}</Toggletip></div>
      </div>
      <p class="xf-empty">{T.formattedXmlPh}</p>
      <textarea id="xf-output" class="tool-textarea xf-box zt-io-fill" placeholder={T.formattedXmlPh} readonly spellcheck="false"></textarea>
    </div>
  </div>

  <script is:inline>
    (function () {
      var t = JSON.parse(document.querySelector('.xf-wrap').dataset.strings || '{}');

      var inputEl = document.getElementById('xf-input');
      var outputEl = document.getElementById('xf-output');
      var statusEl = document.getElementById('xf-status');
      var copyInputBtn = document.getElementById('xf-copy-input');
      var copyOutputBtn = document.getElementById('xf-copy-output');
      var indentEl = document.getElementById('xf-indent');
      var lastValidXmlOutput = '';

      var copyRevision = 0, copyErrorOwner = null;
      var copyStates = [
        { btn: copyInputBtn, request: 0, timer: null },
        { btn: copyOutputBtn, request: 0, timer: null }
      ];

      function invalidateCopies() {
        copyRevision++;
        copyErrorOwner = null;
        copyStates.forEach(function (state) {
          clearTimeout(state.timer);
          state.timer = null;
          state.btn.textContent = t.copy;
        });
      }

      function setStatus(msg, isError) {
        copyErrorOwner = null;
        statusEl.textContent = msg;
        statusEl.className = 'xf-status ' + (isError ? 'error' : 'success');
      }

      function clearStatus() {
        copyErrorOwner = null;
        statusEl.textContent = '';
        statusEl.className = 'xf-status';
      }

      function getIndent() {
        var val = indentEl.value;
        if (val === 'tab') return '\t';
        return new Array(parseInt(val, 10) + 1).join(' ');
      }

      /* ── Parse XML with DOMParser ── */
      function parseXml(text) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(text, 'application/xml');
        // Firefox wraps <parsererror> in a namespace, so querySelector won't match it.
        // Use localName on documentElement as the cross-browser reliable path.
        var docEl = doc.documentElement;
        var errNode = (docEl && docEl.localName === 'parsererror')
          ? docEl
          : doc.querySelector('parsererror');
        if (errNode) {
          var errText = errNode.textContent || errNode.innerText || 'Invalid XML';
          // Chrome and Safari (libxml2) put "This page contains the following errors:" before
          // the located message; keep only "error on line N at column M: …".
          var located = /error on line \d+ at column \d+:[^\n]*/.exec(errText);
          throw new Error(located ? located[0] : errText.split('\n')[0]);
        }
        return doc;
      }

      /* ── engine:start ── */
      /* ── Escape XML special chars ── */
      function escapeXml(str) {
        return str
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&apos;');
      }

      /* ── Prolog text that the DOM does not keep ──
         DOMParser has no node for the XML declaration, and its DocumentType node has no
         internal subset, so both are copied verbatim from the (well-formed) source. */
      function scanProlog(src) {
        var declaration = '';
        var doctype = '';
        var pos = 0;
        var m = /^<\?xml\s[\s\S]*?\?>/.exec(src);
        if (m) { declaration = m[0]; pos = m[0].length; }

        function skipPast(marker, from) {
          var end = src.indexOf(marker, from);
          return end === -1 ? src.length : end + marker.length;
        }

        while (pos < src.length) {
          var ch = src[pos];
          if (ch === ' ' || ch === '\t' || ch === '\n' || ch === '\r') { pos++; continue; }
          if (src.startsWith('<!--', pos)) { pos = skipPast('-->', pos + 4); continue; }
          if (src.startsWith('<?', pos)) { pos = skipPast('?>', pos + 2); continue; }
          if (!src.startsWith('<!DOCTYPE', pos)) break;

          var i = pos + 9;
          var depth = 0;
          while (i < src.length) {
            var c = src[i];
            if (c === '"' || c === "'") { i = skipPast(c, i + 1); continue; }
            if (depth > 0 && src.startsWith('<!--', i)) { i = skipPast('-->', i + 4); continue; }
            if (depth > 0 && src.startsWith('<?', i)) { i = skipPast('?>', i + 2); continue; }
            if (c === '[') depth++;
            else if (c === ']') depth--;
            else if (c === '>' && depth === 0) { i++; break; }
            i++;
          }
          doctype = src.slice(pos, i);
          break;
        }
        return { declaration: declaration, doctype: doctype };
      }

      function piText(node) {
        return '<?' + node.target + (node.data ? ' ' + node.data : '') + '?>';
      }

      /* ── Pretty-print by walking the DOM tree ── */
      function prettyPrint(doc, indent, prolog) {
        var lines = [];
        if (prolog.declaration) lines.push(prolog.declaration);

        function serializeNode(node, depth) {
          var pad = '';
          for (var p = 0; p < depth; p++) pad += indent;

          switch (node.nodeType) {
            case 7: /* ProcessingInstruction */
              lines.push(pad + piText(node));
              break;

            case 10: /* DocumentType */
              lines.push(prolog.doctype);
              break;

            case 8: /* Comment */
              lines.push(pad + '<!--' + node.data + '-->');
              break;

            case 4: /* CDATASection */
              lines.push(pad + '<![CDATA[' + node.data + ']]>');
              break;

            case 3: /* Text */
              var text = node.data;
              var trimmed = text.trim();
              if (trimmed) {
                lines.push(pad + escapeXml(trimmed));
              }
              break;

            case 1: /* Element */
              var tag = node.tagName;
              var attrs = '';
              for (var a = 0; a < node.attributes.length; a++) {
                var attr = node.attributes[a];
                attrs += ' ' + attr.name + '="' + escapeXml(attr.value) + '"';
              }

              /* Check if element has only a single text child */
              if (node.childNodes.length === 1 && node.childNodes[0].nodeType === 3) {
                var txt = node.childNodes[0].data.trim();
                if (txt) {
                  lines.push(pad + '<' + tag + attrs + '>' + escapeXml(txt) + '</' + tag + '>');
                } else {
                  lines.push(pad + '<' + tag + attrs + '/>');
                }
                break;
              }

              /* No children → self-closing */
              if (node.childNodes.length === 0) {
                lines.push(pad + '<' + tag + attrs + '/>');
                break;
              }

              /* Has child elements or mixed content */
              lines.push(pad + '<' + tag + attrs + '>');
              for (var c = 0; c < node.childNodes.length; c++) {
                serializeNode(node.childNodes[c], depth + 1);
              }
              lines.push(pad + '</' + tag + '>');
              break;

            case 9: /* Document */
            case 11: /* DocumentFragment */
              for (var d = 0; d < node.childNodes.length; d++) {
                serializeNode(node.childNodes[d], depth);
              }
              break;
          }
        }

        serializeNode(doc, 0);
        return lines.join('\n');
      }

      /* ── Minify by walking the DOM tree ── */
      function minify(doc, prolog) {
        var parts = [];
        if (prolog.declaration) parts.push(prolog.declaration);

        function serializeNode(node) {
          switch (node.nodeType) {
            case 7: /* ProcessingInstruction */
              parts.push(piText(node));
              break;

            case 10: /* DocumentType */
              parts.push(prolog.doctype);
              break;

            case 8: /* Comment */
              parts.push('<!--' + node.data + '-->');
              break;

            case 4: /* CDATASection */
              parts.push('<![CDATA[' + node.data + ']]>');
              break;

            case 3: /* Text */
              var trimmed = node.data.trim();
              if (trimmed) parts.push(escapeXml(trimmed));
              break;

            case 1: /* Element */
              var tag = node.tagName;
              var attrs = '';
              for (var a = 0; a < node.attributes.length; a++) {
                var attr = node.attributes[a];
                attrs += ' ' + attr.name + '="' + escapeXml(attr.value) + '"';
              }

              if (node.childNodes.length === 0) {
                parts.push('<' + tag + attrs + '/>');
                break;
              }

              parts.push('<' + tag + attrs + '>');
              for (var c = 0; c < node.childNodes.length; c++) {
                serializeNode(node.childNodes[c]);
              }
              parts.push('</' + tag + '>');
              break;

            case 9: /* Document */
            case 11: /* DocumentFragment */
              for (var d = 0; d < node.childNodes.length; d++) {
                serializeNode(node.childNodes[d]);
              }
              break;
          }
        }

        serializeNode(doc);
        return parts.join('');
      }

      /* ── engine:end ── */

      /* ── Real-time format on input (debounced 300ms) ── */
      var _xfLiveTimer = null;
      inputEl.addEventListener('input', function () {
        clearTimeout(_xfLiveTimer);
        invalidateCopies();
        _xfLiveTimer = setTimeout(function () {
          _xfLiveTimer = null;
          invalidateCopies();
          var raw = inputEl.value.trim();
          if (!raw) { outputEl.value = ''; lastValidXmlOutput = ''; clearStatus(); return; }
          try {
            var doc = parseXml(raw);
            var indent = getIndent();
            var result = prettyPrint(doc, indent, scanProlog(raw));
            outputEl.value = result;
            lastValidXmlOutput = result;
            setStatus(t.formatted, false);
          } catch (e) {
            outputEl.value = '';
            lastValidXmlOutput = '';
            setStatus(t.errorPrefix + e.message, true);
          }
        }, 300);
      });

      /* ── Format button ── */
      document.getElementById('xf-format').addEventListener('click', function () {
        clearTimeout(_xfLiveTimer);
        _xfLiveTimer = null;
        invalidateCopies();
        var raw = inputEl.value.trim();
        if (!raw) { outputEl.value = ''; lastValidXmlOutput = ''; clearStatus(); return; }

        try {
          var doc = parseXml(raw);
          var indent = getIndent();
          outputEl.value = prettyPrint(doc, indent, scanProlog(raw));
          lastValidXmlOutput = outputEl.value;
          setStatus(t.formatted, false);
          window.trackTool && window.trackTool('xml_formatter', 'format');
        } catch (e) {
          outputEl.value = '';
          lastValidXmlOutput = '';
          setStatus(t.errorPrefix + e.message, true);
        }
      });

      /* ── Minify button ── */
      document.getElementById('xf-minify').addEventListener('click', function () {
        clearTimeout(_xfLiveTimer);
        _xfLiveTimer = null;
        invalidateCopies();
        var raw = inputEl.value.trim();
        if (!raw) { outputEl.value = ''; lastValidXmlOutput = ''; clearStatus(); return; }

        try {
          var doc = parseXml(raw);
          outputEl.value = minify(doc, scanProlog(raw));
          lastValidXmlOutput = outputEl.value;
          setStatus(t.minified, false);
          window.trackTool && window.trackTool('xml_formatter', 'minify');
        } catch (e) {
          outputEl.value = '';
          lastValidXmlOutput = '';
          setStatus(t.errorPrefix + e.message, true);
        }
      });

      /* ── Clear ── */
      document.getElementById('xf-clear').addEventListener('click', function () {
        clearTimeout(_xfLiveTimer);
        _xfLiveTimer = null;
        invalidateCopies();
        inputEl.value = '';
        outputEl.value = '';
        lastValidXmlOutput = '';
        clearStatus();
        inputEl.focus();
      });

      /* ── Copy buttons ── */
      function copyFrom(field, state) {
        var text = field.value;
        if (!text) return;
        var revision = copyRevision, request = ++state.request;
        clearTimeout(state.timer);
        state.timer = null;
        state.btn.textContent = t.copy;
        function current() { return revision === copyRevision && request === state.request && field.value === text; }
        function failed() {
          if (!current()) return;
          setStatus(t.copyFailed, true);
          copyErrorOwner = state.btn;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (!current()) return;
            if (copyErrorOwner === state.btn && statusEl.textContent === t.copyFailed) clearStatus();
            state.btn.textContent = t.copied;
            state.timer = setTimeout(function () {
              if (current()) state.btn.textContent = t.copy;
            }, 1500);
          }, failed);
        } catch (_) { failed(); }
      }
      copyInputBtn.addEventListener('click', function () {
        copyFrom(inputEl, copyStates[0]);
      });

      copyOutputBtn.addEventListener('click', function () {
        copyFrom(outputEl, copyStates[1]);
      });
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'l' && document.querySelector('.xf-wrap').contains(document.activeElement)) {
          e.preventDefault();
          document.getElementById('xf-clear').click();
        }
      });
    })();
  </script>
</div>

<style>
  .xf-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; min-height: 0; }
  .xf-options, .xf-toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem; flex: none; }
  .xf-options select { min-height: 44px; font-size: 0.85rem; }
  .xf-control { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .xf-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; min-height: 32px; }
  .xf-head label, .xf-options label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .xf-box { min-width: 0; overflow: auto; tab-size: 2; }
  .xf-status { height: 2.6rem; min-height: 2.6rem; flex: none; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; line-height: 1.5; color: var(--color-text-secondary); }
  .xf-status.success { color: var(--color-success); }
  .xf-status.error { color: var(--color-danger); }
  .xf-empty { display: none; flex: 1; align-items: center; justify-content: center; margin: 0; padding: 1rem; color: var(--color-text-secondary); text-align: center; }
  .xf-result:has(#xf-output:placeholder-shown) .xf-empty { display: flex; }
  #xf-output:placeholder-shown { display: none; }

  @media (max-width: 860px) {
    .xf-box { height: 180px; }
    .xf-result:has(#xf-output:placeholder-shown) { display: none; }
    .xf-status { height: 3.25rem; min-height: 3.25rem; }
  }
  @media (max-width: 640px) {
    .xf-wrap { gap: 0.5rem; }
    .xf-toolbar { gap: 0.4rem; }
    .xf-toolbar button { padding-inline: 0.55rem; }
    .xf-head { min-height: 44px; }
    .xf-box { height: 120px; }
  }
</style>
