---
import Toggletip from '../Toggletip.astro';
const { lang = 'en' } = Astro.props;
// strings:start
const STRINGS = {
        en: { copyFailed: 'Copy failed. Try again.', generate: 'Generate', generateBatch: 'Generate 10', batchPlaceholder: 'Batch passwords appear here...', noCharset: 'Select at least one character set.', veryWeak: 'Very Weak', weak: 'Weak', fair: 'Fair', strong: 'Strong', veryStrong: 'Very Strong', length: "Length:", upper: "Uppercase (A–Z)", lower: "Lowercase (a–z)", digits: "Digits (0–9)", symbols: "Symbols (!@#$…)", ambiguous: "Exclude ambiguous (0Ol1I)", copy: "Copy", copyTitle: "Copy to clipboard", clickGenerate: "Click Generate", singleResult: "Password", batchResult: "Batch passwords", empty: "Generated passwords appear here.", tips: {"length": "Choose 4–128 characters. The slider and number stay synchronized and immediately generate a new single password. An empty value uses 20.", "upper": "Include the 26 uppercase ASCII letters. Selected sets supply the pool; a password is not guaranteed to contain a character from each set.", "lower": "Include the 26 lowercase ASCII letters in the random character pool. Keep at least one character set selected.", "digits": "Include the ten digits 0–9 in the random character pool. A selected set is not guaranteed to appear in every password.", "symbols": "Include the fixed set of 26 ASCII symbols. Spaces, quotes, slash, backslash, backtick and tilde are not in the set.", "ambiguous": "Remove 0, O, l, 1 and I from the selected character pool before generating.", "generate": "A single password is generated on load and when length or character options change. Generate draws another value; the existing batch stays unchanged.", "batch": "Generate ten passwords with the current settings, one per line. Changing settings leaves this batch as it was until you generate ten again.", "copy": "Copy the current single password. The batch remains available as selectable text. Ctrl or Command plus L clears both results and the strength meter.", "strength": "The meter shows length multiplied by log2 of the pool size. Its five labels use the fixed thresholds 40, 60, 80 and 100 bits."} },
        zh: { copyFailed: '复制失败，请重试。', generate: '生成', generateBatch: '生成 10 个', batchPlaceholder: '批量密码显示在这里...', noCharset: '请至少选择一种字符集。', veryWeak: '很弱', weak: '弱', fair: '一般', strong: '强', veryStrong: '很强', length: "长度：", upper: "大写字母（A–Z）", lower: "小写字母（a–z）", digits: "数字（0–9）", symbols: "符号（!@#$…）", ambiguous: "排除易混淆字符（0Ol1I）", copy: "复制", copyTitle: "复制到剪贴板", clickGenerate: "点击生成", singleResult: "密码", batchResult: "批量密码", empty: "生成的密码会显示在这里。", tips: {"length": "选择 4–128 个字符。滑块与数字保持同步，修改后立即生成新的单个密码；空值使用 20。", "upper": "将 26 个 ASCII 大写字母加入字符池。选择的字符集只提供抽样范围，不保证每种字符都出现在密码中。", "lower": "将 26 个 ASCII 小写字母加入随机字符池；至少保留一种字符集。", "digits": "将 0–9 十个数字加入随机字符池；每个密码不保证包含所有选中的字符类型。", "symbols": "加入固定的 26 个 ASCII 符号；字符池不包含空格、引号、斜杠、反斜杠、反引号和波浪号。", "ambiguous": "生成前从选中的字符池中移除 0、O、l、1 和 I。", "generate": "载入页面或修改长度、字符选项时生成单个密码。生成按钮重新抽取一个密码，已有批量结果保持不变。", "batch": "按当前设置生成十个密码，每行一个。修改设置不会改写这批结果，需再次点击生成 10 个。", "copy": "复制当前单个密码；批量文本可选中复制。Ctrl 或 Command 加 L 清空两份结果和强度指示器。", "strength": "强度按长度乘以字符池大小的 log2 计算；五档标签使用 40、60、80 和 100 比特的固定阈值。"} },
        ja: { copyFailed: 'コピーに失敗しました。再試行してください。', generate: '生成', generateBatch: '10 個生成', batchPlaceholder: 'バッチパスワードはここに表示されます...', noCharset: '少なくとも 1 つの文字セットを選択してください。', veryWeak: 'とても弱い', weak: '弱い', fair: '普通', strong: '強い', veryStrong: 'とても強い', length: "長さ：", upper: "大文字（A–Z）", lower: "小文字（a–z）", digits: "数字（0–9）", symbols: "記号（!@#$…）", ambiguous: "紛らわしい文字を除外（0Ol1I）", copy: "コピー", copyTitle: "クリップボードにコピー", clickGenerate: "生成をクリック", singleResult: "パスワード", batchResult: "バッチパスワード", empty: "生成したパスワードがここに表示されます。", tips: {"length": "4〜128 文字を指定します。スライダーと数値は同期し、変更すると単体のパスワードを生成します。空欄は 20 になります。", "upper": "ASCII 大文字 26 字を文字プールに加えます。選択した各文字種が必ず含まれるわけではありません。", "lower": "ASCII 小文字 26 字をランダムな文字プールに加えます。少なくとも 1 種類は選択してください。", "digits": "0〜9 の 10 字を文字プールに加えます。選択した文字種が毎回含まれる保証はありません。", "symbols": "固定の ASCII 記号 26 字を加えます。空白、引用符、スラッシュ、バックスラッシュ、バッククォート、チルダは含みません。", "ambiguous": "生成前に、選択した文字プールから 0、O、l、1、I を除きます。", "generate": "ページ表示時や長さ・文字設定の変更時に単体を生成します。「生成」は新しい値を作り、既存のバッチは保持します。", "batch": "現在の設定で 10 個を生成し、1 行に 1 個表示します。設定の変更では既存バッチは変わらず、再び「10 個生成」を押すと更新します。", "copy": "現在の単体パスワードをコピーします。バッチはテキストを選択できます。Ctrl または Command と L で両方の結果と強度を消去します。", "strength": "長さと文字プールの大きさの log2 を掛けたビット数です。5 段階の境界は 40、60、80、100 ビットです。"} },
        ko: { copyFailed: '복사하지 못했습니다. 다시 시도하세요.', generate: '생성', generateBatch: '10개 생성', batchPlaceholder: '배치 비밀번호가 여기에 표시됩니다...', noCharset: '최소 하나의 문자 세트를 선택해 주세요.', veryWeak: '매우 약함', weak: '약함', fair: '보통', strong: '강함', veryStrong: '매우 강함', length: "길이:", upper: "대문자(A–Z)", lower: "소문자(a–z)", digits: "숫자(0–9)", symbols: "기호(!@#$…)", ambiguous: "혼동하기 쉬운 문자 제외(0Ol1I)", copy: "복사", copyTitle: "클립보드에 복사", clickGenerate: "생성 클릭", singleResult: "비밀번호", batchResult: "배치 비밀번호", empty: "생성한 비밀번호가 여기에 표시됩니다.", tips: {"length": "4~128자를 선택하세요. 슬라이더와 숫자는 동기화되며 변경하면 단일 비밀번호가 바로 생성됩니다. 빈 값은 20을 사용합니다.", "upper": "ASCII 대문자 26개를 문자 목록에 추가합니다. 선택한 모든 문자 종류가 비밀번호에 포함된다는 보장은 없습니다.", "lower": "ASCII 소문자 26개를 무작위 문자 목록에 추가합니다. 최소 한 종류를 선택하세요.", "digits": "0~9의 숫자 열 개를 문자 목록에 추가합니다. 각 비밀번호에 선택한 모든 종류가 포함되지는 않을 수 있습니다.", "symbols": "고정 ASCII 기호 26개를 추가합니다. 공백, 따옴표, 슬래시, 역슬래시, 백틱, 물결표는 포함하지 않습니다.", "ambiguous": "생성 전에 선택한 문자 목록에서 0, O, l, 1, I를 제거합니다.", "generate": "페이지를 열거나 길이·문자 옵션을 변경하면 단일 비밀번호를 생성합니다. 생성 버튼은 새 값을 만들며 기존 배치 결과는 유지합니다.", "batch": "현재 설정으로 비밀번호 열 개를 한 줄에 하나씩 생성합니다. 설정을 바꿔도 기존 배치는 유지되며 10개 생성을 다시 눌러야 갱신됩니다.", "copy": "현재 단일 비밀번호를 복사합니다. 배치는 텍스트를 선택할 수 있습니다. Ctrl 또는 Command와 L을 누르면 두 결과와 강도 표시를 지웁니다.", "strength": "길이에 문자 목록 크기의 log2를 곱한 비트 수를 표시합니다. 다섯 단계의 경계는 40, 60, 80, 100비트입니다."} }
      };
// strings:end
const L = STRINGS[lang as keyof typeof STRINGS] || STRINGS.en;
const clientStrings = { copyFailed: L.copyFailed, noCharset: L.noCharset, veryWeak: L.veryWeak, weak: L.weak, fair: L.fair, strong: L.strong, veryStrong: L.veryStrong };
---
<div class="pg-wrap" data-strings={JSON.stringify(clientStrings)}>
  <div class="pg-main">
  <aside class="pg-rail zt-rail">
    <div class="pg-actions">
      <div class="pg-action-row"><button id="pg-generate" class="btn-primary">{L.generate}</button><Toggletip id="pg-tip-generate" lang={lang} about={L.generate}>{L.tips.generate}</Toggletip></div>
      <div class="pg-action-row"><button id="pg-batch-generate" class="btn-secondary">{L.generateBatch}</button><Toggletip id="pg-tip-batch" lang={lang} about={L.generateBatch}>{L.tips.batch}</Toggletip></div>
      <div class="pg-action-row pg-copy-status" role="status" aria-live="polite"><button id="pg-copy" class="btn-icon" title={L.copyTitle} aria-label={L.copy}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button><Toggletip id="pg-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip></div>
    </div>
    <div class="pg-controls">
      <div class="pg-label-row"><label id="pg-length-label" for="pg-length-input">{L.length}</label><Toggletip id="pg-tip-length" lang={lang} about={L.length}>{L.tips.length}</Toggletip></div>
      <div class="pg-length-row">
        <input type="range" id="pg-length" min="4" max="128" value="20" aria-labelledby="pg-length-label" />
        <input type="number" id="pg-length-input" min="4" max="128" value="20" aria-labelledby="pg-length-label" />
      </div>
      <div class="pg-checkboxes">
        <div class="pg-check-row"><label><input type="checkbox" id="pg-upper" checked /><span>{L.upper}</span></label><Toggletip id="pg-tip-upper" lang={lang} about={L.upper}>{L.tips.upper}</Toggletip></div>
        <div class="pg-check-row"><label><input type="checkbox" id="pg-lower" checked /><span>{L.lower}</span></label><Toggletip id="pg-tip-lower" lang={lang} about={L.lower}>{L.tips.lower}</Toggletip></div>
        <div class="pg-check-row"><label><input type="checkbox" id="pg-digits" checked /><span>{L.digits}</span></label><Toggletip id="pg-tip-digits" lang={lang} about={L.digits}>{L.tips.digits}</Toggletip></div>
        <div class="pg-check-row"><label><input type="checkbox" id="pg-symbols" checked /><span>{L.symbols}</span></label><Toggletip id="pg-tip-symbols" lang={lang} about={L.symbols}>{L.tips.symbols}</Toggletip></div>
        <div class="pg-check-row"><label><input type="checkbox" id="pg-ambiguous" /><span>{L.ambiguous}</span></label><Toggletip id="pg-tip-ambiguous" lang={lang} about={L.ambiguous}>{L.tips.ambiguous}</Toggletip></div>
      </div>
    </div>
    <div class="pg-strength-status" role="status" aria-live="polite">
      <div class="pg-strength-bar"><div id="pg-strength-fill" class="pg-strength-fill"></div></div>
      <div class="pg-strength-row"><div id="pg-strength-label" class="pg-strength-label"></div><Toggletip id="pg-tip-strength" lang={lang} about={L.singleResult}>{L.tips.strength}</Toggletip></div>
    </div>
  </aside>
  <section class="pg-results" aria-label={L.singleResult}>
    <p class="pg-empty">{L.empty}</p>
    <div class="pg-result-content">
      <div class="pg-output-row"><div id="pg-output" class="pg-output">{L.clickGenerate}</div></div>
      <div class="pg-batch-section"><label for="pg-batch-output" class="tool-label">{L.batchResult}</label><textarea id="pg-batch-output" class="pg-batch" readonly placeholder={L.batchPlaceholder} spellcheck="false"></textarea></div>
    </div>
  </section>
  </div>
  <script is:inline>
    (function () {
      var t = JSON.parse(document.querySelector('.pg-wrap').dataset.strings);

      /* ── engine:start ── */
      var UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      var LOWER = 'abcdefghijklmnopqrstuvwxyz';
      var DIGITS = '0123456789';
      var SYMBOLS = '!@#$%^&*()-_=+[]{}|;:,.<>?';
      var AMBIGUOUS = /[0Ol1I]/g;

      function charsetFor(opts) {
        var s = '';
        if (opts.upper) s += UPPER;
        if (opts.lower) s += LOWER;
        if (opts.digits) s += DIGITS;
        if (opts.symbols) s += SYMBOLS;
        if (opts.ambiguous) s = s.replace(AMBIGUOUS, '');
        return s;
      }

      // Rejection sampling: values at or above the largest multiple of charset.length
      // are drawn again, so every character is equally likely (no modulo bias).
      function genPassword(len, charset) {
        if (!charset) return '';
        var n = charset.length;
        var limit = 4294967296 - (4294967296 % n);
        var buf = new Uint32Array(len);
        var result = '';
        while (result.length < len) {
          crypto.getRandomValues(buf);
          for (var i = 0; i < buf.length && result.length < len; i++) {
            if (buf[i] < limit) result += charset[buf[i] % n];
          }
        }
        return result;
      }

      function entropy(len, charsetSize) {
        return len * Math.log2(charsetSize);
      }

      function strengthInfo(bits) {
        if (bits < 40) return { key: 'veryWeak', label: 'Very Weak', color: '#e00', width: 15 };
        if (bits < 60) return { key: 'weak', label: 'Weak', color: '#e67e22', width: 35 };
        if (bits < 80) return { key: 'fair', label: 'Fair', color: '#f39c12', width: 55 };
        if (bits < 100) return { key: 'strong', label: 'Strong', color: '#27ae60', width: 75 };
        return { key: 'veryStrong', label: 'Very Strong', color: '#057a55', width: 100 };
      }
      /* ── engine:end ── */

      function buildCharset() {
        return charsetFor({
          upper: document.getElementById('pg-upper').checked,
          lower: document.getElementById('pg-lower').checked,
          digits: document.getElementById('pg-digits').checked,
          symbols: document.getElementById('pg-symbols').checked,
          ambiguous: document.getElementById('pg-ambiguous').checked
        });
      }

      function updateStrength(pwd, charsetSize) {
        var bits = pwd.length * Math.log2(Math.max(charsetSize, 1));
        var info = strengthInfo(bits);
        var fill = document.getElementById('pg-strength-fill');
        var label = document.getElementById('pg-strength-label');
        fill.style.width = info.width + '%';
        fill.style.background = info.color;
        label.textContent = (t[info.key] || info.label) + ' (' + Math.round(bits) + ' bits)';
        label.style.color = info.color;
      }

      var copyBtn = document.getElementById('pg-copy');
      var copyIcon = copyBtn.innerHTML;
      var copyState;
      function resetCopy() {
        if (copyState) clearTimeout(copyState.timer);
        copyState = { timer: null };
        copyBtn.innerHTML = copyIcon;
        copyBtn.style.color = '';
        return copyState;
      }
      function clearResults() {
        document.getElementById('pg-output').textContent = '';
        document.getElementById('pg-output').classList.remove('has-value');
        document.getElementById('pg-strength-fill').style.width = '0%';
        document.getElementById('pg-strength-fill').style.background = '';
        document.getElementById('pg-strength-label').textContent = '';
        document.getElementById('pg-strength-label').style.color = '';
        document.getElementById('pg-batch-output').value = '';
        resetCopy();
        copyBtn.disabled = true;
      }
      function generate() {
        resetCopy();
        var len = Math.min(128, Math.max(4, parseInt(document.getElementById('pg-length').value) || 20));
        var charset = buildCharset();
        if (!charset) {
          clearResults();
          document.getElementById('pg-output').textContent = t.noCharset;
          return;
        }
        var pwd = genPassword(len, charset);
        var out = document.getElementById('pg-output');
        out.textContent = pwd;
        out.classList.add('has-value');
        copyBtn.disabled = false;
        updateStrength(pwd, charset.length);
        window.trackTool && window.trackTool('password_generator', 'generate');
        return pwd;
      }

      function syncLengthInputs(source) {
        var val = Math.min(128, Math.max(4, parseInt(source.value) || 20));
        document.getElementById('pg-length').value = val;
        document.getElementById('pg-length-input').value = val;
      }

      document.getElementById('pg-length').addEventListener('input', function () {
        syncLengthInputs(this);
        generate();
      });
      document.getElementById('pg-length-input').addEventListener('input', function () {
        syncLengthInputs(this);
        generate();
      });

      ['pg-upper', 'pg-lower', 'pg-digits', 'pg-symbols', 'pg-ambiguous'].forEach(function (id) {
        document.getElementById(id).addEventListener('change', generate);
      });

      document.getElementById('pg-generate').addEventListener('click', generate);

      copyBtn.addEventListener('click', function () {
        // Copy only a generated password: the output carries .has-value only then, whatever the
        // page language of the placeholder or the "select a character set" message.
        var out = document.getElementById('pg-output');
        var val = out.textContent;
        if (!val || copyBtn.disabled || !out.classList.contains('has-value')) return;
        var state = resetCopy();
        function failed() { if (copyState === state) copyBtn.textContent = t.copyFailed; }
        try {
          if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') { failed(); return; }
          Promise.resolve(navigator.clipboard.writeText(val)).then(function () {
            if (copyState !== state) return;
            copyBtn.style.color = '#057a55';
            state.timer = setTimeout(function () { if (copyState === state) copyBtn.style.color = ''; }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });

      document.getElementById('pg-batch-generate').addEventListener('click', function () {
        var len = Math.min(128, Math.max(4, parseInt(document.getElementById('pg-length').value) || 20));
        var charset = buildCharset();
        if (!charset) { clearResults(); document.getElementById('pg-output').textContent = t.noCharset; return; }
        var passwords = [];
        for (var i = 0; i < 10; i++) passwords.push(genPassword(len, charset));
        document.getElementById('pg-batch-output').value = passwords.join('\n');
        window.trackTool && window.trackTool('password_generator', 'generate_batch');
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l') return;
        var tool = document.querySelector('.pg-wrap');
        if (!tool || !tool.contains(document.activeElement)) return;
        clearResults();
      });

      // Auto-generate on load
      generate();
    })();
  </script>
</div>

<style>
  .pg-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .pg-main { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 1rem; flex: 1; min-width: 0; min-height: 0; }
  .pg-rail { overflow: auto; }
  .pg-controls { display: flex; flex-direction: column; gap: 0.5rem; }
  .pg-label-row, .pg-action-row, .pg-check-row, .pg-strength-row { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .pg-label-row label { font-size: 0.88rem; font-weight: 600; color: var(--color-text-secondary); }
  .pg-length-row { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .pg-length-row input[type=range] { flex: 1; min-width: 0; accent-color: var(--color-primary); }
  .pg-length-row input[type=number] { width: 60px; padding: 0.25rem 0.4rem; border: 1px solid var(--color-border); border-radius: 5px; font-size: 0.88rem; text-align: center; background: var(--color-bg); color: var(--color-text); }
  .pg-checkboxes { display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.88rem; color: var(--color-text-secondary); }
  .pg-check-row label { display: flex; align-items: center; gap: 0.35rem; min-width: 0; cursor: pointer; }
  .pg-checkboxes input[type=checkbox] { accent-color: var(--color-primary); flex: none; }
  .pg-actions { display: flex; flex-direction: column; gap: 0.5rem; }
  .pg-action-row button { min-width: 0; max-width: 100%; white-space: normal; }
  .pg-copy-status { min-height: 2.8em; }
  .pg-strength-bar { height: 6px; background: var(--color-border); border-radius: 3px; overflow: hidden; }
  .pg-strength-fill { height: 100%; border-radius: 3px; transition: width 0.2s, background 0.2s; width: 0; }
  .pg-strength-label { flex: 1; min-width: 0; font-size: 0.78rem; font-weight: 600; }
  .pg-strength-row { min-height: 2.8em; }
  .pg-results, .pg-result-content { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; }
  .pg-result-content { flex: 1; }
  .pg-output-row { display: flex; align-items: center; flex: none; min-width: 0; min-height: 64px; padding: 0.75rem 1rem; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .pg-output { flex: 1; min-width: 0; font-family: var(--font-mono); font-size: 1.05rem; letter-spacing: 0.04em; color: var(--color-text-muted); user-select: all; white-space: pre; overflow: auto; }
