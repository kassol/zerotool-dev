        var k = displayScale(v), cap = PREVIEW_MAX / Math.max(v.vw, v.vh);
        // A small image shown enlarged gets a canvas at screen resolution
        // (a whole number of canvas px per image px, drawn without
        // smoothing), so cut lines and tile numbers stay sharp.
        var up = Math.floor(Math.min(k * (window.devicePixelRatio || 1), cap));
        var ps = up > 1 ? up : Math.min(1, cap);
        var cw = Math.max(1, Math.round(v.vw * ps)), ch = Math.max(1, Math.round(v.vh * ps));
        if (canvasEl.width !== cw || canvasEl.height !== ch) { canvasEl.width = cw; canvasEl.height = ch; }
        fitStage(v, k);
        pctx.clearRect(0, 0, cw, ch);
        pctx.imageSmoothingEnabled = ps <= 1;
        pctx.imageSmoothingQuality = 'high';
        if (plan.fit === 'pad') {
          var s = Math.min(v.vw / W, v.vh / H);
          pctx.fillStyle = plan.padColor;
          pctx.fillRect(0, 0, cw, ch);
          pctx.drawImage(bitmap, (v.vw - W * s) / 2 * ps, (v.vh - H * s) / 2 * ps, W * s * ps, H * s * ps);
        } else {
          pctx.drawImage(bitmap, 0, 0, cw, ch);
        }
        if (plan.error) return;
        if (plan.crop) {
          var c = plan.crop;
          pctx.fillStyle = 'rgba(0, 0, 0, 0.55)';
          pctx.fillRect(0, 0, cw, c.y * ps);
          pctx.fillRect(0, (c.y + c.h) * ps, cw, ch - (c.y + c.h) * ps);
          pctx.fillRect(0, c.y * ps, c.x * ps, c.h * ps);
          pctx.fillRect((c.x + c.w) * ps, c.y * ps, cw - (c.x + c.w) * ps, c.h * ps);
        }
        var rects = plan.tiles.map(function (tile) { return previewRect(tile, ps); });
        pctx.lineWidth = 3;
        pctx.strokeStyle = 'rgba(0, 0, 0, 0.5)';
        rects.forEach(function (r) { pctx.strokeRect(r.x, r.y, r.w, r.h); });
        pctx.lineWidth = 1;
        pctx.strokeStyle = 'rgba(255, 255, 255, 0.95)';
        rects.forEach(function (r) { pctx.strokeRect(r.x, r.y, r.w, r.h); });
        // Numbers only where a tile shows at least 28 CSS px.
        var cssPerPx = (parseFloat(stageEl.style.width) || cw) / cw;
        pctx.textAlign = 'center';
        pctx.textBaseline = 'middle';
        plan.tiles.forEach(function (tile, i) {
          var r = rects[i], side = Math.min(r.w, r.h);
          if (side * cssPerPx < 28) return;
          var fs = Math.max(10 / cssPerPx, Math.min(side * 0.28, 44 / cssPerPx));
          var text = String(tile.order);
          pctx.font = '700 ' + fs + 'px system-ui, sans-serif';
          var tw = pctx.measureText(text).width + fs * 0.9, th = fs * 1.5;
          var cx = r.x + r.w / 2, cy = r.y + r.h / 2;
          pctx.fillStyle = 'rgba(0, 0, 0, 0.6)';
          pctx.beginPath();
          if (pctx.roundRect) pctx.roundRect(cx - tw / 2, cy - th / 2, tw, th, th / 2);
          else pctx.rect(cx - tw / 2, cy - th / 2, tw, th);
          pctx.fill();
          pctx.fillStyle = 'rgba(255, 255, 255, 1)';
          pctx.fillText(text, cx, cy + fs * 0.04);
        });
      }

      function updateCropBox() {
        var c = plan && !plan.error ? plan.crop : null;
        cropEl.hidden = !c;
        if (!c) return;
        cropEl.style.left = (c.x / W * 100) + '%';
        cropEl.style.top = (c.y / H * 100) + '%';
        cropEl.style.width = (c.w / W * 100) + '%';
        cropEl.style.height = (c.h / H * 100) + '%';
      }

      function updateNotes() {
        var n = plan ? plan.tiles.length : 0;
        if (plan && !plan.error && (plan.kind === 'ig-grid' || plan.kind === 'ig-carousel')) {
          var msg = fmt(plan.kind === 'ig-grid' ? t.postHint : t.carouselHint, { n: n });
          if (plan.crop) msg += ' ' + t.cropHint;
          hintEl.textContent = msg;
          hintEl.hidden = false;
          if (plan.scale > 1.001) {
            var across = plan.fit === 'pad' ? W : plan.crop.w;
            warnEl.textContent = fmt(t.upscaleWarn, { f: plan.scale.toFixed(2), w: across, need: Math.round(across * plan.scale) });
            warnEl.hidden = false;
          } else {
            warnEl.hidden = true;
          }
        } else {
          hintEl.hidden = true;
          warnEl.hidden = true;
        }
      }

      function updateSummary(skipped) {
        if (!shown.length) { summaryEl.textContent = ''; return; }
        var r = tileSizeRange(shown);
        var msg = r.minW === r.maxW && r.minH === r.maxH
          ? fmt(shown.length === 1 ? t.summaryEachOne : t.summaryEach, { n: shown.length, w: r.maxW, h: r.maxH })
          : fmt(t.summaryRange, {
            n: shown.length,
            w: r.minW === r.maxW ? r.maxW : r.minW + '–' + r.maxW,
            h: r.minH === r.maxH ? r.maxH : r.minH + '–' + r.maxH,
          });
        if (skipped) msg += ' · ' + fmt(skipped === 1 ? t.summarySkippedOne : t.summarySkipped, { k: skipped });
        summaryEl.textContent = msg;
      }

      function updateZip() {
        zipBtn.textContent = fmt(t.downloadZip, { n: ready ? shown.length : 0 });
        zipBtn.disabled = busy || !ready || !shown.length;
      }

      function setBusy(b) {
        busy = b;
        settingsEl.disabled = b;
        tilesEl.querySelectorAll('.isp-cell-dl').forEach(function (btn) { btn.disabled = b; });
        updateZip();
      }

      /* ── Tiles ── */
      var DL_ICON = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>';

      function tileLabel(tile, p) {
        if (p.kind === 'ig-grid') return fmt(t.postShort, { n: tile.order });
        if (p.kind === 'ig-carousel') return fmt(t.slideShort, { n: tile.order });
        return fmt(t.tileShort, { r: tile.row + 1, c: tile.col + 1 });
      }

      function addCell(tile, p, index) {
        var cell = document.createElement('div');
        cell.className = 'isp-cell';
        cell.setAttribute('role', 'listitem');
        var box = document.createElement('div');
        box.className = 'isp-thumb-box';
        if (p.kind !== 'grid' && p.kind !== 'tile') box.style.aspectRatio = tile.w + ' / ' + tile.h;
        var k = Math.min(1, THUMB_MAX / Math.max(tile.w, tile.h));
        var tc = document.createElement('canvas');
        tc.width = Math.max(1, Math.round(tile.w * k));
        tc.height = Math.max(1, Math.round(tile.h * k));
        tc.className = 'isp-thumb' + (Math.max(tile.w, tile.h) < 64 ? ' isp-pixelated' : '');
        paintTile(tc.getContext('2d'), tile, k, null, p);
        box.appendChild(tc);
        var foot = document.createElement('div');
        foot.className = 'isp-cell-foot';
        var label = document.createElement('span');
        label.className = 'isp-cell-label';
        label.textContent = tileLabel(tile, p);
        var dl = document.createElement('button');
        dl.type = 'button';
        dl.className = 'btn-icon isp-cell-dl';
        dl.dataset.i = String(index);
        dl.setAttribute('aria-label', fmt(t.downloadTileAria, { name: label.textContent }));
        dl.innerHTML = DL_ICON;
        dl.disabled = busy;
        foot.appendChild(label);
        foot.appendChild(dl);
        cell.appendChild(box);
        cell.appendChild(foot);
        tilesEl.appendChild(cell);
      }

      async function buildTiles(token) {
        var p = plan, skip = p.kind === 'tile' && prefs.skipEmpty, skipped = 0;
        tilesEl.className = 'isp-tiles' + (p.kind === 'ig-grid' ? ' isp-tiles-ig' : '');
        var sliceStart = performance.now();
        for (var i = 0; i < p.tiles.length; i++) {
          var tile = p.tiles[i];
          if (skip && tileIsEmpty(tile, p)) skipped++;
          else { addCell(tile, p, shown.length); shown.push(tile); }
          if (i < p.tiles.length - 1 && performance.now() - sliceStart > 24) {
            setStatus(fmt(t.statusRendering, { i: i + 1, n: p.tiles.length }), 'info');
            await yieldToBrowser();
            if (token !== genToken) return;
            sliceStart = performance.now();
          }
        }
        ready = true;
        updateSummary(skipped);
        updateZip();
        if (!shown.length) { setStatus(t.statusAllEmpty, 'error'); return; }
        if (noticeMsg) setStatus(noticeMsg.text, noticeMsg.kind);
        else setStatus('', 'none');
        if (!tracked && window.trackTool) { tracked = true; window.trackTool(SLUG, 'split'); }
      }

      function computePlan() {
        plan = planTiles(W, H, currentSettings());
        plan.padColor = prefs.padColor;
      }

      function regenerate() {
        clearTimeout(regenTimer);
        regenRevision++;
        if (!bitmap) return;
        genToken++;
        setBusy(false);
        var token = genToken;
        computePlan();
        shown = [];
        ready = false;
        tilesEl.innerHTML = '';
        summaryEl.textContent = '';
        updateZip();
        drawPreview();
        updateCropBox();
        updateNotes();
        if (plan.error) {
          noticeMsg = null;
          setStatus(fmt(t[plan.error.key], plan.error.vars), 'error');
          return;
        }
        noticeMsg = plan.notice ? { text: fmt(t[plan.notice.key], plan.notice.vars), kind: plan.notice.kind } : null;
        if (noticeMsg) setStatus(noticeMsg.text, noticeMsg.kind);
        else setStatus('', 'none');
        buildTiles(token);
      }

      function scheduleRegen(delay) {
        clearTimeout(regenTimer);
        var token = loadToken, request = ++regenRevision;
        regenTimer = setTimeout(function () {
          if (token === loadToken && request === regenRevision) regenerate();
        }, delay === undefined ? 250 : delay);
      }

      /* ── Load / clear ── */
      function releaseBitmap() {
        if (bitmap && bitmap.close) bitmap.close();
        bitmap = null;
      }

      function resetState() {
        loadToken++;
        genToken++;
        regenRevision++;
        clearTimeout(regenTimer);
        cancelAnimationFrame(dragFrame);
        dragFrame = 0;
        drag = null;
        cropEl.classList.remove('is-dragging');
        fileInput.value = '';
        nameEl.textContent = ''; dimsEl.textContent = ''; sizeEl.textContent = '';
        releaseBitmap();
        W = 0; H = 0; base = 'image';
        plan = null; shown = []; ready = false; noticeMsg = null;
        tilesEl.innerHTML = '';
        summaryEl.textContent = '';
        canvasEl.width = 0; canvasEl.height = 0;
        if (scratch) { scratch.width = 0; scratch.height = 0; }
        if (probe) { probe.width = 0; probe.height = 0; }
        cropEl.hidden = true;
        hintEl.hidden = true;
        warnEl.hidden = true;
        workspaceEl.hidden = true;
        dropEl.hidden = false;
        setBusy(false);
      }

      async function loadFile(file, pasted) {
        if (!file) return;
        var token = ++loadToken;
        genToken++;
        regenRevision++;
        clearTimeout(regenTimer);
        cancelAnimationFrame(dragFrame);
        dragFrame = 0;
        drag = null;
        cropEl.classList.remove('is-dragging');
        setBusy(false);
        if (file.type && file.type.indexOf('image/') !== 0) { setStatus(t.statusNotImage, 'error'); return; }
        if (!file.size) { setStatus(t.statusEmpty, 'error'); return; }
        setStatus('', 'none');
        var bmp;
        try {
          bmp = await decodeImage(file);
        } catch (e) {
          if (token === loadToken) setStatus(t.statusDecodeFailed, 'error');
          return;
        }
        if (token !== loadToken) { if (bmp && bmp.close) bmp.close(); return; }
        if (!bmp || !bmp.width || !bmp.height) {
          if (bmp && bmp.close) bmp.close();
          setStatus(t.statusDecodeFailed, 'error');
          return;
        }
        var L = ISP_LIMITS;
        if (bmp.width > L.maxSide || bmp.height > L.maxSide || bmp.width * bmp.height > L.maxSourcePixels) {
          setStatus(fmt(t.statusTooLarge, { w: bmp.width, h: bmp.height, mp: (bmp.width * bmp.height / 1e6).toFixed(1) }), 'error');
          if (bmp.close) bmp.close();
          return;
        }
        if (busy) setBusy(false);
        releaseBitmap();
        bitmap = bmp;
        W = bmp.width; H = bmp.height;
        base = pasted ? 'image' : sanitizeBase(file.name);
        fx = 0.5; fy = 0.5;
        tracked = false;
        nameEl.textContent = pasted ? t.pastedName : (file.name || t.pastedName);
        dimsEl.textContent = W + '×' + H;
        sizeEl.textContent = formatBytes(file.size);
        rowsInput.max = String(Math.min(ISP_LIMITS.maxGrid, H));
        colsInput.max = String(Math.min(ISP_LIMITS.maxGrid, W));
        dropEl.hidden = true;
        workspaceEl.hidden = false;
        regenerate();
      }

      /* ── Export ── */
      function mimeFor(format) {
        if (format === 'jpg') return 'image/jpeg';
        if (format === 'webp') return 'image/webp';
        return 'image/png';
      }

      function encodeTile(tile, p, options) {
        if (!scratch) {
          scratch = document.createElement('canvas');
          sctx = scratch.getContext('2d');
        }
        scratch.width = tile.w;
        scratch.height = tile.h;
        paintTile(sctx, tile, 1, options.format === 'jpg' ? options.jpgBg : null, p);
        var mime = mimeFor(options.format);
        return canvasToBlob(scratch, mime, mime === 'image/png' ? undefined : options.quality / 100);
      }

      async function downloadTile(i) {
        if (busy || !ready || !shown[i]) return;
        var p = plan, tile = shown[i], token = loadToken, generation = genToken;
        var options = { format: prefs.format, quality: prefs.quality, jpgBg: prefs.jpgBg };
        setBusy(true);
        var blob = await encodeTile(tile, p, options);
        if (token !== loadToken || generation !== genToken) return;
        setBusy(false);
        if (!blob) { setStatus(t.statusExportFailed, 'error'); return; }
        var ext = extFromMime(blob.type);
        var name = tileFileName(base, tile, p, ext);
        downloadBlob(blob, name);
        setStatus(fmt(t.statusTileDone, { name: name }) + (options.format === 'webp' && ext !== 'webp' ? ' ' + t.statusWebpFallback : ''), 'success');
        if (window.trackTool) window.trackTool(SLUG, 'tile');
      }

      async function downloadZip() {
        if (busy || !ready || !shown.length) return;
        var p = plan, token = loadToken, generation = genToken, fallback = false;
        var options = { format: prefs.format, quality: prefs.quality, jpgBg: prefs.jpgBg };
        var list = shown.slice().sort(function (a, b) { return a.order - b.order; });
        setBusy(true);
        var files = [];
        for (var k = 0; k < list.length; k++) {
          setStatus(fmt(t.statusEncoding, { i: k + 1, n: list.length }), 'info');
          var blob = await encodeTile(list[k], p, options);
          if (token !== loadToken || generation !== genToken) return;
          if (!blob) { setBusy(false); setStatus(t.statusExportFailed, 'error'); return; }
          var ext = extFromMime(blob.type);
          if (options.format === 'webp' && ext !== 'webp') fallback = true;
          files.push({ name: tileFileName(base, list[k], p, ext), data: new Uint8Array(await blob.arrayBuffer()) });
          if (token !== loadToken || generation !== genToken) return;
        }
        var zip = zipStore(files);
        setBusy(false);
        var suffix = p.kind === 'ig-grid' || p.kind === 'ig-carousel' ? '-instagram' : '-tiles';
        downloadBlob(new Blob([zip], { type: 'application/zip' }), base + suffix + '.zip');
        setStatus(fmt(list.length === 1 ? t.statusZipDoneOne : t.statusZipDone, { n: list.length }) + (fallback ? ' ' + t.statusWebpFallback : ''), 'success');
        if (window.trackTool) window.trackTool(SLUG, 'zip');
      }

      /* ── Input: drop zone click / keyboard / drag / paste ── */
      dropEl.addEventListener('click', function (e) {
        if (e.target !== fileInput) fileInput.click();
      });
      dropEl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
      });
      dropEl.addEventListener('dragover', function (e) { e.preventDefault(); dropEl.classList.add('drag-over'); });
      dropEl.addEventListener('dragleave', function () { dropEl.classList.remove('drag-over'); });
      fileInput.addEventListener('change', function () {
        if (this.files && this.files[0]) loadFile(this.files[0], false);
        this.value = '';
      });
      wrapEl.addEventListener('dragover', function (e) { e.preventDefault(); });
      wrapEl.addEventListener('drop', function (e) {
        e.preventDefault();
        dropEl.classList.remove('drag-over');
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) loadFile(e.dataTransfer.files[0], false);
      });
      document.addEventListener('paste', function (e) {
        if (!e.clipboardData || !e.clipboardData.items) return;
        var items = e.clipboardData.items;
        for (var i = 0; i < items.length; i++) {
          if (items[i].kind === 'file' && items[i].type.indexOf('image/') === 0) {
            var file = items[i].getAsFile();
            if (file) { e.preventDefault(); loadFile(file, true); }
            return;
          }
        }
        var tg = e.target;
        if (tg && (tg.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(tg.tagName))) return;
        setStatus(t.statusNoClipboardImage, 'info');
      });
      $('isp-change').addEventListener('click', function () { fileInput.click(); });
      $('isp-clear').addEventListener('click', function () {
        resetState();
        setStatus('', 'none');
        dropEl.focus();
      });

      /* ── Settings (persisted as preferences) ── */
      segBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var mode = btn.getAttribute('data-mode');
          if (mode === prefs.mode) return;
          prefs.mode = mode;
          savePrefs();
          updateModeUI();
          regenerate();
        });
      });
      NUM_FIELDS.forEach(function (f) {
        var el = $(f.id);
        el.addEventListener('input', function () {
          var v = toInt(el.value, f.min, f.max, null);
          if (v === null || v === prefs[f.key]) return;
          prefs[f.key] = v;
          savePrefs();
          scheduleRegen();
        });
        el.addEventListener('change', function () {
          var v = toInt(el.value, f.min, f.max, prefs[f.key]);
          if ((f.key === 'rows' || f.key === 'cols') && bitmap) v = Math.min(v, f.key === 'rows' ? H : W);
          el.value = String(v);
          if (v !== prefs[f.key]) {
            prefs[f.key] = v;
            savePrefs();
            scheduleRegen(0);
          }
        });
      });
      dropPartialInput.addEventListener('change', function () {
        prefs.dropPartial = dropPartialInput.checked;
        savePrefs();
        regenerate();
      });
      skipEmptyInput.addEventListener('change', function () {
        prefs.skipEmpty = skipEmptyInput.checked;
        savePrefs();
        regenerate();
      });
      igLayoutSelect.addEventListener('change', function () {
        prefs.igLayout = igLayoutSelect.value === 'carousel' ? 'carousel' : 'grid';
        aspectSelect.value = prefs[aspectPrefKey()];
        savePrefs();
        updateModeUI();
        regenerate();
      });
      aspectSelect.addEventListener('change', function () {
        if (ISP_IG.aspects.hasOwnProperty(aspectSelect.value)) prefs[aspectPrefKey()] = aspectSelect.value;
        savePrefs();
        regenerate();
      });
      fitSelect.addEventListener('change', function () {
        prefs.fit = fitSelect.value === 'pad' ? 'pad' : 'crop';
        savePrefs();
        updateModeUI();
        regenerate();
      });
      padColorInput.addEventListener('input', function () {
        prefs.padColor = padColorInput.value;
        savePrefs();
        if (plan) { plan.padColor = prefs.padColor; drawPreview(); }
        scheduleRegen();
      });
      formatSelect.addEventListener('change', function () {
        prefs.format = ['png', 'jpg', 'webp'].indexOf(formatSelect.value) >= 0 ? formatSelect.value : 'png';
        updateExportUI();
        savePrefs();
      });
      qualityInput.addEventListener('input', function () {
        prefs.quality = toInt(qualityInput.value, 50, 100, DEFAULTS.quality);
        qualityVal.textContent = String(prefs.quality);
        savePrefs();
      });
      bgInput.addEventListener('input', function () {
        prefs.jpgBg = bgInput.value;
        savePrefs();
      });

      /* ── Crop box: pointer drag (mouse + touch) and arrow keys ── */
      var drag = null, dragFrame = 0;
      function moveCrop(x, y) {
        var c = plan.crop;
        var n = clampCrop(x, y, c.w, c.h, W, H);
        fx = W > c.w ? n.x / (W - c.w) : 0.5;
        fy = H > c.h ? n.y / (H - c.h) : 0.5;
        computePlan();
        updateCropBox();
        if (!dragFrame) {
          var token = loadToken;
          dragFrame = requestAnimationFrame(function () {
            if (token !== loadToken) return;
            dragFrame = 0;
            drawPreview();
          });
        }
      }
      cropEl.addEventListener('pointerdown', function (e) {
        if (busy || !plan || !plan.crop) return;
        e.preventDefault();
        drag = { px: e.clientX, py: e.clientY, x: plan.crop.x, y: plan.crop.y };
        try { cropEl.setPointerCapture(e.pointerId); } catch (err) {}
        cropEl.classList.add('is-dragging');
      });
      cropEl.addEventListener('pointermove', function (e) {
        if (!drag) return;
        var r = stageEl.getBoundingClientRect();
        if (!r.width || !r.height) return;
        moveCrop(drag.x + (e.clientX - drag.px) * W / r.width, drag.y + (e.clientY - drag.py) * H / r.height);
      });
      function endDrag() {
        if (!drag) return;
        drag = null;
        cropEl.classList.remove('is-dragging');
        regenerate();
      }
      cropEl.addEventListener('pointerup', endDrag);
      cropEl.addEventListener('pointercancel', endDrag);
      cropEl.addEventListener('keydown', function (e) {
        if (busy || !plan || !plan.crop) return;
        var stepX = Math.max(1, Math.round(W * 0.02)), stepY = Math.max(1, Math.round(H * 0.02));
        var c = plan.crop, x = c.x, y = c.y;
        if (e.key === 'ArrowLeft') x -= stepX;
        else if (e.key === 'ArrowRight') x += stepX;
        else if (e.key === 'ArrowUp') y -= stepY;
        else if (e.key === 'ArrowDown') y += stepY;
        else return;
        e.preventDefault();
        moveCrop(x, y);
        scheduleRegen();
      });

      /* ── Tile downloads and ZIP ── */
      tilesEl.addEventListener('click', function (e) {
        var btn = e.target.closest('.isp-cell-dl');
        if (btn) downloadTile(parseInt(btn.dataset.i, 10));
      });
      zipBtn.addEventListener('click', function () { downloadZip(); });

      if (typeof ResizeObserver === 'function') {
        // Redraw in the next frame: resizing the stage inside the callback
        // would raise a "ResizeObserver loop" error.
        var resizeFrame = 0;
        new ResizeObserver(function () {
          if (resizeFrame) return;
          resizeFrame = requestAnimationFrame(function () { resizeFrame = 0; if (bitmap && plan) drawPreview(); });
        }).observe(stageArea);
      }

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l' || !wrapEl.contains(document.activeElement)) return;
        e.preventDefault();
        resetState();
        setStatus('', 'none');
      });


      function revealPreview() {
        if (!workspaceEl.hidden && matchMedia('(max-width: 860px)').matches) {
          stageArea.scrollIntoView({ block: 'start', behavior: 'smooth' });
