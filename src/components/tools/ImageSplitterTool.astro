// strings:end
const L = STRINGS[lang] || STRINGS.en;
const clientStrings = Object.fromEntries(["carouselHint", "cropHint", "downloadTileAria", "downloadZip", "pastedName", "postHint", "postShort", "slideShort", "statusAllEmpty", "statusColsClamped", "statusDecodeFailed", "statusEmpty", "statusEncoding", "statusExportFailed", "statusNoClipboardImage", "statusNoTilesDrop", "statusNoTilesMargin", "statusNotImage", "statusOnePartial", "statusRendering", "statusRowsClamped", "statusTileDone", "statusTileTooLarge", "statusTooLarge", "statusTooMany", "statusWebpFallback", "statusZipDone", "statusZipDoneOne", "summaryEach", "summaryEachOne", "summaryRange", "summarySkipped", "summarySkippedOne", "tileShort", "upscaleWarn"].map(key => [key, L[key as keyof typeof L]]));
---

<div class="isp-wrap" id="isp-wrap" data-lang={lang}>
  <div class="isp-panels">
    <aside class="isp-rail zt-rail">
      <div class="isp-info-actions isp-main-actions isp-actions">
        <span class="isp-action"><button type="button" id="isp-change" class="btn-secondary btn-sm">{L.changeImage}</button><Toggletip id="isp-tip-change" lang={lang} about={L.changeImage}>{L.tips.change}</Toggletip></span>
        <span class="isp-action"><button type="button" id="isp-clear" class="btn-ghost btn-sm">{L.clear}</button><Toggletip id="isp-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip></span>
        <span class="isp-action"><button type="button" id="isp-zip" class="btn-primary" disabled>{L.downloadZip.replace('{n}', '0')}</button><Toggletip id="isp-tip-zip" lang={lang} about={L.exportTitle}>{L.tips.zip}</Toggletip></span>
      </div>
      <div id="isp-status" class="tool-status isp-status" aria-live="polite"></div>
      <div class="isp-label-line"><span class="tool-label">{L.fileAria}</span><Toggletip id="isp-tip-image" lang={lang} about={L.fileAria}>{L.tips.image}</Toggletip></div>
    <div id="isp-drop" class="isp-drop" role="button" tabindex="0">
      <div class="isp-drop-inner">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
        </svg>
        <p set:html={L.dropHint}></p>
        <p class="isp-hint">{L.pasteHint}</p>
        <p class="isp-hint">{L.formatsHint}</p>
      </div>
      <input type="file" id="isp-file" accept="image/*" class="isp-file-input" tabindex="-1" aria-label={L.fileAria} />
    </div>
      <div class="isp-loaded-controls">
        <div class="isp-info">        <p class="isp-info-text">
          <span id="isp-name" class="isp-name"></span>
          <span class="isp-info-sep" aria-hidden="true">·</span>
          <span id="isp-dims"></span>
          <span class="isp-info-sep" aria-hidden="true">·</span>
          <span id="isp-size"></span>
        </p>
        </div>
      <fieldset id="isp-settings" class="isp-settings">
        <div class="isp-label-line"><span class="tool-label">{L.modeAria}</span><Toggletip id="isp-tip-mode" lang={lang} about={L.modeAria}>{L.tips.mode}</Toggletip></div>
        <div class="isp-seg" role="group" aria-label={L.modeAria}>
          <button type="button" class="isp-seg-btn" data-mode="grid" aria-pressed="true">{L.modeGrid}</button>
          <button type="button" class="isp-seg-btn" data-mode="tile" aria-pressed="false">{L.modeTile}</button>
          <button type="button" class="isp-seg-btn" data-mode="instagram" aria-pressed="false">{L.modeInstagram}</button>
        </div>

        <div id="isp-panel-grid" class="isp-fields">
          <div class="isp-field">
            <div class="isp-label-line"><label class="tool-label" for="isp-rows">{L.rowsLabel}</label><Toggletip id="isp-tip-rows" lang={lang} about={L.rowsLabel}>{L.tips.rows}</Toggletip></div>
            <input type="number" id="isp-rows" class="tool-input isp-num" min="1" max="20" value="3" inputmode="numeric" />
          </div>
          <div class="isp-field">
            <div class="isp-label-line"><label class="tool-label" for="isp-cols">{L.colsLabel}</label><Toggletip id="isp-tip-cols" lang={lang} about={L.colsLabel}>{L.tips.cols}</Toggletip></div>
            <input type="number" id="isp-cols" class="tool-input isp-num" min="1" max="20" value="3" inputmode="numeric" />
          </div>
        </div>

        <div id="isp-panel-tile" class="isp-panel-tile" hidden>
          <div class="isp-fields">
            <div class="isp-field">
              <div class="isp-label-line"><label class="tool-label" for="isp-tile-w">{L.tileWLabel}</label><Toggletip id="isp-tip-tileWidth" lang={lang} about={L.tileWLabel}>{L.tips.tileWidth}</Toggletip></div>
              <input type="number" id="isp-tile-w" class="tool-input isp-num" min="1" max="16384" value="64" inputmode="numeric" />
            </div>
            <div class="isp-field">
              <div class="isp-label-line"><label class="tool-label" for="isp-tile-h">{L.tileHLabel}</label><Toggletip id="isp-tip-tileHeight" lang={lang} about={L.tileHLabel}>{L.tips.tileHeight}</Toggletip></div>
              <input type="number" id="isp-tile-h" class="tool-input isp-num" min="1" max="16384" value="64" inputmode="numeric" />
            </div>
            <div class="isp-field">
              <div class="isp-label-line"><label class="tool-label" for="isp-margin">{L.marginLabel}</label><Toggletip id="isp-tip-margin" lang={lang} about={L.marginLabel}>{L.tips.margin}</Toggletip></div>
              <input type="number" id="isp-margin" class="tool-input isp-num" min="0" max="16384" value="0" inputmode="numeric" />
            </div>
            <div class="isp-field">
              <div class="isp-label-line"><label class="tool-label" for="isp-spacing">{L.spacingLabel}</label><Toggletip id="isp-tip-spacing" lang={lang} about={L.spacingLabel}>{L.tips.spacing}</Toggletip></div>
              <input type="number" id="isp-spacing" class="tool-input isp-num" min="0" max="16384" value="0" inputmode="numeric" />
            </div>
          </div>
          <div class="isp-checks">
            <div class="isp-label-line"><label class="isp-check"><input type="checkbox" id="isp-drop-partial" /> <span>{L.dropPartialLabel}</span></label><Toggletip id="isp-tip-dropPartial" lang={lang} about={L.dropPartialLabel}>{L.tips.dropPartial}</Toggletip></div>
            <div class="isp-label-line"><label class="isp-check"><input type="checkbox" id="isp-skip-empty" /> <span>{L.skipEmptyLabel}</span></label><Toggletip id="isp-tip-skipEmpty" lang={lang} about={L.skipEmptyLabel}>{L.tips.skipEmpty}</Toggletip></div>
          </div>
        </div>

        <div id="isp-panel-ig" class="isp-fields" hidden>
          <div class="isp-field">
            <div class="isp-label-line"><label class="tool-label" for="isp-ig-layout">{L.igLayoutLabel}</label><Toggletip id="isp-tip-layout" lang={lang} about={L.igLayoutLabel}>{L.tips.layout}</Toggletip></div>
            <select id="isp-ig-layout" class="tool-input isp-select">
              <option value="grid">{L.igLayoutGrid}</option>
              <option value="carousel">{L.igLayoutCarousel}</option>
            </select>
          </div>
          <div class="isp-field" id="isp-ig-rows-field">
            <div class="isp-label-line"><label class="tool-label" for="isp-ig-rows">{L.igRowsLabel}</label><Toggletip id="isp-tip-igRows" lang={lang} about={L.igRowsLabel}>{L.tips.igRows}</Toggletip></div>
            <input type="number" id="isp-ig-rows" class="tool-input isp-num" min="1" max="10" value="3" inputmode="numeric" />
          </div>
          <div class="isp-field" id="isp-ig-slides-field" hidden>
            <div class="isp-label-line"><label class="tool-label" for="isp-ig-slides">{L.igSlidesLabel}</label><Toggletip id="isp-tip-slides" lang={lang} about={L.igSlidesLabel}>{L.tips.slides}</Toggletip></div>
            <input type="number" id="isp-ig-slides" class="tool-input isp-num" min="2" max="20" value="3" inputmode="numeric" />
          </div>
          <div class="isp-field">
            <div class="isp-label-line"><label class="tool-label" for="isp-aspect">{L.aspectLabel}</label><Toggletip id="isp-tip-aspect" lang={lang} about={L.aspectLabel}>{L.tips.aspect}</Toggletip></div>
            <select id="isp-aspect" class="tool-input isp-select">
              <option value="3:4">3:4 · 1080×1440</option>
              <option value="4:5">4:5 · 1080×1350</option>
              <option value="1:1">1:1 · 1080×1080</option>
            </select>
          </div>
          <div class="isp-field">
            <div class="isp-label-line"><label class="tool-label" for="isp-fit">{L.fitLabel}</label><Toggletip id="isp-tip-fit" lang={lang} about={L.fitLabel}>{L.tips.fit}</Toggletip></div>
            <select id="isp-fit" class="tool-input isp-select">
              <option value="crop">{L.fitCrop}</option>
              <option value="pad">{L.fitPad}</option>
            </select>
          </div>
          <div class="isp-field" id="isp-pad-field" hidden>
            <div class="isp-label-line"><label class="tool-label" for="isp-pad-color">{L.padColorLabel}</label><Toggletip id="isp-tip-pad" lang={lang} about={L.padColorLabel}>{L.tips.pad}</Toggletip></div>
            <input type="color" id="isp-pad-color" class="isp-color" value="#ffffff" />
          </div>
        </div>
      </fieldset>
      <details class="isp-panel isp-export-options">
        <summary class="isp-panel-title">{L.exportTitle}</summary>
        <div class="isp-export-row">
          <div class="isp-field">
            <div class="isp-label-line"><label class="tool-label" for="isp-format">{L.formatLabel}</label><Toggletip id="isp-tip-format" lang={lang} about={L.formatLabel}>{L.tips.format}</Toggletip></div>
            <select id="isp-format" class="tool-input isp-select">
              <option value="png">PNG</option>
              <option value="jpg">JPG</option>
              <option value="webp">WebP</option>
            </select>
          </div>
          <div id="isp-quality-field" class="isp-field isp-quality-field" hidden>
            <div class="isp-label-line"><label for="isp-quality" class="tool-label"><span>{L.qualityLabel}</span> <strong id="isp-quality-val" class="isp-quality-val">92</strong></label><Toggletip id="isp-tip-quality" lang={lang} about={L.qualityLabel}>{L.tips.quality}</Toggletip></div>
            <input type="range" id="isp-quality" min="50" max="100" step="1" value="92" />
          </div>
          <div class="isp-field" id="isp-bg-field" hidden>
            <div class="isp-label-line"><label class="tool-label" for="isp-bg">{L.bgLabel}</label><Toggletip id="isp-tip-background" lang={lang} about={L.bgLabel}>{L.tips.background}</Toggletip></div>
            <input type="color" id="isp-bg" class="isp-color" value="#ffffff" />
          </div>
        </div>
        <p class="isp-note">{L.metaNote}</p>
      </details>
      </div>
    </aside>
    <section class="isp-result-panel">
      <h2 class="tool-label isp-result-title">{L.previewLabel}</h2>
      <p class="isp-empty">{L.emptyPreview}</p>
      <div id="isp-workspace" class="isp-workspace" hidden>
      <div class="isp-label-line"><span class="tool-label">{L.cropAria}</span><Toggletip id="isp-tip-crop" lang={lang} about={L.cropAria}>{L.tips.crop}</Toggletip></div>
      <div class="isp-preview">
        <div id="isp-stage-area" class="isp-stage-area">
          <div id="isp-stage" class="isp-stage">
            <canvas id="isp-canvas" class="isp-canvas"></canvas>
            <div id="isp-crop" class="isp-crop" tabindex="0" role="group" aria-label={L.cropAria} hidden></div>
          </div>
        </div>
      </div>

      <p id="isp-hint" class="isp-note" hidden></p>
      <p id="isp-warn" class="isp-warn" hidden></p>
      <p id="isp-summary" class="isp-summary" aria-live="polite"></p>

      <div class="isp-label-line"><span class="tool-label">{L.tilesAria}</span><Toggletip id="isp-tip-tiles" lang={lang} about={L.tilesAria}>{L.tips.tiles}</Toggletip></div>
      <div id="isp-tiles" class="isp-tiles" tabindex="0" role="list" aria-label={L.tilesAria}></div>
      </div>
    </section>
  </div>
</div>

<script is:inline define:vars={{clientStrings}}>
    (function () {

      var wrapEl = document.getElementById('isp-wrap');
      var t = clientStrings;
      function fmt(str, vars) {
        return str.replace(/\{(\w+)\}/g, function (m, k) { return vars && vars[k] !== undefined ? String(vars[k]) : m; });
      }

      /* ── engine:start ── */
      // Pure, DOM-free tile planning, naming and ZIP helpers — extracted
      // verbatim by scripts/test-image-splitter.mjs. Keep this block free of
      // DOM/canvas APIs.

      // Source limit: the decoded image is held as an ImageBitmap, 4 bytes per
      // pixel (50M px = 200 MB), the same budget as gif-splitter. Every tile is
      // drawn on its own canvas, so a tile must fit the iOS Safari canvas
      // limit of 16,777,216 px (4096²) and 16,384 px per side.
      var ISP_LIMITS = { maxTiles: 400, maxGrid: 20, maxSourcePixels: 50000000, maxSide: 16384, maxCanvasArea: 16777216 };
      var ISP_IG = {
        width: 1080, maxRows: 10, minSlides: 2, maxSlides: 20,
        aspects: { '3:4': [3, 4], '4:5': [4, 5], '1:1': [1, 1] },
      };

      // Integer in [min, max]; empty or non-numeric input gives `fallback`.
      function toInt(v, min, max, fallback) {
        if (v === '' || v === null || v === undefined) return fallback;
        var n = Math.floor(Number(v));
        if (!isFinite(n)) return fallback;
        return Math.max(min, Math.min(max, n));
      }

      // n equal parts of len without losing pixels: part i spans
      // [b[i], b[i+1]); part sizes differ by at most 1.
      function boundaries(n, len) {
        var b = [];
        for (var i = 0; i <= n; i++) b.push(Math.round(i * len / n));
        return b;
      }

      function canvasFits(w, h) {
        var L = ISP_LIMITS;
        return w >= 1 && h >= 1 && w <= L.maxSide && h <= L.maxSide && w * h <= L.maxCanvasArea;
      }

      // A tile's `draw` is the drawImage source rect (sx, sy, sw, sh) in image
      // pixels and destination rect (dx, dy, dw, dh) on the w×h tile canvas.
      function gridTiles(W, H, rows, cols) {
        var xb = boundaries(cols, W), yb = boundaries(rows, H), tiles = [];
        for (var r = 0; r < rows; r++) {
          for (var c = 0; c < cols; c++) {
            var w = xb[c + 1] - xb[c], h = yb[r + 1] - yb[r];
            tiles.push({
              row: r, col: c, order: r * cols + c + 1, w: w, h: h, partial: false,
              draw: { sx: xb[c], sy: yb[r], sw: w, sh: h, dx: 0, dy: 0, dw: w, dh: h },
            });
          }
        }
        return tiles;
      }

      // Number of tile start positions margin + i*(size+spacing) below len.
      // With dropPartial, a tile must also end inside len.
      function countStarts(len, size, margin, spacing, dropPartial) {
        if (margin >= len) return 0;
        var step = size + spacing;
        if (dropPartial) return margin + size > len ? 0 : Math.floor((len - margin - size) / step) + 1;
        return Math.ceil((len - margin) / step);
      }

      function sizeTiles(W, H, tileW, tileH, margin, spacing, dropPartial) {
        var nx = countStarts(W, tileW, margin, spacing, dropPartial);
        var ny = countStarts(H, tileH, margin, spacing, dropPartial);
        var tiles = [];
        for (var r = 0; r < ny; r++) {
          var y = margin + r * (tileH + spacing), h = Math.min(tileH, H - y);
          for (var c = 0; c < nx; c++) {
            var x = margin + c * (tileW + spacing), w = Math.min(tileW, W - x);
            tiles.push({
