const T = STRINGS[lang] || STRINGS.en;
const { tips: TIPS, ...CLIENT } = T;
---

<div class="cts-wrap" data-strings={JSON.stringify(CLIENT)}>
  <div class="cts-controls">
    <div class="cts-field">
      <div class="cts-control"><label for="cts-dialect">{T.dialectLabel}</label><Toggletip id="cts-tip-dialect" lang={lang} about={T.dialectLabel}>{TIPS.dialect}</Toggletip></div>
      <select id="cts-dialect" class="tool-select"><option value="mysql">MySQL</option><option value="postgresql">PostgreSQL</option><option value="sqlite">SQLite</option></select>
    </div>
    <div class="cts-field cts-field--wide">
      <div class="cts-control"><label for="cts-table">{T.tableNameLabel}</label><Toggletip id="cts-tip-table" lang={lang} about={T.tableNameLabel}>{TIPS.table}</Toggletip></div>
      <input id="cts-table" class="tool-input" type="text" value="my_table" spellcheck="false" autocomplete="off" />
    </div>
    <div class="cts-field">
      <div class="cts-control"><label for="cts-mode">{T.insertModeLabel}</label><Toggletip id="cts-tip-mode" lang={lang} about={T.insertModeLabel}>{TIPS.mode}</Toggletip></div>
      <select id="cts-mode" class="tool-select"><option value="batch">{T.batchMode}</option><option value="individual">{T.individualMode}</option></select>
    </div>
    <div class="cts-control cts-create-control"><label class="cts-check"><input id="cts-create" type="checkbox" /><span>{T.createTable}</span></label><Toggletip id="cts-tip-create" lang={lang} about={T.createTable}>{TIPS.create}</Toggletip></div>
    <div class="cts-control cts-file-control"><label class="cts-upload btn-ghost" for="cts-file-input">{T.uploadBtn}<input id="cts-file-input" type="file" accept=".csv,text/csv" /></label><Toggletip id="cts-tip-file" lang={lang} about={T.uploadBtn}>{TIPS.file}</Toggletip></div>
  </div>
  <div id="cts-status" class="cts-status" aria-live="polite"></div>
  <div class="cts-panels zt-io">
    <div class="cts-panel zt-io-pane">
      <div class="cts-head"><div class="cts-control"><label for="cts-csv">{T.csvLabel}</label><Toggletip id="cts-tip-csv" lang={lang} about={T.csvLabel}>{TIPS.csv}</Toggletip></div></div>
      <textarea id="cts-csv" class="tool-textarea cts-box zt-io-fill" spellcheck="false" placeholder={T.placeholder}></textarea>
    </div>
    <div class="cts-panel cts-result-pane zt-io-pane">
      <div class="cts-head"><label id="cts-sql-label" for="cts-sql">{T.sqlLabel}</label><div class="cts-control"><button id="cts-copy" class="btn-copy" type="button">{T.copy}</button><Toggletip id="cts-tip-copy" lang={lang} about={T.copy}>{TIPS.copy}</Toggletip></div></div>
      <textarea id="cts-sql" class="tool-textarea cts-box zt-io-fill" aria-labelledby="cts-sql-label" placeholder=" " spellcheck="false" readonly></textarea>
      <div class="cts-empty zt-io-fill">{T.empty}</div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var t = JSON.parse(document.querySelector('.cts-wrap').dataset.strings || '{}');

      var csvEl      = document.getElementById('cts-csv');
      var sqlEl      = document.getElementById('cts-sql');
      var dialectEl  = document.getElementById('cts-dialect');
      var tableEl    = document.getElementById('cts-table');
      var modeEl     = document.getElementById('cts-mode');
      var copyBtn    = document.getElementById('cts-copy');
      var fileInput  = document.getElementById('cts-file-input');
      var statusEl   = document.getElementById('cts-status');
      var createEl   = document.getElementById('cts-create');
      var fileRevision = 0;
      var copyRevision = 0;
      var copyTimer = null;

      function setStatus(msg, isError) {
        statusEl.textContent = msg;
        statusEl.className = 'cts-status ' + (isError ? 'error' : 'success');
      }
      function clearStatus() {
        statusEl.textContent = '';
        statusEl.className = 'cts-status';
      }

      /* ── engine:start ── */
      /* ── CSV parser (same logic as CsvJsonTool) ── */
      function parseCsv(text) {
        var rows = [];
        var row = [];
        var field = '';
        var inQuote = false;
        var quoteStart = 0;
        var i = 0;
        var len = text.length;

        while (i < len) {
          var ch = text[i];
          if (inQuote) {
            if (ch === '"') {
              if (i + 1 < len && text[i + 1] === '"') {
                field += '"';
                i += 2;
              } else {
                inQuote = false;
                i++;
              }
            } else {
              field += ch;
              i++;
            }
          } else {
            if (ch === '"' && field === '') {
              /* a quote opens a quoted field only at the start of the field; elsewhere it is text */
              inQuote = true;
              quoteStart = i;
              i++;
            } else if (ch === ',') {
              row.push(field);
              field = '';
              i++;
            } else if (ch === '\r') {
              row.push(field);
              field = '';
              rows.push(row);
              row = [];
              i++;
              if (i < len && text[i] === '\n') i++;
            } else if (ch === '\n') {
              row.push(field);
              field = '';
              rows.push(row);
              row = [];
              i++;
            } else {
              field += ch;
              i++;
            }
          }
        }

        if (inQuote) throw new Error('Unclosed quote starting on line ' + text.slice(0, quoteStart).split(/\r\n|\r|\n/).length + '.');

        if (field || row.length > 0) {
          row.push(field);
          rows.push(row);
        }

        if (rows.length > 0) {
          var last = rows[rows.length - 1];
          if (last.length === 1 && last[0] === '') rows.pop();
        }

        return rows;
      }

      /* ── SQL quoting helpers ── */
      function quoteIdent(name, dialect) {
        if (dialect === 'mysql') {
          return '`' + name.replace(/`/g, '``') + '`';
        }
        return '"' + name.replace(/"/g, '""') + '"';
      }

      /* A column is numeric when every non-empty cell in it is a plain number; its cells are
         written unquoted. A cell is a plain number only when the database reads it back as the same text:
         no leading zeros (02134 would become 2134), no sign or exponent forms, at most 15
         digits (more would lose digits in SQLite REAL / JavaScript numbers). Everything else is
         a quoted string, which MySQL, PostgreSQL and SQLite all convert for numeric columns. */
      function isPlainNumber(val) {
        return /^-?(0|[1-9]\d*)(\.\d+)?$/.test(val) && val.replace(/\D/g, '').length <= 15;
      }

      /* MySQL's default mode reads backslash escapes in string literals (MySQL manual,
         "String Literals", Table 11.1), so backslashes are doubled. PostgreSQL (with
         standard_conforming_strings on, the default since 9.1) and SQLite treat backslash
         as an ordinary character. */
      function quoteValue(val, dialect, numeric) {
        if (val === '') return 'NULL';
        if (numeric && isPlainNumber(val)) return val;
        var s = val.replace(/'/g, "''");
        if (dialect === 'mysql') s = s.replace(/\\/g, '\\\\');
        return "'" + s + "'";
      }

      function columnType(values, dialect) {
        var present = values.filter(function (v) { return v !== ''; });
        if (!present.length || !present.every(isPlainNumber)) return 'TEXT';
        if (present.some(function (v) { return v.indexOf('.') >= 0; })) {
          return dialect === 'mysql' ? 'DOUBLE' : dialect === 'postgresql' ? 'DOUBLE PRECISION' : 'REAL';
        }
        var big = present.some(function (v) { return Number(v) > 2147483647 || Number(v) < -2147483648; });
        if (dialect === 'sqlite') return 'INTEGER';
        if (big) return 'BIGINT';
        return dialect === 'mysql' ? 'INT' : 'INTEGER';
      }

      /* opts: { dialect, table, mode: 'batch' | 'individual', createTable }.
         Returns { sql, addedColumns, renamedColumns } or { error: 'noData' | 'noHeader' } or { error: 'unclosed', line }. Cells beyond the header
         get columns named column_N (N = position), so no value is dropped. */
      function csvToSql(text, opts) {
        /* Drop a BOM, leading blank lines and trailing line breaks only (same as csv-json), so spaces
           around the first header and the last cell stay. skipped = blank lines removed at the start. */
        var bomless = text.replace(/^\uFEFF/, '');
        var lead = /^(?:[ \t]*(?:\r\n|\r|\n))+/.exec(bomless);
        var skipped = lead ? lead[0].split(/\r\n|\r|\n/).length - 1 : 0;
        var parsed;
        try { parsed = parseCsv(bomless.slice(lead ? lead[0].length : 0).replace(/(?:\r\n|\r|\n)[ \t\r\n]*$/, '')); }
        catch (e) {
          var unclosed = /^Unclosed quote starting on line (\d+)\.$/.exec(e.message);
          if (unclosed) return { error: 'unclosed', line: Number(unclosed[1]) + skipped };
          throw e;
        }
        var rows = parsed.filter(function (r) {
          return r.some(function (c) { return c !== ''; });
        });
        if (rows.length === 0) return { error: 'noData' };
        var header = rows[0];
        if (header.every(function (h) { return h === ''; })) return { error: 'noHeader' };
        var dataRows = rows.slice(1);
        if (dataRows.length === 0) return { error: 'noData' };

        /* Every column gets a unique, nonempty name. Names are compared without case, because
           MySQL and SQLite column names are not case-sensitive. An empty header and a cell beyond
           the header get column_N (N = position); a repeated name gets _2, _3 … The new names
           avoid every name written in the header. */
        var width = dataRows.reduce(function (w, r) { return Math.max(w, r.length); }, header.length);
        var written = Object.create(null);
        header.forEach(function (h) { written[h.toLowerCase()] = true; });
        var taken = Object.create(null);
        var headers = [];
        var addedColumns = [];
        var renamedColumns = [];
        for (var c = 0; c < width; c++) {
          var given = c < header.length ? header[c] : '';
          var base = given === '' ? 'column_' + (c + 1) : given;
          var name = base;
          if (taken[name.toLowerCase()] || (given === '' && written[name.toLowerCase()])) {
            for (var k = 2; taken[(base + '_' + k).toLowerCase()] || written[(base + '_' + k).toLowerCase()]; k++) {}
            name = base + '_' + k;
          }
          taken[name.toLowerCase()] = true;
          headers.push(name);
          if (c >= header.length) addedColumns.push(name);
          else if (name !== given) renamedColumns.push((given === '' ? '""' : given) + ' → ' + name);
        }

        var dialect = opts.dialect;
        var qTable = quoteIdent(opts.table || 'my_table', dialect);
        var qCols = headers.map(function (h) { return quoteIdent(h, dialect); }).join(', ');
        var lines = [];
        function cell(row, ci) { return row[ci] !== undefined ? row[ci] : ''; }
        var numeric = headers.map(function (_, ci) {
          return dataRows.every(function (r) { var v = cell(r, ci); return v === '' || isPlainNumber(v); });
        });
        function tuple(row) {
          return '(' + headers.map(function (_, ci) { return quoteValue(cell(row, ci), dialect, numeric[ci]); }).join(', ') + ')';
        }

        if (opts.createTable) {
          var defs = headers.map(function (h, ci) {
            return quoteIdent(h, dialect) + ' ' + columnType(dataRows.map(function (r) { return cell(r, ci); }), dialect);
          });
          lines.push('CREATE TABLE ' + qTable + ' (' + defs.join(', ') + ');');
        }
        if (opts.mode === 'individual') {
          dataRows.forEach(function (row) {
            lines.push('INSERT INTO ' + qTable + ' (' + qCols + ') VALUES ' + tuple(row) + ';');
          });
        } else {
          lines.push('INSERT INTO ' + qTable + ' (' + qCols + ') VALUES');
          lines.push(dataRows.map(function (row) { return '  ' + tuple(row); }).join(',\n') + ';');
        }
        return { sql: lines.join('\n'), addedColumns: addedColumns, renamedColumns: renamedColumns };
      }
      /* ── engine:end ── */

      function convert() {
        clearTimeout(_timer);
        pending = false;
        resetCopy();
        if (!csvEl.value.trim()) {
          sqlEl.value = '';
          clearStatus();
          return;
        }
        var r = csvToSql(csvEl.value, {
          dialect: dialectEl.value,
          table: tableEl.value.trim() || 'my_table',
          mode: modeEl.value,
          createTable: createEl.checked,
        });
        if (r.error) {
          setStatus(r.error === 'unclosed' ? t.errUnclosed.replace('{line}', String(r.line)) : r.error === 'noHeader' ? t.errNoHeader : t.errNoData, true);
          sqlEl.value = '';
          return;
        }
        sqlEl.value = r.sql;
        var notes = [];
        if (r.addedColumns.length) notes.push(t.addedColumns.replace('{cols}', r.addedColumns.join(', ')));
        if (r.renamedColumns.length) notes.push(t.renamedColumns.replace('{cols}', r.renamedColumns.join(', ')));
        if (notes.length) setStatus(notes.join(' '), false);
        else clearStatus();
      }

      /* Analytics: one event per committed change (CSV or table name change event, a dialect,
         mode or CREATE TABLE change, a loaded file), not per typing pause or on page load. The
         same input with the same options is sent once. */
      var lastTracked = null;
      function trackChange() {
        if (!sqlEl.value) return;
        var key = [dialectEl.value, modeEl.value, createEl.checked, tableEl.value.trim() || 'my_table', csvEl.value].join('\u0000');
        if (key === lastTracked) return;
        lastTracked = key;
        window.trackTool && window.trackTool('csv_to_sql', 'convert');
      }

      /* ── Debounced live convert ── */
      var _timer = null;
      var pending = false;
      function scheduleConvert() {
        resetCopy();
        clearTimeout(_timer);
        pending = true;
        _timer = setTimeout(convert, 300);
      }
      function commitChange() {
        if (pending) convert();
        trackChange();
      }
      function convertAndTrack() {
        convert();
        trackChange();
      }

      csvEl.addEventListener('input', function () {
        fileRevision++;
        scheduleConvert();
      });
      csvEl.addEventListener('change', commitChange);
      dialectEl.addEventListener('change', convertAndTrack);
      tableEl.addEventListener('input', scheduleConvert);
      tableEl.addEventListener('change', commitChange);
      modeEl.addEventListener('change', convertAndTrack);
      createEl.addEventListener('change', convertAndTrack);

      /* ── File upload ── */
      /* A loaded file must be UTF-8 text. readAsText(file, 'UTF-8') turned every byte that is not
         UTF-8 into U+FFFD (a Shift_JIS or GBK CSV saved by Excel), so the bytes are checked first.
         firstBadUtf8 is copied from json-formatter-engine.js (test-csv-to-sql.mjs compares them);
         decodeCsvBytes follows decodeTextFile in MarkdownToWordTool.astro. */
      function firstBadUtf8(u8) {
        for (var x = 0; x < u8.length;) {
          var b = u8[x], need, min;
          if (b < 0x80) { x++; continue; }
          if (b >= 0xc2 && b <= 0xdf) { need = 1; min = 0x80; }
          else if (b >= 0xe0 && b <= 0xef) { need = 2; min = 0x800; }
          else if (b >= 0xf0 && b <= 0xf4) { need = 3; min = 0x10000; }
          else return x;
          var cp = b & (0x3f >> need);
          for (var y = 1; y <= need; y++) {
            var c = u8[x + y];
            if (c === undefined || (c & 0xc0) !== 0x80) return x;
            cp = (cp << 6) | (c & 0x3f);
          }
          if (cp < min || cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff)) return x;
          x += need + 1;
        }
        return -1;
      }
      function decodeCsvBytes(u8) {
        if ((u8[0] === 0xff && u8[1] === 0xfe) || (u8[0] === 0xfe && u8[1] === 0xff)) return { error: 'fileUtf16', offset: 0 };
        var nul = u8.indexOf(0);
        if (nul >= 0) {
          // UTF-16 text without a byte order mark: many NUL bytes, all on even or all on odd
          // offsets. Other NUL bytes mean a binary file.
          var head = Math.min(u8.length, 64), even = 0, odd = 0;
          for (var x = 0; x < head; x++) if (u8[x] === 0) { if (x % 2) odd++; else even++; }
          if ((even + odd) * 4 >= head && (even === 0 || odd === 0)) return { error: 'fileUtf16', offset: 0 };
          return { error: 'fileBinary', offset: nul };
        }
        var bad = firstBadUtf8(u8);
        if (bad >= 0) return { error: 'fileNotUtf8', offset: bad };
        // A UTF-8 byte order mark at the start is removed, as readAsText did.
        return { text: new TextDecoder('utf-8', { fatal: true }).decode(u8) };
      }

      fileInput.addEventListener('change', function () {
        var file = fileInput.files && fileInput.files[0];
        if (!file) return;
        var revision = ++fileRevision;
        clearTimeout(_timer);
        pending = false;
        resetCopy();
        var reader = new FileReader();
        reader.onload = function (e) {
          if (revision !== fileRevision) return;
          var read = decodeCsvBytes(new Uint8Array(e.target.result));
          if (read.error) { setStatus(t[read.error].replace('{offset}', String(read.offset)), true); return; }
          csvEl.value = read.text;
          convertAndTrack();
        };
        reader.onerror = function () {
          if (revision === fileRevision) setStatus(t.fileError, true);
        };
        reader.readAsArrayBuffer(file);
        fileInput.value = '';
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l') return;
        var widget = document.querySelector('.cts-wrap');
        if (!widget || !widget.contains(document.activeElement)) return;
        e.preventDefault();
        fileRevision++;
        clearTimeout(_timer);
        pending = false;
        lastTracked = null;
        resetCopy();
        csvEl.focus();
        csvEl.value = '';
        sqlEl.value = '';
        fileInput.value = '';
        clearStatus();
      });

      /* ── Copy ── */
      function resetCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
      }

      copyBtn.addEventListener('click', function () {
        if (!sqlEl.value) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        function failed() {
          if (revision === copyRevision) copyBtn.textContent = t.copyFailed;
        }
        try {
          navigator.clipboard.writeText(sqlEl.value).then(function () {
            if (revision !== copyRevision) return;
            copyBtn.textContent = t.copied;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = t.copy;
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });

      // seed sample data on mount
      csvEl.value = 'name,age,city\nAlice,30,New York\nBob,25,London';
      convert();
    })();
  </script>
</div>

<style>
  .cts-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; min-height: 0; }
  .cts-controls { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.5rem 0.75rem; flex: none; }
  .cts-control { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .cts-field { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .cts-field--wide { flex: 1; min-width: 140px; max-width: 20rem; }
  .cts-field label, .cts-head label { font-size: 0.82rem; font-weight: 600; color: var(--color-text-secondary); }
  .cts-field .tool-select, .cts-field .tool-input { width: 100%; min-width: 0; height: 36px; }
  .cts-check { display: flex; align-items: center; gap: 0.35rem; min-height: 36px; font-size: 0.82rem; color: var(--color-text-secondary); cursor: pointer; }
  .cts-check input { accent-color: var(--color-primary); flex: none; }
  .cts-upload { position: relative; display: inline-flex; align-items: center; min-height: 36px; cursor: pointer; white-space: nowrap; }
  .cts-upload input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
  .cts-upload:focus-within { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .cts-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; min-height: 32px; }
  .cts-head .btn-copy { min-width: 6.75rem; white-space: nowrap; }
  .cts-box { min-width: 0; overflow: auto; tab-size: 2; }
  .cts-box[readonly] { cursor: default; }
  .cts-empty { display: none; align-items: center; justify-content: center; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 1rem; color: var(--color-text-muted); font-size: 0.85rem; text-align: center; }
  .cts-result-pane:has(#cts-sql:placeholder-shown) .cts-box { display: none; }
  .cts-result-pane:has(#cts-sql:placeholder-shown) .cts-empty { display: flex; }
  .cts-status { height: 2.6rem; min-height: 2.6rem; flex: none; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; line-height: 1.5; }
  .cts-status.success { color: var(--color-success); }
  .cts-status.error { color: var(--color-danger); }
  @media (max-width: 860px) {
    .cts-box { height: 180px; }
    #cts-sql { height: 22rem; }
    .cts-status { height: 3.25rem; min-height: 3.25rem; }
    .cts-result-pane:has(#cts-sql:placeholder-shown) { display: none; }
  }
  @media (max-width: 640px) {
    .cts-wrap { gap: 0.5rem; }
    .cts-controls { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.35rem 0.5rem; }
    .cts-field--wide { min-width: 0; max-width: none; }
    .cts-field .tool-select, .cts-field .tool-input { height: 44px; }
    .cts-check, .cts-upload, .cts-head { min-height: 44px; }
    .cts-create-control { align-self: end; }
    .cts-file-control { grid-column: 1 / -1; }
    #cts-csv { height: 120px; }
  }
</style>
