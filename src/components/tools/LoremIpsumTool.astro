---
import Toggletip from '../Toggletip.astro';
const { lang = 'en' } = Astro.props;
// strings:start
const STRINGS = {
        en: { copyFailed: 'Copy failed. Try again.', paragraphs: 'Paragraphs:', generate: 'Generate', copyAll: 'Copy All', copied: 'Copied!', startClassic: 'Start with "Lorem ipsum dolor sit amet..."', placeholder: 'Click Generate to create placeholder text.', result: "Generated text", empty: "Generated paragraphs appear here.", tips: {"count": "Choose 1–20 paragraphs. An empty value or zero uses 5; changes take effect when you click Generate.", "classic": "Use the classic five-sentence passage for the first paragraph. Other paragraphs contain 3–6 random sentences from a fixed pool.", "generate": "Generate runs once on load. Click it again to create a new result using the current options.", "copy": "Copy all generated paragraphs as plain text, with one blank line between paragraphs. Ctrl or Command plus L clears the result and keeps the options."} },
        zh: { copyFailed: '复制失败，请重试。', paragraphs: '段落数：', generate: '生成', copyAll: '全部复制', copied: '已复制！', startClassic: '以 "Lorem ipsum dolor sit amet..." 开头', placeholder: '点击生成以创建占位文本。', result: "生成文本", empty: "生成的段落会显示在这里。", tips: {"count": "选择 1–20 段。空值或 0 使用默认 5 段；修改后点击生成才会应用。", "classic": "第一段使用经典的五句文本。其他段落从固定句池随机抽取 3–6 句。", "generate": "页面载入时生成一次；再次点击生成会按当前选项创建新结果。", "copy": "复制全部纯文本，段落间保留一个空行。Ctrl 或 Command 加 L 清空结果并保留选项。"} },
        ja: { copyFailed: 'コピーに失敗しました。再試行してください。', paragraphs: '段落数：', generate: '生成', copyAll: '全てコピー', copied: 'コピー済み！', startClassic: '「Lorem ipsum dolor sit amet...」で始める', placeholder: '「生成」をクリックしてプレースホルダーテキストを作成します。', result: "生成テキスト", empty: "生成した段落がここに表示されます。", tips: {"count": "1〜20 段落を指定します。空欄や 0 は 5 段落になります。変更は「生成」を押したときに反映されます。", "classic": "最初の段落を定番の 5 文にします。他の段落は固定の文リストから 3〜6 文をランダムに選びます。", "generate": "ページ表示時に一度生成します。再び押すと、現在の設定で新しいテキストを生成します。", "copy": "全段落をプレーンテキストでコピーし、段落の間に空行を 1 行入れます。Ctrl または Command と L で結果を消去し、設定は保持します。"} },
        ko: { copyFailed: '복사하지 못했습니다. 다시 시도하세요.', paragraphs: '단락 수:', generate: '생성', copyAll: '전체 복사', copied: '복사됨!', startClassic: '"Lorem ipsum dolor sit amet..."으로 시작', placeholder: '생성 버튼을 클릭하여 자리 표시자 텍스트를 만드세요.', result: "생성된 텍스트", empty: "생성한 단락이 여기에 표시됩니다.", tips: {"count": "1~20개 단락을 선택하세요. 빈 값이나 0은 기본값 5를 사용하며, 변경 후 생성 버튼을 눌러야 적용됩니다.", "classic": "첫 단락에 고전적인 다섯 문장을 사용합니다. 나머지 단락은 고정 목록에서 3~6개 문장을 무작위로 고릅니다.", "generate": "페이지를 열면 한 번 생성합니다. 다시 누르면 현재 옵션으로 새 텍스트를 만듭니다.", "copy": "전체 단락을 일반 텍스트로 복사하며 단락 사이에 빈 줄 하나를 넣습니다. Ctrl 또는 Command와 L을 누르면 결과를 지우고 옵션은 유지합니다."} }
      };
// strings:end
const L = STRINGS[lang as keyof typeof STRINGS] || STRINGS.en;
const clientStrings = { copyAll: L.copyAll, copied: L.copied, copyFailed: L.copyFailed };
---
<div class="li-wrap" data-strings={JSON.stringify(clientStrings)}>
  <div class="li-main">
  <aside class="li-rail zt-rail">
    <div class="li-actions">
      <div class="li-action-row">
        <button id="li-generate" class="btn-primary">{L.generate}</button>
        <Toggletip id="li-tip-generate" lang={lang} about={L.generate} >{L.tips.generate}</Toggletip>
      </div>
      <div class="li-action-row li-status" role="status" aria-live="polite">
        <button id="li-copy" class="btn-secondary">{L.copyAll}</button>
        <Toggletip id="li-tip-copy" lang={lang} about={L.copyAll} >{L.tips.copy}</Toggletip>
      </div>
    </div>
    <div class="li-controls">
      <div class="li-option-row">
        <label for="li-count" class="tool-label">{L.paragraphs}</label>
        <Toggletip id="li-tip-count" lang={lang} about={L.paragraphs} >{L.tips.count}</Toggletip>
        <input type="number" id="li-count" class="tool-input li-count-input" min="1" max="20" value="5" />
      </div>
      <div class="li-classic-row">
        <label class="li-checkbox-label">
          <input type="checkbox" id="li-start-classic" checked />
          <span>{L.startClassic}</span>
        </label>
        <Toggletip id="li-tip-classic" lang={lang} about={L.startClassic} >{L.tips.classic}</Toggletip>
      </div>
    </div>
  </aside>
  <section class="li-results" aria-label={L.result}>
    <p class="li-empty">{L.empty}</p>
    <div id="li-output" class="li-output"><p class="li-placeholder">{L.placeholder}</p></div>
  </section>
  </div>
  <script is:inline>
    (function () {
      var t = JSON.parse(document.querySelector('.li-wrap').dataset.strings);

      var SENTENCES = [
        'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
        'Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
        'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
        'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.',
        'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.',
        'Curabitur pretium tincidunt lacus, nec gravida arcu fermentum vel.',
        'Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas.',
        'Vestibulum ante ipsum primis in faucibus orci luctus et ultrices posuere cubilia curae.',
        'Proin eget tortor risus, vitae posuere nulla efficitur sit amet.',
        'Maecenas accumsan lacus vel facilisis volutpat, est velit egestas dui.',
        'Nulla porttitor accumsan tincidunt, cras ultricies ligula sed magna dictum porta.',
        'Vivamus suscipit tortor eget felis porttitor volutpat, donec rutrum congue leo eget malesuada.',
        'Praesent sapien massa, convallis a pellentesque nec, egestas non nisi.',
        'Mauris blandit aliquet elit, eget tincidunt nibh pulvinar a.',
        'Donec sollicitudin molestie malesuada, nulla quis lorem ut libero malesuada feugiat.',
        'Quisque velit nisi, pretium ut lacinia in, elementum id enim.',
        'Nulla facilisi, morbi non sem vel augue interdum posuere.',
        'Aenean vel elit scelerisque mauris pellentesque pulvinar pellentesque habitant morbi.',
        'Fusce dapibus, tellus ac cursus commodo, tortor mauris condimentum nibh.',
        'Integer malesuada nunc vel risus commodo viverra maecenas accumsan lacus.',
      ];

      var CLASSIC_START = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.';

      function shuffle(arr) {
        var a = arr.slice();
        for (var i = a.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
        }
        return a;
      }

      function makeParagraph() {
        var count = 3 + Math.floor(Math.random() * 4); // 3-6 sentences
        var picked = shuffle(SENTENCES).slice(0, count);
        return picked.join(' ');
      }

      function generate() {
        var count = Math.min(20, Math.max(1, parseInt(document.getElementById('li-count').value) || 5));
        var useClassic = document.getElementById('li-start-classic').checked;
        var paragraphs = [];

        for (var i = 0; i < count; i++) {
          if (i === 0 && useClassic) {
            paragraphs.push(CLASSIC_START);
          } else {
            paragraphs.push(makeParagraph());
          }
        }

        var output = document.getElementById('li-output');
        output.innerHTML = '';
        for (var i = 0; i < paragraphs.length; i++) {
          var p = document.createElement('p');
          p.textContent = paragraphs[i];
          output.appendChild(p);
        }
        output.dataset.text = paragraphs.join('\n\n');
        window.trackTool && window.trackTool('lorem_ipsum', 'generate');
      }

      var copyStates = new Map();
      function resetCopy(btn, label) {
        var previous = copyStates.get(btn);
        if (previous) clearTimeout(previous.timer);
        var state = { timer: null };
        copyStates.set(btn, state);
        btn.textContent = label;
        return state;
      }
      function copyText(btn, text, label, copied, delay) {
        if (!text || btn.disabled) return;
        var state = resetCopy(btn, label);
        function current() { return copyStates.get(btn) === state; }
        function failed() { if (current()) btn.textContent = t.copyFailed; }
        try {
          if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') { failed(); return; }
          Promise.resolve(navigator.clipboard.writeText(text)).then(function () {
            if (!current()) return;
            btn.textContent = copied;
            state.timer = setTimeout(function () { if (current()) btn.textContent = label; }, delay);
          }, failed);
        } catch (e) { failed(); }
      }
      var copyBtn = document.getElementById('li-copy');
      function refresh() {
        resetCopy(copyBtn, t.copyAll);
        generate();
        copyBtn.disabled = false;
      }
      document.getElementById('li-generate').addEventListener('click', refresh);
      copyBtn.addEventListener('click', function () {
        var text = document.getElementById('li-output').dataset.text;
        copyText(copyBtn, text, t.copyAll, t.copied, 1500);
        if (text) window.trackTool && window.trackTool('lorem_ipsum', 'copy');
      });
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l') return;
        var tool = document.querySelector('.li-wrap');
        if (!tool || !tool.contains(document.activeElement)) return;
        var output = document.getElementById('li-output');
        output.innerHTML = '';
        output.dataset.text = '';
        resetCopy(copyBtn, t.copyAll);
        copyBtn.disabled = true;
      });
      // Auto-generate on load
      refresh();
    })();
  </script>
</div>

<style>
  .li-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .li-main { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 1rem; flex: 1; min-width: 0; min-height: 0; }
  .li-rail { overflow: auto; }
  .li-controls { display: flex; flex-direction: column; gap: 0.6rem; }
  .li-option-row, .li-action-row, .li-classic-row { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .li-option-row .tool-label { margin: 0; }
  .li-count-input { width: 70px; padding: 0.3rem 0.5rem; text-align: center; }
  .li-checkbox-label { display: flex; align-items: center; gap: 0.35rem; min-width: 0; font-size: 0.88rem; color: var(--color-text-secondary); cursor: pointer; }
  .li-checkbox-label input[type=checkbox] { accent-color: var(--color-primary); flex: none; }
  .li-actions { display: flex; flex-direction: column; gap: 0.5rem; }
  .li-action-row .btn-primary, .li-action-row .btn-secondary { min-width: 0; white-space: normal; }
  .li-status { min-height: 2.8em; }
  .li-results { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .li-output { flex: 1 1 0; min-height: 300px; padding: 1rem; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); overflow: auto; line-height: 1.7; color: var(--color-text); font-size: 0.92rem; }
  .li-output :global(p) { margin: 0 0 0.75rem; }
  .li-output :global(p:last-child) { margin-bottom: 0; }
  .li-placeholder, .li-empty { color: var(--color-text-muted); font-style: italic; }
  .li-empty { display: none; margin: 0; }
  .li-results:has(#li-output:empty) .li-output { display: none; }
  .li-results:has(#li-output:empty) .li-empty { display: grid; flex: 1; min-height: 300px; place-content: center; padding: 1rem; }
  @media (max-width: 860px) {
    .li-main { grid-template-columns: minmax(0, 1fr); }
    .li-rail { overflow: visible; }
    .li-output { flex: none; height: 320px; min-height: 0; }
    .li-results:has(#li-output:empty) { display: none; }
  }
  @media (max-width: 640px) {
    .li-main { gap: 0.75rem; }
    .li-actions { flex-direction: row; flex-wrap: wrap; }
    .li-action-row { flex: 1 1 auto; }
    .li-action-row .btn-primary, .li-action-row .btn-secondary, .li-count-input { min-height: 44px; }
    .li-checkbox-label input { min-width: 24px; min-height: 24px; }
    .li-output { height: 280px; padding: 0.75rem; }
  }
</style>
