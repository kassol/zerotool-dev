---
// LoremIpsumTool — Lorem Ipsum placeholder text generator widget
---
<div>
  <div class="li-wrap">
    <div class="li-controls">
      <div class="li-option-row">
        <label for="li-count" class="tool-label" data-i18n="paragraphs">Paragraphs:</label>
        <input type="number" id="li-count" class="tool-input li-count-input" min="1" max="20" value="5" />
      </div>
      <label class="li-checkbox-label">
        <input type="checkbox" id="li-start-classic" checked />
        <span data-i18n="startClassic">Start with "Lorem ipsum dolor sit amet..."</span>
      </label>
    </div>

    <div class="li-actions">
      <button id="li-generate" class="btn-primary" data-i18n="generate">Generate</button>
      <button id="li-copy" class="btn-secondary" data-i18n="copyAll">Copy All</button>
    </div>

    <div id="li-output" class="li-output">
      <p class="li-placeholder" data-i18n="placeholder">Click Generate to create placeholder text.</p>
    </div>
  </div>

  <script is:inline>
    (function () {
      var STRINGS = {
        en: { copyFailed: 'Copy failed. Try again.', paragraphs: 'Paragraphs:', generate: 'Generate', copyAll: 'Copy All', copied: 'Copied!', startClassic: 'Start with "Lorem ipsum dolor sit amet..."', placeholder: 'Click Generate to create placeholder text.' },
        zh: { copyFailed: '复制失败，请重试。', paragraphs: '段落数：', generate: '生成', copyAll: '全部复制', copied: '已复制！', startClassic: '以 "Lorem ipsum dolor sit amet..." 开头', placeholder: '点击生成以创建占位文本。' },
        ja: { copyFailed: 'コピーに失敗しました。再試行してください。', paragraphs: '段落数：', generate: '生成', copyAll: '全てコピー', copied: 'コピー済み！', startClassic: '「Lorem ipsum dolor sit amet...」で始める', placeholder: '「生成」をクリックしてプレースホルダーテキストを作成します。' },
        ko: { copyFailed: '복사하지 못했습니다. 다시 시도하세요.', paragraphs: '단락 수:', generate: '생성', copyAll: '전체 복사', copied: '복사됨!', startClassic: '"Lorem ipsum dolor sit amet..."으로 시작', placeholder: '생성 버튼을 클릭하여 자리 표시자 텍스트를 만드세요.' }
      };

      var pageLang = (document.documentElement.lang || 'en').slice(0, 2);
      var t = STRINGS[pageLang] || STRINGS.en;
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n'); if (t[key]) el.textContent = t[key];
      });
      document.querySelectorAll('[data-i18n-ph]').forEach(function(el) {
        var key = el.getAttribute('data-i18n-ph'); if (t[key]) el.placeholder = t[key];
      });

      var SENTENCES = [
        'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
        'Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
        'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
        'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.',
        'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.',
        'Curabitur pretium tincidunt lacus, nec gravida arcu fermentum vel.',
        'Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas.',
        'Vestibulum ante ipsum primis in faucibus orci luctus et ultrices posuere cubilia curae.',
        'Proin eget tortor risus, vitae posuere nulla efficitur sit amet.',
        'Maecenas accumsan lacus vel facilisis volutpat, est velit egestas dui.',
        'Nulla porttitor accumsan tincidunt, cras ultricies ligula sed magna dictum porta.',
        'Vivamus suscipit tortor eget felis porttitor volutpat, donec rutrum congue leo eget malesuada.',
        'Praesent sapien massa, convallis a pellentesque nec, egestas non nisi.',
        'Mauris blandit aliquet elit, eget tincidunt nibh pulvinar a.',
        'Donec sollicitudin molestie malesuada, nulla quis lorem ut libero malesuada feugiat.',
        'Quisque velit nisi, pretium ut lacinia in, elementum id enim.',
        'Nulla facilisi, morbi non sem vel augue interdum posuere.',
        'Aenean vel elit scelerisque mauris pellentesque pulvinar pellentesque habitant morbi.',
        'Fusce dapibus, tellus ac cursus commodo, tortor mauris condimentum nibh.',
        'Integer malesuada nunc vel risus commodo viverra maecenas accumsan lacus.',
      ];

      var CLASSIC_START = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.';

      function shuffle(arr) {
        var a = arr.slice();
        for (var i = a.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
        }
        return a;
      }

      function makeParagraph() {
        var count = 3 + Math.floor(Math.random() * 4); // 3-6 sentences
        var picked = shuffle(SENTENCES).slice(0, count);
        return picked.join(' ');
      }

      function generate() {
        var count = Math.min(20, Math.max(1, parseInt(document.getElementById('li-count').value) || 5));
        var useClassic = document.getElementById('li-start-classic').checked;
        var paragraphs = [];

        for (var i = 0; i < count; i++) {
          if (i === 0 && useClassic) {
            paragraphs.push(CLASSIC_START);
          } else {
            paragraphs.push(makeParagraph());
          }
        }

        var output = document.getElementById('li-output');
        output.innerHTML = '';
        for (var i = 0; i < paragraphs.length; i++) {
          var p = document.createElement('p');
          p.textContent = paragraphs[i];
          output.appendChild(p);
        }
        output.dataset.text = paragraphs.join('\n\n');
        window.trackTool && window.trackTool('lorem_ipsum', 'generate');
      }

      var copyStates = new Map();
      function resetCopy(btn, label) {
        var previous = copyStates.get(btn);
        if (previous) clearTimeout(previous.timer);
        var state = { timer: null };
        copyStates.set(btn, state);
        btn.textContent = label;
        return state;
      }
      function copyText(btn, text, label, copied, delay) {
        if (!text || btn.disabled) return;
        var state = resetCopy(btn, label);
        function current() { return copyStates.get(btn) === state; }
        function failed() { if (current()) btn.textContent = t.copyFailed; }
        try {
          if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') { failed(); return; }
          Promise.resolve(navigator.clipboard.writeText(text)).then(function () {
            if (!current()) return;
            btn.textContent = copied;
            state.timer = setTimeout(function () { if (current()) btn.textContent = label; }, delay);
          }, failed);
        } catch (e) { failed(); }
      }
      var copyBtn = document.getElementById('li-copy');
      function refresh() {
        resetCopy(copyBtn, t.copyAll);
        generate();
        copyBtn.disabled = false;
      }
      document.getElementById('li-generate').addEventListener('click', refresh);
      copyBtn.addEventListener('click', function () {
        var text = document.getElementById('li-output').dataset.text;
        copyText(copyBtn, text, t.copyAll, t.copied, 1500);
        if (text) window.trackTool && window.trackTool('lorem_ipsum', 'copy');
      });
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l') return;
        var tool = document.querySelector('.li-wrap');
        if (!tool || !tool.contains(document.activeElement)) return;
        var output = document.getElementById('li-output');
        output.innerHTML = '';
        output.dataset.text = '';
        resetCopy(copyBtn, t.copyAll);
        copyBtn.disabled = true;
      });
      // Auto-generate on load
      refresh();
    })();
  </script>
</div>

<style>
  .li-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  .li-controls { display: flex; flex-direction: column; gap: 0.6rem; }

  .li-option-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .li-count-input {
    width: 70px;
    padding: 0.3rem 0.5rem;
    text-align: center;
  }

  .li-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .li-checkbox-label input[type=checkbox] { accent-color: var(--color-primary); }

  .li-actions { display: flex; gap: 0.5rem; }

  .li-output {
    padding: 1rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    max-height: 400px;
    overflow-y: auto;
    line-height: 1.7;
    color: var(--color-text);
    font-size: 0.92rem;
  }

  .li-output p {
    margin: 0 0 0.75rem 0;
  }

  .li-output p:last-child {
    margin-bottom: 0;
  }

  .li-placeholder {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
