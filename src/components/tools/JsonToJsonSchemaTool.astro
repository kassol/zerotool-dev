---
// JsonToJsonSchemaTool — paste JSON, get JSON Schema draft-07
---

<div class="jjs-wrap">
  <div class="jjs-panes">
    <div class="jjs-pane">
      <div class="jjs-pane-header">
        <span class="jjs-pane-label" data-i18n="inputJson">JSON Input</span>
        <button id="jjs-clear" class="btn-ghost jjs-btn-sm" type="button" data-i18n="clear">Clear</button>
      </div>
      <textarea id="jjs-input" class="jjs-textarea" spellcheck="false" placeholder='{"name":"Alice","age":30,"active":true}'></textarea>
    </div>
    <div class="jjs-pane">
      <div class="jjs-pane-header">
        <span id="jjs-output-label" class="jjs-pane-label">JSON Schema (draft-07)</span>
        <button id="jjs-copy" class="btn-ghost jjs-btn-sm" type="button" data-i18n="copy">Copy</button>
      </div>
      <textarea id="jjs-output" class="jjs-textarea jjs-output-area" aria-labelledby="jjs-output-label" spellcheck="false" readonly></textarea>
    </div>
  </div>
  <div id="jjs-error" class="jjs-error" hidden></div>

  <script is:inline>
    (function () {
      var STRINGS = {
        en: { inputJson: 'JSON Input', clear: 'Clear', copy: 'Copy', copied: 'Copied!', invalidJson: 'Invalid JSON' },
        zh: { inputJson: '输入 JSON', clear: '清除', copy: '复制', copied: '已复制！', invalidJson: '无效 JSON' },
        ja: { inputJson: 'JSON 入力', clear: 'クリア', copy: 'コピー', copied: 'コピー済み！', invalidJson: '無効な JSON' },
        ko: { inputJson: 'JSON 입력', clear: '지우기', copy: '복사', copied: '복사됨!', invalidJson: '유효하지 않은 JSON' }
      };

      var pageLang = (document.documentElement.lang || 'en').slice(0, 2);
      var t = STRINGS[pageLang] || STRINGS.en;

      document.querySelectorAll('.jjs-wrap [data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n'); if (t[key]) el.textContent = t[key];
      });

      var inputEl  = document.getElementById('jjs-input');
      var outputEl = document.getElementById('jjs-output');
      var errorEl  = document.getElementById('jjs-error');
      var clearBtn = document.getElementById('jjs-clear');
      var copyBtn  = document.getElementById('jjs-copy');

      /* ── engine:start ── */
      function kindOf(value) {
        if (value === null) return 'null';
        if (Array.isArray(value)) return 'array';
        var t = typeof value;
        if (t === 'number') return Number.isInteger(value) ? 'integer' : 'number';
        return t;
      }

      // One schema that accepts every value in the list: a type (or type list) plus the
      // object and array keywords, which only apply to instances of that type.
      function inferFromValues(values) {
        var types = [];
        var objects = [];
        var arrays = [];
        for (var i = 0; i < values.length; i++) {
          var kind = kindOf(values[i]);
          if (kind === 'object') objects.push(values[i]);
          if (kind === 'array') arrays.push(values[i]);
          if (types.indexOf(kind) === -1) types.push(kind);
        }
        // every integer is also a number
        var intIdx = types.indexOf('integer');
        var numIdx = types.indexOf('number');
        if (intIdx !== -1 && numIdx !== -1) {
          types.splice(Math.max(intIdx, numIdx), 1);
          types[Math.min(intIdx, numIdx)] = 'number';
        }

        var schema = { type: types.length === 1 ? types[0] : types };

        if (objects.length > 0) {
          var keys = [];
          var props = {};
          objects.forEach(function (obj) {
            Object.keys(obj).forEach(function (k) {
              if (keys.indexOf(k) === -1) keys.push(k);
            });
          });
          var required = [];
          keys.forEach(function (k) {
            var keyValues = [];
            var inAll = true;
            objects.forEach(function (obj) {
              if (Object.prototype.hasOwnProperty.call(obj, k)) {
                keyValues.push(obj[k]);
                if (obj[k] === null) inAll = false;
              } else {
                inAll = false;
              }
            });
            // defineProperty: a plain assignment to props.__proto__ would set the prototype
            Object.defineProperty(props, k, { value: inferFromValues(keyValues), enumerable: true, writable: true, configurable: true });
            if (inAll) required.push(k);
          });
          schema.properties = props;
          if (required.length > 0) schema.required = required;
        }

        if (arrays.length > 0) {
          var items = [];
          arrays.forEach(function (arr) { items = items.concat(arr); });
          schema.items = items.length > 0 ? inferFromValues(items) : {};
        }

        return schema;
      }

      function inferSchema(value) {
        return inferFromValues([value]);
      }
      /* ── engine:end ── */

      function convert() {
        var raw = inputEl.value.trim();
        if (!raw) {
          outputEl.value = '';
          errorEl.hidden = true;
          return;
        }
        try {
          var parsed = JSON.parse(raw);
          var schema = Object.assign(
            { '$schema': 'http://json-schema.org/draft-07/schema#' },
            inferSchema(parsed)
          );
          outputEl.value = JSON.stringify(schema, null, 2);
          errorEl.hidden = true;
        } catch (e) {
          outputEl.value = '';
          errorEl.textContent = t.invalidJson + ': ' + e.message;
          errorEl.hidden = false;
        }
        window.trackTool && window.trackTool('json-to-json-schema', 'convert');
      }

      inputEl.addEventListener('input', convert);

      clearBtn.addEventListener('click', function () {
        inputEl.value = '';
        outputEl.value = '';
        errorEl.hidden = true;
        inputEl.focus();
      });

      copyBtn.addEventListener('click', function () {
        var text = outputEl.value;
        if (!text) return;
        navigator.clipboard.writeText(text).then(function () {
          copyBtn.textContent = t.copied;
          setTimeout(function () { copyBtn.textContent = t.copy; }, 1500);
          window.trackTool && window.trackTool('json-to-json-schema', 'copy');
        });
      });

      // seed example
      inputEl.value = JSON.stringify({
        "name": "Alice",
        "age": 30,
        "active": true,
        "scores": [95, 87, 92],
        "address": {
          "street": "123 Main St",
          "city": "Wonderland"
        }
      }, null, 2);
      convert();
    })();
  </script>
</div>

<style>
  .jjs-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  .jjs-panes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 680px) {
    .jjs-panes { grid-template-columns: 1fr; }
  }

  .jjs-pane { display: flex; flex-direction: column; gap: 0.4rem; }

  .jjs-pane-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .jjs-pane-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .jjs-btn-sm {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
  }

  .jjs-textarea {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.5;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    width: 100%;
    min-height: 300px;
    resize: vertical;
    box-sizing: border-box;
  }

  .jjs-output-area { color: var(--color-text-secondary); }

  .jjs-error {
    font-size: 0.82rem;
    color: #ef4444;
    padding: 0.4rem 0.6rem;
    border: 1px solid #fca5a5;
    border-radius: var(--radius-sm);
    background: #fef2f2;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .jjs-error {
      background: #2d1515;
      border-color: #7f1d1d;
      color: #fca5a5;
    }
  }
</style>
