---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: {
    empty: "Enter JSON to generate a draft-07 schema.",
    tips: {
      "input": "Edit the sample JSON or enter your own. Every input change immediately generates draft-07 JSON Schema. Arrays merge all their elements; required keys come from non-null values present in every sampled object.",
      "clear": "Clear the input, generated schema and error message. Ctrl/⌘+L within the tool also clears them and returns focus to JSON Input.",
      "copy": "Copy the complete generated schema. The output is read-only; paste it into an editor to refine constraints or required fields. Empty output is not copied."
    },
    inputJson: 'JSON Input', clear: 'Clear', copy: 'Copy', copied: 'Copied!', copyFailed: 'Copy failed. Please copy the output manually.', invalidJson: 'Invalid JSON',
    msgTooDeep: 'The JSON is nested too deeply to generate a schema in this browser (the call stack ran out). Nothing was generated.',
    errJson: 'This is not valid JSON.',
    errJsonAt: 'This is not valid JSON: line {line}, column {col}, {reason}.',
    jsonParse: {
      empty: 'the input is empty',
      trailingComma: 'trailing comma before the closing bracket',
      comment: 'comments are not allowed in JSON',
      singleQuote: 'JSON strings and property names need double quotes (")',
      smartQuote: 'curly quotes ({ch}) are not JSON quotes; use straight double quotes (")',
      fullWidth: 'full-width character {ch}; JSON needs ASCII punctuation and spaces',
      unquotedKey: 'property names must be in double quotes',
      missingComma: 'missing comma between values',
      missingColon: 'missing colon after the property name',
      unterminatedString: 'the string is not closed',
      controlChar: 'a raw line break or tab inside a string; write \\n or \\t',
      badEscape: 'invalid escape sequence in a string',
      badNumber: 'invalid number (no leading zeros, "+", ".5", NaN or Infinity in JSON)',
      badLiteral: 'unknown word; JSON only has true, false and null',
      unexpectedEnd: 'the input ends too early (a bracket or quote is not closed)',
      extraData: 'more data after the end of the JSON value',
      unexpectedChar: 'unexpected character {ch}',
    },
  },
  zh: {
    empty: "输入 JSON 以生成 draft-07 Schema。",
    tips: {
      "input": "修改示例 JSON 或输入自己的数据。每次输入变化立即生成 draft-07 JSON Schema。数组会合并全部元素；每个样本对象都具有且非 null 的键会列为必填。",
      "clear": "清空输入、生成的 Schema 和错误信息。在工具内按 Ctrl/⌘+L 也可清空，并返回输入 JSON。",
      "copy": "复制完整生成的 Schema。输出为只读；请粘贴到编辑器中调整约束或必填字段。输出为空时不复制。"
    },
    inputJson: '输入 JSON', clear: '清除', copy: '复制', copied: '已复制！', copyFailed: '复制失败，请手动复制输出。', invalidJson: '无效 JSON',
    msgTooDeep: 'JSON 嵌套层数过深，此浏览器无法生成 Schema（调用栈耗尽），未生成任何内容。',
    errJson: '这不是有效的 JSON。',
    errJsonAt: '这不是有效的 JSON：第 {line} 行第 {col} 列，{reason}。',
    jsonParse: {
      empty: '输入为空',
      trailingComma: '右括号前多了一个逗号',
      comment: 'JSON 不允许注释',
      singleQuote: 'JSON 的字符串和属性名必须用双引号（"）',
      smartQuote: '{ch} 是中文引号，JSON 要用英文双引号（"）',
      fullWidth: '全角字符 {ch}；JSON 的标点和空格必须是半角',
      unquotedKey: '属性名必须加双引号',
      missingComma: '两个值之间缺少逗号',
      missingColon: '属性名后缺少冒号',
      unterminatedString: '字符串没有闭合',
      controlChar: '字符串里有直接的换行或制表符，要写成 \\n 或 \\t',
      badEscape: '字符串里的转义序列无效',
      badNumber: '数字写法无效（JSON 不允许前导 0、“+”、“.5”、NaN、Infinity）',
      badLiteral: '未知单词；JSON 只有 true、false、null',
      unexpectedEnd: '输入提前结束（有括号或引号没有闭合）',
      extraData: 'JSON 值结束后还有内容',
      unexpectedChar: '意外的字符 {ch}',
    },
  },
  ja: {
    empty: "JSON を入力すると draft-07 スキーマを生成します。",
    tips: {
      "input": "サンプル JSON を編集するか自分のデータを入力します。入力の変更ごとに draft-07 JSON Schema を即座に生成します。配列は全要素をマージし、すべてのサンプルオブジェクトに null 以外の値であるキーを必須にします。",
      "clear": "入力、生成したスキーマ、エラーメッセージを消去します。ツール内の Ctrl/⌘+L でも消去し、JSON 入力にフォーカスを戻します。",
      "copy": "生成したスキーマ全文をコピーします。出力は読み取り専用です。エディターに貼り付けて制約や必須フィールドを調整してください。空の出力はコピーしません。"
    },
    inputJson: 'JSON 入力', clear: 'クリア', copy: 'コピー', copied: 'コピー済み！', copyFailed: 'コピーに失敗しました。出力を手動でコピーしてください。', invalidJson: '無効な JSON',
    msgTooDeep: 'JSON の入れ子が深すぎるため、このブラウザではスキーマを生成できません（コールスタック不足）。何も生成していません。',
    errJson: '有効な JSON ではありません。',
    errJsonAt: '有効な JSON ではありません：{line} 行 {col} 列目、{reason}。',
    jsonParse: {
      empty: '入力が空です',
      trailingComma: '閉じかっこの前に余分なカンマがあります',
      comment: 'JSON にコメントは書けません',
      singleQuote: 'JSON の文字列とプロパティ名はダブルクォート（"）で囲みます',
      smartQuote: '{ch} は全角の引用符です。半角のダブルクォート（"）を使ってください',
      fullWidth: '全角文字 {ch} があります。JSON の記号と空白は半角です',
      unquotedKey: 'プロパティ名はダブルクォートで囲みます',
      missingComma: '値と値の間にカンマがありません',
      missingColon: 'プロパティ名の後にコロンがありません',
      unterminatedString: '文字列が閉じていません',
      controlChar: '文字列の中に改行やタブがそのまま入っています。\\n や \\t と書きます',
      badEscape: '文字列のエスケープが正しくありません',
      badNumber: '数値の書き方が正しくありません（JSON では先頭の 0、「+」、「.5」、NaN、Infinity は使えません）',
      badLiteral: '不明な語です。JSON にあるのは true、false、null だけです',
      unexpectedEnd: '入力が途中で終わっています（かっこか引用符が閉じていません）',
      extraData: 'JSON の値の後に余分なデータがあります',
      unexpectedChar: '予期しない文字 {ch}',
    },
  },
  ko: {
    empty: "JSON을 입력하면 draft-07 스키마를 생성합니다.",
    tips: {
      "input": "샘플 JSON을 수정하거나 데이터를 입력하세요. 입력이 바뀔 때마다 draft-07 JSON Schema를 즉시 생성합니다. 배열은 모든 요소를 병합하며 모든 샘플 객체에 null이 아닌 값으로 있는 키를 필수로 지정합니다.",
      "clear": "입력, 생성된 스키마, 오류 메시지를 지웁니다. 도구 안에서 Ctrl/⌘+L로도 지우고 JSON 입력으로 포커스를 돌립니다.",
      "copy": "생성된 스키마 전체를 복사합니다. 출력은 읽기 전용입니다. 편집기에 붙여넣어 제약 조건이나 필수 필드를 조정하세요. 빈 출력은 복사하지 않습니다."
    },
    inputJson: 'JSON 입력', clear: '지우기', copy: '복사', copied: '복사됨!', copyFailed: '복사하지 못했습니다. 출력을 직접 복사하세요.', invalidJson: '유효하지 않은 JSON',
    msgTooDeep: 'JSON 중첩이 너무 깊어 이 브라우저에서 스키마를 생성할 수 없습니다(호출 스택 부족). 아무것도 생성하지 않았습니다.',
    errJson: '올바른 JSON이 아닙니다.',
    errJsonAt: '올바른 JSON이 아닙니다: {line}행 {col}열, {reason}.',
    jsonParse: {
      empty: '입력이 비어 있습니다',
      trailingComma: '닫는 괄호 앞에 쉼표가 남아 있습니다',
      comment: 'JSON에는 주석을 쓸 수 없습니다',
      singleQuote: 'JSON 문자열과 속성 이름은 큰따옴표(")로 감쌉니다',
      smartQuote: '{ch}는 둥근 따옴표입니다. 곧은 큰따옴표(")를 쓰세요',
      fullWidth: '전각 문자 {ch}가 있습니다. JSON의 기호와 공백은 반각이어야 합니다',
      unquotedKey: '속성 이름은 큰따옴표로 감싸야 합니다',
      missingComma: '값 사이에 쉼표가 없습니다',
      missingColon: '속성 이름 뒤에 콜론이 없습니다',
      unterminatedString: '문자열이 닫히지 않았습니다',
      controlChar: '문자열 안에 줄바꿈이나 탭이 그대로 있습니다. \\n 또는 \\t로 쓰세요',
      badEscape: '문자열의 이스케이프가 잘못되었습니다',
      badNumber: '숫자 형식이 잘못되었습니다(JSON에서는 앞자리 0, "+", ".5", NaN, Infinity를 쓸 수 없습니다)',
      badLiteral: '알 수 없는 단어입니다. JSON에는 true, false, null만 있습니다',
      unexpectedEnd: '입력이 중간에 끝났습니다(괄호나 따옴표가 닫히지 않았습니다)',
      extraData: 'JSON 값이 끝난 뒤에 데이터가 더 있습니다',
      unexpectedChar: '예상하지 못한 문자 {ch}',
    },
  }
};
const L = STRINGS[lang];
const CLIENT_T = {
  copy: L.copy,
  copied: L.copied,
  copyFailed: L.copyFailed,
  invalidJson: L.invalidJson,
  msgTooDeep: L.msgTooDeep,
  errJson: L.errJson,
  errJsonAt: L.errJsonAt,
  jsonParse: L.jsonParse,
};
---

<div class="jjs-wrap" data-strings={JSON.stringify(CLIENT_T)} data-empty="true">
  <div class="jjs-actions">
    <div class="jjs-control-label">
      <button id="jjs-clear" class="btn-ghost" type="button">{L.clear}</button>
      <Toggletip id="jjs-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip>
    </div>
  </div>
  <div class="jjs-status" aria-live="polite">
    <div id="jjs-error" class="jjs-error" hidden></div>
  </div>
  <div class="jjs-panes zt-io">
    <div class="jjs-pane zt-io-pane">
      <div class="jjs-pane-header">
        <div class="jjs-control-label">
          <label for="jjs-input">{L.inputJson}</label>
          <Toggletip id="jjs-tip-input" lang={lang} about={L.inputJson}>{L.tips.input}</Toggletip>
        </div>
      </div>
      <textarea id="jjs-input" class="zt-io-fill" spellcheck="false" placeholder='{"name":"Alice","age":30,"active":true}'></textarea>
    </div>
    <div class="jjs-pane jjs-output-pane zt-io-pane">
      <div class="jjs-pane-header">
        <span id="jjs-output-label">JSON Schema (draft-07)</span>
        <div class="jjs-control-label">
          <button id="jjs-copy" class="btn-ghost" type="button">{L.copy}</button>
          <Toggletip id="jjs-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip>
        </div>
      </div>
      <p class="jjs-empty zt-io-fill">{L.empty}</p>
      <textarea id="jjs-output" class="jjs-output zt-io-fill" tabindex="0" aria-labelledby="jjs-output-label" spellcheck="false" readonly></textarea>
    </div>
  </div>

  <script is:inline>
    (function () {
      var t = JSON.parse(document.querySelector('.jjs-wrap').dataset.strings);

      var inputEl  = document.getElementById('jjs-input');
      var outputEl = document.getElementById('jjs-output');
      var errorEl  = document.getElementById('jjs-error');
      var clearBtn = document.getElementById('jjs-clear');
      var copyBtn  = document.getElementById('jjs-copy');
      var wrap = document.querySelector('.jjs-wrap');
      var copyRevision = 0;
      var copyTimer = null;
      var copyFailure = false;

      function clearError() {
        copyFailure = false;
        errorEl.textContent = '';
        errorEl.hidden = true;
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = t.copy;
        if (copyFailure) clearError();
      }

      /* ── engine:start ── */
      function kindOf(value) {
        if (value === null) return 'null';
        if (Array.isArray(value)) return 'array';
        var t = typeof value;
        if (t === 'number') return Number.isInteger(value) ? 'integer' : 'number';
        return t;
      }

      // One schema that accepts every value in the list: a type (or type list) plus the
      // object and array keywords, which only apply to instances of that type.
      function inferFromValues(values) {
        var types = [];
        var objects = [];
        var arrays = [];
        for (var i = 0; i < values.length; i++) {
          var kind = kindOf(values[i]);
          if (kind === 'object') objects.push(values[i]);
          if (kind === 'array') arrays.push(values[i]);
          if (types.indexOf(kind) === -1) types.push(kind);
        }
        // every integer is also a number
        var intIdx = types.indexOf('integer');
        var numIdx = types.indexOf('number');
        if (intIdx !== -1 && numIdx !== -1) {
          types.splice(Math.max(intIdx, numIdx), 1);
          types[Math.min(intIdx, numIdx)] = 'number';
        }

        var schema = { type: types.length === 1 ? types[0] : types };

        if (objects.length > 0) {
          var keys = [];
          var props = {};
          objects.forEach(function (obj) {
            Object.keys(obj).forEach(function (k) {
              if (keys.indexOf(k) === -1) keys.push(k);
            });
          });
          var required = [];
          keys.forEach(function (k) {
            var keyValues = [];
            var inAll = true;
            objects.forEach(function (obj) {
              if (Object.prototype.hasOwnProperty.call(obj, k)) {
                keyValues.push(obj[k]);
                if (obj[k] === null) inAll = false;
              } else {
                inAll = false;
              }
            });
            // defineProperty: a plain assignment to props.__proto__ would set the prototype
            Object.defineProperty(props, k, { value: inferFromValues(keyValues), enumerable: true, writable: true, configurable: true });
            if (inAll) required.push(k);
          });
          schema.properties = props;
          if (required.length > 0) schema.required = required;
        }

        if (arrays.length > 0) {
          var items = [];
          arrays.forEach(function (arr) { items = items.concat(arr); });
          schema.items = items.length > 0 ? inferFromValues(items) : {};
        }

        return schema;
      }

      function inferSchema(value) {
        return inferFromValues([value]);
      }
      /* ── engine:end ── */

      /* ── json-reason:start ── */
      // Why the input is not JSON, in the page language, without the browser's English message.
      // lineCol and jsonSyntaxError are copied verbatim from json-formatter-engine.js (the test
      // compares the source); jsonSyntaxError runs only after JSON.parse has failed. The tool parses
      // the trimmed text, so the leading whitespace is added back to count lines from the text box.
      function lineCol(text, offset) {
        var line = 1, last = -1;
        for (var i = text.indexOf('\n'); i !== -1 && i < offset; i = text.indexOf('\n', i + 1)) { line++; last = i; }
        return { line: line, col: offset - last };
      }
      function jsonSyntaxError(text) {
        var i = 0, n = text.length;
        var SMART = '\u201c\u201d\u2018\u2019\u300c\u300d';
        var WIDE = '\u3000\uff1a\uff0c\uff5b\uff5d\uff3b\uff3d\uff02';
        function fail(code, at, ch) { throw { jsonErr: true, code: code, offset: at === undefined ? i : at, ch: ch }; }
        function special(c) {
          if (SMART.indexOf(c) >= 0) fail('smartQuote', i, c);
          if (WIDE.indexOf(c) >= 0) fail('fullWidth', i, c);
        }
        function ws() {
          while (i < n) {
            var c = text[i];
            if (c === ' ' || c === '\t' || c === '\n' || c === '\r') { i++; continue; }
            if (c === '/' && (text[i + 1] === '/' || text[i + 1] === '*')) fail('comment');
            if (c === '#') fail('comment');
            break;
          }
        }
        var NUM = /-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?/y;
        var WORD = /[A-Za-z_$][\w$]*/y;
        function str() {
          var s = i; i++;
          while (i < n) {
            var c = text.charCodeAt(i);
            if (c === 34) { i++; return; }
            if (c === 92) {
              var e = text[i + 1];
              if (e !== undefined && '"\\/bfnrt'.indexOf(e) >= 0) { i += 2; continue; }
              if (e === 'u' && /^[0-9a-fA-F]{4}$/.test(text.substr(i + 2, 4))) { i += 6; continue; }
              fail('badEscape');
            }
            if (c < 0x20) fail('controlChar');
            i++;
          }
          fail('unterminatedString', s);
        }
        function num() {
          NUM.lastIndex = i;
          var m = NUM.exec(text);
          if (!m || m[0] === '-' || m[0] === '') fail('badNumber');
          i += m[0].length;
          if (i < n && /[0-9.eE]/.test(text[i])) fail('badNumber');
        }
        function startsValue(c) { return c === '{' || c === '[' || c === '"' || c === '-' || (c >= '0' && c <= '9') || c === 't' || c === 'f' || c === 'n'; }
        function value(depth) {
          if (depth > 3000) fail('unexpectedChar');
          ws();
          if (i >= n) fail('unexpectedEnd');
          var c = text[i];
          if (c === '{') return obj(depth);
          if (c === '[') return arr(depth);
          if (c === '"') return str();
          if (c === "'") fail('singleQuote');
          special(c);
          if (c === '-' || (c >= '0' && c <= '9')) return num();
          if (c === '+' || c === '.') fail('badNumber');
          WORD.lastIndex = i;
          var m = WORD.exec(text);
          if (m) {
            if (m[0] === 'true' || m[0] === 'false' || m[0] === 'null') { i += m[0].length; return; }
            if (m[0] === 'NaN' || m[0] === 'Infinity') fail('badNumber');
            fail('badLiteral');
          }
          fail('unexpectedChar', i, c);
        }
        function obj(depth) {
          i++; ws();
          if (text[i] === '}') { i++; return; }
          for (;;) {
            ws();
            if (i >= n) fail('unexpectedEnd');
            var c = text[i];
            if (c === "'") fail('singleQuote');
            special(c);
            if (c !== '"') { if (/[A-Za-z_$0-9]/.test(c)) fail('unquotedKey'); fail('unexpectedChar', i, c); }
            str(); ws();
            if (i >= n) fail('unexpectedEnd');
            if (text[i] !== ':') { special(text[i]); fail('missingColon'); }
            i++;
            value(depth + 1); ws();
            if (i >= n) fail('unexpectedEnd');
            c = text[i];
            if (c === ',') { var comma = i; i++; ws(); if (text[i] === '}') fail('trailingComma', comma); continue; }
            if (c === '}') { i++; return; }
            special(c);
            if (c === '"' || /[A-Za-z_$]/.test(c)) fail('missingComma');
            fail('unexpectedChar', i, c);
          }
        }
        function arr(depth) {
          i++; ws();
          if (text[i] === ']') { i++; return; }
          for (;;) {
            value(depth + 1); ws();
            if (i >= n) fail('unexpectedEnd');
            var c = text[i];
            if (c === ',') { var comma = i; i++; ws(); if (text[i] === ']') fail('trailingComma', comma); continue; }
            if (c === ']') { i++; return; }
            special(c);
            if (startsValue(c)) fail('missingComma');
            fail('unexpectedChar', i, c);
          }
        }
        try {
          ws();
          if (i >= n) return { code: 'empty', offset: 0 };
          value(0);
          ws();
          if (i < n) fail('extraData');
          return null;
        } catch (e) {
          if (e && e.jsonErr) return { code: e.code, offset: e.offset, ch: e.ch };
          throw e;
        }
      }
      function jsonErrorText(value) {
        var e = jsonSyntaxError(value.trim());
        if (!e) return t.errJson;
        var offset = value.length - value.trimStart().length + e.offset;
        var at = lineCol(value, offset);
        // trim() also removes a leading byte order mark (U+FEFF); it is invisible in the text box, so it is not a column.
        at.col -= (value.slice(offset - at.col + 1, offset).match(/\uFEFF/g) || []).length;
        var reason = String(t.jsonParse[e.code] || t.jsonParse.unexpectedChar || e.code).replace('{ch}', function () { return e.ch == null ? '' : e.ch; });
        return t.errJsonAt.replace(/\{(line|col|reason)\}/g, function (m, k) { return k === 'line' ? String(at.line) : k === 'col' ? String(at.col) : reason; });
      }
      /* ── json-reason:end ── */

      // A stack overflow while walking very deep JSON: RangeError "Maximum call stack size exceeded" in Chrome
      // and Safari, InternalError "too much recursion" in Firefox (MDN: "Too much recursion").
      function isTooDeep(e) {
        return !!e && (e.name === 'RangeError' || e.name === 'InternalError') && /call stack|recursion/i.test(String(e.message));
      }

      function convert() {
        invalidateCopy();
        clearError();
        var raw = inputEl.value.trim();
        if (!raw) {
          outputEl.value = '';
          wrap.dataset.empty = 'true';
          return;
        }
        try {
          var parsed = JSON.parse(raw);
          var schema = Object.assign(
            { '$schema': 'http://json-schema.org/draft-07/schema#' },
            inferSchema(parsed)
          );
          outputEl.value = JSON.stringify(schema, null, 2);
        } catch (e) {
          outputEl.value = '';
          errorEl.textContent = isTooDeep(e) ? t.msgTooDeep : e && e.name === 'SyntaxError' ? jsonErrorText(inputEl.value) : t.invalidJson + ': ' + e.message;
          errorEl.hidden = false;
        }
        wrap.dataset.empty = String(!outputEl.value);
      }

      inputEl.addEventListener('input', convert);
      /* Analytics: one event per committed change (the textarea change event), not on load or per keystroke. */
      inputEl.addEventListener('change', function () {
        if (outputEl.value) window.trackTool && window.trackTool('json-to-json-schema', 'convert');
      });

      clearBtn.addEventListener('click', function () {
        invalidateCopy();
        inputEl.focus();
        inputEl.value = '';
        outputEl.value = '';
        wrap.dataset.empty = 'true';
        clearError();
      });

      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
          e.preventDefault();
          clearBtn.click();
        }
      });

      copyBtn.addEventListener('click', function () {
        var text = outputEl.value;
        if (!text) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = t.copy;
        function failed() {
          if (revision !== copyRevision) return;
          errorEl.textContent = t.copyFailed;
          errorEl.hidden = false;
          copyFailure = true;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            if (copyFailure) clearError();
            copyBtn.textContent = t.copied;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = t.copy;
            }, 1500);
            window.trackTool && window.trackTool('json-to-json-schema', 'copy');
          }, failed);
        } catch (e) { failed(); }
      });

      // seed example
      inputEl.value = JSON.stringify({
        "name": "Alice",
        "age": 30,
        "active": true,
        "scores": [95, 87, 92],
        "address": {
          "street": "123 Main St",
          "city": "Wonderland"
        }
      }, null, 2);
      convert();
    })();
  </script>
</div>

