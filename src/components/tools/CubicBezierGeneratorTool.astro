---
import Toggletip from '../Toggletip.astro';
// CubicBezierGeneratorTool — Visual editor for CSS cubic-bezier() easing curves.
// Drag two control points on an SVG canvas, preview a live animation, copy CSS / SCSS / Tailwind.
// Pure browser-side: SVG + Pointer Events + requestAnimationFrame. Zero dependencies.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const labels = {
  en: {
    presets: 'Presets',
    curveLabel: 'Curve Editor',
    previewLabel: 'Animation Preview',
    p1: 'P1',
    p2: 'P2',
    duration: 'Duration',
    ms: 'ms',
    play: 'Play',
    pause: 'Pause',
    loop: 'Loop',
    output: 'Output',
    formatCss: 'CSS',
    formatScss: 'SCSS',
    formatTailwind: 'Tailwind',
    copy: 'Copy',
    copied: 'Copied!',
    copyFailed: 'Copy failed. Select the output and copy it manually.',
    reset: 'Reset to ease-in-out',
    rangeWarn: 'P1.x / P2.x must be inside 0–1; clamped automatically.',
    rangeWarnY: 'This editor limits P1.y / P2.y to −2–2; clamped automatically.',
    presetLinear: 'Linear',
    presetEase: 'Ease',
    presetEaseIn: 'Ease-In',
    presetEaseOut: 'Ease-Out',
    presetEaseInOut: 'Ease-In-Out',
    presetM2Std: 'Material 2 Std',
    presetM2Decel: 'Material 2 Decel',
    presetM2Accel: 'Material 2 Accel',
    presetM3Std: 'Material 3 Std',
    presetCaDefault: 'Core Animation default',
    presetTwInOut: 'Tailwind In-Out',
    presetBack: 'Back (overshoot)',
    dragHint: 'Drag the two filled circles. Numbers update live.',
  },
  zh: {
    presets: '预设',
    curveLabel: '曲线编辑器',
    previewLabel: '动画预览',
    p1: 'P1',
    p2: 'P2',
    duration: '时长',
    ms: '毫秒',
    play: '播放',
    pause: '暂停',
    loop: '循环',
    output: '输出',
    formatCss: 'CSS',
    formatScss: 'SCSS',
    formatTailwind: 'Tailwind',
    copy: '复制',
    copied: '已复制！',
    copyFailed: '复制失败，请选中输出内容后手动复制。',
    reset: '重置为 ease-in-out',
    rangeWarn: 'P1.x / P2.x 必须在 0-1 区间内，已自动夹紧。',
    rangeWarnY: '本编辑器把 P1.y / P2.y 限制在 −2 到 2 之间，已自动夹紧。',
    presetLinear: '线性',
    presetEase: 'Ease',
    presetEaseIn: 'Ease-In',
    presetEaseOut: 'Ease-Out',
    presetEaseInOut: 'Ease-In-Out',
    presetM2Std: 'Material 2 标准',
    presetM2Decel: 'Material 2 减速',
    presetM2Accel: 'Material 2 加速',
    presetM3Std: 'Material 3 标准',
    presetCaDefault: 'Core Animation 默认',
    presetTwInOut: 'Tailwind In-Out',
    presetBack: 'Back（回弹）',
    dragHint: '拖拽两个实心圆点，数值实时更新。',
  },
  ja: {
    presets: 'プリセット',
    curveLabel: 'カーブエディタ',
    previewLabel: 'アニメーションプレビュー',
    p1: 'P1',
    p2: 'P2',
    duration: '時間',
    ms: 'ミリ秒',
    play: '再生',
    pause: '一時停止',
    loop: 'ループ',
    output: '出力',
    formatCss: 'CSS',
    formatScss: 'SCSS',
    formatTailwind: 'Tailwind',
    copy: 'コピー',
    copied: 'コピー済み！',
    copyFailed: 'コピーに失敗しました。出力を選択して手動でコピーしてください。',
    reset: 'ease-in-out にリセット',
    rangeWarn: 'P1.x / P2.x は 0-1 の範囲内である必要があります。自動的にクランプしました。',
    rangeWarnY: 'このエディタでは P1.y / P2.y を −2〜2 に制限しています。自動的にクランプしました。',
    presetLinear: 'Linear',
    presetEase: 'Ease',
    presetEaseIn: 'Ease-In',
    presetEaseOut: 'Ease-Out',
    presetEaseInOut: 'Ease-In-Out',
    presetM2Std: 'Material 2 標準',
    presetM2Decel: 'Material 2 減速',
    presetM2Accel: 'Material 2 加速',
    presetM3Std: 'Material 3 標準',
    presetCaDefault: 'Core Animation 既定',
    presetTwInOut: 'Tailwind In-Out',
    presetBack: 'Back（オーバーシュート）',
    dragHint: '塗りつぶしの 2 つの円をドラッグ。値はリアルタイムで更新。',
  },
  ko: {
    presets: '프리셋',
    curveLabel: '곡선 편집기',
    previewLabel: '애니메이션 미리보기',
    p1: 'P1',
    p2: 'P2',
    duration: '지속 시간',
    ms: '밀리초',
    play: '재생',
    pause: '일시정지',
    loop: '반복',
    output: '출력',
    formatCss: 'CSS',
    formatScss: 'SCSS',
    formatTailwind: 'Tailwind',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사하지 못했습니다. 출력을 선택하여 직접 복사하세요.',
    reset: 'ease-in-out으로 재설정',
    rangeWarn: 'P1.x / P2.x는 반드시 0-1 범위 안에 있어야 합니다. 자동으로 보정되었습니다.',
    rangeWarnY: '이 편집기는 P1.y / P2.y를 −2~2로 제한합니다. 자동으로 보정되었습니다.',
    presetLinear: 'Linear',
    presetEase: 'Ease',
    presetEaseIn: 'Ease-In',
    presetEaseOut: 'Ease-Out',
    presetEaseInOut: 'Ease-In-Out',
    presetM2Std: 'Material 2 표준',
    presetM2Decel: 'Material 2 감속',
    presetM2Accel: 'Material 2 가속',
    presetM3Std: 'Material 3 표준',
    presetCaDefault: 'Core Animation 기본',
    presetTwInOut: 'Tailwind In-Out',
    presetBack: 'Back (오버슈트)',
    dragHint: '두 개의 채워진 원을 드래그하세요. 숫자가 실시간 갱신됩니다.',
  },
};

const STRINGS = {
  "en": {
    "tips": {
      "presets": "Choose one of 12 presets, including the separate Material 2 and Material 3 curves. Presets replace the four control-point values.",
      "points": "X is clamped to 0–1; Y is clamped to −2–2 for anticipation and overshoot. Fields and copied values keep up to three decimals; finer values from dragging are rounded to three. A value typed outside these ranges is clamped and a message appears.",
      "curve": "Drag either filled circle to edit the curve. The diagonal is linear timing. Scroll this preview to reach control points above or below the square.",
      "playback": "Preview duration is limited to 100–10,000 ms. Play starts from the beginning; Pause stops the preview. Loop repeats it. Duration and Loop do not appear in the generated timing-function code.",
      "format": "Choose a CSS timing-function declaration, an SCSS variable or a Tailwind configuration snippet, then copy the visible output. These formats use the same control points.",
      "reset": "Reset restores ease-in-out (0.42, 0, 0.58, 1), 1500 ms and CSS output, stops playback and clears saved settings on this device. Ctrl/⌘+L does the same while a tool control has focus. Loop stays unchanged."
    }
  },
  "zh": {
    "tips": {
      "presets": "选择 12 个预设之一，其中 Material 2 与 Material 3 使用各自的曲线。点击预设会替换四个控制点数值。",
      "points": "X 会限制到 0–1，Y 会限制到 −2–2，用于回拉和过冲。数字框与复制结果最多保留三位小数，拖动得到的更细数值按三位四舍五入。输入超出范围时会被夹紧并显示提示。",
      "curve": "拖动任一实心圆点编辑曲线。对角线代表线性时间关系。上下滚动预览，可找到方框上方或下方的控制点。",
      "playback": "预览时长限制为 100–10,000 毫秒。播放从头开始，暂停会停止预览，循环会重复播放。时长和循环选项不会写入生成的缓动函数代码。",
      "format": "选择 CSS 缓动函数声明、SCSS 变量或 Tailwind 配置片段，再复制当前输出。三种格式使用相同的控制点。",
      "reset": "重置恢复 ease-in-out（0.42, 0, 0.58, 1）、1500 毫秒和 CSS 输出，停止播放并清除当前设备保存的设置。工具内控件获得焦点时，Ctrl/⌘+L 执行同样操作。循环选项保持不变。"
    }
  },
  "ja": {
    "tips": {
      "presets": "12種類から選べます。Material 2とMaterial 3はそれぞれ別の曲線です。選ぶと制御点の4つの値を置き換えます。",
      "points": "Xは0〜1、Yは−2〜2に制限され、Yで逆方向の動きや行き過ぎを作れます。数値欄とコピーは小数第3位まで保持し、ドラッグで生じたそれより細かい値は第3位に丸めます。範囲外の値を入力すると制限内に収め、メッセージを表示します。",
      "curve": "塗りつぶした円をドラッグして曲線を編集します。対角線はlinearです。正方形の上下にある制御点へは、プレビューをスクロールして移動できます。",
      "playback": "時間は100〜10,000ミリ秒です。再生は最初から始まり、一時停止で止まります。ループで繰り返します。時間とループは生成されるタイミング関数のコードには含まれません。",
      "format": "CSSのタイミング関数宣言、SCSS変数、Tailwind設定から選び、表示中の出力をコピーします。制御点はどの形式も同じです。",
      "reset": "リセットはease-in-out（0.42, 0, 0.58, 1）、1500ミリ秒、CSS出力に戻し、再生を止め、端末に保存した設定を消します。ツール内にフォーカスがある場合はCtrl/⌘+Lも同じ操作です。ループは変わりません。"
    }
  },
  "ko": {
    "tips": {
      "presets": "12개 프리셋 중에서 선택하세요. Material 2와 Material 3는 서로 다른 곡선입니다. 선택하면 네 제어점 값이 바뀝니다.",
      "points": "X는 0~1, Y는 −2~2로 제한됩니다. Y로 역방향 움직임과 오버슈트를 만드세요. 숫자 입력과 복사 값은 소수 셋째 자리까지 유지하며, 드래그로 생긴 더 세밀한 값은 셋째 자리로 반올림합니다. 범위를 벗어난 값을 입력하면 범위 안으로 보정하고 메시지를 표시합니다.",
      "curve": "채워진 원을 끌어 곡선을 편집하세요. 대각선은 linear입니다. 정사각형 위아래의 제어점은 미리보기를 스크롤하여 찾을 수 있습니다.",
      "playback": "미리보기 시간은 100~10,000밀리초입니다. 재생은 처음부터 시작하고 일시정지는 멈춥니다. 반복을 켜면 다시 재생합니다. 시간과 반복은 생성된 타이밍 함수 코드에 포함되지 않습니다.",
      "format": "CSS 타이밍 함수 선언, SCSS 변수 또는 Tailwind 설정을 선택한 뒤 현재 출력을 복사하세요. 세 형식은 같은 제어점을 사용합니다.",
      "reset": "초기화는 ease-in-out(0.42, 0, 0.58, 1), 1500밀리초, CSS 출력으로 복원하고 재생을 멈추고 기기에 저장된 설정을 지웁니다. 도구 안에 초점이 있을 때 Ctrl/⌘+L도 같은 동작을 합니다. 반복 선택은 유지됩니다."
    }
  }
};
const L = labels[lang] ?? labels['en'];
const TIPS = STRINGS[lang].tips;
---

<div
  class="cbg-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-play={L.play}
  data-pause={L.pause}
  data-warn={L.rangeWarn}
  data-warn-y={L.rangeWarnY}
>
  <div class="cbg-layout">
    <div class="cbg-rail zt-rail">
  <div class="cbg-presets">
    <div class="cbg-label-row"><span class="cbg-section-label">{L.presets}</span><Toggletip id="cbg-tip-presets" lang={lang} about={L.presets}>{TIPS.presets}</Toggletip></div>
    <div class="cbg-preset-btns">
      <button class="cbg-preset" data-p="0,0,1,1" type="button">{L.presetLinear}</button>
      <button class="cbg-preset" data-p="0.25,0.1,0.25,1" type="button">{L.presetEase}</button>
      <button class="cbg-preset" data-p="0.42,0,1,1" type="button">{L.presetEaseIn}</button>
      <button class="cbg-preset" data-p="0,0,0.58,1" type="button">{L.presetEaseOut}</button>
      <button class="cbg-preset" data-p="0.42,0,0.58,1" type="button">{L.presetEaseInOut}</button>
      <button class="cbg-preset" data-p="0.4,0,0.2,1" type="button">{L.presetM2Std}</button>
      <button class="cbg-preset" data-p="0,0,0.2,1" type="button">{L.presetM2Decel}</button>
      <button class="cbg-preset" data-p="0.4,0,1,1" type="button">{L.presetM2Accel}</button>
      <button class="cbg-preset" data-p="0.2,0,0,1" type="button">{L.presetM3Std}</button>
      <button class="cbg-preset" data-p="0.25,0.1,0.25,1" type="button">{L.presetCaDefault}</button>
      <button class="cbg-preset" data-p="0.4,0,0.2,1" type="button">{L.presetTwInOut}</button>
      <button class="cbg-preset" data-p="0.68,-0.55,0.265,1.55" type="button">{L.presetBack}</button>
    </div>
  </div>
      <div class="cbg-controls">
  <div class="cbg-numbers">
    <div class="cbg-num-group">
      <div class="cbg-label-row"><span class="cbg-section-label">{L.p1}</span><Toggletip id="cbg-tip-p1" lang={lang} about={L.p1}>{TIPS.points}</Toggletip></div>
      <div class="cbg-num-row">
        <label class="cbg-num-label">x<input id="cbg-p1x" class="tool-input cbg-num" type="number" step="0.01" min="0" max="1" value="0.42"/></label>
        <label class="cbg-num-label">y<input id="cbg-p1y" class="tool-input cbg-num" type="number" step="0.01" value="0"/></label>
      </div>
    </div>
    <div class="cbg-num-group">
      <div class="cbg-label-row"><span class="cbg-section-label">{L.p2}</span><Toggletip id="cbg-tip-p2" lang={lang} about={L.p2}>{TIPS.points}</Toggletip></div>
      <div class="cbg-num-row">
        <label class="cbg-num-label">x<input id="cbg-p2x" class="tool-input cbg-num" type="number" step="0.01" min="0" max="1" value="0.58"/></label>
        <label class="cbg-num-label">y<input id="cbg-p2y" class="tool-input cbg-num" type="number" step="0.01" value="1"/></label>
      </div>
    </div>
  </div>
        <div class="cbg-playback">
          <div class="cbg-label-row"><label class="tool-label cbg-duration-label" for="cbg-duration">{L.duration}</label><Toggletip id="cbg-tip-playback" lang={lang} about={L.previewLabel}>{TIPS.playback}</Toggletip></div>
          <div class="cbg-duration-row">
            <input id="cbg-duration" class="tool-input cbg-duration" type="number" min="100" max="10000" step="50" value="1500"/>
            <span class="cbg-unit">{L.ms}</span>
            <label class="cbg-loop-toggle"><input id="cbg-loop" type="checkbox" checked/><span>{L.loop}</span></label>
          </div>
          <div class="cbg-primary-row">
            <button id="cbg-play" class="btn-secondary cbg-play" type="button">{L.play}</button>
            <button id="cbg-copy" class="btn-copy cbg-copy" type="button">{L.copy}</button>
          </div>
          <div class="cbg-label-row"><button id="cbg-reset" class="btn-ghost cbg-reset" type="button">{L.reset}</button><Toggletip id="cbg-tip-reset" lang={lang} about={L.reset}>{TIPS.reset}</Toggletip></div>
        </div>
        <span id="cbg-status" class="tool-status none" role="status"></span>
      </div>
      <div class="cbg-output">
        <div class="cbg-label-row"><span class="cbg-section-label">{L.output}</span><Toggletip id="cbg-tip-format" lang={lang} about={L.output}>{TIPS.format}</Toggletip></div>
      <div class="cbg-format-tabs">
        <button class="cbg-format cbg-format--active" data-fmt="css" type="button">{L.formatCss}</button>
        <button class="cbg-format" data-fmt="scss" type="button">{L.formatScss}</button>
        <button class="cbg-format" data-fmt="tailwind" type="button">{L.formatTailwind}</button>
      </div>
        <pre class="cbg-output-pre" tabindex="0" role="region" aria-label={L.output}><code id="cbg-output-text">transition-timing-function: cubic-bezier(0.42, 0, 0.58, 1);</code></pre>
      </div>
    </div>
    <div class="cbg-main">
      <div class="cbg-card cbg-curve-card">
        <div class="cbg-card-head"><span class="cbg-section-label">{L.curveLabel}</span><Toggletip id="cbg-tip-curve" lang={lang} about={L.curveLabel}>{TIPS.curve}</Toggletip></div>
        <div class="cbg-canvas-wrap" tabindex="0" role="region" aria-label={L.curveLabel}>
          <div class="cbg-canvas-space">
        <svg id="cbg-canvas" class="cbg-canvas" viewBox="0 0 320 320" xmlns="http://www.w3.org/2000/svg" aria-label={L.curveLabel}>
          {/* Grid */}
          <g class="cbg-grid" stroke="currentColor" stroke-opacity="0.12" stroke-width="1">
            <line x1="0" y1="80" x2="320" y2="80"/>
            <line x1="0" y1="160" x2="320" y2="160"/>
            <line x1="0" y1="240" x2="320" y2="240"/>
            <line x1="80" y1="0" x2="80" y2="320"/>
            <line x1="160" y1="0" x2="160" y2="320"/>
            <line x1="240" y1="0" x2="240" y2="320"/>
          </g>
          {/* Diagonal reference */}
          <line x1="0" y1="320" x2="320" y2="0" class="cbg-diag" stroke="currentColor" stroke-opacity="0.18" stroke-dasharray="3 3"/>
          {/* Bezier curve */}
          <path id="cbg-curve" class="cbg-curve" d="" fill="none" stroke="currentColor" stroke-width="2.5"/>
          {/* Control lines */}
          <line id="cbg-line1" class="cbg-ctrl-line" x1="0" y1="320" x2="0" y2="0" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5"/>
          <line id="cbg-line2" class="cbg-ctrl-line" x1="320" y1="0" x2="320" y2="320" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5"/>
          {/* Anchor points (fixed) */}
          <circle cx="0" cy="320" r="4" class="cbg-anchor" fill="currentColor"/>
          <circle cx="320" cy="0" r="4" class="cbg-anchor" fill="currentColor"/>
          {/* Draggable handles */}
          <circle id="cbg-h1" class="cbg-handle" cx="0" cy="0" r="9"/>
          <circle id="cbg-h2" class="cbg-handle" cx="0" cy="0" r="9"/>
        </svg>
          </div>
        </div>
        <p class="cbg-hint">{L.dragHint}</p>
      </div>
      <div class="cbg-card cbg-animation-card">
        <div class="cbg-card-head"><span class="cbg-section-label">{L.previewLabel}</span></div>
        <div class="cbg-track"><div id="cbg-ball" class="cbg-ball" aria-hidden="true"></div></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    'use strict';

    var SLUG = 'cubic-bezier-generator';
    var SIZE = 320;
    var DEFAULT = { p1x: 0.42, p1y: 0, p2x: 0.58, p2y: 1, duration: 1500, format: 'css' };

    var wrap = document.querySelector('.cbg-wrap');
    if (!wrap) return;

    var copyText = wrap.dataset.copy;
    var copiedText = wrap.dataset.copied;
    var copyFailedText = wrap.dataset.copyFailed;
    var playText = wrap.dataset.play;
    var pauseText = wrap.dataset.pause;
    var warnText = wrap.dataset.warn;
    var warnYText = wrap.dataset.warnY;

    var $ = function(id) { return document.getElementById(id); };
    var canvas = $('cbg-canvas');
    var curve = $('cbg-curve');
    var line1 = $('cbg-line1');
    var line2 = $('cbg-line2');
    var h1 = $('cbg-h1');
    var h2 = $('cbg-h2');
    var ball = $('cbg-ball');
    var p1xInput = $('cbg-p1x');
    var p1yInput = $('cbg-p1y');
    var p2xInput = $('cbg-p2x');
    var p2yInput = $('cbg-p2y');
    var durationInput = $('cbg-duration');
    var playBtn = $('cbg-play');
    var loopChk = $('cbg-loop');
    var outputText = $('cbg-output-text');
    var copyBtn = $('cbg-copy');
    var resetBtn = $('cbg-reset');
    var statusEl = $('cbg-status');
    var presetBtns = wrap.querySelectorAll('.cbg-preset');
    var formatBtns = wrap.querySelectorAll('.cbg-format');

    // ── State ──────────────────────────────────────────────────────────────
    var state = Object.assign({}, DEFAULT);
    try {
