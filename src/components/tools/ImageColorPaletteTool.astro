          ['mouseleave', 'focusout'].forEach(function (ev) { li.addEventListener(ev, function () { highlight(0); }); });
          paletteEl.appendChild(li);
        });
      }
      function renderMarkers() {
        markers.textContent = '';
        shown.forEach(function (c, i) {
          var p = posToXY(pickPos(c, state.pick), img.sw, img.sh);
          var m = el('span', 'icp-marker', String(i + 1));
          m.setAttribute('data-n', String(i + 1));
          m.style.left = (p.x * 100).toFixed(3) + '%';
          m.style.top = (p.y * 100).toFixed(3) + '%';
          var rgb = pickRgb(c, state.pick);
          m.style.backgroundColor = toHex(rgb);
          m.style.color = textOn(rgb);
          markers.appendChild(m);
        });
      }
      function highlight(n) {
        markers.querySelectorAll('.icp-marker').forEach(function (m) {
          m.classList.toggle('is-active', m.getAttribute('data-n') === String(n));
        });
      }
      function entries() {
        return shown.map(function (c) { return { rgb: pickRgb(c, state.pick), share: c.share }; });
      }
      function renderCode() {
        codeOut.textContent = shown.length ? exportCode(entries(), state.code, state.values) : '';
      }

      // ── downloads ──
      function download(bytes, type, fileName) {
        var a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([bytes], { type: type }));
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(function () { URL.revokeObjectURL(a.href); }, 10000);
        setStatus(fill(t.saved, { name: fileName }), 'ok');
      }
      $('icp-gpl').addEventListener('click', function () {
        if (!shown.length) return;
        var name = paletteName(img && img.name);
        download(gplFile(entries(), name), 'text/plain;charset=utf-8', name + '.gpl');
        track('export_gpl');
      });
      $('icp-ase').addEventListener('click', function () {
        if (!shown.length) return;
        var name = paletteName(img && img.name);
        download(aseFile(entries(), name), 'application/octet-stream', name + '.ase');
        track('export_ase');
      });
      $('icp-copy-code').addEventListener('click', function () {
        if (!codeOut.textContent) return;
        var seq = statusSeq, format = t['code_' + state.code];
        copyText(codeOut.textContent).then(function (ok) {
          if (seq !== statusSeq) return;
          setStatus(ok ? fill(t.copiedCode, { format: format }) : t.copyFailed, ok ? 'ok' : 'error');
          if (ok) track('copy_code');
        });
      });

      // ── controls ──
      kInput.addEventListener('input', function () {
        state.k = Number(kInput.value);
        kOut.textContent = kInput.value;
        recompute();
      });
      kInput.addEventListener('change', savePrefs);
      sortSel.addEventListener('change', function () { state.sort = sortSel.value; savePrefs(); if (result) render(); });
      pickSel.addEventListener('change', function () { state.pick = pickSel.value; savePrefs(); if (result) render(); });
      vividCb.addEventListener('change', function () { state.vivid = vividCb.checked; savePrefs(); recompute(); });
      whiteCb.addEventListener('change', function () { state.ignoreWhite = whiteCb.checked; savePrefs(); recompute(); });
      blackCb.addEventListener('change', function () { state.ignoreBlack = blackCb.checked; savePrefs(); recompute(); });
      codeSel.addEventListener('change', function () { state.code = codeSel.value; savePrefs(); renderCode(); });
      valuesSel.addEventListener('change', function () { state.values = valuesSel.value; savePrefs(); renderCode(); });

      // ── input: button, drop anywhere on the tool, paste anywhere on the page ──
      openBtn.addEventListener('click', function () { fileInput.click(); });
      drop.addEventListener('click', function (e) { if (e.target === drop || e.target.closest('.icp-hint')) fileInput.click(); });
      fileInput.addEventListener('change', function () { openFile(fileInput.files && fileInput.files[0]); fileInput.value = ''; });
      sampleBtn.addEventListener('click', function () {
        loadGen++;
        var c = sampleCanvas();
        setImage(c, c.width, c.height, t.sampleName, t.sampleLoaded);
        track('sample');
      });
      wrap.addEventListener('dragover', function (e) {
        if (e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types || [], 'Files') >= 0) {
          e.preventDefault();
          wrap.classList.add('is-dragging');
        }
      });
      wrap.addEventListener('dragleave', function (e) { if (!wrap.contains(e.relatedTarget)) wrap.classList.remove('is-dragging'); });
      wrap.addEventListener('drop', function (e) {
        wrap.classList.remove('is-dragging');
        if (!e.dataTransfer || !e.dataTransfer.files || !e.dataTransfer.files.length) return;
        e.preventDefault();
        openFile(e.dataTransfer.files[0]);
      });
      document.addEventListener('paste', function (e) {
        var cd = e.clipboardData;
        if (!cd) return;
        for (var i = 0; i < cd.files.length; i++) {
          if (isImageFile(cd.files[i])) { e.preventDefault(); openFile(cd.files[i]); return; }
        }
        var target = e.target;
        if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) return;
        if (wrap.contains(target) || target === document.body) setStatus(t.noImageInClipboard, 'info');
      });

      // The site-wide Ctrl/⌘+L shortcut clears the tool: the image, the palette, the export and
      // any running Display P3 check or file load. Settings stay as they are.
      function clearAll() {
        cancelScan();
        loadGen++;
        fileInput.value = '';
        img = null; result = null; shown = [];
        main.hidden = true; exportEl.hidden = true;
        drop.classList.remove('is-compact');
        openBtn.textContent = t.open;
        bar.textContent = ''; paletteEl.textContent = ''; markers.textContent = '';
        codeOut.textContent = ''; info.textContent = '';
        canvas.width = 0; canvas.height = 0;
        setStatus('');
      }
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
          e.preventDefault();
          if (paletteEl.contains(document.activeElement)) openBtn.focus();
          clearAll();
        }
      });
    })();
  </script>
</div>

