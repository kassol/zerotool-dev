const T = STRINGS[lang] ?? STRINGS.en;
const CODE_KINDS = ['list', 'css', 'scss', 'tw4', 'tw3', 'json'] as const;
const LINK_PREFIX = lang === 'en' ? '' : `/${lang}`;
---

<div class="icp-wrap" id="icp-wrap" data-lang={lang} data-prefix={LINK_PREFIX}>
  <div class="icp-drop" id="icp-drop" data-active={T.dropActive}>
    <div class="icp-actions">
      <button class="btn-primary" id="icp-open" type="button">{T.open}</button>
      <button class="btn-ghost" id="icp-sample" type="button">{T.sample}</button>
    </div>
    <p class="icp-hint"><span class="icp-hint-long">{T.dropHint}</span><span class="icp-hint-short">{T.dropHintShort}</span></p>
    <input id="icp-file" type="file" accept="image/*,.svg,.avif,.webp,.heic,.heif" class="icp-file" tabindex="-1" aria-hidden="true" />
  </div>

  <p id="icp-status" class="icp-status" role="status" aria-live="polite"></p>

  <div class="icp-main" id="icp-main" hidden>
    <div class="icp-side">
      <div class="icp-controls">
        <label class="icp-ctl icp-ctl-k">
          <span class="icp-ctl-label">{T.colors}</span>
          <input id="icp-k" type="range" min="2" max="16" step="1" value="6" />
          <output id="icp-k-out" for="icp-k">6</output>
        </label>
        <details class="icp-more" id="icp-more" open>
        <summary class="icp-more-sum">{T.more}</summary>
        <div class="icp-more-body">
        <label class="icp-ctl">
          <span class="icp-ctl-label">{T.sort}</span>
          <select id="icp-sort" class="icp-select">
            <option value="share">{T.sortShare}</option>
            <option value="hue">{T.sortHue}</option>
            <option value="light">{T.sortLight}</option>
          </select>
        </label>
        <label class="icp-ctl">
          <span class="icp-ctl-label">{T.pick}</span>
          <select id="icp-pick" class="icp-select">
            <option value="common">{T.pickCommon}</option>
            <option value="average">{T.pickAverage}</option>
          </select>
        </label>
        <label class="icp-check"><input id="icp-vivid" type="checkbox" checked /> <span>{T.vivid}</span></label>
        <label class="icp-check"><input id="icp-white" type="checkbox" /> <span>{T.ignoreWhite}</span></label>
        <label class="icp-check"><input id="icp-black" type="checkbox" /> <span>{T.ignoreBlack}</span></label>
        </div>
        </details>
      </div>
      <div class="icp-bar" id="icp-bar" role="img" aria-label={T.barAria}></div>
      <ol class="icp-palette" id="icp-palette"></ol>
    </div>
    <figure class="icp-preview" id="icp-preview">
      <div class="icp-preview-box" role="img" aria-label={T.previewAria}>
        <canvas id="icp-canvas" class="icp-canvas" width="1" height="1"></canvas>
        <div class="icp-markers" id="icp-markers" aria-hidden="true"></div>
      </div>
      <figcaption class="icp-info" id="icp-info"></figcaption>
    </figure>
  </div>

  <section class="icp-export" id="icp-export" hidden aria-labelledby="icp-export-title">
    <h3 class="icp-export-title" id="icp-export-title">{T.exportTitle}</h3>
    <div class="icp-export-row">
      <label class="icp-ctl">
        <span class="icp-ctl-label">{T.exportFormat}</span>
        <select id="icp-code" class="icp-select">
          {CODE_KINDS.map((k) => <option value={k}>{T[`code_${k}`]}</option>)}
        </select>
      </label>
      <label class="icp-ctl">
        <span class="icp-ctl-label">{T.exportValues}</span>
        <select id="icp-values" class="icp-select">
          <option value="hex">HEX</option>
          <option value="rgb">RGB</option>
          <option value="hsl">HSL</option>
          <option value="oklch">OKLCH</option>
        </select>
      </label>
      <button class="btn-copy" id="icp-copy-code" type="button">{T.copyCode}</button>
    </div>
    <pre class="icp-code" id="icp-code-out" tabindex="0"></pre>
    <div class="icp-export-row">
      <button class="btn-secondary" id="icp-gpl" type="button">{T.gpl}</button>
      <button class="btn-secondary" id="icp-ase" type="button">{T.ase}</button>
    </div>
  </section>

  <script is:inline define:vars={{ t: T }}>
    (function () {
      /* ── engine:start ── */
      /* ── Copied from ColorPaletteGeneratorTool.astro (sRGB ↔ HSL ↔ OKLab ↔ OKLCH, value formats).
         scripts/test-image-color-palette.mjs compares every declaration with the source. ── */
      function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }
      function mod360(h) { h = h % 360; return h < 0 ? h + 360 : h; }

      function toHex(rgb) {
        return '#' + rgb.map(function (v) { return ('0' + v.toString(16)).slice(-2); }).join('').toUpperCase();
      }

      /* HSL ↔ sRGB, CSS Color 4 §7.1 / §7.2. s and l in percent, rgb in 0–255 floats. */
      function rgbToHsl(r, g, b) {
        r /= 255; g /= 255; b /= 255;
        var max = Math.max(r, g, b), min = Math.min(r, g, b);
        var h = 0, s = 0, l = (max + min) / 2, d = max - min;
        if (d !== 0) {
          s = (l === 0 || l === 1) ? 0 : (max - l) / Math.min(l, 1 - l);
          if (max === r) h = (g - b) / d + (g < b ? 6 : 0);
          else if (max === g) h = (b - r) / d + 2;
          else h = (r - g) / d + 4;
          h *= 60;
        }
