      italicSans: '无衬线斜体', boldItalicSans: '无衬线粗斜体', sans: '无衬线',
      script: '花体（手写）', boldScript: '粗花体', fraktur: '哥特体', boldFraktur: '粗哥特体',
      doubleStruck: '空心体', monospace: '等宽', smallCaps: '小型大写',
      superscript: '上标', subscript: '下标', fullwidth: '全角',
      circled: '圆圈', negativeCircled: '实心圆圈', squared: '方框', negativeSquared: '实心方框',
      strikethrough: '删除线', underline: '下划线'
    }
  },
  ja: {
    inputLabel: 'テキスト',
    placeholder: '英数字を入力または貼り付け。装飾文字を貼り付けると普通の文字に戻せます…',
