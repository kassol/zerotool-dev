      boldSans: '太字（サンセリフ）', bold: '太字（セリフ）', italic: '斜体', boldItalic: '太字斜体',
      italicSans: 'サンセリフ斜体', boldItalicSans: 'サンセリフ太字斜体', sans: 'サンセリフ',
      script: '筆記体', boldScript: '太字筆記体', fraktur: 'ドイツ文字（フラクトゥール）', boldFraktur: '太字フラクトゥール',
      doubleStruck: '黒板太字（中抜き）', monospace: '等幅', smallCaps: 'スモールキャピタル',
