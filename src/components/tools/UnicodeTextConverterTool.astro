    missing: '{style} 글자 없음: {chars}',
    styles: {
      boldSans: '굵게(산세리프)', bold: '굵게(세리프)', italic: '기울임', boldItalic: '굵은 기울임',
      italicSans: '산세리프 기울임', boldItalicSans: '산세리프 굵은 기울임', sans: '산세리프',
      script: '필기체', boldScript: '굵은 필기체', fraktur: '프락투어(고딕)', boldFraktur: '굵은 프락투어',
      doubleStruck: '겹선체', monospace: '고정폭', smallCaps: '작은 대문자',
      superscript: '위첨자', subscript: '아래첨자', fullwidth: '전각',
      circled: '동그라미', negativeCircled: '검은 동그라미', squared: '네모', negativeSquared: '검은 네모',
      strikethrough: '취소선', underline: '밑줄'
    }
  }
} as const;
/* ── strings:end ── */

const T = STRINGS[lang];
---

<div class="utc-wrap">
  <div class="utc-input">
    <div class="utc-input-head">
      <label for="utc-input" class="tool-label">{T.inputLabel}</label>
      <button id="utc-clear" class="btn-ghost btn-sm" type="button">{T.clear}</button>
    </div>
    <textarea id="utc-input" class="tool-textarea utc-textarea" placeholder={T.placeholder} spellcheck="false" rows="2"></textarea>
    <p id="utc-status" class="tool-status none utc-status" aria-live="polite">{T.preview.replace('{sample}', T.sample)}</p>
  </div>

  <div id="utc-plain" class="utc-card utc-plain" hidden>
    <div class="utc-card-head">
      <span class="utc-card-name">{T.plainLabel}</span>
      <span class="utc-card-actions">
        <button id="utc-use-plain" class="btn-ghost btn-sm" type="button">{T.useAsInput}</button>
        <button id="utc-copy-plain" class="btn-copy" type="button" aria-label={T.copyAria.replace('{style}', T.plainLabel)}>{T.copy}</button>
      </span>
    </div>
    <div id="utc-plain-text" class="utc-card-text"></div>
  </div>

  <div id="utc-grid" class="utc-grid"></div>
  <p class="utc-a11y">{T.a11y}</p>

  <script is:inline define:vars={{ t: T }}>
    (function () {
      /* ── engine:start ── */
      // Style order on the page. Letter tables are built from code point offsets in the
      // Unicode charts; holes in the Mathematical Alphanumeric Symbols block point to the
      // Letterlike Symbols that were encoded earlier (UTR #25 section 2.2).
      var STYLE_IDS = [
        'boldSans', 'bold', 'italic', 'boldItalic', 'italicSans', 'boldItalicSans', 'sans',
        'script', 'boldScript', 'fraktur', 'boldFraktur', 'doubleStruck', 'monospace',
        'smallCaps', 'superscript', 'subscript', 'fullwidth',
        'circled', 'negativeCircled', 'squared', 'negativeSquared',
        'strikethrough', 'underline'
      ];

      var UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      var LOWER = 'abcdefghijklmnopqrstuvwxyz';
      var DIGITS = '0123456789';

      // [capital A, small a or null (= same as capitals), digit zero or null, holes]
      var MATH = {
        bold: [0x1D400, 0x1D41A, 0x1D7CE],
        italic: [0x1D434, 0x1D44E, null, { h: 0x210E }],
        boldItalic: [0x1D468, 0x1D482, null],
        script: [0x1D49C, 0x1D4B6, null, { B: 0x212C, E: 0x2130, F: 0x2131, H: 0x210B, I: 0x2110, L: 0x2112, M: 0x2133, R: 0x211B, e: 0x212F, g: 0x210A, o: 0x2134 }],
        boldScript: [0x1D4D0, 0x1D4EA, null],
        fraktur: [0x1D504, 0x1D51E, null, { C: 0x212D, H: 0x210C, I: 0x2111, R: 0x211C, Z: 0x2128 }],
        doubleStruck: [0x1D538, 0x1D552, 0x1D7D8, { C: 0x2102, H: 0x210D, N: 0x2115, P: 0x2119, Q: 0x211A, R: 0x211D, Z: 0x2124 }],
        boldFraktur: [0x1D56C, 0x1D586, null],
        sans: [0x1D5A0, 0x1D5BA, 0x1D7E2],
        boldSans: [0x1D5D4, 0x1D5EE, 0x1D7EC],
        italicSans: [0x1D608, 0x1D622, null],
        boldItalicSans: [0x1D63C, 0x1D656, null],
        monospace: [0x1D670, 0x1D68A, 0x1D7F6],
        circled: [0x24B6, 0x24D0, null, { 0: 0x24EA, 1: 0x2460, 2: 0x2461, 3: 0x2462, 4: 0x2463, 5: 0x2464, 6: 0x2465, 7: 0x2466, 8: 0x2467, 9: 0x2468 }],
        // The Enclosed Alphanumeric Supplement has capitals only.
        negativeCircled: [0x1F150, null, null, { 0: 0x24FF, 1: 0x2776, 2: 0x2777, 3: 0x2778, 4: 0x2779, 5: 0x277A, 6: 0x277B, 7: 0x277C, 8: 0x277D, 9: 0x277E }],
        squared: [0x1F130, null, null],
        negativeSquared: [0x1F170, null, null]
      };

      // Letters that exist only as small capitals, modifier letters or subscripts.
      // Anything missing from a table is left as typed and listed under the card.
      var LISTS = {
        smallCaps: {
          a: 0x1D00, b: 0x0299, c: 0x1D04, d: 0x1D05, e: 0x1D07, f: 0xA730, g: 0x0262, h: 0x029C,
          i: 0x026A, j: 0x1D0A, k: 0x1D0B, l: 0x029F, m: 0x1D0D, n: 0x0274, o: 0x1D0F, p: 0x1D18,
          q: 0xA7AF, r: 0x0280, s: 0xA731, t: 0x1D1B, u: 0x1D1C, v: 0x1D20, w: 0x1D21, y: 0x028F,
          z: 0x1D22
        },
        superscript: {
          A: 0x1D2C, B: 0x1D2E, D: 0x1D30, E: 0x1D31, G: 0x1D33, H: 0x1D34, I: 0x1D35, J: 0x1D36,
          K: 0x1D37, L: 0x1D38, M: 0x1D39, N: 0x1D3A, O: 0x1D3C, P: 0x1D3E, R: 0x1D3F, T: 0x1D40,
          U: 0x1D41, V: 0x2C7D, W: 0x1D42,
          a: 0x1D43, b: 0x1D47, c: 0x1D9C, d: 0x1D48, e: 0x1D49, f: 0x1DA0, g: 0x1D4D, h: 0x02B0,
          i: 0x2071, j: 0x02B2, k: 0x1D4F, l: 0x02E1, m: 0x1D50, n: 0x207F, o: 0x1D52, p: 0x1D56,
          r: 0x02B3, s: 0x02E2, t: 0x1D57, u: 0x1D58, v: 0x1D5B, w: 0x02B7, x: 0x02E3, y: 0x02B8,
          z: 0x1DBB,
          0: 0x2070, 1: 0x00B9, 2: 0x00B2, 3: 0x00B3, 4: 0x2074, 5: 0x2075, 6: 0x2076, 7: 0x2077,
          8: 0x2078, 9: 0x2079, '+': 0x207A, '-': 0x207B, '=': 0x207C, '(': 0x207D, ')': 0x207E
        },
        subscript: {
          a: 0x2090, e: 0x2091, h: 0x2095, i: 0x1D62, j: 0x2C7C, k: 0x2096, l: 0x2097, m: 0x2098,
          n: 0x2099, o: 0x2092, p: 0x209A, r: 0x1D63, s: 0x209B, t: 0x209C, u: 0x1D64, v: 0x1D65,
          x: 0x2093,
          0: 0x2080, 1: 0x2081, 2: 0x2082, 3: 0x2083, 4: 0x2084, 5: 0x2085, 6: 0x2086, 7: 0x2087,
          8: 0x2088, 9: 0x2089, '+': 0x208A, '-': 0x208B, '=': 0x208C, '(': 0x208D, ')': 0x208E
        }
      };

      // Combining marks added after each character (U+0336 long stroke overlay,
      // U+0332 combining low line).
      var OVERLAY = { strikethrough: '\u0336', underline: '\u0332' };

      var TABLES = {};
      (function build() {
        Object.keys(MATH).forEach(function (id) {
          var spec = MATH[id];
          var map = {};
          var holes = spec[3] || {};
          for (var i = 0; i < 26; i++) {
            map[UPPER[i]] = String.fromCodePoint(spec[0] + i);
            map[LOWER[i]] = String.fromCodePoint((spec[1] === null ? spec[0] : spec[1]) + i);
          }
          if (spec[2] !== null) {
            for (var d = 0; d < 10; d++) map[DIGITS[d]] = String.fromCodePoint(spec[2] + d);
          }
          Object.keys(holes).forEach(function (k) { map[k] = String.fromCodePoint(holes[k]); });
          TABLES[id] = map;
        });
        Object.keys(LISTS).forEach(function (id) {
          var map = {};
          Object.keys(LISTS[id]).forEach(function (k) { map[k] = String.fromCodePoint(LISTS[id][k]); });
          TABLES[id] = map;
        });
        // Small capitals are lower-case forms; capitals stay capitals by design.
        for (var u = 0; u < 26; u++) TABLES.smallCaps[UPPER[u]] = UPPER[u];
        // Fullwidth forms cover all printable ASCII (U+FF01..U+FF5E); space becomes U+3000.
        var fw = {};
        for (var c = 0x21; c <= 0x7E; c++) fw[String.fromCharCode(c)] = String.fromCharCode(c + 0xFEE0);
        fw[' '] = '\u3000';
        TABLES.fullwidth = fw;
      })();

      // Reverse table: styled character -> plain character, from every table above.
      var REVERSE = {};
      Object.keys(TABLES).forEach(function (id) {
        var map = TABLES[id];
        Object.keys(map).forEach(function (k) {
          if (map[k] !== k && !REVERSE[map[k]]) REVERSE[map[k]] = k;
        });
      });

      var segmenter = (typeof Intl !== 'undefined' && Intl.Segmenter)
        ? new Intl.Segmenter(undefined, { granularity: 'grapheme' }) : null;

      function graphemes(text) {
        if (segmenter) {
          var out = [];
          var it = segmenter.segment(text)[Symbol.iterator]();
          for (var s = it.next(); !s.done; s = it.next()) out.push(s.value.segment);
          return out;
        }
        return Array.from(text);
      }

      // Latin letters and ASCII digits: when one of these has no form in a style,
      // the card says so. Other scripts are reported once for the whole input.
      var LATIN_LETTER = /^(\p{Script=Latin}|[0-9])$/u;
      var LINE_BREAK = /^(\r\n|\r|\n|\u2028|\u2029)$/;

      // Styles whose letters take combining accents well. Accents over circled,
      // squared, fullwidth, small-capital and superscript letters collide with the
      // enclosure or float beside the letter, so those styles keep é as typed.
      var KEEPS_MARKS = {
        bold: 1, italic: 1, boldItalic: 1, script: 1, boldScript: 1, fraktur: 1, boldFraktur: 1,
        doubleStruck: 1, sans: 1, boldSans: 1, italicSans: 1, boldItalicSans: 1, monospace: 1
      };

      // Convert one style. Each grapheme cluster is decomposed (NFD); when its base
      // letter has a styled form, the styled letter keeps the cluster's combining marks
      // (é -> 𝐞 + U+0301). Clusters without a styled form are kept exactly as typed.
      // missing: distinct Latin letters, digits and accented letters that have no form in this style.
      function convert(text, id) {
        var parts = graphemes(text);
        var out = '';
        var missing = [];
        var overlay = OVERLAY[id];
        var map = TABLES[id];
        for (var i = 0; i < parts.length; i++) {
          var g = parts[i];
          if (overlay) {
            out += LINE_BREAK.test(g) ? g : g + overlay;
            continue;
          }
          var d = g.normalize('NFD');
          var base = String.fromCodePoint(d.codePointAt(0));
          var marks = d.slice(base.length);
          var styled = Object.prototype.hasOwnProperty.call(map, base) ? map[base] : null;
          if (styled !== null && (!marks || KEEPS_MARKS[id])) {
            out += styled + marks;
          } else {
            out += g;
            var key = marks ? g : base;
            if (LATIN_LETTER.test(base) && missing.indexOf(key) < 0) missing.push(key);
          }
        }
        return { text: out, missing: missing };
      }

      // Marks that fancy text generators put on top of letters.
      var STRIP_MARKS = /[\u0332\u0333\u0335\u0336\u0337\u0338]/g;

      function inNfkcRange(cp) {
        return (cp >= 0x1D400 && cp <= 0x1D7FF) ||
          (cp >= 0x2460 && cp <= 0x24FF) ||
          (cp >= 0x1F100 && cp <= 0x1F1E5) ||
          (cp >= 0xFF01 && cp <= 0xFF5E) ||
          (cp >= 0x2070 && cp <= 0x209F) ||
          (cp >= 0x1D2C && cp <= 0x1D6A) ||
          (cp >= 0x1D9B && cp <= 0x1DBF) ||
          (cp >= 0x02B0 && cp <= 0x02B8) ||
          (cp >= 0x02E0 && cp <= 0x02E4) ||
          cp === 0x2C7C || cp === 0x2C7D;
      }

      // Styled characters a user would not expect to lose when restyling text:
      // ¹ ² ³ (m², footnotes), circled digits used as list markers, ideographic space.
      function keepInSource(ch) {
        var cp = ch.codePointAt(0);
        if (cp === 0x00B9 || cp === 0x00B2 || cp === 0x00B3 || cp === 0x3000) return true;
        if ((cp >= 0x2460 && cp <= 0x2473) || cp === 0x24EA || (cp >= 0x2776 && cp <= 0x277F) || cp === 0x24FF) return true;
        return false;
      }

      // Turn styled text back into plain text. forSource keeps the characters listed in
      // keepInSource, so restyling "m²" or "①" does not change them.
      function toPlain(text, forSource) {
        var out = '';
        var changed = 0;
        var chars = Array.from(text);
        for (var i = 0; i < chars.length; i++) {
          var ch = chars[i];
          if (ch === '\uFE0F' && i > 0 && REVERSE[chars[i - 1]]) { changed++; continue; }
          if (forSource && keepInSource(ch)) { out += ch; continue; }
          var plain = null;
          if (REVERSE[ch]) plain = REVERSE[ch];
          else if (ch === '\u3000') plain = ' ';
          else if (inNfkcRange(ch.codePointAt(0))) {
            var n = ch.normalize('NFKC');
            if (n !== ch) plain = n;
          }
          if (plain !== null) { out += plain; changed++; } else out += ch;
        }
        var stripped = out.replace(STRIP_MARKS, '');
        changed += out.length - stripped.length;
        return { text: stripped, changed: changed };
      }

      var NON_LATIN_LETTER = /[\p{L}\p{N}]/u;
      var LATIN_SCRIPT = /[\p{Script=Latin}\p{Script=Common}\p{Script=Inherited}]/u;

      // Whole-input summary: the text the styles start from, how many styled characters
      // were folded back, and letters from other scripts (no styled forms exist for them).
      function analyze(input) {
        var src = toPlain(input, true);
        var others = [];
        var chars = Array.from(src.text);
        for (var i = 0; i < chars.length; i++) {
          var ch = chars[i];
          if (NON_LATIN_LETTER.test(ch) && !LATIN_SCRIPT.test(ch) && others.indexOf(ch) < 0) others.push(ch);
        }
        return { source: src.text, styled: src.changed, others: others };
      }

      function fill(template, values) {
        return template.replace(/\{(\w+)\}/g, function (m, k) {
          return Object.prototype.hasOwnProperty.call(values, k) ? String(values[k]) : m;
        });
      }
      /* ── engine:end ── */

      var wrap = document.querySelector('.utc-wrap');
      var inputEl = document.getElementById('utc-input');
      var statusEl = document.getElementById('utc-status');
      var gridEl = document.getElementById('utc-grid');
      var plainCard = document.getElementById('utc-plain');
      var plainText = document.getElementById('utc-plain-text');
      var cards = {};

      function setStatus(msg, kind) {
        statusEl.textContent = msg;
        statusEl.className = 'tool-status utc-status ' + (kind || 'none');
      }

      // Cards are built once; render() only sets textContent, so user text is never
      // parsed as HTML.
      STYLE_IDS.forEach(function (id) {
        var card = document.createElement('div');
        card.className = 'utc-card';
        var head = document.createElement('div');
        head.className = 'utc-card-head';
        var name = document.createElement('span');
        name.className = 'utc-card-name';
        name.textContent = t.styles[id];
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn-copy';
        btn.textContent = t.copy;
        btn.setAttribute('aria-label', fill(t.copyAria, { style: t.styles[id] }));
        head.appendChild(name);
        head.appendChild(btn);
        var text = document.createElement('div');
        text.className = 'utc-card-text';
        var note = document.createElement('div');
        note.className = 'utc-card-note';
        note.hidden = true;
        card.appendChild(head);
        card.appendChild(text);
        card.appendChild(note);
        gridEl.appendChild(card);
        cards[id] = { card: card, text: text, note: note, btn: btn };
        btn.addEventListener('click', function () { copyText(text.textContent, btn, t.styles[id], id); });
      });

      function fallbackCopy(value) {
        var ta = document.createElement('textarea');
        ta.value = value;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.body.removeChild(ta);
        return ok;
      }

      function copyText(value, btn, label, id) {
        if (!value || btn.disabled) return;
        function done() {
          btn.textContent = t.copied;
          setTimeout(function () { btn.textContent = t.copy; }, 1500);
          setStatus(fill(t.copiedStatus, { style: label }), 'success');
          window.trackTool && window.trackTool('unicode_text_converter', 'copy_' + id);
        }
        function fail() { setStatus(t.copyFailed, 'error'); }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(value).then(done, function () { fallbackCopy(value) ? done() : fail(); });
        } else if (fallbackCopy(value)) done();
        else fail();
      }

      function render() {
        var input = inputEl.value;
        var preview = input === '';
        var info = analyze(preview ? t.sample : input);
        STYLE_IDS.forEach(function (id) {
          var r = convert(info.source, id);
          var c = cards[id];
          c.text.textContent = r.text;
          c.card.classList.toggle('utc-preview', preview);
          c.btn.disabled = preview;
          if (!preview && r.missing.length) {
            c.note.textContent = fill(t.missing, { style: t.styles[id], chars: r.missing.slice(0, 12).join(' ') + (r.missing.length > 12 ? ' …' : '') });
            c.note.hidden = false;
          } else {
            c.note.hidden = true;
          }
        });
        if (!preview && info.styled > 0) {
          plainText.textContent = toPlain(input, false).text;
          plainCard.hidden = false;
        } else {
          plainCard.hidden = true;
        }
        if (preview) { setStatus(fill(t.preview, { sample: t.sample }), 'none'); return; }
        var notes = [];
        if (info.styled > 0) notes.push(fill(t.styledNote, { n: info.styled }));
        if (info.others.length) notes.push(fill(t.othersNote, { chars: info.others.slice(0, 8).join(' ') + (info.others.length > 8 ? ' …' : '') }));
        setStatus(notes.join(' '), notes.length ? 'info' : 'none');
      }

      var timer = null;
      inputEl.addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(render, 120);
      });

      document.getElementById('utc-clear').addEventListener('click', function () {
        clearTimeout(timer);
        inputEl.value = '';
        render();
        inputEl.focus();
      });

      var plainBtn = document.getElementById('utc-copy-plain');
      plainBtn.addEventListener('click', function () { copyText(plainText.textContent, plainBtn, t.plainLabel, 'plain'); });
      document.getElementById('utc-use-plain').addEventListener('click', function () {
        inputEl.value = plainText.textContent;
        render();
        inputEl.focus();
      });

      // The site-wide Ctrl/Cmd+L empties the text box; refresh the cards with it.
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
          setTimeout(render, 0);
        }
      });

      render();
    })();
  </script>
</div>

<style is:global>
  .utc-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  .utc-input { display: flex; flex-direction: column; gap: 0.35rem; }
  .utc-input-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .utc-textarea { min-height: 3.6rem; font-family: var(--font-sans); font-size: 1rem; }
  .utc-status { margin: 0; }

  .utc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 0.6rem;
  }

  .utc-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    padding: 0.55rem 0.7rem 0.6rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }
  .utc-wrap [hidden] { display: none; }
  .utc-plain { box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-primary) 45%, transparent); }

  .utc-card-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .utc-card-actions { display: flex; gap: 0.35rem; align-items: center; }
  .utc-card-name {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    min-width: 0;
  }
  .utc-card-text {
    font-size: 1.1rem;
    line-height: 1.45;
    color: var(--color-text);
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    min-height: 1.45em;
  }
  .utc-card-note { font-size: 0.78rem; color: var(--color-text-muted); }
  .utc-preview .utc-card-text { color: var(--color-text-secondary); }
  .utc-wrap .btn-copy:disabled { opacity: 0.5; cursor: default; }

  .utc-a11y { margin: 0; font-size: 0.82rem; color: var(--color-text-muted); }
</style>
