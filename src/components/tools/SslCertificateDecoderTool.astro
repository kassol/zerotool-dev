        var ch = state.chain, inf = ch.info[i], cert = state.certs[i];
        if (inf.duplicateOf != null) return fmt(S.roleDuplicate, { n: inf.duplicateOf + 1 });
        if (ch.path.indexOf(i) < 0 && !ch.bundle) return S.roleUnrelated;
        if (inf.selfSigned) return isCa(cert) || cert.version < 3 ? S.roleRoot : S.roleSelfSigned;
        if (isCa(cert)) return S.roleIntermediate;
        return S.roleLeaf;
      }

      function linkText(link) {
        if (!link) return '';
        var parts = [link.name === 'exact' ? S.nameExact : S.nameNormalized];
        if (link.keyId === true) parts.push(S.keyIdMatch);
        var sig = link.signature || {};
        parts.push(sig.state === 'ok' ? S.sigOk : sig.state === 'unsupported' ? fmt(S.sigUnsupported, { alg: sig.reason || '' }) : sig.state === 'mismatch' ? S.sigMismatch : S.sigBad);
        return parts.join(' · ');
      }

      function renderChain() {
        var ch = state.chain, certs = state.certs, html = '';
        var msgs = [];
        if (certs.length === 1) msgs.push({ t: S.orderSingle, c: 'info' });
        else if (ch.bundle) msgs.push({ t: S.bundle, c: 'info' });
        else {
          msgs.push(ch.inOrder ? { t: S.orderOk, c: 'ok' } : { t: fmt(S.orderBad, { order: ch.path.map(function (x) { return '#' + (x + 1); }).join(' → ') }), c: 'bad' });
          if (ch.leaves.length > 1) msgs.push({ t: fmt(S.leavesMany, { n: ch.leaves.length, first: ch.path[0] + 1 }), c: 'info' });
        }
        if (!ch.bundle) {
          var topCert = certs[ch.top];
          if (ch.rootIncluded && certs.length > 1) msgs.push({ t: S.rootIncluded, c: 'info' });
          else if (!ch.rootIncluded && !ch.info[ch.top].badLink) {
            var aia = topCert.ext['1.3.6.1.5.5.7.1.1'];
            var url = null;
            if (aia && aia.decoded) aia.decoded.access.forEach(function (a) { if (!url && a.method === 'caIssuers' && a.location.type === 'URI') url = a.location.value; });
            var topIsCa = isCa(topCert);
            msgs.push({ t: fmt(S.issuerMissing, { n: ch.top + 1, issuer: issuerShort(topCert) }) + (url ? ' ' + fmt(S.issuerMissingAia, { url: url }) : '') + ' ' + (topIsCa ? S.issuerMissingCa : S.issuerMissingLeaf), c: topIsCa ? 'info' : 'bad' });
          }
          ch.problems.forEach(function (p) { msgs.push({ t: fmt(S['prob' + p.code.charAt(0).toUpperCase() + p.code.slice(1)], p.params), c: 'bad' }); });
        }
        html += '<ul class="scd-chain-msgs">' + msgs.map(function (m) { return '<li class="scd-msg scd-msg-' + m.c + '">' + esc(m.t) + '</li>'; }).join('') + '</ul>';
        html += '<ol class="scd-chain-list">';
        certs.forEach(function (cert, i) {
          var st = statusOf(cert), inf = ch.info[i];
          var good = inf.issuerLink || inf.badLink;
          var link = good ? '<span class="scd-link' + (inf.issuerLink ? '' : ' scd-link-bad') + '">↳ ' + esc(fmt(S.linkTo, { n: good.index + 1 })) + ': ' + esc(linkText(good)) + '</span>'
            : inf.selfLink ? '<span class="scd-link">↺ ' + esc(linkText(inf.selfLink)) + '</span>' : '';
          html += '<li><button type="button" class="scd-chain-item' + (i === state.selected ? ' is-active' : '') + '" data-index="' + i + '" aria-pressed="' + (i === state.selected) + '">' +
            '<span class="scd-chain-head"><span class="scd-chain-num">#' + (i + 1) + '</span><span class="scd-chain-name">' + esc(shortName(cert)) + '</span>' +
            chip(roleOf(i)) + '<span class="scd-tag scd-st-' + st.state + '">' + esc(st.text) + '</span></span>' + link + '</button></li>';
        });
        html += '</ol>';
        var tools = '<p class="scd-note">' + esc(S.trustNote) + '</p>';
        if (!ch.inOrder && !ch.bundle && certs.length > 1) {
          var pem = ch.path.map(function (x) { return toPem(certs[x].der); }).join('');
          tools += '<button type="button" class="btn-secondary scd-copy" data-copy="' + esc(pem) + '">' + esc(S.copyChain) + '</button>';
        }
        return card(fmt(S.chainTitle, { n: certs.length }), html + tools, 'scd-chain');
      }

      function renderExtension(e) {
        var d = e.decoded, body = '';
        if (e.error || !d) {
          body = '<p class="scd-muted">' + esc(e.error ? S.extError : S.extRaw) + '</p>' + mono(bytesToHex(e.value));
        } else switch (e.oid) {
          case '2.5.29.19': body = esc(fmt(S.bcValue, { ca: d.ca ? S.yes : S.no })) + (d.pathLen != null ? ', ' + esc(fmt(S.bcPath, { n: d.pathLen })) : ''); break;
          case '2.5.29.15': body = d.flags.map(function (f) { return chip(f); }).join(''); break;
          case '2.5.29.37': body = d.usages.map(function (u) { return chip(u.name === u.oid ? u.oid : u.name + ' (' + u.oid + ')'); }).join(''); break;
          case '2.5.29.14': body = mono(d.keyId); break;
          case '2.5.29.35':
            body = (d.keyId ? row(S.akiKeyId, mono(d.keyId)) : '') + (d.issuer ? row(S.akiIssuer, esc(d.issuer.map(gnText).join(', '))) : '') + (d.serial ? row(S.akiSerial, mono(d.serial)) : '');
            break;
          case '1.3.6.1.5.5.7.1.1': case '1.3.6.1.5.5.7.1.11':
            body = d.access.map(function (a) { return row(a.method, mono(gnText(a.location)), a.location.value); }).join(''); break;
          case '2.5.29.31': case '2.5.29.46':
            body = d.points.map(function (p) { return p.names.map(function (g) { return row(g.type, mono(gnText(g)), g.value); }).join(''); }).join(''); break;
          case '2.5.29.32':
            body = d.policies.map(function (p) {
              var q = p.qualifiers.map(function (x) { return '<div class="scd-sub">' + esc(x.type) + ': ' + esc(x.value) + '</div>'; }).join('');
              return '<div class="scd-policy">' + mono(p.oid) + (p.name ? ' ' + chip(p.name) : '') + q + '</div>';
            }).join(''); break;
          case '2.5.29.17': body = esc(fmt(S.secSan, { n: d.names.length })); break;
          case '2.5.29.18':
            body = d.names.map(function (g) { return row(g.type, esc(gnText(g))); }).join(''); break;
          case '2.5.29.30':
            body = (d.permitted.length ? row(S.permitted, esc(d.permitted.map(function (g) { return g.type + ':' + g.value; }).join(', '))) : '') +
              (d.excluded.length ? row(S.excluded, esc(d.excluded.map(function (g) { return g.type + ':' + g.value; }).join(', '))) : ''); break;
          case '1.3.6.1.5.5.7.1.24':
            body = d.features.map(function (f) { return chip(f === 5 ? S.mustStaple : String(f)); }).join(''); break;
          case '1.3.6.1.4.1.11129.2.4.2': body = esc(d.scts.length + ' SCT'); break;
          case '1.3.6.1.4.1.11129.2.4.3': body = esc(S.poison); break;
          default: body = esc(JSON.stringify(d));
        }
        var head = '<div class="scd-ext-head">' + mono(e.name === e.oid ? e.oid : e.name) + (e.name !== e.oid ? ' <span class="scd-muted">' + esc(e.oid) + '</span>' : '') +
          (e.critical ? ' ' + chip(S.critical, 'scd-chip-critical') : '') + '</div>';
        return '<div class="scd-ext">' + head + '<div class="scd-ext-body">' + body + '</div></div>';
      }

      function renderDetail(cert, fps) {
        var html = '';
        var checks = checkCertificate(cert, Date.now());
        html += card(S.secChecks, checks.length
          ? '<ul class="scd-checks">' + checks.map(function (c) { return '<li class="scd-msg scd-msg-' + (c.level === 'error' ? 'bad' : c.level === 'warn' ? 'warn' : 'info') + '">' + esc(fmt(S['chk_' + c.code] || c.code, c.params)) + '</li>'; }).join('') + '</ul>'
          : '<p class="scd-msg scd-msg-ok">' + esc(S.chk_noIssues) + '</p>');

        var st = statusOf(cert), vd = validityDays(cert);
        html += card(S.secValidity,
          row(S.labelStatus, '<span class="scd-tag scd-st-' + st.state + '">' + esc(st.text) + '</span>') +
          row(S.labelNotBefore, mono(fmtDate(cert.notBefore.ms)) + ' <span class="scd-muted">' + esc(cert.notBefore.type + ' ' + cert.notBefore.raw) + '</span>') +
          row(S.labelNotAfter, mono(cert.notAfter.noExpiry ? S.noExpiry : fmtDate(cert.notAfter.ms)) + ' <span class="scd-muted">' + esc(cert.notAfter.type + ' ' + cert.notAfter.raw) + '</span>') +
          row(S.labelPeriod, esc(fmt(S.periodValue, vd))));

        function nameCard(title, name) {
          var rows = name.rdns.map(function (rdn) {
            return rdn.map(function (a) { return row(a.name, a.value == null ? mono('#' + bytesToHex(a.raw, '')) : esc(a.value)); }).join('');
          }).join('');
          var one = nameToString(name);
          return card(title, (rows || '<p class="scd-muted">—</p>') + (one ? row(S.labelOneLine, mono(one), one) : ''));
        }
        html += '<div class="scd-grid-2">' + nameCard(S.secSubject, cert.subject) + nameCard(S.secIssuer, cert.issuer) + '</div>';

        var sans = sanNames(cert);
        if (sans.length) {
          html += card(fmt(S.secSan, { n: sans.length }), '<div class="scd-san">' + sans.map(function (g) {
            return '<span class="scd-san-item"><span class="scd-san-type">' + esc(g.type) + '</span>' + esc(gnText(g)) + '</span>';
          }).join('') + '</div>' + '<button type="button" class="btn-copy scd-copy" data-copy="' + esc(sans.map(function (g) { return g.value; }).join('\n')) + '">' + esc(S.copy) + '</button>');
        }

        var k = cert.spki, keyBody = row(S.labelAlgorithm, esc(k.algorithm === k.algOid ? k.algOid : k.algorithm + ' (' + k.algOid + ')'));
        if (k.bits) keyBody += row(S.labelKeySize, esc(fmt(S.bits, { n: k.bits })));
        if (k.curve) keyBody += row(S.labelCurve, esc(k.curve + (k.curveAlias && k.curveAlias !== k.curve ? ' / ' + k.curveAlias : '')));
        if (k.exponent) keyBody += row(S.labelExponent, mono(k.exponent));
        if (k.pubBytes) keyBody += row(S.labelPubBytes, esc(fmt(S.pubBytes, { n: k.pubBytes })));
        if (k.modulusHex) keyBody += '<details class="scd-details"><summary>' + esc(S.labelModulus) + '</summary>' + mono(k.modulusHex.match(/../g).join(':')) + '</details>';
        keyBody += row(S.labelSpki, mono(fps.spkiSha256), fps.spkiSha256);
        var sigBody = row(S.labelSigAlg, esc(cert.sigAlg.name === cert.sigAlg.oid ? cert.sigAlg.oid : cert.sigAlg.name + ' (' + cert.sigAlg.oid + ')'));
        if (cert.sigAlg.pss) sigBody += row(S.labelPss, esc(fmt(S.pssValue, { hash: cert.sigAlg.pss.hash, mgfHash: cert.sigAlg.pss.mgfHash, salt: cert.sigAlg.pss.saltLength })));
        sigBody += '<details class="scd-details"><summary>' + esc(cert.signature.length + ' bytes') + '</summary>' + mono(bytesToHex(cert.signature)) + '</details>';
        html += '<div class="scd-grid-2">' + card(S.secKey, keyBody) + card(S.secSignature, sigBody) + '</div>';

        html += card(S.secFingerprints, row('SHA-256', mono(fps.sha256), fps.sha256) + row('SHA-1', mono(fps.sha1), fps.sha1) + row('MD5', mono(fps.md5), fps.md5));
        html += card(S.secMeta, row(S.labelSerialHex, mono(cert.serial.colon), cert.serial.hex) + row(S.labelSerialDec, mono(cert.serial.decimal), cert.serial.decimal) + row(S.labelVersion, esc('v' + cert.version)));

        var others = cert.extensions;
        if (others.length) html += card(fmt(S.secExtensions, { n: others.length }), others.map(renderExtension).join(''));

        var sctExt = cert.ext['1.3.6.1.4.1.11129.2.4.2'];
        if (sctExt && sctExt.decoded && sctExt.decoded.scts.length) {
          html += card(fmt(S.secSct, { n: sctExt.decoded.scts.length }), sctExt.decoded.scts.map(function (s) {
            return '<div class="scd-sct">' + row(S.labelLogId, mono(s.logIdBase64), s.logIdBase64) + row(S.labelTimestamp, mono(fmtDate(s.timestamp))) +
              row(S.labelSctSig, esc(s.signature + ' / ' + s.hash)) + '</div>';
          }).join(''));
        }
        html += '<div class="scd-actions"><button type="button" class="btn-secondary scd-copy" data-copy="' + esc(toPem(cert.der)) + '">' + esc(S.copyPem) + '</button></div>';
        return html;
      }

      function renderHost() {
        var out = document.getElementById('scd-host-result');
        if (!out) return;
        var host = state.host.trim();
        if (!host || !state.certs.length) { out.textContent = ''; out.className = 'scd-host-result'; return; }
        var cert = state.certs[state.selected];
        var r = matchHostname(cert, host), text, cls;
        if (r.state === 'invalid') { out.textContent = S.hostInvalid; out.className = 'scd-host-result scd-msg scd-msg-warn'; return; }
        var shown = r.host ? (idnToUnicode(r.host) ? idnToUnicode(r.host) + ' (' + r.host + ')' : r.host) : '';
        if (r.state === 'match') { text = fmt(r.wildcard ? S.hostWildcard : S.hostMatch, { host: shown, name: r.by.value }); cls = 'ok'; }
        else if (r.state === 'cnOnly') { text = fmt(S.hostCnOnly, { host: shown }); cls = 'bad'; }
        else { text = r.count ? fmt(S.hostNoMatch, { host: shown, count: r.count }) : S.hostNoSan; cls = 'bad'; }
        out.textContent = text;
        out.className = 'scd-host-result scd-msg scd-msg-' + cls;
      }

      async function showSelected() {
        var run = state.run;
        var cert = state.certs[state.selected];
        var fps;
        try { fps = await fingerprints(cert, subtle); }
        catch (e) { fps = { sha256: '—', sha1: '—', md5: bytesToHex(md5(cert.der)), spkiSha256: '—' }; }
        if (run !== state.run) return;
        document.getElementById('scd-detail').innerHTML = renderDetail(cert, fps);
        resultsEl.querySelectorAll('.scd-chain-item').forEach(function (b) {
          var on = Number(b.getAttribute('data-index')) === state.selected;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', String(on));
        });
        renderHost();
      }

      async function runDecode(opts) {
        var run = ++state.run;
        var text = inputEl.value;
        if (!text.trim()) {
          resultsEl.hidden = true; resultsEl.innerHTML = '';
          setStatus(opts && opts.quiet ? '' : S.errEmpty, 'error');
          return;
        }
        var parsed;
        try { parsed = parseInput(text); }
        catch (e) { resultsEl.hidden = true; resultsEl.innerHTML = ''; setStatus(errorText(e), 'error'); return; }
        persist(parsed.hasPrivateKey);
        var certs = [], errors = [];
        parsed.certs.forEach(function (item, i) {
          try { certs.push(decodeCertificate(item.der)); }
          catch (e) { errors.push(fmt(S.errCert, { n: i + 1, line: item.source.line || 1, msg: errorText(e) })); }
        });
        var notes = parsed.notices.map(noteText).concat(errors);
        if (!certs.length) {
          resultsEl.hidden = true; resultsEl.innerHTML = '';
          setStatus(notes.join('\n') || S.errNoCert, 'error');
          return;
        }
        var chain = await analyzeChain(certs, subtle);
        if (run !== state.run) return;
        state.certs = certs; state.chain = chain;
        state.selected = chain.path[0] || 0;
        var hostVal = (document.getElementById('scd-host') || {}).value || '';
        state.host = hostVal;
        resultsEl.innerHTML = renderChain() +
          '<div class="scd-host"><label class="tool-label" for="scd-host">' + esc(S.hostLabel) + '</label>' +
          '<input id="scd-host" class="tool-input" type="text" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder="' + esc(S.hostPlaceholder) + '" value="' + esc(hostVal) + '">' +
          '<p id="scd-host-result" class="scd-host-result" role="status" aria-live="polite"></p></div>' +
          '<div id="scd-detail" class="scd-detail"></div>';
        resultsEl.hidden = false;
        var lead = opts && opts.lead ? opts.lead + ' ' : '';
        var summary = lead + (certs.length === 1 ? S.decodedOne : fmt(S.decodedMany, { n: certs.length }));
        setStatus([summary].concat(notes).join('\n'), errors.length || parsed.hasPrivateKey ? 'error' : notes.length ? 'info' : 'success');
        await showSelected();
        // After an explicit action, bring the chain card into view if it starts below the viewport.
        if (opts && opts.reveal) {
          var top = resultsEl.getBoundingClientRect().top;
          if (top > window.innerHeight - 120) statusEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        if (typeof window.trackTool === 'function') { try { window.trackTool(SLUG, 'decode'); } catch (e) {} }
      }

      function persist(hasKey) {
        if (!window.ztPersist) return;
        try {
          if (hasKey || /PRIVATE KEY-----/.test(inputEl.value)) window.ztPersist.clear(SLUG);
          else window.ztPersist.save(SLUG, inputEl.value);
        } catch (e) {}
      }

      function copyText(btn, value) {
        function done(ok) {
          var original = btn.getAttribute('data-label') || btn.textContent;
          btn.setAttribute('data-label', original);
          btn.textContent = ok ? S.copied : S.copyFailed;
          btn.classList.toggle('copied', ok);
          setTimeout(function () { btn.textContent = original; btn.classList.remove('copied'); }, 1400);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(value).then(function () { done(true); }, function () { done(fallbackCopy(value)); });
        else done(fallbackCopy(value));
      }
      function fallbackCopy(value) {
        var ta = document.createElement('textarea');
        ta.value = value; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta);
        return ok;
      }

      resultsEl.addEventListener('click', function (ev) {
        var copyBtn = ev.target.closest('.scd-copy');
        if (copyBtn) { copyText(copyBtn, copyBtn.getAttribute('data-copy') || ''); return; }
        var item = ev.target.closest('.scd-chain-item');
        if (item) { state.selected = Number(item.getAttribute('data-index')); showSelected(); }
      });
      var hostTimer = null;
      resultsEl.addEventListener('input', function (ev) {
        if (ev.target.id !== 'scd-host') return;
        state.host = ev.target.value;
        clearTimeout(hostTimer);
        hostTimer = setTimeout(renderHost, 150);
      });

      var inputTimer = null;
      inputEl.addEventListener('input', function () {
        clearTimeout(inputTimer);
        inputTimer = setTimeout(function () { runDecode({ quiet: true }); }, 350);
      });
      document.getElementById('scd-decode').addEventListener('click', function () { clearTimeout(inputTimer); runDecode({ reveal: true }); });
      document.getElementById('scd-example').addEventListener('click', function () {
        clearTimeout(inputTimer);
        inputEl.value = EX.pem;
        var hostEl = document.getElementById('scd-host');
        if (hostEl) hostEl.value = EX.host;
        runDecode({ lead: fmt(S.exampleLoaded, { host: EX.host, date: EX.date }), reveal: true }).then(function () {
          var h = document.getElementById('scd-host');
          if (h && !h.value) { h.value = EX.host; state.host = EX.host; renderHost(); }
        });
      });
      document.getElementById('scd-clear').addEventListener('click', clearAll);
      function clearAll() {
        clearTimeout(inputTimer);
        state.run++;
        inputEl.value = '';
        resultsEl.hidden = true; resultsEl.innerHTML = '';
        state.certs = []; state.host = '';
        setStatus('', 'none');
        if (window.ztPersist) { try { window.ztPersist.clear(SLUG); } catch (e) {} }
      }
      document.getElementById('scd-open').addEventListener('click', function () { fileEl.click(); });
      fileEl.addEventListener('change', function () { if (fileEl.files && fileEl.files[0]) loadFile(fileEl.files[0]); fileEl.value = ''; });
      inputEl.addEventListener('dragover', function (e) { e.preventDefault(); inputEl.classList.add('is-drag'); });
      inputEl.addEventListener('dragleave', function () { inputEl.classList.remove('is-drag'); });
      inputEl.addEventListener('drop', function (e) {
        inputEl.classList.remove('is-drag');
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) { e.preventDefault(); loadFile(e.dataTransfer.files[0]); }
      });

      function loadFile(file) {
        if (file.size > 1048576) { setStatus(S.errFileTooLarge, 'error'); return; }
        file.arrayBuffer().then(function (buf) {
          var bytes = new Uint8Array(buf);
          var conv = fileToText(bytes);
          if (conv.error) { resultsEl.hidden = true; resultsEl.innerHTML = ''; setStatus(conv.error, 'error'); return; }
          inputEl.value = conv.text;
          var kindText = conv.kind === 'der' ? S.fileDer : conv.kind === 'pkcs7' ? fmt(S.filePkcs7, { n: conv.count }) : S.fileText;
          var lead = fmt(S.fileLoaded, { name: file.name, kind: kindText }) + (conv.removedKey ? ' ' + S.fileKeyRemoved : '');
          runDecode({ lead: lead, reveal: true });
        }, function () { setStatus(S.errFileRead, 'error'); });
      }

      // Converts a file to PEM text for the input box. Private keys and PKCS #12 never reach the box.
      function fileToText(bytes) {
        if (bytes.length && bytes[0] === 0x30) {
          var cls = classifyDer(bytes);
          if (cls.kind === 'privateKey') return { error: S.notePrivateKeyDer };
          if (cls.kind === 'pkcs12') return { error: S.notePkcs12 };
          if (cls.kind === 'pkcs7') {
            try {
              var list = pkcs7Certificates(bytes);
              return { text: list.map(function (d) { return toPem(d); }).join(''), kind: 'pkcs7', count: list.length };
            } catch (e) { return { error: errorText(e) }; }
          }
          if (cls.kind === 'invalid') return { error: errorText(cls.error) };
          return { text: toPem(bytes), kind: 'der' };
        }
        var text = new TextDecoder('utf-8').decode(bytes);
        var removed = false;
        text = text.replace(/-----BEGIN ([A-Z0-9 ]*PRIVATE KEY)-----[\s\S]*?-----END \1-----\s*/g, function () { removed = true; return ''; });
        return { text: text, kind: 'text', removedKey: removed };
      }

      // The site-wide Ctrl/⌘+L shortcut empties the text fields; reset the results with them.
      document.addEventListener('keydown', function (e) {
        var wrap = document.querySelector('.scd-wrap');
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && wrap && wrap.contains(document.activeElement)) setTimeout(clearAll, 0);
      });

      if (window.ztPersist) {
        try {
          var saved = window.ztPersist.load(SLUG);
          if (saved && typeof saved === 'string' && !/PRIVATE KEY-----/.test(saved)) { inputEl.value = saved; runDecode({ quiet: true }); }
          else if (saved) window.ztPersist.clear(SLUG);
        } catch (e) {}
      }
    })();
  </script>

  <style is:global>
    .scd-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; }
    .scd-input { min-height: 150px; font-family: var(--font-mono); font-size: 0.82rem; }
    .scd-input.is-drag { outline: 2px dashed var(--color-primary); outline-offset: 2px; }
    .scd-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
    .scd-hint { margin: 0; font-size: 0.8rem; color: var(--color-text-muted); }
    .scd-wrap .tool-status { white-space: pre-line; }
    .scd-results { display: grid; gap: 0.75rem; min-width: 0; }
    .scd-detail { display: grid; gap: 0.75rem; min-width: 0; }
    .scd-grid-2 { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
    @media (min-width: 760px) { .scd-grid-2 { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
    .scd-card {
      background: var(--color-surface);
      border-radius: var(--radius-lg);
      padding: 0.9rem 1rem;
      box-shadow: inset 0 0 0 1px var(--color-border-soft), var(--shadow-card);
      display: flex; flex-direction: column; gap: 0.5rem; min-width: 0;
    }
    .scd-card-title {
      margin: 0; font-family: var(--font-sans); font-size: 0.78rem; font-weight: 700;
      letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-primary);
    }
    .scd-card-body { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
    .scd-row {
      display: flex; gap: 0.7rem; align-items: center; flex-wrap: wrap;
      padding: 0.4rem 0.6rem; border-radius: var(--radius-md);
      background: var(--color-bg-secondary); box-shadow: inset 0 0 0 1px var(--color-border-soft); min-width: 0;
    }
    .scd-row-label {
      font-size: 0.78rem; font-weight: 700; letter-spacing: 0.02em;
      color: var(--color-text-secondary); flex: 0 0 auto; min-width: 8rem;
    }
    .scd-row-value { flex: 1 1 12rem; min-width: 0; font-size: 0.88rem; color: var(--color-text); overflow-wrap: anywhere; }
    .scd-mono { font-family: var(--font-mono); font-size: 0.8rem; overflow-wrap: anywhere; }
    .scd-muted { color: var(--color-text-muted); font-size: 0.8rem; }
    .scd-copy { flex: 0 0 auto; }
    .scd-tag {
      display: inline-flex; align-items: center; padding: 0.15rem 0.55rem; border-radius: var(--radius-pill);
      font-size: 0.76rem; font-weight: 700; white-space: nowrap;
      box-shadow: inset 0 0 0 1px color-mix(in oklch, currentColor 35%, transparent);
      background: color-mix(in oklch, currentColor 10%, transparent);
    }
    .scd-st-valid { color: var(--color-success); }
    .scd-st-expired { color: var(--color-danger); }
    .scd-st-soon { color: var(--color-accent); }
    .scd-st-future { color: var(--color-text-secondary); }
    .scd-chip {
      display: inline-flex; align-items: center; padding: 0.15rem 0.6rem; border-radius: var(--radius-pill);
      background: var(--color-bg-secondary); color: var(--color-text-secondary); font-size: 0.8rem; font-weight: 600;
      margin: 0 0.3rem 0.3rem 0; box-shadow: inset 0 0 0 1px var(--color-border-soft); overflow-wrap: anywhere;
    }
    .scd-chip-critical { color: var(--color-danger); }
    .scd-chain-msgs, .scd-checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
    .scd-msg {
      margin: 0; padding: 0.45rem 0.7rem; border-radius: var(--radius-md); font-size: 0.86rem; line-height: 1.45;
      background: var(--color-bg-secondary); box-shadow: inset 3px 0 0 var(--color-text-muted);
    }
    .scd-msg-ok { box-shadow: inset 3px 0 0 var(--color-success); }
    .scd-msg-bad { box-shadow: inset 3px 0 0 var(--color-danger); }
    .scd-msg-warn { box-shadow: inset 3px 0 0 var(--color-accent); }
    .scd-msg-info { box-shadow: inset 3px 0 0 var(--color-primary); }
    .scd-chain-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
    .scd-chain-item {
      width: 100%; text-align: left; display: flex; flex-direction: column; gap: 0.25rem;
      padding: 0.55rem 0.7rem; border: 0; border-radius: var(--radius-md); cursor: pointer;
      background: var(--color-bg-secondary); color: var(--color-text); font: inherit;
      box-shadow: inset 0 0 0 1px var(--color-border-soft); min-height: 44px;
    }
    .scd-chain-item:hover { box-shadow: inset 0 0 0 1px var(--color-border); }
    .scd-chain-item:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
    .scd-chain-item.is-active { box-shadow: inset 0 0 0 2px var(--color-primary); background: var(--color-surface); }
    .scd-chain-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; min-width: 0; }
    .scd-chain-head .scd-chip { margin: 0; }
    .scd-chain-num { font-family: var(--font-mono); font-weight: 700; color: var(--color-text-secondary); }
    .scd-chain-name { font-weight: 700; overflow-wrap: anywhere; min-width: 0; }
    .scd-link { font-size: 0.8rem; color: var(--color-text-secondary); overflow-wrap: anywhere; }
    .scd-link-bad { color: var(--color-danger); }
    .scd-note { margin: 0; font-size: 0.8rem; color: var(--color-text-muted); }
    .scd-host { display: grid; gap: 0.35rem; }
    .scd-host-result:empty { display: none; }
    .scd-san { display: flex; flex-wrap: wrap; gap: 0.3rem; }
    .scd-san-item {
      display: inline-flex; gap: 0.35rem; align-items: baseline; padding: 0.2rem 0.55rem; border-radius: var(--radius-md);
      background: var(--color-bg-secondary); box-shadow: inset 0 0 0 1px var(--color-border-soft);
      font-family: var(--font-mono); font-size: 0.8rem; overflow-wrap: anywhere; min-width: 0;
    }
    .scd-san-type { font-family: var(--font-sans); font-size: 0.7rem; font-weight: 700; color: var(--color-text-muted); }
    .scd-ext { padding: 0.5rem 0.6rem; border-radius: var(--radius-md); background: var(--color-bg-secondary); box-shadow: inset 0 0 0 1px var(--color-border-soft); display: grid; gap: 0.35rem; min-width: 0; }
    .scd-ext .scd-row { background: var(--color-surface); }
    .scd-ext-head { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; font-weight: 700; }
    .scd-ext-head .scd-chip { margin: 0; }
    .scd-ext-body { font-size: 0.86rem; overflow-wrap: anywhere; min-width: 0; }
    .scd-policy { padding: 0.2rem 0; }
    .scd-sub { padding-left: 1rem; font-size: 0.82rem; color: var(--color-text-secondary); overflow-wrap: anywhere; }
    .scd-sct { display: grid; gap: 0.3rem; padding-bottom: 0.35rem; border-bottom: 1px solid var(--color-border-soft); }
    .scd-sct:last-child { border-bottom: 0; }
    .scd-details summary { cursor: pointer; font-size: 0.82rem; color: var(--color-text-secondary); padding: 0.2rem 0; }
    .scd-details .scd-mono { display: block; padding: 0.4rem 0.6rem; }
    @media (max-width: 640px) {
      .scd-input { min-height: 110px; }
      .scd-row-label { min-width: 0; flex: 0 0 100%; }
      .scd-details summary { min-height: 24px; display: flex; align-items: center; }
    }
  </style>
</div>
