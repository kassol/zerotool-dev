---
import Toggletip from '../Toggletip.astro';

// SecretRedactorTool — mask credentials in text before pasting it into an AI chat,
// then restore the placeholders in the reply.
// Runs in the browser: fixed regex rule table + Shannon-entropy fallback, no dependencies.
// Privacy: persistence policy is `disabled` (src/data/persistence.ts); the placeholder
// mapping lives in one closure variable and is rebuilt from the current input on every run.
// The detection/restore engine sits between the `engine:start` / `engine:end` markers so
// scripts/test-secret-redactor.mjs can extract and test the shipped code.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: {
    tips: {"input": "Paste logs, .env files, config or code. Detection runs 0.25 seconds after typing stops. The limit is 1,000,000 characters; split larger text.", "example": "Load a sample .env and log with dummy credentials. The same value uses the same placeholder wherever it appears. Loading the example replaces the original text and rebuilds its mapping.", "clear": "Clear removes both inputs, both results and the in-memory mapping. Ctrl/Cmd+L does the same while focus is in the tool. Detector selections stay unchanged.", "detect": "All six categories start enabled. Open Detect to change them; each change immediately rebuilds the mapping. With every category off, the output is the original text. High-entropy detection requires 32+ base64 characters, mixed upper/lower case and digits, and at least 4.2 bits of Shannon entropy per character.", "output": "Copy the full redacted text into your AI prompt. Ask the assistant to preserve bracketed placeholders such as [OPENAI_KEY_1] exactly, so the reply can be restored.", "findings": "Expand Findings to see each distinct placeholder, the matching rule, a masked value preview and its occurrence count. A repeated value shares one placeholder.", "reply": "Paste the AI reply. Restoration runs 0.15 seconds after typing stops, using the current mapping. Case changes, spaces inside brackets and Markdown-escaped brackets are accepted; names without brackets remain unchanged.", "restored": "Copy the full restored reply into your terminal or editor. Unmatched placeholders stay unchanged; unknown uppercase placeholders are listed below. If copying fails, select the text and copy it manually."},
    reviewHint: "Detection can miss secrets. Review the redacted text before sharing it.",
    restoredHint: "The restored reply contains the original secret values. Check where you paste it.",
    inputLabel: '① Paste text with secrets',
    inputPlaceholder: 'Paste logs, .env files, config or code — e.g. OPENAI_API_KEY=sk-proj-…',
    loadExample: 'Load example',
    clear: 'Clear',
    detect: 'Detect',
    catAi: 'AI provider keys',
    catCloud: 'Cloud & SaaS tokens',
    catToken: 'JWT & auth headers',
    catPrivateKey: 'Private keys',
    catPassword: 'Passwords & connection strings',
    catEntropy: 'High-entropy strings',
    outputLabel: '② Redacted text',
    outputEmpty: 'The redacted text appears here.',
    findings: 'Findings',
    chars: '{n} chars',
    replyLabel: '③ Paste the AI reply to restore',
    replyPlaceholder: 'Paste the reply that contains placeholders such as [OPENAI_KEY_1]',
    replyHint: "Keep the original text in ① and the detector settings unchanged until you restore the reply. The mapping is rebuilt from the current text and settings.",
    restoredLabel: 'Restored reply',
    restoredEmpty: 'The restored reply appears here.',
    copy: 'Copy',
    copied: 'Copied',
    copyFailed: 'Could not copy. Select and copy the text manually.',
    statusEmpty: 'Paste text to scan.',
    statusTooLong: 'Input is {n} characters; the limit is 1,000,000. Split the text.',
    statusAllOff: 'All detectors are off.',
    statusNone: 'No secrets detected.',
    statusFound: '{n} {secrets} found → {m} {placeholders}',
    secretOne: 'secret', secretMany: 'secrets',
    placeholderOne: 'placeholder', placeholderMany: 'placeholders',
    restoreEmptyMapping: 'Nothing to restore — the mapping is empty.',
    restoreNone: 'No placeholders found in the reply.',
    restoreDone: 'Restored {x} {placeholders} ({y} distinct of {z} in the mapping)',
    restoreUnknown: 'Unknown placeholders left unchanged: {list}',
  },
  zh: {
    tips: {"input": "粘贴日志、.env、配置或代码。停止输入 0.25 秒后检测。上限为 1,000,000 个字符，更长的文本请拆分。", "example": "加载含示例凭据的 .env 和日志。同一个值在各处使用相同占位符。加载示例会替换原文并重新生成映射。", "clear": "清空会移除两处输入、两处结果和内存中的映射。焦点在工具内时，Ctrl/Cmd+L 执行相同清理。检测开关保持不变。", "detect": "六类检测默认全部开启。展开「检测」可修改开关，每次修改都会立即重建映射。全部关闭时，输出就是原文。高熵检测要求至少 32 个 base64 字符，同时含大写、小写和数字，且香农熵不低于每字符 4.2 bit。", "output": "复制完整的脱敏文本到 AI 提问中。请让 AI 原样保留 [OPENAI_KEY_1] 这类带方括号的占位符，以便还原回复。", "findings": "展开检测明细，查看各个不同的占位符、命中规则、遮住部分字符的值预览及出现次数。同一个值重复出现时共用占位符。", "reply": "粘贴 AI 回复，停止输入 0.15 秒后使用当前映射还原。支持大小写变化、括号内空格和 Markdown 转义的括号；没有括号的名称保持原样。", "restored": "复制完整的还原结果到终端或编辑器。未匹配的占位符保持原样，未知的大写占位符会在下方列出。复制失败时，请选中文本后手动复制。"},
