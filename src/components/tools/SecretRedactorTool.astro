    placeholderOne: '', placeholderMany: '',
    restoreEmptyMapping: '復元するものがありません。対応表が空です。',
    restoreNone: '返答にプレースホルダーが見つかりません。',
    restoreDone: '{x} 箇所を復元しました（対応表 {z} 個中 {y} 個）',
    restoreUnknown: '不明なプレースホルダー（変更なし）：{list}',
  },
  ko: {
    inputLabel: '① 시크릿이 포함된 텍스트 붙여넣기',
    inputPlaceholder: '로그, .env, 설정 파일, 코드를 붙여넣기 (예: OPENAI_API_KEY=sk-proj-…)',
    loadExample: '예제 불러오기',
    clear: '지우기',
    detect: '감지 대상',
    catAi: 'AI 제공자 키',
    catCloud: '클라우드·SaaS 토큰',
    catToken: 'JWT·인증 헤더',
    catPrivateKey: '개인 키',
    catPassword: '비밀번호·연결 문자열',
    catEntropy: '고엔트로피 문자열',
    outputLabel: '② 마스킹된 텍스트',
    outputEmpty: '마스킹된 텍스트가 여기에 표시됩니다.',
    findings: '감지 목록',
    chars: '{n}자',
    replyLabel: '③ AI 답변을 붙여넣어 복원',
    replyPlaceholder: '[OPENAI_KEY_1] 같은 플레이스홀더가 포함된 답변을 붙여넣기',
    replyHint: '복원은 ①의 매핑을 사용합니다. 복원이 끝날 때까지 ①을 바꾸지 마세요.',
    restoredLabel: '복원된 답변',
    restoredEmpty: '복원된 답변이 여기에 표시됩니다.',
    copy: '복사',
    copied: '복사됨',
    statusEmpty: '텍스트를 붙여넣으면 검사를 시작합니다.',
    statusTooLong: '입력이 {n}자입니다. 한도는 1,000,000자입니다. 나눠서 붙여넣으세요.',
    statusAllOff: '모든 감지 대상이 꺼져 있습니다.',
    statusNone: '감지된 시크릿이 없습니다.',
    statusFound: '시크릿 {n}건 감지 → 플레이스홀더 {m}개',
    secretOne: '', secretMany: '',
    placeholderOne: '', placeholderMany: '',
    restoreEmptyMapping: '복원할 내용이 없습니다. 매핑이 비어 있습니다.',
    restoreNone: '답변에서 플레이스홀더를 찾지 못했습니다.',
    restoreDone: '{x}곳 복원 완료 (매핑 {z}개 중 {y}개 사용)',
    restoreUnknown: '알 수 없는 플레이스홀더(변경 안 함): {list}',
  },
} as const;

const L = labels[lang];
const categories = [
  { id: 'ai', name: L.catAi },
  { id: 'cloud', name: L.catCloud },
  { id: 'token', name: L.catToken },
  { id: 'private-key', name: L.catPrivateKey },
  { id: 'password', name: L.catPassword },
  { id: 'entropy', name: L.catEntropy },
];
---

<div class="scr-wrap">
  <section class="scr-section">
    <div class="scr-row">
      <label class="tool-label" for="scr-input">{L.inputLabel}</label>
      <div class="scr-actions">
        <button id="scr-example" class="btn-ghost" type="button">{L.loadExample}</button>
        <button id="scr-clear" class="btn-ghost" type="button">{L.clear}</button>
      </div>
    </div>
    <textarea
      id="scr-input"
      class="tool-textarea"
      rows="8"
      placeholder={L.inputPlaceholder}
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
    ></textarea>
    <div class="scr-toggles" role="group" aria-labelledby="scr-detect-label">
      <span class="scr-toggles-legend" id="scr-detect-label">{L.detect}</span>
      {categories.map((c) => (
        <label class={`scr-pill scr-pill-${c.id}`}>
          <input type="checkbox" data-cat={c.id} checked />
          <span>{c.name}</span>
          <span class="scr-pill-count" data-count={c.id}>0</span>
        </label>
      ))}
    </div>
    <p id="scr-status" class="tool-status none" aria-live="polite">{L.statusEmpty}</p>
  </section>

  <section class="scr-section">
    <div class="scr-row">
      <span class="tool-label" id="scr-output-label">{L.outputLabel}</span>
      <button id="scr-copy" class="btn-copy" type="button" disabled>{L.copy}</button>
    </div>
    <div class="scr-out-wrap">
      <pre id="scr-output" class="scr-out" tabindex="0" aria-labelledby="scr-output-label" data-empty={L.outputEmpty}></pre>
    </div>
    <details id="scr-findings" class="scr-findings" hidden>
      <summary>{L.findings} (<span id="scr-findings-count">0</span>)</summary>
      <div id="scr-findings-list" class="scr-findings-list"></div>
    </details>
  </section>

  <section class="scr-section">
    <label class="tool-label" for="scr-reply">{L.replyLabel}</label>
    <textarea
      id="scr-reply"
      class="tool-textarea"
      rows="6"
      placeholder={L.replyPlaceholder}
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
    ></textarea>
    <p class="scr-hint">{L.replyHint}</p>
    <p id="scr-restore-status" class="tool-status none" aria-live="polite"></p>
    <p id="scr-unknown" class="tool-status info scr-unknown" hidden></p>
    <div class="scr-row">
      <span class="tool-label" id="scr-restored-label">{L.restoredLabel}</span>
      <button id="scr-copy-restored" class="btn-copy" type="button" disabled>{L.copy}</button>
    </div>
    <div class="scr-out-wrap">
      <pre id="scr-restored" class="scr-out" tabindex="0" aria-labelledby="scr-restored-label" data-empty={L.restoredEmpty}></pre>
    </div>
  </section>
</div>

<script is:inline define:vars={{ T: L }}>
  (function () {
    var wrap = document.querySelector('.scr-wrap');
    if (!wrap) return;

    /* ── engine:start ── */
    var LIMIT = 1000000;
    var RULES = [
      { id: 'private-key', cat: 'private-key', label: 'PRIVATE_KEY', re: /-----BEGIN[A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----[\s\S]*?(?:-----END[A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----|$(?![\s\S]))/gd },
      { id: 'anthropic-key', cat: 'ai', label: 'ANTHROPIC_KEY', re: /\bsk-ant-[a-z]{3,6}\d{2}-[A-Za-z0-9_-]{32,}/gd },
      { id: 'openai-key', cat: 'ai', label: 'OPENAI_KEY', re: /\bsk-(?:proj|svcacct|admin)-[A-Za-z0-9_-]{32,}/gd },
      { id: 'openai-legacy-key', cat: 'ai', label: 'OPENAI_KEY', re: /\bsk-[A-Za-z0-9]{20}T3BlbkFJ[A-Za-z0-9]{20}\b/gd },
      { id: 'huggingface-token', cat: 'ai', label: 'HF_TOKEN', re: /\bhf_[A-Za-z0-9]{34,}\b/gd },
      { id: 'generic-sk-key', cat: 'ai', label: 'API_KEY', re: /\bsk-[A-Za-z0-9][A-Za-z0-9_-]{31,}/gd },
      { id: 'github-fine-grained-pat', cat: 'cloud', label: 'GITHUB_TOKEN', re: /\bgithub_pat_[A-Za-z0-9_]{80,}/gd },
      { id: 'github-token', cat: 'cloud', label: 'GITHUB_TOKEN', re: /\bgh[pousr]_[A-Za-z0-9]{36,}\b/gd },
      { id: 'gitlab-pat', cat: 'cloud', label: 'GITLAB_TOKEN', re: /\bglpat-[A-Za-z0-9_-]{20,}/gd },
      { id: 'slack-webhook', cat: 'cloud', label: 'SLACK_WEBHOOK', re: /https:\/\/hooks\.slack\.com\/(?:services|workflows|triggers)\/[A-Za-z0-9+/_-]{20,}/gd },
      { id: 'slack-token', cat: 'cloud', label: 'SLACK_TOKEN', re: /\bxox[abposr]-[A-Za-z0-9-]{10,}/gd },
      { id: 'stripe-secret-key', cat: 'cloud', label: 'STRIPE_KEY', re: /\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}\b/gd },
      { id: 'stripe-webhook-secret', cat: 'cloud', label: 'STRIPE_WEBHOOK_SECRET', re: /\bwhsec_[A-Za-z0-9+/=]{24,}/gd },
      { id: 'aws-access-key-id', cat: 'cloud', label: 'AWS_ACCESS_KEY', re: /\b(?:AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16}\b/gd },
      { id: 'aws-secret-access-key', cat: 'cloud', label: 'AWS_SECRET_KEY', re: /aws.{0,20}?secret.{0,20}?['"]?\s*[:=]\s*['"]?([A-Za-z0-9/+]{40})(?![A-Za-z0-9/+])/gdi },
      { id: 'google-api-key', cat: 'cloud', label: 'GOOGLE_API_KEY', re: /\bAIza[A-Za-z0-9_-]{35}(?![A-Za-z0-9_-])/gd },
      { id: 'google-oauth-secret', cat: 'cloud', label: 'GOOGLE_OAUTH_SECRET', re: /\bGOCSPX-[A-Za-z0-9_-]{28}(?![A-Za-z0-9_-])/gd },
      { id: 'sendgrid-key', cat: 'cloud', label: 'SENDGRID_KEY', re: /\bSG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}(?![A-Za-z0-9_-])/gd },
      { id: 'npm-token', cat: 'cloud', label: 'NPM_TOKEN', re: /\bnpm_[A-Za-z0-9]{36}\b/gd },
      { id: 'pypi-token', cat: 'cloud', label: 'PYPI_TOKEN', re: /\bpypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{50,}/gd },
      { id: 'telegram-bot-token', cat: 'cloud', label: 'TELEGRAM_BOT_TOKEN', re: /\b\d{8,10}:AA[A-Za-z0-9_-]{33}(?![A-Za-z0-9_-])/gd },
      { id: 'jwt', cat: 'token', label: 'JWT', re: /\beyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]*/gd },
      { id: 'basic-auth-header', cat: 'token', label: 'BASIC_AUTH', re: /\bAuthorization\s*[:=]\s*['"]?Basic\s+([A-Za-z0-9+/]{8,}={0,2})/gdi },
      { id: 'bearer-token', cat: 'token', label: 'BEARER_TOKEN', re: /\bBearer\s+([A-Za-z0-9._~+/-]{16,}={0,2})/gdi },
      { id: 'url-credential', cat: 'password', label: 'URL_PASSWORD', re: /\b[a-z][a-z0-9+.-]{1,30}:\/\/[^\s:/?#@'"]+:([^\s/?#@'"]+)@/gdi },
      { id: 'keyed-secret', cat: 'password', label: 'SECRET', keyed: true, re: /(?:^|[\s{,;(&?'"])[A-Za-z0-9_.-]{0,40}?(?:password|passwd|pwd|secret|secret[_-]?key|token|api[_-]?key|apikey|access[_-]?key|private[_-]?key|client[_-]?secret|auth[_-]?token|credentials?)['"]?\s*(?::|=|:=|=>)\s*['"]?([^\s'"`,;]{4,})/gdmi },
    ];
    var ENTROPY_RULE = { id: 'high-entropy', cat: 'entropy', label: 'HIGH_ENTROPY' };
    var CATEGORY_IDS = ['ai', 'cloud', 'token', 'private-key', 'password', 'entropy'];

    var PH_EXACT = /^\[[A-Z][A-Z0-9_]*_\d+\]$/;
    var PH_ANY = /\[[A-Z][A-Z0-9_]*_\d+\]/g;
    // `bearer` / `basic` added to the spec list: in `"token": "Bearer eyJ…"` the keyed
    // rule would otherwise mask the scheme word while rule 24 masks the credential.
    var KEYED_STOPWORDS = ['true', 'false', 'null', 'none', 'nil', 'undefined', 'required', 'optional', 'bearer', 'basic'];

    function keyedValueOk(v) {
      if (v[0] === '$' || v[0] === '%') return false;
      if (/^<.*>$/.test(v) || /^\{\{.*\}\}$/.test(v)) return false;
      if (/^(.)\1*$/.test(v)) return false;
      if (KEYED_STOPWORDS.indexOf(v.toLowerCase()) !== -1) return false;
      return true;
    }

    function shannon(s) {
      var freq = {};
      for (var i = 0; i < s.length; i++) freq[s[i]] = (freq[s[i]] || 0) + 1;
      var h = 0;
      for (var k in freq) {
        var p = freq[k] / s.length;
        h -= p * Math.log2(p);
      }
      return h;
    }

    function publicPemRanges(text) {
      var ranges = [];
      var re = /-----BEGIN (CERTIFICATE|CERTIFICATE REQUEST|PUBLIC KEY|X509 CRL)-----[\s\S]*?-----END \1-----/g;
      var m;
      while ((m = re.exec(text)) !== null) ranges.push([m.index, m.index + m[0].length]);
      return ranges;
    }

    function entropyHits(text) {
      var out = [];
      var pem = publicPemRanges(text);
      var re = /[A-Za-z0-9+/_-]{32,}={0,2}/g;
      var m;
      while ((m = re.exec(text)) !== null) {
        var run = m[0].replace(/=+$/, '');
        var start = m.index;
        if (!/[A-Z]/.test(run) || !/[a-z]/.test(run) || !/[0-9]/.test(run)) continue;
        if (shannon(run) < 4.2) continue;
        var pathSegs = run.split('/').filter(function (seg) { return /^[a-z][a-z0-9_-]{2,}$/.test(seg); });
        if (pathSegs.length >= 2) continue;
        if (/^sha(?:1|256|384|512)-/.test(run)) continue;
        if (text.slice(Math.max(0, start - 7), start) === 'base64,') continue;
        var inPem = false;
        for (var i = 0; i < pem.length; i++) {
          if (start >= pem[i][0] && start < pem[i][1]) { inPem = true; break; }
        }
        if (inPem) continue;
        out.push({ s: start, e: start + m[0].length });
      }
      return out;
    }

    // Returns { hits, output, entries }. hits: accepted spans in text order, each with
    // its entry; entries: one per distinct value { ph, value, label, rule, cat, count }.
    function detect(text, enabled) {
      var raw = [];
      for (var r = 0; r < RULES.length; r++) {
        var rule = RULES[r];
        if (!enabled[rule.cat]) continue;
        rule.re.lastIndex = 0;
        var m;
        while ((m = rule.re.exec(text)) !== null) {
          if (m[0].length === 0) { rule.re.lastIndex++; continue; }
          var span = m.indices[1] || m.indices[0];
          var value = text.slice(span[0], span[1]);
          if (PH_EXACT.test(value)) continue;
          if (rule.keyed && !keyedValueOk(value)) continue;
          raw.push({ p: r, s: span[0], e: span[1], rule: rule });
        }
      }
      if (enabled.entropy) {
        var eh = entropyHits(text);
        for (var j = 0; j < eh.length; j++) raw.push({ p: RULES.length, s: eh[j].s, e: eh[j].e, rule: ENTROPY_RULE });
      }

      raw.sort(function (a, b) { return a.p - b.p || a.s - b.s || (b.e - b.s) - (a.e - a.s); });
      var taken = new Uint8Array(text.length);
      var hits = [];
      for (var h = 0; h < raw.length; h++) {
        var hit = raw[h];
        var free = true;
        for (var x = hit.s; x < hit.e; x++) { if (taken[x]) { free = false; break; } }
        if (!free) continue;
        taken.fill(1, hit.s, hit.e);
        hits.push(hit);
      }
      hits.sort(function (a, b) { return a.s - b.s; });

      var existing = new Set(text.match(PH_ANY) || []);
      var valueToEntry = new Map();
      var counters = {};
      var entries = [];
      var parts = [];
      var cursor = 0;
      for (var k = 0; k < hits.length; k++) {
        var cur = hits[k];
        var val = text.slice(cur.s, cur.e);
        var entry = valueToEntry.get(val);
        if (!entry) {
          var label = cur.rule.label;
          var n = counters[label] || 0;
          var ph;
          do { n++; ph = '[' + label + '_' + n + ']'; } while (existing.has(ph));
          counters[label] = n;
          entry = { ph: ph, value: val, label: label, rule: cur.rule.id, cat: cur.rule.cat, count: 0 };
          valueToEntry.set(val, entry);
          entries.push(entry);
        }
        entry.count++;
        cur.entry = entry;
        parts.push(text.slice(cursor, cur.s), entry.ph);
        cursor = cur.e;
      }
      parts.push(text.slice(cursor));
      return { hits: hits, output: parts.join(''), entries: entries };
    }

    // Returns { parts, text, total, distinct, unknown }. parts: strings, or
    // { value } objects for restored spans.
    function restore(reply, entries) {
      var lookup = new Map();
      for (var i = 0; i < entries.length; i++) lookup.set(entries[i].ph.slice(1, -1), entries[i].value);
      var re = /\\?\[\s*([A-Za-z][A-Za-z0-9_]*_\d+)\s*\\?\]/g;
      var parts = [];
      var used = new Set();
      var unknown = [];
      var total = 0;
      var cursor = 0;
      var m;
      while ((m = re.exec(reply)) !== null) {
        var key = m[1].toUpperCase();
        if (lookup.has(key)) {
          parts.push(reply.slice(cursor, m.index), { value: lookup.get(key) });
          cursor = m.index + m[0].length;
          total++;
          used.add(key);
        } else if (/^[A-Z][A-Z0-9_]*_\d+$/.test(m[1]) && unknown.indexOf('[' + m[1] + ']') === -1) {
          unknown.push('[' + m[1] + ']');
        }
      }
      parts.push(reply.slice(cursor));
      var text = parts.map(function (p) { return typeof p === 'string' ? p : p.value; }).join('');
      return { parts: parts, text: text, total: total, distinct: used.size, unknown: unknown };
    }

    /* ── engine:end ── */

    // First 4 + last 2 characters; length only when the value is shorter than 12.
    function maskPreview(value) {
      var len = '(' + fmt(T.chars, { n: value.length }) + ')';
      if (value.length < 12) return '••• ' + len;
      return value.slice(0, 4) + '…' + value.slice(-2) + ' ' + len;
    }

    var input = wrap.querySelector('#scr-input');
    var reply = wrap.querySelector('#scr-reply');
    var status = wrap.querySelector('#scr-status');
    var output = wrap.querySelector('#scr-output');
    var copyBtn = wrap.querySelector('#scr-copy');
    var findings = wrap.querySelector('#scr-findings');
    var findingsCount = wrap.querySelector('#scr-findings-count');
    var findingsList = wrap.querySelector('#scr-findings-list');
    var restoreStatus = wrap.querySelector('#scr-restore-status');
    var unknownEl = wrap.querySelector('#scr-unknown');
    var restored = wrap.querySelector('#scr-restored');
    var copyRestoredBtn = wrap.querySelector('#scr-copy-restored');
    var toggles = wrap.querySelectorAll('input[data-cat]');
    var countEls = wrap.querySelectorAll('[data-count]');

    // The only place the mapping lives. Rebuilt by every runAll().
    var state = { output: '', entries: [] };
    var restoredText = '';

    function fmt(tpl, vars) {
      return tpl.replace(/\{(\w+)\}/g, function (_, k) { return vars[k] !== undefined ? String(vars[k]) : ''; }).replace(/\s{2,}/g, ' ').trim();
    }
    function escapeHtml(s) {
      return s.replace(/[&<>"]/g, function (c) {
        return c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : '&quot;';
      });
    }
    function setStatus(el, text, kind) {
      el.textContent = text;
      el.className = 'tool-status ' + kind;
    }
    function enabledMap() {
      var map = {};
      toggles.forEach(function (t) { map[t.getAttribute('data-cat')] = t.checked; });
      return map;
    }

    function runRedact() {
      var text = input.value;
      var enabled = enabledMap();
      var counts = {};
      CATEGORY_IDS.forEach(function (c) { counts[c] = 0; });
      var result = { hits: [], output: '', entries: [] };

      if (!text) {
        setStatus(status, T.statusEmpty, 'none');
      } else if (text.length > LIMIT) {
        setStatus(status, fmt(T.statusTooLong, { n: text.length.toLocaleString('en-US') }), 'error');
      } else if (!CATEGORY_IDS.some(function (c) { return enabled[c]; })) {
        result.output = text;
        setStatus(status, T.statusAllOff, 'none');
      } else {
        result = detect(text, enabled);
        result.hits.forEach(function (h) { counts[h.rule.cat]++; });
        if (!result.hits.length) {
          setStatus(status, T.statusNone, 'success');
        } else {
          var n = result.hits.length;
          var m = result.entries.length;
          setStatus(status, fmt(T.statusFound, {
            n: n, m: m,
            secrets: n === 1 ? T.secretOne : T.secretMany,
            placeholders: m === 1 ? T.placeholderOne : T.placeholderMany,
          }), 'success');
        }
      }

      state = { output: result.output, entries: result.entries };
      countEls.forEach(function (el) { el.textContent = String(counts[el.getAttribute('data-count')] || 0); });

      if (!result.hits.length) {
        output.textContent = result.output;
      } else {
        var html = '';
        var cursor = 0;
        var src = input.value;
        result.hits.forEach(function (h) {
          html += escapeHtml(src.slice(cursor, h.s));
          html += '<span class="scr-chip scr-chip-' + h.entry.cat + '">' + escapeHtml(h.entry.ph) + '</span>';
          cursor = h.e;
        });
        html += escapeHtml(src.slice(cursor));
        output.innerHTML = html;
      }
      copyBtn.disabled = !result.output;

      findingsList.textContent = '';
      findingsCount.textContent = String(result.entries.length);
      findings.hidden = result.entries.length === 0;
      if (!result.entries.length) findings.open = false;
      result.entries.forEach(function (e) {
        var row = document.createElement('div');
        row.className = 'scr-finding';
        var ph = document.createElement('span');
        ph.className = 'scr-chip scr-chip-' + e.cat;
        ph.textContent = e.ph;
        var rule = document.createElement('span');
        rule.className = 'scr-finding-rule';
        rule.textContent = e.rule;
        var preview = document.createElement('span');
        preview.className = 'scr-finding-preview';
        preview.textContent = maskPreview(e.value);
        var count = document.createElement('span');
        count.className = 'scr-finding-count';
        count.textContent = '×' + e.count;
        row.append(ph, count, rule, preview);
        findingsList.appendChild(row);
      });
    }

    function runRestore() {
      var text = reply.value;
      unknownEl.hidden = true;
      unknownEl.textContent = '';
      restoredText = '';
      if (!text) {
        setStatus(restoreStatus, '', 'none');
        restored.textContent = '';
      } else if (!state.entries.length) {
        setStatus(restoreStatus, T.restoreEmptyMapping, 'none');
        restored.textContent = '';
      } else {
        var r = restore(text, state.entries);
        restoredText = r.text;
        if (r.total === 0) {
          setStatus(restoreStatus, T.restoreNone, 'none');
        } else {
          setStatus(restoreStatus, fmt(T.restoreDone, {
            x: r.total, y: r.distinct, z: state.entries.length,
            placeholders: r.total === 1 ? T.placeholderOne : T.placeholderMany,
          }), 'success');
        }
        if (r.unknown.length) {
          unknownEl.textContent = fmt(T.restoreUnknown, { list: r.unknown.join(', ') });
          unknownEl.hidden = false;
        }
        restored.innerHTML = r.parts.map(function (p) {
          return typeof p === 'string' ? escapeHtml(p) : '<mark class="scr-restored">' + escapeHtml(p.value) + '</mark>';
        }).join('');
      }
      copyRestoredBtn.disabled = !restoredText;
    }

    function runAll() {
      runRedact();
      runRestore();
    }

    function debounce(fn, ms) {
      var timer;
      return function () { clearTimeout(timer); timer = setTimeout(fn, ms); };
    }

    function copy(text) {
      if (!text) return Promise.resolve(false);
      if (navigator.clipboard && navigator.clipboard.writeText) {
        return navigator.clipboard.writeText(text).then(function () { return true; }, function () { return fallbackCopy(text); });
      }
      return Promise.resolve(fallbackCopy(text));
    }
    function fallbackCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (_) {}
      document.body.removeChild(ta);
      return ok;
    }
    function flashCopied(btn) {
      btn.textContent = T.copied;
      btn.classList.add('copied');
      setTimeout(function () {
        btn.textContent = T.copy;
        btn.classList.remove('copied');
      }, 1400);
    }

    // Assembled at runtime so no token-shaped literal sits in the source (push protection,
    // repo scanners). AWS values are the vendor-documented dummies.
    function buildExample() {
      var oa = 'sk-' + 'proj-' + 'Q9vXmT2kLp8RwZ4nYb7Hc1Js5Df3Ga6E' + 'u0KiWoPqNr';
      var an = 'sk-' + 'ant-' + 'api03-' + 'Hn4Rt8Kq2Zx6Vb1Mc9Lw3Ps7Df5Gj0Ya' + 'Tu2Ei4Oo';
      var gh = 'gh' + 'p_' + 'Ab3De6Gh9Jk2Mn5Pq8St1Vw4Yz7Bc0Ef3Hi6';
      var pw = 'S3cure!' + 'Pass42';
      var jwt = 'ey' + 'JhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9' + '.ey' + 'JzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkFkYSJ9' + '.' + 'dBjftJeZ4CVPmB92K27uhbUJU1p1r_wW1gFWFOEjXk';
      return [
        '# .env',
        'OPENAI_API_KEY=' + oa,
        'ANTHROPIC_API_KEY=' + an,
        'AWS_ACCESS_KEY_ID=' + 'AKIA' + 'IOSFODNN7EXAMPLE',
        'AWS_SECRET_ACCESS_KEY=' + 'wJalrXUtnFEMI/K7MDENG/' + 'bPxRfiCYEXAMPLEKEY',
        'DATABASE_URL=postgres://app:' + pw + '@db.internal:5432/app',
        'GITHUB_TOKEN=' + gh,
        'MAX_TOKENS=1024',
        '',
        '# app.log',
        '2026-09-23T10:12:03Z POST /v1/chat/completions -> 401',
        '  Authorization: Bearer ' + jwt,
        '2026-09-23T10:12:04Z retry with key ' + oa + ' -> 200',
        '2026-09-23T10:12:05Z connected to postgres://app:' + pw + '@db.internal:5432/app',
      ].join('\n');
    }

    var runRedactDebounced = debounce(runAll, 250);
    var runRestoreDebounced = debounce(runRestore, 150);

    input.addEventListener('input', runRedactDebounced);
    reply.addEventListener('input', runRestoreDebounced);
    toggles.forEach(function (t) { t.addEventListener('change', runAll); });

    wrap.querySelector('#scr-example').addEventListener('click', function () {
      input.value = buildExample();
      runAll();
    });
    wrap.querySelector('#scr-clear').addEventListener('click', function () {
      input.value = '';
      reply.value = '';
      runAll();
      input.focus();
    });

    // ToolLayout's Ctrl/Cmd+L blanks textareas without firing `input`; re-run after it.
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L')) setTimeout(runAll, 0);
    });

    // Keep bfcache and form restoration from bringing secrets back.
    window.addEventListener('pagehide', function () {
      input.value = '';
      reply.value = '';
      runAll();
    });

    copyBtn.addEventListener('click', function () {
      copy(state.output).then(function (ok) {
        if (!ok) return;
        flashCopied(copyBtn);
        if (window.trackTool) window.trackTool('secret-redactor', 'redact_copy');
      });
    });
    copyRestoredBtn.addEventListener('click', function () {
      copy(restoredText).then(function (ok) {
        if (!ok) return;
        flashCopied(copyRestoredBtn);
        if (window.trackTool) window.trackTool('secret-redactor', 'restore_copy');
      });
    });

    runAll();
  })();
</script>

