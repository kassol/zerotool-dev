    copied: '已复制',
    statusEmpty: '粘贴文本开始检测。',
    statusTooLong: '输入共 {n} 个字符，上限为 1,000,000。请拆分后再粘贴。',
    statusAllOff: '所有检测类别均已关闭。',
    statusNone: '未检测到密钥。',
    statusFound: '发现 {n} 处密钥 → {m} 个占位符',
    secretOne: '', secretMany: '',
    placeholderOne: '', placeholderMany: '',
    restoreEmptyMapping: '没有可还原的内容——映射为空。',
    restoreNone: '回复中没有找到占位符。',
