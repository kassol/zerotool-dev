    jsonInput: 'JSON 입력',
    tsOutput: 'TypeScript 출력',
    example: '예시',
    clear: '지우기',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사하지 못했습니다. 출력을 직접 복사하세요.',
    generate: 'TypeScript 생성',
    msgInvalidJson: '잘못된 JSON: ',
    msgInvalidAt: '잘못된 JSON: {line}행 {col}열, {reason}.',
    jsonParse: {
      empty: '입력이 비어 있습니다',
      trailingComma: '닫는 괄호 앞에 쉼표가 남아 있습니다',
