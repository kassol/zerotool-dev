      /* ── json-reason:end ── */

      /* ── Main convert function ── */
      function convert() {
        invalidateCopy();
        clearTimeout(_jttLiveTimer);
        _jttLiveTimer = null;
        var raw = inputEl.value.trim();
        if (!raw) { inputEl.classList.remove('error'); clearStatus(); setOutput(''); return; }

        // Real-time error highlighting
        inputEl.classList.remove('error');

        var parsed;
        try {
          parsed = JSON.parse(raw);
        } catch (e) {
          inputEl.classList.add('error');
          setOutput('');
          setStatus(jsonErrorText(inputEl.value, e), true);
          return;
        }

        inputEl.classList.remove('error');

        var rootName = safeIdentifier(rootNameEl.value.trim()) || 'RootObject';
        var result;
        try {
          result = generateTypeScript(parsed, rootName, optionalEl.checked, useTypeEl.checked);
        } catch (e) {
          // For example a stack overflow on very deep nesting: never leave the previous output.
          setOutput('');
          setStatus(MSG_FAILED + (e && e.message ? e.message : String(e)), true);
          return;
        }
        setOutput(result.code);
        if (result.count === 0) setStatus(MSG_GENERATED, false);
        else setStatus(result.count === 1 ? MSG_GEN_ONE : MSG_GEN_MANY.replace('{n}', result.count), false);
      }

      /* Analytics: one event per committed edit, Generate or Example, not per typing pause.
         One action can fire both change (blur on mousedown) and click, so the same JSON,
         root name and options are sent once. */
      var lastTracked = null;
      function trackGenerate() {
        if (!outputCodeEl.textContent || inputEl.classList.contains('error')) return;
        var key = inputEl.value + '\u0000' + (rootNameEl.value.trim() || 'RootObject') + '\u0000' + optionalEl.checked + '\u0000' + useTypeEl.checked;
        if (key === lastTracked) return;
        lastTracked = key;
        window.trackTool && window.trackTool('json-to-typescript', 'generate');
      }

      /* ── Real-time generate (debounced 300ms) ── */
      var _jttLiveTimer = null;
      inputEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_jttLiveTimer);
        _jttLiveTimer = setTimeout(convert, 300);
      });
      inputEl.addEventListener('change', function () {
        if (_jttLiveTimer) convert();
        trackGenerate();
      });

      document.getElementById('jtt-convert').addEventListener('click', function () {
        convert();
        trackGenerate();
      });

      document.getElementById('jtt-example').addEventListener('click', function () {
        inputEl.value = EXAMPLE;
        inputEl.classList.remove('error');
        clearStatus();
        convert();
        trackGenerate();
      });

      document.getElementById('jtt-clear').addEventListener('click', function () {
        invalidateCopy();
        lastTracked = null;
        clearTimeout(_jttLiveTimer);
        _jttLiveTimer = null;
        inputEl.value = '';
        setOutput('');
        inputEl.classList.remove('error');
        clearStatus();
      });

      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && wrap && wrap.contains(document.activeElement)) {
          e.preventDefault();
          inputEl.focus();
          document.getElementById('jtt-clear').click();
        }
      });

      document.getElementById('jtt-copy').addEventListener('click', function () {
        var text = outputCodeEl.textContent;
        if (!text) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(COPY_FAILED, true);
          copyFailure = true;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            if (copyFailure) clearStatus();
            copyBtn.textContent = COPIED;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = COPY;
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });
    })();
  </script>
</div>

<style>
  .jtt-wrap { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; gap: 0.75rem; }
  .jtt-config { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .jtt-name-field { display: flex; flex-direction: column; gap: 0.25rem; width: 18rem; max-width: 100%; }
  .jtt-control-label { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .jtt-options { display: flex; align-items: center; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  .jtt-config label { font-size: 0.85rem; color: var(--color-text-secondary); display: flex; align-items: center; gap: 0.4rem; }
  .jtt-options label { min-height: 44px; }
  .jtt-name-field input {
    min-height: 44px; width: 100%; padding: 0.4rem 0.6rem; font-size: 0.85rem;
    font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg); color: var(--color-text);
  }
  .jtt-name-field input:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jtt-config :global(code) { font-size: 0.82rem; font-family: var(--font-mono); padding: 0.1rem 0.3rem; background: var(--color-bg); border-radius: 3px; }
  .jtt-panel-header { display: flex; justify-content: space-between; align-items: center; min-height: 44px; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .jtt-panel textarea, .jtt-output {
    width: 100%; min-width: 0; font-family: var(--font-mono); font-size: 0.82rem; padding: 0.75rem;
    border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg-secondary); color: var(--color-text); line-height: 1.5;
  }
  .jtt-panel textarea { transition: border-color 0.15s; }
  .jtt-panel textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }
  .jtt-panel textarea.error { border-color: #c0392b; }
  .jtt-output { margin: 0; overflow: auto; white-space: pre; }
  .jtt-output:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jtt-panel-header button:disabled { opacity: 0.5; cursor: not-allowed; }
  .jtt-empty { display: none; margin: 0; padding: 2rem; align-items: center; justify-content: center; text-align: center; color: var(--color-text-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .jtt-output-pane:has(#jtt-output-code:empty) .jtt-output { display: none; }
  .jtt-output-pane:has(#jtt-output-code:empty) .jtt-empty { display: flex; }
  .jtt-actions { display: flex; gap: 0.5rem 1rem; flex-wrap: wrap; }
  .jtt-status { font-size: 0.85rem; line-height: 1.4; min-height: 2.4rem; overflow-wrap: anywhere; }
  .jtt-status.success { color: #057a55; }
  .jtt-status.error { color: #c0392b; }
  @media (max-width: 860px) {
    .jtt-wrap { gap: 0.5rem; }
    .jtt-name-field { width: 100%; flex-direction: row; align-items: center; gap: 0.5rem; }
    .jtt-name-field .jtt-control-label { flex: 1; }
    .jtt-name-field input { width: 45%; flex: none; }
    .jtt-options { align-items: flex-start; flex-direction: column; gap: 0; }
    .jtt-actions button, .jtt-panel-header button { min-height: 44px; }
    .jtt-panel textarea { height: 144px; min-height: 144px; }
    .jtt-output { height: 22rem; min-height: 160px; resize: none; }
    .jtt-output-pane:has(#jtt-output-code:empty) { display: none; }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .jtt-status.success { color: #34d399; }
    :global(:root:not([data-theme="light"])) .jtt-status.error { color: #f87171; }
    :global(:root:not([data-theme="light"])) .jtt-panel textarea.error { border-color: #f87171; }
  }
