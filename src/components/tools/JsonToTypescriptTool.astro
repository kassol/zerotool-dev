---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: {
    useTypeAbout: "Use type instead of interface",
    empty: "Enter JSON or load the example to generate TypeScript.",
    tips: {
      "input": "Enter valid JSON without comments or trailing commas. Generation runs 300 ms after typing stops; invalid JSON clears the output and shows an error.",
      "rootName": "Enter a valid TypeScript name. A blank field uses RootObject. Click Generate TypeScript to apply a change.",
      "optional": "Add ? to every generated object property. Even when this is off, fields missing from some array items are optional. Click Generate TypeScript to apply the option.",
      "useType": "Generate object declarations with type instead of interface. Primitive roots already use type. Click Generate TypeScript to apply the option.",
      "generate": "Generate now with the current JSON, root name and options. Use this after changing the name or options. Ctrl/⌘+Enter also generates.",
      "example": "Replace the JSON input with a sample containing nested objects, arrays and null. Generate immediately with the current root name and options.",
      "clear": "Clear JSON, output and status. Keep the root name and both options. Ctrl/⌘+L, with focus in the tool, also clears the root name.",
      "copy": "Copy the complete displayed TypeScript output. Empty output is not copied."
    },
    rootName: 'Root interface name',
    makeOptional: 'Make properties optional',
    useType: 'Use <code>type</code> instead of <code>interface</code>',
    jsonInput: 'JSON Input',
    tsOutput: 'TypeScript Output',
    example: 'Example',
    clear: 'Clear',
    copy: 'Copy',
    copied: 'Copied!',
    copyFailed: 'Copy failed. Please copy the output manually.',
    generate: 'Generate TypeScript',
    msgInvalidJson: 'Invalid JSON: ',
    msgFailed: 'Could not generate TypeScript: ',
    msgGenerated: 'Generated.',
    msgGenOne: 'Generated 1 interface.',
    msgGenMany: 'Generated {n} interfaces.',
  },
  zh: {
    useTypeAbout: "使用 type 替代 interface",
    empty: "输入 JSON 或载入示例以生成 TypeScript。",
    tips: {
      "input": "输入合法 JSON，不能带注释或末尾逗号。停止输入 300 毫秒后自动生成；JSON 无效时会清空输出并显示错误。",
      "rootName": "请输入合法的 TypeScript 名称。留空时使用 RootObject。修改后点击生成 TypeScript 应用。",
      "optional": "为所有生成的对象属性添加 ?。未勾选时，对象数组中部分元素缺少的字段仍为可选。点击生成 TypeScript 应用选项。",
      "useType": "用 type 替代 interface 生成对象声明。基本类型的根值始终使用 type。点击生成 TypeScript 应用选项。",
      "generate": "立即按当前 JSON、根名和选项生成。修改根名或选项后，点击此按钮应用。也可按 Ctrl/⌘+Enter 生成。",
      "example": "用含嵌套对象、数组和 null 的示例替换 JSON 输入，并按当前根名和选项立即生成。",
      "clear": "清空 JSON、输出和状态，保留根名及两个选项。在工具内按 Ctrl/⌘+L 还会清空根名。",
      "copy": "复制当前显示的完整 TypeScript 输出。输出为空时不复制。"
    },
    rootName: '根接口名称',
    makeOptional: '属性设为可选',
    useType: '使用 <code>type</code> 替代 <code>interface</code>',
    jsonInput: 'JSON 输入',
    tsOutput: 'TypeScript 输出',
    example: '示例',
    clear: '清空',
    copy: '复制',
    copied: '已复制！',
    copyFailed: '复制失败，请手动复制输出。',
    generate: '生成 TypeScript',
    msgInvalidJson: 'JSON 格式错误：',
    msgFailed: '无法生成 TypeScript：',
    msgGenerated: '已生成。',
    msgGenOne: '已生成 1 个接口。',
    msgGenMany: '已生成 {n} 个接口。',
  },
  ja: {
    useTypeAbout: "interface の代わりに type を使用",
    empty: "JSON を入力するかサンプルを読み込むと、TypeScript を生成します。",
    tips: {
      "input": "コメントや末尾のカンマを含まない有効な JSON を入力します。入力を止めてから 300 ミリ秒後に生成します。無効な JSON では出力を消去し、エラーを表示します。",
      "rootName": "有効な TypeScript 名を入力します。空欄では RootObject を使います。変更後は 「TypeScript を生成」をクリックして適用します。",
      "optional": "生成するすべてのオブジェクトプロパティに ? を付けます。オフでも、配列の一部の要素にないフィールドは省略可能です。「TypeScript を生成」で適用します。",
      "useType": "オブジェクト宣言に interface の代わりに type を使います。プリミティブのルート値は常に type を使います。「TypeScript を生成」で適用します。",
      "generate": "現在の JSON、ルート名、設定で生成します。名前や設定の変更後にクリックして適用します。Ctrl/⌘+Enter でも生成できます。",
      "example": "JSON 入力を、ネストされたオブジェクト、配列、null を含むサンプルに置き換えます。現在のルート名と設定ですぐに生成します。",
      "clear": "JSON、出力、ステータスを消去し、ルート名と両方の設定を保持します。ツール内で Ctrl/⌘+L を押すとルート名も消去します。",
      "copy": "表示中の TypeScript 出力を全文コピーします。出力が空の場合はコピーしません。"
    },
    rootName: 'ルートインターフェース名',
    makeOptional: 'プロパティをオプションにする',
    useType: '<code>interface</code> の代わりに <code>type</code> を使用',
    jsonInput: 'JSON 入力',
    tsOutput: 'TypeScript 出力',
    example: 'サンプル',
    clear: 'クリア',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyFailed: 'コピーに失敗しました。出力を手動でコピーしてください。',
    generate: 'TypeScript を生成',
    msgInvalidJson: '無効なJSON：',
    msgFailed: 'TypeScript を生成できませんでした：',
    msgGenerated: '生成しました。',
    msgGenOne: '1 個の型を生成しました。',
    msgGenMany: '{n} 個の型を生成しました。',
  },
  ko: {
    useTypeAbout: "interface 대신 type 사용",
    empty: "JSON을 입력하거나 예시를 불러와 TypeScript를 생성하세요.",
    tips: {
      "input": "주석이나 끝 쉼표가 없는 유효한 JSON을 입력하세요. 입력을 멈춘 뒤 300밀리초 후 생성합니다. JSON이 잘못되면 출력을 지우고 오류를 표시합니다.",
      "rootName": "유효한 TypeScript 이름을 입력하세요. 비워 두면 RootObject를 사용합니다. 변경 후 TypeScript 생성을 클릭해 적용하세요.",
      "optional": "생성되는 모든 객체 속성에 ?를 붙입니다. 꺼져 있어도 배열의 일부 객체에 없는 필드는 선택적입니다. TypeScript 생성을 클릭해 적용하세요.",
      "useType": "객체 선언에 interface 대신 type을 사용합니다. 기본 타입의 루트 값은 항상 type을 사용합니다. TypeScript 생성을 클릭해 적용하세요.",
      "generate": "현재 JSON, 루트 이름, 옵션으로 즉시 생성합니다. 이름이나 옵션을 바꾼 뒤 클릭해 적용하세요. Ctrl/⌘+Enter로도 생성할 수 있습니다.",
      "example": "JSON 입력을 중첩 객체, 배열, null이 포함된 예시로 바꿉니다. 현재 루트 이름과 옵션으로 즉시 생성합니다.",
      "clear": "JSON, 출력, 상태를 지우고 루트 이름과 두 옵션은 유지합니다. 도구 안에서 Ctrl/⌘+L을 누르면 루트 이름도 지웁니다.",
      "copy": "현재 표시된 TypeScript 출력 전체를 복사합니다. 출력이 비어 있으면 복사하지 않습니다."
    },
    rootName: '루트 인터페이스 이름',
    makeOptional: '속성을 선택적으로 설정',
    useType: '<code>interface</code> 대신 <code>type</code> 사용',
    jsonInput: 'JSON 입력',
    tsOutput: 'TypeScript 출력',
    example: '예시',
    clear: '지우기',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사하지 못했습니다. 출력을 직접 복사하세요.',
    generate: 'TypeScript 생성',
    msgInvalidJson: '잘못된 JSON: ',
    msgFailed: 'TypeScript를 생성하지 못했습니다: ',
    msgGenerated: '생성 완료.',
    msgGenOne: '인터페이스 1개를 생성했습니다.',
    msgGenMany: '인터페이스 {n}개를 생성했습니다.',
  },
};

const L = STRINGS[lang];
---

<div
  class="jtt-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-msg-invalid-json={L.msgInvalidJson}
  data-msg-failed={L.msgFailed}
  data-msg-generated={L.msgGenerated}
  data-msg-gen-one={L.msgGenOne}
  data-msg-gen-many={L.msgGenMany}
>
  <div class="jtt-config">
    <div class="jtt-name-field">
      <div class="jtt-control-label">
        <label for="jtt-root-name">{L.rootName}</label>
        <Toggletip id="jtt-tip-root-name" lang={lang} about={L.rootName}>{L.tips.rootName}</Toggletip>
      </div>
      <input id="jtt-root-name" type="text" value="RootObject" spellcheck="false" />
    </div>
    <div class="jtt-options">
      <div class="jtt-control-label">
        <label for="jtt-optional"><input id="jtt-optional" type="checkbox" />{L.makeOptional}</label>
        <Toggletip id="jtt-tip-optional" lang={lang} about={L.makeOptional}>{L.tips.optional}</Toggletip>
      </div>
      <div class="jtt-control-label">
        <label for="jtt-use-type"><input id="jtt-use-type" type="checkbox" /><span set:html={L.useType} /></label>
        <Toggletip id="jtt-tip-use-type" lang={lang} about={L.useTypeAbout}>{L.tips.useType}</Toggletip>
      </div>
    </div>
  </div>

  <div class="jtt-actions">
    <div class="jtt-control-label">
      <button id="jtt-convert" class="btn-primary" type="button">{L.generate}</button>
      <Toggletip id="jtt-tip-generate" lang={lang} about={L.generate}>{L.tips.generate}</Toggletip>
    </div>
    <div class="jtt-control-label">
      <button id="jtt-example" class="btn-ghost" type="button">{L.example}</button>
      <Toggletip id="jtt-tip-example" lang={lang} about={L.example}>{L.tips.example}</Toggletip>
    </div>
    <div class="jtt-control-label">
      <button id="jtt-clear" class="btn-ghost" type="button">{L.clear}</button>
      <Toggletip id="jtt-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip>
    </div>
  </div>
  <div id="jtt-status" class="jtt-status" aria-live="polite"></div>

  <div class="jtt-panels zt-io">
    <div class="jtt-panel zt-io-pane">
      <div class="jtt-panel-header">
        <div class="jtt-control-label">
          <label for="jtt-input">{L.jsonInput}</label>
          <Toggletip id="jtt-tip-input" lang={lang} about={L.jsonInput}>{L.tips.input}</Toggletip>
        </div>
      </div>
      <textarea
        id="jtt-input"
        class="zt-io-fill"
        placeholder='{"name": "Alice", "age": 30, "address": {"city": "London"}}'
        spellcheck="false"
      ></textarea>
    </div>

    <div class="jtt-panel jtt-output-pane zt-io-pane">
      <div class="jtt-panel-header">
        <span id="jtt-output-label">{L.tsOutput}</span>
        <div class="jtt-control-label">
          <button id="jtt-copy" class="btn-ghost" type="button">{L.copy}</button>
          <Toggletip id="jtt-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip>
        </div>
      </div>
      <p class="jtt-empty zt-io-fill">{L.empty}</p>
      <pre id="jtt-output" class="jtt-output zt-io-fill" tabindex="0" aria-labelledby="jtt-output-label"><code id="jtt-output-code"></code></pre>
    </div>
  </div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.jtt-wrap')
        : document.querySelector('.jtt-wrap');

      var COPY = wrap ? wrap.dataset.copy : 'Copy';
      var COPIED = wrap ? wrap.dataset.copied : 'Copied!';
      var COPY_FAILED = wrap ? wrap.dataset.copyFailed : 'Copy failed. Please copy the output manually.';
      var MSG_INVALID = wrap ? wrap.dataset.msgInvalidJson : 'Invalid JSON: ';
      var MSG_FAILED = wrap ? wrap.dataset.msgFailed : 'Could not generate TypeScript: ';
      var MSG_GENERATED = wrap ? wrap.dataset.msgGenerated : 'Generated.';
      var MSG_GEN_ONE = wrap ? wrap.dataset.msgGenOne : 'Generated 1 interface.';
      var MSG_GEN_MANY = wrap ? wrap.dataset.msgGenMany : 'Generated {n} interfaces.';

      var inputEl = document.getElementById('jtt-input');
      var outputCodeEl = document.getElementById('jtt-output-code');
      var statusEl = document.getElementById('jtt-status');
      var rootNameEl = document.getElementById('jtt-root-name');
      var optionalEl = document.getElementById('jtt-optional');
      var useTypeEl = document.getElementById('jtt-use-type');
      var copyBtn = document.getElementById('jtt-copy');
      var copyRevision = 0;
      var copyTimer = null;
      var copyFailure = false;

      // Copy is enabled only while there is output to copy.
      function setOutput(text) {
        outputCodeEl.textContent = text;
        copyBtn.disabled = !text;
      }
      setOutput('');

      var EXAMPLE = JSON.stringify({
        id: 1,
        name: "Alice",
        isActive: true,
        score: 9.5,
        tags: ["typescript", "json"],
        address: {
          city: "London",
          zip: "EC1A 1BB"
        },
        friends: [
          { id: 2, name: "Bob" },
          { id: 3, name: "Carol" }
        ],
        metadata: null
      }, null, 2);

      function setStatus(msg, isError) {
        copyFailure = false;
        statusEl.textContent = msg;
        statusEl.className = 'jtt-status ' + (isError ? 'error' : 'success');
      }

      function clearStatus() {
        copyFailure = false;
        statusEl.textContent = '';
        statusEl.className = 'jtt-status';
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        if (copyFailure) clearStatus();
      }

      /* ── engine:start ── */
      function hasOwn(o, k) { return Object.prototype.hasOwnProperty.call(o, k); }

      /* ── PascalCase helper ── */
      // Type names must be identifiers: a name that does not start with a letter, _ or $
      // after conversion (2fa, an empty key) gets a "T" prefix.
      function toPascalCase(str) {
        var name = String(str)
          .replace(/[^\p{L}\p{N}_$]+(.)/gu, function (_, ch) { return ch.toUpperCase(); })
          .replace(/[^\p{L}\p{N}_$]/gu, '')
          .replace(/^(.)/, function (_, ch) { return ch.toUpperCase(); });
        if (!/^[\p{L}_$]/u.test(name)) name = 'T' + name;
        return name;
      }

      // Declarations are kept in a list in the order they are first reached (root first).
      // A nested object gets the PascalCase of its key. When that name is already used by a
      // type with different fields, the parent's name is put in front (b.meta → BMeta), then a
      // number is added; an object with the same fields as an earlier one of the same key
      // reuses that type. The root name is reserved so a nested key cannot take it.
      function newState(rootName) {
        var reserved = Object.create(null);
        reserved[rootName] = true;
        return { list: [], byName: Object.create(null), reserved: reserved };
      }
      function openSlot(state) {
        var slot = { name: null, base: null, sig: null, fields: null };
        state.list.push(slot);
        return slot;
      }
      function closeSlot(state, slot, base, parent, fields, fixedName) {
        var sig = fields.join('\n');
        if (fixedName) {
          slot.name = fixedName; slot.base = base; slot.sig = sig; slot.fields = fields;
          state.byName[fixedName] = slot;
          return fixedName;
        }
        for (var i = 0; i < state.list.length; i++) {
          var other = state.list[i];
          if (other !== slot && other.base === base && other.sig === sig) {
            state.list.splice(state.list.indexOf(slot), 1);
            return other.name;
          }
        }
        var candidates = [base];
        if (parent) candidates.push(parent + base);
        var name = null;
        for (var c = 0; c < candidates.length && !name; c++) {
          if (!state.byName[candidates[c]] && !state.reserved[candidates[c]]) name = candidates[c];
        }
        for (var n = 2; !name; n++) {
          if (!state.byName[base + n] && !state.reserved[base + n]) name = base + n;
        }
        slot.name = name; slot.base = base; slot.sig = sig; slot.fields = fields;
        state.byName[name] = slot;
        return name;
      }

      function fieldKey(k) {
        return /^[a-zA-Z_$][a-zA-Z0-9_$]*$/.test(k) ? k : JSON.stringify(k);
      }

      /* ── Type inference engine ── */
      function inferType(value, key, parent, state, optional) {
        if (value === null) return 'null';
        if (typeof value === 'string') return 'string';
        if (typeof value === 'number') return 'number';
        if (typeof value === 'boolean') return 'boolean';

        if (Array.isArray(value)) {
          if (value.length === 0) return 'unknown[]';
          var elementTypes = [];
          var objectItems = [];

          for (var i = 0; i < value.length; i++) {
            var item = value[i];
            if (item !== null && typeof item === 'object' && !Array.isArray(item)) {
              objectItems.push(item);
            } else {
              var t = inferType(item, key + 'Item', parent, state, optional);
              if (elementTypes.indexOf(t) === -1) elementTypes.push(t);
            }
          }

          if (objectItems.length > 0) {
            var itemName = mergeObjects(objectItems, toPascalCase(key) + 'Item', parent, state, optional, null);
            if (elementTypes.indexOf(itemName) === -1) elementTypes.push(itemName);
          }

          if (elementTypes.length === 1) return elementTypes[0] + '[]';
          return '(' + elementTypes.join(' | ') + ')[]';
        }

        if (typeof value === 'object') {
          return buildObject(value, toPascalCase(key), parent, state, optional, null);
        }

        return 'unknown';
      }

      /* ── One object → one declaration; returns the type name ── */
      function buildObject(obj, base, parent, state, optional, fixedName) {
        var slot = openSlot(state);
        var context = fixedName || base;
        var fields = [];
        var keys = Object.keys(obj);
        for (var i = 0; i < keys.length; i++) {
          var k = keys[i];
          var v = obj[k];
          var typeName = inferType(v, k, context, state, optional);
          var fieldOptional = optional || v === null ? '?' : '';
          fields.push('  ' + fieldKey(k) + fieldOptional + ': ' + typeName + ';');
        }
        return closeSlot(state, slot, base, parent, fields, fixedName);
      }

      /* ── Several objects (array items) → one merged declaration ── */
      function mergeObjects(objects, base, parent, state, optional, fixedName) {
        var slot = openSlot(state);
        var context = fixedName || base;
        // Count how many objects have each key; a key missing from some gets "?".
        var counts = Object.create(null);
        var order = [];
        for (var i = 0; i < objects.length; i++) {
          var keys = Object.keys(objects[i]);
          for (var j = 0; j < keys.length; j++) {
            if (!(keys[j] in counts)) { counts[keys[j]] = 0; order.push(keys[j]); }
            counts[keys[j]]++;
          }
        }

        var fields = [];
        for (var ki = 0; ki < order.length; ki++) {
          var k = order[ki];
          var presentInAll = counts[k] === objects.length;
          var types = [];
          var nested = [];
          for (var oi = 0; oi < objects.length; oi++) {
            if (!hasOwn(objects[oi], k)) continue;
            var v = objects[oi][k];
            // Objects under the same key in different items are merged into one type.
            if (v !== null && typeof v === 'object' && !Array.isArray(v)) { nested.push(v); continue; }
            var t = inferType(v, k, context, state, optional);
            if (types.indexOf(t) === -1) types.push(t);
          }
          if (nested.length) {
            var nt = nested.length === 1
              ? buildObject(nested[0], toPascalCase(k), context, state, optional, null)
              : mergeObjects(nested, toPascalCase(k), context, state, optional, null);
            if (types.indexOf(nt) === -1) types.push(nt);
          }
          var typeStr = types.length === 1 ? types[0] : '(' + types.join(' | ') + ')';
          var fieldOptional = (!presentInAll || optional) ? '?' : '';
          fields.push('  ' + fieldKey(k) + fieldOptional + ': ' + typeStr + ';');
        }
        return closeSlot(state, slot, base, parent, fields, fixedName);
      }

      /* ── Render declarations to TypeScript ── */
      function renderDeclarations(state, useType) {
        var lines = [];
        state.list.forEach(function (slot) {
          lines.push(useType ? 'type ' + slot.name + ' = {' : 'interface ' + slot.name + ' {');
          for (var j = 0; j < slot.fields.length; j++) lines.push(slot.fields[j]);
          lines.push('}');
          lines.push('');
        });
        return lines.join('\n').trimEnd();
      }

      // Returns { code, count }; count is 0 when the root is not an object (a type alias).
      function generateTypeScript(parsed, rootName, optional, useType) {
        var state = newState(rootName);
        if (parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed)) {
          buildObject(parsed, rootName, '', state, optional, rootName);
        } else if (Array.isArray(parsed) && parsed.some(function (v) { return v !== null && typeof v === 'object' && !Array.isArray(v); })) {
          var objectItems = parsed.filter(function (v) { return v !== null && typeof v === 'object' && !Array.isArray(v); });
          mergeObjects(objectItems, rootName, '', state, optional, rootName);
        } else {
          return { code: 'type ' + rootName + ' = ' + inferType(parsed, rootName, '', state, optional) + ';', count: 0 };
        }
        return { code: renderDeclarations(state, useType), count: state.list.length };
      }
      /* ── engine:end ── */

      /* ── Main convert function ── */
      function convert() {
        invalidateCopy();
        clearTimeout(_jttLiveTimer);
        _jttLiveTimer = null;
        var raw = inputEl.value.trim();
        if (!raw) { inputEl.classList.remove('error'); clearStatus(); setOutput(''); return; }

        // Real-time error highlighting
        inputEl.classList.remove('error');

        var parsed;
        try {
          parsed = JSON.parse(raw);
        } catch (e) {
          inputEl.classList.add('error');
          setOutput('');
          setStatus(MSG_INVALID + e.message, true);
          return;
        }

        inputEl.classList.remove('error');

        var rootName = (rootNameEl.value.trim() || 'RootObject');
        var result;
        try {
          result = generateTypeScript(parsed, rootName, optionalEl.checked, useTypeEl.checked);
        } catch (e) {
          // For example a stack overflow on very deep nesting: never leave the previous output.
          setOutput('');
          setStatus(MSG_FAILED + (e && e.message ? e.message : String(e)), true);
          return;
        }
        setOutput(result.code);
        if (result.count === 0) setStatus(MSG_GENERATED, false);
        else setStatus(result.count === 1 ? MSG_GEN_ONE : MSG_GEN_MANY.replace('{n}', result.count), false);
      }

      /* Analytics: one event per committed edit, Generate or Example, not per typing pause.
         One action can fire both change (blur on mousedown) and click, so the same JSON,
         root name and options are sent once. */
      var lastTracked = null;
      function trackGenerate() {
        if (!outputCodeEl.textContent || inputEl.classList.contains('error')) return;
        var key = inputEl.value + '\u0000' + (rootNameEl.value.trim() || 'RootObject') + '\u0000' + optionalEl.checked + '\u0000' + useTypeEl.checked;
        if (key === lastTracked) return;
        lastTracked = key;
        window.trackTool && window.trackTool('json-to-typescript', 'generate');
      }

      /* ── Real-time generate (debounced 300ms) ── */
      var _jttLiveTimer = null;
      inputEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_jttLiveTimer);
        _jttLiveTimer = setTimeout(convert, 300);
      });
      inputEl.addEventListener('change', function () {
        if (_jttLiveTimer) convert();
        trackGenerate();
      });

      document.getElementById('jtt-convert').addEventListener('click', function () {
        convert();
        trackGenerate();
      });

      document.getElementById('jtt-example').addEventListener('click', function () {
        inputEl.value = EXAMPLE;
        inputEl.classList.remove('error');
        clearStatus();
        convert();
        trackGenerate();
      });

      document.getElementById('jtt-clear').addEventListener('click', function () {
        invalidateCopy();
        lastTracked = null;
        clearTimeout(_jttLiveTimer);
        _jttLiveTimer = null;
        inputEl.value = '';
        setOutput('');
        inputEl.classList.remove('error');
        clearStatus();
      });

      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && wrap && wrap.contains(document.activeElement)) {
          e.preventDefault();
          inputEl.focus();
          document.getElementById('jtt-clear').click();
        }
      });

      document.getElementById('jtt-copy').addEventListener('click', function () {
        var text = outputCodeEl.textContent;
        if (!text) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(COPY_FAILED, true);
          copyFailure = true;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            if (copyFailure) clearStatus();
            copyBtn.textContent = COPIED;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = COPY;
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });
    })();
  </script>
</div>

