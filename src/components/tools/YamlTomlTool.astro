---
import Toggletip from '../Toggletip.astro';
// YamlTomlTool — bidirectional YAML ↔ TOML converter (js-yaml + smol-toml, bundled from npm).
// Values TOML cannot hold as written (null, integers outside ±(2^53 − 1), timestamps with more
// than millisecond precision or impossible dates) stop the conversion with their JSON Pointer
// paths: the old output is cleared and its copy button disabled (conversion-fidelity.js).
// YAML dates become TOML local dates; YAML date-times become offset date-times; -0 becomes
// -0.0 and whole floats stay floats (1.0). TOML date-times and times with more than millisecond
// precision, and TOML local date-times (YAML would read them as UTC), stop TOML → YAML.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: { copyFailed: 'Copy failed. Please try again.', copy: 'Copy', copied: 'Copied!', clear: 'Clear', swap: 'Swap', yamlToToml: 'Converted YAML to TOML.', tomlToYaml: 'Converted TOML to YAML.', invalidYaml: 'Invalid YAML', invalidToml: 'Invalid TOML', rootMapping: 'YAML root must be a mapping (object), not a scalar or sequence.', tips: {"yaml": "Paste one YAML document with a mapping at the root. TOML updates 0.3 seconds after typing stops. Values TOML cannot preserve stop conversion and are listed by field path.", "toml": "Paste TOML here. YAML updates 0.3 seconds after typing stops, with two-space indentation and no line folding. Values YAML cannot preserve stop conversion.", "copyYaml": "Copy all current text in the YAML pane, including your edits. An empty pane cannot be copied.", "copyToml": "Copy all current text in the TOML pane, including your edits. An empty pane cannot be copied.", "swap": "Move the entire YAML and TOML panes, keeping their labels and text together. Focus moves to the new first pane. Pending conversion is cancelled; Swap does not convert.", "clear": "Clear both panes, the status and pending conversion. Ctrl+L (⌘+L on Mac) does the same while focus is inside this tool."} },
  zh: { copyFailed: '复制失败，请重试。', copy: '复制', copied: '已复制！', clear: '清除', swap: '交换', yamlToToml: '已将 YAML 转换为 TOML。', tomlToYaml: '已将 TOML 转换为 YAML。', invalidYaml: '无效 YAML', invalidToml: '无效 TOML', rootMapping: 'YAML 的根必须是映射（对象），不能是标量或序列。', tips: {"yaml": "粘贴一个以映射为根的 YAML 文档。停止输入 0.3 秒后更新 TOML。TOML 无法原样保存的值会停止转换，并按字段路径列出。", "toml": "在此粘贴 TOML。停止输入 0.3 秒后更新 YAML，使用两个空格缩进，不折叠长行。遇到 YAML 无法原样保存的值时停止转换。", "copyYaml": "复制 YAML 面板当前的全部文本，包括您编辑的内容。面板为空时无法复制。", "copyToml": "复制 TOML 面板当前的全部文本，包括您编辑的内容。面板为空时无法复制。", "swap": "交换 YAML 与 TOML 整个面板的位置，标签与原文一起移动，并聚焦新的第一个面板。等待执行的转换会取消；交换本身不转换内容。", "clear": "清空两个面板、状态和等待执行的转换。焦点在工具内时，Ctrl+L（Mac 为 ⌘+L）也会清空。"} },
  ja: { copyFailed: 'コピーに失敗しました。もう一度お試しください。', copy: 'コピー', copied: 'コピー済み！', clear: 'クリア', swap: '入れ替え', yamlToToml: 'YAML を TOML に変換しました。', tomlToYaml: 'TOML を YAML に変換しました。', invalidYaml: '無効な YAML', invalidToml: '無効な TOML', rootMapping: 'YAML のルートはマッピング（オブジェクト）である必要があります。スカラーやシーケンスは変換できません。', tips: {"yaml": "ルートがマッピングの YAML 文書を1つ貼り付けます。入力を止めて0.3秒後に TOML が更新されます。TOML で元の値を保てない場合は変換を止め、フィールドのパスを示します。", "toml": "TOML を貼り付けます。入力を止めて0.3秒後に YAML がスペース2個のインデントで更新されます。長い行は折り返し形式にせず、YAML で元の値を保てない場合は変換を止めます。", "copyYaml": "YAML 欄の現在のテキストを、編集した内容も含めてすべてコピーします。空の欄はコピーできません。", "copyToml": "TOML 欄の現在のテキストを、編集した内容も含めてすべてコピーします。空の欄はコピーできません。", "swap": "YAML と TOML の欄全体を、ラベルとテキストを保って入れ替えます。新しい先頭の欄にフォーカスが移ります。待機中の変換は取り消し、入れ替え自体では変換しません。", "clear": "両方の欄、ステータス、待機中の変換をクリアします。ツール内では Ctrl+L（Mac は ⌘+L）でもクリアできます。"} },
  ko: { copyFailed: '복사하지 못했습니다. 다시 시도하세요.', copy: '복사', copied: '복사됨!', clear: '지우기', swap: '바꾸기', yamlToToml: 'YAML을 TOML로 변환했습니다.', tomlToYaml: 'TOML을 YAML로 변환했습니다.', invalidYaml: '유효하지 않은 YAML', invalidToml: '유효하지 않은 TOML', rootMapping: 'YAML 루트는 매핑(객체)이어야 합니다. 스칼라나 시퀀스는 변환할 수 없습니다.', tips: {"yaml": "루트가 매핑인 YAML 문서 하나를 붙여 넣으세요. 입력을 멈추고 0.3초 뒤 TOML이 갱신됩니다. TOML에 원래 값 그대로 담을 수 없으면 변환을 멈추고 필드 경로를 표시합니다.", "toml": "TOML을 붙여 넣으세요. 입력을 멈추고 0.3초 뒤 YAML이 공백 두 개 들여쓰기로 갱신됩니다. 긴 줄은 접지 않으며 YAML에 원래 값을 담을 수 없으면 변환을 멈춥니다.", "copyYaml": "직접 편집한 내용을 포함하여 YAML 칸의 현재 텍스트 전체를 복사합니다. 빈 칸은 복사할 수 없습니다.", "copyToml": "직접 편집한 내용을 포함하여 TOML 칸의 현재 텍스트 전체를 복사합니다. 빈 칸은 복사할 수 없습니다.", "swap": "YAML과 TOML 칸 전체를 라벨과 텍스트 그대로 이동합니다. 새 첫 번째 칸으로 포커스가 옮겨집니다. 대기 중인 변환은 취소되며 바꾸기 자체는 변환하지 않습니다.", "clear": "두 칸과 상태를 지우고 대기 중인 변환을 취소합니다. 도구 안에서 Ctrl+L(Mac은 ⌘+L)로도 지울 수 있습니다."} },
};
// strings:end
const T = STRINGS[lang] || STRINGS.en;
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="yt-wrap" data-lang={lang} data-strings={JSON.stringify(CLIENT_T)}>
  <div class="yt-toolbar">
    <div class="yt-control"><button id="yt-swap" class="btn-secondary" type="button">{T.swap}</button><Toggletip id="yt-tip-swap" about={T.swap} lang={lang}>{TIPS.swap}</Toggletip></div>
    <div class="yt-control"><button id="yt-clear" class="btn-ghost" type="button">{T.clear}</button><Toggletip id="yt-tip-clear" about={T.clear} lang={lang}>{TIPS.clear}</Toggletip></div>
  </div>
  <div id="yt-status" class="yt-status" aria-live="polite"></div>
  <div class="yt-panels zt-io">
    <div class="yt-panel zt-io-pane">
      <div class="yt-head">
        <div class="yt-control"><label for="yt-yaml">YAML</label><Toggletip id="yt-tip-yaml" about="YAML" lang={lang}>{TIPS.yaml}</Toggletip></div>
        <div class="yt-control"><button id="yt-copy-yaml" class="btn-copy" type="button" disabled>{T.copy}</button><Toggletip id="yt-tip-copy-yaml" about={T.copy + ' YAML'} lang={lang}>{TIPS.copyYaml}</Toggletip></div>
      </div>
      <textarea id="yt-yaml" class="tool-textarea yt-box zt-io-fill" placeholder={"database:\n  host: localhost\n  port: 5432\n  enabled: true"} spellcheck="false"></textarea>
    </div>
    <div class="yt-panel zt-io-pane">
      <div class="yt-head">
        <div class="yt-control"><label for="yt-toml">TOML</label><Toggletip id="yt-tip-toml" about="TOML" lang={lang}>{TIPS.toml}</Toggletip></div>
        <div class="yt-control"><button id="yt-copy-toml" class="btn-copy" type="button" disabled>{T.copy}</button><Toggletip id="yt-tip-copy-toml" about={T.copy + ' TOML'} lang={lang}>{TIPS.copyToml}</Toggletip></div>
      </div>
      <textarea id="yt-toml" class="tool-textarea yt-box zt-io-fill" placeholder={"[database]\nhost = \"localhost\"\nport = 5432\nenabled = true"} spellcheck="false"></textarea>
    </div>
  </div>

  <script>
    import jsyaml from 'js-yaml';
    import { parse as tomlParse, stringify as tomlStringify, TomlDate } from 'smol-toml';
    import { yamlLoadSchema, findLosses, formatLosses, markTomlTimes } from './conversion-fidelity.js';
    import { yamlErrorText } from './yaml-limits.js';

    const yamlEl = document.getElementById('yt-yaml') as HTMLTextAreaElement;
    const tomlEl = document.getElementById('yt-toml') as HTMLTextAreaElement;
    const statusEl = document.getElementById('yt-status') as HTMLElement;
    const copyYamlBtn = document.getElementById('yt-copy-yaml') as HTMLButtonElement;
    const copyTomlBtn = document.getElementById('yt-copy-toml') as HTMLButtonElement;
    const ytWrap = document.querySelector('.yt-wrap') as HTMLElement;
    const S = JSON.parse(ytWrap.dataset.strings || '{}');
    const LANG = ytWrap.dataset.lang || 'en';
    const YAML_SCHEMA = yamlLoadSchema(jsyaml, { timestamps: true, floats: true });

    type Result = { ok: true; text: string } | { ok: false; message: string };

    function yamlToToml(raw: string): Result {
      let parsed: any;
      try { parsed = jsyaml.load(raw, { schema: YAML_SCHEMA }); }
      catch (e: any) { return { ok: false, message: S.invalidYaml + ': ' + yamlErrorText(e, LANG) }; }
      if (parsed === null || parsed === undefined || typeof parsed !== 'object' || Array.isArray(parsed)) {
        return { ok: false, message: S.invalidYaml + ': ' + S.rootMapping };
      }
      const found = findLosses(parsed, 'toml', { TomlDate });
      if (found.count) return { ok: false, message: formatLosses(found, 'TOML', LANG) };
      try { return { ok: true, text: tomlStringify(found.value) }; }
      catch (e: any) { return { ok: false, message: S.invalidYaml + ': ' + (e?.message || String(e)) }; }
    }

    function tomlToYaml(raw: string): Result {
      let data: any;
      try { data = markTomlTimes(raw, tomlParse, tomlParse(raw), { localDateTime: true }); }
      catch (e: any) { return { ok: false, message: S.invalidToml + ': ' + (e?.message || String(e)) }; }
      const found = findLosses(data, 'yaml');
      if (found.count) return { ok: false, message: formatLosses(found, 'YAML', LANG) };
      return { ok: true, text: jsyaml.dump(found.value, { indent: 2, lineWidth: -1, noRefs: true }) };
    }

    function syncCopy() {
      copyYamlBtn.disabled = !yamlEl.value;
      copyTomlBtn.disabled = !tomlEl.value;
    }

    let copyRevision = 0;
    let copyErrorOwner: HTMLButtonElement | null = null;
    const copyStates = [copyYamlBtn, copyTomlBtn].map(btn => ({ btn, request: 0, timer: null as ReturnType<typeof setTimeout> | null }));

    function invalidateCopies() {
      copyRevision++;
      copyErrorOwner = null;
      copyStates.forEach(state => {
        if (state.timer) clearTimeout(state.timer);
        state.timer = null;
        state.btn.textContent = S.copy;
      });
    }

    function cancelQueued() {
      if (_ytYamlTimer) clearTimeout(_ytYamlTimer);
      if (_ytTomlTimer) clearTimeout(_ytTomlTimer);
      _ytYamlTimer = _ytTomlTimer = null;
    }

    function setStatus(msg: string, isError: boolean) {
      copyErrorOwner = null;
      statusEl.textContent = msg;
      statusEl.className = 'yt-status ' + (isError ? 'error' : 'success');
    }

    function clearStatus() {
      copyErrorOwner = null;
      statusEl.textContent = '';
      statusEl.className = 'yt-status';
    }

    /* Runs one direction; a failed conversion clears the output so a stale result cannot be copied. */
    function run(fromEl: HTMLTextAreaElement, toEl: HTMLTextAreaElement, convert: (raw: string) => Result, okMsg: string): boolean {
      cancelQueued();
      invalidateCopies();
      const raw = fromEl.value.trim();
      if (!raw) { toEl.value = ''; clearStatus(); syncCopy(); return false; }
      const r = convert(raw);
      if (r.ok) { toEl.value = r.text; setStatus(okMsg, false); }
      else { toEl.value = ''; setStatus(r.message, true); }
      syncCopy();
      return r.ok;
    }
    const runYaml = () => run(yamlEl, tomlEl, yamlToToml, S.yamlToToml);
    const runToml = () => run(tomlEl, yamlEl, tomlToYaml, S.tomlToYaml);

    /* ── Real-time conversion (debounced 300ms) ── */
    let _ytYamlTimer: ReturnType<typeof setTimeout> | null = null;
    yamlEl.addEventListener('input', () => {
      cancelQueued();
      invalidateCopies();
      syncCopy();
      _ytYamlTimer = setTimeout(runYaml, 300);
    });

    let _ytTomlTimer: ReturnType<typeof setTimeout> | null = null;
    tomlEl.addEventListener('input', () => {
      cancelQueued();
      invalidateCopies();
      syncCopy();
      _ytTomlTimer = setTimeout(runToml, 300);
    });

    /* ── Swap button ── */
    document.getElementById('yt-swap')!.addEventListener('click', () => {
      cancelQueued();
      if (copyErrorOwner && statusEl.textContent === S.copyFailed) clearStatus();
      invalidateCopies();
      const panels = ytWrap.querySelector('.yt-panels')!;
      panels.appendChild(panels.firstElementChild!);
      (panels.firstElementChild!.querySelector('textarea') as HTMLTextAreaElement).focus();
      (window as any).trackTool && (window as any).trackTool('yaml_toml', 'swap');
    });

    /* ── Clear ── */
    document.getElementById('yt-clear')!.addEventListener('click', () => {
      cancelQueued();
      invalidateCopies();
      yamlEl.value = '';
      tomlEl.value = '';
      clearStatus();
      syncCopy();
      yamlEl.focus();
    });

    /* ── Copy buttons ── */
    function copyFrom(el: HTMLTextAreaElement, btn: HTMLButtonElement) {
      if (!el.value || btn.disabled) return;
      const text = el.value;
      const state = copyStates.find(state => state.btn === btn)!;
      const revision = copyRevision, request = ++state.request;
      if (state.timer) clearTimeout(state.timer);
      state.timer = null;
      btn.textContent = S.copy;
      const current = () => revision === copyRevision && request === state.request && el.value === text && !btn.disabled;
      const failed = () => {
        if (!current()) return;
        setStatus(S.copyFailed, true);
        copyErrorOwner = btn;
      };
      try {
        navigator.clipboard.writeText(text).then(() => {
          if (!current()) return;
          if (copyErrorOwner === btn && statusEl.textContent === S.copyFailed) clearStatus();
          btn.textContent = S.copied;
          state.timer = setTimeout(() => { if (current()) btn.textContent = S.copy; }, 1500);
        }, failed);
      } catch (_) { failed(); }
    }
    copyYamlBtn.addEventListener('click', () => copyFrom(yamlEl, copyYamlBtn));
    copyTomlBtn.addEventListener('click', () => copyFrom(tomlEl, copyTomlBtn));

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'l' && ytWrap.contains(document.activeElement)) {
        e.preventDefault();
        document.getElementById('yt-clear')!.click();
      }
    });

    /* ── Page load ── Astro bundles this script as a module, which runs only after the page is
       parsed. Text typed (or restored by the browser) before then had no input listener, so
       convert it once now: the focused panel first, else the YAML panel, else the TOML panel.
       The example fills the page only when both panels are empty. */
    const focused = document.activeElement;
    if (focused === tomlEl && tomlEl.value.trim()) runToml();
    else if (yamlEl.value.trim()) runYaml();
    else if (tomlEl.value.trim()) runToml();
    else {
      yamlEl.value = 'database:\n  host: localhost\n  port: 5432\n  enabled: true';
      runYaml();
    }
  </script>
</div>

<style>
  .yt-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; min-height: 0; }
  .yt-toolbar { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; flex: none; }
  .yt-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; min-height: 32px; }
  .yt-control { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .yt-head label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .yt-box { min-width: 0; overflow: auto; tab-size: 2; }
  .yt-status { height: 2.6rem; min-height: 2.6rem; flex: none; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; line-height: 1.5; color: var(--color-text-secondary); }
  .yt-status.success { color: var(--color-success); }
  .yt-status.error { color: var(--color-danger); }

  @media (max-width: 860px) {
    .yt-box { height: 180px; }
    .yt-status { height: 3.25rem; min-height: 3.25rem; }
  }
  @media (max-width: 640px) {
    .yt-wrap { gap: 0.5rem; }
    .yt-head { min-height: 44px; }
    .yt-box { height: 120px; }
  }
</style>
