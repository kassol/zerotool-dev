---
// YamlTomlTool — bidirectional YAML ↔ TOML converter (js-yaml + smol-toml, bundled from npm).
// Values TOML cannot hold as written (null, integers outside ±(2^53 − 1), timestamps with more
// than millisecond precision or impossible dates) stop the conversion with their JSON Pointer
// paths: the old output is cleared and its copy button disabled (conversion-fidelity.js).
// YAML dates become TOML local dates; YAML date-times become offset date-times; -0 becomes
// -0.0 and whole floats stay floats (1.0). TOML date-times and times with more than millisecond
// precision, and TOML local date-times (YAML would read them as UTC), stop TOML → YAML.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: { copy: 'Copy', copied: 'Copied!', clear: 'Clear', swap: 'Swap', yamlToToml: 'Converted YAML to TOML.', tomlToYaml: 'Converted TOML to YAML.', invalidYaml: 'Invalid YAML', invalidToml: 'Invalid TOML', rootMapping: 'YAML root must be a mapping (object), not a scalar or sequence.' },
  zh: { copy: '复制', copied: '已复制！', clear: '清除', swap: '交换', yamlToToml: '已将 YAML 转换为 TOML。', tomlToYaml: '已将 TOML 转换为 YAML。', invalidYaml: '无效 YAML', invalidToml: '无效 TOML', rootMapping: 'YAML 的根必须是映射（对象），不能是标量或序列。' },
  ja: { copy: 'コピー', copied: 'コピー済み！', clear: 'クリア', swap: '入れ替え', yamlToToml: 'YAML を TOML に変換しました。', tomlToYaml: 'TOML を YAML に変換しました。', invalidYaml: '無効な YAML', invalidToml: '無効な TOML', rootMapping: 'YAML のルートはマッピング（オブジェクト）である必要があります。スカラーやシーケンスは変換できません。' },
  ko: { copy: '복사', copied: '복사됨!', clear: '지우기', swap: '바꾸기', yamlToToml: 'YAML을 TOML로 변환했습니다.', tomlToYaml: 'TOML을 YAML로 변환했습니다.', invalidYaml: '유효하지 않은 YAML', invalidToml: '유효하지 않은 TOML', rootMapping: 'YAML 루트는 매핑(객체)이어야 합니다. 스칼라나 시퀀스는 변환할 수 없습니다.' },
};
// strings:end
const T = STRINGS[lang] || STRINGS.en;
---

<div>
  <div class="yt-wrap" data-lang={lang} data-strings={JSON.stringify(T)}>
    <div class="yt-panels">
      <div class="yt-panel">
        <label for="yt-yaml">
          <span>YAML</span>
          <button id="yt-copy-yaml" class="btn-copy" type="button" disabled>{T.copy}</button>
        </label>
        <textarea
          id="yt-yaml"
          placeholder={"database:\n  host: localhost\n  port: 5432\n  enabled: true"}
          spellcheck="false"
        ></textarea>
      </div>
      <div class="yt-panel">
        <label for="yt-toml">
          <span>TOML</span>
          <button id="yt-copy-toml" class="btn-copy" type="button" disabled>{T.copy}</button>
        </label>
        <textarea
          id="yt-toml"
          placeholder={"[database]\nhost = \"localhost\"\nport = 5432\nenabled = true"}
          spellcheck="false"
        ></textarea>
      </div>
    </div>

    <div class="yt-actions">
      <button id="yt-swap" class="btn-primary">{T.swap}</button>
      <button id="yt-clear" class="btn-ghost">{T.clear}</button>
    </div>

    <div id="yt-status" class="yt-status" aria-live="polite"></div>
  </div>

  <script>
    import jsyaml from 'js-yaml';
    import { parse as tomlParse, stringify as tomlStringify, TomlDate } from 'smol-toml';
    import { yamlLoadSchema, findLosses, formatLosses, markTomlTimes } from './conversion-fidelity.js';
    import { yamlErrorText } from './yaml-limits.js';

    const yamlEl = document.getElementById('yt-yaml') as HTMLTextAreaElement;
    const tomlEl = document.getElementById('yt-toml') as HTMLTextAreaElement;
    const statusEl = document.getElementById('yt-status') as HTMLElement;
    const copyYamlBtn = document.getElementById('yt-copy-yaml') as HTMLButtonElement;
    const copyTomlBtn = document.getElementById('yt-copy-toml') as HTMLButtonElement;
    const ytWrap = document.querySelector('.yt-wrap') as HTMLElement;
    const S = JSON.parse(ytWrap.dataset.strings || '{}');
    const LANG = ytWrap.dataset.lang || 'en';
    const YAML_SCHEMA = yamlLoadSchema(jsyaml, { timestamps: true, floats: true });

    type Result = { ok: true; text: string } | { ok: false; message: string };

    function yamlToToml(raw: string): Result {
      let parsed: any;
      try { parsed = jsyaml.load(raw, { schema: YAML_SCHEMA }); }
      catch (e: any) { return { ok: false, message: S.invalidYaml + ': ' + yamlErrorText(e, LANG) }; }
      if (parsed === null || parsed === undefined || typeof parsed !== 'object' || Array.isArray(parsed)) {
        return { ok: false, message: S.invalidYaml + ': ' + S.rootMapping };
      }
      const found = findLosses(parsed, 'toml', { TomlDate });
      if (found.count) return { ok: false, message: formatLosses(found, 'TOML', LANG) };
      try { return { ok: true, text: tomlStringify(found.value) }; }
      catch (e: any) { return { ok: false, message: S.invalidYaml + ': ' + (e?.message || String(e)) }; }
    }

    function tomlToYaml(raw: string): Result {
      let data: any;
      try { data = markTomlTimes(raw, tomlParse, tomlParse(raw), { localDateTime: true }); }
      catch (e: any) { return { ok: false, message: S.invalidToml + ': ' + (e?.message || String(e)) }; }
      const found = findLosses(data, 'yaml');
      if (found.count) return { ok: false, message: formatLosses(found, 'YAML', LANG) };
      return { ok: true, text: jsyaml.dump(found.value, { indent: 2, lineWidth: -1, noRefs: true }) };
    }

    function syncCopy() {
      copyYamlBtn.disabled = !yamlEl.value;
      copyTomlBtn.disabled = !tomlEl.value;
    }

    function setStatus(msg: string, isError: boolean) {
      statusEl.textContent = msg;
      statusEl.className = 'yt-status ' + (isError ? 'error' : 'success');
    }

    function clearStatus() {
      statusEl.textContent = '';
      statusEl.className = 'yt-status';
    }

    /* Runs one direction; a failed conversion clears the output so a stale result cannot be copied. */
    function run(fromEl: HTMLTextAreaElement, toEl: HTMLTextAreaElement, convert: (raw: string) => Result, okMsg: string): boolean {
      const raw = fromEl.value.trim();
      if (!raw) { clearStatus(); syncCopy(); return false; }
      const r = convert(raw);
      if (r.ok) { toEl.value = r.text; setStatus(okMsg, false); }
      else { toEl.value = ''; setStatus(r.message, true); }
      syncCopy();
      return r.ok;
    }
    const runYaml = () => run(yamlEl, tomlEl, yamlToToml, S.yamlToToml);
    const runToml = () => run(tomlEl, yamlEl, tomlToYaml, S.tomlToYaml);

    /* ── Real-time conversion (debounced 300ms) ── */
    let _ytYamlTimer: ReturnType<typeof setTimeout> | null = null;
    yamlEl.addEventListener('input', () => {
      syncCopy();
      if (_ytYamlTimer) clearTimeout(_ytYamlTimer);
      _ytYamlTimer = setTimeout(runYaml, 300);
    });

    let _ytTomlTimer: ReturnType<typeof setTimeout> | null = null;
    tomlEl.addEventListener('input', () => {
      syncCopy();
      if (_ytTomlTimer) clearTimeout(_ytTomlTimer);
      _ytTomlTimer = setTimeout(runToml, 300);
    });

    /* ── Swap button ── */
    document.getElementById('yt-swap')!.addEventListener('click', () => {
      const tmp = yamlEl.value;
      yamlEl.value = tomlEl.value;
      tomlEl.value = tmp;
      if (runYaml()) (window as any).trackTool && (window as any).trackTool('yaml_toml', 'swap');
    });

    /* ── Clear ── */
    document.getElementById('yt-clear')!.addEventListener('click', () => {
      yamlEl.value = '';
      tomlEl.value = '';
      clearStatus();
      syncCopy();
    });

    /* ── Copy buttons ── */
    function copyFrom(el: HTMLTextAreaElement, btn: HTMLButtonElement) {
      if (!el.value || btn.disabled) return;
      navigator.clipboard.writeText(el.value).then(() => {
        btn.textContent = S.copied;
        setTimeout(() => { btn.textContent = S.copy; }, 1500);
      });
    }
    copyYamlBtn.addEventListener('click', () => copyFrom(yamlEl, copyYamlBtn));
    copyTomlBtn.addEventListener('click', () => copyFrom(tomlEl, copyTomlBtn));

    /* ── Keyboard shortcut: Ctrl/Cmd+Enter ── */
    yamlEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) runYaml();
    });
    tomlEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) runToml();
    });

    /* ── Page load ── Astro bundles this script as a module, which runs only after the page is
       parsed. Text typed (or restored by the browser) before then had no input listener, so
       convert it once now: the focused panel first, else the YAML panel, else the TOML panel.
       The example fills the page only when both panels are empty. */
    const focused = document.activeElement;
    if (focused === tomlEl && tomlEl.value.trim()) runToml();
    else if (yamlEl.value.trim()) runYaml();
    else if (tomlEl.value.trim()) runToml();
    else {
      yamlEl.value = 'database:\n  host: localhost\n  port: 5432\n  enabled: true';
      runYaml();
    }
  </script>
</div>

<style>
  .yt-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  .yt-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 600px) {
    .yt-panels { grid-template-columns: 1fr; }
  }

  .yt-panel { display: flex; flex-direction: column; gap: 0.4rem; }

  .yt-panel label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .yt-panel textarea {
    width: 100%;
    min-height: 200px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    resize: vertical;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    line-height: 1.5;
  }

  .yt-panel textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .yt-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .yt-status { font-size: 0.85rem; min-height: 1.2rem; }
  .yt-status.success { color: #057a55; }
  .yt-status.error { color: #c0392b; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .yt-status.success { color: #34d399; }
    :root:not([data-theme="light"]) .yt-status.error { color: #f87171; }
  }
  [data-theme="dark"] .yt-status.success { color: #34d399; }
  [data-theme="dark"] .yt-status.error { color: #f87171; }
</style>
