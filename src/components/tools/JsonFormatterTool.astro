      return { error: zeros * 4 >= Math.min(u8.length, 64) ? 'utf16NoBom' : 'notUtf8', offset: bad };
    }
    return { text: new TextDecoder('utf-8', { ignoreBOM: true }).decode(u8), encoding: 'UTF-8' };
  }

  /* Tree view helpers. */
  function kindOf(v) {
    if (v === null) return 'null';
    if (typeof v === 'string') return 'string';
    if (typeof v === 'boolean') return 'boolean';
    return v.t === 'n' ? 'number' : v.t === 'o' ? 'object' : 'array';
  }
  function childrenOf(v, o) {
    if (v === null || typeof v !== 'object' || v.t === 'n') return [];
    if (v.t === 'a') return v.v.map(function (x, idx) { return { seg: idx, value: x }; });
    return orderOf(v, o).map(function (idx) { return { seg: v.k[idx], value: v.v[idx], dup: !!v.d && o.dupes !== 'last' && v.k.indexOf(v.k[idx]) !== idx }; });
  }
  /* ── engine:end ── */

  const wrap = document.getElementById('jf-wrap') as HTMLElement;
  const T: any = JSON.parse(wrap.dataset.strings || '{}');
  const SLUG = 'json-formatter';
  const $ = (id: string) => document.getElementById(id) as any;
  const input = $('jf-input') as HTMLTextAreaElement;
  const statusEl = $('jf-status') as HTMLElement;
  const outPre = $('jf-output') as HTMLElement;
  const outCode = $('jf-output-code') as HTMLElement;
  const treeWrap = $('jf-tree-wrap') as HTMLElement;
  const treeEl = $('jf-tree') as HTMLElement;
  const pathEl = $('jf-path') as HTMLElement;
  const notesEl = $('jf-notes') as HTMLUListElement;
  const copyBtn = $('jf-copy') as HTMLButtonElement;
  const dlBtn = $('jf-download') as HTMLButtonElement;
  const fileEl = $('jf-file') as HTMLInputElement;
  const sortEl = $('jf-sort') as HTMLInputElement;
  const asciiEl = $('jf-ascii') as HTMLInputElement;
  const json5El = $('jf-json5') as HTMLInputElement;
  const numbersEl = $('jf-numbers') as HTMLSelectElement;
  const dupesEl = $('jf-dupes') as HTMLSelectElement;
  const AUTO_LIMIT = 2_000_000;
  const HIGHLIGHT_LIMIT = 1_000_000;
  const FILE_LIMIT = 50 * 1024 * 1024;
  const CHUNK = 200;
  const EXPAND_LIMIT = 2000;
  const SAMPLE = '{"id":1830000000000000001,"name":"ZeroTool","price":19.90,"tags":["json","formatter"],"owner":{"login":"kassol","verified":true},"updatedAt":"2026-10-02T09:30:00Z","notes":null}';

  let mode: 'pretty' | 'min' = 'pretty';
  let indent = '2';
  let view: 'text' | 'tree' = 'text';
  let outText = '';
  let current: any = null;
  let fileName = '';
  let fileNote = '';
  let errorRange: number[] | null = null;
  let timer: ReturnType<typeof setTimeout> | null = null;
  let saveTimer: ReturnType<typeof setTimeout> | null = null;

  function plural(pair: string[], n: number) { return fmt(n === 1 ? pair[0] : pair[1], { n: n.toLocaleString() }); }
  function size(chars: number) {
    if (chars < 1024) return chars + ' B';
    if (chars < 1024 * 1024) return (chars / 1024).toFixed(1) + ' KB';
    return (chars / 1024 / 1024).toFixed(1) + ' MB';
  }
  function utf8Size(s: string) { return new Blob([s]).size; }
  function el(tag: string, cls?: string, text?: string): HTMLElement {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }
  function opts() {
    return {
      indent: mode === 'min' ? '' : indent === 'tab' ? '\t' : indent === '4' ? '    ' : '  ',
      sortKeys: sortEl.checked, ascii: asciiEl.checked,
      numbers: numbersEl.value === 'js' ? 'js' : 'raw', dupes: dupesEl.value === 'last' ? 'last' : 'keep',
    };
  }
  function prefs() {
    return { mode, indent, view, sort: sortEl.checked, ascii: asciiEl.checked, json5: json5El.checked, numbers: numbersEl.value, dupes: dupesEl.value };
  }
  function save() {
    const p: any = prefs();
    if (input.value.length < 200_000) p.input = input.value;
    (window as any).ztPersist?.save(SLUG, p);
  }
  function setStatus(text: string, kind: string) {
    statusEl.textContent = text;
    statusEl.className = 'jf-status' + (kind ? ' jf-' + kind : '');
  }
  function setPressed(sel: string, attr: string, value: string) {
    wrap.querySelectorAll(sel).forEach((b: any) => b.setAttribute('aria-pressed', String(b.getAttribute(attr) === value)));
  }

  /* Notes ---------------------------------------------------------------------------- */
  function note(text: string, kind: string, extra?: (li: HTMLElement) => void) {
    const li = el('li', 'jf-note jf-note-' + kind);
    li.appendChild(el('span', '', text));
    if (extra) extra(li);
    notesEl.appendChild(li);
  }
  function actionBtn(label: string, fn: () => void) {
    return (li: HTMLElement) => {
      const b = el('button', 'btn-ghost jf-mini', label) as HTMLButtonElement;
      b.type = 'button';
      b.addEventListener('click', fn);
      li.appendChild(b);
    };
  }
  function subList(items: string[], more: number) {
    return (li: HTMLElement) => {
      const ul = el('ul', 'jf-sub');
      items.forEach((s) => ul.appendChild(el('li', '', s)));
      if (more > 0) ul.appendChild(el('li', '', fmt(T.moreItems, { n: more })));
      li.appendChild(ul);
    };
  }
  function changeList(changes: any) {
    return Object.keys(T.changes).filter((k) => changes && changes[k] > 0).map((k) => plural(T.changes[k], changes[k])).join(', ');
  }
  function lineOf(res: any, offset: number) { return lineCol(input.value, offset + res.base).line; }
  function pathText(segs: any[]) { return segs.length ? pointerOf(segs) : T.tree.root; }
  function replaceInput(text: string) {
    input.value = text;
    fileName = ''; fileNote = '';
    run(true);
    save();
    input.focus({ preventScroll: true });
  }

  function renderNotes(res: any) {
    notesEl.textContent = '';
    if (fileNote) note(fileNote, 'info');
    if (res.bom) note(T.bomNote, 'info');
    if (res.ok) {
      if (res.mode === 'json5') note(fmt(T.json5Done, { list: changeList(res.changes) }), 'info');
      const o = opts();
      if (res.dupCount) {
        note(plural(o.dupes === 'last' ? T.dupNoteLast : T.dupNote, res.dupCount), 'warn',
          subList(res.dups.map((d: any) => fmt(T.dupItem, { key: d.key, path: pathText(d.path), line: lineOf(res, d.offset) })), res.dupCount - res.dups.length));
      }
      if (res.numberCount) {
        const msg = o.numbers === 'js' ? T.numNoteJs : T.numNote;
        const key: any = { precision: 'numPrecision', overflow: 'numOverflow', underflow: 'numUnderflow', negZero: 'numNegZero' };
        note(plural(msg, res.numberCount), 'warn',
          subList(res.numbers.map((x: any) => fmt(T[key[x.kind]], { raw: x.raw, js: x.js, path: pathText(x.path), line: lineOf(res, x.offset) })), res.numberCount - res.numbers.length));
      }
      if (res.surrogateCount) {
        note(plural(T.surrNote, res.surrogateCount), 'warn',
          subList(res.surrogates.map((x: any) => fmt(T.surrItem, { path: pathText(x.path), line: lineOf(res, x.offset) })), res.surrogateCount - res.surrogates.length));
      }
      if (res.inner) note(T.hint.inner, 'info', actionBtn(T.hint.innerBtn, () => replaceInput(res.inner)));
      if (view === 'text' && outText.length > HIGHLIGHT_LIMIT) note(T.highlightOff, 'info');
    } else if (!res.empty) {
      if (errorRange) note(fmt(T.where, { line: res.frame.line, col: res.frame.col, reason: '' }).replace(/[:：]\s*$/, ''), 'error', actionBtn(T.gotoError, gotoError));
      if (res.hint && res.hint.code === 'nonFinite' && res.error.code === 'nonFinite') res.hint = null;
      if (res.json5) note(fmt(T.json5Offer, { list: changeList(res.json5) }), 'info', actionBtn(T.json5Accept, () => { json5El.checked = true; save(); run(true); }));
      const h = res.hint;
      if (h) {
        if (h.code === 'fence') note(T.hint.fence, 'info', actionBtn(T.hint.fenceBtn, () => replaceInput(h.text)));
        else if (h.code === 'escaped') note(T.hint.escaped, 'info', actionBtn(T.hint.escapedBtn, () => replaceInput(h.text)));
        else if (h.code === 'jsonl') {
          const parts = T.hint.jsonl.split('{link}');
          note('', 'info', (li) => {
            li.textContent = '';
            li.appendChild(document.createTextNode(fmt(parts[0], { n: h.n })));
            const a = el('a', '', T.hint.jsonlLink) as HTMLAnchorElement;
            a.href = wrap.dataset.jsonl || '/tools/jsonl-converter/';
            li.appendChild(a);
            li.appendChild(document.createTextNode(parts[1] || ''));
          });
        } else if (h.code === 'python') note(fmt(T.hint.python, { word: h.word, fix: h.fix }), 'info');
        else if (h.code === 'undefined') note(T.hint.undefined, 'info');
        else if (h.code === 'nonFinite') note(T.hint.nonFinite, 'info');
      }
    }
    notesEl.hidden = !notesEl.childElementCount;
  }
  function reasonOf(e: any) { return fmt(T.parse[e.code] || T.parse.unexpectedChar, { ch: e.ch || input.value.charAt(e.offset) || '' }); }
  function gotoError() {
    if (!errorRange) return;
    input.focus({ preventScroll: true });
    input.setSelectionRange(errorRange[0], errorRange[1]);
    const line = input.value.slice(0, errorRange[0]).split('\n').length - 1;
    const lh = parseFloat(getComputedStyle(input).lineHeight) || 20;
    input.scrollTop = Math.max(0, line * lh - input.clientHeight / 3);
    const r = input.getBoundingClientRect();
    if (r.top < 0 || r.top > window.innerHeight - 80) input.scrollIntoView({ block: 'center' });
  }

  /* Output --------------------------------------------------------------------------- */
  function showText() {
    outCode.className = '';
    if (outText.length <= HIGHLIGHT_LIMIT) outCode.innerHTML = highlight(outText);
    else outCode.textContent = outText;
  }
  function render(res: any) {
    current = res;
    errorRange = null;
    if (res.ok) {
      outText = serialize(res.root, opts());
      const summary = fmt(T.summary, {
        values: plural(T.values, res.stats.objects + res.stats.arrays + res.stats.strings + res.stats.numbers + res.stats.booleans + res.stats.nulls - 0),
        depth: res.stats.depth, inSize: size(utf8Size(input.value)), outSize: size(utf8Size(outText)),
      });
      setStatus(fmt(res.mode === 'json5' ? T.validJson5 : T.valid, { summary }), 'ok');
      if (view === 'text') showText(); else buildTree(res);
      copyBtn.disabled = dlBtn.disabled = false;
    } else {
      outText = '';
      copyBtn.disabled = dlBtn.disabled = true;
      treeEl.textContent = '';
      if (res.empty) {
        setStatus(T.empty, '');
        outCode.className = ''; outCode.textContent = '';
      } else {
        const off = res.error.offset + res.base;
        const fr = codeFrame(input.value, off);
        res.frame = fr;
        errorRange = [off, Math.min(input.value.length, off + 1)];
        setStatus(fmt(T.invalid, { where: fmt(T.where, { line: fr.line, col: fr.col, reason: reasonOf(res.error) }) }), 'error');
        outCode.className = 'jf-error';
        outCode.textContent = fr.text;
      }
    }
    const showTree = view === 'tree' && !!res.ok;
    outPre.hidden = showTree;
    treeWrap.hidden = !showTree;
    renderNotes(res);
  }
  function run(force: boolean) {
    const text = input.value;
    if (!force && text.length > AUTO_LIMIT) {
      setStatus(fmt(T.large, { size: size(text.length) }), '');
      return;
    }
    render(analyze(text, { json5: json5El.checked }));
  }
  function schedule() {
    if (timer) clearTimeout(timer);
    timer = setTimeout(() => run(false), input.value.length > 200_000 ? 600 : 250);
    if (saveTimer) clearTimeout(saveTimer);
    saveTimer = setTimeout(save, 500);
  }
  function rerender() { if (current && current.ok) render(current); else run(true); save(); }

  /* Tree ----------------------------------------------------------------------------- */
  let selected: HTMLElement | null = null;
  let rows = 0;
  function preview(v: any) {
    const k = kindOf(v);
    if (k === 'object') return '{ ' + plural(T.tree.keys, v.k.length) + ' }';
    if (k === 'array') return '[ ' + plural(T.tree.items, v.v.length) + ' ]';
    const s = scalarOut(v, opts());
    return s.length > 200 ? s.slice(0, 199) + '…' : s;
  }
  function makeRow(seg: any, value: any, segs: any[], level: number, dup: boolean): HTMLElement {
    const k = kindOf(value);
    const box = el('div', 'jf-tn');
    const row = el('button', 'jf-tr jf-t-' + k) as HTMLButtonElement;
    row.type = 'button';
    row.setAttribute('role', 'treeitem');
    row.setAttribute('aria-level', String(level));
    row.style.paddingLeft = (0.4 + (level - 1) * 1.1) + 'rem';
    const container = k === 'object' || k === 'array';
    const hasKids = container && value.v.length > 0;
    row.appendChild(el('span', 'jf-tw', hasKids ? '▸' : ''));
    if (seg !== null) row.appendChild(el('span', typeof seg === 'number' ? 'jf-ti' : 'jf-tk', typeof seg === 'number' ? String(seg) : JSON.stringify(seg)));
    if (dup) row.appendChild(el('span', 'jf-tdup', T.tree.dup));
    row.appendChild(el('span', 'jf-tv', preview(value)));
    if (hasKids) row.setAttribute('aria-expanded', 'false');
    (row as any)._segs = segs;
    box.appendChild(row);
    row.addEventListener('click', () => {
      select(row);
      if (hasKids) toggle(box, row, value, segs, level);
    });
    (box as any)._open = () => { if (hasKids && row.getAttribute('aria-expanded') !== 'true') toggle(box, row, value, segs, level); };
    return box;
  }
  function toggle(box: HTMLElement, row: HTMLElement, value: any, segs: any[], level: number) {
    const open = row.getAttribute('aria-expanded') === 'true';
    const kids = box.querySelector(':scope > .jf-tc') as HTMLElement | null;
    if (open) { row.setAttribute('aria-expanded', 'false'); (row.firstChild as HTMLElement).textContent = '▸'; if (kids) kids.hidden = true; return; }
    row.setAttribute('aria-expanded', 'true');
    (row.firstChild as HTMLElement).textContent = '▾';
    if (kids) { kids.hidden = false; return; }
    const c = el('div', 'jf-tc');
    c.setAttribute('role', 'group');
    box.appendChild(c);
    const list = childrenOf(value, opts());
    addChildren(c, list, 0, segs, level);
  }
  function addChildren(c: HTMLElement, list: any[], from: number, segs: any[], level: number) {
    const end = Math.min(list.length, from + CHUNK);
    for (let x = from; x < end; x++) {
      c.appendChild(makeRow(list[x].seg, list[x].value, segs.concat([list[x].seg]), level + 1, !!list[x].dup && opts().dupes !== 'last'));
      rows++;
    }
    if (end < list.length) {
      const more = el('button', 'btn-ghost jf-mini jf-tmore', fmt(T.tree.more, { n: Math.min(CHUNK, list.length - end) })) as HTMLButtonElement;
      more.type = 'button';
      more.style.marginLeft = (0.4 + level * 1.1) + 'rem';
      more.addEventListener('click', () => { more.remove(); addChildren(c, list, end, segs, level); });
      c.appendChild(more);
    }
  }
  function select(row: HTMLElement) {
    if (selected) selected.removeAttribute('aria-selected');
    selected = row;
    row.setAttribute('aria-selected', 'true');
    const segs = (row as any)._segs as any[];
    pathEl.textContent = '';
    const ptr = segs.length ? pointerOf(segs) : '';
    const items: [string, string][] = [[T.tree.pointer, ptr], [T.tree.jq, jqPathOf(segs)]];
    items.forEach(([label, val]) => {
      const line = el('div', 'jf-path-line');
      line.appendChild(el('span', 'jf-path-label', label));
      line.appendChild(el('code', 'jf-path-val', val === '' ? '""' : val));
      const b = el('button', 'btn-ghost jf-mini', T.tree.copyPath) as HTMLButtonElement;
      b.type = 'button';
      b.addEventListener('click', () => copyText(val, b));
      line.appendChild(b);
      pathEl.appendChild(line);
    });
  }
  function buildTree(res: any) {
    treeEl.textContent = '';
    selected = null; rows = 0;
    pathEl.textContent = T.tree.pathHint;
    const root = makeRow(null, res.root, [], 1, false);
    treeEl.appendChild(root);
    (root as any)._open();
    const first = root.querySelector(':scope > .jf-tc');
    if (first && first.childElementCount <= 20) first.querySelectorAll(':scope > .jf-tn').forEach((b: any) => b._open && b._open());
  }
  function expandAll() {
    let opened = 0;
    for (;;) {
      const closed = Array.from(treeEl.querySelectorAll('.jf-tr[aria-expanded="false"]'));
      if (!closed.length || rows > EXPAND_LIMIT) break;
      for (const r of closed) { if (rows > EXPAND_LIMIT) break; ((r.parentElement as any)._open)(); opened++; }
    }
    if (rows > EXPAND_LIMIT) pathEl.textContent = fmt(T.tree.expandLimit, { n: EXPAND_LIMIT.toLocaleString() });
    return opened;
  }
  function collapseAll() { if (current && current.ok) buildTree(current); }

  /* Copy, download, files ------------------------------------------------------------ */
  function copyText(text: string, btn: HTMLButtonElement) {
    const label = btn.textContent;
    const done = () => { btn.textContent = T.copied; setTimeout(() => { btn.textContent = label; }, 1500); };
    const fallback = () => {
      const ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      ta.remove();
      if (ok) done(); else setStatus(T.copyFail, 'error');
    };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fallback);
    else fallback();
  }
  copyBtn.addEventListener('click', () => { if (outText) copyText(outText, copyBtn); });
  dlBtn.addEventListener('click', () => {
    if (!outText) return;
    const base = (fileName || 'data').replace(/\.(json5?|jsonc|txt|geojson|har)$/i, '');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([outText + (mode === 'min' ? '' : '\n')], { type: 'application/json' }));
    a.download = base + (mode === 'min' ? '.min.json' : '.formatted.json');
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  async function openFile(file: File) {
    if (file.size > FILE_LIMIT) { setStatus(fmt(T.tooLarge, { size: size(file.size), max: size(FILE_LIMIT) }), 'error'); return; }
    let buf: ArrayBuffer;
    try { buf = await file.arrayBuffer(); } catch (e: any) { setStatus(fmt(T.readFail, { message: e && e.message || String(e) }), 'error'); return; }
    const d = decodeBytes(new Uint8Array(buf));
    if (d.error) { setStatus(fmt(d.error === 'utf16NoBom' ? T.utf16NoBom : T.notUtf8, { offset: d.offset }), 'error'); return; }
    input.value = d.text;
    fileName = file.name;
    fileNote = d.encoding !== 'UTF-8' ? fmt(T.encodingNote, { encoding: d.encoding }) : '';
    run(true);
    save();
  }
  $('jf-open').addEventListener('click', () => fileEl.click());
  fileEl.addEventListener('change', () => { const f = fileEl.files && fileEl.files[0]; if (f) openFile(f); fileEl.value = ''; });
  wrap.addEventListener('dragover', (e) => { if (e.dataTransfer && Array.from(e.dataTransfer.types).includes('Files')) { e.preventDefault(); wrap.classList.add('jf-drop'); } });
  wrap.addEventListener('dragleave', (e) => { if (e.target === wrap) wrap.classList.remove('jf-drop'); });
  wrap.addEventListener('drop', (e) => {
    wrap.classList.remove('jf-drop');
    const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (f) { e.preventDefault(); openFile(f); }
  });

  /* Controls ------------------------------------------------------------------------- */
  function track(action: string) { (window as any).trackTool && (window as any).trackTool('json_formatter', action); }
  $('jf-format').addEventListener('click', () => { mode = 'pretty'; run(true); save(); track('format'); });
  $('jf-minify').addEventListener('click', () => { mode = 'min'; run(true); save(); track('minify'); });
  wrap.querySelectorAll('[data-indent]').forEach((b: any) => b.addEventListener('click', () => {
    indent = b.getAttribute('data-indent'); mode = 'pretty';
    setPressed('[data-indent]', 'data-indent', indent);
    rerender();
  }));
  wrap.querySelectorAll('[data-view]').forEach((b: any) => b.addEventListener('click', () => {
    view = b.getAttribute('data-view') === 'tree' ? 'tree' : 'text';
    setPressed('[data-view]', 'data-view', view);
    rerender();
  }));
  [sortEl, asciiEl, numbersEl, dupesEl].forEach((c) => c.addEventListener('change', rerender));
  json5El.addEventListener('change', () => { run(true); save(); });
  $('jf-sample').addEventListener('click', () => replaceInput(SAMPLE));
  $('jf-clear').addEventListener('click', () => {
    input.value = ''; fileName = ''; fileNote = '';
    (window as any).ztPersist?.clear(SLUG);
    run(true); save();
    input.focus();
  });
  $('jf-expand').addEventListener('click', expandAll);
  $('jf-collapse').addEventListener('click', collapseAll);
  input.addEventListener('input', schedule);
  // Ctrl/Cmd+L (ToolLayout) empties the textarea without an input event.
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L')) setTimeout(() => { if (!input.value) { fileName = ''; fileNote = ''; run(true); save(); } }, 0);
  });

  const saved = (window as any).ztPersist?.load(SLUG) || {};
  if (saved.mode === 'min') mode = 'min';
  if (saved.indent === '4' || saved.indent === 'tab') indent = saved.indent;
  if (saved.view === 'tree') view = 'tree';
  sortEl.checked = !!saved.sort;
  asciiEl.checked = !!saved.ascii;
  json5El.checked = !!saved.json5;
  if (saved.numbers === 'js') numbersEl.value = 'js';
  if (saved.dupes === 'last') dupesEl.value = 'last';
  setPressed('[data-indent]', 'data-indent', indent);
  setPressed('[data-view]', 'data-view', view);
  if (typeof saved.input === 'string' && saved.input) input.value = saved.input;
  if (input.value) run(false);
</script>

<style is:global>
  /* Every selector uses the jf- prefix (unique to this tool); global because the tree,
     notes and highlighted output are created by the script. */
  .jf-wrap { display: flex; flex-direction: column; gap: 0.7rem; }
  .jf-wrap.jf-drop { outline: 2px dashed var(--color-primary); outline-offset: 6px; border-radius: var(--radius-md); }

  .jf-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .jf-toolbar-end { display: inline-flex; flex-wrap: wrap; gap: 0.4rem; margin-left: auto; }

  .jf-seg {
    display: inline-flex;
    padding: 3px;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
