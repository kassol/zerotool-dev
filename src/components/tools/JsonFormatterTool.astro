    const end = from + page.rows.length;
    if (end < page.total) {
      const more = el('button', 'btn-ghost jf-mini jf-tmore', fmt(T.tree.more, { n: Math.min(CHUNK, page.total - end) })) as HTMLButtonElement;
      more.type = 'button';
      more.style.marginLeft = (0.4 + level * 1.1) + 'rem';
