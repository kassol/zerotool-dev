const S = STRINGS[lang] || STRINGS.en;
const jsonlHref = (lang === 'en' ? '' : '/' + lang) + '/tools/jsonl-converter/';
---

<div class="jf-wrap" id="jf-wrap" data-strings={JSON.stringify(S)} data-jsonl={jsonlHref}>
  <div class="jf-toolbar">
    <button id="jf-format" class="btn-primary" type="button">{S.format}</button>
    <button id="jf-minify" class="btn-secondary" type="button">{S.minify}</button>
    <div class="jf-seg" role="group" aria-label={S.indentAria}>
      <button type="button" class="jf-seg-btn" data-indent="2" aria-pressed="true">{S.indent2}</button>
      <button type="button" class="jf-seg-btn" data-indent="4" aria-pressed="false">{S.indent4}</button>
      <button type="button" class="jf-seg-btn" data-indent="tab" aria-pressed="false">{S.indentTab}</button>
    </div>
    <span class="jf-toolbar-end">
      <button id="jf-open" class="btn-ghost" type="button">{S.open}</button>
      <button id="jf-sample" class="btn-ghost" type="button">{S.sample}</button>
      <button id="jf-clear" class="btn-ghost" type="button">{S.clear}</button>
    </span>
  </div>
  <input type="file" id="jf-file" accept=".json,.jsonc,.json5,.geojson,.har,.txt,application/json,text/plain" hidden />

  <p id="jf-status" class="jf-status" role="status" aria-live="polite">{S.empty}</p>

  <div class="jf-panels">
    <div class="jf-panel">
      <label for="jf-input" class="jf-label">{S.inputLabel}</label>
      <textarea id="jf-input" class="tool-textarea jf-text" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder={S.placeholder}></textarea>
    </div>
    <div class="jf-panel">
      <div class="jf-out-head">
        <span class="jf-label" id="jf-output-label">{S.outputLabel}</span>
        <div class="jf-seg jf-view" role="group" aria-label={S.viewAria}>
          <button type="button" class="jf-seg-btn" data-view="text" aria-pressed="true">{S.viewText}</button>
          <button type="button" class="jf-seg-btn" data-view="tree" aria-pressed="false">{S.viewTree}</button>
        </div>
        <span class="jf-out-actions">
          <button id="jf-copy" class="btn-copy" type="button" disabled>{S.copy}</button>
          <button id="jf-download" class="btn-copy" type="button" disabled>{S.download}</button>
        </span>
      </div>
      <pre id="jf-output" class="jf-output" tabindex="0" aria-labelledby="jf-output-label"><code id="jf-output-code"></code></pre>
      <div id="jf-tree-wrap" class="jf-tree-wrap" hidden>
        <div class="jf-tree-bar">
          <button id="jf-expand" class="btn-ghost jf-mini" type="button">{S.tree.expandAll}</button>
          <button id="jf-collapse" class="btn-ghost jf-mini" type="button">{S.tree.collapseAll}</button>
        </div>
        <div id="jf-tree" class="jf-tree" role="tree" aria-labelledby="jf-output-label"></div>
        <div id="jf-path" class="jf-path">{S.tree.pathHint}</div>
      </div>
    </div>
  </div>

  <ul id="jf-notes" class="jf-notes" hidden></ul>

  <div class="jf-options" role="group" aria-label={S.optionsAria}>
    <label class="jf-check"><input type="checkbox" id="jf-sort" /> <span>{S.optSort}</span></label>
    <label class="jf-check"><input type="checkbox" id="jf-ascii" /> <span>{S.optAscii}</span></label>
    <label class="jf-check"><input type="checkbox" id="jf-json5" /> <span>{S.optJson5}</span></label>
    <label class="jf-field">
      <span>{S.numbersLabel}</span>
      <select id="jf-numbers" class="tool-input jf-select">
        <option value="raw">{S.numRaw}</option>
        <option value="js">{S.numJs}</option>
      </select>
    </label>
    <label class="jf-field">
      <span>{S.dupesLabel}</span>
      <select id="jf-dupes" class="tool-input jf-select">
        <option value="keep">{S.dupKeep}</option>
        <option value="last">{S.dupLast}</option>
      </select>
    </label>
  </div>
</div>

<script>
  import { fmt, pointerOf, jqPathOf } from './json-formatter-engine.js';
  import FormatterWorker from './json-formatter.worker.js?worker';
  import { createFormatterClient } from './json-formatter-run.js';

  const wrap = document.getElementById('jf-wrap') as HTMLElement;
  const T: any = JSON.parse(wrap.dataset.strings || '{}');
  const SLUG = 'json-formatter';
  const $ = (id: string) => document.getElementById(id) as any;
  const input = $('jf-input') as HTMLTextAreaElement;
  const statusEl = $('jf-status') as HTMLElement;
  const outPre = $('jf-output') as HTMLElement;
  const outCode = $('jf-output-code') as HTMLElement;
  const treeWrap = $('jf-tree-wrap') as HTMLElement;
  const treeEl = $('jf-tree') as HTMLElement;
  const pathEl = $('jf-path') as HTMLElement;
  const notesEl = $('jf-notes') as HTMLUListElement;
  const copyBtn = $('jf-copy') as HTMLButtonElement;
  const dlBtn = $('jf-download') as HTMLButtonElement;
  const fileEl = $('jf-file') as HTMLInputElement;
  const sortEl = $('jf-sort') as HTMLInputElement;
  const asciiEl = $('jf-ascii') as HTMLInputElement;
  const json5El = $('jf-json5') as HTMLInputElement;
  const numbersEl = $('jf-numbers') as HTMLSelectElement;
  const dupesEl = $('jf-dupes') as HTMLSelectElement;
  const AUTO_LIMIT = 2_000_000;
  const FILE_LIMIT = 50 * 1024 * 1024;
  const CHUNK = 200;
  const EXPAND_LIMIT = 2000;
  // The status says "working" only when a result takes longer than this, so small inputs do
  // not flicker.
  const WORKING_DELAY = 150;
  // A long output is written into the <pre> in blocks of about this many characters (see showText).
  const DISPLAY_BLOCK = 16 * 1024;
  const HTML_FIRST = 4;
  const HTML_STEP = 4;
  const CV = typeof CSS !== 'undefined' && CSS.supports('content-visibility', 'auto');
  const SAMPLE = '{"id":1830000000000000001,"name":"ZeroTool","price":19.90,"tags":["json","formatter"],"owner":{"login":"kassol","verified":true},"updatedAt":"2026-10-02T09:30:00Z","notes":null}';

  // Parsing, serializing and the tree data run in a worker (json-formatter.worker.js). The page
  // keeps the view the worker returns: output text, notes and tree rows.
  const client = createFormatterClient(() => new FormatterWorker());

  let mode: 'pretty' | 'min' = 'pretty';
  let indent = '2';
  let view: 'text' | 'tree' = 'text';
  let outText = '';
  let current: any = null;
  let docId = 0;
  let generation = 0;
  let fileName = '';
  let fileNote = '';
  let errorRange: number[] | null = null;
  let timer: ReturnType<typeof setTimeout> | null = null;
  let saveTimer: ReturnType<typeof setTimeout> | null = null;
  let workingTimer: ReturnType<typeof setTimeout> | null = null;

  function plural(pair: string[], n: number) { return fmt(n === 1 ? pair[0] : pair[1], { n: n.toLocaleString() }); }
  function size(chars: number) {
    if (chars < 1024) return chars + ' B';
    if (chars < 1024 * 1024) return (chars / 1024).toFixed(1) + ' KB';
    return (chars / 1024 / 1024).toFixed(1) + ' MB';
  }
  function el(tag: string, cls?: string, text?: string): HTMLElement {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  }
  function opts() {
    return {
      indent: mode === 'min' ? '' : indent === 'tab' ? '\t' : indent === '4' ? '    ' : '  ',
      sortKeys: sortEl.checked, ascii: asciiEl.checked,
      numbers: numbersEl.value === 'js' ? 'js' : 'raw', dupes: dupesEl.value === 'last' ? 'last' : 'keep',
      text: view === 'text',
    };
  }
  function prefs() {
    return { mode, indent, view, sort: sortEl.checked, ascii: asciiEl.checked, json5: json5El.checked, numbers: numbersEl.value, dupes: dupesEl.value };
  }
  function save() {
    const p: any = prefs();
    if (input.value.length < 200_000) p.input = input.value;
    (window as any).ztPersist?.save(SLUG, p);
  }
  function setStatus(text: string, kind: string) {
    statusEl.textContent = text;
    statusEl.className = 'jf-status' + (kind ? ' jf-' + kind : '');
  }
  function setPressed(sel: string, attr: string, value: string) {
    wrap.querySelectorAll(sel).forEach((b: any) => b.setAttribute('aria-pressed', String(b.getAttribute(attr) === value)));
  }

  /* Notes ---------------------------------------------------------------------------- */
  function note(text: string, kind: string, extra?: (li: HTMLElement) => void) {
    const li = el('li', 'jf-note jf-note-' + kind);
    li.appendChild(el('span', '', text));
    if (extra) extra(li);
    notesEl.appendChild(li);
  }
  function actionBtn(label: string, fn: () => void) {
    return (li: HTMLElement) => {
      const b = el('button', 'btn-ghost jf-mini', label) as HTMLButtonElement;
      b.type = 'button';
      b.addEventListener('click', fn);
      li.appendChild(b);
    };
  }
  function subList(items: string[], more: number) {
    return (li: HTMLElement) => {
      const ul = el('ul', 'jf-sub');
      items.forEach((s) => ul.appendChild(el('li', '', s)));
      if (more > 0) ul.appendChild(el('li', '', fmt(T.moreItems, { n: more })));
      li.appendChild(ul);
    };
  }
  function changeList(changes: any) {
    return Object.keys(T.changes).filter((k) => changes && changes[k] > 0).map((k) => plural(T.changes[k], changes[k])).join(', ');
  }
  // Paths and line numbers come from the worker; null is the root.
  function pathText(path: string | null) { return path === null ? T.tree.root : path; }
  function replaceInput(text: string) {
    input.value = text;
    fileName = ''; fileNote = '';
    run(true);
    save();
    input.focus({ preventScroll: true });
  }

  function renderNotes(res: any) {
    notesEl.textContent = '';
    if (fileNote) note(fileNote, 'info');
    if (res.bom) note(T.bomNote, 'info');
    if (res.ok) {
      if (res.mode === 'json5') note(fmt(T.json5Done, { list: changeList(res.changes) }), 'info');
      const o = opts();
      if (res.dupCount) {
        note(plural(o.dupes === 'last' ? T.dupNoteLast : T.dupNote, res.dupCount), 'warn',
          subList(res.dups.map((d: any) => fmt(T.dupItem, { key: d.key, path: pathText(d.path), line: d.line })), res.dupCount - res.dups.length));
      }
      if (res.numberCount) {
        const msg = o.numbers === 'js' ? T.numNoteJs : T.numNote;
        const key: any = { precision: 'numPrecision', overflow: 'numOverflow', underflow: 'numUnderflow', negZero: 'numNegZero' };
        note(plural(msg, res.numberCount), 'warn',
          subList(res.numbers.map((x: any) => fmt(T[key[x.kind]], { raw: x.raw, js: x.js, path: pathText(x.path), line: x.line })), res.numberCount - res.numbers.length));
      }
      if (res.surrogateCount) {
        note(plural(T.surrNote, res.surrogateCount), 'warn',
          subList(res.surrogates.map((x: any) => fmt(T.surrItem, { path: pathText(x.path), line: x.line })), res.surrogateCount - res.surrogates.length));
      }
      if (res.inner) note(T.hint.inner, 'info', actionBtn(T.hint.innerBtn, () => replaceInput(res.inner)));
      if (view === 'text' && res.big) note(fmt(T.highlightOff, { size: size(res.outSize) }), 'info');
    } else if (!res.empty) {
      if (errorRange) note(fmt(T.where, { line: res.frame.line, col: res.frame.col, reason: '' }).replace(/[:：]\s*$/, ''), 'error', actionBtn(T.gotoError, gotoError));
      if (res.hint && res.hint.code === 'nonFinite' && res.error.code === 'nonFinite') res.hint = null;
      if (res.json5) note(fmt(T.json5Offer, { list: changeList(res.json5) }), 'info', actionBtn(T.json5Accept, () => { json5El.checked = true; save(); run(true); }));
      const h = res.hint;
      if (h) {
        if (h.code === 'fence') note(T.hint.fence, 'info', actionBtn(T.hint.fenceBtn, () => replaceInput(h.text)));
        else if (h.code === 'escaped') note(T.hint.escaped, 'info', actionBtn(T.hint.escapedBtn, () => replaceInput(h.text)));
        else if (h.code === 'jsonl') {
          const parts = T.hint.jsonl.split('{link}');
          note('', 'info', (li) => {
            li.textContent = '';
            li.appendChild(document.createTextNode(fmt(parts[0], { n: h.n })));
            const a = el('a', '', T.hint.jsonlLink) as HTMLAnchorElement;
            a.href = wrap.dataset.jsonl || '/tools/jsonl-converter/';
            li.appendChild(a);
            li.appendChild(document.createTextNode(parts[1] || ''));
          });
        } else if (h.code === 'python') note(fmt(T.hint.python, { word: h.word, fix: h.fix }), 'info');
        else if (h.code === 'undefined') note(T.hint.undefined, 'info');
        else if (h.code === 'nonFinite') note(T.hint.nonFinite, 'info');
      }
    }
    notesEl.hidden = !notesEl.childElementCount;
  }
  function reasonOf(e: any) { return fmt(T.parse[e.code] || T.parse.unexpectedChar, { ch: e.ch }); }
  function gotoError() {
    if (!errorRange) return;
    input.focus({ preventScroll: true });
    input.setSelectionRange(errorRange[0], errorRange[1]);
    const line = current && current.frame ? current.frame.line - 1 : 0;
    const lh = parseFloat(getComputedStyle(input).lineHeight) || 20;
    input.scrollTop = Math.max(0, line * lh - input.clientHeight / 3);
    const r = input.getBoundingClientRect();
    if (r.top < 0 || r.top > window.innerHeight - 80) input.scrollIntoView({ block: 'center' });
  }

  /* Output --------------------------------------------------------------------------- */
  let displayGen = 0;
  function showText(res: any) {
    outCode.className = '';
    const gen = ++displayGen;
    if (res.html !== undefined) {
      // Highlighted output: line-aligned blocks of HTML from the worker (blockHtml). The first
      // ones go in at once; the rest a few per task, so no single task parses the whole megabyte.
      const parts: string[] = res.html;
      outCode.innerHTML = parts.slice(0, HTML_FIRST).join('');
      let i = HTML_FIRST;
      const more = () => {
        if (gen !== displayGen) return;
        outCode.insertAdjacentHTML('beforeend', parts.slice(i, i + HTML_STEP).join(''));
        i += HTML_STEP;
        if (i < parts.length) setTimeout(more, 0);
      };
      if (i < parts.length) setTimeout(more, 0);
      return;
    }
    // Only the first 1 MB of a long output is shown (the worker cuts it at a line end). Laying
    // out that megabyte at once blocks the page for over a second, so it is split into blocks
    // with content-visibility: auto: the browser lays out only the blocks near the visible part.
    // Without content-visibility (older browsers) one block is added per frame instead.
    const text: string = res.display || '';
    outCode.textContent = '';
    const blocks: HTMLElement[] = [];
    for (let pos = 0; pos < text.length;) {
      let end = Math.min(text.length, pos + DISPLAY_BLOCK);
      const nl = text.indexOf('\n', end);
      end = end >= text.length || nl < 0 ? text.length : nl + 1;
      const part = text.slice(pos, end);
      const blk = el('span', 'jf-blk', part);
      // white-space: pre does not wrap, so the height of a block is its line count.
      let lines = part.charAt(part.length - 1) === '\n' ? 0 : 1;
      for (let i = part.indexOf('\n'); i !== -1; i = part.indexOf('\n', i + 1)) lines++;
      blk.style.setProperty('contain-intrinsic-height', 'auto ' + lines * 1.5 + 'em');
      blocks.push(blk);
      pos = end;
    }
    if (CV) { outCode.append(...blocks); return; }
    let n = 0;
    const step = () => {
      if (gen !== displayGen) return;
      outCode.appendChild(blocks[n++]);
      if (n < blocks.length) requestAnimationFrame(step);
    };
    if (blocks.length) step();
  }
  function render(res: any) {
    current = res;
    errorRange = null;
    if (res.ok) {
      outText = res.out;
      const summary = fmt(T.summary, {
        values: plural(T.values, res.stats.objects + res.stats.arrays + res.stats.strings + res.stats.numbers + res.stats.booleans + res.stats.nulls - 0),
        depth: res.stats.depth, inSize: size(res.inSize), outSize: size(res.outSize),
      });
      setStatus(fmt(res.mode === 'json5' ? T.validJson5 : T.valid, { summary }), 'ok');
      if (view === 'text') showText(res); else buildTree(res);
      copyBtn.disabled = dlBtn.disabled = false;
    } else {
      displayGen++;
      outText = '';
      copyBtn.disabled = dlBtn.disabled = true;
      treeEl.textContent = '';
      if (res.empty) {
        setStatus(T.empty, '');
        outCode.className = ''; outCode.textContent = '';
      } else {
        const fr = res.frame;
        errorRange = res.errorRange;
        setStatus(fmt(T.invalid, { where: fmt(T.where, { line: fr.line, col: fr.col, reason: reasonOf(res.error) }) }), 'error');
        outCode.className = 'jf-error';
        outCode.textContent = fr.text;
      }
    }
    const showTree = view === 'tree' && !!res.ok;
    outPre.hidden = showTree;
    treeWrap.hidden = !showTree;
    renderNotes(res);
  }
  function working(chars: number) {
    if (workingTimer) clearTimeout(workingTimer);
    workingTimer = setTimeout(() => { setStatus(fmt(T.working, { size: size(chars) }), ''); }, WORKING_DELAY);
  }
  function settled(gen: number) {
    if (gen !== generation) return false;
    if (workingTimer) { clearTimeout(workingTimer); workingTimer = null; }
    return true;
  }
  function failed(gen: number, error: any) {
    if (!settled(gen) || (error && error.name === 'AbortError')) return;
    current = null; outText = ''; displayGen++;
    copyBtn.disabled = dlBtn.disabled = true;
    setStatus(fmt(T.workerFail, { message: (error && error.message) || String(error) }), 'error');
  }
  function run(force: boolean) {
    const text = input.value;
    const gen = ++generation;
    if (!force && text.length > AUTO_LIMIT) {
      if (workingTimer) { clearTimeout(workingTimer); workingTimer = null; }
      client.cancel();
      setStatus(fmt(T.large, { size: size(text.length) }), '');
      return;
    }
    working(text.length);
    client.analyze(text, json5El.checked, opts()).then((r: any) => {
      if (!settled(gen)) return;
      docId = r.docId;
      render(r.view);
    }, (e: any) => failed(gen, e));
  }
  function schedule() {
