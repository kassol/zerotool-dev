  }
  async function addChildren(c: HTMLElement, from: number, idxs: number[], segs: any[], level: number) {
    const gen = treeGen;
    let page: any;
    try { page = await client.children(docId, idxs, from, CHUNK, opts()); } catch (e) { return; }
    if (gen !== treeGen || page.stale) return;
    for (const r of page.rows) {
      c.appendChild(makeRow(r, idxs.concat([r.idx]), segs.concat([r.seg]), level + 1));
      rows++;
