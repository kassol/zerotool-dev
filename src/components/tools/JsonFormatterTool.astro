  /* Tree ----------------------------------------------------------------------------- */
  // Rows hold the position path (indexes into the parsed document, kept in the worker) and the
  // key path (for the JSON Pointer and jq path). Children are requested CHUNK rows at a time.
  let selected: HTMLElement | null = null;
  let rows = 0;
  let treeGen = 0;
  function preview(r: any) {
    if (r.kind === 'object') return '{ ' + plural(T.tree.keys, r.count) + ' }';
    if (r.kind === 'array') return '[ ' + plural(T.tree.items, r.count) + ' ]';
    return r.preview;
  }
  function makeRow(r: any, idxs: number[], segs: any[], level: number): HTMLElement {
    const box = el('div', 'jf-tn');
    const row = el('button', 'jf-tr jf-t-' + r.kind) as HTMLButtonElement;
    row.type = 'button';
    row.setAttribute('role', 'treeitem');
    row.setAttribute('aria-level', String(level));
    row.style.paddingLeft = (0.4 + (level - 1) * 1.1) + 'rem';
