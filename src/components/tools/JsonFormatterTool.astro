      pathEl.appendChild(line);
    });
  }
  async function buildTree(res: any) {
    const gen = ++treeGen;
    treeEl.textContent = '';
    selected = null; rows = 0;
    pathEl.textContent = T.tree.pathHint;
    const root = makeRow(res.root, [], [], 1);
    treeEl.appendChild(root);
    await (root as any)._open();
    if (gen !== treeGen) return;
    const first = root.querySelector(':scope > .jf-tc');
    if (first && first.childElementCount <= 20) {
      for (const b of Array.from(first.querySelectorAll(':scope > .jf-tn')) as any[]) {
        if (gen !== treeGen) return;
