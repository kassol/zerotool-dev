---
// YamlValidatorTool — validate YAML syntax with detailed error messages and structure preview
// The preview is JSON: values it cannot show as written (.inf / .nan, integers outside
// ±(2^53 − 1), timestamps that are not real dates or have more than millisecond precision) are
// listed under it with their JSON Pointer paths (conversion-fidelity.js); validation is unchanged.
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const labels = {
  en: {
    emptyResult: "Validate YAML to see its parsed structure or syntax errors here.",
    errorDetails: "Error details",
    tips: {
      input: "Paste one YAML document or several separated by ---. Validation checks syntax, not an application schema or lint rules. Editing does not validate automatically; click Validate again to update the result.",
      validate: "Click Validate or press Ctrl+Enter (⌘+Enter on Mac). Valid YAML shows a JSON preview. Errors include the parser reason, line, column and snippet when available. If any document has an error, each document is listed with available line ranges.",
      clear: "Clear empties the input, status, errors, preview and precision note. Ctrl+L (⌘+L on Mac) does the same while focus is inside this tool.",
      preview: "Read the parsed data to check its structure. Multiple documents appear as a JSON array. Anchors and merge keys are expanded; comments are omitted. Values JSON cannot show as written are listed above the preview with their paths.",
      copy: "Copy JSON copies the displayed JSON preview. Review the precision note first: non-finite numbers, large integers and some dates cannot be shown exactly. Negative zero is written as -0.0 and timestamps are shown in UTC.",
    },
    inputLabel: 'YAML Input',
    clear: 'Clear',
    validate: 'Validate',
    parsedStructure: 'Parsed Structure',
    copyJson: 'Copy JSON',
    copied: 'Copied!',
    copyFailed: 'Copy failed — retry',
    msgEmpty: 'Paste YAML and click Validate.',
    msgLibMissing: 'YAML library not loaded. Please check your network connection.',
    msgValid: 'Valid YAML \u2014 no errors found.',
    msgInvalid: 'Invalid YAML \u2014 see error details below.',
    msgValidMulti: 'Valid YAML \u2014 {n} documents, no errors found. The preview shows them as a JSON array.',
    msgInvalidMulti: 'Invalid YAML \u2014 {bad} of {n} documents have errors; see details below.',
    docTitle: 'Document {k}',
    docLines: 'lines {a}\u2013{b}',
    docValid: 'valid',
    errTitle: 'Syntax error',
    errLine: 'Line {line}',
    errLineCol: 'Line {line}, column {col}',
  },
  zh: {
    emptyResult: "验证 YAML 后，这里显示解析结构或语法错误。",
    errorDetails: "错误详情",
    tips: {
      input: "粘贴一个 YAML 文档，或用 --- 分隔的多个文档。验证只检查语法，不检查应用 schema 或代码风格。编辑时不会自动验证，需再次点击「验证」更新结果。",
      validate: "点击「验证」或按 Ctrl+Enter（Mac 为 ⌘+Enter）。合法 YAML 显示 JSON 预览；错误会显示解析器原因，以及可用的行号、列号和代码片段。有文档出错时，会逐个列出文档结果和可用的行范围。",
      clear: "「清除」清空输入、状态、错误、预览和精度注记。焦点在本工具内时，Ctrl+L（Mac 为 ⌘+L）执行相同操作。",
      preview: "检查解析出的数据结构是否符合预期。多个文档以 JSON 数组显示，锚点和合并键已展开，注释不显示。JSON 无法原样表示的值会在预览上方按路径列出。",
      copy: "「复制 JSON」复制当前 JSON 预览。先查看精度注记：非有限数、大整数和部分日期无法精确显示。负零写为 -0.0，时间戳显示为 UTC。",
    },
    inputLabel: 'YAML 输入',
    clear: '清除',
    validate: '验证',
    parsedStructure: '解析结构',
    copyJson: '复制 JSON',
    copied: '已复制！',
    copyFailed: '复制失败，请重试',
    msgEmpty: '粘贴 YAML 内容，然后点击验证。',
    msgLibMissing: 'YAML 库未加载，请检查网络连接。',
    msgValid: 'YAML 有效 \u2014 未发现错误。',
    msgInvalid: 'YAML 无效 \u2014 请查看下方错误详情。',
    msgValidMulti: 'YAML 有效 \u2014 共 {n} 个文档，未发现错误。预览以 JSON 数组显示。',
    msgInvalidMulti: 'YAML 无效 \u2014 {n} 个文档中有 {bad} 个有错误，请查看下方详情。',
    docTitle: '文档 {k}',
    docLines: '第 {a}\u2013{b} 行',
    docValid: '有效',
    errTitle: '语法错误',
    errLine: '第 {line} 行',
    errLineCol: '第 {line} 行，第 {col} 列',
  },
  ja: {
    emptyResult: "YAML を検証すると、解析結果や構文エラーがここに表示されます。",
    errorDetails: "エラー詳細",
    tips: {
      input: "YAML 文書を 1 つ、または --- で区切って複数貼り付けます。構文だけを検証し、アプリのスキーマや lint ルールは確認しません。編集だけでは再検証しないので、「検証」を押して結果を更新してください。",
      validate: "「検証」または Ctrl+Enter（Mac は ⌘+Enter）を押します。有効な YAML は JSON でプレビューします。エラーにはパーサーの理由と、取得できる行・列・スニペットを表示します。文書にエラーがあれば、各文書の結果と取得できる行範囲を示します。",
      clear: "「クリア」は入力、ステータス、エラー、プレビュー、精度の注記を空にします。このツール内にフォーカスがあれば Ctrl+L（Mac は ⌘+L）も同じ操作です。",
      preview: "解析された構造を確認してください。複数文書は JSON 配列になります。アンカーとマージキーは展開し、コメントは省きます。JSON で元のとおりに表示できない値は、パスとともにプレビューの上に示します。",
      copy: "「JSON をコピー」は表示中の JSON プレビューをコピーします。先に精度の注記を確認してください。非有限数、大きな整数、一部の日付は正確に表示できません。負のゼロは -0.0、タイムスタンプは UTC で表示します。",
    },
    inputLabel: 'YAML 入力',
    clear: 'クリア',
    validate: '検証',
    parsedStructure: '解析結果',
    copyJson: 'JSON をコピー',
    copied: 'コピーしました！',
    copyFailed: 'コピー失敗・再試行',
    msgEmpty: 'YAML を貼り付けて検証をクリックしてください。',
    msgLibMissing: 'YAML ライブラリが読み込まれていません。ネットワーク接続を確認してください。',
    msgValid: 'YAML は有効です \u2014 エラーなし。',
    msgInvalid: 'YAML は無効です \u2014 下のエラー詳細を確認してください。',
    msgValidMulti: 'YAML は有効です \u2014 {n} 個のドキュメント、エラーなし。プレビューは JSON 配列で表示します。',
    msgInvalidMulti: 'YAML は無効です \u2014 {n} 個のドキュメントのうち {bad} 個にエラーがあります。下の詳細を確認してください。',
    docTitle: 'ドキュメント {k}',
    docLines: '{a}\u2013{b} 行目',
    docValid: '有効',
    errTitle: '構文エラー',
    errLine: '{line} 行目',
    errLineCol: '{line} 行目、{col} 列目',
  },
  ko: {
    emptyResult: "YAML을 검증하면 여기에 파싱 구조나 구문 오류가 표시됩니다.",
    errorDetails: "오류 세부사항",
    tips: {
      input: "YAML 문서 하나 또는 ---로 나눈 여러 문서를 붙여 넣으세요. 구문만 검사하며 앱 스키마나 lint 규칙은 검사하지 않습니다. 편집만으로는 재검증하지 않으므로 「검증」을 눌러 결과를 갱신하세요.",
      validate: "「검증」 또는 Ctrl+Enter(Mac은 ⌘+Enter)를 누르세요. 유효한 YAML은 JSON 미리보기로 표시합니다. 오류에는 파서의 원인과 제공되는 줄·열·스니펫을 표시합니다. 문서에 오류가 있으면 각 문서의 결과와 제공되는 줄 범위를 보여 줍니다.",
      clear: "「지우기」는 입력, 상태, 오류, 미리보기, 정밀도 안내를 비웁니다. 이 도구 안에 포커스가 있으면 Ctrl+L(Mac은 ⌘+L)도 같은 작업을 합니다.",
      preview: "파싱된 데이터 구조를 확인하세요. 여러 문서는 JSON 배열로 표시합니다. 앵커와 병합 키는 펼쳐지고 주석은 제외됩니다. JSON으로 원래대로 표시할 수 없는 값은 경로와 함께 미리보기 위에 나옵니다.",
      copy: "「JSON 복사」는 현재 JSON 미리보기를 복사합니다. 정밀도 안내를 먼저 확인하세요. 비유한 수, 큰 정수, 일부 날짜는 정확히 표시할 수 없습니다. 음수 0은 -0.0으로, 타임스탬프는 UTC로 표시합니다.",
    },
    inputLabel: 'YAML 입력',
    clear: '지우기',
    validate: '검증',
    parsedStructure: '파싱 구조',
    copyJson: 'JSON 복사',
    copied: '복사됨!',
    copyFailed: '복사 실패 — 다시 시도',
    msgEmpty: 'YAML을 붙여넣고 검증을 클릭하세요.',
    msgLibMissing: 'YAML 라이브러리가 로드되지 않았습니다. 네트워크 연결을 확인하세요.',
    msgValid: 'YAML 유효 \u2014 오류 없음.',
    msgInvalid: 'YAML 유효하지 않음 \u2014 아래 오류 세부사항을 확인하세요.',
    msgValidMulti: 'YAML 유효 \u2014 문서 {n}개, 오류 없음. 미리보기는 JSON 배열로 표시합니다.',
    msgInvalidMulti: 'YAML 유효하지 않음 \u2014 문서 {n}개 중 {bad}개에 오류가 있습니다. 아래 세부사항을 확인하세요.',
    docTitle: '문서 {k}',
    docLines: '{a}\u2013{b}행',
    docValid: '유효',
    errTitle: '구문 오류',
    errLine: '{line}행',
    errLineCol: '{line}행 {col}열',
  },
};

const L = labels[lang];
const { tips: TIPS } = L;
---

<div class="yv-wrap"
    data-lang={lang}
    data-err-title={L.errTitle}
    data-err-line={L.errLine}
    data-err-line-col={L.errLineCol}
    data-msg-empty={L.msgEmpty}
    data-msg-lib-missing={L.msgLibMissing}
    data-msg-valid={L.msgValid}
    data-msg-invalid={L.msgInvalid}
    data-msg-valid-multi={L.msgValidMulti}
    data-msg-invalid-multi={L.msgInvalidMulti}
    data-doc-title={L.docTitle}
    data-doc-lines={L.docLines}
    data-doc-valid={L.docValid}
    data-copy-json={L.copyJson}
    data-copied={L.copied}
    data-copy-failed={L.copyFailed}
 >
  <div class="yv-actions">
    <span class="yv-control">
      <button id="yv-validate" class="btn-primary" type="button">{L.validate}</button>
      <Toggletip id="yv-tip-validate" lang={lang} about={L.validate}>{TIPS.validate}</Toggletip>
    </span>
    <span class="yv-control">
      <button id="yv-clear" class="btn-ghost" type="button">{L.clear}</button>
      <Toggletip id="yv-tip-clear" lang={lang} about={L.clear}>{TIPS.clear}</Toggletip>
    </span>
  </div>
  <div id="yv-status" class="yv-status" role="status" aria-live="polite"></div>
  <div class="yv-input-section">
    <div class="yv-heading">
      <label for="yv-input">{L.inputLabel}</label>
      <Toggletip id="yv-tip-input" lang={lang} about={L.inputLabel}>{TIPS.input}</Toggletip>
    </div>
    <textarea
      id="yv-input"
      placeholder={"name: Alice\nage: 30\naddress:\n  city: Wonderland\n  zip: '00000'\nhobbies:\n  - reading\n  - hiking"}
      spellcheck="false"
    ></textarea>
  </div>
  <div id="yv-results" class="yv-results" data-empty="true">
    <p class="yv-empty">{L.emptyResult}</p>
    <div id="yv-error-box" class="yv-error-box" style="display:none" tabindex="0" role="region" aria-label={L.errorDetails}></div>
    <div id="yv-preview" class="yv-preview" style="display:none">
      <div class="yv-preview-header">
        <span>{L.parsedStructure}</span>
        <Toggletip id="yv-tip-preview" lang={lang} about={L.parsedStructure}>{TIPS.preview}</Toggletip>
        <span class="yv-control yv-copy-control">
          <button id="yv-copy-preview" class="btn-copy" type="button">{L.copyJson}</button>
          <Toggletip id="yv-tip-copy" lang={lang} about={L.copyJson}>{TIPS.copy}</Toggletip>
        </span>
      </div>
      <p id="yv-preview-note" class="yv-preview-note" role="note" hidden></p>
      <pre id="yv-preview-content" class="yv-preview-content" tabindex="0" role="region" aria-label={L.parsedStructure}></pre>
    </div>
  </div>

  <script>
    import jsyaml from 'js-yaml';
    import { yamlLimitText } from './yaml-limits.js';
    import { yamlLoadSchema, findLosses, formatLosses, stringifyJson } from './conversion-fidelity.js';

    const inputEl   = document.getElementById('yv-input') as HTMLTextAreaElement;
    const statusEl  = document.getElementById('yv-status')!;
    const errorBox  = document.getElementById('yv-error-box')!;
    const previewEl = document.getElementById('yv-preview')!;
    const previewContent = document.getElementById('yv-preview-content')!;
    const previewNote = document.getElementById('yv-preview-note')!;
    const validateBtn    = document.getElementById('yv-validate')!;
    const clearBtn       = document.getElementById('yv-clear')!;
    const copyPreviewBtn = document.getElementById('yv-copy-preview')!;
    const wrapEl = document.querySelector('.yv-wrap') as HTMLElement;

    const MSG_EMPTY   = wrapEl.dataset.msgEmpty!;
    const MSG_VALID   = wrapEl.dataset.msgValid!;
    const MSG_INVALID = wrapEl.dataset.msgInvalid!;
    const MSG_VALID_MULTI   = wrapEl.dataset.msgValidMulti!;
    const MSG_INVALID_MULTI = wrapEl.dataset.msgInvalidMulti!;
    const DOC_TITLE   = wrapEl.dataset.docTitle!;
    const DOC_LINES   = wrapEl.dataset.docLines!;
    const DOC_VALID   = wrapEl.dataset.docValid!;
    const COPY_JSON   = wrapEl.dataset.copyJson!;
    const COPIED      = wrapEl.dataset.copied!;
    const COPY_FAILED = wrapEl.dataset.copyFailed!;
    let copyRevision = 0;
    let copyTimer: ReturnType<typeof setTimeout> | undefined;
    const LANG        = wrapEl.dataset.lang || 'en';
    const ERR_TITLE   = wrapEl.dataset.errTitle!;
    const ERR_LINE    = wrapEl.dataset.errLine!;
    const ERR_LINE_COL = wrapEl.dataset.errLineCol!;
    const PREVIEW_SCHEMA = yamlLoadSchema(jsyaml, { timestamps: true });

    /* ── engine:start ── */
    // A line starting with `---` or `...` is a document marker and never scalar content
    // (YAML 1.2.2 §9.1.2, c-forbidden), so the text can be cut there to find each document.
    function splitDocuments(text) {
      var lines = text.split(/\r?\n/);
      var chunks = [];
      var start = 0;
      for (var i = 1; i < lines.length; i++) {
        if (!/^---(?:[ \t]|$)/.test(lines[i])) continue;
        // directives (%YAML, %TAG) written just before `---` belong to the next document
        var cut = i;
        for (var j = i - 1; j >= start && /^(%|#|\s*$)/.test(lines[j]); j--) {
          if (lines[j].charAt(0) === '%') cut = j;
        }
        if (cut > start) {
          chunks.push({ start: start, end: cut - 1, text: lines.slice(start, cut).join('\n') });
          start = cut;
        }
      }
      chunks.push({ start: start, end: lines.length - 1, text: lines.slice(start).join('\n') });
      return chunks;
    }

    // `options` go to loadAll (the page passes a schema that marks values JSON cannot show)
    function validateYaml(text, yaml, options) {
      var chunks = splitDocuments(text);
      var docs = [];
      var ok = true;
      chunks.forEach(function (chunk) {
        // comments before the first `---` are not a document of their own
        if (chunks.length > 1 && chunk.text.split('\n').every(function (l) { return /^\s*(#.*)?$/.test(l); })) return;
        // pad with blank lines so error marks and snippets use the line numbers of the full text
        var padded = new Array(chunk.start + 1).join('\n') + chunk.text;
        try {
          yaml.loadAll(padded, null, options).forEach(function (value) {
            docs.push({ ok: true, value: value, startLine: chunk.start + 1, endLine: chunk.end + 1 });
          });
        } catch (e) {
          ok = false;
          docs.push({ ok: false, error: e, startLine: chunk.start + 1, endLine: chunk.end + 1 });
        }
      });

      if (ok) {
        // the whole stream is the reference for values; keep line ranges only when they line up
        var whole = null;
        try {
          whole = yaml.loadAll(text, null, options);
        } catch (e) {
          ok = false;
          var line = e.mark ? e.mark.line + 1 : 0;
          var hit = docs.filter(function (d) { return d.startLine <= line && line <= d.endLine; })[0] || docs[docs.length - 1];
          if (hit) { hit.ok = false; hit.error = e; delete hit.value; }
          else docs.push({ ok: false, error: e, startLine: null, endLine: null });
        }
        if (whole && whole.length !== docs.length) {
          docs = whole.map(function (value) { return { ok: true, value: value, startLine: null, endLine: null }; });
        } else if (whole) {
          whole.forEach(function (value, n) { docs[n].value = value; });
        }
      }
      docs.forEach(function (d, n) { d.index = n + 1; });
      return { ok: ok, documents: docs };
    }
    /* ── engine:end ── */

    function setStatus(msg: string, type: string) {
      statusEl.textContent = msg;
      statusEl.className = 'yv-status ' + (type || '');
    }

    function resetCopy() {
      copyRevision++;
      clearTimeout(copyTimer);
      copyTimer = undefined;
      copyPreviewBtn.textContent = COPY_JSON;
    }

    function clearAll() {
      resetCopy();
      document.getElementById('yv-results')!.dataset.empty = 'true';
      setStatus('', '');
      errorBox.style.display = 'none';
      errorBox.innerHTML = '';
      previewEl.style.display = 'none';
      previewContent.textContent = '';
      setNote('');
    }

    function setNote(text: string) {
      previewNote.textContent = text;
      previewNote.hidden = !text;
    }

    function parseYamlError(e: any) {
      const msg = e.message || String(e);
      const reasonMatch = msg.match(/^([^\n]+?)(?:\s+at line\s+(\d+),\s+column\s+(\d+))?[:\n]/);
      const rawReason = e.reason || (reasonMatch ? reasonMatch[1].trim() : msg.split('\n')[0].trim());
      // js-yaml work limits (nesting depth, merge keys) are explained in the page language
      const reason = yamlLimitText(rawReason, LANG) || rawReason;
      const line   = e.mark && e.mark.line   != null ? e.mark.line + 1   : null;
      const col    = e.mark && e.mark.column != null ? e.mark.column + 1 : null;
      const nlIdx  = msg.indexOf('\n');
      const snippet = nlIdx !== -1 ? msg.slice(nlIdx + 1).trim() : null;
      return { reason, line, col, snippet };
    }

    function escapeHtml(str: string) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function buildErrorHtml(info: { reason: string; line: number | null; col: number | null; snippet: string | null }) {
      let html = '<div class="yv-err-title">' + escapeHtml(ERR_TITLE) + '</div>';
      html += '<div class="yv-err-reason">' + escapeHtml(info.reason) + '</div>';
      if (info.line != null) {
        const loc = info.col != null ? ERR_LINE_COL.replace('{col}', String(info.col)) : ERR_LINE;
        html += '<div class="yv-err-location">' + escapeHtml(loc.replace('{line}', String(info.line))) + '</div>';
      }
      if (info.snippet) {
        html += '<pre class="yv-err-snippet">' + escapeHtml(info.snippet) + '</pre>';
      }
      return html;
    }

    function doValidate() {
      resetCopy();
      const text = inputEl.value;
      if (!text.trim()) {
        clearAll();
        setStatus(MSG_EMPTY, '');
        return;
      }
      document.getElementById('yv-results')!.dataset.empty = 'false';
      const result = validateYaml(text, jsyaml, { schema: PREVIEW_SCHEMA });
      const docs = result.documents;
      const multi = docs.length > 1;
      if (result.ok) {
        errorBox.style.display = 'none';
        errorBox.innerHTML = '';
        const found = findLosses(multi ? docs.map((d: any) => d.value) : (docs[0] ? docs[0].value : null), 'json', { preview: true });
        previewContent.textContent = stringifyJson(found.value, 2);
        setNote(found.count ? formatLosses(found, 'JSON', LANG, 'preview') : '');
        previewEl.style.display = '';
        setStatus(multi ? MSG_VALID_MULTI.replace('{n}', String(docs.length)) : MSG_VALID, 'success');
        (window as any).trackTool?.('yaml-validator', 'validate_success');
      } else {
        previewEl.style.display = 'none';
        previewContent.textContent = '';
        setNote('');
        if (multi) {
          errorBox.innerHTML = docs.map((d: any) => {
            let title = DOC_TITLE.replace('{k}', String(d.index));
            if (d.startLine != null) {
              title += ' \u00b7 ' + DOC_LINES.replace('{a}', String(d.startLine)).replace('{b}', String(d.endLine));
            }
            if (d.ok) {
              return '<div class="yv-doc yv-doc-ok"><span class="yv-doc-title">' + escapeHtml(title) + '</span> \u2014 ' + escapeHtml(DOC_VALID) + '</div>';
            }
            return '<div class="yv-doc"><div class="yv-doc-title">' + escapeHtml(title) + '</div>' + buildErrorHtml(parseYamlError(d.error)) + '</div>';
          }).join('');
          const bad = docs.filter((d: any) => !d.ok).length;
          setStatus(MSG_INVALID_MULTI.replace('{bad}', String(bad)).replace('{n}', String(docs.length)), 'error');
        } else {
          errorBox.innerHTML = buildErrorHtml(parseYamlError(docs[0].error));
          setStatus(MSG_INVALID, 'error');
        }
        errorBox.style.display = '';
        (window as any).trackTool?.('yaml-validator', 'validate_error');
      }
    }

    /* Prevent textarea blur before click fires (eliminates first-click race) */
    validateBtn.addEventListener('mousedown', (e) => e.preventDefault());
    validateBtn.addEventListener('click', doValidate);

    clearBtn.addEventListener('click', () => {
      inputEl.value = '';
      clearAll();
    });

    copyPreviewBtn.addEventListener('click', async () => {
      if (!previewContent.textContent) return;
      resetCopy();
      const revision = copyRevision;
      try {
        await navigator.clipboard.writeText(previewContent.textContent);
        if (revision !== copyRevision) return;
        copyPreviewBtn.textContent = COPIED;
        copyTimer = setTimeout(() => { if (revision === copyRevision) copyPreviewBtn.textContent = COPY_JSON; }, 1500);
      } catch {
        if (revision === copyRevision) copyPreviewBtn.textContent = COPY_FAILED;
      }
    });
    inputEl.addEventListener('input', resetCopy);

    /* Keyboard shortcut: Ctrl/Cmd+Enter */
    inputEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        e.stopPropagation();
        doValidate();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L') || !wrapEl.contains(document.activeElement)) return;
      e.preventDefault();
      inputEl.focus();
      inputEl.value = '';
      clearAll();
    });

    /* Auto-validate on load if pre-filled */
    if (inputEl.value.trim()) doValidate();
  </script>
</div>

