const CLIENT_T = Object.fromEntries(["canvasBlocked", "copied", "copy", "copyFailed", "emojiFirstOnly", "generationFailed", "statsTpl", "svgForeignObject", "fileTooLarge", "filesWord", "generatedPrefix", "generating", "imageLoaded", "invalidFile", "invalidSvg", "nameMissing", "provideSource", "svgLoaded", "svgTainted"].map(key => [key, L[key]]));
---
<div class="fg-wrap">
  <div class="fg-main">
    <div class="fg-rail zt-rail">
      <div class="fg-actions">
        <button id="fg-generate" type="button" class="btn-primary" disabled>{L.generatePackage}</button><Toggletip id="fg-tip-generate" about={L.generatePackage} lang={lang}>{L.tips.generate}</Toggletip>
      </div>
      <div class="fg-export-actions">
        <button id="fg-copy-snippet" type="button" class="btn-copy" disabled>{L.copy}</button><Toggletip id="fg-tip-copy" about={L.copy} lang={lang}>{L.tips.copy}</Toggletip>
        <button id="fg-download-zip" type="button" class="btn-primary" disabled>{L.downloadZip}</button><Toggletip id="fg-tip-download" about={L.downloadZip} lang={lang}>{L.tips.download}</Toggletip>
      </div>
      <div class="fg-status-slot"><div id="fg-status" class="tool-status" aria-live="polite"></div></div>
      <div class="fg-source-heading"><span class="tool-label">{L.sourceLabel}</span><Toggletip id="fg-tip-source" about={L.sourceLabel} lang={lang}>{L.tips.source}</Toggletip></div>
    {/* Source tabs */}
    <div class="fg-tabs" role="tablist" aria-label={L.sourceLabel}>
      <button id="fg-tab-emoji" class="fg-tab fg-tab--active" role="tab" aria-selected="true" data-tab="emoji">{L.tabEmoji}</button>
      <button id="fg-tab-text" class="fg-tab" role="tab" aria-selected="false" data-tab="text">{L.tabText}</button>
      <button id="fg-tab-image" class="fg-tab" role="tab" aria-selected="false" data-tab="image">{L.tabImage}</button>
      <button id="fg-tab-svg" class="fg-tab" role="tab" aria-selected="false" data-tab="svg">{L.tabSvg}</button>
    </div>

    {/* Source panels */}
    <div class="fg-source">
      {/* Emoji */}
      <div id="fg-panel-emoji" class="fg-panel" role="tabpanel">

        <div class="fg-field">
          <label for="fg-emoji-input" class="tool-label">{L.emojiCustom}<Toggletip id="fg-tip-emoji" about={L.emojiCustom} lang={lang}>{L.tips.emoji}</Toggletip></label>
          <input type="text" id="fg-emoji-input" class="tool-input fg-emoji-custom" placeholder="🚀" maxlength="32" autocomplete="off" />
        </div>
        <details class="fg-options"><summary>{L.emojiPresets}</summary>        <div class="fg-emoji-row" id="fg-emoji-presets" role="group" aria-label="Common emoji">
          <button class="fg-emoji-btn" data-emoji="🚀" type="button" aria-label="Rocket">🚀</button>
          <button class="fg-emoji-btn" data-emoji="⚡" type="button" aria-label="Lightning">⚡</button>
          <button class="fg-emoji-btn" data-emoji="🔥" type="button" aria-label="Fire">🔥</button>
          <button class="fg-emoji-btn" data-emoji="🌟" type="button" aria-label="Star">🌟</button>
          <button class="fg-emoji-btn" data-emoji="✨" type="button" aria-label="Sparkles">✨</button>
          <button class="fg-emoji-btn" data-emoji="🎯" type="button" aria-label="Target">🎯</button>
          <button class="fg-emoji-btn" data-emoji="💡" type="button" aria-label="Bulb">💡</button>
          <button class="fg-emoji-btn" data-emoji="🛠️" type="button" aria-label="Tools">🛠️</button>
          <button class="fg-emoji-btn" data-emoji="📦" type="button" aria-label="Package">📦</button>
          <button class="fg-emoji-btn" data-emoji="🔧" type="button" aria-label="Wrench">🔧</button>
          <button class="fg-emoji-btn" data-emoji="🎨" type="button" aria-label="Palette">🎨</button>
          <button class="fg-emoji-btn" data-emoji="❤️" type="button" aria-label="Heart">❤️</button>
        </div></details>
      </div>

      {/* Text */}
      <div id="fg-panel-text" class="fg-panel" role="tabpanel" hidden>
        <div class="fg-field">
          <label for="fg-text-input" class="tool-label">{L.textChars}<Toggletip id="fg-tip-text" about={L.textChars} lang={lang}>{L.tips.text}</Toggletip></label>
          <input type="text" id="fg-text-input" class="tool-input" placeholder="Z" maxlength="4" autocomplete="off" />
        </div>
        <div class="fg-row">
          <div class="fg-field">
            <label for="fg-text-font" class="tool-label">{L.textFont}</label>
            <select id="fg-text-font" class="fg-select">
              <option value="system-ui">System UI</option>
              <option value="serif">Serif</option>
              <option value="monospace">Monospace</option>
              <option value="sans-serif">Sans Serif</option>
            </select>
          </div>
          <div class="fg-field">
            <label for="fg-text-color" class="tool-label">{L.textColor}</label>
            <input type="color" id="fg-text-color" class="fg-color-input" value="#ffffff" />
          </div>
          <div class="fg-field">
            <label for="fg-text-weight" class="tool-label">{L.textWeight}</label>
            <select id="fg-text-weight" class="fg-select">
              <option value="700">Bold</option>
              <option value="500">Medium</option>
              <option value="400">Regular</option>
            </select>
          </div>
        </div>
      </div>

      {/* Image */}
      <div id="fg-panel-image" class="fg-panel" role="tabpanel" hidden>
        <Toggletip id="fg-tip-image" about={L.tabImage} lang={lang}>{L.tips.image}</Toggletip>
        <div id="fg-drop" class="fg-drop" role="button" tabindex="0">
          <div class="fg-drop-inner">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
            </svg>
            <p class="fg-drop-text"><span>{L.dropImageA}</span><strong>{L.dropImageB}</strong></p>
            <p class="fg-hint">{L.imageHint}</p>
          </div>
          <input type="file" id="fg-file" accept="image/png,image/jpeg,image/svg+xml,.png,.jpg,.jpeg,.svg" class="fg-file-input" />
        </div>
        <div id="fg-image-info" class="fg-image-info" hidden></div>
      </div>

      {/* SVG */}
      <div id="fg-panel-svg" class="fg-panel" role="tabpanel" hidden>
        <div class="fg-field">
          <label for="fg-svg-input" class="tool-label">{L.pasteSvgCode}<Toggletip id="fg-tip-svg" about={L.pasteSvgCode} lang={lang}>{L.tips.svg}</Toggletip></label>
          <textarea id="fg-svg-input" class="tool-textarea" rows="6" autocomplete="off" placeholder='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">...</svg>' spellcheck="false"></textarea>
        </div>
      </div>
    </div>

    {/* Configuration */}
    <details class="fg-options"><summary>{L.options}</summary>
    <div class="fg-config">
      <div class="fg-config-row">
        <div class="fg-field">
          <span class="tool-label">{L.background}</span><Toggletip id="fg-tip-background" about={L.background} lang={lang}>{L.tips.background}</Toggletip>
          <div class="fg-control-row">
            <label class="fg-radio">
              <input type="radio" name="fg-bg" value="transparent" checked />
              <span>{L.bgTransparent}</span>
            </label>
            <label class="fg-radio">
              <input type="radio" name="fg-bg" value="color" />
              <span>{L.bgColor}</span>
            </label>
            <input type="color" id="fg-bg-color" aria-label={L.bgColor} class="fg-color-input" value="#0ea5e9" disabled />
          </div>
        </div>
      </div>

      <div class="fg-config-row">
        <div class="fg-field">
          <span class="tool-label">{L.shape}</span><Toggletip id="fg-tip-shape" about={L.shape} lang={lang}>{L.tips.shape}</Toggletip>
          <div class="fg-control-row">
            <label class="fg-radio"><input type="radio" name="fg-shape" value="square" checked /><span>{L.shapeSquare}</span></label>
            <label class="fg-radio"><input type="radio" name="fg-shape" value="rounded" /><span>{L.shapeRounded}</span></label>
            <label class="fg-radio"><input type="radio" name="fg-shape" value="circle" /><span>{L.shapeCircle}</span></label>
          </div>
        </div>

        <div class="fg-field fg-padding-field">
          <label for="fg-padding" class="tool-label">
            <span>{L.padding}</span><Toggletip id="fg-tip-padding" about={L.padding} lang={lang}>{L.tips.padding}</Toggletip>
            <span id="fg-padding-val" class="fg-padding-val">8%</span>
          </label>
          <input type="range" id="fg-padding" min="0" max="30" value="8" step="1" />
        </div>

        <div class="fg-field">
          <label for="fg-theme-color" class="tool-label">{L.themeColor}<Toggletip id="fg-tip-theme" about={L.themeColor} lang={lang}>{L.tips.theme}</Toggletip></label>
          <input type="color" id="fg-theme-color" class="fg-color-input" value="#ffffff" />
        </div>
      </div>

      <div class="fg-config-row">
        <div class="fg-field fg-name-field">
          <label for="fg-app-name" class="tool-label">{L.appName}<Toggletip id="fg-tip-name" about={L.appName} lang={lang}>{L.tips.name}</Toggletip></label>
          <input type="text" id="fg-app-name" class="tool-input" placeholder="My Site" maxlength="100" autocomplete="off" />
        </div>
        <div class="fg-field fg-name-field">
          <label for="fg-short-name" class="tool-label">{L.shortName}</label>
          <input type="text" id="fg-short-name" class="tool-input" placeholder="Site" maxlength="40" autocomplete="off" />
        </div>
      </div>
      <p class="fg-hint">{L.nameHint}</p>
    </div>

    </details>

    </div>
    <div class="fg-output">
    {/* Live preview */}
    <div id="fg-live-preview" class="fg-preview-section" data-empty="false">
      <p id="fg-empty" class="fg-empty" hidden>{L.empty}</p>
      <div class="fg-preview-header">
        <span class="fg-preview-label">{L.livePreview}</span>
        <span class="fg-preview-hint">{L.previewHint}</span>
      </div>
      <div id="fg-preview-grid" class="fg-preview-grid">
        <div class="fg-preview-cell"><div class="fg-prev-frame" style="--p:16px"><canvas id="fg-prev-16" width="16" height="16" aria-label="16 px favicon preview"></canvas></div><span class="fg-prev-label">16 px</span></div>
        <div class="fg-preview-cell"><div class="fg-prev-frame" style="--p:32px"><canvas id="fg-prev-32" width="32" height="32"></canvas></div><span class="fg-prev-label">32 px</span></div>
        <div class="fg-preview-cell"><div class="fg-prev-frame" style="--p:64px"><canvas id="fg-prev-64" width="64" height="64"></canvas></div><span class="fg-prev-label">64 px</span></div>
        <div class="fg-preview-cell"><div class="fg-prev-frame" style="--p:96px"><canvas id="fg-prev-180" width="180" height="180"></canvas></div><span class="fg-prev-label">180 px</span></div>
      </div>
    </div>

    {/* Result */}
    <div id="fg-result" class="fg-result" hidden>
      <div class="fg-result-header">
        <span class="fg-result-label">{L.resultLabel}</span>
        <span id="fg-result-stats" class="fg-result-stats"></span>
      </div>
      <div class="fg-package-body">
      <ul id="fg-file-list" class="fg-file-list"></ul>
      <p class="fg-hint">{L.maskableNote}</p>

      <div class="fg-snippet">
        <div class="fg-snippet-header">
          <span class="tool-label">{L.snippetLabel}</span>
          
        </div>
        <pre id="fg-snippet-code" class="fg-snippet-code"></pre>
      </div>


      </div>
    </div>


    </div>
  </div>
</div>

  <script is:inline define:vars={{ CLIENT_T }}>
    (function () {
      var t = CLIENT_T;

      /* ── State ── */
      var state = {
        sourceType: 'emoji',  // 'emoji' | 'text' | 'image' | 'svg'
        emoji: '🚀',
        text: '',
        textFont: 'system-ui',
        textColor: '#ffffff',
        textWeight: '700',
        image: null,             // HTMLImageElement
        svgImg: null,            // HTMLImageElement (rendered from SVG)
        svgText: '',             // markup of svgImg, for the failure message
        imageSvgText: '',        // markup of an SVG file in the Image tab
        bgMode: 'transparent',
        bgColor: '#0ea5e9',
        shape: 'square',
        padding: 8,              // %
        themeColor: '#ffffff',
        appName: '',
        shortName: ''
      };

      var TARGET_SIZES = [16, 32, 48, 64, 96, 128, 180, 192, 512];
      var ICO_SIZES = [16, 32, 48];
      var lastZipUrl = '';
      var fileRevision = 0;
      var svgRevision = 0;
      var generateRevision = 0;
      var generating = false;
      var copyRequest = 0;
      var copyTimer = 0;
      var copyError = false;
      var resultStatusMessage = '';
      var resultStatusLevel = 'none';

      /* ── DOM refs ── */
      var $ = function (id) { return document.getElementById(id); };
      var statusEl = $('fg-status');
      var generateBtn = $('fg-generate');
      var resultEl = $('fg-result');
      var fileListEl = $('fg-file-list');
      var snippetCodeEl = $('fg-snippet-code');
      var resultStatsEl = $('fg-result-stats');

      function setStatus(msg, level) {
        statusEl.textContent = msg || '';
        statusEl.className = 'tool-status ' + (level || 'none');
      }

      /* ── Tab switching ── */
      var tabs = ['emoji', 'text', 'image', 'svg'];
      tabs.forEach(function (name) {
        $('fg-tab-' + name).addEventListener('click', function () {
          state.sourceType = name;
          tabs.forEach(function (n) {
            var btn = $('fg-tab-' + n);
            var pnl = $('fg-panel-' + n);
            var active = (n === name);
            btn.classList.toggle('fg-tab--active', active);
            btn.setAttribute('aria-selected', active ? 'true' : 'false');
            pnl.hidden = !active;
          });
          updateAll();
        });
      });

      /* ── Emoji handlers ── */
      document.querySelectorAll('.fg-emoji-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.emoji = btn.getAttribute('data-emoji');
          $('fg-emoji-input').value = state.emoji;
          document.querySelectorAll('.fg-emoji-btn').forEach(function (b) { b.classList.remove('fg-emoji-btn--active'); });
          btn.classList.add('fg-emoji-btn--active');
          updateAll();
          if (emojiNotice) { setStatus('', 'none'); emojiNotice = false; }
        });
      });
      /* One icon shows one emoji. Keep the first grapheme cluster, so ZWJ sequences and
         flags stay whole, and say so when more was entered. */
      function firstGrapheme(v) {
        if (typeof Intl !== 'undefined' && Intl.Segmenter) {
          var it = new Intl.Segmenter(undefined, { granularity: 'grapheme' }).segment(v)[Symbol.iterator]().next();
          return it.done ? '' : it.value.segment;
        }
        return v;
      }
      $('fg-emoji-input').addEventListener('input', function () {
        var raw = this.value.trim();
        var v = firstGrapheme(raw);
        state.emoji = v;
        document.querySelectorAll('.fg-emoji-btn').forEach(function (b) { b.classList.remove('fg-emoji-btn--active'); });
        updateAll();
        if (v !== raw) { setStatus(t.emojiFirstOnly + v, 'info'); emojiNotice = true; }
        else if (emojiNotice) { setStatus('', 'none'); emojiNotice = false; }
      });
      var emojiNotice = false;

      /* ── Text handlers ── */
      $('fg-text-input').addEventListener('input', function () { state.text = this.value; updateAll(); });
      $('fg-text-font').addEventListener('change', function () { state.textFont = this.value; updateAll(); });
      $('fg-text-color').addEventListener('input', function () { state.textColor = this.value; updateAll(); });
      $('fg-text-weight').addEventListener('change', function () { state.textWeight = this.value; updateAll(); });

      /* ── Image handlers ── */
      var dropEl = $('fg-drop');
      var fileInput = $('fg-file');
      var imageInfo = $('fg-image-info');

      dropEl.addEventListener('click', function (e) {
        if (e.target !== fileInput) fileInput.click();
      });
      dropEl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
      });
      dropEl.addEventListener('dragover', function (e) { e.preventDefault(); dropEl.classList.add('drag-over'); });
      dropEl.addEventListener('dragleave', function () { dropEl.classList.remove('drag-over'); });
      dropEl.addEventListener('drop', function (e) {
        e.preventDefault();
        dropEl.classList.remove('drag-over');
        var f = e.dataTransfer.files && e.dataTransfer.files[0];
        if (f) handleFile(f);
      });
      fileInput.addEventListener('change', function () {
        if (this.files && this.files[0]) handleFile(this.files[0]);
      });

      function handleFile(file) {
        var revision = ++fileRevision;
        state.image = null;
        imageInfo.textContent = '';
        imageInfo.hidden = true;
        updateAll();
        if (file.size > 10 * 1024 * 1024) { setStatus(t.fileTooLarge, 'error'); return; }
        var ok = /\.(png|jpe?g|svg)$/i.test(file.name) || /^image\/(png|jpeg|svg\+xml)$/.test(file.type);
        if (!ok) { setStatus(t.invalidFile, 'error'); return; }
        var reader = new FileReader();
        var isSvg = /svg/i.test(file.type) || /\.svg$/i.test(file.name);
        reader.onload = function (ev) {
          if (revision !== fileRevision) return;
          if (isSvg) {
            loadSvgFromString(ev.target.result, function (img) {
              if (revision !== fileRevision || !img) return;
              state.image = img;
              state.imageSvgText = ev.target.result;
              showImageInfo(file, img);
              if (state.sourceType === 'image') {
                setStatus(t.imageLoaded, 'success');
                updateAll();
              }
            }, function () { return revision === fileRevision; }, 'image');
          } else {
            var url = URL.createObjectURL(file);
            var im = new Image();
            im.onload = function () {
              URL.revokeObjectURL(url);
              if (revision !== fileRevision) return;
              state.image = im;
              state.imageSvgText = '';
              showImageInfo(file, im);
              if (state.sourceType === 'image') {
                setStatus(t.imageLoaded, 'success');
                updateAll();
              }
            };
            im.onerror = function () {
              URL.revokeObjectURL(url);
              if (revision !== fileRevision || state.sourceType !== 'image') return;
              setStatus(t.invalidFile, 'error');
            };
            im.src = url;
          }
        };
        reader.onerror = function () {
          if (revision === fileRevision && state.sourceType === 'image') setStatus(t.invalidFile, 'error');
        };
        if (isSvg) reader.readAsText(file);
        else reader.readAsDataURL(file);
      }

      function showImageInfo(file, img) {
        var w = img.naturalWidth || img.width;
        var h = img.naturalHeight || img.height;
        var kb = (file.size / 1024).toFixed(1) + ' KB';
        imageInfo.textContent = file.name + ' · ' + w + ' × ' + h + ' · ' + kb;
        imageInfo.hidden = false;
      }

      /* ── SVG handlers ── */
      var svgInput = $('fg-svg-input');
      var svgDebounce;
      svgInput.addEventListener('input', function () {
        clearTimeout(svgDebounce);
        var revision = ++svgRevision;
        var v = svgInput.value;
        state.svgImg = null;
        updateAll();
        svgDebounce = setTimeout(function () {
          if (revision !== svgRevision || !v.trim()) return;
          if (!/<svg[\s>]/i.test(v)) {
            if (state.sourceType === 'svg') setStatus(t.invalidSvg, 'error');
            return;
          }
          loadSvgFromString(v, function (img) {
            if (revision !== svgRevision || !img) return;
            state.svgImg = img;
            state.svgText = v;
            if (state.sourceType === 'svg') {
              setStatus(t.svgLoaded, 'success');
              updateAll();
            }
          }, function () { return revision === svgRevision; }, 'svg');
        }, 300);
      });

      function loadSvgFromString(svgText, cb, isCurrent, sourceType) {
        try {
          var blob = new Blob([svgText], { type: 'image/svg+xml;charset=utf-8' });
          var url = URL.createObjectURL(blob);
          var im = new Image();
          im.onload = function () {
            URL.revokeObjectURL(url);
            if (!isCurrent()) return;
            // Stamp dims fallback if natural sizes are zero (some SVGs without explicit width/height)
            if (!im.width || !im.height) {
              var dims = parseSvgDimensions(svgText);
              im._fallbackW = dims.w;
              im._fallbackH = dims.h;
            }
            cb(im);
          };
          im.onerror = function () {
            URL.revokeObjectURL(url);
            if (!isCurrent()) return;
            if (state.sourceType === sourceType) setStatus(t.invalidSvg, 'error');
            cb(null);
          };
          im.src = url;
        } catch (err) {
          if (!isCurrent()) return;
          if (state.sourceType === sourceType) setStatus(t.invalidSvg, 'error');
          cb(null);
        }
      }

      function parseSvgDimensions(text) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(text, 'image/svg+xml');
        var svg = doc.querySelector('svg');
        if (!svg) return { w: 256, h: 256 };
        var w = parseFloat(svg.getAttribute('width')) || 0;
        var h = parseFloat(svg.getAttribute('height')) || 0;
        if (w && h) return { w: w, h: h };
        var vb = svg.getAttribute('viewBox');
        if (vb) {
          var p = vb.trim().split(/[\s,]+/);
          if (p.length === 4) {
            var vw = parseFloat(p[2]), vh = parseFloat(p[3]);
            if (!isNaN(vw) && !isNaN(vh)) return { w: vw, h: vh };
          }
        }
        return { w: 256, h: 256 };
      }

      /* ── Config handlers ── */
      document.querySelectorAll('input[name="fg-bg"]').forEach(function (r) {
        r.addEventListener('change', function () {
          state.bgMode = r.value;
          $('fg-bg-color').disabled = (r.value !== 'color');
          updateAll();
        });
      });
      $('fg-bg-color').addEventListener('input', function () { state.bgColor = this.value; updateAll(); });
      document.querySelectorAll('input[name="fg-shape"]').forEach(function (r) {
        r.addEventListener('change', function () { state.shape = r.value; updateAll(); });
      });
      var paddingEl = $('fg-padding');
      paddingEl.addEventListener('input', function () {
        state.padding = parseInt(this.value, 10);
        $('fg-padding-val').textContent = state.padding + '%';
        updateAll();
      });
      $('fg-theme-color').addEventListener('input', function () { state.themeColor = this.value; updateAll(); });
      $('fg-app-name').addEventListener('input', function () { state.appName = this.value; updateAll(); });
      $('fg-short-name').addEventListener('input', function () { state.shortName = this.value; updateAll(); });

      /* ── Drawing pipeline ── */
      function drawShapeClip(ctx, shape, size) {
        ctx.beginPath();
        if (shape === 'circle') {
          ctx.arc(size / 2, size / 2, size / 2, 0, Math.PI * 2);
        } else if (shape === 'rounded') {
          var r = size * 0.125;
          ctx.moveTo(r, 0);
          ctx.lineTo(size - r, 0);
          ctx.quadraticCurveTo(size, 0, size, r);
          ctx.lineTo(size, size - r);
