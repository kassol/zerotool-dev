        notes.forEach(function (s) {
          var li = document.createElement('li');
          li.textContent = s;
          notesEl.appendChild(li);
        });
        notesEl.hidden = !notes.length;
      }

      function renderList() {
        var many = state.items.length > 1;
        batchEl.hidden = !many;
        rowsEl.textContent = '';
        if (!many) return;
        state.items.forEach(function (item, idx) {
          var r = item.result;
          var tr = document.createElement('tr');
          if (idx === state.active) tr.className = 's2p-row-active';
          var tdName = document.createElement('td');
          var pick = document.createElement('button');
          pick.type = 'button';
          pick.className = 's2p-pick';
          pick.textContent = item.name;
          pick.setAttribute('aria-current', idx === state.active ? 'true' : 'false');
          pick.addEventListener('click', function () { state.active = idx; renderActive(); renderList(); });
          tdName.appendChild(pick);
          var tdSize = document.createElement('td');
          var tdDl = document.createElement('td');
          if (r && !r.error) {
            tdSize.textContent = fill(t.listSizes, { sw: shortNum(r.sourceWidth), sh: shortNum(r.sourceHeight), w: r.width, h: r.height });
            var dl = document.createElement('button');
            dl.type = 'button';
            dl.className = 'btn-secondary btn-sm s2p-row-dl';
            dl.textContent = r.fileName;
            dl.addEventListener('click', function () { save(r.url, r.fileName); });
            tdDl.appendChild(dl);
          } else {
            tdSize.textContent = t.listError;
            tdSize.className = 's2p-row-error';
            tdSize.title = r ? errorText(r.error) : '';
            tdDl.textContent = r ? errorText(r.error) : '';
            tdDl.className = 's2p-row-error';
          }
          tr.appendChild(tdName);
          tr.appendChild(tdSize);
          tr.appendChild(tdDl);
          rowsEl.appendChild(tr);
        });
      }

      function save(url, name) {
        var a = document.createElement('a');
        a.href = url;
        a.download = name;
        document.body.appendChild(a);
        a.click();
        a.remove();
      }

      downloadBtn.addEventListener('click', function () {
        var r = state.items[state.active] && state.items[state.active].result;
        if (r && !r.error) save(r.url, r.fileName);
      });

      zipBtn.addEventListener('click', function () {
        var ok = state.items.filter(function (x) { return x.result && !x.result.error; });
        if (!ok.length) return;
        Promise.all(ok.map(function (x) { return x.result.blob.arrayBuffer(); })).then(function (bufs) {
          var zip = zipStore(ok.map(function (x, i) { return { name: x.result.fileName, data: new Uint8Array(bufs[i]) }; }));
          var url = URL.createObjectURL(new Blob([zip], { type: 'application/zip' }));
          save(url, 'svg-to-png.zip');
          setTimeout(function () { URL.revokeObjectURL(url); }, 10000);
        });
      });

      /* ── input ── */
      function load(list, skipped) {
        state.items.forEach(function (x) { if (x.result && x.result.url) URL.revokeObjectURL(x.result.url); });
        state.skipped = skipped || [];
        state.items = list.map(function (x) {
          var analysis = x.readError ? { error: { code: 'read', name: x.name } } : analyzeSvg(x.text);
          return { name: x.name, text: x.text, analysis: analysis, result: null };
        });
        state.active = 0;
        if (!state.items.length) {
          renderActive();
          renderList();
          resultEl.hidden = true;
          setStatus(fill(t.note.skipped, { names: state.skipped.join(', ') }), 'error');
          return;
        }
        run();
      }

      function isSvgFile(f) { return /\.svg$/i.test(f.name) || f.type === 'image/svg+xml'; }

      function loadFiles(files) {
        var all = Array.prototype.slice.call(files || []);
        if (!all.length) return;
        var svgs = all.filter(isSvgFile);
        var skipped = all.filter(function (f) { return !isSvgFile(f); }).map(function (f) { return f.name; });
        Promise.all(svgs.map(function (f) {
          return f.text().then(function (text) { return { name: f.name, text: text }; }, function () {
            return { name: f.name, text: '', readError: true };
          });
        })).then(function (list) {
          load(list, skipped);
        });
      }

      fileInput.addEventListener('change', function () {
        loadFiles(fileInput.files);
        fileInput.value = '';
      });
      /* ── code:start ── */
      // An empty code box does not replace converted files with the "empty" error: Convert
      // (also ToolLayout's Ctrl/Cmd+Enter, which clicks it) then leaves their result alone.
      function convertCode() {
        if (!codeInput.value.trim() && state.items.some(function (x) { return x.name; })) return;
        load([{ name: '', text: codeInput.value }]);
      }
      $('s2p-convert-code').addEventListener('click', convertCode);
      // stopPropagation: ToolLayout's page-wide Ctrl/Cmd+Enter would click Convert a second time.
      codeInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); e.stopPropagation(); convertCode(); }
      });
      /* ── code:end ── */

      // The whole tool accepts dropped files, so a drop next to the box does not open the file.
      wrap.addEventListener('dragover', function (e) {
        e.preventDefault();
        wrap.classList.add('s2p-drag');
      });
      wrap.addEventListener('dragleave', function (e) {
        if (!wrap.contains(e.relatedTarget)) wrap.classList.remove('s2p-drag');
      });
      wrap.addEventListener('drop', function (e) {
        e.preventDefault();
        wrap.classList.remove('s2p-drag');
        if (e.dataTransfer && e.dataTransfer.files.length) loadFiles(e.dataTransfer.files);
      });

      // Paste SVG code or SVG files anywhere on the page, outside other text fields.
      document.addEventListener('paste', function (e) {
        var target = e.target;
        if (target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;
        var cd = e.clipboardData;
        if (!cd) return;
        var files = Array.prototype.slice.call(cd.files || []).filter(isSvgFile);
        if (files.length) { e.preventDefault(); loadFiles(files); return; }
        var text = cd.getData('text/plain');
        if (text && /<svg[\s>]/i.test(text)) {
          e.preventDefault();
          codeInput.value = text;
          load([{ name: '', text: text }]);
        }
      });

      // ToolLayout's Ctrl/Cmd+L empties the code box without an input event (only while the
      // focus is inside the tool); drop the files, the result and the status with it.
      /* ── clear:start ── */
      document.addEventListener('keydown', function (e) {
        if (!(e.metaKey || e.ctrlKey) || (e.key !== 'l' && e.key !== 'L')) return;
        if (!wrap.contains(document.activeElement)) return;
        state.gen++;
        clearTimeout(timer);
        state.items.forEach(function (x) { if (x.result && x.result.url) URL.revokeObjectURL(x.result.url); });
        state.items = [];
        state.skipped = [];
        state.active = 0;
        renderActive();
        renderList();
        resultEl.hidden = true;
        setStatus('');
      });
      /* ── clear:end ── */

      syncOptionUi();
    })();
  </script>

<style>
  /* v2 "convert" layout: the root is a flex column, so the two panes (.zt-io in
     tool-common.css) take the height that is left under the options and the status line.
     Left: drop zone, code box and the file table. Right: the result and its notes. */
  .s2p-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; min-height: 0; }
  .s2p-wrap [hidden] { display: none !important; }
  /* The shared .zt-tip has no flex: none; keep the button round in a flex row. */
  .s2p-wrap :global(.zt-tip) { flex: none; }
  .s2p-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .s2p-options { display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem; align-items: flex-end; }
  .s2p-opt { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  /* Every label row is as high as a toggletip button, so labels with and without one line up. */
  .s2p-opt-head, .s2p-opt > .tool-label { display: flex; align-items: center; gap: 0.25rem; min-height: 24px; }
  .s2p-opt select.tool-input { min-width: 9rem; }
  .s2p-num { width: 7rem; }
  .s2p-scale-row { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .s2p-chips { display: flex; gap: 0.25rem; }
  .s2p-chip {
    min-width: 2.4rem;
    height: 2rem;
    padding: 0 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    font-weight: 650;
    cursor: pointer;
  }
  .s2p-chip[aria-pressed="true"] { border-color: var(--color-primary); color: var(--color-primary); background: var(--color-bg); }
  .s2p-color {
    width: 3rem;
    height: 2.5rem;
    padding: 2px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    cursor: pointer;
  }

  .s2p-status { min-height: 0; overflow-wrap: anywhere; }
  .s2p-status:empty { display: none; }

  .s2p-head { display: flex; align-items: center; gap: 0.25rem; min-height: 36px; }
  .s2p-convert { flex: none; margin-left: auto; min-height: 34px; padding-top: 0.3rem; padding-bottom: 0.3rem; }

  /* Left pane */
  .s2p-drop {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 1rem;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .s2p-drop:hover,
  .s2p-drag .s2p-drop { border-color: var(--color-primary); background: var(--color-bg); }
  .s2p-drop svg { flex: none; color: var(--color-primary); }
  .s2p-drop-text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .s2p-drop-title { font-size: 0.95rem; font-weight: 600; color: var(--color-text); }
  .s2p-drop-hint { font-size: 0.8rem; line-height: 1.4; }
  .s2p-file-input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .s2p-pane--in:has(.s2p-file-input:focus-visible) .s2p-drop { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .s2p-code { font-size: 0.82rem; }

  /* Several files: the table takes the pane's height and scrolls inside it; the code box
     keeps a short strip for pasting. */
  .s2p-batch { display: flex; flex: 1 1 0; flex-direction: column; gap: 0.5rem; align-items: flex-start; min-width: 0; min-height: 150px; }
  .s2p-pane--in:has(.s2p-batch:not([hidden])) .s2p-code { flex: none; min-height: 0; height: 64px; }
  .s2p-table-wrap { position: relative; flex: 1 1 0; width: 100%; min-height: 0; overflow: auto; border-radius: var(--radius-sm); box-shadow: inset 0 0 0 1px var(--color-border-soft); }
  .s2p-table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
  .s2p-table th { position: sticky; top: 0; z-index: 1; text-align: left; font-weight: 600; color: var(--color-text-secondary); padding: 0.3rem 0.5rem; background: var(--color-surface-muted); }
  /* A long error text in the last column must not squeeze the name and the size. */
  .s2p-table th:first-child { width: 40%; }
  .s2p-table :global(td) { padding: 0.3rem 0.5rem; border-top: 1px solid var(--color-border-soft); vertical-align: middle; }
  .s2p-table :global(td:nth-child(2)) { white-space: nowrap; }
  .s2p-table :global(.s2p-row-active td) { background: var(--color-surface-muted); }
  .s2p-table :global(.s2p-pick) {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--color-primary);
    text-decoration: underline;
    cursor: pointer;
    text-align: left;
    overflow-wrap: anywhere;
  }
  .s2p-table :global(.s2p-row-error) { color: var(--color-danger); }

  /* Right pane: one framed box. flex-basis 0 and overflow: a tall preview or a long list
     of notes scrolls inside the box and never makes the page taller. */
  .s2p-out {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 0.5rem;
    overflow: auto;
    padding: 0.82rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }
  /* Shown until there is a result or a note (at 860px and below the pane is hidden instead). */
  .s2p-empty { max-width: 36ch; margin: auto; text-align: center; font-size: 0.88rem; line-height: 1.55; color: var(--color-text-muted); }
  .s2p-out:has(.s2p-result:not([hidden])) .s2p-empty,
  .s2p-out:has(.s2p-notes:not([hidden])) .s2p-empty { display: none; }
  .s2p-result { display: flex; flex: 1 0 auto; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .s2p-bar { display: flex; flex: none; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .s2p-dims { flex: 1 1 auto; min-width: 0; font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-text-secondary); overflow-wrap: anywhere; }
  /* The preview takes the height the pane has left. */
  .s2p-preview-box {
    position: relative;
    flex: 1 1 0;
    min-height: 160px;
    border-radius: var(--radius-md);
    outline: 1px solid var(--color-border-soft);
    outline-offset: -1px;
    /* The squares must show on the pane's own background in both themes. */
    background:
      repeating-conic-gradient(color-mix(in oklch, var(--color-text-muted) 22%, transparent) 0% 25%, transparent 0% 50%) 0 0 / 16px 16px,
      var(--color-surface);
    overflow: hidden;
  }
  /* Drawn at its own size or smaller, never enlarged. */
  .s2p-preview-img { position: absolute; inset: 0.5rem; width: calc(100% - 1rem); height: calc(100% - 1rem); object-fit: scale-down; }

  .s2p-notes {
    flex: none;
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    overflow-wrap: anywhere;
  }

  /* Stacked: input, then the result at its own height (hidden until there is one), then
     the options. */
  @media (max-width: 860px) {
    .s2p-code { height: 130px; }
    .s2p-batch { flex: none; min-height: 0; }
    .s2p-table-wrap { flex: none; max-height: 260px; }
    .s2p-pane--out:has(.s2p-result[hidden]):has(.s2p-notes[hidden]) { display: none; }
    .s2p-out { flex: none; min-height: 0; overflow: visible; resize: none; }
    .s2p-preview-box { display: flex; flex: none; align-items: center; justify-content: center; min-height: 80px; padding: 0.5rem; }
    .s2p-preview-img { position: static; width: auto; height: auto; max-width: 100%; max-height: min(45vh, 360px); object-fit: contain; }
    .s2p-options { order: 5; }
  }

  @media (max-width: 640px) {
    .s2p-drop { padding: 0.6rem 0.75rem; }
    .s2p-drop-hint { display: none; }
    .s2p-code { height: 120px; }
    .s2p-head { min-height: 44px; }
    .s2p-opt-head, .s2p-opt > .tool-label { min-height: 28px; }
    .s2p-convert { min-height: 44px; }
    .s2p-out { padding: 0.65rem; }
    .s2p-preview-img { max-height: 170px; }
    .s2p-chip { height: 2.75rem; min-width: 2.75rem; }
    .s2p-color { height: 2.75rem; }
    .s2p-table :global(.s2p-pick) { min-height: 24px; }
  }
</style>
