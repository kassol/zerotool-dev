        if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1024 / 1024).toFixed(2) + ' MB';
      }
      function listUrls(urls) {
        var shown = urls.slice(0, 3).map(function (u) { return u.length > 80 ? u.slice(0, 77) + '…' : u; });
        return shown.join(', ') + (urls.length > 3 ? ' (+' + (urls.length - 3) + ')' : '');
      }
      function setStatus(msg, kind) {
        statusEl.textContent = msg || '';
        statusEl.className = 'tool-status s2p-status' + (kind ? ' ' + kind : '');
      }

      function errorText(e) {
        if (!e) return '';
        if (e.code === 'tooLarge' || e.code === 'canvas') return fill(t.err[e.code], { w: e.width.toLocaleString('en-US'), h: e.height.toLocaleString('en-US') });
        if (e.code === 'xml' && e.entity) return fill(t.err.xmlEntity, { line: e.line, entity: e.entity });
        if (e.code === 'xml') return fill(t.err.xml, { line: e.line == null ? '?' : e.line, detail: e.detail });
        return fill(t.err[e.code] || t.err.render, e);
      }

      function noteText(n) {
        var vars = {};
        for (var k in n) if (hasOwn(n, k)) vars[k] = n[k];
        if (n.urls) vars.urls = listUrls(n.urls);
        return fill(t.note[n.code], vars);
      }

      /* ── options ── */
      function readOptions() {
        var bg = bgEl.value;
        var q = parseInt(qualityEl.value, 10);
        return {
          mode: modeEl.value,
          scale: scaleEl.value,
          width: widthEl.value,
          height: heightEl.value,
          format: formatEl.value,
          quality: q >= 1 && q <= 100 ? q / 100 : 0.92,
          background: bg === 'white' ? '#ffffff' : bg === 'custom' ? colorEl.value : null
        };
      }

      function syncOptionUi() {
        var mode = modeEl.value;
        $('s2p-scale-wrap').hidden = mode !== 'scale';
        $('s2p-w-wrap').hidden = !(mode === 'width' || mode === 'exact');
        $('s2p-h-wrap').hidden = !(mode === 'height' || mode === 'exact');
        $('s2p-quality-wrap').hidden = formatEl.value === 'image/png';
        $('s2p-color-wrap').hidden = bgEl.value !== 'custom';
        chips.forEach(function (c) { c.setAttribute('aria-pressed', String(Number(c.dataset.scale) === Number(scaleEl.value))); });
        downloadBtn.textContent = fill(t.download, { format: FORMAT_LABEL[formatEl.value] });
      }

      function prefillSize() {
        var item = state.items[state.active];
        var r = item && item.result && !item.result.error ? item.result : null;
        if (!r) return;
        if (!widthEl.value) widthEl.value = r.width;
        if (!heightEl.value) heightEl.value = r.height;
      }

      var timer = null;
      function schedule() {
        syncOptionUi();
        if (!state.items.length) return;
        clearTimeout(timer);
        timer = setTimeout(run, 250);
      }
      modeEl.addEventListener('change', function () { prefillSize(); schedule(); });
      [scaleEl, widthEl, heightEl, qualityEl].forEach(function (el) { el.addEventListener('input', schedule); });
      [formatEl, bgEl, colorEl].forEach(function (el) { el.addEventListener('change', schedule); });
      colorEl.addEventListener('input', schedule);
      chips.forEach(function (c) {
        c.addEventListener('click', function () { scaleEl.value = c.dataset.scale; schedule(); });
      });

      /* ── conversion ── */
      function checkXml(svg) {
        var doc = new DOMParser().parseFromString(svg, 'image/svg+xml');
        var perr = doc.getElementsByTagName('parsererror')[0];
        if (!perr) return null;
        var info = parseXmlError(perr.textContent);
        return { code: 'xml', line: info.line, detail: info.detail, entity: info.entity };
      }

      function loadImage(svg) {
        return new Promise(function (resolve, reject) {
          var url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml;charset=utf-8' }));
          var img = new Image();
          img.onload = function () { URL.revokeObjectURL(url); resolve(img); };
          img.onerror = function () { URL.revokeObjectURL(url); reject(new Error('render')); };
          img.src = url;
        });
      }

      // A canvas above the browser's limit is created but draws nothing (MDN, <canvas>
      // "Maximum canvas size"); test its last pixel before drawing.
      function canvasUsable(ctx, w, h) {
        try {
          ctx.fillStyle = '#000';
          ctx.fillRect(w - 1, h - 1, 1, 1);
          var ok = ctx.getImageData(w - 1, h - 1, 1, 1).data[3] === 255;
          ctx.clearRect(w - 1, h - 1, 1, 1);
          return ok;
        } catch (e) { return false; }
      }

      function toBlob(canvas, type, quality) {
        return new Promise(function (resolve, reject) {
          try { canvas.toBlob(resolve, type, quality); } catch (e) { reject(e); }
        });
      }

      function collectNotes(a, plan) {
        var notes = [];
        if (a.size.source === 'viewBox') notes.push({ code: 'viewBox', w: shortNum(a.size.width), h: shortNum(a.size.height) });
        if (a.size.source === 'default') notes.push({ code: 'default' });
        a.size.notes.forEach(function (n) { notes.push(n); });
        if (a.fixes.indexOf('xmlns') >= 0) notes.push({ code: 'xmlns' });
        if (a.fixes.indexOf('xlink') >= 0) notes.push({ code: 'xlink' });
        if (a.refs.images.length) notes.push({ code: 'externalImage', urls: a.refs.images });
        if (a.refs.uses.length) notes.push({ code: 'externalUse', urls: a.refs.uses });
        var css = a.refs.imports.concat(a.refs.css);
        if (css.length) notes.push({ code: 'externalCss', urls: css });
        if (plan.letterbox) notes.push({ code: 'letterbox' });
        return notes;
      }

      function blockedError(e, a) {
        if (e && e.name === 'SecurityError') return a.refs.foreignObject ? { code: 'taintedForeign' } : { code: 'tainted', detail: e.name };
        return { code: 'encode' };
      }

      function convertItem(item, opts) {
        var a = item.analysis;
        if (a.error) return Promise.resolve({ error: a.error });
        var plan = planOutput(a.size, opts);
        if (plan.error) return Promise.resolve({ error: { code: plan.error, width: plan.width, height: plan.height } });
        var svg = buildSvg(item.text, a, plan);
        var xmlError = checkXml(svg);
        if (xmlError) return Promise.resolve({ error: xmlError });
        var notes = collectNotes(a, plan);
        var w = plan.width, h = plan.height;
        return loadImage(svg).then(function (img) {
          var canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          var ctx = canvas.getContext('2d');
          if (!ctx || !canvasUsable(ctx, w, h)) return { error: { code: 'canvas', width: w, height: h } };
          var bg = backgroundFor(opts.format, opts.background);
          if (bg.note) notes.push({ code: bg.note });
          if (bg.color) { ctx.fillStyle = bg.color; ctx.fillRect(0, 0, w, h); }
          ctx.drawImage(img, 0, 0, w, h);
          if (!bg.color && w * h <= 4194304 && isBlank(ctx.getImageData(0, 0, w, h).data)) notes.push({ code: 'blank' });
          return toBlob(canvas, opts.format, opts.quality).then(function (blob) {
            canvas.width = 0;
            canvas.height = 0;
            if (!blob) return { error: { code: 'encode' } };
            if (blob.type !== opts.format) notes.push({ code: 'formatFallback', format: FORMAT_LABEL[opts.format], actual: FORMAT_LABEL[blob.type] || blob.type });
            return {
              blob: blob, url: URL.createObjectURL(blob), width: w, height: h, notes: notes,
              sourceWidth: a.size.width, sourceHeight: a.size.height,
              fileName: outputName(item.name, opts, plan, extForMime(blob.type))
            };
          });
        }, function () {
          return { error: { code: 'render' } };
        }).catch(function (e) { return { error: blockedError(e, a) }; });
      }

      function run() {
        var gen = ++state.gen;
        var opts = readOptions();
        var items = state.items;
        setStatus(t.converting, 'info');
        var i = 0;
        (function next() {
          if (gen !== state.gen) return;
          if (i >= items.length) { finish(); return; }
          var item = items[i++];
          convertItem(item, opts).then(function (res) {
            if (gen !== state.gen) { if (res.url) URL.revokeObjectURL(res.url); return; }
            if (item.result && item.result.url) URL.revokeObjectURL(item.result.url);
            item.result = res;
            if (item === items[state.active]) renderActive();
            next();
          });
        })();
      }

      function finish() {
        var ok = state.items.filter(function (x) { return x.result && !x.result.error; });
        var names = uniqueNames(ok.map(function (x) { return x.result.fileName; }));
        ok.forEach(function (x, i) { x.result.fileName = names[i]; });
        renderActive();
        renderList();
        var item = state.items[state.active];
        if (state.items.length > 1) setStatus(fill(t.doneMany, { ok: ok.length, n: state.items.length }), ok.length ? 'success' : 'error');
        else if (item.result.error) setStatus(errorText(item.result.error), 'error');
        else setStatus(fill(t.doneOne, { name: item.name || 'SVG', file: item.result.fileName }), 'success');
        inputSec.hidden = ok.length > 0;
        if (ok.length) {
          window.trackTool && window.trackTool('svg-to-png-converter', 'convert');
        }
        resultEl.hidden = !ok.length && state.items.length === 1;
        var bar = resultEl.getBoundingClientRect();
        if (!resultEl.hidden && (bar.top < 0 || bar.bottom > window.innerHeight)) resultEl.scrollIntoView({ block: 'nearest' });
      }

      function renderActive() {
        var item = state.items[state.active];
        var r = item && item.result;
        var notes = [];
        if (state.skipped.length) notes.push(fill(t.note.skipped, { names: state.skipped.join(', ') }));
        if (r && !r.error) {
          resultEl.hidden = false;
          previewImg.src = r.url;
          previewImg.hidden = false;
          dimsEl.textContent = fill(t.result, { w: r.width, h: r.height, bytes: formatBytes(r.blob.size) });
          downloadBtn.disabled = false;
          r.notes.forEach(function (n) { notes.push(noteText(n)); });
        } else {
          previewImg.hidden = true;
          previewImg.removeAttribute('src');
          dimsEl.textContent = r && r.error ? errorText(r.error) : '';
          downloadBtn.disabled = true;
        }
        notesEl.textContent = '';
        notes.forEach(function (s) {
          var li = document.createElement('li');
          li.textContent = s;
          notesEl.appendChild(li);
        });
        notesEl.hidden = !notes.length;
      }

      function renderList() {
        var many = state.items.length > 1;
        batchEl.hidden = !many;
        rowsEl.textContent = '';
        if (!many) return;
        state.items.forEach(function (item, idx) {
          var r = item.result;
          var tr = document.createElement('tr');
          if (idx === state.active) tr.className = 's2p-row-active';
          var tdName = document.createElement('td');
          var pick = document.createElement('button');
          pick.type = 'button';
          pick.className = 's2p-pick';
          pick.textContent = item.name;
          pick.setAttribute('aria-current', idx === state.active ? 'true' : 'false');
          pick.addEventListener('click', function () { state.active = idx; renderActive(); renderList(); });
          tdName.appendChild(pick);
          var tdSize = document.createElement('td');
          var tdDl = document.createElement('td');
          if (r && !r.error) {
            tdSize.textContent = fill(t.listSizes, { sw: shortNum(r.sourceWidth), sh: shortNum(r.sourceHeight), w: r.width, h: r.height });
            var dl = document.createElement('button');
            dl.type = 'button';
            dl.className = 'btn-sm s2p-row-dl';
            dl.textContent = r.fileName;
            dl.addEventListener('click', function () { save(r.url, r.fileName); });
            tdDl.appendChild(dl);
          } else {
            tdSize.textContent = t.listError;
            tdSize.className = 's2p-row-error';
            tdSize.title = r ? errorText(r.error) : '';
            tdDl.textContent = r ? errorText(r.error) : '';
            tdDl.className = 's2p-row-error';
          }
          tr.appendChild(tdName);
          tr.appendChild(tdSize);
          tr.appendChild(tdDl);
          rowsEl.appendChild(tr);
        });
      }

      function save(url, name) {
        var a = document.createElement('a');
        a.href = url;
        a.download = name;
        document.body.appendChild(a);
        a.click();
        a.remove();
      }

      downloadBtn.addEventListener('click', function () {
        var r = state.items[state.active] && state.items[state.active].result;
        if (r && !r.error) save(r.url, r.fileName);
      });

      zipBtn.addEventListener('click', function () {
        var ok = state.items.filter(function (x) { return x.result && !x.result.error; });
        if (!ok.length) return;
        Promise.all(ok.map(function (x) { return x.result.blob.arrayBuffer(); })).then(function (bufs) {
          var zip = zipStore(ok.map(function (x, i) { return { name: x.result.fileName, data: new Uint8Array(bufs[i]) }; }));
          var url = URL.createObjectURL(new Blob([zip], { type: 'application/zip' }));
          save(url, 'svg-to-png.zip');
          setTimeout(function () { URL.revokeObjectURL(url); }, 10000);
        });
      });

      /* ── input ── */
      function load(list, skipped) {
        state.items.forEach(function (x) { if (x.result && x.result.url) URL.revokeObjectURL(x.result.url); });
        state.skipped = skipped || [];
        state.items = list.map(function (x) {
          var analysis = x.readError ? { error: { code: 'read', name: x.name } } : analyzeSvg(x.text);
          return { name: x.name, text: x.text, analysis: analysis, result: null };
        });
        state.active = 0;
        if (!state.items.length) {
          renderActive();
          renderList();
          resultEl.hidden = true;
          setStatus(fill(t.note.skipped, { names: state.skipped.join(', ') }), 'error');
          return;
        }
        run();
      }

      function isSvgFile(f) { return /\.svg$/i.test(f.name) || f.type === 'image/svg+xml'; }

      function loadFiles(files) {
        var all = Array.prototype.slice.call(files || []);
        if (!all.length) return;
        var svgs = all.filter(isSvgFile);
        var skipped = all.filter(function (f) { return !isSvgFile(f); }).map(function (f) { return f.name; });
        Promise.all(svgs.map(function (f) {
          return f.text().then(function (text) { return { name: f.name, text: text }; }, function () {
            return { name: f.name, text: '', readError: true };
          });
        })).then(function (list) {
          load(list, skipped);
        });
      }

      function activateTab(tab) {
        var isFile = tab === 'file';
        tabFile.classList.toggle('s2p-tab--active', isFile);
        tabCode.classList.toggle('s2p-tab--active', !isFile);
        tabFile.setAttribute('aria-selected', String(isFile));
        tabCode.setAttribute('aria-selected', String(!isFile));
        panelFile.hidden = !isFile;
        panelCode.hidden = isFile;
      }
      tabFile.addEventListener('click', function () { activateTab('file'); });
      tabCode.addEventListener('click', function () { activateTab('code'); codeInput.focus(); });

      fileInput.addEventListener('change', function () {
        loadFiles(fileInput.files);
        fileInput.value = '';
      });
      $('s2p-convert-code').addEventListener('click', function () { load([{ name: '', text: codeInput.value }]); });
      codeInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); load([{ name: '', text: codeInput.value }]); }
      });
      otherBtn.addEventListener('click', function () {
        inputSec.hidden = false;
        (panelFile.hidden ? codeInput : $('s2p-drop')).focus();
      });

      // The whole tool accepts dropped files, so a drop next to the box does not open the file.
      wrap.addEventListener('dragover', function (e) {
        e.preventDefault();
        wrap.classList.add('s2p-drag');
      });
      wrap.addEventListener('dragleave', function (e) {
        if (!wrap.contains(e.relatedTarget)) wrap.classList.remove('s2p-drag');
      });
      wrap.addEventListener('drop', function (e) {
        e.preventDefault();
        wrap.classList.remove('s2p-drag');
        if (e.dataTransfer && e.dataTransfer.files.length) loadFiles(e.dataTransfer.files);
      });

      // Paste SVG code or SVG files anywhere on the page, outside other text fields.
      document.addEventListener('paste', function (e) {
        var target = e.target;
        if (target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;
        var cd = e.clipboardData;
        if (!cd) return;
        var files = Array.prototype.slice.call(cd.files || []).filter(isSvgFile);
        if (files.length) { e.preventDefault(); loadFiles(files); return; }
        var text = cd.getData('text/plain');
        if (text && /<svg[\s>]/i.test(text)) {
          e.preventDefault();
          codeInput.value = text;
          activateTab('code');
          load([{ name: '', text: text }]);
        }
      });

      syncOptionUi();
    })();
  </script>
</div>

<style>
  .s2p-wrap { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  .s2p-input { display: flex; flex-direction: column; gap: 0.6rem; }

  .s2p-tabs { display: flex; border-bottom: 2px solid var(--color-border); }
  .s2p-tab {
    padding: 0.45rem 1rem;
    font-size: 0.88rem;
    font-weight: 600;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    cursor: pointer;
    color: var(--color-text-secondary);
  }
  .s2p-tab:hover { color: var(--color-text); }
  .s2p-tab--active { color: var(--color-primary); border-bottom-color: var(--color-primary); }

  .s2p-panel { display: flex; flex-direction: column; gap: 0.5rem; }
  .s2p-panel[hidden] { display: none; }

  .s2p-drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    padding: 1.25rem 1rem;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .s2p-drop:hover,
  .s2p-drag .s2p-drop { border-color: var(--color-primary); background: var(--color-bg); }
  .s2p-drop-title { font-size: 0.95rem; font-weight: 600; color: var(--color-text); }
  .s2p-drop-hint { font-size: 0.8rem; }
  .s2p-file-input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .s2p-panel:focus-within .s2p-drop { outline: 2px solid var(--color-primary); outline-offset: 2px; }

  .s2p-code { min-height: 9rem; }

  .s2p-result { display: flex; flex-direction: column; gap: 0.5rem; }
  .s2p-result[hidden] { display: none; }
  .s2p-bar { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .s2p-dims { flex: 1 1 auto; min-width: 0; font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-text-secondary); }
  .s2p-preview-box {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80px;
    padding: 0.5rem;
    border-radius: var(--radius-md);
    outline: 1px solid var(--color-border-soft);
    outline-offset: -1px;
    background: repeating-conic-gradient(var(--color-bg-secondary) 0% 25%, var(--color-surface) 0% 50%) 0 0 / 16px 16px;
    overflow: hidden;
  }
  .s2p-preview-img { display: block; max-width: 100%; max-height: min(45vh, 360px); object-fit: contain; }

  .s2p-status { min-height: 0; }
  .s2p-status:empty { display: none; }
  .s2p-notes {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    overflow-wrap: anywhere;
  }
  .s2p-notes[hidden] { display: none; }

  .s2p-batch { display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; min-width: 0; }
  .s2p-batch[hidden] { display: none; }
  .s2p-table { width: 100%; border-collapse: collapse; font-size: 0.84rem; display: block; overflow-x: auto; }
  .s2p-table th { text-align: left; font-weight: 600; color: var(--color-text-secondary); padding: 0.3rem 0.5rem; }
  .s2p-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .s2p-table :global(td) { padding: 0.3rem 0.5rem; border-top: 1px solid var(--color-border-soft); vertical-align: middle; }
  .s2p-table :global(.s2p-row-active td) { background: var(--color-surface-muted); }
  .s2p-table :global(.s2p-pick) {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--color-primary);
    text-decoration: underline;
    cursor: pointer;
    text-align: left;
    overflow-wrap: anywhere;
  }
  .s2p-table :global(.s2p-row-error) { color: var(--color-danger); }

  .s2p-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: flex-end;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-soft);
  }
  .s2p-opt { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .s2p-opt[hidden] { display: none; }
  .s2p-opt select.tool-input { min-width: 9rem; }
  .s2p-num { width: 7rem; }
  .s2p-scale-row { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .s2p-chips { display: flex; gap: 0.25rem; }
  .s2p-chip {
    min-width: 2.4rem;
    height: 2rem;
    padding: 0 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    font-weight: 650;
    cursor: pointer;
  }
  .s2p-chip[aria-pressed="true"] { border-color: var(--color-primary); color: var(--color-primary); background: var(--color-bg); }
  .s2p-color {
    width: 3rem;
    height: 2.5rem;
    padding: 2px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .s2p-drop { padding: 0.9rem 0.75rem; }
    .s2p-drop-hint { font-size: 0.78rem; }
    .s2p-preview-img { max-height: 170px; }
    .s2p-chip { height: 2.75rem; min-width: 2.75rem; }
    .s2p-color { height: 2.75rem; }
    .s2p-table :global(.s2p-pick) { min-height: 24px; }
  }
</style>
