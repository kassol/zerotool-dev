// SvgToPngConverterTool — renders SVG with the browser (as an <img>) onto a canvas and
// exports PNG, JPEG or WebP. Nothing is uploaded.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

