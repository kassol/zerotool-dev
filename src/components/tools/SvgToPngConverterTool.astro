---

<div>
  <div class="s2p-wrap" id="s2p-wrap">
    <div id="s2p-input" class="s2p-input">
      <div class="s2p-tabs" role="tablist">
        <button id="s2p-tab-file" class="s2p-tab s2p-tab--active" type="button" role="tab" aria-selected="true" aria-controls="s2p-panel-file">{T.uploadTab}</button>
        <button id="s2p-tab-code" class="s2p-tab" type="button" role="tab" aria-selected="false" aria-controls="s2p-panel-code">{T.pasteTab}</button>
      </div>

      <div id="s2p-panel-file" class="s2p-panel" role="tabpanel" aria-labelledby="s2p-tab-file">
        <label id="s2p-drop" class="s2p-drop" for="s2p-file">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
          <span class="s2p-drop-title">{T.dropTitle}</span>
          <span class="s2p-drop-hint">{T.dropHint}</span>
        </label>
        <input type="file" id="s2p-file" class="s2p-file-input" accept=".svg,image/svg+xml" multiple />
      </div>

      <div id="s2p-panel-code" class="s2p-panel" hidden role="tabpanel" aria-labelledby="s2p-tab-code">
        <label for="s2p-code" class="tool-label">{T.codeLabel}</label>
        <textarea id="s2p-code" class="tool-textarea s2p-code" rows="7" spellcheck="false" placeholder={T.codePh}></textarea>
        <button id="s2p-convert-code" class="btn-primary" type="button">{T.convertCode}</button>
      </div>
    </div>

    <div id="s2p-result" class="s2p-result" hidden>
      <div class="s2p-bar">
        <span id="s2p-dims" class="s2p-dims"></span>
        <button id="s2p-other" class="btn-ghost s2p-other" type="button">{T.other}</button>
        <button id="s2p-download" class="btn-primary" type="button"></button>
      </div>
      <div class="s2p-preview-box">
        <img id="s2p-preview" class="s2p-preview-img" alt={T.previewAlt} />
      </div>
    </div>

    <div id="s2p-status" class="tool-status s2p-status" aria-live="polite"></div>
    <ul id="s2p-notes" class="s2p-notes" hidden></ul>

    <div id="s2p-batch" class="s2p-batch" hidden>
      <table class="s2p-table">
        <thead><tr><th scope="col">{T.listFile}</th><th scope="col">{T.listSize}</th><th scope="col"><span class="s2p-sr">{T.download}</span></th></tr></thead>
        <tbody id="s2p-rows"></tbody>
      </table>
      <button id="s2p-zip" class="btn-secondary" type="button">{T.downloadAll}</button>
    </div>

    <div class="s2p-options">
      <div class="s2p-opt">
        <label for="s2p-mode" class="tool-label">{T.sizeLabel}</label>
        <select id="s2p-mode" class="tool-input">
          <option value="scale">{T.modeScale}</option>
          <option value="width">{T.modeWidth}</option>
          <option value="height">{T.modeHeight}</option>
          <option value="exact">{T.modeExact}</option>
        </select>
      </div>
      <div class="s2p-opt" id="s2p-scale-wrap">
        <label for="s2p-scale" class="tool-label">{T.scaleLabel}</label>
        <div class="s2p-scale-row">
          <input id="s2p-scale" class="tool-input s2p-num" type="number" min="0.1" max="64" step="any" value="1" inputmode="decimal" />
          <div class="s2p-chips" role="group" aria-label={T.scaleLabel}>
            <button type="button" class="s2p-chip" data-scale="1" aria-pressed="true">1x</button>
            <button type="button" class="s2p-chip" data-scale="2" aria-pressed="false">2x</button>
            <button type="button" class="s2p-chip" data-scale="3" aria-pressed="false">3x</button>
            <button type="button" class="s2p-chip" data-scale="4" aria-pressed="false">4x</button>
          </div>
        </div>
      </div>
      <div class="s2p-opt" id="s2p-w-wrap" hidden>
        <label for="s2p-width" class="tool-label">{T.widthLabel}</label>
        <input id="s2p-width" class="tool-input s2p-num" type="number" min="1" max="65535" step="1" inputmode="numeric" />
      </div>
      <div class="s2p-opt" id="s2p-h-wrap" hidden>
        <label for="s2p-height" class="tool-label">{T.heightLabel}</label>
        <input id="s2p-height" class="tool-input s2p-num" type="number" min="1" max="65535" step="1" inputmode="numeric" />
      </div>
