      result: '픽셀 크기, 파일 크기, 미리보기, 다운로드 버튼을 보여 줍니다. 파일 이름은 SVG 이름을 따르며, 배율이 1이 아니면 @2x 같은 접미사가, 다른 크기 방식에서는 「-너비x높이」가 붙습니다. 붙여 넣은 코드는 image라는 이름으로 저장합니다. 미리보기 아래 안내는 추가한 내용과 불러오지 못한 참조를 알려 줍니다. 파일이 여러 개면 파일 표에서 이름을 눌러 그 파일을 보고 줄마다 따로 받을 수 있습니다. 「모두 다운로드(.zip)」는 svg-to-png.zip을 저장합니다.'
    },
    sizeLabel: '크기', modeScale: '배율', modeWidth: '너비', modeHeight: '높이', modeExact: '너비 × 높이',
    scaleLabel: '배율', widthLabel: '너비(px)', heightLabel: '높이(px)',
    formatLabel: '형식', qualityLabel: '품질',
    bgLabel: '배경', bgTransparent: '투명', bgWhite: '흰색', bgCustom: '색 지정', colorLabel: '배경색',
    download: '{format} 다운로드', downloadAll: '모두 다운로드(.zip)', previewAlt: '변환 결과',
    listFile: '파일', listSize: '크기', listSizes: '{sw} × {sh} → {w} × {h}', listError: '오류', listDownload: '다운로드',
    converting: '변환 중…', result: '{w} × {h} px · {bytes}',
    doneOne: '{name} → {file}', doneMany: '{n}개 중 {ok}개를 변환했습니다.',
    err: {
      empty: 'SVG가 비어 있습니다.',
      notSvg: '<svg> 요소를 찾을 수 없습니다.',
      rootNotSvg: '루트 요소가 <svg>가 아니라 <{name}>입니다. <svg>…</svg> 부분만 붙여 넣으세요.',
      xml: 'SVG가 올바른 XML이 아닙니다({line}번째 줄): {detail}',
      xmlEntity: 'SVG가 올바른 XML이 아닙니다({line}번째 줄): &{entity};는 HTML 엔티티이며 XML에는 정의되어 있지 않습니다. &nbsp; 대신 &#160;처럼 숫자로 쓰세요.',
      render: '브라우저가 이 SVG를 그리지 못했습니다.',
      tainted: '브라우저가 이미지 읽기를 막았습니다({detail}).',
      taintedForeign: 'SVG에 <foreignObject>(SVG 안의 HTML)가 있습니다. Chrome과 Edge는 이런 이미지를 canvas에서 내보내지 못하게 막습니다. HTML 부분을 SVG의 <text>나 도형으로 바꾸세요.',
      tooLarge: '{w} × {h} px는 한 변 65,535 px 한도를 넘습니다.',
      canvas: '이 브라우저에서는 {w} × {h} px canvas를 만들 수 없습니다. 데스크톱 Chrome은 268,435,456픽셀(16,384 × 16,384), iPhone과 iPad는 4,096 × 4,096까지입니다. 더 작은 크기를 고르세요.',
      badNumber: '1부터 65,535까지의 정수를 입력하세요.',
      badScale: '0보다 큰 배율을 입력하세요.',
      encode: '브라우저가 이미지를 인코딩하지 못했습니다.',
      read: '{name}을(를) 읽지 못했습니다.'
    },
    note: {
      viewBox: 'width / height가 없어 viewBox 크기({w} × {h})로 출력했습니다.',
      default: 'width, height, viewBox가 모두 없어 기본 크기 300 × 150으로 출력했습니다.',
      relativeSize: '{attr}="{value}"는 SVG가 놓이는 페이지에 따라 정해지므로 무시했습니다.',
      xmlns: '빠진 xmlns="http://www.w3.org/2000/svg"를 추가했습니다. 이것이 없으면 이미지로 열리지 않습니다.',
      xlink: '빠진 xmlns:xlink 선언을 추가했습니다.',
      externalImage: '외부 이미지 링크를 제거했습니다. 브라우저는 SVG 이미지가 참조하는 파일을 불러오지 않습니다: {urls}. 남기려면 data: URI로 넣으세요.',
      externalUse: '<use>가 다른 파일을 참조하지만 불러오지 않습니다: {urls}.',
      externalCss: 'CSS가 외부 파일을 참조하지만 불러오지 않습니다: {urls}. 글자는 웹 폰트 대신 설치된 글꼴로 그려집니다.',
      letterbox: '이 크기는 SVG와 가로세로 비율이 다릅니다. 도형은 preserveAspectRatio 설정대로 가운데에 놓입니다.',
      jpegWhite: 'JPEG는 투명을 지원하지 않아 투명한 부분은 흰색이 됩니다.',
      formatFallback: '이 브라우저는 {format}를 인코딩하지 못해 {actual}로 저장했습니다.',
      blank: '결과가 완전히 투명합니다. 도형이 viewBox 안에 있는지 확인하세요.',
      skipped: 'SVG가 아닌 파일은 건너뛰었습니다: {names}.'
    }
  }
};
// strings:end

const T = STRINGS[lang];
// The script gets every string except the toggletip text, which is in the HTML.
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="s2p-wrap" id="s2p-wrap">
  <div class="s2p-options">
    <div class="s2p-opt">
      <span class="s2p-opt-head">
        <label for="s2p-mode" class="tool-label">{T.sizeLabel}</label>
        <Toggletip id="s2p-tip-size" lang={lang} about={T.sizeLabel} wide>{TIPS.size}</Toggletip>
      </span>
      <select id="s2p-mode" class="tool-input">
        <option value="scale">{T.modeScale}</option>
        <option value="width">{T.modeWidth}</option>
        <option value="height">{T.modeHeight}</option>
        <option value="exact">{T.modeExact}</option>
      </select>
    </div>
    <div class="s2p-opt" id="s2p-scale-wrap">
      <label for="s2p-scale" class="tool-label">{T.scaleLabel}</label>
      <div class="s2p-scale-row">
        <input id="s2p-scale" class="tool-input s2p-num" type="number" min="0.1" max="64" step="any" value="1" inputmode="decimal" />
        <div class="s2p-chips" role="group" aria-label={T.scaleLabel}>
          <button type="button" class="s2p-chip" data-scale="1" aria-pressed="true">1x</button>
          <button type="button" class="s2p-chip" data-scale="2" aria-pressed="false">2x</button>
          <button type="button" class="s2p-chip" data-scale="3" aria-pressed="false">3x</button>
          <button type="button" class="s2p-chip" data-scale="4" aria-pressed="false">4x</button>
        </div>
      </div>
    </div>
    <div class="s2p-opt" id="s2p-w-wrap" hidden>
      <label for="s2p-width" class="tool-label">{T.widthLabel}</label>
      <input id="s2p-width" class="tool-input s2p-num" type="number" min="1" max="65535" step="1" inputmode="numeric" />
    </div>
    <div class="s2p-opt" id="s2p-h-wrap" hidden>
      <label for="s2p-height" class="tool-label">{T.heightLabel}</label>
      <input id="s2p-height" class="tool-input s2p-num" type="number" min="1" max="65535" step="1" inputmode="numeric" />
    </div>
    <div class="s2p-opt">
      <span class="s2p-opt-head">
        <label for="s2p-format" class="tool-label">{T.formatLabel}</label>
        <Toggletip id="s2p-tip-format" lang={lang} about={T.formatLabel} wide>{TIPS.format}</Toggletip>
      </span>
      <select id="s2p-format" class="tool-input">
        <option value="image/png">PNG</option>
        <option value="image/jpeg">JPEG</option>
        <option value="image/webp">WebP</option>
      </select>
    </div>
    <div class="s2p-opt" id="s2p-quality-wrap" hidden>
      <label for="s2p-quality" class="tool-label">{T.qualityLabel}</label>
      <input id="s2p-quality" class="tool-input s2p-num" type="number" min="1" max="100" step="1" value="92" inputmode="numeric" />
    </div>
    <div class="s2p-opt">
      <span class="s2p-opt-head">
        <label for="s2p-bg" class="tool-label">{T.bgLabel}</label>
        <Toggletip id="s2p-tip-bg" lang={lang} about={T.bgLabel} wide>{TIPS.bg}</Toggletip>
      </span>
      <select id="s2p-bg" class="tool-input">
        <option value="transparent">{T.bgTransparent}</option>
        <option value="white">{T.bgWhite}</option>
        <option value="custom">{T.bgCustom}</option>
      </select>
    </div>
    <div class="s2p-opt" id="s2p-color-wrap" hidden>
      <label for="s2p-color" class="tool-label">{T.colorLabel}</label>
      <input id="s2p-color" class="s2p-color" type="color" value="#ffffff" />
    </div>
  </div>

  <div id="s2p-status" class="tool-status s2p-status" aria-live="polite"></div>

  <div class="s2p-panels zt-io">
    <div class="s2p-pane s2p-pane--in zt-io-pane">
      <label id="s2p-drop" class="s2p-drop" for="s2p-file">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
        </svg>
        <span class="s2p-drop-text">
          <span class="s2p-drop-title">{T.dropTitle}</span>
          <span class="s2p-drop-hint">{T.dropHint}</span>
        </span>
      </label>
      <input type="file" id="s2p-file" class="s2p-file-input" accept=".svg,image/svg+xml" multiple />
      <div class="s2p-head">
        <label for="s2p-code" class="tool-label">{T.codeLabel}</label>
        <Toggletip id="s2p-tip-input" lang={lang} about={T.codeLabel} wide>{TIPS.input}</Toggletip>
        <button id="s2p-convert-code" class="btn-primary s2p-convert" type="button">{T.convertCode}</button>
      </div>
      <textarea id="s2p-code" class="tool-textarea s2p-code zt-io-fill" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder={T.codePh}></textarea>

      <div id="s2p-batch" class="s2p-batch" hidden>
        <div class="s2p-table-wrap">
          <table class="s2p-table">
            <thead><tr><th scope="col">{T.listFile}</th><th scope="col">{T.listSize}</th><th scope="col"><span class="s2p-sr">{T.listDownload}</span></th></tr></thead>
            <tbody id="s2p-rows"></tbody>
          </table>
        </div>
        <button id="s2p-zip" class="btn-secondary" type="button">{T.downloadAll}</button>
      </div>
    </div>

    <div class="s2p-pane s2p-pane--out zt-io-pane">
      <div class="s2p-head">
        <span id="s2p-out-label" class="tool-label">{T.outLabel}</span>
        <Toggletip id="s2p-tip-result" lang={lang} about={T.outLabel} wide>{TIPS.result}</Toggletip>
      </div>
      <div class="s2p-out zt-io-fill" role="group" aria-labelledby="s2p-out-label">
        <p class="s2p-empty">{T.outEmpty}</p>
        <div id="s2p-result" class="s2p-result" hidden>
          <div class="s2p-bar">
            <span id="s2p-dims" class="s2p-dims"></span>
            <button id="s2p-download" class="btn-primary" type="button"></button>
          </div>
          <div class="s2p-preview-box">
            <img id="s2p-preview" class="s2p-preview-img" alt={T.previewAlt} />
          </div>
        </div>
        <ul id="s2p-notes" class="s2p-notes" hidden></ul>
      </div>
    </div>
  </div>
</div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      /* ── engine:start ── */
      var SVG_NS = 'http://www.w3.org/2000/svg';
      var XLINK_NS = 'http://www.w3.org/1999/xlink';
      // Largest canvas side any browser accepts (Chrome 152: 65,535; measured 2026-09-30).
      var MAX_SIDE = 65535;
      // CSS absolute units in px (CSS Values and Units Level 4, section 6.2).
      var ABS_UNITS = { '': 1, px: 1, in: 96, cm: 96 / 2.54, mm: 96 / 25.4, q: 96 / 101.6, pt: 4 / 3, pc: 16 };

      function hasOwn(o, k) { return Object.prototype.hasOwnProperty.call(o, k); }

      // { px } for absolute and font-relative lengths; { px: null, unit } when the length
      // needs a layout to resolve (%, ex, ch, vw…) or is not a positive number; null when absent.
      function parseLength(value, fontSize) {
        if (value == null) return null;
        var s = String(value).trim();
        if (s === '' || s.toLowerCase() === 'auto') return null;
        var m = /^([+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?)([a-z%]*)$/i.exec(s);
        if (!m) return { px: null, unit: s };
        var n = parseFloat(m[1]);
        var unit = m[2].toLowerCase();
        var px;
        if (hasOwn(ABS_UNITS, unit)) px = n * ABS_UNITS[unit];
        else if (unit === 'em') px = n * fontSize;
        else if (unit === 'rem') px = n * 16;
        else return { px: null, unit: unit };
        if (!(px > 0) || !isFinite(px)) return { px: null, unit: 'invalid' };
        return { px: px };
      }

      function parseStyle(style) {
        var out = {};
        String(style || '').split(';').forEach(function (decl) {
          var i = decl.indexOf(':');
          if (i < 0) return;
          var key = decl.slice(0, i).trim().toLowerCase();
          var value = decl.slice(i + 1).replace(/!important\s*$/i, '').trim();
          if (key) out[key] = value;
        });
        return out;
      }

      function parseViewBox(value) {
        if (value == null) return null;
        var parts = String(value).trim().split(/[\s,]+/);
        if (parts.length !== 4) return null;
        var n = parts.map(Number);
        if (n.some(function (x) { return !isFinite(x); })) return null;
        if (!(n[2] > 0) || !(n[3] > 0)) return null;
        return { x: n[0], y: n[1], width: n[2], height: n[3] };
      }

      // The size the SVG has on its own, in CSS px. Follows what Chrome reports as the
      // natural size of an <img>, except that a viewBox alone gives the viewBox size
      // (Chrome gives 300 × 150).
      function intrinsicSize(attrs) {
        var style = parseStyle(attrs.style);
        var fsLen = parseLength(hasOwn(style, 'font-size') ? style['font-size'] : attrs['font-size'], 16);
        var fontSize = fsLen && fsLen.px ? fsLen.px : 16;
        var notes = [];
        function dim(name) {
          var raw = hasOwn(style, name) ? style[name] : attrs[name];
          var len = parseLength(raw, fontSize);
          if (len && len.px == null) notes.push({ code: 'relativeSize', attr: name, value: String(raw).trim() });
          return len && len.px != null ? len.px : null;
        }
        var w = dim('width');
        var h = dim('height');
        var vb = parseViewBox(attrs.viewBox);
        var source = 'size';
        if (w == null || h == null) {
          if (vb) {
            if (w != null) h = w * vb.height / vb.width;
            else if (h != null) w = h * vb.width / vb.height;
            else { w = vb.width; h = vb.height; source = 'viewBox'; }
          } else {
            if (w == null && h == null) source = 'default';
            if (w == null) w = 300;
            if (h == null) h = 150;
          }
        }
        return { width: w, height: h, viewBox: vb, source: source, notes: notes };
      }

      function wholeNumber(v) {
        var s = String(v == null ? '' : v).trim();
        if (!/^\d+$/.test(s)) return null;
        var n = parseInt(s, 10);
        return n >= 1 && n <= MAX_SIDE ? n : null;
      }

      // opts.mode: 'scale' (opts.scale), 'width', 'height' (keep the aspect ratio) or
      // 'exact' (opts.width × opts.height; the SVG's preserveAspectRatio places the drawing).
      function planOutput(size, opts) {
        var w = size.width, h = size.height, ow, oh;
        if (opts.mode === 'width' || opts.mode === 'height' || opts.mode === 'exact') {
          var vw = opts.mode === 'height' ? 1 : wholeNumber(opts.width);
          var vh = opts.mode === 'width' ? 1 : wholeNumber(opts.height);
          if (vw == null || vh == null) return { error: 'badNumber' };
          if (opts.mode === 'width') { ow = vw; oh = vw * h / w; }
          else if (opts.mode === 'height') { oh = vh; ow = vh * w / h; }
          else { ow = vw; oh = vh; }
        } else {
          var f = Number(opts.scale);
          if (!(f > 0) || !isFinite(f)) return { error: 'badScale' };
          ow = w * f; oh = h * f;
        }
        ow = Math.max(1, Math.round(ow));
        oh = Math.max(1, Math.round(oh));
        if (ow > MAX_SIDE || oh > MAX_SIDE) return { error: 'tooLarge', width: ow, height: oh };
        return { width: ow, height: oh, letterbox: opts.mode === 'exact' && Math.abs((ow / oh) / (w / h) - 1) > 0.01 };
      }

      function decodeXml(s) {
        return String(s).replace(/&(#x[0-9a-f]+|#\d+|amp|lt|gt|quot|apos);/gi, function (m, e) {
          var k = e.toLowerCase();
          if (k === 'amp') return '&';
          if (k === 'lt') return '<';
          if (k === 'gt') return '>';
          if (k === 'quot') return '"';
          if (k === 'apos') return "'";
          var cp = k.charAt(1) === 'x' ? parseInt(k.slice(2), 16) : parseInt(k.slice(1), 10);
          return cp > 0 && cp <= 0x10FFFF ? String.fromCodePoint(cp) : m;
        });
      }

      function skipDeclaration(src, i) {
        var depth = 0, quote = null;
        for (var j = i + 2; j < src.length; j++) {
          var c = src.charAt(j);
          if (quote) { if (c === quote) quote = null; continue; }
          if (c === '"' || c === "'") quote = c;
          else if (c === '[') depth++;
          else if (c === ']') depth--;
          else if (c === '>' && depth <= 0) return j + 1;
        }
        return src.length;
      }

      var TAG_NAME = /[A-Za-z_][\w.\-]*(?::[\w.\-]+)?/y;
      var ATTR_NAME = /[^\s=\/>]+/y;
      var SPACE = /\s/;

      function readStartTag(src, i) {
        TAG_NAME.lastIndex = i + 1;
        var m = TAG_NAME.exec(src);
        if (!m) return null;
        var n = src.length;
        var tag = { name: m[0], start: i, attrs: [], selfClosing: false, closeStart: n, end: n };
        var j = i + 1 + m[0].length;
        while (j < n) {
          while (j < n && SPACE.test(src.charAt(j))) j++;
          var c = src.charAt(j);
          if (c === '>') { tag.closeStart = j; tag.end = j + 1; return tag; }
          if (c === '/' && src.charAt(j + 1) === '>') { tag.closeStart = j; tag.end = j + 2; tag.selfClosing = true; return tag; }
          ATTR_NAME.lastIndex = j;
          var am = ATTR_NAME.exec(src);
          if (!am) { j++; continue; }
          var start = j;
          j += am[0].length;
          var k = j;
          while (k < n && SPACE.test(src.charAt(k))) k++;
          if (src.charAt(k) !== '=') { tag.attrs.push({ name: am[0], value: '', rawValue: '', quote: '', start: start, end: j }); continue; }
          k++;
          while (k < n && SPACE.test(src.charAt(k))) k++;
          var q = src.charAt(k), raw, end;
          if (q === '"' || q === "'") {
            var close = src.indexOf(q, k + 1);
            if (close < 0) close = n;
            raw = src.slice(k + 1, close);
            end = Math.min(n, close + 1);
          } else {
            q = '';
            var e = k;
            while (e < n && !SPACE.test(src.charAt(e)) && src.charAt(e) !== '>') e++;
            raw = src.slice(k, e);
            end = e;
          }
          tag.attrs.push({ name: am[0], value: decodeXml(raw), rawValue: raw, quote: q, start: start, end: end });
          j = end;
        }
        return tag;
      }

      // Start tags in document order, with attribute positions. Comments, CDATA sections,
