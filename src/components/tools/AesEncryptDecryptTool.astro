const L = STRINGS[lang];
// The script gets every string except the toggletip text, which is in the HTML.
const { tips: TIPS, ...CLIENT_S } = L;
---
<div class="aes-wrap">
  <div class="aes-keybar">
    <select id="aes-mode" class="tool-input aes-select aes-mode" aria-label={L.keyMode}>
      <option value="password">{L.modePassword}</option>
      <option value="raw">{L.modeRaw}</option>
    </select>
    <Toggletip id="aes-tip-key" lang={lang} about={L.keyMode} wide>{TIPS.key}</Toggletip>
    <input type="password" id="aes-password" class="tool-input aes-key-input" placeholder={L.passwordPlaceholder} aria-label={L.modePassword} autocomplete="off" spellcheck="false" autocapitalize="off" />
    <input type="text" id="aes-rawkey" class="tool-input aes-key-input" placeholder={L.rawKeyPlaceholder} aria-label={L.modeRaw} autocomplete="off" spellcheck="false" autocapitalize="off" hidden />
    <button id="aes-toggle-pw" class="btn-ghost aes-btn" type="button" aria-pressed="false">{L.show}</button>
    <select id="aes-keyfmt" class="tool-input aes-select" aria-label={L.keyFormat} hidden>
      <option value="hex">Hex</option>
      <option value="base64">Base64</option>
      <option value="text">{L.keyFmtText}</option>
    </select>
    <button id="aes-genkey" class="btn-secondary aes-btn" type="button" hidden>{L.generate}</button>
    <div id="aes-advanced" class="aes-advanced" hidden>
      <span class="aes-adv-field">
        <input type="text" id="aes-iv" class="tool-input" placeholder={L.ivPlaceholder} aria-label={L.ivPlaceholder} autocomplete="off" spellcheck="false" autocapitalize="off" />
        <Toggletip id="aes-tip-iv" lang={lang} about="IV" wide>{TIPS.iv}</Toggletip>
      </span>
      <span class="aes-adv-field">
        <input type="text" id="aes-aad" class="tool-input" placeholder={L.aadPlaceholder} aria-label={L.aadPlaceholder} autocomplete="off" spellcheck="false" autocapitalize="off" />
        <Toggletip id="aes-tip-aad" lang={lang} about="AAD" wide>{TIPS.aad}</Toggletip>
      </span>
    </div>
    <span class="aes-actions">
      <button id="aes-encrypt" class="btn-primary aes-go" type="button">{L.encrypt}</button>
      <button id="aes-decrypt" class="btn-primary aes-go" type="button">{L.decrypt}</button>
    </span>
  </div>

  <div class="aes-feedback">
    <p id="aes-status" class="tool-status aes-status" role="status" aria-live="polite" hidden></p>
    <button id="aes-download" class="btn-secondary aes-download" type="button" hidden></button>
  </div>

  <div class="aes-io zt-io">
    <div class="aes-pane zt-io-pane">
      <div class="aes-head">
        <label class="aes-label" for="aes-plaintext">{L.plaintext}</label>
        <Toggletip id="aes-tip-plain" lang={lang} about={L.plaintext} wide>{TIPS.plain}</Toggletip>
        <span class="aes-head-end">
          <button id="aes-plain-file-btn" class="btn-ghost aes-btn aes-file-btn" type="button" title={L.fileEncTitle} aria-label={L.fileEncTitle}>{L.file}</button>
        </span>
        <input type="file" id="aes-plain-file-input" hidden />
      </div>
      <div class="aes-box">
        <textarea id="aes-plaintext" class="tool-textarea aes-textarea zt-io-fill" spellcheck="false" placeholder={L.plaintextPlaceholder}></textarea>
        <div id="aes-plain-file" class="aes-file zt-io-fill" hidden>
          <span class="aes-file-name"></span>
          <button type="button" class="aes-file-clear" aria-label={L.removeFile}>×</button>
        </div>
      </div>
    </div>

    <div class="aes-pane zt-io-pane">
      <div class="aes-head">
        <label class="aes-label" for="aes-ciphertext">{L.ciphertext}</label>
        <Toggletip id="aes-tip-cipher" lang={lang} about={L.ciphertext} wide>{TIPS.cipher}</Toggletip>
        <span class="aes-head-end">
          <button id="aes-cipher-file-btn" class="btn-ghost aes-btn aes-file-btn" type="button" title={L.fileDecTitle} aria-label={L.fileDecTitle}>{L.file}</button>
          <label class="aes-enc-label">
            <span>{L.outputEncoding}</span>
            <select id="aes-encoding" class="tool-input aes-select">
              <option value="base64">Base64</option>
              <option value="hex">Hex</option>
            </select>
          </label>
          <button id="aes-copy" class="btn-copy aes-copy" type="button">{L.copy}</button>
        </span>
        <input type="file" id="aes-cipher-file-input" hidden />
      </div>
      <div class="aes-box">
        <textarea id="aes-ciphertext" class="tool-textarea aes-textarea zt-io-fill" spellcheck="false" placeholder={L.ciphertextPlaceholder}></textarea>
        <div id="aes-cipher-file" class="aes-file zt-io-fill" hidden>
          <span class="aes-file-name"></span>
          <button type="button" class="aes-file-clear" aria-label={L.removeFile}>×</button>
        </div>
      </div>
    </div>
  </div>

  <p class="aes-note">{L.note}</p>

  <script is:inline define:vars={{ S: CLIENT_S }}>
    (function () {
      /* ── engine:start ── */
      // Password ciphertext: "v2:" + Base64 or hex of [salt 16][iv 12][ciphertext][tag 16], key from
      // PBKDF2-HMAC-SHA256 at 600,000 iterations (OWASP Password Storage Cheat Sheet). Text without a
      // prefix is the original format of this page (200,000 iterations); if that fails, the same
      // layout is tried at 600,000 (what other tools and code that drops the prefix produce).
      // ":" is not a Base64 or hex character, so a prefix can never be part of the payload.
      // Raw key ciphertext: Base64 or hex of [iv 12][ciphertext][tag 16], no prefix (the layout of
      // Go's gcm.Seal(nonce, nonce, …) and of Python AESGCM output with the nonce in front).
      // Files are the same bytes without Base64: password mode "v2:" + payload, raw key mode payload.
      var CURRENT_VERSION = 2;
      var PBKDF2_ITERATIONS = { 1: 200000, 2: 600000 };
      var SALT_BYTES = 16, IV_BYTES = 12, TAG_BYTES = 16;
      var MAX_FILE_BYTES = 256 * 1024 * 1024;
      var B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
      var SALTED = [0x53, 0x61, 0x6c, 0x74, 0x65, 0x64, 0x5f, 0x5f]; // "Salted__" (OpenSSL enc, CryptoJS)
      var HEX = [];
      for (var h = 0; h < 256; h++) HEX.push((h < 16 ? '0' : '') + h.toString(16));

      function fail(code, detail) {
        var e = new Error(code + (detail ? ' ' + JSON.stringify(detail, function (k, v) { return v instanceof Uint8Array ? v.length + ' bytes' : v; }) : ''));
        e.code = code;
        e.detail = detail || {};
        return e;
      }
      function toSpec(spec) { return typeof spec === 'string' ? { type: 'password', password: spec } : spec; }
      function isSpace(c) { return c === ' ' || c === '\n' || c === '\r' || c === '\t' || c === '\f' || c === '\v'; }
      function startsWith(bytes, prefix) {
        if (bytes.length < prefix.length) return false;
        for (var i = 0; i < prefix.length; i++) if (bytes[i] !== prefix[i]) return false;
        return true;
      }
      function concat(parts) {
        var n = 0, i;
        for (i = 0; i < parts.length; i++) n += parts[i].length;
        var out = new Uint8Array(n), off = 0;
        for (i = 0; i < parts.length; i++) { out.set(parts[i], off); off += parts[i].length; }
        return out;
      }

      function bytesToBase64(bytes) {
        var parts = [];
        for (var i = 0; i < bytes.length; i += 0x8000) parts.push(String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000)));
        return btoa(parts.join(''));
      }
      function bytesToHex(bytes) {
        var out = new Array(bytes.length);
        for (var i = 0; i < bytes.length; i++) out[i] = HEX[bytes[i]];
        return out.join('');
      }

      // RFC 4648 §4 Base64, or the URL-safe alphabet of §5; whitespace (line breaks of copied
      // text) is ignored; "=" only at the end. Positions are 1-based characters of the whole input.
      function binToBytes(bin) {
        var out = new Uint8Array(bin.length);
        for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
        return out;
      }
      function decodeBase64(text, offset) {
        if (text.length % 4 === 0 && /^[A-Za-z0-9+/]*={0,2}$/.test(text)) return binToBytes(atob(text));
        var clean = [], pad = 0, padPos = 0, pos = offset;
        for (var ch of text) {
          pos++;
          if (isSpace(ch)) continue;
          if (ch === '=') { if (!pad) padPos = pos; pad++; continue; }
          if (pad) throw fail('base64', { ch: '=', pos: padPos });
          if (ch === '-') ch = '+';
          else if (ch === '_') ch = '/';
          else if (B64.indexOf(ch) < 0) throw fail('base64', { ch: ch, pos: pos });
          clean.push(ch);
        }
        var s = clean.join('');
        if (s.length % 4 === 1 || pad > 2 || (pad && (s.length + pad) % 4 !== 0)) throw fail('base64Length', { chars: s.length + pad });
        while (s.length % 4) s += '=';
        return binToBytes(atob(s));
      }
      function isHexText(text) { return /^[0-9a-fA-F\s]+$/.test(text) && /[0-9a-fA-F]/.test(text); }
      function decodeHex(text) {
        var s = text.replace(/\s+/g, '');
        if (s.length % 2) throw fail('hex', { digits: s.length });
        var out = new Uint8Array(s.length / 2);
        for (var i = 0; i < out.length; i++) out[i] = parseInt(s.substr(i * 2, 2), 16);
        return out;
      }

      function parseCiphertext(input) {
        var text = String(input).trim();
        if (!text) throw fail('empty');
        var version = null, body = text, offset = 0;
        var m = /^v(\d+):/.exec(text);
        if (m) { body = text.slice(m[0].length); offset = m[0].length; }
        var encoding = isHexText(body) ? 'hex' : 'base64';
        var bytes = encoding === 'hex' ? decodeHex(body) : decodeBase64(body, offset);
        if (startsWith(bytes, SALTED)) throw fail('openssl');
        if (m) {
          version = Number(m[1]);
          if (version === 1 || !PBKDF2_ITERATIONS[version]) throw fail('version', { version: m[1] });
        }
        return { version: version, bytes: bytes, encoding: encoding };
      }

      async function deriveKey(password, salt, iterations, usages) {
        var keyMaterial = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
        return crypto.subtle.deriveKey(
          { name: 'PBKDF2', salt: salt, iterations: iterations, hash: 'SHA-256' },
          keyMaterial, { name: 'AES-GCM', length: 256 }, false, usages
        );
      }
      function importRawKey(bytes, usages) {
        return crypto.subtle.importKey('raw', bytes, 'AES-GCM', false, usages);
      }
      function gcmParams(iv, aad) {
        var p = { name: 'AES-GCM', iv: iv, tagLength: 128 };
        if (aad && aad.length) p.additionalData = aad;
        return p;
      }
      async function gcmOpen(key, iv, data, aad) {
        try {
          return new Uint8Array(await crypto.subtle.decrypt(gcmParams(iv, aad), key, data));
        } catch (e) {
          throw fail('auth'); // OperationError: the tag does not match
        }
      }

      async function sealPayload(spec, plain) {
        if (spec.type === 'raw') {
          // A given IV (e.g. a nonce stored next to the ciphertext) is not written to the output.
          var riv = spec.iv || crypto.getRandomValues(new Uint8Array(IV_BYTES));
          var rk = await importRawKey(spec.key, ['encrypt']);
          var sealed = new Uint8Array(await crypto.subtle.encrypt(gcmParams(riv, spec.aad), rk, plain));
          return spec.iv ? sealed : concat([riv, sealed]);
        }
        var iv = crypto.getRandomValues(new Uint8Array(IV_BYTES));
        var salt = crypto.getRandomValues(new Uint8Array(SALT_BYTES));
        var key = await deriveKey(spec.password, salt, PBKDF2_ITERATIONS[CURRENT_VERSION], ['encrypt']);
        return concat([salt, iv, new Uint8Array(await crypto.subtle.encrypt({ name: 'AES-GCM', iv: iv, tagLength: 128 }, key, plain))]);
      }

      async function openPayload(spec, payload, version) {
        if (spec.type === 'raw') {
          var rmin = spec.iv ? TAG_BYTES : IV_BYTES + TAG_BYTES;
          if (payload.length < rmin) throw fail('short', { bytes: payload.length, min: rmin });
          var rk = await importRawKey(spec.key, ['decrypt']);
          if (spec.iv) return { bytes: await gcmOpen(rk, spec.iv, payload, spec.aad), iterations: 0 };
          return { bytes: await gcmOpen(rk, payload.subarray(0, IV_BYTES), payload.subarray(IV_BYTES), spec.aad), iterations: 0 };
        }
        var min = SALT_BYTES + IV_BYTES + TAG_BYTES;
        if (payload.length < min) throw fail('short', { bytes: payload.length, min: min });
        var salt = payload.subarray(0, SALT_BYTES);
        var iv = payload.subarray(SALT_BYTES, SALT_BYTES + IV_BYTES);
        var body = payload.subarray(SALT_BYTES + IV_BYTES);
        var tries = version === null ? [PBKDF2_ITERATIONS[1], PBKDF2_ITERATIONS[2]] : [PBKDF2_ITERATIONS[version]];
        for (var i = 0; i < tries.length; i++) {
          var key = await deriveKey(spec.password, salt, tries[i], ['decrypt']);
          try {
            return { bytes: await gcmOpen(key, iv, body), iterations: tries[i] };
          } catch (e) {
            if (e.code !== 'auth' || i === tries.length - 1) throw e;
          }
        }
      }

      function utf8OrNull(bytes) {
        try { return new TextDecoder('utf-8', { fatal: true, ignoreBOM: true }).decode(bytes); } catch (e) { return null; }
      }

      async function encryptText(spec, text, encoding) {
        spec = toSpec(spec);
        var payload = await sealPayload(spec, new TextEncoder().encode(text));
        var body = encoding === 'hex' ? bytesToHex(payload) : bytesToBase64(payload);
        return spec.type === 'raw' ? body : 'v' + CURRENT_VERSION + ':' + body;
      }

      async function decryptInput(spec, input) {
        spec = toSpec(spec);
        var p = parseCiphertext(input);
        if (spec.type === 'raw' && p.version !== null) throw fail('rawPrefix');
        var r = await openPayload(spec, p.bytes, p.version);
        return { text: utf8OrNull(r.bytes), bytes: r.bytes, version: p.version, iterations: r.iterations, encoding: p.encoding };
      }

      async function decryptText(spec, input) {
        var r = await decryptInput(spec, input);
        if (r.text === null) throw fail('utf8', { n: r.bytes.length, bytes: r.bytes });
        return r.text;
      }

      async function encryptFile(spec, bytes) {
        spec = toSpec(spec);
        if (bytes.length > MAX_FILE_BYTES) throw fail('fileSize', { bytes: bytes.length });
        var payload = await sealPayload(spec, bytes);
        return spec.type === 'raw' ? payload : concat([new TextEncoder().encode('v' + CURRENT_VERSION + ':'), payload]);
      }

      function isAsciiText(bytes) {
        for (var i = 0; i < bytes.length; i++) {
          var b = bytes[i];
          if (b > 0x7e || (b < 0x20 && b !== 0x09 && b !== 0x0a && b !== 0x0d)) return false;
        }
        return true;
      }

      async function decryptFile(spec, bytes) {
        spec = toSpec(spec);
        if (!bytes.length) throw fail('empty');
        if (bytes.length > MAX_FILE_BYTES + 64) throw fail('fileSize', { bytes: bytes.length });
        if (startsWith(bytes, SALTED)) throw fail('openssl');
        // A text ciphertext saved to a file (random binary is never all printable ASCII)
        if (isAsciiText(bytes)) {
          var text = new TextDecoder().decode(bytes);
          try {
            return (await decryptInput(spec, text)).bytes;
          } catch (e) {
            if (e.code === 'base64' || e.code === 'base64Length' || e.code === 'hex' || e.code === 'empty') throw fail('fileFormat');
            throw e;
          }
        }
        if (spec.type === 'raw') return (await openPayload(spec, bytes, null)).bytes;
        var head = String.fromCharCode.apply(null, bytes.subarray(0, 8));
        var m = /^v(\d+):/.exec(head);
        if (!m) throw fail('fileFormat');
        var version = Number(m[1]);
        if (version === 1 || !PBKDF2_ITERATIONS[version]) throw fail('version', { version: m[1] });
        return (await openPayload(spec, bytes.subarray(m[0].length), version)).bytes;
      }

      // format: 'hex', 'base64', or 'text' (the UTF-8 bytes of the string, e.g. a 32-character
      // WeChat Pay APIv3 key)
      function parseRawKey(str, format) {
        var text = String(str);
        if (!(format === 'text' ? text : text.replace(/\s+/g, ''))) throw fail('keyEmpty');
        var bytes;
        if (format === 'text') {
          bytes = new TextEncoder().encode(text);
        } else if (format === 'base64') {
          try { bytes = decodeBase64(text, 0); } catch (e) {
            if (e.code === 'base64') throw fail('keyChars', { ch: e.detail.ch, pos: e.detail.pos, format: 'Base64' });
            throw fail('keyBase64Length', { chars: e.detail.chars });
          }
        } else {
          var pos = 0;
          for (var ch of text) {
            pos++;
            if (!isSpace(ch) && !/[0-9a-fA-F]/.test(ch)) throw fail('keyChars', { ch: ch, pos: pos, format: 'hex' });
          }
          var s = text.replace(/\s+/g, '');
          if (s.length % 2) throw fail('keyHexLength', { digits: s.length });
          bytes = decodeHex(s);
        }
        if (bytes.length !== 16 && bytes.length !== 24 && bytes.length !== 32) throw fail('keyLength', { bytes: bytes.length });
        return bytes;
      }

      // IV field of raw key mode: 24 hex digits are read as 12 bytes; anything else is text,
      // used as its UTF-8 bytes (WeChat Pay APIv3 sends the nonce as a 12-character string).
      function parseIv(str) {
        var text = String(str || '');
        if (!text.trim()) return null;
        var compact = text.replace(/\s+/g, '');
        if (/^[0-9a-fA-F]{24}$/.test(compact)) return decodeHex(compact);
        return new TextEncoder().encode(text);
      }

      function generateRawKey(bits) {
        return bytesToHex(crypto.getRandomValues(new Uint8Array((bits || 256) / 8)));
      }
      /* ── engine:end ── */

      var modeEl = document.getElementById('aes-mode');
      var pwEl = document.getElementById('aes-password');
      var rawEl = document.getElementById('aes-rawkey');
      var toggleBtn = document.getElementById('aes-toggle-pw');
      var keyFmtEl = document.getElementById('aes-keyfmt');
      var genBtn = document.getElementById('aes-genkey');
      var advEl = document.getElementById('aes-advanced');
      var ivEl = document.getElementById('aes-iv');
      var aadEl = document.getElementById('aes-aad');
      var plainEl = document.getElementById('aes-plaintext');
      var cipherEl = document.getElementById('aes-ciphertext');
      var encBtn = document.getElementById('aes-encrypt');
      var decBtn = document.getElementById('aes-decrypt');
      var copyBtn = document.getElementById('aes-copy');
      var encodingEl = document.getElementById('aes-encoding');
      var statusEl = document.getElementById('aes-status');
      var downloadBtn = document.getElementById('aes-download');
      var wrap = document.querySelector('.aes-wrap');
      var plainFile = { input: document.getElementById('aes-plain-file-input'), btn: document.getElementById('aes-plain-file-btn'), chip: document.getElementById('aes-plain-file'), area: plainEl, file: null };
      var cipherFile = { input: document.getElementById('aes-cipher-file-input'), btn: document.getElementById('aes-cipher-file-btn'), chip: document.getElementById('aes-cipher-file'), area: cipherEl, file: null };
      var downloadUrl = null;
      var busy = false;

      function fmt(template, vars) {
        return String(template).replace(/\{(\w+)\}/g, function (all, k) { return vars && vars[k] !== undefined ? vars[k] : all; });
      }
      function num(n) { return Number(n).toLocaleString(document.documentElement.lang || 'en'); }
      function size(n) {
        if (n < 1024) return n + ' B';
        if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1024 / 1024).toFixed(1) + ' MB';
      }
      function setStatus(msg, kind) {
        statusEl.textContent = msg || '';
        statusEl.className = 'tool-status aes-status' + (kind ? ' ' + kind : '');
        statusEl.hidden = !msg;
      }
      function errorMessage(e) {
        var d = (e && e.detail) || {};
        var vars = {};
        for (var k in d) vars[k] = d[k];
        if (e && e.code === 'fileSize') { vars.size = size(d.bytes); vars.max = size(MAX_FILE_BYTES); }
        if (e && e.code === 'utf8') vars.n = num(d.n);
        var tpl = e && e.code && S['err_' + e.code];
        return tpl ? fmt(tpl, vars) : String(e && e.message || e);
      }
      function clearDownload() {
        if (downloadUrl) URL.revokeObjectURL(downloadUrl);
        downloadUrl = null;
        downloadBtn.hidden = true;
      }
      function offerDownload(bytes, name) {
        clearDownload();
        downloadUrl = URL.createObjectURL(new Blob([bytes], { type: 'application/octet-stream' }));
        downloadBtn.textContent = fmt(S.download, { name: name });
        downloadBtn.dataset.name = name;
        downloadBtn.hidden = false;
      }
      downloadBtn.addEventListener('click', function () {
        if (!downloadUrl) return;
        var a = document.createElement('a');
        a.href = downloadUrl;
        a.download = downloadBtn.dataset.name || 'download.bin';
        document.body.appendChild(a);
        a.click();
        a.remove();
      });

      function currentSpec() {
        if (modeEl.value === 'raw') {
          return { type: 'raw', key: parseRawKey(rawEl.value, keyFmtEl.value), iv: parseIv(ivEl.value), aad: aadEl.value ? new TextEncoder().encode(aadEl.value) : null };
        }
        if (!pwEl.value) { var e = new Error('noPassword'); e.ui = S.errNoPassword; throw e; }
        return { type: 'password', password: pwEl.value };
      }

      function applyMode() {
        var raw = modeEl.value === 'raw';
        pwEl.hidden = raw;
        toggleBtn.hidden = raw;
        rawEl.hidden = !raw;
        keyFmtEl.hidden = !raw;
        genBtn.hidden = !raw;
        advEl.hidden = !raw;
        rawEl.placeholder = keyFmtEl.value === 'base64' ? S.rawKeyPlaceholderB64 : keyFmtEl.value === 'text' ? S.rawKeyPlaceholderText : S.rawKeyPlaceholder;
        setStatus('');
      }
      modeEl.addEventListener('change', applyMode);
      keyFmtEl.addEventListener('change', applyMode);
      genBtn.addEventListener('click', function () {
        var hex = generateRawKey(256);
        if (keyFmtEl.value === 'text') { keyFmtEl.value = 'hex'; applyMode(); }
        if (keyFmtEl.value === 'base64') {
          var b = new Uint8Array(32);
          for (var i = 0; i < 32; i++) b[i] = parseInt(hex.substr(i * 2, 2), 16);
          rawEl.value = bytesToBase64(b);
        } else rawEl.value = hex;
        setStatus('');
      });
      toggleBtn.addEventListener('click', function () {
        var show = pwEl.type === 'password';
        pwEl.type = show ? 'text' : 'password';
        toggleBtn.textContent = show ? S.hide : S.show;
        toggleBtn.setAttribute('aria-pressed', String(show));
      });

      function setFile(slot, file) {
        slot.file = file || null;
        slot.input.value = '';
        slot.area.hidden = !!file;
        slot.chip.hidden = !file;
        if (file) slot.chip.querySelector('.aes-file-name').textContent = file.name + ' · ' + size(file.size);
        clearDownload();
        setStatus('');
      }
      [plainFile, cipherFile].forEach(function (slot) {
        slot.btn.addEventListener('click', function () { slot.input.click(); });
        slot.input.addEventListener('change', function () { if (slot.input.files && slot.input.files[0]) setFile(slot, slot.input.files[0]); });
        slot.chip.querySelector('.aes-file-clear').addEventListener('click', function () { setFile(slot, null); slot.area.focus(); });
        var box = slot.area.parentElement;
        box.addEventListener('dragover', function (e) { if (e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types, 'Files') >= 0) { e.preventDefault(); box.classList.add('aes-drop'); } });
        box.addEventListener('dragleave', function () { box.classList.remove('aes-drop'); });
        box.addEventListener('drop', function (e) {
          box.classList.remove('aes-drop');
          if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) { e.preventDefault(); setFile(slot, e.dataTransfer.files[0]); }
        });
      });

      function setBusy(on, spec) {
        busy = on;
        encBtn.disabled = on;
        decBtn.disabled = on;
        if (on) setStatus(spec.type === 'raw' ? S.workingRaw : fmt(S.working, { n: num(PBKDF2_ITERATIONS[CURRENT_VERSION]) }), 'info');
      }

      async function run(kind) {
        if (busy) return;
        var spec;
        clearDownload();
        try { spec = currentSpec(); } catch (e) { setStatus(e.ui || errorMessage(e), 'error'); return; }
        var slot = kind === 'encrypt' ? plainFile : cipherFile;
        if (!slot.file && !(kind === 'encrypt' ? plainEl.value : cipherEl.value.trim())) {
          setStatus(kind === 'encrypt' ? S.errNoPlaintext : S.errNoCiphertext, 'error');
          return;
        }
        setBusy(true, spec);
        try {
          if (slot.file) {
            if (slot.file.size > MAX_FILE_BYTES + (kind === 'encrypt' ? 0 : 64)) throw fail('fileSize', { bytes: slot.file.size });
            var input = new Uint8Array(await slot.file.arrayBuffer());
            var out, name;
            if (kind === 'encrypt') {
              out = await encryptFile(spec, input);
              name = slot.file.name + '.enc';
            } else {
              out = await decryptFile(spec, input);
              name = /\.enc$/i.test(slot.file.name) && slot.file.name.length > 4 ? slot.file.name.slice(0, -4) : slot.file.name + '.decrypted';
            }
            offerDownload(out, name);
            var ivFile = kind === 'encrypt' && spec.iv;
            setStatus(fmt(S.fileReady, { name: name, size: size(out.length) }) + (ivFile ? ' ' + S.ivWarning : ''), ivFile ? 'info' : 'success');
          } else if (kind === 'encrypt') {
            cipherEl.value = await encryptText(spec, plainEl.value, encodingEl.value);
            setStatus(fmt(spec.iv ? S.encryptedIv : spec.type === 'raw' ? S.encryptedRaw : S.encrypted, { n: num(new TextEncoder().encode(plainEl.value).length) }) + (spec.iv ? ' ' + S.ivWarning : ''), spec.iv ? 'info' : 'success');
          } else {
            var r = await decryptInput(spec, cipherEl.value);
            var format = spec.type === 'raw' ? (spec.iv ? S.fmtRawIv : S.fmtRaw) : r.version === 2 ? S.fmtV2 : r.iterations === PBKDF2_ITERATIONS[1] ? S.fmtLegacy : S.fmtNoPrefix600;
            if (r.text === null) {
              offerDownload(r.bytes, 'decrypted.bin');
              setStatus(fmt(S.err_utf8, { n: num(r.bytes.length) }), 'error');
            } else {
              plainEl.value = r.text;
              setStatus(fmt(S.decrypted, { n: num(r.bytes.length), format: format }), 'success');
            }
          }
          window.trackTool && window.trackTool('aes-encrypt-decrypt', kind + (slot.file ? '-file' : ''));
        } catch (e) {
          setStatus(errorMessage(e), 'error');
        } finally {
          busy = false;
          encBtn.disabled = false;
          decBtn.disabled = false;
        }
      }

      // Manual triggers only: encrypting on every keystroke would run PBKDF2 (600,000 iterations)
      // for each character and show intermediate states of the plaintext.
      encBtn.addEventListener('click', function () { run('encrypt'); });
      decBtn.addEventListener('click', function () { run('decrypt'); });
      // Ctrl/Cmd+Enter in the ciphertext box decrypts (ToolLayout's shortcut clicks the first
      // primary button, which is Encrypt).
      cipherEl.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); run('decrypt'); }
      });
      // ToolLayout's Ctrl/Cmd+L clears textareas and text inputs; also clear the password and files.
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
          pwEl.value = '';
          ivEl.value = '';
          aadEl.value = '';
          setFile(plainFile, null);
          setFile(cipherFile, null);
        }
      });

      copyBtn.addEventListener('click', function () {
        var text = cipherEl.value;
        if (!text) return;
        navigator.clipboard.writeText(text).then(function () {
          copyBtn.textContent = S.copied;
          setTimeout(function () { copyBtn.textContent = S.copy; }, 1500);
        });
      });

      applyMode();
    })();
  </script>
</div>

<style>
  /* v2 "convert" layout: the root is a flex column, so the two boxes (.zt-io in
     tool-common.css) take the height that is left under the key bar and the status line. */
  .aes-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-height: 0; }
  /* The toggletip root has no flex rule of its own; keep the "?" button from being squeezed. */
  .aes-wrap :global(.zt-tip) { flex: none; }

  .aes-keybar { display: flex; gap: 0.6rem 0.5rem; align-items: center; flex-wrap: wrap; }
  .aes-select { font-family: var(--font-sans); cursor: pointer; }
  .aes-mode { flex: 0 0 auto; }
  .aes-key-input { flex: 1 1 14rem; min-width: 0; }
  /* Two classes, so the limit wins over `.tool-widget input[type="password"] { max-width: 100% }`
     in tool-common.css. Encrypt and Decrypt follow the key directly on wide screens. */
  .aes-keybar .aes-key-input { max-width: 44rem; }
  .aes-key-input[hidden], .aes-keybar [hidden] { display: none; }
  .aes-actions { display: inline-flex; gap: 0.5rem; }

  /* IV and AAD come before Encrypt and Decrypt in the source (and in the tab order). Side by side
     they take the row under the key bar; stacked they sit between the key and the buttons. */
  .aes-advanced { order: 1; flex: 1 1 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.5rem; }
  .aes-advanced[hidden] { display: none; }
  .aes-adv-field { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .aes-adv-field .tool-input { flex: 1 1 auto; min-width: 0; }

  /* The status line keeps its height while it is empty, so a message does not move the boxes:
     one row side by side, two rows stacked, three on phones (the authentication error takes
     three rows at 390px in English and Japanese). The download button takes its own row under
     the message ("Download them below") and is there only for a file result. */
  .aes-feedback { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .aes-status { flex: 1 1 100%; margin: 0; min-height: 1.375rem; line-height: 1.375rem; overflow-wrap: anywhere; }
  .aes-status[hidden] { display: block; visibility: hidden; }
  .aes-download[hidden] { display: none; }

  .aes-head { display: flex; align-items: center; gap: 0.25rem 0.4rem; flex-wrap: wrap; min-height: 32px; }
  .aes-head-end { display: inline-flex; align-items: center; gap: 0.4rem; margin-left: auto; }
  .aes-label { font-size: 0.85rem; font-weight: 650; color: var(--color-text-secondary); }
  .aes-file-btn { font-size: 0.8rem; min-height: 32px; padding: 0.25rem 0.6rem; }
  .aes-enc-label { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; color: var(--color-text-secondary); }
  .aes-enc-label .aes-select { min-height: 32px; padding: 0.2rem 0.5rem; font-size: 0.8rem; }

  /* The box is the drop target; the text box or the chosen file fills it (.zt-io-fill). */
  .aes-box { position: relative; display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; min-height: 0; }
  .aes-textarea { display: block; }
  .aes-textarea[hidden] { display: none; }
  .aes-box.aes-drop .aes-textarea, .aes-box.aes-drop .aes-file { box-shadow: inset 0 0 0 2px var(--color-primary); }

  .aes-file {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.82rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }
  .aes-file[hidden] { display: none; }
  .aes-file-clear {
