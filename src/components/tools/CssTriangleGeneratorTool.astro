---
import Toggletip from '../Toggletip.astro';
// CssTriangleGeneratorTool — CSS triangle via border hack
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: {
    direction: 'Direction',
    width: 'Width (px)',
    height: 'Height (px)',
    color: 'Color',
    preview: 'Preview',
    outputLabel: 'Generated CSS',
    htmlLabel: 'HTML Usage',
    copy: 'Copy',
    copied: 'Copied!',
    copyFailed: 'Copy failed',
    badWidth: 'Width must be a whole number from 1 to 500 px.',
    badHeight: 'Height must be a whole number from 1 to 500 px.',
    top: 'Top', right: 'Right', bottom: 'Bottom', left: 'Left',
    topLeft: 'Top-Left', topRight: 'Top-Right',
    bottomLeft: 'Bottom-Left', bottomRight: 'Bottom-Right',
    empty: "Adjust a control to preview the triangle.",
    details: "HTML Usage",
    tips: {
          "direction": "Choose one of eight directions. The four corner buttons produce right-angle triangles.",
          "width": "Set the width in whole pixels from 1 to 500. For top and bottom triangles, an odd width is split into floor and ceil border widths; 25px becomes 12px + 13px.",
          "height": "Set the height in whole pixels from 1 to 500. Left and right triangles split an odd height between the top and bottom transparent borders.",
          "color": "Choose a color or enter # followed by six hex digits. Partial text keeps the previous color. Ctrl/⌘+L clears text and results while keeping size, direction and the color picker.",
          "css": "Copy the complete .triangle rule. Width and height are zero; its borders draw the shape. Copy failures are shown and can be retried.",
          "html": "Copy the fixed div with class triangle. Rename the class in both HTML and CSS when using another selector."
    },
  },
  zh: {
    direction: '方向',
    width: '宽度 (px)',
    height: '高度 (px)',
    color: '颜色',
    preview: '预览',
    outputLabel: '生成的 CSS',
    htmlLabel: 'HTML 用法',
    copy: '复制',
    copied: '已复制！',
    copyFailed: '复制失败',
    badWidth: '宽度须为 1 到 500 之间的整数（px）。',
    badHeight: '高度须为 1 到 500 之间的整数（px）。',
    top: '上', right: '右', bottom: '下', left: '左',
    topLeft: '左上', topRight: '右上',
    bottomLeft: '左下', bottomRight: '右下',
    empty: "调整任意控件即可预览三角形。",
    details: "HTML 用法",
    tips: {
          "direction": "选择八个方向之一。四个角按钮生成直角三角形。",
          "width": "宽度为 1 到 500 之间的整数像素。上下方向会将奇数宽度分成向下与向上取整的两条边，例如 25px 分成 12px + 13px。",
          "height": "高度为 1 到 500 之间的整数像素。左右方向会将奇数高度分到上下两条透明边框。",
          "color": "选择颜色或输入 # 加六位十六进制数字。未完成的输入保留原颜色。Ctrl/⌘+L 清空文本与结果，并保留尺寸、方向和颜色选择器。",
          "css": "复制完整的 .triangle 规则。width 与 height 为零，边框绘制三角形。复制失败会显示提示，可直接重试。",
          "html": "复制固定的 triangle 类 div。使用其他选择器时，同时修改 HTML 与 CSS 中的类名。"
    },
  },
  ja: {
    direction: '方向',
    width: '幅 (px)',
    height: '高さ (px)',
    color: '色',
    preview: 'プレビュー',
    outputLabel: '生成された CSS',
    htmlLabel: 'HTML 使用例',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyFailed: 'コピーに失敗しました',
    badWidth: '幅は1〜500の整数（px）で入力してください。',
    badHeight: '高さは1〜500の整数（px）で入力してください。',
    top: '上', right: '右', bottom: '下', left: '左',
    topLeft: '左上', topRight: '右上',
    bottomLeft: '左下', bottomRight: '右下',
    empty: "コントロールを調整すると三角形をプレビューできます。",
    details: "HTML 使用例",
    tips: {
          "direction": "8方向から選びます。四隅のボタンは直角三角形を生成します。",
          "width": "幅は1〜500の整数ピクセルで指定します。上下方向では奇数の幅を切り捨てと切り上げに分けます。25pxは12px + 13pxです。",
          "height": "高さは1〜500の整数ピクセルで指定します。左右方向では奇数の高さを上下の透明な境界線に分けます。",
          "color": "色を選ぶか、#に続けて6桁の16進数を入力します。途中の入力は元の色を保持します。Ctrl/⌘+Lでテキストと結果を消去し、サイズ・方向・カラーピッカーを保持します。",
          "css": "完全な.triangleルールをコピーします。widthとheightは0で、境界線が形を描きます。コピー失敗後は再試行できます。",
          "html": "triangleクラスの固定divをコピーします。別のセレクターを使う場合はHTMLとCSSの両方でクラス名を変更します。"
    },
  },
  ko: {
    direction: '방향',
    width: '너비 (px)',
    height: '높이 (px)',
    color: '색상',
    preview: '미리보기',
    outputLabel: '생성된 CSS',
    htmlLabel: 'HTML 사용법',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사 실패',
    badWidth: '너비는 1~500 사이의 정수(px)로 입력하세요.',
    badHeight: '높이는 1~500 사이의 정수(px)로 입력하세요.',
    top: '위', right: '오른쪽', bottom: '아래', left: '왼쪽',
    topLeft: '왼쪽 위', topRight: '오른쪽 위',
    bottomLeft: '왼쪽 아래', bottomRight: '오른쪽 아래',
    empty: "컨트롤을 조정하면 삼각형을 미리 볼 수 있습니다.",
    details: "HTML 사용법",
    tips: {
          "direction": "8개 방향 중 하나를 선택합니다. 네 모서리 버튼은 직각 삼각형을 만듭니다.",
          "width": "너비는 1~500 사이의 정수 픽셀로 설정합니다. 위아래 방향의 홀수 너비는 내림과 올림으로 나뉩니다. 25px은 12px + 13px입니다.",
          "height": "높이는 1~500 사이의 정수 픽셀로 설정합니다. 좌우 방향의 홀수 높이는 위아래 투명 테두리로 나뉩니다.",
          "color": "색상을 선택하거나 # 뒤에 6자리 16진수를 입력합니다. 미완성 입력은 기존 색상을 유지합니다. Ctrl/⌘+L은 텍스트와 결과를 지우고 크기, 방향, 색상 선택기는 유지합니다.",
          "css": "전체 .triangle 규칙을 복사합니다. width와 height는 0이며 테두리가 모양을 그립니다. 복사 실패 후 바로 다시 시도할 수 있습니다.",
          "html": "triangle 클래스의 고정 div를 복사합니다. 다른 선택자를 사용하면 HTML과 CSS의 클래스 이름을 함께 변경하세요."
    },
  },
};

// strings:end

const L = STRINGS[lang] ?? STRINGS.en;
---

<div
  class="ctg-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-bad-width={L.badWidth}
  data-bad-height={L.badHeight}
>
  <div class="ctg-body">
    <div class="ctg-rail zt-rail">
  {/* Controls */}
  <div class="ctg-controls">
    {/* Direction */}
    <div class="ctg-field ctg-field--dir">
      <div class="ctg-field-header"><label class="ctg-label">{L.direction}</label><Toggletip id="ctg-tip-direction" lang={lang} about={L.direction}>{L.tips.direction}</Toggletip></div>
      <div class="ctg-dir-grid">
        <button class="ctg-dir-btn" data-dir="top-left" type="button" title={L.topLeft}>◤</button>
        <button class="ctg-dir-btn ctg-dir-btn--active" data-dir="top" type="button" title={L.top}>▲</button>
        <button class="ctg-dir-btn" data-dir="top-right" type="button" title={L.topRight}>◥</button>
        <button class="ctg-dir-btn" data-dir="left" type="button" title={L.left}>◀</button>
        <div class="ctg-dir-center"></div>
        <button class="ctg-dir-btn" data-dir="right" type="button" title={L.right}>▶</button>
        <button class="ctg-dir-btn" data-dir="bottom-left" type="button" title={L.bottomLeft}>◣</button>
        <button class="ctg-dir-btn" data-dir="bottom" type="button" title={L.bottom}>▼</button>
        <button class="ctg-dir-btn" data-dir="bottom-right" type="button" title={L.bottomRight}>◢</button>
      </div>
    </div>

    <div class="ctg-fields-right">
      {/* Width */}
      <div class="ctg-field">
        <div class="ctg-field-header"><label class="ctg-label" for="ctg-width">{L.width}</label><Toggletip id="ctg-tip-width" lang={lang} about={L.width}>{L.tips.width}</Toggletip></div>
        <input id="ctg-width" class="ctg-num-input" type="number" min="1" max="500" value="100" />
      </div>
      {/* Height */}
      <div class="ctg-field">
        <div class="ctg-field-header"><label class="ctg-label" for="ctg-height">{L.height}</label><Toggletip id="ctg-tip-height" lang={lang} about={L.height}>{L.tips.height}</Toggletip></div>
        <input id="ctg-height" class="ctg-num-input" type="number" min="1" max="500" value="100" />
      </div>
      {/* Color */}
      <div class="ctg-field">
        <div class="ctg-field-header"><label id="ctg-color-label" class="ctg-label" for="ctg-hex">{L.color}</label><Toggletip id="ctg-tip-color" lang={lang} about={L.color}>{L.tips.color}</Toggletip></div>
        <div class="ctg-color-row">
          <input id="ctg-picker" class="ctg-color-picker" type="color" value="#3b82f6" aria-labelledby="ctg-color-label" />
          <input id="ctg-hex" class="ctg-hex-input" type="text" value="#3b82f6" maxlength="7" spellcheck="false" autocomplete="off" />
        </div>
      </div>
    </div>
  </div>

  {/* CSS Output */}
  <div class="ctg-section">
    <div class="ctg-output-header">
      <div class="ctg-field-header"><span class="ctg-section-label">{L.outputLabel}</span><Toggletip id="ctg-tip-css" lang={lang} about={L.outputLabel}>{L.tips.css}</Toggletip></div>
      <button id="ctg-copy-css" class="btn-copy" type="button" aria-label={L.copy}>{L.copy}</button>
    </div>
    <p id="ctg-status" class="tool-status" role="status"></p>
    <pre id="ctg-pre-css" class="ctg-pre" tabindex="0" role="region" aria-label={L.outputLabel}><code id="ctg-code-css" class="ctg-code"></code></pre>
  </div>

  {/* HTML Usage */}
  <details class="ctg-section ctg-html-details">
    <summary>{L.details}</summary>
    <div class="ctg-output-header">
      <div class="ctg-field-header"><span class="ctg-section-label">{L.htmlLabel}</span><Toggletip id="ctg-tip-html" lang={lang} about={L.htmlLabel}>{L.tips.html}</Toggletip></div>
      <button id="ctg-copy-html" class="btn-copy" type="button" aria-label={L.copy}>{L.copy}</button>
    </div>
    <pre class="ctg-pre" tabindex="0" role="region" aria-label={L.htmlLabel}><code id="ctg-code-html" class="ctg-code">&lt;div class="triangle"&gt;&lt;/div&gt;</code></pre>
  </details>

    </div>
  {/* Preview */}
  <div id="ctg-preview-section" class="ctg-section ctg-preview-section">
    <div class="ctg-section-label">{L.preview}</div>
    <div class="ctg-preview-wrap">
      <p class="ctg-empty">{L.empty}</p>
      <div id="ctg-preview" class="ctg-preview-el"></div>
    </div>
  </div>

  </div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.ctg-wrap')
        : document.querySelector('.ctg-wrap');

      var COPY_LABEL   = wrap.dataset.copy;
      var COPIED_LABEL = wrap.dataset.copied;
      var COPY_FAILED_LABEL = wrap.dataset.copyFailed;
      var BAD_WIDTH = wrap.dataset.badWidth;
      var BAD_HEIGHT = wrap.dataset.badHeight;
      var MAX_SIZE = 500;
      var sizeError = '';

      var widthEl   = document.getElementById('ctg-width');
      var heightEl  = document.getElementById('ctg-height');
      var pickerEl  = document.getElementById('ctg-picker');
      var hexEl     = document.getElementById('ctg-hex');
      var previewEl = document.getElementById('ctg-preview');
      var codeCssEl = document.getElementById('ctg-code-css');
      var copyCssBtn  = document.getElementById('ctg-copy-css');
      var copyHtmlBtn = document.getElementById('ctg-copy-html');

      var currentDir = 'top';

      /* Direction buttons */
      var dirBtns = wrap.querySelectorAll('.ctg-dir-btn');
      dirBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          dirBtns.forEach(function (b) { b.classList.remove('ctg-dir-btn--active'); });
          btn.classList.add('ctg-dir-btn--active');
          currentDir = btn.dataset.dir;
          render();
        });
      });

      /* Color sync */
      pickerEl.addEventListener('input', function () {
        hexEl.value = pickerEl.value;
        render();
      });
      hexEl.addEventListener('input', function () {
        invalidateCopies();
        var v = hexEl.value.trim();
        if (/^#[0-9a-fA-F]{6}$/.test(v)) {
          pickerEl.value = v;
          render();
        }
      });

      widthEl.addEventListener('input', render);
      heightEl.addEventListener('input', render);

      /* ── engine:start ── */
      // The two transparent borders add up to the full width (or height): an odd size is split
      // into floor and ceil halves, so width 25 gives 12px + 13px and the apex sits 0.5px off
      // centre. Fractional halves (12.5px) would not help: browsers floor border widths to whole
      // device pixels (CSS Backgrounds 3, "snap as a border width").
      function computeBorders(dir, w, h, color) {
        var half_w = Math.floor(w / 2), rest_w = w - half_w;
        var half_h = Math.floor(h / 2), rest_h = h - half_h;
        switch (dir) {
          case 'top':
            return [
              'border-left: ' + half_w + 'px solid transparent',
              'border-right: ' + rest_w + 'px solid transparent',
              'border-bottom: ' + h + 'px solid ' + color,
            ];
          case 'bottom':
            return [
              'border-left: ' + half_w + 'px solid transparent',
              'border-right: ' + rest_w + 'px solid transparent',
              'border-top: ' + h + 'px solid ' + color,
            ];
          case 'left':
            return [
              'border-top: ' + half_h + 'px solid transparent',
              'border-bottom: ' + rest_h + 'px solid transparent',
              'border-right: ' + w + 'px solid ' + color,
            ];
          case 'right':
            return [
              'border-top: ' + half_h + 'px solid transparent',
              'border-bottom: ' + rest_h + 'px solid transparent',
              'border-left: ' + w + 'px solid ' + color,
            ];
          case 'top-left':
            return [
              'border-top: ' + h + 'px solid ' + color,
              'border-right: ' + w + 'px solid transparent',
            ];
          case 'top-right':
            return [
              'border-top: ' + h + 'px solid ' + color,
              'border-left: ' + w + 'px solid transparent',
            ];
          case 'bottom-left':
            return [
              'border-bottom: ' + h + 'px solid ' + color,
              'border-right: ' + w + 'px solid transparent',
            ];
          case 'bottom-right':
            return [
              'border-bottom: ' + h + 'px solid ' + color,
              'border-left: ' + w + 'px solid transparent',
            ];
          default:
            return [];
        }
      }
      /* ── engine:end ── */

      /* Width and height: whole numbers from 1 to MAX_SIZE (the inputs' min and max). */
      function readSize(el) {
        var v = String(el.value).trim();
        if (!/^\d+$/.test(v)) return null;
        var n = Number(v);
        return n >= 1 && n <= MAX_SIZE ? n : null;
      }

      function update(w, h) {
        var color = pickerEl.value;
        var borders = computeBorders(currentDir, w, h, color);

        /* Apply to preview */
        previewEl.style.width  = '0';
        previewEl.style.height = '0';
        previewEl.style.borderTop    = '';
        previewEl.style.borderBottom = '';
        previewEl.style.borderLeft   = '';
        previewEl.style.borderRight  = '';
        borders.forEach(function (rule) {
          var parts = rule.split(':');
          var prop  = parts[0].trim();
          var val   = parts.slice(1).join(':').trim();
          var camel = prop.replace(/-([a-z])/g, function (_, c) { return c.toUpperCase(); });
          previewEl.style[camel] = val;
        });

        /* Build CSS text */
        var lines = ['.triangle {'];
        lines.push('  width: 0;');
        lines.push('  height: 0;');
        borders.forEach(function (b) { lines.push('  ' + b + ';'); });
        lines.push('}');
        var raw = lines.join('\n');

        var highlighted = raw
          .replace(/(\{|\})/g,         '<span class="ctg-hl-brace">$1</span>')
          .replace(/(\.triangle)/g,     '<span class="ctg-hl-sel">$1</span>')
          .replace(/([\w-]+)(\s*:)/g,   '<span class="ctg-hl-prop">$1</span>$2')
          .replace(/(:)(\s*)([^;{}\n]+)(;)/g, '$1$2<span class="ctg-hl-val">$3</span><span class="ctg-hl-semi">$4</span>');
        codeCssEl.innerHTML = highlighted;

        window.trackTool && window.trackTool('css-triangle-generator', 'generate');
      }

      var copyRevision = 0;
      var copyStates = [];
      var statusEl = document.getElementById('ctg-status');

      function invalidateCopies() {
        copyRevision++;
        copyStates.forEach(function (state) {
          clearTimeout(state.timer);
          state.timer = 0;
          state.btn.textContent = COPY_LABEL;
          state.btn.setAttribute('aria-label', COPY_LABEL);
        });
        if (statusEl && !sizeError) { statusEl.textContent = ''; statusEl.className = 'tool-status'; }
      }

      function clearResult() {
        codeCssEl.textContent = '';
        previewEl.style.borderTop = '';
        previewEl.style.borderBottom = '';
        previewEl.style.borderLeft = '';
        previewEl.style.borderRight = '';
        previewEl.hidden = true;
        copyCssBtn.disabled = true;
        wrap.dataset.empty = 'true';
      }

      function render() {
        sizeError = '';
        invalidateCopies();
        var w = readSize(widthEl), h = readSize(heightEl);
        if (w === null || h === null) {
          clearResult();
          sizeError = w === null ? BAD_WIDTH : BAD_HEIGHT;
          statusEl.textContent = sizeError;
          statusEl.className = 'tool-status error';
          return;
        }
        update(w, h);
        copyCssBtn.disabled = false;
        previewEl.hidden = false;
        wrap.dataset.empty = 'false';
      }

      function makeCopyHandler(btn, getTextFn) {
        var state = { btn: btn, timer: 0 };
        copyStates.push(state);
        btn.addEventListener('click', function () {
          var text = getTextFn();
          if (!text) return;
          invalidateCopies();
          var request = copyRevision;
          function failed() {
            if (request !== copyRevision) return;
            btn.textContent = COPY_FAILED_LABEL;
            btn.setAttribute('aria-label', COPY_FAILED_LABEL);
            if (statusEl) statusEl.textContent = COPY_FAILED_LABEL;
          }
          if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
            failed();
            return;
          }
          try {
            Promise.resolve(navigator.clipboard.writeText(text)).then(function () {
              if (request !== copyRevision) return;
              btn.textContent = COPIED_LABEL;
              btn.setAttribute('aria-label', COPIED_LABEL);
              state.timer = setTimeout(function () {
                if (request !== copyRevision) return;
                btn.textContent = COPY_LABEL;
                btn.setAttribute('aria-label', COPY_LABEL);
                state.timer = 0;
              }, 1500);
            }, failed);
          } catch (_) { failed(); }
        });
      }

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l' || !wrap.contains(document.activeElement)) return;
        wrap.querySelectorAll('input[type="text"]').forEach(function (input) { input.value = ''; });
        sizeError = '';
        invalidateCopies();
        clearResult();
      });

      makeCopyHandler(copyCssBtn, function () { return codeCssEl.textContent; });
      makeCopyHandler(copyHtmlBtn, function () { return '<div class="triangle"></div>'; });

      render();
    })();
  </script>
</div>

<style>
  .ctg-wrap { display: flex; flex-direction: column; gap: 1.25rem; }

  .ctg-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-start;
  }

  .ctg-field { display: flex; flex-direction: column; gap: 0.3rem; }
  .ctg-field--dir { flex-shrink: 0; }

  .ctg-fields-right {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    flex: 1;
    align-items: flex-start;
  }

  .ctg-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .ctg-num-input,
  .ctg-hex-input {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    width: 100px;
    box-sizing: border-box;
  }

  .ctg-num-input:focus,
  .ctg-hex-input:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  /* Direction grid */
  .ctg-dir-grid {
    display: grid;
    grid-template-columns: repeat(3, 36px);
    grid-template-rows: repeat(3, 36px);
    gap: 3px;
  }

  .ctg-dir-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
