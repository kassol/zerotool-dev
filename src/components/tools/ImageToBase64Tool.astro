---
// ImageToBase64Tool — image file → Base64 / data URI / CSS / HTML / Markdown, and
// Base64 or data URI → image. The type comes from the file signature, not the name.
// Everything runs in the browser; nothing is uploaded or stored.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

