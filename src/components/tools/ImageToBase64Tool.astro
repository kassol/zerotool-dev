  .i2b-panel[hidden], .i2b-result[hidden], .i2b-drop[hidden], .i2b-dec-result[hidden] { display: none; }
  /* The script sets hidden on the two direction panels, the drop zone and the two
     results only; the toolbar buttons, the file preview and the empty hints follow. */
