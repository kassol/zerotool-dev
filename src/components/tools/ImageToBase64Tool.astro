  .i2b-wrap:has(> #i2b-dec[hidden]) .i2b-for-dec,
  .i2b-wrap:has(#i2b-result[hidden]) .i2b-loaded,
  .i2b-wrap:has(#i2b-dec-result[hidden]) .i2b-dec-loaded,
  .i2b-result:not([hidden]) ~ .i2b-empty,
  .i2b-dec-result:not([hidden]) ~ .i2b-empty { display: none; }

  .i2b-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .i2b-toolbar-end { display: inline-flex; gap: 0.4rem; margin-left: auto; }
  .i2b-modes { display: inline-flex; gap: 0; border: 1px solid var(--color-border); border-radius: var(--radius-pill); padding: 3px; background: var(--color-bg-secondary); }
  .i2b-mode {
    border: 0; background: transparent; color: var(--color-text-secondary); font: inherit; font-size: 0.85rem; font-weight: 650;
    padding: 0.35rem 0.9rem; border-radius: var(--radius-pill); cursor: pointer; min-height: 32px; white-space: nowrap;
  }
  .i2b-mode.active { background: var(--color-surface); color: var(--color-text); box-shadow: var(--shadow-subtle); }
  .i2b-mode:focus-visible, .i2b-fmt:focus-visible, .i2b-enc:focus-visible, .i2b-drop:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

  .i2b-status { margin: 0; overflow-wrap: anywhere; }
