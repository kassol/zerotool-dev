    font-size: 0.8rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: var(--radius-pill); cursor: pointer; min-height: 28px;
  }
  .i2b-fmt.active, .i2b-enc.active { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-primary-contrast); }
