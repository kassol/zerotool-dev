            thumb.src = thumbUrl;
            drop.hidden = true;
            result.hidden = false;
            setStatus('');
            render();
            window.trackTool && window.trackTool('image_to_base64', 'encode');
          });
        }).catch(function () {
          if (my !== job) return;
          setStatus(t.readFailed, 'error');
        });
      }

      function updateInfo(w, h) {
        if (!state) return;
        var parts = [state.det.name];
        if (w > 0 && h > 0) parts.push(fill(t.dims, { w: w, h: h }));
        parts.push(fill(t.sizeLine, {
          bytes: plural(t.bytes, state.size, pageLang),
          chars: plural(t.chars, state.base64.length, pageLang),
          pct: growthPercent(state.size, state.base64.length)
        }));
        infoEl.textContent = parts.join(' \u00b7 ');
      }

      function setMode(mode) {
        modeBtns.forEach(function (b) { var on = b.dataset.mode === mode; b.classList.toggle('active', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        encPanel.hidden = mode !== 'encode';
        decPanel.hidden = mode !== 'decode';
        setStatus('');
        base64Link.hidden = true;
      }

      modeBtns.forEach(function (b) { b.addEventListener('click', function () { setMode(b.dataset.mode); }); });

      drop.addEventListener('click', function () { fileInput.click(); });
      drop.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
      });
      fileInput.addEventListener('change', function () { if (this.files && this.files[0]) handleFile(this.files[0]); });
      $('i2b-another').addEventListener('click', function () { fileInput.value = ''; fileInput.click(); });
      $('i2b-clear').addEventListener('click', resetEncode);

      function hasFiles(e) {
        return e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types || [], 'Files') >= 0;
      }
      wrap.addEventListener('dragover', function (e) {
        if (!hasFiles(e)) return;
        e.preventDefault();
        drop.classList.add('drag-over');
      });
      wrap.addEventListener('dragleave', function (e) {
        if (!wrap.contains(e.relatedTarget)) drop.classList.remove('drag-over');
      });
      wrap.addEventListener('drop', function (e) {
        if (!hasFiles(e)) return;
        e.preventDefault();
        drop.classList.remove('drag-over');
        var file = e.dataTransfer.files[0];
        if (file) { setMode('encode'); handleFile(file); }
      });

      document.addEventListener('paste', function (e) {
        if (encPanel.hidden) return;
        var items = (e.clipboardData && e.clipboardData.files) || [];
        for (var i = 0; i < items.length; i++) {
          var f = items[i];
          if (f && (f.type.indexOf('image/') === 0 || !f.type)) {
            e.preventDefault();
            var name = f.name && f.name !== 'image.png' ? f.name : t.pastedName + '.' + (EXT_TYPES[extOf(f.name)] ? extOf(f.name) : 'png');
            handleFile(new File([f], name, { type: f.type }));
            return;
          }
        }
      });

      fmtBtns.forEach(function (b) { b.addEventListener('click', function () { fmt = b.dataset.fmt; render(); }); });
      encBtns.forEach(function (b) { b.addEventListener('click', function () { if (state) { state.enc = b.dataset.enc; render(); } }); });

      copyBtn.addEventListener('click', function () {
        var text = state ? state.text : '';
        if (!text) return;
        var done = function () {
          copyBtn.textContent = t.copied;
          setTimeout(function () { copyBtn.textContent = t.copy; }, 1500);
        };
        var fallback = function () {
          if (output.hidden) { setStatus(t.copyFailedLong, 'error'); return; }
          output.focus();
          output.select();
          var ok = false;
          try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
          if (ok) done(); else setStatus(t.copyFailed, 'error');
        };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fallback);
        else fallback();
      });

      dlTxt.addEventListener('click', function () {
        if (!state) return;
        var url = URL.createObjectURL(new Blob([state.text], { type: 'text/plain' }));
        var a = document.createElement('a');
        a.href = url;
        a.download = altFromName(state.fileName || 'image') + '.' + fmt + '.txt';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      });

      /* ── Decode ── */
      function resetDecode(keepInput) {
        if (decUrl) { URL.revokeObjectURL(decUrl); decUrl = ''; }
        decImg.removeAttribute('src');
        setNotes(decNotes, []);
        decResult.hidden = true;
        if (!keepInput) decIn.value = '';
        setStatus('');
        base64Link.hidden = true;
      }

      $('i2b-decode').addEventListener('click', function () {
        if (decPanel.hidden) return;
        resetDecode(true);
        var parsed = parseDecodeInput(decIn.value);
        if (parsed.error) {
          var msg = {
            empty: t.decEmpty,
            badChar: fill(t.decBadChar, { pos: parsed.pos, ch: parsed.ch }),
            padMiddle: fill(t.decPadMiddle, { pos: parsed.pos }),
            badLength: fill(t.decBadLength, { n: parsed.n }),
            badPercent: fill(t.decBadPercent, { pos: parsed.pos })
          }[parsed.error];
          setStatus(msg, 'error');
          return;
        }
        var info = inspectDecoded(parsed);
        if (info.error) {
          setStatus(fill(t.decNotImage, { bytes: plural(t.bytes, info.size, pageLang), hex: info.hex || '\u2014' }), 'error');
          base64Link.hidden = false;
          return;
        }
        var notes = [];
        parsed.notes.forEach(function (n) { notes.push({ urlSafe: t.decUrlSafe, extracted: t.decExtracted, jsonSlash: t.decJsonSlash }[n]); });
        if (info.declaredMismatch) notes.push(fill(t.decDeclared, { declared: info.declaredMismatch, type: info.name, ext: info.ext }));
        var blob = new Blob([parsed.bytes], { type: info.mime });
        decUrl = URL.createObjectURL(blob);
        var file = 'image.' + info.ext;
        decDownload.href = decUrl;
        decDownload.download = file;
        decDownload.textContent = fill(t.download, { file: file });
        var base = fill(t.decResult, { type: info.name, dims: '\u2026', bytes: plural(t.bytes, info.size, pageLang) });
        decInfo.textContent = base.replace(' \u00b7 \u2026', '');
        decImg.onload = function () {
          decInfo.textContent = fill(t.decResult, { type: info.name, dims: fill(t.dims, { w: decImg.naturalWidth, h: decImg.naturalHeight }), bytes: plural(t.bytes, info.size, pageLang) });
        };
        decImg.onerror = function () {
          var where = info.key.indexOf('hei') === 0 ? t.whereHeic : info.key === 'tiff' ? t.whereTiff : '';
          setNotes(decNotes, notes.concat([fill(t.noPreview, { type: info.name, where: where })]));
        };
        setNotes(decNotes, notes);
        decImg.src = decUrl;
        decResult.hidden = false;
        window.trackTool && window.trackTool('image_to_base64', 'decode');
      });

      $('i2b-dec-clear').addEventListener('click', function () { resetDecode(false); });

      // The site-wide Ctrl/Cmd+L empties text fields; drop the whole state with it.
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
          resetEncode();
          resetDecode(false);
        }
      });
    })();
  </script>
</div>

