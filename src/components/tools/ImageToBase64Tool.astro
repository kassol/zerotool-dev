      image: '이미지를 도구 영역 어디에나 끌어다 놓거나, Ctrl+V(Mac은 \u2318V)로 붙여넣거나, 점선 상자를 클릭해 파일을 고릅니다. 한 번에 파일 하나, 최대 100MB입니다. 형식은 파일 이름이 아니라 파일 앞부분의 바이트로 판별하며, 둘이 다르면 안내가 나옵니다.',
      output: 'Data URI는 형식을 앞에 붙인 Base64로, img의 src나 CSS의 url()에 바로 쓸 수 있습니다. Base64는 인코딩한 문자열만입니다. CSS는 background-image 선언입니다. HTML <img>에는 픽셀 너비와 높이가 붙고(SVG 제외) alt는 파일 이름에서 가져오며, Markdown의 대체 텍스트도 파일 이름에서 가져옵니다. 200만 자가 넘는 출력은 칸에 표시하지 않지만, 복사로는 전체 텍스트를 받고 .txt 저장으로 저장할 수 있습니다.',
      svg: 'URL 인코딩은 영문자, 숫자, 공백, 대부분의 문장 부호를 그대로 두고 나머지(< > # %와 큰따옴표 등)를 %XX로 씁니다. Base64는 파일 크기의 4/3입니다. 버튼의 숫자는 해당 Data URI의 길이이며, 파일을 열면 더 짧은 쪽이 선택됩니다. 출력 형식이 Base64일 때는 항상 Base64입니다.',
      decIn: 'Base64만, Data URI, 또는 Data URI가 들어 있는 텍스트(CSS 규칙, <img> 태그, Markdown 이미지, JSON)를 붙여넣습니다. 줄바꿈, URL 안전 문자(-와 _), 끝의 = 누락도 읽습니다. 그다음 디코딩을 누르거나 Ctrl+Enter(Mac은 \u2318+Enter)를 누릅니다. 이 방향은 입력하는 동안에는 실행되지 않습니다.',
      decOut: '이미지 형식과 저장 파일의 확장자는 Data URI에 적힌 형식이 아니라 디코딩한 바이트로 판별하며, 둘이 다르면 안내가 나옵니다. 이미지 형식만 인식합니다. 미리보기는 이 브라우저의 디코더를 쓰므로 HEIC는 Safari 17 이상, TIFF는 Safari에서만 보이지만 저장한 파일은 완전합니다.',
    },
  },
} as const;

const T = STRINGS[lang];
// The script gets every string except the toggletip text, which is in the HTML.
const { tips: TIPS, ...CLIENT_T } = T;
const base64Href = (lang === 'en' ? '' : '/' + lang) + '/tools/base64/';
---

<div class="i2b-wrap" id="i2b-wrap">
  <div class="i2b-toolbar">
    <div class="i2b-modes" role="group" aria-label={T.modeAria}>
      <button type="button" class="i2b-mode active" data-mode="encode" aria-pressed="true">{T.modeEncode}</button>
      <button type="button" class="i2b-mode" data-mode="decode" aria-pressed="false">{T.modeDecode}</button>
    </div>
    <button id="i2b-decode" class="btn-primary i2b-for-dec" type="button">{T.decode}</button>
    <span class="i2b-toolbar-end">
      <button id="i2b-another" class="btn-secondary i2b-for-enc i2b-loaded" type="button">{T.chooseAnother}</button>
      <button id="i2b-clear" class="btn-ghost i2b-for-enc i2b-loaded" type="button">{T.clear}</button>
      <button id="i2b-dec-clear" class="btn-ghost i2b-for-dec" type="button">{T.clear}</button>
    </span>
  </div>

  <p id="i2b-status" class="tool-status i2b-status" aria-live="polite"></p>
  <p id="i2b-base64-link" class="i2b-base64-link" hidden><a href={base64Href}>{T.base64Tool} &rarr;</a></p>

  <section id="i2b-enc" class="i2b-panel zt-io">
    <div class="i2b-pane zt-io-pane">
      <div class="i2b-head">
        <span class="i2b-label">{T.imgLabel}</span>
        <Toggletip id="i2b-tip-image" lang={lang} about={T.imgLabel} wide>{TIPS.image}</Toggletip>
      </div>
      <div id="i2b-drop" class="i2b-drop zt-io-fill" role="button" tabindex="0" aria-label={T.dropAria}>
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
        </svg>
        <p class="i2b-drop-title">{T.dropTitle}</p>
        <p class="i2b-drop-hint">{T.dropHint}</p>
      </div>
      <input type="file" id="i2b-file" class="i2b-file-input" accept="image/*,.svg,.ico,.cur,.bmp,.tif,.tiff,.heic,.heif,.avif,.jxl" tabindex="-1" aria-hidden="true" />
      <div class="i2b-fileline i2b-loaded zt-io-fill">
        <span class="i2b-thumb"><img id="i2b-thumb" alt="" /></span>
        <div class="i2b-meta">
          <strong id="i2b-name" class="i2b-name"></strong>
          <span id="i2b-info" class="i2b-info"></span>
        </div>
      </div>
    </div>

    <div class="i2b-pane i2b-pane--out zt-io-pane">
      <div class="i2b-head">
        <label for="i2b-output" id="i2b-out-label" class="i2b-label">{T.fmtDataUri}</label>
        <Toggletip id="i2b-tip-output" lang={lang} about={T.formatLabel} wide>{TIPS.output}</Toggletip>
        <span id="i2b-out-len" class="i2b-out-len i2b-loaded"></span>
        <span class="i2b-head-end i2b-loaded">
          <button id="i2b-download-txt" class="btn-secondary btn-sm" type="button" hidden>{T.downloadTxt}</button>
          <button id="i2b-copy" class="btn-copy" type="button">{T.copy}</button>
        </span>
      </div>
      <div id="i2b-result" class="i2b-result zt-io-fill" hidden>
        <div class="i2b-optrow">
          <div class="i2b-seg" role="group" aria-labelledby="i2b-fmt-label">
            <span class="i2b-seg-label i2b-fmt-label" id="i2b-fmt-label">{T.formatLabel}</span>
            <button type="button" class="i2b-fmt active" data-fmt="datauri" aria-pressed="true">{T.fmtDataUri}</button>
            <button type="button" class="i2b-fmt" data-fmt="base64" aria-pressed="false">{T.fmtBase64}</button>
            <button type="button" class="i2b-fmt" data-fmt="css" aria-pressed="false">{T.fmtCss}</button>
            <button type="button" class="i2b-fmt" data-fmt="html" aria-pressed="false">{T.fmtHtml}</button>
            <button type="button" class="i2b-fmt" data-fmt="markdown" aria-pressed="false">{T.fmtMarkdown}</button>
          </div>
          <div id="i2b-svgenc" class="i2b-seg" role="group" aria-labelledby="i2b-svg-label" hidden>
            <span class="i2b-seg-label" id="i2b-svg-label">{T.svgEncLabel}</span>
            <button type="button" class="i2b-enc" data-enc="base64" aria-pressed="false">{T.svgBase64} <span class="i2b-enc-len" data-len="base64"></span></button>
            <button type="button" class="i2b-enc" data-enc="url" aria-pressed="false">{T.svgUrl} <span class="i2b-enc-len" data-len="url"></span></button>
            <Toggletip id="i2b-tip-svg" lang={lang} about={T.svgEncLabel} wide>{TIPS.svg}</Toggletip>
          </div>
        </div>
        <textarea id="i2b-output" class="tool-textarea i2b-output" readonly spellcheck="false"></textarea>
        <p id="i2b-toolong" class="i2b-toolong" hidden></p>
        <ul id="i2b-notes" class="i2b-notes" hidden></ul>
      </div>
      <p class="i2b-empty zt-io-fill"><span>{T.outEmpty}</span></p>
    </div>
  </section>

  <section id="i2b-dec" class="i2b-panel zt-io" hidden>
    <div class="i2b-pane zt-io-pane">
      <div class="i2b-head">
        <label for="i2b-dec-in" class="i2b-label">{T.decLabel}</label>
        <Toggletip id="i2b-tip-decin" lang={lang} about={T.decLabel} wide>{TIPS.decIn}</Toggletip>
      </div>
      <textarea id="i2b-dec-in" class="tool-textarea i2b-dec-in zt-io-fill" spellcheck="false" placeholder={T.decPh}></textarea>
    </div>

    <div class="i2b-pane i2b-pane--out zt-io-pane">
      <div class="i2b-head">
        <span class="i2b-label">{T.imgLabel}</span>
        <Toggletip id="i2b-tip-decout" lang={lang} about={T.imgLabel} wide>{TIPS.decOut}</Toggletip>
        <span id="i2b-dec-info" class="i2b-info i2b-dec-loaded"></span>
        <span class="i2b-head-end i2b-dec-loaded">
          <a id="i2b-dec-download" class="btn-secondary btn-sm" href="#" download></a>
        </span>
      </div>
      <div id="i2b-dec-result" class="i2b-dec-result zt-io-fill" hidden>
        <img id="i2b-dec-img" class="i2b-dec-img" alt={T.previewAlt} />
        <ul id="i2b-dec-notes" class="i2b-notes" hidden></ul>
      </div>
      <p class="i2b-empty zt-io-fill"><span>{T.decOutEmpty}</span></p>
    </div>
  </section>
</div>

  <script is:inline define:vars={{ t: CLIENT_T, pageLang: lang }}>
    (function () {
      /* ── engine:start ── */
      var FILE_LIMIT = 100 * 1024 * 1024;
      var DISPLAY_LIMIT = 2000000;

      var TYPES = {
        png: { mime: 'image/png', ext: 'png', name: 'PNG' },
        jpeg: { mime: 'image/jpeg', ext: 'jpg', name: 'JPEG' },
        gif: { mime: 'image/gif', ext: 'gif', name: 'GIF' },
        webp: { mime: 'image/webp', ext: 'webp', name: 'WebP' },
        avif: { mime: 'image/avif', ext: 'avif', name: 'AVIF' },
        heic: { mime: 'image/heic', ext: 'heic', name: 'HEIC' },
        heicseq: { mime: 'image/heic-sequence', ext: 'heic', name: 'HEIC' },
        heif: { mime: 'image/heif', ext: 'heif', name: 'HEIF' },
        heifseq: { mime: 'image/heif-sequence', ext: 'heif', name: 'HEIF' },
        svg: { mime: 'image/svg+xml', ext: 'svg', name: 'SVG' },
        ico: { mime: 'image/x-icon', ext: 'ico', name: 'ICO' },
        cur: { mime: 'image/x-icon', ext: 'cur', name: 'CUR' },
        bmp: { mime: 'image/bmp', ext: 'bmp', name: 'BMP' },
        tiff: { mime: 'image/tiff', ext: 'tiff', name: 'TIFF' },
        jxl: { mime: 'image/jxl', ext: 'jxl', name: 'JPEG XL' }
      };

      var EXT_TYPES = {
        png: 'png', apng: 'png', jpg: 'jpeg', jpeg: 'jpeg', jpe: 'jpeg', jfif: 'jpeg', pjpeg: 'jpeg', pjp: 'jpeg',
        gif: 'gif', webp: 'webp', avif: 'avif', heic: 'heic', heif: 'heif', hif: 'heif', svg: 'svg',
        ico: 'ico', cur: 'cur', bmp: 'bmp', dib: 'bmp', tif: 'tiff', tiff: 'tiff', jxl: 'jxl'
      };

      var MIME_TYPES = {
        'image/png': 'png', 'image/apng': 'png', 'image/jpeg': 'jpeg', 'image/jpg': 'jpeg', 'image/pjpeg': 'jpeg',
        'image/gif': 'gif', 'image/webp': 'webp', 'image/avif': 'avif', 'image/heic': 'heic',
        'image/heic-sequence': 'heicseq', 'image/heif': 'heif', 'image/heif-sequence': 'heifseq',
        'image/svg+xml': 'svg', 'image/x-icon': 'ico', 'image/vnd.microsoft.icon': 'ico', 'image/bmp': 'bmp',
        'image/x-ms-bmp': 'bmp', 'image/tiff': 'tiff', 'image/jxl': 'jxl'
      };

      function startsWith(bytes, sig, offset) {
        offset = offset || 0;
        if (bytes.length < offset + sig.length) return false;
        for (var i = 0; i < sig.length; i++) {
          if (sig[i] !== null && bytes[offset + i] !== sig[i]) return false;
        }
        return true;
      }

      function ascii(bytes, from, to) {
        var s = '';
        for (var i = from; i < to && i < bytes.length; i++) s += String.fromCharCode(bytes[i]);
        return s;
      }

      // ISO BMFF 'ftyp' box: major brand at 8, compatible brands from 16 to the box end
      // (HEIF: ISO/IEC 23008-12; AVIF: AV1 Image File Format, brands avif / avis).
      function sniffFtyp(bytes) {
        if (bytes.length < 16 || ascii(bytes, 4, 8) !== 'ftyp') return null;
        var size = ((bytes[0] << 24) >>> 0) + (bytes[1] << 16) + (bytes[2] << 8) + bytes[3];
        var end = Math.min(bytes.length, Math.max(16, size));
        var brands = [ascii(bytes, 8, 12)];
        for (var p = 16; p + 4 <= end; p += 4) brands.push(ascii(bytes, p, p + 4));
        var order = [
          ['avif', 'avif'], ['avis', 'avif'],
          ['heic', 'heic'], ['heix', 'heic'], ['heim', 'heic'], ['heis', 'heic'],
          ['hevc', 'heicseq'], ['hevx', 'heicseq'], ['hevm', 'heicseq'], ['hevs', 'heicseq'],
          ['mif1', 'heif'], ['msf1', 'heifseq']
        ];
        if (brands[0] === 'avif' || brands[0] === 'avis') return 'avif';
        for (var i = 0; i < order.length; i++) {
          if (brands[0] === order[i][0]) {
            if (order[i][1] === 'heif' || order[i][1] === 'heifseq') {
              if (brands.indexOf('avif') > 0 || brands.indexOf('avis') > 0) return 'avif';
            }
            return order[i][1];
          }
        }
        for (var j = 0; j < order.length; j++) {
          if (brands.indexOf(order[j][0], 1) > 0) return order[j][1];
        }
        return null;
      }

      // SVG has no magic number: skip a BOM, whitespace, the XML declaration,
      // comments, processing instructions and a DOCTYPE, then expect <svg.
      function looksLikeSvg(bytes) {
        var s = ascii(bytes, 0, Math.min(bytes.length, 8192));
        var i = 0;
        if (s.charCodeAt(0) === 0xEF && s.charCodeAt(1) === 0xBB && s.charCodeAt(2) === 0xBF) i = 3;
        for (var guard = 0; guard < 64; guard++) {
          while (i < s.length && /\s/.test(s[i])) i++;
          if (s.substr(i, 2) === '<?') {
            var e = s.indexOf('?>', i + 2); if (e < 0) return false; i = e + 2; continue;
          }
          if (s.substr(i, 4) === '<!--') {
            var c = s.indexOf('-->', i + 4); if (c < 0) return false; i = c + 3; continue;
          }
          if (s.substr(i, 9).toUpperCase() === '<!DOCTYPE') {
            var depth = 0, q = '';
            for (i += 9; i < s.length; i++) {
              var ch = s[i];
              if (q) { if (ch === q) q = ''; continue; }
              if (ch === '"' || ch === "'") q = ch;
              else if (ch === '[') depth++;
              else if (ch === ']') depth--;
              else if (ch === '>' && depth <= 0) { i++; break; }
            }
            continue;
          }
          break;
        }
        return /^<svg[\s>\/]/.test(s.substr(i, 5)) || /^<svg:svg[\s>\/]/.test(s.substr(i, 9));
      }

      // Signatures follow WHATWG MIME Sniffing section 6.1 (image type pattern
      // matching) where it has one; ftyp is checked first because a 256-byte ftyp
      // box starts with 00 00 01 00, the ICO pattern.
      function sniffImage(bytes) {
        if (!bytes || !bytes.length) return null;
        var f = sniffFtyp(bytes);
        if (f) return f;
        if (startsWith(bytes, [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A])) return 'png';
        if (startsWith(bytes, [0xFF, 0xD8, 0xFF])) return 'jpeg';
        if (startsWith(bytes, [0x47, 0x49, 0x46, 0x38, 0x37, 0x61]) || startsWith(bytes, [0x47, 0x49, 0x46, 0x38, 0x39, 0x61])) return 'gif';
        if (startsWith(bytes, [0x52, 0x49, 0x46, 0x46, null, null, null, null, 0x57, 0x45, 0x42, 0x50, 0x56, 0x50])) return 'webp';
        if (startsWith(bytes, [0x00, 0x00, 0x00, 0x0C, 0x4A, 0x58, 0x4C, 0x20, 0x0D, 0x0A, 0x87, 0x0A]) || startsWith(bytes, [0xFF, 0x0A])) return 'jxl';
        if (startsWith(bytes, [0x49, 0x49, 0x2A, 0x00]) || startsWith(bytes, [0x4D, 0x4D, 0x00, 0x2A])) return 'tiff';
        if (startsWith(bytes, [0x00, 0x00, 0x01, 0x00])) return 'ico';
        if (startsWith(bytes, [0x00, 0x00, 0x02, 0x00])) return 'cur';
        if (startsWith(bytes, [0x42, 0x4D])) return 'bmp';
        if (looksLikeSvg(bytes)) return 'svg';
        return null;
      }

      function extOf(name) {
        var m = /\.([A-Za-z0-9]+)$/.exec(name || '');
        return m ? m[1].toLowerCase() : '';
      }

      function hexHead(bytes, n) {
        var out = [];
        for (var i = 0; i < Math.min(n || 8, bytes.length); i++) out.push((bytes[i] < 16 ? '0' : '') + bytes[i].toString(16).toUpperCase());
        return out.join(' ');
      }

      function sameFamily(a, b) {
        var fam = { heicseq: 'heic', heifseq: 'heic', heif: 'heic', cur: 'ico' };
        return (fam[a] || a) === (fam[b] || b);
      }

      // Type by content first. The name and the browser-reported type are only a
      // fallback, and a disagreeing extension is reported.
      function detectImage(bytes, name, reported) {
        var key = sniffImage(bytes);
        var ext = extOf(name);
        var extKey = EXT_TYPES[ext] || null;
        if (key) {
          var info = TYPES[key];
          return {
            key: key, mime: info.mime, ext: info.ext, name: info.name, source: 'signature',
            mismatch: extKey && !sameFamily(extKey, key) ? { ext: ext } : null
          };
        }
        var fallback = extKey || MIME_TYPES[(reported || '').toLowerCase()] || null;
        if (fallback) {
          var fi = TYPES[fallback];
          return { key: fallback, mime: fi.mime, ext: fi.ext, name: fi.name, source: 'name', mismatch: null };
        }
        return { error: 'notImage', hex: hexHead(bytes, 8) };
      }

      function base64Length(n) { return 4 * Math.ceil(n / 3); }

      // Data URI body without Base64 (RFC 2397). Bytes are escaped one by one, so the
      // file's own encoding is kept. Raw: letters, digits, space and -._~!$'()*+,;=:@/?
      // Escaped: " (HTML attribute and CSS string delimiter), # (starts a fragment),
      // % (escape), & (HTML character references), < > \ ^ ` { | } [ ], tab, CR, LF
      // (the URL parser deletes tabs and newlines), other controls, non-ASCII bytes,
      // and trailing spaces (the URL parser strips them).
      var URL_RAW = /[A-Za-z0-9\-._~!$'()*+,;=:@\/? ]/;
      function percentEncodeBytes(bytes) {
        var parts = [];
        var lastNonSpace = bytes.length - 1;
        while (lastNonSpace >= 0 && bytes[lastNonSpace] === 0x20) lastNonSpace--;
        var chunk = '';
        for (var i = 0; i < bytes.length; i++) {
          var b = bytes[i];
          var c = String.fromCharCode(b);
          if (b < 0x80 && URL_RAW.test(c) && !(b === 0x20 && i > lastNonSpace)) chunk += c;
          else chunk += '%' + (b < 16 ? '0' : '') + b.toString(16).toUpperCase();
          if (chunk.length > 8192) { parts.push(chunk); chunk = ''; }
        }
        parts.push(chunk);
        return parts.join('');
      }

      function escapeHtmlAttr(s) {
        return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function altFromName(name) {
        var stem = String(name || '').replace(/\.[A-Za-z0-9]+$/, '');
        return stem.replace(/[\u0000-\u001F\u007F]/g, '').trim();
      }

      // One string per output format. dataUri is the data URI in use (Base64, or
      // URL-encoded for SVG); base64 is always the Base64 of the file.
      function buildOutput(fmt, o) {
        var uri = o.dataUri;
        if (fmt === 'base64') return o.base64;
        if (fmt === 'css') return 'background-image: url("' + uri + '");';
        if (fmt === 'html') {
          var size = o.width > 0 && o.height > 0 ? ' width="' + o.width + '" height="' + o.height + '"' : '';
          return '<img src="' + uri + '"' + size + ' alt="' + escapeHtmlAttr(altFromName(o.name)) + '">';
        }
        if (fmt === 'markdown') {
          var alt = altFromName(o.name).replace(/([\\\[\]])/g, '\\$1');
          var dest = /[\s()<>]/.test(uri) ? '<' + uri + '>' : uri;
          return '![' + alt + '](' + dest + ')';
        }
        return uri;
      }

      function dataUriBase64(mime, base64) { return 'data:' + mime + ';base64,' + base64; }
      function dataUriSvg(bytes) { return 'data:image/svg+xml,' + percentEncodeBytes(bytes); }

      // Decode side. Accepts a data URI (alone, or inside CSS / HTML / Markdown /
      // JSON text) or bare Base64 with any whitespace; standard or URL-safe
      // alphabet; padding optional. Positions are 1-based code points of the input.
      var B64_VALUE = {};
      (function () {
        var abc = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
        for (var i = 0; i < abc.length; i++) B64_VALUE[abc[i]] = i;
        B64_VALUE['-'] = 62; B64_VALUE['_'] = 63;
      })();

      function codePointPos(text, index) {
        var n = 0;
        for (var i = 0; i < index; i++) {
          var c = text.charCodeAt(i);
          if (c >= 0xD800 && c <= 0xDBFF && i + 1 < index) i++;
          n++;
        }
        return n + 1;
      }

      function decodeBase64Body(text, start) {
        var clean = [];
        var urlSafe = false;
        var padFrom = -1;
