  .i2b-base64-link[hidden] { display: none; }

  .i2b-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.4rem; min-height: 32px; }
  .i2b-label { margin: 0; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .i2b-head-end { display: inline-flex; align-items: center; gap: 0.4rem; margin-left: auto; }
  /* .btn-secondary sets display, so the hidden attribute needs its own rule (Download .txt shows only for a long output). */
  .i2b-head-end [hidden] { display: none; }
  .i2b-out-len { font-size: 0.78rem; color: var(--color-text-muted); }
  .i2b-info { font-size: 0.8rem; color: var(--color-text-secondary); overflow-wrap: anywhere; }

  .i2b-drop {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1rem;
    text-align: center;
    cursor: pointer;
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.35rem;
    transition: border-color 0.15s, background 0.15s;
