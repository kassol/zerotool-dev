      signed: "먼저 비트 너비를 선택합니다. 입력 정수를 해당 너비의 부호 있는 패턴으로 읽으며 최상위 비트가 1이면 음수입니다. 음수 입력은 부호 있는 범위 안에 있어야 하고 양수 패턴은 선택한 비트 수를 넘을 수 없습니다.",
      other: "다섯 번째 행의 기본값은 36진법입니다. 2~36진법 중 하나를 선택하면 즉시 갱신됩니다. 나머지 네 행은 10·2·16·8진수로 고정됩니다.",
      steps: "결과 아래에서 계산 과정을 펼칩니다. 10진법 이외의 입력은 자리값을 전개하며, 나눗셈은 대상 진법이 10 및 입력 진법과 다를 때 표시합니다. 정수 부분만 다룹니다. 전개는 유효 입력 64자리까지, 나눗셈은 10진수 64자리까지 표시합니다."
    },
    err: {
      invalidDigit: '{pos}번째 문자 “{char}”는 {base}진수 숫자가 아닙니다(사용 가능: {allowed}).',
      hintHex: ' 16진수라면 16진법을 고르거나 앞에 0x를 붙이세요.',
      invalidChar: '{pos}번째 문자 “{char}”는 숫자에 쓸 수 없습니다.',
      sepPlace: '{pos}번째 구분 기호 “{char}”는 두 숫자 사이에만 올 수 있습니다.',
      comma: '{pos}번째 문자는 쉼표입니다. 쉼표는 10진수의 세 자리 구분(1,000,000)으로만 읽습니다. 소수점은 .을 쓰세요.',
      secondPoint: '{pos}번째 문자는 두 번째 소수점입니다.',
      signPlace: '{pos}번째 부호 “{char}”: 부호는 맨 앞에만 올 수 있습니다.',
      noDigits: '변환할 숫자가 없습니다.',
      prefixMismatch: '{prefix}는 {prefixName} 접두사인데 입력 진법은 {base}입니다. {prefixName}나 10진수를 고르거나 접두사를 지우세요.',
      tooLong: '{max}자리를 넘습니다.',
      signedFraction: '부호 있는 수(2의 보수)로 읽으려면 정수를 입력하세요.',
      signedRange: '{value}는 부호 있는 {n}비트 범위({min} ~ {max})를 벗어납니다.',
      signedWide: '입력에 {bits}비트가 필요합니다. {n}비트 패턴은 {n}비트뿐입니다.'
    }
  }
} as const;

const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
const otherBases = Array.from({ length: 35 }, (_, i) => i + 2).filter((b) => ![2, 8, 10, 16].includes(b));
const allBases = Array.from({ length: 35 }, (_, i) => i + 2);
const baseLabel = (b: number) => b in T.baseNames ? `${T.baseNames[b as 2 | 8 | 10 | 16]} (${b})` : T.baseN.replace('{n}', String(b));
const widths = [8, 16, 32, 64, 128];
const resultBases = [10, 2, 16, 8] as const;
---

<div class="nb-wrap">
  <div class="nb-opts">
    <div class="nb-option-group nb-format-options">
      <div class="nb-opt-line">
        <label for="nb-group">{T.optGroup}</label>
        <select id="nb-group" class="nb-small-select">
          <option value="none">{T.groupNone}</option>
          <option value="underscore">{T.groupUnderscore}</option>
          <option value="space">{T.groupSpace}</option>
        </select>
        <Toggletip id="nb-tip-format" lang={lang} about={T.optGroup}>{TIPS.format}</Toggletip>
      </div>
      <div class="nb-checks">
        <label class="nb-opt"><input type="checkbox" id="nb-prefix" /> {T.optPrefix}</label>
        <label class="nb-opt"><input type="checkbox" id="nb-lower" /> {T.optLower}</label>
      </div>
    </div>
    <div class="nb-option-group nb-width-options">
      <div class="nb-opt-line">
        <label for="nb-width">{T.optWidth}</label>
        <select id="nb-width" class="nb-small-select">
          <option value="0">{T.widthOff}</option>
          {widths.map((w) => <option value={w}>{T.widthBits.replace('{n}', String(w))}</option>)}
        </select>
        <Toggletip id="nb-tip-width" lang={lang} about={T.optWidth}>{TIPS.width}</Toggletip>
      </div>
      <div class="nb-opt-line">
        <label class="nb-opt"><input type="checkbox" id="nb-signed" disabled /> {T.optSigned}</label>
        <Toggletip id="nb-tip-signed" lang={lang} about={T.optSigned}>{TIPS.signed}</Toggletip>
      </div>
    </div>
    <button id="nb-clear" class="btn-ghost nb-clear" type="button">{T.clear}</button>
  </div>

  <div id="nb-status" class="tool-status nb-status" aria-live="polite" tabindex="0"></div>

  <div class="nb-in-row">
    <div class="nb-field nb-field-base">
      <div class="nb-field-label">
        <label class="tool-label" for="nb-base">{T.inputBase}</label>
        <Toggletip id="nb-tip-base" lang={lang} about={T.inputBase}>{TIPS.base}</Toggletip>
      </div>
      <select id="nb-base" class="tool-input">
        {[2, 8, 10, 16].map((b) => <option value={b} selected={b === 10}>{baseLabel(b)}</option>)}
        <optgroup label={T.otherBases}>
          {otherBases.map((b) => <option value={b}>{baseLabel(b)}</option>)}
        </optgroup>
      </select>
    </div>
    <div class="nb-field nb-field-num">
      <div class="nb-field-label">
        <label class="tool-label" for="nb-input">{T.number}</label>
        <Toggletip id="nb-tip-number" lang={lang} about={T.number}>{TIPS.number}</Toggletip>
      </div>
      <input id="nb-input" class="tool-input" type="text" placeholder={T.placeholder} spellcheck="false" autocomplete="off" autocapitalize="off" />
    </div>
  </div>

  <div class="nb-results">
    {resultBases.map((b) => (
      <div class="nb-row" data-base={b}>
        <span class="nb-key" id={`nb-key-${b}`}>{T.baseShort[b]}</span>
        <output id={`nb-out-${b}`} class="nb-value" tabindex="0" aria-labelledby={`nb-key-${b}`}></output>
        <button class="btn-copy" type="button" data-copy={`nb-out-${b}`}>{T.copy}</button>
      </div>
    ))}
    <div class="nb-row nb-row-other" data-base="other">
      <span class="nb-key nb-other-key">
        <label class="nb-sr" for="nb-other-base">{T.outOther}</label>
        <select id="nb-other-base" class="nb-other-select">
          {allBases.map((b) => <option value={b} selected={b === 36}>{T.baseN.replace('{n}', String(b))}</option>)}
        </select>
        <Toggletip id="nb-tip-other" lang={lang} about={T.outOther}>{TIPS.other}</Toggletip>
      </span>
      <output id="nb-out-other" class="nb-value" tabindex="0" aria-label={T.outOther}></output>
      <button class="btn-copy" type="button" data-copy="nb-out-other">{T.copy}</button>
    </div>
    <div class="nb-row nb-twos" hidden>
      <span class="nb-key" id="nb-key-twos-bin"></span>
      <output id="nb-out-twos-bin" class="nb-value" tabindex="0" aria-labelledby="nb-key-twos-bin"></output>
      <button class="btn-copy" type="button" data-copy="nb-out-twos-bin">{T.copy}</button>
    </div>
    <div class="nb-row nb-twos" hidden>
      <span class="nb-key" id="nb-key-twos-hex"></span>
      <output id="nb-out-twos-hex" class="nb-value" tabindex="0" aria-labelledby="nb-key-twos-hex"></output>
      <button class="btn-copy" type="button" data-copy="nb-out-twos-hex">{T.copy}</button>
    </div>
    <p id="nb-twos-info" class="nb-twos-info" tabindex="0" hidden></p>
  </div>

  <div class="nb-steps-section">
    <details class="nb-steps" id="nb-steps">
      <summary>{T.stepsSummary}</summary>
      <label class="nb-opt nb-steps-target">{T.stepsTarget}
        <select id="nb-steps-base" class="nb-small-select">
          {allBases.map((b) => <option value={b} selected={b === 2}>{b}</option>)}
        </select>
      </label>
      <pre id="nb-steps-out" class="nb-steps-out" tabindex="0" aria-label={T.stepsSummary}></pre>
    </details>
    <Toggletip id="nb-tip-steps" lang={lang} about={T.stepsSummary}>{TIPS.steps}</Toggletip>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      /* ── engine:start ── */
      var DIGITS = '0123456789abcdefghijklmnopqrstuvwxyz';
      var MAX_DIGITS = 20000;
      var MAX_FRAC = 64;
      var PREFIX_BASE = { b: 2, o: 8, x: 16 };
      var SEPARATORS = { ' ': 1, '\t': 1, '\n': 1, '\r': 1, '_': 1, "'": 1 };
      var SPACES = { '\u00a0': 1, '\u2007': 1, '\u2009': 1, '\u202f': 1, '\u205f': 1, '\u3000': 1 };
      var MINUS = { '\u2212': 1, '\u2010': 1, '\u2011': 1, '\u2012': 1, '\u2013': 1, '\ufe63': 1 };

      function fill(tpl, fields) {
        return String(tpl).replace(/\{(\w+)\}/g, function (m, k) {
          return fields && fields[k] !== undefined ? String(fields[k]) : m;
        });
      }

      // Map full-width ASCII (U+FF01–FF5E), wide spaces and minus signs to
      // ASCII. Other characters are left alone, so superscripts and circled
      // digits are rejected instead of silently read as digits.
      function asciiChar(ch) {
        var cp = ch.codePointAt(0);
        if (cp >= 0xff01 && cp <= 0xff5e) return { c: String.fromCharCode(cp - 0xfee0), wide: true };
        if (SPACES[ch]) return { c: ' ', wide: cp === 0x3000 };
        if (MINUS[ch]) return { c: '-', wide: cp === 0xfe63 };
        return { c: ch, wide: false };
      }

      function digitValue(c) {
        var i = DIGITS.indexOf(c.toLowerCase());
        return c.length === 1 && i >= 0 ? i : -1;
      }

      function allowedDigits(base) {
        if (base <= 10) return '0\u2013' + (base - 1);
        return '0\u20139, A\u2013' + DIGITS.charAt(base - 1).toUpperCase();
      }

      function parseDigits(s, base) {
        var B = BigInt(base);
        var chunk = 1, size = base;
        while (size * base < 9007199254740991 && chunk < 15) { size *= base; chunk++; }
        var value = 0n;
        for (var i = 0; i < s.length; i += chunk) {
          var part = s.slice(i, i + chunk);
          value = value * (B ** BigInt(part.length)) + BigInt(parseInt(part, base));
        }
        return value;
      }

      function gcd(a, b) {
        while (b) { var t = a % b; a = b; b = t; }
        return a;
      }

      function bitLength(n) {
        if (n < 0n) n = -n;
        return n === 0n ? 0 : n.toString(2).length;
      }

      // Parse `raw` as a number in `base` (2–36). Returns
      //   { empty: true } for blank input,
      //   { error: { code, ...fields } }, or
      //   { n, d, readBase, intDigits, fracDigits, notes }
      // where the value is the reduced fraction n / d (d > 0).
      // opts.signedWidth > 0 reads a non-negative input as an n-bit two's
      // complement pattern.
      function parseNumber(raw, base, opts) {
        opts = opts || {};
        var chars = [];
        var wide = false;
        var pos = 0;
        for (var ch of String(raw)) {
          pos++;
          var a = asciiChar(ch);
          if (a.wide) wide = true;
          chars.push({ c: a.c, orig: ch, pos: pos });
        }
        var isSpace = function (c) { return c === ' ' || c === '\t' || c === '\n' || c === '\r'; };
        var start = 0, end = chars.length;
        while (start < end && isSpace(chars[start].c)) start++;
        while (end > start && isSpace(chars[end - 1].c)) end--;
        if (start === end) return { empty: true };

        var notes = [];
        var i = start;
        var neg = false;
        if (chars[i].c === '+' || chars[i].c === '-') { neg = chars[i].c === '-'; i++; }

        var readBase = base;
        var afterPrefix = false;
        if (i + 1 < end && chars[i].c === '0' && PREFIX_BASE[chars[i + 1].c.toLowerCase()]) {
          var letter = chars[i + 1].c.toLowerCase();
          var pBase = PREFIX_BASE[letter];
          var prefix = '0' + letter;
          if (pBase === base) {
            i += 2; afterPrefix = true;
          } else if (base === 10) {
            readBase = pBase; i += 2; afterPrefix = true;
            notes.push({ code: 'prefix', prefix: prefix, base: pBase });
          } else if (digitValue(letter) < base) {
            notes.push({ code: 'prefixDigits', prefix: chars[i].orig + chars[i + 1].orig, base: base });
          } else {
            return { error: { code: 'prefixMismatch', prefix: prefix, prefixBase: pBase, base: base, pos: chars[i].pos } };
          }
        } else if (base === 16 && i < end && chars[i].c === '#') {
          i++;
          notes.push({ code: 'hash' });
        }

        var intDigits = '', fracDigits = '';
        var part = 'int';
        var prevDigit = false;
        var pendingSep = null;
        var commas = [];
        var intSepFree = 0;
        for (; i < end; i++) {
          var c = chars[i].c;
          var v = digitValue(c);
          if (v >= 0 && v < readBase) {
            if (part === 'int') intDigits += c.toLowerCase(); else fracDigits += c.toLowerCase();
            prevDigit = true; pendingSep = null; afterPrefix = false;
            continue;
          }
          if (SEPARATORS[c] || c === ',') {
            if (c === ',' && (readBase !== 10 || part === 'frac')) {
              return { error: { code: 'comma', pos: chars[i].pos } };
            }
            var okAfterPrefix = afterPrefix && c === '_';
            if ((!prevDigit && !okAfterPrefix) || pendingSep) {
              return { error: { code: 'sepPlace', char: chars[i].orig, pos: chars[i].pos } };
            }
            if (c === ',') commas.push({ at: intDigits.length, pos: chars[i].pos });
            pendingSep = chars[i]; prevDigit = false; afterPrefix = false;
            continue;
          }
          if (c === '.') {
            if (part === 'frac') return { error: { code: 'secondPoint', pos: chars[i].pos } };
            if (pendingSep) return { error: { code: 'sepPlace', char: pendingSep.orig, pos: pendingSep.pos } };
            part = 'frac'; prevDigit = false; afterPrefix = false;
            continue;
          }
          if (c === '+' || c === '-') return { error: { code: 'signPlace', char: chars[i].orig, pos: chars[i].pos } };
          if (v >= 0) {
            return { error: { code: 'invalidDigit', char: chars[i].orig, pos: chars[i].pos, base: readBase, hex: readBase === 10 && v < 16 } };
          }
          return { error: { code: 'invalidChar', char: chars[i].orig, pos: chars[i].pos } };
        }
        if (pendingSep) return { error: { code: 'sepPlace', char: pendingSep.orig, pos: pendingSep.pos } };
        if (!intDigits && !fracDigits) return { error: { code: 'noDigits' } };
        if (intDigits.length + fracDigits.length > MAX_DIGITS) return { error: { code: 'tooLong', max: MAX_DIGITS } };
        if (commas.length) {
          var prevAt = 0;
          for (var k = 0; k < commas.length; k++) {
            var len = commas[k].at - prevAt;
            if ((k === 0 && (len < 1 || len > 3)) || (k > 0 && len !== 3)) return { error: { code: 'comma', pos: commas[k].pos } };
            prevAt = commas[k].at;
          }
          if (intDigits.length - prevAt !== 3) return { error: { code: 'comma', pos: commas[commas.length - 1].pos } };
        }
        if (wide) notes.unshift({ code: 'fullwidth' });

        var ip = intDigits ? parseDigits(intDigits, readBase) : 0n;
        var n, d;
        if (fracDigits) {
          d = BigInt(readBase) ** BigInt(fracDigits.length);
          n = ip * d + parseDigits(fracDigits, readBase);
          var g = gcd(n, d);
          if (g > 1n) { n /= g; d /= g; }
        } else {
          n = ip; d = 1n;
        }
        if (neg) n = -n;

        var w = opts.signedWidth || 0;
        if (w) {
          var W = BigInt(w);
          var min = -(1n << (W - 1n)), max = (1n << (W - 1n)) - 1n;
          if (fracDigits) return { error: { code: 'signedFraction' } };
          if (n < 0n) {
            if (n < min) return { error: { code: 'signedRange', value: n.toString(), n: w, min: min.toString(), max: max.toString() } };
          } else if (bitLength(n) > w) {
            return { error: { code: 'signedWide', bits: bitLength(n), n: w } };
          } else if (n > max) {
            n -= 1n << W;
            notes.push({ code: 'signedNeg', n: w, value: n.toString() });
          }
        }
        return { n: n, d: d, readBase: readBase, intDigits: intDigits || '0', fracDigits: fracDigits, notes: notes };
      }

      function groupDigits(s, size, sep) {
        if (!sep || s.length <= size) return s;
        var out = '';
        var first = s.length % size || size;
        out = s.slice(0, first);
        for (var i = first; i < s.length; i += size) out += sep + s.slice(i, i + size);
        return out;
      }

      function groupSizeFor(base) { return base === 10 ? 3 : 4; }

      // Write n / d in `base`. opts: { group: 'none' | 'underscore' | 'space',
      // prefix: bool (0b / 0o / 0x for bases 2, 8, 16), lower: bool }.
      // A repeating fraction is written with the repeating block in
      // parentheses; a fraction that neither ends nor repeats within MAX_FRAC
      // digits is cut and marked with an ellipsis.
      function formatValue(n, d, base, opts) {
        opts = opts || {};
        var neg = n < 0n;
        var a = neg ? -n : n;
        var ip = a / d;
        var r = a % d;
        var s = ip.toString(base);
        var sep = opts.group === 'underscore' ? '_' : opts.group === 'space' ? ' ' : '';
        s = groupDigits(s, groupSizeFor(base), sep);
        var frac = '', repeating = false, truncated = false;
        if (r !== 0n) {
          var B = BigInt(base);
          var seen = new Map();
          var digits = '';
          while (r !== 0n) {
            var key = r.toString(36);
            if (seen.has(key)) {
              var at = seen.get(key);
              digits = digits.slice(0, at) + '(' + digits.slice(at) + ')';
              repeating = true;
              break;
            }
            if (digits.length >= MAX_FRAC) { digits += '\u2026'; truncated = true; break; }
            seen.set(key, digits.length);
            r *= B;
            digits += DIGITS.charAt(Number(r / d));
            r %= d;
          }
          frac = '.' + digits;
        }
        var text = s + frac;
        text = opts.lower ? text : text.toUpperCase();
        var prefix = opts.prefix ? ({ 2: '0b', 8: '0o', 16: '0x' })[base] || '' : '';
        return { text: (neg ? '-' : '') + prefix + text, repeating: repeating, truncated: truncated };
      }

      // N-bit two's complement pattern of an integer value. Accepts
      // -2^(N-1) .. 2^N - 1 (the signed and the unsigned range together).
      function twosComplement(n, d, width, opts) {
        opts = opts || {};
        if (d !== 1n) return { error: 'fraction' };
        var W = BigInt(width);
        var min = -(1n << (W - 1n));
        var max = (1n << W) - 1n;
        if (n < min || n > max) return { error: 'range', min: min.toString(), max: max.toString() };
        var u = BigInt.asUintN(width, n);
        var sep = opts.group === 'underscore' ? '_' : opts.group === 'space' ? ' ' : '';
        var bin = groupDigits(u.toString(2).padStart(width, '0'), 4, sep);
        var hex = groupDigits(u.toString(16).padStart(width / 4, '0'), 4, sep);
        if (!opts.lower) hex = hex.toUpperCase();
        if (opts.prefix) { bin = '0b' + bin; hex = '0x' + hex; }
        return { bin: bin, hex: hex, unsigned: u.toString(), signed: BigInt.asIntN(width, n).toString() };
      }

      // Positional expansion of an integer digit string to decimal.
      function stepsToDecimal(digits, base) {
        if (digits.length > 64) return null;
        var B = BigInt(base);
        var terms = [];
        var sum = 0n;
        for (var i = 0; i < digits.length; i++) {
          var power = digits.length - 1 - i;
          var v = BigInt(digitValue(digits.charAt(i)));
          var product = v * B ** BigInt(power);
          sum += product;
          terms.push({ digit: digits.charAt(i).toUpperCase(), power: power, product: product.toString() });
        }
        return { terms: terms, sum: sum.toString() };
      }

      // Repeated division of a non-negative integer by `base`.
      function stepsFromDecimal(n, base) {
        if (n < 0n) n = -n;
        if (n.toString(10).length > 64) return null;
        var B = BigInt(base);
        var rows = [];
        while (n > 0n) {
          var q = n / B, r = n % B;
          rows.push({ dividend: n.toString(), quotient: q.toString(), remainder: r.toString(), digit: DIGITS.charAt(Number(r)).toUpperCase() });
          n = q;
        }
        return { rows: rows, result: rows.map(function (x) { return x.digit; }).reverse().join('') || '0' };
      }
      /* ── engine:end ── */

      var SLUG = 'number-base';
      var $ = function (id) { return document.getElementById(id); };
      var inputEl = $('nb-input');
      var baseEl = $('nb-base');
      var statusEl = $('nb-status');
      var otherBaseEl = $('nb-other-base');
      var groupEl = $('nb-group');
      var prefixEl = $('nb-prefix');
      var lowerEl = $('nb-lower');
      var widthEl = $('nb-width');
      var signedEl = $('nb-signed');
      var stepsEl = $('nb-steps');
      var stepsBaseEl = $('nb-steps-base');
      var stepsOut = $('nb-steps-out');
      var twosRows = document.querySelectorAll('.nb-twos');
      var twosInfo = $('nb-twos-info');
      var outs = { 10: $('nb-out-10'), 2: $('nb-out-2'), 16: $('nb-out-16'), 8: $('nb-out-8') };
      var last = null;
      var resultRevision = 0;
      var copyButtons = document.querySelectorAll('.nb-wrap .btn-copy[data-copy]');

      function baseName(b) { return t.baseNames[b] || fill(t.baseN, { n: b }); }

      function setStatus(msg, kind) {
        statusEl.textContent = msg;
        statusEl.className = 'tool-status nb-status' + (kind ? ' ' + kind : '');
      }

      function errorText(e) {
        var f = {};
        for (var k in e) f[k] = e[k];
        if (e.code === 'invalidDigit') f.allowed = allowedDigits(e.base);
        if (e.code === 'prefixMismatch') f.prefixName = baseName(e.prefixBase);
        var msg = fill(t.err[e.code], f);
        if (e.code === 'invalidDigit' && e.hex) msg += t.err.hintHex;
        return msg;
      }

      function noteText(nt) {
        switch (nt.code) {
          case 'fullwidth': return t.noteFullwidth;
          case 'hash': return t.noteHash;
          case 'prefix': return fill(t.notePrefix, { prefix: nt.prefix, baseName: baseName(nt.base) });
          case 'prefixDigits': return fill(t.notePrefixDigits, nt);
          case 'signedNeg': return fill(t.noteSignedNeg, nt);
        }
        return '';
      }

      function readOpts() {
        return { group: groupEl.value, prefix: prefixEl.checked, lower: lowerEl.checked };
      }

      function saveState() {
        if (!window.ztPersist) return;
        window.ztPersist.save(SLUG, {
          base: baseEl.value, other: otherBaseEl.value, group: groupEl.value, prefix: prefixEl.checked,
          lower: lowerEl.checked, width: widthEl.value, signed: signedEl.checked, steps: stepsBaseEl.value
        });
      }

      function loadState() {
        var s = (window.ztPersist && window.ztPersist.load(SLUG)) || {};
        var setSel = function (el, v) { if (v !== undefined && el.querySelector('option[value="' + v + '"]')) el.value = String(v); };
        setSel(baseEl, s.base); setSel(otherBaseEl, s.other); setSel(groupEl, s.group);
        setSel(widthEl, s.width); setSel(stepsBaseEl, s.steps);
        prefixEl.checked = !!s.prefix; lowerEl.checked = !!s.lower; signedEl.checked = !!s.signed;
      }

      function clearOutputs() {
        Object.keys(outs).forEach(function (b) { outs[b].textContent = ''; });
        $('nb-out-other').textContent = '';
        $('nb-out-twos-bin').textContent = '';
        $('nb-out-twos-hex').textContent = '';
        twosInfo.hidden = true;
        stepsOut.textContent = '';
        last = null;
      }

      function highlight(readBase) {
        document.querySelectorAll('.nb-row').forEach(function (row) {
          var b = row.getAttribute('data-base');
          var on = b === String(readBase) || (b === 'other' && otherBaseEl.value === String(readBase) && !outs[readBase]);
          row.classList.toggle('nb-active', on);
        });
      }

      function renderSteps() {
        if (!last || !stepsEl.open) { if (!last) stepsOut.textContent = ''; return; }
        var lines = [];
        var r = last;
        if (r.n === 0n) { stepsOut.textContent = t.stepsZero; return; }
        if (r.readBase !== 10) {
          var exp = stepsToDecimal(r.intDigits.replace(/^0+(?=.)/, ''), r.readBase);
          if (!exp) { stepsOut.textContent = t.stepsTooLong; return; }
          lines.push(fill(t.stepsExpand, { base: r.readBase }));
          exp.terms.forEach(function (x) { lines.push('  ' + fill(t.stepLine, { digit: x.digit, base: r.readBase, power: x.power, product: x.product })); });
          lines.push('  ' + fill(t.stepsSum, { sum: exp.sum }));
          lines.push('');
        }
        var target = Number(stepsBaseEl.value);
        var ip = (r.n < 0n ? -r.n : r.n) / r.d;
        var div = stepsFromDecimal(ip, target);
        if (!div) { stepsOut.textContent = t.stepsTooLong; return; }
        if (target !== 10 && target !== r.readBase) {
          lines.push(fill(t.stepsDivide, { base: target }));
          div.rows.forEach(function (x) { lines.push('  ' + fill(t.divLine, { dividend: x.dividend, base: target, quotient: x.quotient, remainder: x.remainder })); });
          lines.push('  ' + fill(t.divRead, { result: div.result }));
        }
        if (r.d !== 1n) { lines.push(''); lines.push(t.stepsFraction); }
        stepsOut.textContent = lines.join('\n').trim();
      }

      var trackTimer = null, lastTracked = '';
      function track(raw) {
        clearTimeout(trackTimer);
        trackTimer = setTimeout(function () {
          if (raw === lastTracked) return;
          lastTracked = raw;
          window.trackTool && window.trackTool('number_base', 'convert');
        }, 1500);
      }

      function convert() {
        resultRevision++;
        copyButtons.forEach(function (btn) { btn.textContent = t.copy; });
        var base = Number(baseEl.value);
        var width = Number(widthEl.value);
        signedEl.disabled = !width;
        var signedWidth = width && signedEl.checked ? width : 0;
        var r = parseNumber(inputEl.value, base, { signedWidth: signedWidth });
        twosRows.forEach(function (row) { row.hidden = !width; });
        if (width) {
          $('nb-key-twos-bin').textContent = fill(t.twosBin, { n: width });
          $('nb-key-twos-hex').textContent = fill(t.twosHex, { n: width });
        }
        if (r.empty) { clearOutputs(); setStatus('', ''); highlight(base); return; }
        if (r.error) { clearOutputs(); setStatus(errorText(r.error), 'error'); highlight(base); return; }

        last = r;
        var o = readOpts();
        var repeating = false, truncated = false;
        function put(el, b) {
          var f = formatValue(r.n, r.d, b, o);
          el.textContent = f.text;
          repeating = repeating || f.repeating;
          truncated = truncated || f.truncated;
        }
        Object.keys(outs).forEach(function (b) { put(outs[b], Number(b)); });
        put($('nb-out-other'), Number(otherBaseEl.value));

        if (width) {
          var tc = twosComplement(r.n, r.d, width, o);
          if (tc.error) {
            $('nb-out-twos-bin').textContent = '';
            $('nb-out-twos-hex').textContent = '';
            twosInfo.textContent = tc.error === 'fraction' ? t.twosFraction : fill(t.twosRange, { n: width, min: tc.min, max: tc.max });
          } else {
            $('nb-out-twos-bin').textContent = tc.bin;
            $('nb-out-twos-hex').textContent = tc.hex;
            twosInfo.textContent = fill(t.twosInfo, { n: width, unsigned: tc.unsigned, signed: tc.signed });
          }
          twosInfo.hidden = false;
        } else {
          twosInfo.hidden = true;
        }

        var signedRead = r.notes.some(function (nt) { return nt.code === 'signedNeg'; });
        var parts = [r.d === 1n && !signedRead ? fill(t.okInt, { baseName: baseName(r.readBase), bits: bitLength(r.n) }) : fill(t.okPlain, { baseName: baseName(r.readBase) })];
        r.notes.forEach(function (nt) { parts.push(noteText(nt)); });
        if (repeating) parts.push(t.noteRepeat);
        if (truncated) parts.push(t.noteTruncated);
        setStatus(parts.join(' '), r.notes.length || repeating || truncated ? 'info' : 'success');
        highlight(r.readBase);
        renderSteps();
        track(inputEl.value);
      }

      function onOption() { saveState(); convert(); }

      inputEl.addEventListener('input', convert);
      [baseEl, otherBaseEl, groupEl, prefixEl, lowerEl, widthEl, signedEl].forEach(function (el) {
        el.addEventListener('change', onOption);
      });
      stepsBaseEl.addEventListener('change', function () { saveState(); renderSteps(); });
      stepsEl.addEventListener('toggle', renderSteps);

      $('nb-clear').addEventListener('click', function () {
        inputEl.value = '';
        convert();
        inputEl.focus();
      });

      // The page-wide Ctrl/Cmd+L shortcut empties the text input; refresh the
      // outputs and status after it runs.
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L')) {
          setTimeout(function () { if (!inputEl.value) convert(); }, 0);
        }
      });

      function copyText(text) {
        if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
        return new Promise(function (resolve, reject) {
          var ta = document.createElement('textarea');
          ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          var ok = false;
          try { ok = document.execCommand('copy'); } catch (err) { ok = false; }
          document.body.removeChild(ta);
          ok ? resolve() : reject(new Error('copy'));
        });
      }

      copyButtons.forEach(function (btn) {
        var requestId = 0, feedbackTimer = null;
        btn.addEventListener('click', function () {
          var val = $(btn.getAttribute('data-copy')).textContent;
          if (!val) return;
          var revision = resultRevision, input = inputEl.value, request = ++requestId;
          clearTimeout(feedbackTimer);
          btn.textContent = t.copy;
          function isCurrent() {
            // Ctrl/Cmd+L clears the input before the deferred convert runs.
            return revision === resultRevision && input === inputEl.value && request === requestId;
          }
          copyText(val).then(function () {
            if (isCurrent()) {
              btn.textContent = t.copied;
              feedbackTimer = setTimeout(function () { if (isCurrent()) btn.textContent = t.copy; }, 1500);
            }
            window.trackTool && window.trackTool('number_base', 'copy');
          }, function () { if (isCurrent()) setStatus(t.copyFail, 'error'); });
        });
      });

      loadState();
      convert();
    })();
  </script>
</div>

