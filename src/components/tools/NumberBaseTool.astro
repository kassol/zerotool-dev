---
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// {name} fields are filled by the inline script. baseNames covers the four
// common bases; every other base uses `baseN`.
const STRINGS = {
  en: {
    inputBase: 'Input base', number: 'Number', placeholder: 'e.g. 255, 0xFF, 1111_0000, -42, 0.1',
    baseNames: { 2: 'Binary', 8: 'Octal', 10: 'Decimal', 16: 'Hexadecimal' },
    baseShort: { 2: 'Binary', 8: 'Octal', 10: 'Decimal', 16: 'Hex' },
    baseN: 'Base {n}', otherBases: 'Other bases', outOther: 'Base',
    copy: 'Copy', copied: 'Copied!', copyFail: 'Copy failed. Select the value and copy it by hand.', clear: 'Clear',
    optGroup: 'Digit grouping', groupNone: 'None', groupUnderscore: '1111_0000', groupSpace: '1111 0000',
    optPrefix: 'Prefix 0b / 0o / 0x', optLower: 'Lowercase a–z',
    optWidth: 'Two\u2019s complement', widthOff: 'Off', widthBits: '{n}-bit', optSigned: 'Read input as signed',
    twosBin: '{n}-bit binary', twosHex: '{n}-bit hex',
    stepsSummary: 'Show the working', stepsTarget: 'Divide the decimal value by',
    stepsExpand: 'Positional expansion, base {base} to decimal:', stepLine: '{digit} \u00d7 {base}^{power} = {product}', stepsSum: 'Sum = {sum}',
    stepsDivide: 'Repeated division, decimal to base {base}:', divLine: '{dividend} \u00f7 {base} = {quotient}, remainder {remainder}', divRead: 'Remainders read from bottom to top: {result}',
    stepsZero: 'The value is 0, so every base writes it as 0.', stepsTooLong: 'Steps are shown for integers of up to 64 digits.', stepsFraction: 'Steps cover the integer part. The fraction digits come from repeated multiplication by the base.',
    okInt: 'Read as {baseName}: {bits} bits.', okPlain: 'Read as {baseName}.',
    notePrefix: 'The {prefix} prefix was read as {baseName}.', notePrefixDigits: '\u201c{prefix}\u201d was read as two base-{base} digits, not as a prefix.',
    noteHash: 'The leading # was ignored.', noteFullwidth: 'Full-width characters were read as ASCII.',
    noteRepeat: 'Digits in parentheses repeat forever: 0.0(0011) means 0.000110011\u2026',
    noteTruncated: 'A fraction marked \u2026 does not end within 64 digits; the digits shown are cut off, not rounded.',
    noteSignedNeg: 'The {n}-bit pattern has its top bit set, so it was read as {value}.',
    twosRange: 'Outside the {n}-bit range ({min} to {max}).', twosFraction: 'Two\u2019s complement needs an integer.',
    twosInfo: '{n}-bit: unsigned {unsigned}, signed {signed}.',
    err: {
      invalidDigit: '\u201c{char}\u201d at position {pos} is not a base-{base} digit (allowed: {allowed}).',
      hintHex: ' Hexadecimal? Choose base 16 or type 0x first.',
      invalidChar: '\u201c{char}\u201d at position {pos} cannot appear in a number.',
      sepPlace: 'Separator \u201c{char}\u201d at position {pos} must sit between two digits.',
      comma: 'Comma at position {pos}: commas are read only as thousands separators in base 10 (1,000,000). Use . as the decimal point.',
      secondPoint: 'Second decimal point at position {pos}.',
      signPlace: 'Sign \u201c{char}\u201d at position {pos}: a sign can only come first.',
      noDigits: 'No digits to convert.',
      prefixMismatch: '{prefix} is the {prefixName} prefix, but the input base is {base}. Choose {prefixName} or Decimal, or delete the prefix.',
      tooLong: 'The number has more than {max} digits.',
      signedFraction: 'Signed (two\u2019s complement) input must be an integer.',
      signedRange: '{value} is outside the signed {n}-bit range ({min} to {max}).',
      signedWide: 'The input needs {bits} bits; a {n}-bit pattern has {n}.'
    }
  },
  zh: {
    inputBase: '输入进制', number: '数字', placeholder: '如 255、0xFF、1111_0000、-42、0.1',
    baseNames: { 2: '二进制', 8: '八进制', 10: '十进制', 16: '十六进制' },
    baseShort: { 2: '二进制', 8: '八进制', 10: '十进制', 16: '十六进制' },
    baseN: '{n} 进制', otherBases: '其他进制', outOther: '进制',
    copy: '复制', copied: '已复制！', copyFail: '复制失败，请手动选中数值复制。', clear: '清除',
    optGroup: '数位分组', groupNone: '不分组', groupUnderscore: '1111_0000', groupSpace: '1111 0000',
    optPrefix: '加前缀 0b / 0o / 0x', optLower: '字母小写',
    optWidth: '补码', widthOff: '关', widthBits: '{n} 位', optSigned: '按有符号数读取输入',
    twosBin: '{n} 位二进制', twosHex: '{n} 位十六进制',
    stepsSummary: '显示计算过程', stepsTarget: '十进制值除以',
    stepsExpand: '按权展开，{base} 进制转十进制：', stepLine: '{digit} \u00d7 {base}^{power} = {product}', stepsSum: '求和 = {sum}',
    stepsDivide: '除基取余，十进制转 {base} 进制：', divLine: '{dividend} \u00f7 {base} = {quotient} 余 {remainder}', divRead: '余数从下往上读：{result}',
    stepsZero: '值为 0，任何进制都写作 0。', stepsTooLong: '计算过程只对 64 位数字以内的整数显示。', stepsFraction: '过程只覆盖整数部分；小数部分按「乘基取整」得到。',
    okInt: '按{baseName}读取：{bits} 个二进制位。', okPlain: '按{baseName}读取。',
    notePrefix: '前缀 {prefix} 按{baseName}读取。', notePrefixDigits: '「{prefix}」按 {base} 进制的两个数字读取，不是前缀。',
    noteHash: '开头的 # 已忽略。', noteFullwidth: '全角字符已按半角读取。',
    noteRepeat: '括号内的数字无限循环：0.0(0011) 即 0.000110011…',
    noteTruncated: '标 … 的小数在 64 位内没有结束，显示的数字是截断的，没有四舍五入。',
    noteSignedNeg: '这个 {n} 位模式的最高位是 1，按有符号数读作 {value}。',
    twosRange: '超出 {n} 位的范围（{min} 到 {max}）。', twosFraction: '补码只适用于整数。',
    twosInfo: '{n} 位：无符号 {unsigned}，有符号 {signed}。',
    err: {
      invalidDigit: '第 {pos} 个字符「{char}」不是 {base} 进制的数字（可用：{allowed}）。',
      hintHex: ' 如果是十六进制，请选 16 进制或在前面加 0x。',
      invalidChar: '第 {pos} 个字符「{char}」不能出现在数字里。',
      sepPlace: '第 {pos} 个字符是分隔符「{char}」，它只能夹在两个数字之间。',
      comma: '第 {pos} 个字符是逗号：逗号只在十进制里作千位分隔符（1,000,000）。小数点请用 .。',
      secondPoint: '第 {pos} 个字符是第二个小数点。',
      signPlace: '第 {pos} 个字符是符号「{char}」，符号只能写在最前面。',
      noDigits: '没有可转换的数字。',
      prefixMismatch: '{prefix} 是{prefixName}前缀，但输入进制是 {base}。请改选{prefixName}或十进制，或删掉前缀。',
      tooLong: '数字超过 {max} 位。',
      signedFraction: '按有符号数（补码）读取时，输入必须是整数。',
      signedRange: '{value} 超出 {n} 位有符号整数的范围（{min} 到 {max}）。',
      signedWide: '输入需要 {bits} 个二进制位，{n} 位模式只有 {n} 位。'
    }
  },
  ja: {
    inputBase: '入力の基数', number: '数値', placeholder: '例：255、0xFF、1111_0000、-42、0.1',
    baseNames: { 2: '2進数', 8: '8進数', 10: '10進数', 16: '16進数' },
    baseShort: { 2: '2進数', 8: '8進数', 10: '10進数', 16: '16進数' },
    baseN: '{n}進数', otherBases: 'その他の基数', outOther: '基数',
    copy: 'コピー', copied: 'コピー済み！', copyFail: 'コピーできませんでした。値を選択して手動でコピーしてください。', clear: 'クリア',
    optGroup: '桁区切り', groupNone: 'なし', groupUnderscore: '1111_0000', groupSpace: '1111 0000',
    optPrefix: '接頭辞 0b / 0o / 0x', optLower: '英字を小文字に',
    optWidth: '2の補数', widthOff: 'オフ', widthBits: '{n}ビット', optSigned: '入力を符号付きで読む',
    twosBin: '{n}ビット 2進数', twosHex: '{n}ビット 16進数',
    stepsSummary: '計算過程を表示', stepsTarget: '10進数の値を割る基数',
    stepsExpand: '位取りの展開（{base}進数 → 10進数）：', stepLine: '{digit} \u00d7 {base}^{power} = {product}', stepsSum: '合計 = {sum}',
    stepsDivide: '繰り返し割り算（10進数 → {base}進数）：', divLine: '{dividend} \u00f7 {base} = {quotient} 余り {remainder}', divRead: '余りを下から上へ読む：{result}',
    stepsZero: '値は 0 なので、どの基数でも 0 です。', stepsTooLong: '計算過程は 64 桁以内の整数で表示します。', stepsFraction: '過程は整数部のみです。小数部は基数を掛ける操作の繰り返しで求めます。',
    okInt: '{baseName}として読み取り：{bits} ビット。', okPlain: '{baseName}として読み取り。',
    notePrefix: '接頭辞 {prefix} を{baseName}として読み取りました。', notePrefixDigits: '「{prefix}」は接頭辞ではなく{base}進数の 2 桁として読み取りました。',
    noteHash: '先頭の # は無視しました。', noteFullwidth: '全角文字は半角として読み取りました。',
    noteRepeat: '括弧内の数字は無限に繰り返します：0.0(0011) は 0.000110011…',
    noteTruncated: '… の付いた小数は 64 桁以内で終わりません。表示した桁は切り捨てで、四捨五入していません。',
    noteSignedNeg: 'この {n} ビットのパターンは最上位ビットが 1 なので、符号付きで {value} と読みました。',
    twosRange: '{n} ビットの範囲（{min} ～ {max}）の外です。', twosFraction: '2の補数は整数にだけ使えます。',
    twosInfo: '{n} ビット：符号なし {unsigned}、符号付き {signed}。',
    err: {
      invalidDigit: '{pos} 文字目の「{char}」は{base}進数の数字ではありません（使える文字：{allowed}）。',
      hintHex: ' 16進数なら基数 16 を選ぶか、先頭に 0x を付けてください。',
      invalidChar: '{pos} 文字目の「{char}」は数値に使えません。',
      sepPlace: '{pos} 文字目の区切り「{char}」は数字と数字の間にしか置けません。',
      comma: '{pos} 文字目のカンマ：カンマは 10 進数の 3 桁区切り（1,000,000）としてだけ読みます。小数点は . を使ってください。',
      secondPoint: '{pos} 文字目は 2 つ目の小数点です。',
      signPlace: '{pos} 文字目の符号「{char}」：符号は先頭にしか置けません。',
      noDigits: '変換する数字がありません。',
      prefixMismatch: '{prefix} は{prefixName}の接頭辞ですが、入力の基数は {base} です。{prefixName}か10進数を選ぶか、接頭辞を消してください。',
      tooLong: '{max} 桁を超えています。',
      signedFraction: '符号付き（2の補数）で読むときは整数を入力してください。',
      signedRange: '{value} は符号付き {n} ビットの範囲（{min} ～ {max}）の外です。',
      signedWide: '入力は {bits} ビット必要です。{n} ビットのパターンは {n} ビットしかありません。'
    }
  },
  ko: {
    inputBase: '입력 진법', number: '숫자', placeholder: '예: 255, 0xFF, 1111_0000, -42, 0.1',
    baseNames: { 2: '2진수', 8: '8진수', 10: '10진수', 16: '16진수' },
    baseShort: { 2: '2진수', 8: '8진수', 10: '10진수', 16: '16진수' },
    baseN: '{n}진수', otherBases: '그 밖의 진법', outOther: '진법',
    copy: '복사', copied: '복사됨!', copyFail: '복사하지 못했습니다. 값을 선택해 직접 복사하세요.', clear: '지우기',
    optGroup: '자릿수 구분', groupNone: '없음', groupUnderscore: '1111_0000', groupSpace: '1111 0000',
    optPrefix: '접두사 0b / 0o / 0x', optLower: '영문 소문자',
    optWidth: '2의 보수', widthOff: '끄기', widthBits: '{n}비트', optSigned: '입력을 부호 있는 수로 읽기',
    twosBin: '{n}비트 2진수', twosHex: '{n}비트 16진수',
    stepsSummary: '계산 과정 보기', stepsTarget: '10진수 값을 나눌 진법',
    stepsExpand: '자리값 전개({base}진수 → 10진수):', stepLine: '{digit} \u00d7 {base}^{power} = {product}', stepsSum: '합 = {sum}',
    stepsDivide: '반복 나눗셈(10진수 → {base}진수):', divLine: '{dividend} \u00f7 {base} = {quotient} 나머지 {remainder}', divRead: '나머지를 아래에서 위로 읽기: {result}',
    stepsZero: '값이 0이므로 어느 진법에서도 0입니다.', stepsTooLong: '계산 과정은 64자리 이하의 정수에만 표시합니다.', stepsFraction: '과정은 정수 부분만 다룹니다. 소수 부분은 진법을 곱하는 계산을 반복해 구합니다.',
    okInt: '{baseName}로 읽음: {bits}비트.', okPlain: '{baseName}로 읽음.',
    notePrefix: '접두사 {prefix}를 보고 {baseName}로 읽었습니다.', notePrefixDigits: '“{prefix}”는 접두사가 아니라 {base}진수 숫자 두 자리로 읽었습니다.',
    noteHash: '앞의 #은 무시했습니다.', noteFullwidth: '전각 문자를 반각으로 읽었습니다.',
    noteRepeat: '괄호 안의 숫자는 끝없이 반복됩니다: 0.0(0011)은 0.000110011…',
    noteTruncated: '…가 붙은 소수는 64자리 안에서 끝나지 않습니다. 표시된 자리는 잘라 낸 값이며 반올림하지 않았습니다.',
    noteSignedNeg: '이 {n}비트 패턴은 최상위 비트가 1이므로 부호 있는 수 {value}로 읽었습니다.',
    twosRange: '{n}비트 범위({min} ~ {max})를 벗어납니다.', twosFraction: '2의 보수는 정수에만 쓸 수 있습니다.',
    twosInfo: '{n}비트: 부호 없음 {unsigned}, 부호 있음 {signed}.',
    err: {
      invalidDigit: '{pos}번째 문자 “{char}”는 {base}진수 숫자가 아닙니다(사용 가능: {allowed}).',
      hintHex: ' 16진수라면 16진법을 고르거나 앞에 0x를 붙이세요.',
      invalidChar: '{pos}번째 문자 “{char}”는 숫자에 쓸 수 없습니다.',
      sepPlace: '{pos}번째 구분 기호 “{char}”는 두 숫자 사이에만 올 수 있습니다.',
      comma: '{pos}번째 문자는 쉼표입니다. 쉼표는 10진수의 세 자리 구분(1,000,000)으로만 읽습니다. 소수점은 .을 쓰세요.',
      secondPoint: '{pos}번째 문자는 두 번째 소수점입니다.',
      signPlace: '{pos}번째 부호 “{char}”: 부호는 맨 앞에만 올 수 있습니다.',
      noDigits: '변환할 숫자가 없습니다.',
      prefixMismatch: '{prefix}는 {prefixName} 접두사인데 입력 진법은 {base}입니다. {prefixName}나 10진수를 고르거나 접두사를 지우세요.',
      tooLong: '{max}자리를 넘습니다.',
      signedFraction: '부호 있는 수(2의 보수)로 읽으려면 정수를 입력하세요.',
      signedRange: '{value}는 부호 있는 {n}비트 범위({min} ~ {max})를 벗어납니다.',
      signedWide: '입력에 {bits}비트가 필요합니다. {n}비트 패턴은 {n}비트뿐입니다.'
    }
  }
} as const;

const T = STRINGS[lang];
const otherBases = Array.from({ length: 35 }, (_, i) => i + 2).filter((b) => ![2, 8, 10, 16].includes(b));
const allBases = Array.from({ length: 35 }, (_, i) => i + 2);
const baseLabel = (b: number) => b in T.baseNames ? `${T.baseNames[b as 2 | 8 | 10 | 16]} (${b})` : T.baseN.replace('{n}', String(b));
const widths = [8, 16, 32, 64, 128];
const resultBases = [10, 2, 16, 8] as const;
---

<div>
  <div class="nb-wrap">
    <div class="nb-in-row">
      <div class="nb-field nb-field-base">
        <label class="tool-label" for="nb-base">{T.inputBase}</label>
        <select id="nb-base" class="tool-input">
          {[2, 8, 10, 16].map((b) => <option value={b} selected={b === 10}>{baseLabel(b)}</option>)}
          <optgroup label={T.otherBases}>
            {otherBases.map((b) => <option value={b}>{baseLabel(b)}</option>)}
          </optgroup>
        </select>
      </div>
      <div class="nb-field nb-field-num">
        <label class="tool-label" for="nb-input">{T.number}</label>
        <input id="nb-input" class="tool-input" type="text" placeholder={T.placeholder} spellcheck="false" autocomplete="off" autocapitalize="off" />
      </div>
    </div>

    <div id="nb-status" class="tool-status nb-status" aria-live="polite"></div>

    <div class="nb-results">
      {resultBases.map((b) => (
        <div class="nb-row" data-base={b}>
          <span class="nb-key" id={`nb-key-${b}`}>{T.baseShort[b]}</span>
          <output id={`nb-out-${b}`} class="nb-value" aria-labelledby={`nb-key-${b}`}></output>
          <button class="btn-copy" type="button" data-copy={`nb-out-${b}`}>{T.copy}</button>
        </div>
      ))}
      <div class="nb-row nb-row-other" data-base="other">
        <span class="nb-key">
          <label class="nb-sr" for="nb-other-base">{T.outOther}</label>
          <select id="nb-other-base" class="nb-other-select">
            {allBases.map((b) => <option value={b} selected={b === 36}>{T.baseN.replace('{n}', String(b))}</option>)}
          </select>
        </span>
        <output id="nb-out-other" class="nb-value" aria-label={T.outOther}></output>
        <button class="btn-copy" type="button" data-copy="nb-out-other">{T.copy}</button>
      </div>
      <div class="nb-row nb-twos" hidden>
        <span class="nb-key" id="nb-key-twos-bin"></span>
        <output id="nb-out-twos-bin" class="nb-value" aria-labelledby="nb-key-twos-bin"></output>
        <button class="btn-copy" type="button" data-copy="nb-out-twos-bin">{T.copy}</button>
      </div>
      <div class="nb-row nb-twos" hidden>
        <span class="nb-key" id="nb-key-twos-hex"></span>
        <output id="nb-out-twos-hex" class="nb-value" aria-labelledby="nb-key-twos-hex"></output>
        <button class="btn-copy" type="button" data-copy="nb-out-twos-hex">{T.copy}</button>
      </div>
      <p id="nb-twos-info" class="nb-twos-info" hidden></p>
    </div>

    <div class="nb-opts">
      <label class="nb-opt">{T.optGroup}
        <select id="nb-group" class="nb-small-select">
          <option value="none">{T.groupNone}</option>
          <option value="underscore">{T.groupUnderscore}</option>
          <option value="space">{T.groupSpace}</option>
        </select>
      </label>
      <label class="nb-opt"><input type="checkbox" id="nb-prefix" /> {T.optPrefix}</label>
      <label class="nb-opt"><input type="checkbox" id="nb-lower" /> {T.optLower}</label>
      <label class="nb-opt">{T.optWidth}
        <select id="nb-width" class="nb-small-select">
          <option value="0">{T.widthOff}</option>
          {widths.map((w) => <option value={w}>{T.widthBits.replace('{n}', String(w))}</option>)}
        </select>
      </label>
      <label class="nb-opt"><input type="checkbox" id="nb-signed" disabled /> {T.optSigned}</label>
      <button id="nb-clear" class="btn-ghost nb-clear" type="button">{T.clear}</button>
    </div>

    <details class="nb-steps" id="nb-steps">
      <summary>{T.stepsSummary}</summary>
      <label class="nb-opt nb-steps-target">{T.stepsTarget}
        <select id="nb-steps-base" class="nb-small-select">
          {allBases.map((b) => <option value={b} selected={b === 2}>{b}</option>)}
        </select>
      </label>
      <pre id="nb-steps-out" class="nb-steps-out"></pre>
    </details>
  </div>

  <script is:inline define:vars={{ t: T }}>
    (function () {
      /* ── engine:start ── */
      var DIGITS = '0123456789abcdefghijklmnopqrstuvwxyz';
      var MAX_DIGITS = 20000;
      var MAX_FRAC = 64;
      var PREFIX_BASE = { b: 2, o: 8, x: 16 };
      var SEPARATORS = { ' ': 1, '\t': 1, '\n': 1, '\r': 1, '_': 1, "'": 1 };
      var SPACES = { '\u00a0': 1, '\u2007': 1, '\u2009': 1, '\u202f': 1, '\u205f': 1, '\u3000': 1 };
      var MINUS = { '\u2212': 1, '\u2010': 1, '\u2011': 1, '\u2012': 1, '\u2013': 1, '\ufe63': 1 };

      function fill(tpl, fields) {
        return String(tpl).replace(/\{(\w+)\}/g, function (m, k) {
          return fields && fields[k] !== undefined ? String(fields[k]) : m;
