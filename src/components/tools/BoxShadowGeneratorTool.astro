---
import Toggletip from '../Toggletip.astro';
// BoxShadowGeneratorTool — CSS box-shadow visual generator
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: {
    hOffset: 'Horizontal Offset',
    vOffset: 'Vertical Offset',
    blur: 'Blur Radius',
    spread: 'Spread Radius',
    opacity: 'Opacity',
    color: 'Shadow Color',
    inset: 'Inset',
    preview: 'Preview',
    outputLabel: 'Generated CSS',
    copy: 'Copy',
    copied: 'Copied!',
    copyFailed: 'Copy failed',
    badColor: 'Enter # followed by 6 hex digits, or 8 to set opacity too. The previous color is kept.',
    px: 'px',
    pct: '%',
    empty: "Adjust a control to preview the shadow.",
    tips: {
      "h": "Move the shadow left with a negative value or right with a positive value, from −50 to 50px. The preview and CSS update as you move the slider.",
      "v": "Move the shadow up with a negative value or down with a positive value, from −50 to 50px.",
      "blur": "Set the blur radius from 0 to 100px. Zero gives a hard edge; larger values soften it.",
      "spread": "Expand the shadow with a positive value or shrink it with a negative value, from −50 to 50px.",
      "opacity": "Set opacity from 0% to 100% in whole percent. The CSS writes the alpha value in rgba() with two decimal places.",
      "color": "Choose a color or enter # followed by six hex digits. Eight digits also set the opacity from the last two (rounded to a whole percent); moving the opacity slider afterwards removes those two digits. Other text keeps the previous color and shows a hint. Ctrl/⌘+L clears the result while keeping the slider, color picker and inset settings.",
      "inset": "Turn this on to add inset and draw the shadow inside the box. The tool generates one shadow at a time.",
      "copy": "Copy the complete box-shadow declaration. Change any control to update it immediately; no Generate button is needed. If copying fails, try again or select the CSS and copy it by hand."
    },
  },
  zh: {
    hOffset: '水平偏移',
    vOffset: '垂直偏移',
    blur: '模糊半径',
    spread: '扩散半径',
    opacity: '不透明度',
    color: '阴影颜色',
    inset: '内阴影',
    preview: '预览',
    outputLabel: '生成的 CSS',
    copy: '复制',
    copied: '已复制！',
    copyFailed: '复制失败',
    badColor: '请输入 # 加 6 位十六进制数，或 8 位（同时设置不透明度）。已保留原颜色。',
    px: 'px',
    pct: '%',
    empty: "调整任意控件即可预览阴影。",
    tips: {
      "h": "水平偏移范围为 −50 到 50px，负值向左、正值向右。拖动滑块时预览与 CSS 同时更新。",
      "v": "垂直偏移范围为 −50 到 50px，负值向上、正值向下。",
      "blur": "模糊半径范围为 0 到 100px。0 表示硬边缘，较大的值让边缘更柔和。",
      "spread": "扩散半径范围为 −50 到 50px，正值扩大阴影、负值缩小阴影。",
      "opacity": "以整数百分比设置 0% 到 100% 的不透明度，CSS 在 rgba() 中将透明度写为两位小数。",
      "color": "选择颜色或输入 # 加六位十六进制数字。输入八位时，最后两位同时设置不透明度（取整到百分比），之后拖动不透明度滑块会去掉这两位。其他文字保留原颜色并显示提示。Ctrl/⌘+L 清空结果并保留滑块、颜色选择器和内阴影设置。",
      "inset": "开启后添加 inset，在框内绘制阴影。工具每次生成一个阴影。",
      "copy": "复制完整的 box-shadow 声明。修改任意控件都会立即更新，无需生成按钮。复制失败时可重试，或选中 CSS 手动复制。"
    },
  },
  ja: {
    hOffset: '水平オフセット',
    vOffset: '垂直オフセット',
    blur: 'ブラー半径',
    spread: 'スプレッド半径',
    opacity: '不透明度',
    color: 'シャドウカラー',
    inset: 'インセット',
    preview: 'プレビュー',
    outputLabel: '生成された CSS',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyFailed: 'コピーに失敗しました',
    badColor: '#と6桁の16進数（不透明度も指定するなら8桁）を入力してください。色は元のままです。',
    px: 'px',
    pct: '%',
    empty: "コントロールを調整するとシャドウをプレビューできます。",
    tips: {
      "h": "水平オフセットは−50〜50pxです。負の値で左、正の値で右へ移動し、スライダーの変更でプレビューとCSSが更新されます。",
      "v": "垂直オフセットは−50〜50pxです。負の値で上、正の値で下へ移動します。",
      "blur": "ブラー半径は0〜100pxです。0はシャープなエッジになり、大きい値ほど柔らかくなります。",
      "spread": "スプレッド半径は−50〜50pxです。正の値でシャドウを拡大し、負の値で縮小します。",
      "opacity": "不透明度を0%〜100%の整数で設定します。CSSではrgba()のアルファ値を小数点以下2桁で出力します。",
      "color": "色を選択するか、#に続けて6桁の16進数を入力します。8桁にすると最後の2桁で不透明度も設定します（整数のパーセントに丸めます）。その後で不透明度スライダーを動かすと、この2桁は消えます。それ以外の文字列では元の色を保持し、ヒントを表示します。Ctrl/⌘+Lで結果を消去し、スライダー、カラーピッカー、インセットの設定を保持します。",
      "inset": "オンにするとinsetを追加してボックスの内側にシャドウを描きます。一度に生成するシャドウは1つです。",
      "copy": "box-shadow宣言全体をコピーします。コントロールを変更すると即座に更新され、生成ボタンは不要です。コピーに失敗したら再試行するか、CSSを選択して手動でコピーしてください。"
    },
  },
  ko: {
    hOffset: '수평 오프셋',
    vOffset: '수직 오프셋',
    blur: '블러 반경',
    spread: '스프레드 반경',
    opacity: '불투명도',
    color: '그림자 색상',
    inset: '인셋',
    preview: '미리보기',
    outputLabel: '생성된 CSS',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사 실패',
    badColor: '# 뒤에 16진수 6자리(불투명도까지 지정하려면 8자리)를 입력하세요. 기존 색상을 유지합니다.',
    px: 'px',
    pct: '%',
    empty: "컨트롤을 조정하면 그림자를 미리 볼 수 있습니다.",
    tips: {
      "h": "수평 오프셋 범위는 −50~50px입니다. 음수는 왼쪽, 양수는 오른쪽으로 이동하며 슬라이더를 움직이면 미리보기와 CSS가 업데이트됩니다.",
      "v": "수직 오프셋 범위는 −50~50px입니다. 음수는 위로, 양수는 아래로 이동합니다.",
      "blur": "블러 반경은 0~100px입니다. 0은 날카로운 테두리이며 값이 커질수록 부드러워집니다.",
      "spread": "스프레드 반경은 −50~50px입니다. 양수는 그림자를 확대하고 음수는 축소합니다.",
      "opacity": "불투명도를 0%~100%의 정수로 설정합니다. CSS는 rgba()의 알파 값을 소수점 둘째 자리까지 출력합니다.",
      "color": "색상을 선택하거나 # 뒤에 6자리 16진수를 입력합니다. 8자리로 입력하면 마지막 두 자리로 불투명도도 정합니다(정수 퍼센트로 반올림). 그 뒤 불투명도 슬라이더를 움직이면 이 두 자리는 지워집니다. 그 밖의 문자열은 기존 색상을 유지하고 안내를 표시합니다. Ctrl/⌘+L은 결과를 지우고 슬라이더, 색상 선택기, 인셋 설정은 유지합니다.",
      "inset": "켜면 inset을 추가해 상자 안쪽에 그림자를 그립니다. 한 번에 하나의 그림자를 생성합니다.",
      "copy": "전체 box-shadow 선언을 복사합니다. 컨트롤을 바꾸면 즉시 업데이트되므로 생성 버튼이 필요하지 않습니다. 복사가 실패하면 다시 시도하거나 CSS를 선택해 직접 복사하세요."
    },
  },
};
// strings:end

const L = STRINGS[lang] ?? STRINGS.en;
---

<div
  class="bsg-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-bad-color={L.badColor}
>
  <div class="bsg-body">
    <div class="bsg-rail zt-rail">
      <div class="bsg-controls">
        <div class="bsg-field">
          <div class="bsg-field-header">
            <label class="bsg-label" for="bsg-h">{L.hOffset}</label>
            <Toggletip id="bsg-tip-h" lang={lang} about={L.hOffset}>{L.tips.h}</Toggletip>
          </div>
          <div class="bsg-range-row">
            <input id="bsg-h" class="bsg-slider" type="range" min="-50" max="50" value="5" />
            <span class="bsg-val" id="bsg-h-val">5px</span>
          </div>
        </div>
        <div class="bsg-field">
          <div class="bsg-field-header">
            <label class="bsg-label" for="bsg-v">{L.vOffset}</label>
            <Toggletip id="bsg-tip-v" lang={lang} about={L.vOffset}>{L.tips.v}</Toggletip>
          </div>
          <div class="bsg-range-row">
            <input id="bsg-v" class="bsg-slider" type="range" min="-50" max="50" value="5" />
            <span class="bsg-val" id="bsg-v-val">5px</span>
          </div>
        </div>
        <div class="bsg-field">
          <div class="bsg-field-header">
            <label class="bsg-label" for="bsg-blur">{L.blur}</label>
            <Toggletip id="bsg-tip-blur" lang={lang} about={L.blur}>{L.tips.blur}</Toggletip>
          </div>
          <div class="bsg-range-row">
            <input id="bsg-blur" class="bsg-slider" type="range" min="0" max="100" value="10" />
            <span class="bsg-val" id="bsg-blur-val">10px</span>
          </div>
        </div>
        <div class="bsg-field">
          <div class="bsg-field-header">
            <label class="bsg-label" for="bsg-spread">{L.spread}</label>
            <Toggletip id="bsg-tip-spread" lang={lang} about={L.spread}>{L.tips.spread}</Toggletip>
          </div>
          <div class="bsg-range-row">
            <input id="bsg-spread" class="bsg-slider" type="range" min="-50" max="50" value="0" />
            <span class="bsg-val" id="bsg-spread-val">0px</span>
          </div>
        </div>
        <div class="bsg-field">
          <div class="bsg-field-header">
            <label class="bsg-label" for="bsg-opacity">{L.opacity}</label>
            <Toggletip id="bsg-tip-opacity" lang={lang} about={L.opacity}>{L.tips.opacity}</Toggletip>
          </div>
          <div class="bsg-range-row">
            <input id="bsg-opacity" class="bsg-slider" type="range" min="0" max="100" value="30" />
            <span class="bsg-val" id="bsg-opacity-val">30%</span>
          </div>
        </div>
        <div class="bsg-field bsg-field-inset">
          <div class="bsg-field-header">
            <label class="bsg-label" for="bsg-inset">{L.inset}</label>
            <Toggletip id="bsg-tip-inset" lang={lang} about={L.inset}>{L.tips.inset}</Toggletip>
          </div>
          <label class="bsg-toggle">
            <input id="bsg-inset" type="checkbox" class="bsg-toggle-input" />
            <span class="bsg-toggle-track"></span>
          </label>
        </div>
      </div>
      <div class="bsg-field bsg-field-color">
        <div class="bsg-field-header">
          <label id="bsg-color-label" class="bsg-label" for="bsg-color-hex">{L.color}</label>
          <Toggletip id="bsg-tip-color" lang={lang} about={L.color}>{L.tips.color}</Toggletip>
        </div>
        <div class="bsg-color-input-wrap">
          <input id="bsg-color" class="bsg-swatch" type="color" value="#000000" aria-label={L.color} />
          <input id="bsg-color-hex" class="tool-input bsg-hex-input" type="text" value="#000000" spellcheck="false" autocomplete="off" maxlength="16" aria-labelledby="bsg-color-label" />
        </div>
      </div>
      <div class="bsg-output-section">
        <div class="bsg-output-header">
          <div class="bsg-output-label">
            <span class="bsg-section-label">{L.outputLabel}</span>
            <Toggletip id="bsg-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip>
          </div>
          <button id="bsg-copy" class="btn-copy" type="button">{L.copy}</button>
        </div>
        <p id="bsg-status" class="tool-status" role="status"></p>
        <pre class="bsg-pre" tabindex="0" role="region" aria-label={L.outputLabel}><code id="bsg-code" class="bsg-code"></code></pre>
      </div>
    </div>
    <div id="bsg-preview-section" class="bsg-preview-section" data-empty="false">
      <span class="bsg-section-label">{L.preview}</span>
      <div class="bsg-preview-canvas">
        <p id="bsg-empty" class="bsg-empty" hidden>{L.empty}</p>
        <div id="bsg-preview-box" class="bsg-preview-box"></div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.bsg-wrap')
        : document.querySelector('.bsg-wrap');

      var COPY_LABEL   = wrap.dataset.copy;
      var COPIED_LABEL = wrap.dataset.copied;
      var COPY_FAILED_LABEL = wrap.dataset.copyFailed;
      var BAD_COLOR_LABEL = wrap.dataset.badColor;

      var hEl       = document.getElementById('bsg-h');
      var vEl       = document.getElementById('bsg-v');
      var blurEl    = document.getElementById('bsg-blur');
      var spreadEl  = document.getElementById('bsg-spread');
      var opacityEl = document.getElementById('bsg-opacity');
      var colorEl   = document.getElementById('bsg-color');
      var hexEl     = document.getElementById('bsg-color-hex');
      var insetEl   = document.getElementById('bsg-inset');
      var previewEl = document.getElementById('bsg-preview-box');
      var codeEl    = document.getElementById('bsg-code');
      var copyBtn   = document.getElementById('bsg-copy');
      var statusEl  = document.getElementById('bsg-status');
      var emptyEl   = document.getElementById('bsg-empty');
      var resultEl  = document.getElementById('bsg-preview-section');

      var hValEl       = document.getElementById('bsg-h-val');
      var vValEl       = document.getElementById('bsg-v-val');
      var blurValEl    = document.getElementById('bsg-blur-val');
      var spreadValEl  = document.getElementById('bsg-spread-val');
      var opacityValEl = document.getElementById('bsg-opacity-val');

      function hexToRgb(hex) {
        var r = parseInt(hex.slice(1, 3), 16);
        var g = parseInt(hex.slice(3, 5), 16);
        var b = parseInt(hex.slice(5, 7), 16);
        return { r: r, g: g, b: b };
      }

      function generate() {
        var h       = parseInt(hEl.value);
        var v       = parseInt(vEl.value);
        var blur    = parseInt(blurEl.value);
        var spread  = parseInt(spreadEl.value);
        var opacity = parseInt(opacityEl.value) / 100;
        var hex     = colorEl.value;
        var inset   = insetEl.checked;

        hValEl.textContent       = h + 'px';
        vValEl.textContent       = v + 'px';
        blurValEl.textContent    = blur + 'px';
        spreadValEl.textContent  = spread + 'px';
        opacityValEl.textContent = Math.round(opacity * 100) + '%';

        var rgb = hexToRgb(hex);
        var shadow = (inset ? 'inset ' : '') +
          h + 'px ' +
          v + 'px ' +
          blur + 'px ' +
          spread + 'px ' +
          'rgba(' + rgb.r + ', ' + rgb.g + ', ' + rgb.b + ', ' + opacity.toFixed(2) + ')';

        previewEl.style.boxShadow = shadow;

        var css = 'box-shadow: ' + shadow + ';';
        codeEl.innerHTML =
          '<span class="bsg-hl-prop">box-shadow</span>' +
          '<span class="bsg-hl-colon">: </span>' +
          (inset ? '<span class="bsg-hl-kw">inset </span>' : '') +
          '<span class="bsg-hl-num">' + h + 'px ' + v + 'px ' + blur + 'px ' + spread + 'px</span> ' +
          '<span class="bsg-hl-color">rgba(' + rgb.r + ', ' + rgb.g + ', ' + rgb.b + ', ' + opacity.toFixed(2) + ')</span>' +
          '<span class="bsg-hl-semi">;</span>';

        copyBtn.disabled = false;
      }

      var copyRequest = 0;
      var copyTimer = 0;

      function resetCopyFeedback() {
        copyRequest++;
        clearTimeout(copyTimer);
        copyTimer = 0;
        copyBtn.textContent = COPY_LABEL;
        copyBtn.classList.remove('copied');
        statusEl.textContent = '';
        statusEl.className = 'tool-status';
      }

      function refresh() {
        resetCopyFeedback();
        generate();
        previewEl.hidden = false;
        emptyEl.hidden = true;
        resultEl.dataset.empty = 'false';
      }

      /* Sync color swatch <-> hex input */
      colorEl.addEventListener('input', function () {
        hexEl.value = colorEl.value;
        refresh();
      });

      /* #rrggbb sets the color; #rrggbbaa also sets the opacity slider (alpha / 255, whole percent). */
      function readHex(v) {
        var m = /^#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?$/.exec(v);
        if (!m) return null;
        return { color: '#' + m[1].toLowerCase(), opacity: m[2] ? Math.round(parseInt(m[2], 16) / 255 * 100) : null };
      }
      function showColorHint() {
        statusEl.textContent = BAD_COLOR_LABEL;
        statusEl.className = 'tool-status error';
      }

      hexEl.addEventListener('input', function () {
        var v = hexEl.value.trim();
        var hex = readHex(v);
        if (hex) {
          colorEl.value = hex.color;
          if (hex.opacity !== null) opacityEl.value = String(hex.opacity);
        }
        refresh();
        /* Text that typing more digits cannot make valid (rgba(), names, full-width characters). */
        if (!hex && v && !/^#?[0-9a-fA-F]{0,8}$/.test(v)) showColorHint();
      });
      hexEl.addEventListener('change', function () {
        var v = hexEl.value.trim();
        if (v && !readHex(v)) showColorHint();
      });

      [hEl, vEl, blurEl, spreadEl, opacityEl].forEach(function (el) {
        el.addEventListener('input', refresh);
      });

      insetEl.addEventListener('change', refresh);

      /* After #rrggbbaa, the slider owns the opacity: drop the alpha digits so the field matches it. */
      opacityEl.addEventListener('input', function () {
        var v = hexEl.value.trim();
        if (/^#[0-9a-fA-F]{8}$/.test(v)) hexEl.value = v.slice(0, 7);
      });

      /* Analytics: one event per committed change (as in color-palette-generator), not per input event. */
      function trackGenerate() {
        if (codeEl.textContent) window.trackTool && window.trackTool('box-shadow-generator', 'generate');
      }
      [hEl, vEl, blurEl, spreadEl, opacityEl, colorEl, insetEl].forEach(function (el) {
        el.addEventListener('change', trackGenerate);
      });
      hexEl.addEventListener('change', function () {
        if (readHex(hexEl.value.trim())) trackGenerate();
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l') return;
        if (!document.activeElement || !wrap.contains(document.activeElement)) return;
        e.preventDefault();
        resetCopyFeedback();
        hexEl.value = '';
        codeEl.textContent = '';
        previewEl.style.boxShadow = '';
        copyBtn.disabled = true;
        previewEl.hidden = true;
        emptyEl.hidden = false;
        resultEl.dataset.empty = 'true';
      });

      copyBtn.addEventListener('click', async function () {
        var text = codeEl.textContent;
        if (!text) return;
        resetCopyFeedback();
        var request = copyRequest;
        try {
          await navigator.clipboard.writeText(text);
          if (request !== copyRequest) return;
          copyBtn.textContent = COPIED_LABEL;
          copyTimer = setTimeout(function () {
            if (request === copyRequest) copyBtn.textContent = COPY_LABEL;
          }, 1500);
          window.trackTool && window.trackTool('box-shadow-generator', 'copy');
        } catch (_) {
          if (request === copyRequest) {
            copyBtn.textContent = COPY_FAILED_LABEL;
            statusEl.textContent = COPY_FAILED_LABEL;
            statusEl.className = 'tool-status error';
          }
        }
      });

      refresh();
    })();
  </script>
</div>

<style>
  .bsg-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .bsg-body { display: grid; grid-template-columns: clamp(270px, 24vw, 320px) minmax(0, 1fr); gap: 1.5rem; flex: 1 1 0; min-height: 0; }
  .bsg-rail { overflow: auto; padding-right: 0.3rem; }
  .bsg-controls { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
  .bsg-field { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .bsg-field-header, .bsg-output-label { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
  .bsg-field-header .bsg-label { flex: 1; min-width: 0; }
