---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: {
    tips: {
      "actions": "Format prints parsed GraphQL and removes comments; Minify removes ignored whitespace and comments. Validate checks syntax only and keeps the current output on success. Ctrl/⌘+Enter runs Format.",
      "indent": "Choose 2 or 4 spaces, then click Format to apply the setting. Only structural indentation widens; block-string text keeps its relative indentation.",
      "clear": "Clear removes input, output, status and pending parser actions. Ctrl/⌘+L does the same while focus is in this tool.",
      "input": "Enter a query, mutation, subscription, fragment or SDL definition, up to 10,485,760 characters. Editing does not run an action. Load sample inserts and formats the example.",
      "output": "Format and Minify replace this read-only output. Editing the input or changing indentation leaves the last output until you run Format or Minify.",
      "exportText": "Copy and Download .graphql use the complete current output. The downloaded file is named query.graphql; input edits are included only after Format or Minify."
    },
    copyFailed: 'Copy failed. Try again.',
    inputLabel: 'GraphQL Input', sample: 'Load sample',
    indent: 'Indent:', indent2: '2 spaces', indent4: '4 spaces',
    format: 'Format', minify: 'Minify', validate: 'Validate', clear: 'Clear',
    output: 'Output', copy: 'Copy', copied: 'Copied!', download: 'Download .graphql',
    outputPlaceholder: 'Formatted GraphQL appears here...',
    formatted: 'Formatted.', minified: 'Minified.', valid: 'Valid GraphQL.',
    parseError: 'Parse error', emptyInput: 'Paste GraphQL to format.',
    tooLarge: 'Input exceeds 10 MB. Use prettier --parser graphql locally.',
    libLoading: 'Loading GraphQL parser...',
    stats: "{ops} definition(s), {chars} chars",
    line: 'line', column: 'column'
  },
  zh: {
    tips: {
      "actions": "格式化会重新打印解析后的 GraphQL 并删除注释；压缩会删除可忽略的空白与注释。校验仅检查语法，成功时保留当前输出。Ctrl/⌘+Enter 执行格式化。",
      "indent": "选择 2 或 4 个空格，再点击格式化应用设置。只加宽结构缩进；块字符串文字保留相对缩进。",
      "clear": "清除会清空输入、输出、状态和等待解析器的操作。焦点在工具内时，Ctrl/⌘+L 执行相同操作。",
      "input": "输入查询、变更、订阅、片段或 SDL 定义，上限 10,485,760 个字符。编辑不会自动执行操作；载入示例会填入并格式化示例。",
      "output": "格式化和压缩会替换此只读输出。修改输入或缩进后，原输出会保留到再次格式化或压缩。",
      "exportText": "复制与下载 .graphql 使用当前完整输出。文件名为 query.graphql；编辑输入后需先格式化或压缩，才能导出更新后的内容。"
    },
    copyFailed: '复制失败，请重试。',
    inputLabel: 'GraphQL 输入', sample: '载入示例',
    indent: '缩进：', indent2: '2 个空格', indent4: '4 个空格',
    format: '格式化', minify: '压缩', validate: '校验', clear: '清除',
    output: '输出', copy: '复制', copied: '已复制！', download: '下载 .graphql',
    outputPlaceholder: '格式化后的 GraphQL 显示在此处...',
    formatted: '已格式化。', minified: '已压缩。', valid: 'GraphQL 语法有效。',
    parseError: '解析错误', emptyInput: '粘贴 GraphQL 以开始。',
    tooLarge: '输入超过 10 MB，请在本地使用 prettier --parser graphql。',
    libLoading: '正在加载 GraphQL 解析器...',
    stats: "{ops} 个定义，{chars} 字符",
    line: '行', column: '列'
  },
  ja: {
    tips: {
      "actions": "整形は解析した GraphQL を再出力し、コメントを削除します。圧縮は無視できる空白とコメントを削除します。検証は構文のみを確認し、成功時は現在の出力を保持します。Ctrl/⌘+Enter は整形を実行します。",
      "indent": "2 または 4 スペースを選び、整形を押して適用します。構造のインデントだけを広げ、ブロック文字列内の相対的なインデントは保持します。",
      "clear": "クリアは入力、出力、ステータスとパーサー待機中の操作を消去します。ツール内にフォーカスがあれば Ctrl/⌘+L でも実行できます。",
      "input": "query、mutation、subscription、fragment、SDL 定義を最大 10,485,760 文字まで入力できます。編集だけでは実行しません。サンプルを読み込むと例を挿入して整形します。",
      "output": "整形と圧縮はこの読み取り専用出力を置き換えます。入力やインデントを変更しても、整形または圧縮を実行するまで前の出力を保持します。",
      "exportText": "コピーと .graphql をダウンロードは現在の出力全体を使います。ファイル名は query.graphql です。入力の変更を含めるには先に整形または圧縮を実行してください。"
    },
    copyFailed: 'コピーに失敗しました。再試行してください。',
    inputLabel: 'GraphQL 入力', sample: 'サンプルを読み込む',
    indent: 'インデント：', indent2: '2 スペース', indent4: '4 スペース',
    format: '整形', minify: '圧縮', validate: '検証', clear: 'クリア',
    output: '出力', copy: 'コピー', copied: 'コピー済み！', download: '.graphql をダウンロード',
    outputPlaceholder: '整形された GraphQL がここに表示されます...',
    formatted: '整形しました。', minified: '圧縮しました。', valid: 'GraphQL は有効です。',
    parseError: '解析エラー', emptyInput: 'GraphQL を貼り付けてください。',
    tooLarge: '入力が 10 MB を超えています。ローカルで prettier --parser graphql を使用してください。',
    libLoading: 'GraphQL パーサーを読み込み中...',
    stats: "{ops} 定義、{chars} 文字",
    line: '行', column: '列'
  },
  ko: {
    tips: {
      "actions": "형식화는 파싱한 GraphQL을 다시 출력하고 주석을 삭제합니다. 압축은 무시할 수 있는 공백과 주석을 삭제합니다. 검증은 구문만 확인하며 성공하면 현재 출력을 유지합니다. Ctrl/⌘+Enter는 형식화를 실행합니다.",
      "indent": "공백 2개 또는 4개를 선택한 뒤 형식화를 눌러 적용하세요. 구조적 들여쓰기만 넓히며 블록 문자열 안의 상대적 들여쓰기는 유지합니다.",
      "clear": "지우기는 입력, 출력, 상태와 파서를 기다리는 작업을 지웁니다. 도구 안에 포커스가 있을 때 Ctrl/⌘+L도 같은 동작을 합니다.",
      "input": "query, mutation, subscription, fragment 또는 SDL 정의를 최대 10,485,760자까지 입력하세요. 편집만으로는 실행하지 않습니다. 샘플 불러오기는 예제를 넣고 형식화합니다.",
      "output": "형식화와 압축은 이 읽기 전용 출력을 바꿉니다. 입력이나 들여쓰기를 바꿔도 형식화 또는 압축을 실행할 때까지 이전 출력을 유지합니다.",
      "exportText": "복사와 .graphql 다운로드는 현재 출력 전체를 사용합니다. 파일명은 query.graphql입니다. 입력 수정 내용을 포함하려면 먼저 형식화 또는 압축을 실행하세요."
    },
    copyFailed: '복사하지 못했습니다. 다시 시도하세요.',
    inputLabel: 'GraphQL 입력', sample: '샘플 불러오기',
    indent: '들여쓰기:', indent2: '공백 2개', indent4: '공백 4개',
    format: '형식화', minify: '압축', validate: '검증', clear: '지우기',
    output: '출력', copy: '복사', copied: '복사됨!', download: '.graphql 다운로드',
    outputPlaceholder: '형식화된 GraphQL이 여기에 표시됩니다...',
    formatted: '형식화 완료.', minified: '압축 완료.', valid: '유효한 GraphQL입니다.',
    parseError: '파싱 오류', emptyInput: 'GraphQL을 붙여넣어 시작하세요.',
    tooLarge: '입력이 10MB를 초과합니다. 로컬에서 prettier --parser graphql 사용하세요.',
    libLoading: 'GraphQL 파서 로딩 중...',
    stats: "{ops}개 정의, {chars}자",
    line: '줄', column: '열'
  }
};
// strings:end
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="gqlf-wrap">
  <div class="gqlf-actions">
    <div class="gqlf-control gqlf-primary-actions">
      <button id="gqlf-format" class="btn-primary" type="button">{T.format}</button>
      <button id="gqlf-minify" class="btn-secondary" type="button">{T.minify}</button>
      <button id="gqlf-validate" class="btn-secondary" type="button">{T.validate}</button>
      <Toggletip id="gqlf-tip-actions" lang={lang} about={T.format + ' / ' + T.minify + ' / ' + T.validate}>{TIPS.actions}</Toggletip>
    </div>
    <div class="gqlf-control">
      <button id="gqlf-clear" class="btn-ghost" type="button">{T.clear}</button>
      <Toggletip id="gqlf-tip-clear" lang={lang} about={T.clear}>{TIPS.clear}</Toggletip>
    </div>
    <div class="gqlf-control gqlf-opt">
      <label for="gqlf-indent">{T.indent}</label>
      <select id="gqlf-indent">
        <option value="2">{T.indent2}</option>
        <option value="4">{T.indent4}</option>
      </select>
      <Toggletip id="gqlf-tip-indent" lang={lang} about={T.indent}>{TIPS.indent}</Toggletip>
    </div>
  </div>
  <div id="gqlf-status" class="tool-status" aria-live="polite"></div>

  <div class="gqlf-panels zt-io">
    <div class="gqlf-panel zt-io-pane">
      <div class="gqlf-panel-head">
        <div class="gqlf-control">
          <label for="gqlf-input">{T.inputLabel}</label>
          <Toggletip id="gqlf-tip-input" lang={lang} about={T.inputLabel}>{TIPS.input}</Toggletip>
        </div>
        <button id="gqlf-sample" class="btn-ghost gqlf-sample-btn" type="button">{T.sample}</button>
      </div>
      <textarea id="gqlf-input" class="tool-textarea gqlf-textarea zt-io-fill" placeholder="query GetUser($id: ID!) { user(id: $id) { id name email } }" spellcheck="false"></textarea>
    </div>
    <div class="gqlf-panel gqlf-output-pane zt-io-pane">
      <div class="gqlf-panel-head gqlf-output-head">
        <div class="gqlf-control">
          <label for="gqlf-output">{T.output}</label>
          <Toggletip id="gqlf-tip-output" lang={lang} about={T.output}>{TIPS.output}</Toggletip>
        </div>
        <div class="gqlf-control gqlf-out-actions">
          <button id="gqlf-copy" class="btn-copy" type="button">{T.copy}</button>
          <button id="gqlf-download" class="btn-ghost gqlf-dl-btn" type="button">{T.download}</button>
          <Toggletip id="gqlf-tip-export" lang={lang} about={T.copy + ' / ' + T.download}>{TIPS.exportText}</Toggletip>
        </div>
      </div>
      <textarea id="gqlf-output" class="tool-textarea gqlf-textarea zt-io-fill" placeholder={T.outputPlaceholder} readonly spellcheck="false"></textarea>
    </div>
  </div>

  <script>
    import { parse, print, Source, stripIgnoredCharacters, GraphQLError } from 'graphql';
    (window as any).__gqlfLib = { parse, print, Source, stripIgnoredCharacters, GraphQLError };
    window.dispatchEvent(new Event('gqlf-lib-ready'));
  </script>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var SAMPLE = [
        'query GetUser($id: ID!, $withPosts: Boolean!) {',
        '  user(id: $id) {',
        '    id name email',
        '    posts @include(if: $withPosts) {',
        '      ...PostSummary',
        '    }',
        '  }',
        '}',
        '',
        'fragment PostSummary on Post {',
        '  id title publishedAt',
        '}',
        '',
        'mutation Publish($id: ID!) {',
        '  publishPost(id: $id) { id status }',
        '}'
      ].join('\n');

      var MAX_BYTES = 10 * 1024 * 1024;

      var input = document.getElementById('gqlf-input');
      var output = document.getElementById('gqlf-output');
      var statusEl = document.getElementById('gqlf-status');
      var copyBtn = document.getElementById('gqlf-copy');
      var indentSel = document.getElementById('gqlf-indent');
      var revision = 0, copyRequest = 0, copyTimer = null;

      function resetCopy() {
        copyRequest++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
      }
      function cancelPending() {
        revision++;
        resetCopy();
        if (!getLib()) clearStatus();
      }

      function setStatus(msg, kind) {
        statusEl.textContent = msg;
        statusEl.className = 'tool-status' + (kind ? ' ' + kind : '');
      }
      function clearStatus() { setStatus('', ''); }

      function getLib() { return window.__gqlfLib; }

      function whenLibReady(cb) {
        var request = revision;
        if (getLib()) { cb(); return; }
        setStatus(t.libLoading, '');
        window.addEventListener('gqlf-lib-ready', function once() {
          window.removeEventListener('gqlf-lib-ready', once);
          if (request !== revision) return;
          clearStatus();
          cb();
        });
      }

      function readInput() {
        var raw = input.value;
        raw = raw.replace(/^﻿/, '').replace(/\r\n/g, '\n');
        return raw;
      }

      function reportError(e) {
        var lib = getLib();
        if (lib && e instanceof lib.GraphQLError) {
          var loc = e.locations && e.locations[0];
          var detail = loc ? ' (' + t.line + ' ' + loc.line + ', ' + t.column + ' ' + loc.column + ')' : '';
          setStatus(t.parseError + ': ' + e.message + detail, 'error');
        } else {
          setStatus(t.parseError + ': ' + (e && e.message ? e.message : String(e)), 'error');
        }
        output.value = '';
      }

      function indentStr() {
        return indentSel.value === '4' ? '    ' : '  ';
      }

      /* ── engine:start ── */
      // Offsets [start, end) of every block string ("""...""") in a parsed document.
      function blockStringRanges(ast) {
        var ranges = [];
        (function walk(node) {
          if (!node || typeof node !== 'object') return;
          if (Array.isArray(node)) { for (var i = 0; i < node.length; i++) walk(node[i]); return; }
          if (node.kind === 'StringValue' && node.block && node.loc) ranges.push([node.loc.start, node.loc.end]);
          for (var k in node) if (k !== 'loc' && Object.prototype.hasOwnProperty.call(node, k)) walk(node[k]);
        })(ast);
        return ranges;
      }

      // graphql-js print() indents by 2 spaces per level. For another indent width, change only
      // that structural indentation. Lines inside a block string keep whatever follows the
      // indentation of the line that opens it: the GraphQL spec removes the common indentation
      // of a block string, so changing the relative indentation would change the string value.
      function reindent(text, indent, ranges) {
        if (indent === '  ') return text;
        var lines = text.split('\n');
        var out = [];
        var offset = 0;
        var lineStarts = [];
        for (var i = 0; i < lines.length; i++) { lineStarts.push(offset); offset += lines[i].length + 1; }
        function lineIndexAt(pos) {
          var lo = 0, hi = lineStarts.length - 1;
          while (lo < hi) { var mid = (lo + hi + 1) >> 1; if (lineStarts[mid] <= pos) lo = mid; else hi = mid - 1; }
          return lo;
        }
        var base = new Array(lines.length);
        (ranges || []).forEach(function (r) {
          var open = lineIndexAt(r[0]);
          var close = lineIndexAt(r[1] - 1);
          var openIndent = /^ */.exec(lines[open])[0].length;
          for (var j = open + 1; j <= close; j++) base[j] = openIndent;
        });
        function convert(n) { return new Array(Math.floor(n / 2) + 1).join(indent) + (n % 2 ? ' ' : ''); }
        for (var k = 0; k < lines.length; k++) {
          var line = lines[k];
          if (base[k] !== undefined) {
            var b = base[k];
            if (line.slice(0, b) === new Array(b + 1).join(' ')) out.push(convert(b) + line.slice(b));
            else out.push(line);
          } else {
            var n = /^ */.exec(line)[0].length;
            out.push(convert(n) + line.slice(n));
          }
        }
        return out.join('\n');
      }
      /* ── engine:end ── */

      function doFormat() {
        cancelPending();
        var raw = readInput().trim();
        if (!raw) { setStatus(t.emptyInput, ''); output.value = ''; return; }
        if (raw.length > MAX_BYTES) { setStatus(t.tooLarge, 'error'); output.value = ''; return; }
        whenLibReady(function () {
          var lib = getLib();
          try {
            var ast = lib.parse(new lib.Source(raw));
            var printed = lib.print(ast);
            output.value = reindent(printed, indentStr(), blockStringRanges(lib.parse(printed)));
            setStatus(t.formatted + ' ' + t.stats.replace('{ops}', ast.definitions.length).replace('{chars}', output.value.length), 'success');
            window.trackTool && window.trackTool('graphql_formatter', 'format');
          } catch (e) { reportError(e); }
        });
      }

      function doMinify() {
        cancelPending();
        var raw = readInput().trim();
        if (!raw) { setStatus(t.emptyInput, ''); output.value = ''; return; }
        if (raw.length > MAX_BYTES) { setStatus(t.tooLarge, 'error'); output.value = ''; return; }
        whenLibReady(function () {
          var lib = getLib();
          try {
            lib.parse(new lib.Source(raw));
            var min = lib.stripIgnoredCharacters(raw);
            output.value = min;
            setStatus(t.minified + ' ' + t.stats.replace('{ops}', 0).replace('{chars}', min.length), 'success');
            window.trackTool && window.trackTool('graphql_formatter', 'minify');
          } catch (e) { reportError(e); }
        });
      }

      function doValidate() {
        cancelPending();
        var raw = readInput().trim();
        if (!raw) { setStatus(t.emptyInput, ''); output.value = ''; return; }
        if (raw.length > MAX_BYTES) { setStatus(t.tooLarge, 'error'); output.value = ''; return; }
        whenLibReady(function () {
          var lib = getLib();
          try {
            var ast = lib.parse(new lib.Source(raw));
            setStatus(t.valid + ' ' + t.stats.replace('{ops}', ast.definitions.length).replace('{chars}', raw.length), 'success');
            window.trackTool && window.trackTool('graphql_formatter', 'validate');
          } catch (e) { reportError(e); }
        });
      }

      document.getElementById('gqlf-format').addEventListener('click', doFormat);
      document.getElementById('gqlf-minify').addEventListener('click', doMinify);
      document.getElementById('gqlf-validate').addEventListener('click', doValidate);
      function clearAll() {
        cancelPending();
        input.value = ''; output.value = ''; clearStatus();
      }
      document.getElementById('gqlf-clear').addEventListener('click', clearAll);
      input.addEventListener('input', cancelPending);
      indentSel.addEventListener('change', resetCopy);
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var wrap = document.querySelector('.gqlf-wrap');
        if (!wrap || !wrap.contains(document.activeElement)) return;
        e.preventDefault();
        input.focus();
        clearAll();
      });
      document.getElementById('gqlf-sample').addEventListener('click', function () {
        input.value = SAMPLE;
        doFormat();
      });

      copyBtn.addEventListener('click', function () {
        var text = output.value;
        if (!text) return;
        var request = ++copyRequest;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        function failed() {
          if (request !== copyRequest || output.value !== text) return;
          copyBtn.textContent = t.copyFailed;
        }
        function done() {
          if (request !== copyRequest || output.value !== text) return;
          copyBtn.textContent = t.copied;
          copyTimer = setTimeout(function () {
            if (request === copyRequest && output.value === text) copyBtn.textContent = t.copy;
          }, 1500);
        }
        try {
          if (!navigator.clipboard || !navigator.clipboard.writeText) { failed(); return; }
          navigator.clipboard.writeText(text).then(done, failed);
        } catch (e) { failed(); }
      });

      document.getElementById('gqlf-download').addEventListener('click', function () {
        var text = output.value;
        if (!text) return;
        var blob = new Blob([text], { type: 'application/graphql' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'query.graphql';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });

      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault();
          e.stopPropagation();
          doFormat();
        }
      });
    })();
  </script>
</div>

<style>
  .gqlf-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; gap: 0.75rem; }
  .gqlf-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; flex: none; }
  .gqlf-control { display: inline-flex; align-items: center; gap: 0.375rem; min-width: 0; }
  .gqlf-primary-actions { gap: 0.5rem; }
  .gqlf-opt { margin-left: auto; font-size: 0.85rem; color: var(--color-text-secondary); }
  .gqlf-opt select { min-height: 44px; min-width: 0; max-width: 100%; padding: 0.4rem 0.65rem; border: 0; border-radius: var(--radius-md); background: var(--color-bg-secondary); color: var(--color-text); box-shadow: inset 0 0 0 1px var(--color-border-soft); }
