.mtoc-toggle { display: inline-flex; align-items: center; min-height: 44px; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); cursor: pointer; }
.mtoc-toggle input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--color-primary); }
