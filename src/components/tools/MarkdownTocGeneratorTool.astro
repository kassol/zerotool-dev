    maxLevelLabel: '최대 제목 레벨',
    includeH1: 'H1 포함',
    markerMode: '마커 모드',
    markerHint: '<!-- toc --> ... <!-- /toc --> 마커 사이의 목차 교체',
    indent2: '공백 2칸',
    indent4: '공백 4칸',
    indentTab: 'Tab',
    bulletDash: '- (하이픈)',
    bulletAsterisk: '* (별표)',
    bulletNumber: '1. (번호)',
    tocOutput: '목차',
    mdOutput: 'TOC 삽입된 Markdown',
    copyToc: 'TOC 복사',
    copyMd: 'Markdown 복사',
    copied: '복사됨!',
    copyFailed: '복사 실패',
    empty: '제목을 찾을 수 없습니다.',
    markerMissing: '<!-- toc --> 마커를 찾을 수 없습니다. TOC가 첫 제목 앞에 삽입됩니다.',
    markerUpdated: '마커 사이에 TOC를 삽입했습니다.',
    markerInserted: '첫 제목 앞에 TOC를 삽입했습니다.',
    markerUnclosed: '<!-- toc --> 마커가 닫혀 있지 않음 — Markdown 변경 없음. 교체를 활성화하려면 <!-- /toc --> 를 추가하세요.',
    formatOptions: "서식 및 제목 단계",
    emptyToc: "생성된 목차가 여기에 표시됩니다.",
    emptyMarkdown: "목차를 삽입한 Markdown이 여기에 표시됩니다.",
    tips: {
      input: "Markdown을 입력하거나 붙여넣으면 제목과 설정 변경이 목차에 즉시 반영됩니다. ATX(#)와 setext 제목을 읽고, 펜스 코드와 기존 목차 마커 블록은 제외합니다.",
      anchor: "대상 GitHub / Hugo, GitLab, Jekyll(GFM), kramdown 또는 Bitbucket Cloud에 맞는 앵커 규칙을 고르세요. 대상 렌더러에서 생성된 링크 하나를 확인하세요.",
      bullet: "하이픈, 별표 또는 번호 목록을 선택합니다. 번호 목록의 각 항목은 1.로 시작하며, 표시 번호는 Markdown 렌더러가 정합니다.",
      indent: "제목 단계마다 공백 2칸, 4칸 또는 탭으로 들여씁니다. 포함된 제목 중 가장 얕은 단계는 들여쓰지 않습니다.",
      min: "이 단계부터 제목을 포함합니다. 범위는 1–6입니다. 최솟값이 최댓값보다 크면 두 값을 작은 순서로 읽습니다.",
      max: "이 단계까지 제목을 포함합니다. 범위는 1–6입니다. 중복 앵커 ID를 정할 때는 범위 밖 제목도 셉니다.",
      h1: "템플릿에서 문서 제목을 이미 표시한다면 H1 포함을 끄세요. 나머지 제목의 앵커 ID는 유지됩니다.",
      marker: "전체 Markdown을 표시하고 <!-- toc -->와 <!-- /toc --> 사이의 목차를 교체합니다. 마커가 없으면 첫 # 제목 앞에 넣고, 닫히지 않은 마커가 있으면 원문을 유지합니다.",
      copyToc: "생성된 Markdown 목차 전체를 복사합니다. 선택 범위에 제목이 없으면 이 버튼은 비활성화됩니다.",
      copyMd: "마커 모드가 생성한 Markdown 전체를 복사합니다. 목차가 비었거나 시작 마커가 닫히지 않았다면 복사할 수 없습니다.",
    },
    headings: (n) => `제목 ${n}개`,
  },
};
// strings:end

const L = STRINGS[lang] ?? STRINGS.en;
const TIPS = L.tips;
---

<div
  class="mtoc-wrap"
  data-lang={lang}
  data-copy={L.copyToc}
  data-copy-md={L.copyMd}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-empty={L.empty}
  data-marker-missing={L.markerMissing}
  data-marker-updated={L.markerUpdated}
  data-marker-inserted={L.markerInserted}
  data-marker-unclosed={L.markerUnclosed}
  data-headings-singular={lang === 'en' ? '1 heading' : (lang === 'zh' ? '共 1 个标题' : (lang === 'ja' ? '見出し 1 件' : '제목 1개'))}
  data-headings-plural-pre={lang === 'en' ? '' : (lang === 'zh' ? '共 ' : (lang === 'ja' ? '見出し ' : '제목 '))}
  data-headings-plural-post={lang === 'en' ? ' headings' : (lang === 'zh' ? ' 个标题' : (lang === 'ja' ? ' 件' : '개'))}
>
  <div class="mtoc-top-controls">
    <div class="mtoc-control mtoc-anchor-control">
      <label class="tool-label" for="mtoc-anchor">{L.anchorLabel}</label>
      <select id="mtoc-anchor" class="tool-input mtoc-select">
          <option value="github">GitHub / Hugo</option>
          <option value="gitlab">GitLab</option>
          <option value="jekyll">Jekyll (kramdown GFM)</option>
          <option value="kramdown">kramdown (input: kramdown)</option>
          <option value="bitbucket">Bitbucket Cloud</option>
        </select>
      <Toggletip id="mtoc-tip-anchor" lang={lang} about={L.anchorLabel}>{TIPS.anchor}</Toggletip>
    </div>
    <div class="mtoc-toggle-control">
      <label class="mtoc-toggle" for="mtoc-marker-mode"><input id="mtoc-marker-mode" type="checkbox" /><span>{L.markerMode}</span></label>
      <Toggletip id="mtoc-tip-marker" lang={lang} about={L.markerMode}>{TIPS.marker}</Toggletip>
    </div>
  </div>
  <details class="mtoc-options" id="mtoc-options">
    <summary>{L.formatOptions}</summary>
    <div class="mtoc-controls-col">
      <div class="mtoc-control">
        <div class="mtoc-label-row"><label class="tool-label" for="mtoc-bullet">{L.bulletLabel}</label><Toggletip id="mtoc-tip-bullet" lang={lang} about={L.bulletLabel}>{TIPS.bullet}</Toggletip></div>
        <select id="mtoc-bullet" class="tool-input mtoc-select">
          <option value="-">{L.bulletDash}</option>
          <option value="*">{L.bulletAsterisk}</option>
          <option value="1.">{L.bulletNumber}</option>
        </select>
      </div>
      <div class="mtoc-control">
        <div class="mtoc-label-row"><label class="tool-label" for="mtoc-indent">{L.indentLabel}</label><Toggletip id="mtoc-tip-indent" lang={lang} about={L.indentLabel}>{TIPS.indent}</Toggletip></div>
        <select id="mtoc-indent" class="tool-input mtoc-select">
          <option value="2">{L.indent2}</option>
          <option value="4">{L.indent4}</option>
          <option value="tab">{L.indentTab}</option>
        </select>
      </div>
      <div class="mtoc-range">
        <div class="mtoc-label-row"><label class="tool-label" for="mtoc-min">{L.minLevelLabel} <span class="mtoc-range-value" id="mtoc-min-value">1</span></label><Toggletip id="mtoc-tip-min" lang={lang} about={L.minLevelLabel}>{TIPS.min}</Toggletip></div>
        <input id="mtoc-min" type="range" min="1" max="6" value="1" />
      </div>
      <div class="mtoc-range">
        <div class="mtoc-label-row"><label class="tool-label" for="mtoc-max">{L.maxLevelLabel} <span class="mtoc-range-value" id="mtoc-max-value">6</span></label><Toggletip id="mtoc-tip-max" lang={lang} about={L.maxLevelLabel}>{TIPS.max}</Toggletip></div>
        <input id="mtoc-max" type="range" min="1" max="6" value="6" />
      </div>
      <div class="mtoc-toggle-control">
        <label class="mtoc-toggle" for="mtoc-include-h1"><input id="mtoc-include-h1" type="checkbox" checked /><span>{L.includeH1}</span></label><Toggletip id="mtoc-tip-h1" lang={lang} about={L.includeH1}>{TIPS.h1}</Toggletip>
      </div>
    </div>
  </details>
  <div class="mtoc-toolbar">
    <div class="mtoc-copy-control"><button id="mtoc-copy-toc" class="btn-copy" type="button" disabled>{L.copyToc}</button><Toggletip id="mtoc-tip-copyToc" lang={lang} about={L.copyToc}>{TIPS.copyToc}</Toggletip></div>
    <div class="mtoc-copy-control mtoc-md-control"><button id="mtoc-copy-md" class="btn-copy" type="button" disabled>{L.copyMd}</button><Toggletip id="mtoc-tip-copyMd" lang={lang} about={L.copyMd}>{TIPS.copyMd}</Toggletip></div>
  </div>
  <div class="mtoc-status-row">
    <span class="mtoc-status" id="mtoc-status" aria-live="polite"></span>
    <span class="mtoc-status mtoc-md-control" id="mtoc-md-status" aria-live="polite"></span>
  </div>
  <div class="mtoc-grid zt-io">
    <div class="mtoc-input-col zt-io-pane">
      <div class="mtoc-label-row"><label class="tool-label" for="mtoc-input">{L.inputLabel}</label><Toggletip id="mtoc-tip-input" lang={lang} about={L.inputLabel}>{TIPS.input}</Toggletip></div>
      <textarea id="mtoc-input" class="tool-textarea mtoc-textarea zt-io-fill" placeholder={L.inputPh} spellcheck="false"></textarea>
    </div>
    <div class="mtoc-results zt-io-pane" id="mtoc-results">
      <div class="mtoc-output mtoc-toc-output zt-io-pane">
        <label class="tool-label" for="mtoc-toc">{L.tocOutput}</label>
        <textarea id="mtoc-toc" class="tool-textarea mtoc-textarea-out zt-io-fill" placeholder=" " readonly spellcheck="false"></textarea>
        <p class="mtoc-empty" id="mtoc-empty-toc">{L.emptyToc}</p>
      </div>
      <div class="mtoc-output mtoc-md-output zt-io-pane" id="mtoc-md-block" hidden>
        <label class="tool-label" id="mtoc-md-label" for="mtoc-md">{L.mdOutput}</label>
        <textarea id="mtoc-md" class="tool-textarea mtoc-textarea-out zt-io-fill" placeholder=" " aria-labelledby="mtoc-md-label" readonly spellcheck="false"></textarea>
        <p class="mtoc-empty" id="mtoc-empty-md">{L.emptyMarkdown}</p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  var wrap = document.querySelector('.mtoc-wrap');
  if (!wrap) return;
  var inputEl = document.getElementById('mtoc-input');
  var anchorEl = document.getElementById('mtoc-anchor');
  var bulletEl = document.getElementById('mtoc-bullet');
  var indentEl = document.getElementById('mtoc-indent');
  var minEl = document.getElementById('mtoc-min');
  var maxEl = document.getElementById('mtoc-max');
  var minValEl = document.getElementById('mtoc-min-value');
  var maxValEl = document.getElementById('mtoc-max-value');
  var h1El = document.getElementById('mtoc-include-h1');
  var markerEl = document.getElementById('mtoc-marker-mode');
  var tocEl = document.getElementById('mtoc-toc');
  var mdEl = document.getElementById('mtoc-md');
  var mdBlock = document.getElementById('mtoc-md-block');
  var statusEl = document.getElementById('mtoc-status');
  var mdStatusEl = document.getElementById('mtoc-md-status');
  var copyTocBtn = document.getElementById('mtoc-copy-toc');
  var copyMdBtn = document.getElementById('mtoc-copy-md');

  var COPY_LABEL = wrap.getAttribute('data-copy') || 'Copy';
  var COPY_MD_LABEL = wrap.getAttribute('data-copy-md') || 'Copy';
  var COPIED_LABEL = wrap.getAttribute('data-copied') || 'Copied!';
  var COPY_FAILED = wrap.getAttribute('data-copy-failed') || 'Copy failed';
  var EMPTY_LABEL = wrap.getAttribute('data-empty') || 'No headings found.';
  var MARKER_MISSING = wrap.getAttribute('data-marker-missing') || '';
  var MARKER_UPDATED = wrap.getAttribute('data-marker-updated') || '';
  var MARKER_INSERTED = wrap.getAttribute('data-marker-inserted') || '';
  var MARKER_UNCLOSED = wrap.getAttribute('data-marker-unclosed') || '';
  var HEAD_SINGULAR = wrap.getAttribute('data-headings-singular') || '1 heading';
  var HEAD_PRE = wrap.getAttribute('data-headings-plural-pre') || '';
  var HEAD_POST = wrap.getAttribute('data-headings-plural-post') || ' headings';

  /* ── engine:start ── */
  // ── Heading parser ────────────────────────────────────────────────
  function parseHeadings(md) {
    var lines = md.split('\n');
    var headings = [];
    var inFence = false;
    var fenceChar = '';
    var inTocMarker = false;
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i];
      var trimmed = line.trim();
      // Fenced code block
      var fenceMatch = trimmed.match(/^(```|~~~)/);
      if (fenceMatch) {
        if (!inFence) { inFence = true; fenceChar = fenceMatch[1]; }
        else if (trimmed.indexOf(fenceChar) === 0) { inFence = false; fenceChar = ''; }
        continue;
      }
      if (inFence) continue;
      // Skip TOC marker block
      if (/<!--\s*toc\s*-->/i.test(line)) { inTocMarker = true; continue; }
      if (/<!--\s*\/toc\s*-->/i.test(line)) { inTocMarker = false; continue; }
      if (inTocMarker) continue;
      // ATX heading
      // CommonMark: the closing #-sequence must follow a space or tab ("## C#" keeps its #).
      var atx = line.match(/^ {0,3}(#{1,6})[ \t]+(.+?)(?:[ \t]+#+)?[ \t]*$/);
      if (atx) {
        headings.push({ level: atx[1].length, text: cleanInline(atx[2]) });
        continue;
      }
      // Setext heading
      if (i + 1 < lines.length && trimmed && !inFence) {
        var next = lines[i + 1].trim();
        if (/^=+$/.test(next)) { headings.push({ level: 1, text: cleanInline(trimmed) }); i++; continue; }
        if (/^-+$/.test(next) && next.length >= 2) {
          headings.push({ level: 2, text: cleanInline(trimmed) });
          i++;
          continue;
        }
      }
    }
    return headings;
  }

  // Strip Markdown inline syntax for anchor computation; keep readable for TOC label
  function cleanInline(text) {
    return text
      .replace(/`([^`]+)`/g, '$1')
      .replace(/\*\*([^*]+)\*\*/g, '$1')
      .replace(/__([^_]+)__/g, '$1')
      .replace(/\*([^*]+)\*/g, '$1')
      .replace(/_([^_]+)_/g, '$1')
      .replace(/~~([^~]+)~~/g, '$1')
      .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
      .replace(/<\/?[a-zA-Z][^>]*>/g, '')
      .trim();
  }

  // ── Slugify per platform ──────────────────────────────────────────
  // GitHub: github-slugger 2.0.0 (lowercase, drop everything except letters, marks, decimal
  // digits, connector punctuation such as "_", "-" and space, then each space becomes "-").
  // Its table is Unicode \p{Alphabetic}\p{M}\p{Nd}\p{Pc}. GitLab 17.0+ documents the same rules.
  // Jekyll: kramdown-parser-gfm generate_gfm_header_id (Jekyll's default input is GFM); same
  // character set (Ruby \p{Word}), tabs also become "-".
  // kramdown: kramdown's own parser (input: kramdown), basic_generate_id: drop leading non-letters,
  // keep only ASCII a-z 0-9 space "-", empty -> "section".
  // Bitbucket Cloud: "markdown-header-" prefix (Atlassian BCLOUD-8276); the rest of its rules
  // are not documented, so the GitHub rule is used for the remainder.
  var GITHUB_STRIP = /[^\p{Alphabetic}\p{M}\p{Nd}\p{Pc} \-]/gu;
  var GFM_STRIP = /[^\p{Alphabetic}\p{M}\p{Nd}\p{Pc} \t\-]/gu;

  function slugifyGithub(text) {
    return text.toLowerCase().replace(GITHUB_STRIP, '').replace(/ /g, '-');
  }
  function slugifyJekyll(text) {
    return text.toLowerCase().replace(GFM_STRIP, '').replace(/[ \t]/g, '-');
  }
  function slugifyKramdown(text) {
    var s = text.replace(/^[^a-zA-Z]+/, '');
    s = s.replace(/[^a-zA-Z0-9 \-]/g, '');
    s = s.replace(/ /g, '-').toLowerCase();
    return s;
  }
  function slugify(text, style) {
    if (style === 'jekyll') return slugifyJekyll(text);
    if (style === 'kramdown') return slugifyKramdown(text);
    if (style === 'bitbucket') return 'markdown-header-' + slugifyGithub(text);
    return slugifyGithub(text);
  }

  // Unique ids for every heading of the document, in document order (renderers count all
  // headings, not only the ones shown in the TOC).
  function dedupe(slugs, style) {
    var out = [];
    var counts = Object.create(null);
    var i, base;
    if (style === 'jekyll' || style === 'kramdown') {
      // kramdown: a per-base counter; the result is not checked against earlier ids, so
      // "Install", "Install-1", "Install" gives install, install-1, install-1.
      for (i = 0; i < slugs.length; i++) {
        base = slugs[i];
        if (style === 'kramdown' && base === '') base = 'section';
        if (style === 'jekyll' && base === '') { out.push(''); continue; }
        if (!(base in counts)) { counts[base] = 0; out.push(base); }
        else { counts[base] += 1; out.push(base + '-' + counts[base]); }
      }
      return out;
    }
    if (style === 'bitbucket') {
      for (i = 0; i < slugs.length; i++) {
        base = slugs[i];
        if (!(base in counts)) { counts[base] = 0; out.push(base); }
        else { counts[base] += 1; out.push(base + '_' + counts[base]); }
      }
      return out;
    }
    // github-slugger BananaSlug.slug(): bump the counter until the result is unused.
    for (i = 0; i < slugs.length; i++) {
      base = slugs[i];
      var result = base;
      while (result in counts) {
        counts[base]++;
        result = base + '-' + counts[base];
      }
      counts[result] = 0;
      out.push(result);
    }
    return out;
  }

  // ── TOC renderer ──────────────────────────────────────────────────
  function escapeMdLink(text) {
    // Escape brackets so they don't terminate the link label
    return text.replace(/\\/g, '\\\\').replace(/\[/g, '\\[').replace(/\]/g, '\\]');
  }

  function renderTOC(headings, opts) {
    if (headings.length === 0) return '';
    var minL = opts.minLevel;
    var maxL = opts.maxLevel;
    var includeH1 = opts.includeH1;
    var bullet = opts.bullet;
    var indentChars = opts.indent === 'tab' ? '\t' : (opts.indent === '4' ? '    ' : '  ');

    var allSlugs = dedupe(headings.map(function (h) { return slugify(h.text, opts.style); }), opts.style);
    var filtered = [];
    var finalSlugs = [];
    for (var i = 0; i < headings.length; i++) {
      var h = headings[i];
      if (h.level < minL || h.level > maxL) continue;
      if (!includeH1 && h.level === 1) continue;
      filtered.push(h);
      finalSlugs.push(allSlugs[i]);
    }
    if (filtered.length === 0) return '';

    var baseLevel = Infinity;
    for (var j = 0; j < filtered.length; j++) {
      if (filtered[j].level < baseLevel) baseLevel = filtered[j].level;
    }


    var lines = [];
    for (var k = 0; k < filtered.length; k++) {
      var depth = filtered[k].level - baseLevel;
      var indent = depth > 0 ? new Array(depth + 1).join(indentChars) : '';
      var b = bullet === '1.' ? '1.' : bullet;
      var anchor = finalSlugs[k];
      var label = escapeMdLink(filtered[k].text);
      lines.push(indent + b + ' [' + label + '](#' + anchor + ')');
    }
    return lines.join('\n');
  }

  // ── In-place TOC marker update ────────────────────────────────────
  // Returns { md: string, status: 'updated' | 'inserted' | 'unclosed' | 'missing-no-heading' }
  function applyToMarkdown(md, toc) {
    var openRe = /<!--\s*toc\s*-->/i;
    var closeRe = /<!--\s*\/toc\s*-->/i;
    var openMatch = openRe.exec(md);
    if (openMatch) {
      var afterOpen = md.slice(openMatch.index + openMatch[0].length);
      var closeMatch = closeRe.exec(afterOpen);
      if (!closeMatch) {
        return { md: md, status: 'unclosed' };
      }
      var closeAbs = openMatch.index + openMatch[0].length + closeMatch.index;
      var newMd = md.slice(0, openMatch.index + openMatch[0].length) + '\n' + toc + '\n' + md.slice(closeAbs);
      return { md: newMd, status: 'updated' };
    }
    // No marker: insert before first ATX heading
    var firstHeadingRe = /(^|\n)(#{1,6})\s+/m;
    var firstMatch = firstHeadingRe.exec(md);
    if (!firstMatch) {
      return { md: md, status: 'missing-no-heading' };
    }
    var insertAt = firstMatch.index === 0 ? 0 : firstMatch.index + 1; // skip the leading newline
    var prefix = md.slice(0, insertAt);
    var suffix = md.slice(insertAt);
    var newDoc = prefix + '<!-- toc -->\n' + toc + '\n<!-- /toc -->\n\n' + suffix;
    return { md: newDoc, status: 'inserted' };
  }
  /* ── engine:end ── */

  function headingCountLabel(n) {
    if (n === 1) return HEAD_SINGULAR;
    return HEAD_PRE + n + HEAD_POST;
  }

  var copyStates = [
    { button: copyTocBtn, label: COPY_LABEL, revision: 0, timer: null },
    { button: copyMdBtn, label: COPY_MD_LABEL, revision: 0, timer: null },
  ];
  function invalidateCopies() {
    copyStates.forEach(function (state) {
      state.revision++;
      clearTimeout(state.timer);
      state.button.classList.remove('copied');
      state.button.textContent = state.label;
    });
  }

  function update() {
    invalidateCopies();
    var md = inputEl.value;
    var minL = parseInt(minEl.value, 10);
    var maxL = parseInt(maxEl.value, 10);
    if (minL > maxL) { [minL, maxL] = [maxL, minL]; }
    minValEl.textContent = String(minL);
    maxValEl.textContent = String(maxL);

    var headings = parseHeadings(md);
    var visibleCount = headings.filter(function (h) {
      if (h.level < minL || h.level > maxL) return false;
      if (!h1El.checked && h.level === 1) return false;
      return true;
    }).length;

    var toc = renderTOC(headings, {
      style: anchorEl.value,
      bullet: bulletEl.value,
      indent: indentEl.value,
      minLevel: minL,
      maxLevel: maxL,
      includeH1: h1El.checked,
    });

    if (toc === '') {
      tocEl.value = '';
      tocEl.placeholder = EMPTY_LABEL;
      copyTocBtn.disabled = true;
      statusEl.textContent = headings.length === 0 ? '' : EMPTY_LABEL;
    } else {
      tocEl.value = toc;
      copyTocBtn.disabled = false;
      statusEl.textContent = headingCountLabel(visibleCount);
    }

    if (markerEl.checked) {
      mdBlock.hidden = false;
      if (md.trim() === '') {
        mdEl.value = '';
        copyMdBtn.disabled = true;
        mdStatusEl.textContent = '';
      } else if (toc === '') {
        mdEl.value = md;
        copyMdBtn.disabled = true;
        mdStatusEl.textContent = EMPTY_LABEL;
      } else {
        var result = applyToMarkdown(md, toc);
        mdEl.value = result.md;
        if (result.status === 'updated') {
          copyMdBtn.disabled = false;
          mdStatusEl.textContent = MARKER_UPDATED;
        } else if (result.status === 'inserted') {
          copyMdBtn.disabled = false;
          mdStatusEl.textContent = MARKER_INSERTED;
        } else if (result.status === 'unclosed') {
          copyMdBtn.disabled = true;
          mdStatusEl.textContent = MARKER_UNCLOSED;
        } else {
          copyMdBtn.disabled = true;
          mdStatusEl.textContent = MARKER_MISSING;
        }
      }
    } else {
      mdBlock.hidden = true;
    }
  }

  function copyValue(textarea, btn, baseLabel) {
    if (!textarea.value) return;
    var state = copyStates[btn === copyTocBtn ? 0 : 1];
    var request = ++state.revision;
    clearTimeout(state.timer);
    var done = function () {
      if (request !== state.revision) return;
      btn.classList.add('copied');
      btn.textContent = COPIED_LABEL;
      state.timer = setTimeout(function () {
        if (request !== state.revision) return;
        btn.classList.remove('copied');
        btn.textContent = baseLabel;
      }, 1200);
    };
    function fallback() {
      if (request !== state.revision) return;
      var copied = false;
      try {
        textarea.select();
        copied = document.execCommand('copy');
      } catch (_e) {}
      if (request !== state.revision) return;
      if (copied) done();
      else {
        btn.classList.remove('copied');
        btn.textContent = COPY_FAILED;
      }
    }
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(textarea.value).then(done, fallback);
      } else fallback();
    } catch (_e) { fallback(); }
  }

  copyTocBtn.addEventListener('click', function () { copyValue(tocEl, copyTocBtn, COPY_LABEL); });
  copyMdBtn.addEventListener('click', function () { copyValue(mdEl, copyMdBtn, COPY_MD_LABEL); });

  ['input', 'change'].forEach(function (evt) {
    [inputEl, anchorEl, bulletEl, indentEl, minEl, maxEl, h1El, markerEl].forEach(function (el) {
      el.addEventListener(evt, update);
    });
  });

  document.addEventListener('keydown', function (e) {
    if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
      e.preventDefault();
      inputEl.focus();
      inputEl.value = '';
      update();
      mdEl.value = '';
      mdStatusEl.textContent = '';
      copyMdBtn.disabled = true;
    }
  });

  update();
})();
</script>

