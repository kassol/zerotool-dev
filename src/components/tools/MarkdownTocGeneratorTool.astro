.mtoc-wrap:not(:has(#mtoc-marker-mode:checked)) .mtoc-md-control { display: none; }
.mtoc-status-row { display: flex; gap: 0.75rem; flex: none; height: 2.6em; font-size: 0.8rem; line-height: 1.3; }
