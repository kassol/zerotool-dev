.mtoc-textarea-out::placeholder { color: transparent; }
.mtoc-textarea-out:focus { background: var(--color-bg-secondary); box-shadow: inset 0 0 0 1px var(--color-border-soft); }
.mtoc-empty { display: none; position: absolute; inset: 2rem 0 0; margin: 0; padding: 1rem; place-content: center; text-align: center; color: var(--color-text-muted); font-size: 0.85rem; pointer-events: none; }
.mtoc-toc-output:has(#mtoc-toc:placeholder-shown) #mtoc-empty-toc,
.mtoc-md-output:has(#mtoc-md:placeholder-shown) #mtoc-empty-md { display: grid; }
@media (max-width: 860px) {
  .mtoc-controls-col { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mtoc-textarea { flex: none; height: 220px; }
  .mtoc-textarea-out { flex: none; height: 240px; }
  .mtoc-output { flex: none; }
  .mtoc-results:has(#mtoc-toc:placeholder-shown):has(#mtoc-md:placeholder-shown),
  .mtoc-results:has(#mtoc-toc:placeholder-shown):has(#mtoc-md-block[hidden]) { display: none; }
}
@media (max-width: 640px) {
  .mtoc-wrap { gap: 0.4rem; }
  .mtoc-top-controls { gap: 0.25rem 0.75rem; }
  .mtoc-anchor-control { flex-basis: 100%; }
  .mtoc-anchor-control .tool-label { font-size: 0.78rem; }
  .mtoc-toggle { min-height: 32px; }
  .mtoc-options summary { min-height: 32px; }
  .mtoc-controls-col { gap: 0.5rem; }
  .mtoc-controls-col .tool-label { font-size: 0.75rem; }
  .mtoc-toolbar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
