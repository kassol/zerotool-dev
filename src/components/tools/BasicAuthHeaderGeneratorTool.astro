    .bahg-privacy { margin: 0; padding: 0.8rem 0.9rem; border-radius: var(--radius-md); background: var(--color-surface-muted); color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.5; box-shadow: inset 0 0 0 1px var(--color-border-soft); }
    @media (max-width: 860px) {
