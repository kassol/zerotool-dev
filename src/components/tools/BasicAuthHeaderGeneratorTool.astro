const { tips: TIPS, ...CLIENT_T } = T;
---
<div class="bahg-wrap">
  <section class="bahg-card" aria-labelledby="bahg-generate-title">
    <div class="bahg-card-head">
      <div>
        <h2 id="bahg-generate-title">{T.generateTitle}</h2>
        <p>{T.generateHint}</p>
      </div>
    </div>

    <div class="bahg-actions">
      <div class="bahg-button-help"><button id="bahg-generate" class="btn-primary" type="button">{T.generate}</button><Toggletip id="bahg-tip-generate" lang={lang} about={T.generate}>{TIPS.generate}</Toggletip></div>
      <button id="bahg-load-generate-example" class="btn-secondary" type="button">{T.loadExample}</button>
      <button id="bahg-clear-generate" class="btn-ghost" type="button">{T.clear}</button>
    </div>

    <div id="bahg-generate-status" class="tool-status none" aria-live="polite" tabindex="0"></div>

    <div class="bahg-grid">
      <div class="bahg-field">
        <div class="bahg-field-label"><label class="tool-label" for="bahg-username">{T.username}</label><Toggletip id="bahg-tip-username" lang={lang} about={T.username}>{TIPS.username}</Toggletip></div>
        <input id="bahg-username" class="tool-input" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="Aladdin" />
      </div>

      <div class="bahg-field">
        <div class="bahg-field-label"><label class="tool-label" for="bahg-password">{T.password}</label><Toggletip id="bahg-tip-password" lang={lang} about={T.password}>{TIPS.password}</Toggletip></div>
        <span class="bahg-password-row">
          <input id="bahg-password" class="tool-input" type="password" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="open sesame" />
          <span class="bahg-button-help"><button id="bahg-toggle-password" class="btn-secondary" type="button">{T.show}</button><Toggletip id="bahg-tip-visibility" lang={lang} about={T.show}>{TIPS.visibility}</Toggletip></span>
        </span>
      </div>
    </div>


    <div id="bahg-generate-output" class="bahg-output" hidden>
      <div class="tool-result-row">
        <span class="tool-result-label">{T.fullHeader}</span>
        <code id="bahg-full-header" class="tool-result-value" tabindex="0" aria-label={T.fullHeader}></code>
        <div class="bahg-button-help"><button class="btn-copy" type="button" data-copy-target="bahg-full-header">{T.copy}</button><Toggletip id="bahg-tip-copy" lang={lang} about={T.copy}>{TIPS.copy}</Toggletip></div>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">{T.token}</span>
        <code id="bahg-token" class="tool-result-value" tabindex="0" aria-label={T.token}></code>
        <button class="btn-copy" type="button" data-copy-target="bahg-token">{T.copy}</button>
      </div>
      <div class="bahg-snippet-grid">
        <div class="bahg-snippet">
          <div class="bahg-snippet-head">
            <div class="bahg-field-label"><span class="tool-result-label">cURL</span><Toggletip id="bahg-tip-snippets" lang={lang} about="cURL / Fetch">{TIPS.snippets}</Toggletip></div>
            <button class="btn-copy" type="button" data-copy-target="bahg-curl">{T.copy}</button>
          </div>
          <pre><code id="bahg-curl" tabindex="0" aria-label="cURL"></code></pre>
        </div>
        <div class="bahg-snippet">
          <div class="bahg-snippet-head">
            <span class="tool-result-label">Fetch</span>
            <button class="btn-copy" type="button" data-copy-target="bahg-fetch">{T.copy}</button>
          </div>
          <pre><code id="bahg-fetch" tabindex="0" aria-label="Fetch"></code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="bahg-card" aria-labelledby="bahg-decode-title">
    <div class="bahg-card-head">
      <div>
        <h2 id="bahg-decode-title">{T.decodeTitle}</h2>
        <p>{T.decodeHint}</p>
      </div>
    </div>

    <div class="bahg-actions">
      <div class="bahg-button-help"><button id="bahg-decode" class="btn-primary" type="button">{T.decode}</button><Toggletip id="bahg-tip-decode" lang={lang} about={T.decode}>{TIPS.decode}</Toggletip></div>
      <button id="bahg-load-decode-example" class="btn-secondary" type="button">{T.loadExample}</button>
      <button id="bahg-clear-decode" class="btn-ghost" type="button">{T.clear}</button>
    </div>

    <div id="bahg-decode-status" class="tool-status none" aria-live="polite" tabindex="0"></div>

    <div class="bahg-field">
      <div class="bahg-field-label"><label class="tool-label" for="bahg-decode-input">{T.decodeInput}</label><Toggletip id="bahg-tip-token" lang={lang} about={T.decodeInput}>{TIPS.token}</Toggletip></div>
      <textarea id="bahg-decode-input" class="tool-textarea" rows="4" spellcheck="false" placeholder="Basic dXNlcjpwOmE6c3M="></textarea>
    </div>


    <div id="bahg-decode-output" class="bahg-output" hidden>
      <div class="tool-result-row">
        <span class="tool-result-label">{T.decodedUsername}</span>
        <code id="bahg-decoded-username" class="tool-result-value" tabindex="0" aria-label={T.decodedUsername}></code>
        <button class="btn-copy" type="button" data-copy-target="bahg-decoded-username">{T.copy}</button>
      </div>
      <div class="tool-result-row">
        <span class="tool-result-label">{T.decodedPassword}</span>
        <code id="bahg-decoded-password" class="tool-result-value" tabindex="0" aria-label={T.decodedPassword}></code>
        <button class="btn-copy" type="button" data-copy-target="bahg-decoded-password">{T.copy}</button>
      </div>
    </div>
  </section>

  <p class="bahg-privacy">{T.privacy}</p>
</div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var encoder = new TextEncoder();

      function byId(id) {
        return document.getElementById(id);
      }

      var usernameEl = byId('bahg-username');
      var passwordEl = byId('bahg-password');
      var togglePasswordBtn = byId('bahg-toggle-password');
      var generateBtn = byId('bahg-generate');
      var loadGenerateExampleBtn = byId('bahg-load-generate-example');
      var clearGenerateBtn = byId('bahg-clear-generate');
      var generateStatusEl = byId('bahg-generate-status');
      var generateOutputEl = byId('bahg-generate-output');
      var fullHeaderEl = byId('bahg-full-header');
      var tokenEl = byId('bahg-token');
      var curlEl = byId('bahg-curl');
      var fetchEl = byId('bahg-fetch');
      var decodeInputEl = byId('bahg-decode-input');
      var decodeBtn = byId('bahg-decode');
      var loadDecodeExampleBtn = byId('bahg-load-decode-example');
      var clearDecodeBtn = byId('bahg-clear-decode');
      var decodeStatusEl = byId('bahg-decode-status');
      var decodeOutputEl = byId('bahg-decode-output');
      var decodedUsernameEl = byId('bahg-decoded-username');
      var decodedPasswordEl = byId('bahg-decoded-password');
      var generateRevision = 0, decodeRevision = 0;

      function setStatus(el, message, type) {
        el.textContent = message || '';
        el.className = 'tool-status ' + (type || 'none');
      }

      function bytesToBase64(bytes) {
        var binary = '';
        var chunkSize = 8192;
        for (var i = 0; i < bytes.length; i += chunkSize) {
          binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunkSize));
        }
        return btoa(binary);
      }

      /* ── engine:start ── */
      function base64ToBytes(token) {
        var normalized = token.replace(/\s+/g, '');
        if (!normalized) throw new Error('invalidBase64');
        if (!/^[A-Za-z0-9+/]*={0,2}$/.test(normalized) || normalized.length % 4 === 1) {
          throw new Error('invalidBase64');
        }
        try {
          var binary = atob(normalized);
          var bytes = new Uint8Array(binary.length);
          for (var i = 0; i < binary.length; i += 1) {
            bytes[i] = binary.charCodeAt(i);
          }
          return bytes;
        } catch (err) {
          throw new Error('invalidBase64');
        }
      }

      function extractBasicToken(input) {
        var value = input.trim();
        var authorizationMatch;
        if (!value) throw new Error('missingDecode');

        authorizationMatch = value.match(/^authorization\s*:\s*(.+)$/i);
        if (authorizationMatch) value = authorizationMatch[1].trim();

        var schemeMatch = value.match(/^([A-Za-z][A-Za-z0-9+.-]*)\s+(.+)$/);
        if (schemeMatch) {
          if (schemeMatch[1].toLowerCase() !== 'basic') throw new Error('invalidScheme');
          value = schemeMatch[2].trim();
        }
        return value;
      }

      // RFC 7617 §2.1: the only charset the scheme defines is UTF-8. Older clients send
      // ISO-8859-1, so bytes that are not valid UTF-8 are shown as ISO-8859-1 with a notice
      // (every byte maps to U+0000–U+00FF) instead of being reported as bad Base64.
      function decodeCredentials(input) {
        var bytes = base64ToBytes(extractBasicToken(input));
        var text;
        var charset = 'utf-8';
        try {
          text = new TextDecoder('utf-8', { fatal: true }).decode(bytes);
        } catch (err) {
          charset = 'iso-8859-1';
          text = '';
          for (var i = 0; i < bytes.length; i += 1) text += String.fromCharCode(bytes[i]);
        }
        var colonIndex = text.indexOf(':');
        if (colonIndex === -1) throw new Error('missingColon');
        return { username: text.slice(0, colonIndex), password: text.slice(colonIndex + 1), charset: charset };
      }
      /* ── engine:end ── */

      function resetCopyButtons(output) {
        output.querySelectorAll('[data-copy-target]').forEach(function (button) {
          button.classList.remove('copied');
          button.textContent = t.copy;
        });
      }

      function generateHeader() {
        generateRevision++; resetCopyButtons(generateOutputEl);
        var username = usernameEl.value;
        var password = passwordEl.value;
        var token;
        var header;
        if (!username && !password) {
          generateOutputEl.hidden = true;
          setStatus(generateStatusEl, t.missingGenerate, 'error');
          return;
        }
        if (username.indexOf(':') !== -1) {
          generateOutputEl.hidden = true;
          setStatus(generateStatusEl, t.usernameColon, 'error');
          return;
        }
        token = bytesToBase64(encoder.encode(username + ':' + password));
        header = 'Authorization: Basic ' + token;
        fullHeaderEl.textContent = header;
        tokenEl.textContent = token;
        curlEl.textContent = 'curl -H "' + header + '" https://example.com/api';
        fetchEl.textContent = "fetch('https://example.com/api', {\n  headers: {\n    Authorization: 'Basic " + token + "'\n  }\n});";
        generateOutputEl.hidden = false;
        setStatus(generateStatusEl, t.generated, 'success');
      }

      function decodeHeader() {
        decodeRevision++; resetCopyButtons(decodeOutputEl);
        var result;
        try {
          result = decodeCredentials(decodeInputEl.value);
          decodedUsernameEl.textContent = result.username;
          decodedPasswordEl.textContent = result.password;
          decodeOutputEl.hidden = false;
          if (result.charset === 'utf-8') setStatus(decodeStatusEl, t.decoded, 'success');
          else setStatus(decodeStatusEl, t.decodedLatin1, 'info');
        } catch (err) {
          decodeOutputEl.hidden = true;
          setStatus(decodeStatusEl, t[err.message] || t.invalidBase64, 'error');
        }
      }

      function resetCopyButton(button, isCurrent) {
        window.setTimeout(function () {
          if (!isCurrent()) return;
          button.classList.remove('copied');
          button.textContent = t.copy;
        }, 1200);
      }

      async function copyText(button, statusEl, isCurrent) {
        var target = byId(button.getAttribute('data-copy-target'));
        var text = target ? target.textContent : '';
        if (!text) return;
        if (statusEl.textContent === t.copyFailed && statusEl.classList.contains('error')) setStatus(statusEl, '', 'none');
        try {
          await navigator.clipboard.writeText(text);
          if (!isCurrent()) return;
          button.classList.add('copied');
          button.textContent = t.copied;
          resetCopyButton(button, isCurrent);
        } catch (err) {
          if (isCurrent()) {
            button.classList.remove('copied');
            button.textContent = t.copy;
            setStatus(statusEl, t.copyFailed, 'error');
          }
        }
      }

      togglePasswordBtn.addEventListener('click', function () {
        var showing = passwordEl.type === 'text';
        passwordEl.type = showing ? 'password' : 'text';
        togglePasswordBtn.textContent = showing ? t.show : t.hide;
      });

      generateBtn.addEventListener('click', generateHeader);
      loadGenerateExampleBtn.addEventListener('click', function () {
        usernameEl.value = 'Aladdin';
        passwordEl.value = 'open sesame';
        generateHeader();
      });
      function clearGenerate() {
        generateRevision++; resetCopyButtons(generateOutputEl);
        usernameEl.value = '';
        passwordEl.value = '';
        fullHeaderEl.textContent = '';
        tokenEl.textContent = '';
        curlEl.textContent = '';
        fetchEl.textContent = '';
        generateOutputEl.hidden = true;
        setStatus(generateStatusEl, '', 'none');
      }
      clearGenerateBtn.addEventListener('click', clearGenerate);

      decodeBtn.addEventListener('click', decodeHeader);
      loadDecodeExampleBtn.addEventListener('click', function () {
        decodeInputEl.value = 'Basic dXNlcjpwOmE6c3M=';
        decodeHeader();
      });
      function clearDecode() {
        decodeRevision++; resetCopyButtons(decodeOutputEl);
        decodeInputEl.value = '';
        decodedUsernameEl.textContent = '';
        decodedPasswordEl.textContent = '';
        decodeOutputEl.hidden = true;
        setStatus(decodeStatusEl, '', 'none');
      }
      clearDecodeBtn.addEventListener('click', clearDecode);

      document.querySelectorAll('.bahg-wrap [data-copy-target]').forEach(function (button) {
        var request = 0;
        button.addEventListener('click', function () {
          var decoding = !!button.closest('#bahg-decode-output');
          var statusEl = decoding ? decodeStatusEl : generateStatusEl;
          var revision = decoding ? decodeRevision : generateRevision, current = ++request;
          copyText(button, statusEl, function () {
            return current === request && revision === (decoding ? decodeRevision : generateRevision);
          });
        });
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.metaKey || e.ctrlKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var widget = document.querySelector('.bahg-wrap');
        if (!widget || !widget.contains(document.activeElement)) return;
        e.preventDefault();
        clearGenerate(); clearDecode();
      });
    })();
  </script>

