---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: {
    tips: {
      text: "Enter text and click Text → ASCII. Each Unicode code point produces one number. Emoji made of several code points produce several numbers; line breaks and tabs also produce codes.",
      codes: "Enter codes separated by whitespace or commas, then click ASCII → Text. Mix decimal, 0x hex, 0o octal and 0b binary. Every token must be valid; the range is 0–1114111, excluding 55296–57343.",
      format: "Select Decimal, Hex, Octal or Binary for Text → ASCII. Hex uses uppercase digits; 0x, 0o and 0b prefixes identify the other bases. Values have no leading zeros. Click Text → ASCII again after changing the format.",
      copy: "Copy the complete current contents of this box, including any edits. If copying fails, select the contents and copy manually.",
      reference: "Expand the table to look up printable ASCII codes 32–126 in decimal and hex. SP represents the space character. The converter also handles code points outside this table.",
    },
    text: 'Text', codesLabel: 'ASCII / Unicode Codes', copy: 'Copy', copied: 'Copied!', clear: 'Clear',
    copyFail: 'Could not copy. Please select the content and copy it manually.',
    textPlaceholder: 'Enter text here...', codesPlaceholder: 'Enter space-separated codes (e.g. 72 101 108 108 111)...',
    format: 'Format:', fmtDecimal: 'Decimal', fmtHex: 'Hex (0x41)', fmtOctal: 'Octal (0o101)', fmtBinary: 'Binary (0b1000001)',
    toAscii: 'Text → ASCII', toText: 'ASCII → Text', refTable: 'ASCII Reference Table (32–126)',
    convertedChars: { one: 'Converted {n} character.', other: 'Converted {n} characters.' },
    convertedCodes: { one: 'Converted {n} code.', other: 'Converted {n} codes.' }
  },
  zh: {
    tips: {
      text: "输入文本后点击「文本 → ASCII」。每个 Unicode 码点生成一个数值。由多个码点组成的表情会生成多个数值；换行和制表符也会生成码值。",
      codes: "输入以空白或逗号分隔的码值，再点击「ASCII → 文本」。可混合十进制、0x 十六进制、0o 八进制和 0b 二进制。每个码值必须完整有效，范围为 0–1114111，排除 55296–57343。",
      format: "为「文本 → ASCII」选择十进制、十六进制、八进制或二进制。十六进制字母大写；0x、0o、0b 前缀标识对应进制。数值不补前导零。改变格式后再次点击「文本 → ASCII」进行转换。",
      copy: "复制此框当前的完整内容，包括手动编辑的内容。复制失败时，请选中内容后手动复制。",
      reference: "展开表格，查看可打印 ASCII 码 32–126 的十进制和十六进制值。SP 表示空格。转换器也能处理表格范围以外的码点。",
    },
    text: '文本', codesLabel: 'ASCII / Unicode 码值', copy: '复制', copied: '已复制！', clear: '清除',
    copyFail: '复制失败。请选中内容后手动复制。',
    textPlaceholder: '在此输入文本...', codesPlaceholder: '输入以空格分隔的码值（如 72 101 108 108 111）...',
    format: '格式：', fmtDecimal: '十进制', fmtHex: '十六进制 (0x41)', fmtOctal: '八进制 (0o101)', fmtBinary: '二进制 (0b1000001)',
    toAscii: '文本 → ASCII', toText: 'ASCII → 文本', refTable: 'ASCII 参考表（32–126）',
    convertedChars: { one: '已转换 {n} 个字符。', other: '已转换 {n} 个字符。' },
    convertedCodes: { one: '已转换 {n} 个码值。', other: '已转换 {n} 个码值。' }
  },
  ja: {
    tips: {
      text: "テキストを入力し、「テキスト → ASCII」を押します。Unicode コードポイントごとに1つの数値を出力します。複数のコードポイントで構成される絵文字は複数の数値になり、改行やタブもコードになります。",
      codes: "空白またはカンマで区切ったコードを入力し、「ASCII → テキスト」を押します。10進数、0x の16進数、0o の8進数、0b の2進数を混在できます。各コード全体が有効である必要があります。範囲は0〜1114111で、55296〜57343は除外します。",
      format: "「テキスト → ASCII」の出力を10進数・16進数・8進数・2進数から選びます。16進数の英字は大文字で、0x・0o・0b は各進数の接頭辞です。先頭のゼロは補いません。変更後は「テキスト → ASCII」をもう一度押します。",
      copy: "手動で編集した内容も含め、この欄の現在の内容をすべてコピーします。失敗した場合は内容を選択し、手動でコピーしてください。",
      reference: "表を開くと、印字可能な ASCII コード32〜126の10進数と16進数を確認できます。SP は空白を表します。変換器は表の範囲外のコードポイントも扱えます。",
    },
    text: 'テキスト', codesLabel: 'ASCII / Unicode コード', copy: 'コピー', copied: 'コピー済み！', clear: 'クリア',
    copyFail: 'コピーできませんでした。内容を選択して手動でコピーしてください。',
    textPlaceholder: 'テキストを入力...', codesPlaceholder: 'スペース区切りのコードを入力（例: 72 101 108 108 111）...',
    format: 'フォーマット：', fmtDecimal: '10進数', fmtHex: '16進数 (0x41)', fmtOctal: '8進数 (0o101)', fmtBinary: '2進数 (0b1000001)',
    toAscii: 'テキスト → ASCII', toText: 'ASCII → テキスト', refTable: 'ASCII 参照表（32–126）',
    convertedChars: { one: '{n} 文字を変換しました。', other: '{n} 文字を変換しました。' },
    convertedCodes: { one: '{n} コードを変換しました。', other: '{n} コードを変換しました。' }
  },
  ko: {
    tips: {
      text: "텍스트를 입력하고 텍스트 → ASCII를 누르세요. Unicode 코드 포인트마다 숫자 하나를 출력합니다. 여러 코드 포인트로 구성된 이모지는 여러 숫자가 되며 줄바꿈과 탭도 코드로 출력됩니다.",
      codes: "공백이나 쉼표로 구분한 코드를 입력하고 ASCII → 텍스트를 누르세요. 10진수, 0x 16진수, 0o 8진수, 0b 2진수를 섞을 수 있습니다. 각 코드 전체가 유효해야 하며 범위는 0–1114111에서 55296–57343을 제외한 값입니다.",
      format: "텍스트 → ASCII 출력에 사용할 10진수·16진수·8진수·2진수를 선택하세요. 16진수 영문자는 대문자이며 0x·0o·0b 접두사로 진수를 표시합니다. 앞에 0을 채우지 않습니다. 형식을 바꾼 뒤 텍스트 → ASCII를 다시 누르세요.",
      copy: "직접 수정한 내용을 포함하여 이 입력창의 현재 내용을 모두 복사합니다. 실패하면 내용을 선택하여 직접 복사하세요.",
      reference: "표를 펼치면 출력 가능한 ASCII 코드 32–126의 10진수와 16진수를 볼 수 있습니다. SP는 공백을 나타냅니다. 변환기는 표 범위 밖의 코드 포인트도 처리합니다.",
    },
    text: '텍스트', codesLabel: 'ASCII / Unicode 코드', copy: '복사', copied: '복사됨!', clear: '지우기',
    copyFail: '복사하지 못했습니다. 내용을 선택하여 직접 복사하세요.',
    textPlaceholder: '텍스트를 입력하세요...', codesPlaceholder: '공백으로 구분된 코드를 입력하세요 (예: 72 101 108 108 111)...',
    format: '형식:', fmtDecimal: '10진수', fmtHex: '16진수 (0x41)', fmtOctal: '8진수 (0o101)', fmtBinary: '2진수 (0b1000001)',
    toAscii: '텍스트 → ASCII', toText: 'ASCII → 텍스트', refTable: 'ASCII 참조표 (32–126)',
    convertedChars: { one: '{n}개 문자를 변환했습니다.', other: '{n}개 문자를 변환했습니다.' },
    convertedCodes: { one: '{n}개 코드를 변환했습니다.', other: '{n}개 코드를 변환했습니다.' }
  }
} as const;
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="ac-wrap">
    <div class="ac-controls">
      <div class="ac-format">
        <label for="ac-format-select">{T.format}</label>
        <select id="ac-format-select" class="tool-input">
          <option value="dec">{T.fmtDecimal}</option>
          <option value="hex">{T.fmtHex}</option>
          <option value="oct">{T.fmtOctal}</option>
          <option value="bin">{T.fmtBinary}</option>
        </select>
        <Toggletip id="ac-tip-format" about={T.format} lang={lang}>{TIPS.format}</Toggletip>
      </div>
      <button id="ac-clear" class="btn-ghost" type="button">{T.clear}</button>
      <div class="ac-actions">
        <button id="ac-to-ascii" class="btn-primary" type="button">{T.toAscii}</button>
        <button id="ac-to-text" class="btn-primary" type="button">{T.toText}</button>
      </div>
    </div>

    <div id="ac-status" class="ac-status" aria-live="polite"></div>

    <div class="ac-panels zt-io">
      <div class="ac-panel zt-io-pane">
        <div class="ac-head">
          <label for="ac-text">{T.text}</label>
          <Toggletip id="ac-tip-text" about={T.text} lang={lang}>{TIPS.text}</Toggletip>
          <div class="ac-copy-controls">
            <button id="ac-copy-text" class="btn-copy" type="button">{T.copy}</button>
            <Toggletip id="ac-tip-copy-text" about={T.copy} lang={lang}>{TIPS.copy}</Toggletip>
          </div>
        </div>
        <textarea id="ac-text" class="tool-textarea ac-box zt-io-fill" placeholder={T.textPlaceholder} spellcheck="false" autocomplete="off"></textarea>
      </div>
      <div class="ac-panel zt-io-pane">
        <div class="ac-head">
          <label for="ac-codes">{T.codesLabel}</label>
          <Toggletip id="ac-tip-codes" about={T.codesLabel} lang={lang}>{TIPS.codes}</Toggletip>
          <div class="ac-copy-controls">
            <button id="ac-copy-codes" class="btn-copy" type="button">{T.copy}</button>
            <Toggletip id="ac-tip-copy-codes" about={T.copy} lang={lang}>{TIPS.copy}</Toggletip>
          </div>
        </div>
        <textarea id="ac-codes" class="tool-textarea ac-box zt-io-fill" placeholder={T.codesPlaceholder} spellcheck="false" autocomplete="off"></textarea>
      </div>
    </div>

    <div class="ac-reference">
      <details class="ac-ref">
        <summary>{T.refTable}</summary>
        <div class="ac-ref-table-wrap" tabindex="0" role="region" aria-label={T.refTable}>
          <table class="ac-ref-table" id="ac-ref-table">
            <thead>
              <tr><th>Char</th><th>Dec</th><th>Hex</th><th>Char</th><th>Dec</th><th>Hex</th><th>Char</th><th>Dec</th><th>Hex</th></tr>
            </thead>
            <tbody id="ac-ref-tbody"></tbody>
          </table>
        </div>
      </details>
      <Toggletip id="ac-tip-reference" about={T.refTable} lang={lang}>{TIPS.reference}</Toggletip>
    </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      function countMessage(messages, n) {
        return messages[n === 1 ? 'one' : 'other'].replace('{n}', String(n));
      }

      var textEl = document.getElementById('ac-text');
      var codesEl = document.getElementById('ac-codes');
      var statusEl = document.getElementById('ac-status');
      var formatEl = document.getElementById('ac-format-select');
      var copyTextBtn = document.getElementById('ac-copy-text');
      var copyCodesBtn = document.getElementById('ac-copy-codes');
      var copyErrorBtn = null;
      var copyRevision = 0;

      function setStatus(msg, isError) {
        copyErrorBtn = null;
        statusEl.textContent = msg;
        statusEl.className = 'ac-status ' + (isError ? 'error' : 'success');
      }

      function clearStatus() {
        copyErrorBtn = null;
        statusEl.textContent = '';
        statusEl.className = 'ac-status';
      }

      function invalidateCopies() {
        copyRevision++;
        [copyTextBtn, copyCodesBtn].forEach(function (btn) {
          clearTimeout(btn._acCopyTimer);
          btn.textContent = t.copy;
        });
        if (copyErrorBtn) clearStatus();
      }

      textEl.addEventListener('input', invalidateCopies);
      codesEl.addEventListener('input', invalidateCopies);

      /* ── engine:start ── */
      /* ── Format a code point based on selected format ── */
      function formatCode(cp, fmt) {
        switch (fmt) {
          case 'hex': return '0x' + cp.toString(16).toUpperCase();
          case 'oct': return '0o' + cp.toString(8);
          case 'bin': return '0b' + cp.toString(2);
          default:    return String(cp);
        }
      }

      /* ── Read one code token: the whole token must be digits of its base ── */
      var CODE_FORMS = [
        [/^0x([0-9a-f]+)$/i, 16],
        [/^0o([0-7]+)$/i, 8],
        [/^0b([01]+)$/i, 2],
        [/^([0-9]+)$/, 10],
      ];
      function parseCode(tok) {
        for (var f = 0; f < CODE_FORMS.length; f++) {
          var m = CODE_FORMS[f][0].exec(tok);
          if (m) {
            var num = parseInt(m[1], CODE_FORMS[f][1]);
            if (num > 0x10FFFF || (num >= 0xD800 && num <= 0xDFFF)) {
              throw new Error('Code point out of range: ' + tok);
            }
            return num;
          }
        }
        throw new Error('Invalid code: ' + tok);
      }
      /* ── engine:end ── */

      /* ── Text → ASCII ── */
      document.getElementById('ac-to-ascii').addEventListener('click', function () {
        invalidateCopies();
        var val = textEl.value;
        if (!val) { clearStatus(); codesEl.value = ''; return; }

        try {
          var fmt = formatEl.value;
          var codes = [];
          for (var i = 0; i < val.length; ) {
            var cp = val.codePointAt(i);
            codes.push(formatCode(cp, fmt));
            i += cp > 0xFFFF ? 2 : 1;
          }
          codesEl.value = codes.join(' ');
          setStatus(countMessage(t.convertedChars, codes.length), false);
          window.trackTool && window.trackTool('ascii_converter', 'text_to_ascii');
        } catch (e) {
          codesEl.value = '';
          setStatus('Error: ' + e.message, true);
        }
      });

      /* ── ASCII → Text ── */
      document.getElementById('ac-to-text').addEventListener('click', function () {
        invalidateCopies();
        var val = codesEl.value.trim();
        if (!val) { clearStatus(); textEl.value = ''; return; }

        try {
          /* Split on whitespace and/or commas */
          var tokens = val.split(/[\s,]+/).filter(function (t) { return t.length > 0; });
          var chars = [];
          for (var i = 0; i < tokens.length; i++) {
            chars.push(String.fromCodePoint(parseCode(tokens[i])));
          }
          textEl.value = chars.join('');
          setStatus(countMessage(t.convertedCodes, tokens.length), false);
          window.trackTool && window.trackTool('ascii_converter', 'ascii_to_text');
        } catch (e) {
          textEl.value = '';
          setStatus('Error: ' + e.message, true);
        }
      });

      /* ── Clear ── */
      document.getElementById('ac-clear').addEventListener('click', function () {
        textEl.value = '';
        codesEl.value = '';
        textEl.dispatchEvent(new Event('input', { bubbles: true }));
        codesEl.dispatchEvent(new Event('input', { bubbles: true }));
        clearStatus();
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var widget = document.querySelector('.ac-wrap');
        if (widget && widget.contains(document.activeElement)) {
          invalidateCopies();
          clearStatus();
        }
      });

      /* ── Copy buttons ── */
      function copyValue(value, btn) {
        if (!value) return;
        var revision = copyRevision;
        var request = btn._acCopyRequest = (btn._acCopyRequest || 0) + 1;
        clearTimeout(btn._acCopyTimer);
        btn.textContent = t.copy;
        function current() { return revision === copyRevision && request === btn._acCopyRequest; }
        function done() {
          if (!current()) return;
          if (copyErrorBtn === btn) clearStatus();
          btn.textContent = t.copied;
          btn._acCopyTimer = setTimeout(function () { if (current()) btn.textContent = t.copy; }, 1500);
        }
        function failed() {
          if (!current()) return;
          setStatus(t.copyFail, true);
          copyErrorBtn = btn;
        }
        try { navigator.clipboard.writeText(value).then(done, failed); }
        catch (e) { failed(); }
      }
      copyTextBtn.addEventListener('click', function () { copyValue(textEl.value, copyTextBtn); });
      copyCodesBtn.addEventListener('click', function () { copyValue(codesEl.value, copyCodesBtn); });

      /* ── Build reference table (printable ASCII 32–126, 3 columns) ── */
      (function buildRefTable() {
        var tbody = document.getElementById('ac-ref-tbody');
        var chars = [];
        for (var c = 32; c <= 126; c++) chars.push(c);
        var cols = 3;
        var rows = Math.ceil(chars.length / cols);

        for (var r = 0; r < rows; r++) {
          var tr = document.createElement('tr');
          for (var col = 0; col < cols; col++) {
            var idx = col * rows + r;
            if (idx < chars.length) {
              var code = chars[idx];
              var ch = code === 32 ? 'SP' : String.fromCharCode(code);

              var tdChar = document.createElement('td');
              tdChar.textContent = ch;
              var tdDec = document.createElement('td');
              tdDec.textContent = String(code);
              var tdHex = document.createElement('td');
              tdHex.textContent = '0x' + code.toString(16).toUpperCase();

              tr.appendChild(tdChar);
              tr.appendChild(tdDec);
              tr.appendChild(tdHex);
            } else {
              for (var k = 0; k < 3; k++) {
                tr.appendChild(document.createElement('td'));
              }
            }
          }
          tbody.appendChild(tr);
        }
      })();
    })();
  </script>
</div>

<style>
  .ac-wrap { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; }
  .ac-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 0.75rem; flex: none; }
  .ac-format { display: flex; align-items: center; gap: 0.35rem; min-width: 0; font-size: 0.85rem; color: var(--color-text-secondary); }
  .ac-format select { width: auto; font-size: 0.82rem; }
  .ac-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-left: auto; }
  .ac-head { display: flex; align-items: center; gap: 0.25rem; min-height: 32px; flex: none; }
  .ac-head label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .ac-copy-controls { display: flex; align-items: center; gap: 0.25rem; margin-left: auto; flex: none; }
  .ac-box { width: 100%; overflow: auto; font-family: var(--font-mono); font-size: 0.88rem; }
  .ac-status { flex: none; height: 2.8em; line-height: 1.4; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; }
  .ac-status.success { color: var(--color-success); }
  .ac-status.error { color: var(--color-danger); }
  .ac-reference { display: flex; align-items: flex-start; gap: 0.35rem; flex: none; min-width: 0; }
  .ac-reference > :global(.zt-tip) { margin-top: 0.4rem; }
  .ac-ref { flex: 1; min-width: 0; border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .ac-ref summary { padding: 0.6rem 0.75rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); cursor: pointer; user-select: none; }
  .ac-ref-table-wrap { max-height: 400px; overflow: auto; padding: 0 0.75rem 0.75rem; }
  .ac-ref-table { width: 100%; border-collapse: collapse; font-size: 0.78rem; font-family: var(--font-mono); }
  .ac-ref-table th,
  .ac-ref-table :global(td) { padding: 0.25rem 0.5rem; text-align: left; border-bottom: 1px solid var(--color-border); }
  .ac-ref-table th { font-family: inherit; font-weight: 600; color: var(--color-text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; position: sticky; top: 0; background: var(--color-bg-secondary); }
  .ac-ref-table :global(tbody tr:last-child td) { border-bottom: none; }
  @media (max-width: 860px) {
    .ac-box { height: 160px; }
  }
  @media (max-width: 640px) {
    .ac-controls { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 0.5rem; }
    .ac-format { flex-wrap: wrap; }
    .ac-format label { width: 100%; }
    .ac-format select { flex: 1; min-width: 0; }
    .ac-actions { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); margin-left: 0; }
    .ac-wrap .ac-actions .btn-primary { min-width: 0; padding-left: 0.45rem; padding-right: 0.45rem; }
    .ac-status { height: 4.2em; }
    .ac-box { height: 120px; }
    .ac-ref summary { min-height: 44px; }
  }
</style>
