---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: {
    spaces2: "2 spaces", spaces4: "4 spaces", tab: "Tab",
    tips: {
      mode: "Minify removes ordinary comments and collapses HTML whitespace. Beautify re-indents the parsed markup. Each button selects the mode used after typing; Ctrl/⌘+Enter runs Minify.",
      indent: "Choose 2 spaces, 4 spaces or Tab for Beautify. Changing this option immediately reruns the current mode.",
      clear: "Clear removes both fields, status and pending processing. Ctrl/⌘+L does the same while focus is in this tool.",
      input: "Enter an HTML fragment or a full document. Processing runs 300 ms after typing stops, using the last selected mode. The browser parser repairs malformed markup.",
      output: "The result is serialized HTML. After Minify, the status shows the original and output byte counts and the percentage change. Inline JavaScript and CSS are not minified.",
      copy: "Copy the complete output text. The input panel has its own Copy button for the original text.",
    },
    copyFailed: 'Copy failed. Try again.',
    copy: 'Copy', copied: 'Copied!', clear: 'Clear',
    minify: 'Minify', beautify: 'Beautify',
    htmlInput: 'HTML Input', output: 'Output',
    inputPh: 'Paste your HTML here…',
    outputPh: 'Minified or beautified HTML will appear here…',
    indent: 'Indent:',
    statusMin: 'Minified — {orig} → {out} ({pct})',
    statusBeauty: 'Beautified successfully.',
    statusErr: 'Error: ',
    bytes: 'B', kbytes: 'KB',
  },
  zh: {
    spaces2: "2 个空格", spaces4: "4 个空格", tab: "Tab",
    tips: {
      mode: "压缩会删除普通注释并折叠 HTML 空白；美化会重新缩进解析后的标记。按钮会选择后续输入时使用的模式；Ctrl/⌘+Enter 执行压缩。",
      indent: "为美化选择 2 个空格、4 个空格或 Tab。改变此选项会立即按当前模式重新处理。",
      clear: "清除会清空两栏、状态和排队的处理任务。焦点在工具内时，Ctrl/⌘+L 执行相同操作。",
      input: "输入 HTML 片段或完整文档。停止输入 300 毫秒后会按最近选择的模式处理；浏览器解析器会修复不完整的标记。",
      output: "结果是序列化的 HTML。压缩后的状态行显示原始与输出字节数及变化百分比；内联 JavaScript 和 CSS 不做压缩。",
      copy: "复制完整输出文本。输入面板另有复制按钮，用于复制原始文本。",
    },
    copyFailed: '复制失败，请重试。',
    copy: '复制', copied: '已复制！', clear: '清除',
    minify: '压缩', beautify: '美化',
    htmlInput: 'HTML 输入', output: '输出',
    inputPh: '在此粘贴 HTML…',
    outputPh: '压缩或美化后的 HTML 将显示在这里…',
    indent: '缩进：',
    statusMin: '已压缩 — {orig} → {out} ({pct})',
    statusBeauty: '已美化。',
    statusErr: '错误：',
    bytes: 'B', kbytes: 'KB',
  },
  ja: {
    spaces2: "2 スペース", spaces4: "4 スペース", tab: "Tab",
    tips: {
      mode: "圧縮は通常のコメントを削除し、HTML の空白をまとめます。整形は解析したマークアップのインデントを整えます。選んだモードは次の入力にも使われ、Ctrl/⌘+Enter は圧縮を実行します。",
      indent: "整形用に 2 スペース、4 スペース、Tab を選べます。変更すると現在のモードで直ちに再処理します。",
      clear: "クリアは両欄、ステータス、待機中の処理を消去します。ツール内にフォーカスがあるときは Ctrl/⌘+L でも実行できます。",
      input: "HTML の断片または完全な文書を入力します。入力停止から 300 ミリ秒後、最後に選んだモードで処理します。ブラウザーのパーサーは不正なマークアップを修復します。",
      output: "結果はシリアライズされた HTML です。圧縮後のステータスには元と出力のバイト数、変化率が表示されます。インライン JavaScript と CSS は圧縮しません。",
      copy: "出力テキスト全体をコピーします。元のテキストには入力パネルのコピーを使えます。",
    },
    copyFailed: 'コピーに失敗しました。再試行してください。',
    copy: 'コピー', copied: 'コピー済み！', clear: 'クリア',
    minify: '圧縮', beautify: '整形',
    htmlInput: 'HTML 入力', output: '出力',
    inputPh: 'ここに HTML を貼り付け…',
    outputPh: '圧縮または整形された HTML がここに表示されます…',
    indent: 'インデント：',
    statusMin: '圧縮完了 — {orig} → {out} ({pct})',
    statusBeauty: '整形が完了しました。',
    statusErr: 'エラー：',
    bytes: 'B', kbytes: 'KB',
  },
  ko: {
    spaces2: "공백 2개", spaces4: "공백 4개", tab: "Tab",
    tips: {
      mode: "압축은 일반 주석을 제거하고 HTML 공백을 줄입니다. 정렬은 파싱한 마크업의 들여쓰기를 정리합니다. 선택한 모드는 이후 입력에도 적용되며 Ctrl/⌘+Enter는 압축을 실행합니다.",
      indent: "정렬에 사용할 공백 2개, 공백 4개 또는 Tab을 선택합니다. 변경하면 현재 모드로 즉시 다시 처리합니다.",
      clear: "지우기는 두 입력란, 상태와 대기 중인 처리를 지웁니다. 도구 안에 포커스가 있을 때 Ctrl/⌘+L도 같은 동작을 합니다.",
      input: "HTML 조각이나 전체 문서를 입력합니다. 입력을 멈춘 뒤 300밀리초가 지나면 마지막으로 선택한 모드로 처리합니다. 브라우저 파서는 잘못된 마크업을 복구합니다.",
      output: "결과는 직렬화된 HTML입니다. 압축 후 상태에 원본과 출력 바이트 수, 변화율이 표시됩니다. 인라인 JavaScript와 CSS는 압축하지 않습니다.",
      copy: "출력 텍스트 전체를 복사합니다. 원본 텍스트는 입력 패널의 복사 버튼으로 복사할 수 있습니다.",
    },
    copyFailed: '복사하지 못했습니다. 다시 시도하세요.',
    copy: '복사', copied: '복사됨!', clear: '지우기',
    minify: '압축', beautify: '정렬',
    htmlInput: 'HTML 입력', output: '출력',
    inputPh: '여기에 HTML 붙여넣기…',
    outputPh: '압축 또는 정렬된 HTML이 여기에 표시됩니다…',
    indent: '들여쓰기：',
    statusMin: '압축됨 — {orig} → {out} ({pct})',
    statusBeauty: '정렬이 완료되었습니다.',
    statusErr: '오류：',
    bytes: 'B', kbytes: 'KB',
  },
};
// strings:end
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="hm-wrap">
  <div class="hm-actions">
    <div class="hm-control">
      <button id="hm-minify" class="btn-primary" type="button">{T.minify}</button>
      <button id="hm-beautify" class="btn-primary" type="button">{T.beautify}</button>
      <Toggletip id="hm-tip-mode" lang={lang} about={T.minify + ' / ' + T.beautify}>{TIPS.mode}</Toggletip>
    </div>
    <div class="hm-control">
      <button id="hm-clear" class="btn-ghost" type="button">{T.clear}</button>
      <Toggletip id="hm-tip-clear" lang={lang} about={T.clear}>{TIPS.clear}</Toggletip>
    </div>
    <div class="hm-control hm-indent-label">
      <label for="hm-indent">{T.indent}</label>
      <select id="hm-indent">
        <option value="2" selected>{T.spaces2}</option>
        <option value="4">{T.spaces4}</option>
        <option value="tab">{T.tab}</option>
      </select>
      <Toggletip id="hm-tip-indent" lang={lang} about={T.indent}>{TIPS.indent}</Toggletip>
    </div>
  </div>
  <div id="hm-status" class="tool-status" aria-live="polite"></div>

  <div class="hm-panels zt-io">
    <div class="hm-panel zt-io-pane">
      <div class="hm-panel-head">
        <div class="hm-control">
          <label for="hm-input">{T.htmlInput}</label>
          <Toggletip id="hm-tip-input" lang={lang} about={T.htmlInput}>{TIPS.input}</Toggletip>
        </div>
        <button id="hm-copy-input" class="btn-copy" type="button">{T.copy}</button>
      </div>
      <textarea id="hm-input" class="tool-textarea hm-textarea zt-io-fill" placeholder={T.inputPh} spellcheck="false"></textarea>
    </div>
    <div id="hm-output-pane" class="hm-panel hm-output-pane zt-io-pane">
      <div class="hm-panel-head">
        <div class="hm-control">
          <label for="hm-output">{T.output}</label>
          <Toggletip id="hm-tip-output" lang={lang} about={T.output}>{TIPS.output}</Toggletip>
        </div>
        <div class="hm-control hm-copy-group">
          <button id="hm-copy-output" class="btn-copy" type="button">{T.copy}</button>
          <Toggletip id="hm-tip-copy" lang={lang} about={T.copy}>{TIPS.copy}</Toggletip>
        </div>
      </div>
      <textarea id="hm-output" class="tool-textarea hm-textarea zt-io-fill" readonly placeholder={T.outputPh} spellcheck="false"></textarea>
    </div>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var inputEl = document.getElementById('hm-input');
      var outputEl = document.getElementById('hm-output');
      var statusEl = document.getElementById('hm-status');
      var copyInputBtn = document.getElementById('hm-copy-input');
      var copyOutputBtn = document.getElementById('hm-copy-output');
      var indentEl = document.getElementById('hm-indent');
      var lastMode = 'minify';
      var copyStates = [];

      function resetCopies() {
        copyStates.forEach(function (state) {
          state.request++;
          clearTimeout(state.timer);
          state.btn.textContent = t.copy;
          state.btn.classList.remove('copied');
        });
      }

      function setStatus(msg, kind) {
        statusEl.textContent = msg;
        statusEl.className = 'tool-status ' + (kind || 'success');
      }
      function clearStatus() {
        statusEl.textContent = '';
        statusEl.className = 'tool-status';
      }
      function getIndent() {
        var v = indentEl.value;
        if (v === 'tab') return '\t';
        var n = parseInt(v, 10) || 2;
        return new Array(n + 1).join(' ');
      }
      /* ── engine:start ── */
      var VOID_ELEMENTS = {
        area:1, base:1, br:1, col:1, embed:1, hr:1, img:1, input:1,
        link:1, meta:1, source:1, track:1, wbr:1,
      };
      var PRESERVE_ELEMENTS = {
        script:1, style:1, pre:1, textarea:1, code:1, samp:1, kbd:1,
      };

      /* Phrasing elements: leading / trailing spaces inside them are visible text
         ("<strong>Note: </strong>text"), so they are collapsed but not removed. */
      var INLINE_ELEMENTS = {
        a:1, abbr:1, b:1, bdi:1, bdo:1, button:1, cite:1, data:1, dfn:1, em:1, i:1, label:1,
        mark:1, q:1, rp:1, rt:1, ruby:1, s:1, small:1, span:1, strong:1, sub:1, sup:1, time:1,
        u:1, var:1, del:1, ins:1, font:1, big:1, tt:1, strike:1, output:1, option:1, legend:1,
      };
      /* HTML "ASCII whitespace" (Infra standard). \s would also match U+00A0, the character
         &nbsp; stands for, and turn a non-breaking space into a normal one. */
      var WS_RUN = /[ \t\n\f\r]+/g;
      function wsTrim(s) { return s.replace(/^[ \t\n\f\r]+|[ \t\n\f\r]+$/g, ''); }

      function escapeAttr(s) {
        return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
      }
      function escapeText(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function formatBytes(n) {
        if (n < 1024) return n + ' ' + t.bytes;
        return (n / 1024).toFixed(1) + ' ' + t.kbytes;
      }
      function isFragment(raw) {
        return !/<(html|head|body)[\s>]/i.test(raw) && !/<!doctype/i.test(raw);
      }
      function repeat(s, n) {
        var out = ''; for (var i = 0; i < n; i++) out += s; return out;
      }

      function attrsString(el) {
        var attrs = '';
        for (var i = 0; i < el.attributes.length; i++) {
          var a = el.attributes[i];
          if (a.value === '') {
            attrs += ' ' + a.name;
          } else {
            attrs += ' ' + a.name + '="' + escapeAttr(a.value) + '"';
          }
        }
        return attrs;
      }

      function serializeNode(node, mode, depth, indent, parts) {
        var pad = (mode === 'beautify') ? repeat(indent, depth) : '';
        var nl = (mode === 'beautify') ? '\n' : '';

        switch (node.nodeType) {
          case 1: { /* Element */
            var tag = node.tagName.toLowerCase();
            var attrs = attrsString(node);

            if (VOID_ELEMENTS[tag]) {
              parts.push(pad + '<' + tag + attrs + '>' + nl);
              return;
            }
            if (PRESERVE_ELEMENTS[tag]) {
              /* A pre / textarea inside this element is written by this innerHTML call too; its
                 text gets the LF described below only for the call. */
              var lfTexts = [];
              (function findLF(el) {
                for (var i = 0; i < el.childNodes.length; i++) {
                  var c = el.childNodes[i];
                  if (c.nodeType !== 1) continue;
                  var ct = c.tagName.toLowerCase(), cf = c.childNodes[0];
                  if ((ct === 'pre' || ct === 'textarea') && cf && cf.nodeType === 3 && cf.data.charAt(0) === '\n') lfTexts.push(cf);
                  findLF(c);
                }
              })(node);
              for (var k = 0; k < lfTexts.length; k++) lfTexts[k].data = '\n' + lfTexts[k].data;
              var inner = node.innerHTML;
              for (k = 0; k < lfTexts.length; k++) lfTexts[k].data = lfTexts[k].data.slice(1);
              /* The parser ignores one LF right after <pre> / <textarea> and innerHTML does not
                 write it back (HTML Standard), so text that starts with a newline would lose its
                 first blank line on the next parse: write that LF back. */
              var first = node.childNodes[0];
              if ((tag === 'pre' || tag === 'textarea') && first && first.nodeType === 3 && first.data.charAt(0) === '\n' &&
                  inner.search(/[^\n]|$/) === first.data.search(/[^\n]|$/)) {
                inner = '\n' + inner;
              }
              if (mode === 'minify') {
                parts.push('<' + tag + attrs + '>' + inner + '</' + tag + '>');
              } else {
                /* Only raw-text elements (script/style) get newlines around inner content.
                   pre/textarea/code/samp/kbd are whitespace-sensitive: adding newlines
                   would change rendering and the operation would not be idempotent. */
                var isRawText = (tag === 'script' || tag === 'style');
                if (isRawText && inner && inner.indexOf('\n') !== -1) {
                  parts.push(pad + '<' + tag + attrs + '>' + nl + inner + nl + pad + '</' + tag + '>' + nl);
                } else {
                  parts.push(pad + '<' + tag + attrs + '>' + inner + '</' + tag + '>' + nl);
                }
              }
              return;
            }
            if (node.childNodes.length === 0) {
              parts.push(pad + '<' + tag + attrs + '></' + tag + '>' + nl);
              return;
            }
            /* Single text child collapse */
            if (node.childNodes.length === 1 && node.childNodes[0].nodeType === 3) {
              var txt = node.childNodes[0].data;
              if (mode === 'minify') {
                var collapsed = txt.replace(WS_RUN, ' ');
                if (!INLINE_ELEMENTS[tag]) collapsed = wsTrim(collapsed);
                parts.push('<' + tag + attrs + '>' + escapeText(collapsed) + '</' + tag + '>');
              } else {
                var trimmed = wsTrim(txt);
                if (trimmed && trimmed.length < 80 && trimmed.indexOf('\n') === -1) {
                  parts.push(pad + '<' + tag + attrs + '>' + escapeText(trimmed) + '</' + tag + '>' + nl);
                } else {
                  parts.push(pad + '<' + tag + attrs + '>' + nl);
                  parts.push(repeat(indent, depth + 1) + escapeText(trimmed) + nl);
                  parts.push(pad + '</' + tag + '>' + nl);
                }
              }
              return;
            }
            /* Has children */
            parts.push(pad + '<' + tag + attrs + '>' + nl);
            for (var c = 0; c < node.childNodes.length; c++) {
              serializeNode(node.childNodes[c], mode, depth + 1, indent, parts);
            }
            parts.push(pad + '</' + tag + '>' + nl);
            return;
          }
          case 3: { /* Text */
            var data = node.data;
            if (mode === 'minify') {
              var c2 = data.replace(WS_RUN, ' ');
              /* Keep whitespace-only text nodes (collapsed to a single space).
                 They preserve inter-token spacing for inline content like
                 `<span>A</span> <span>B</span>`; dropping them would render as `AB`. */
              if (!c2) return;
              parts.push(escapeText(c2));
            } else {
              var trimmed2 = wsTrim(data);
              if (trimmed2) parts.push(pad + escapeText(trimmed2) + nl);
            }
            return;
          }
          case 8: { /* Comment */
            if (mode === 'minify') {
              /* Keep IE conditional comments (both [if ...] openers and [endif] closers). */
              if (/^\[if /i.test(node.data) || /\[endif\]/i.test(node.data)) {
                parts.push('<!--' + node.data + '-->');
              }
            } else {
              parts.push(pad + '<!--' + node.data + '-->' + nl);
            }
            return;
          }
        }
      }

      /* Fragment mode: the HTML parser moves some fragment content out of <body>:
         comments before the first element go to the Document or <html>, and <title>,
         <meta>, <link>, <style>, <script> before body content go to <head>. Serialize
         everything except the implied html / head / body wrappers, in document order. */
      function processDoc(doc, raw, mode, indent) {
        var parts = [];
        var fragment = isFragment(raw);

        if (!fragment && doc.doctype) {
          if (mode === 'minify') {
            parts.push('<!doctype ' + doc.doctype.name + '>');
          } else {
            parts.push('<!doctype ' + doc.doctype.name + '>\n');
          }
        }

        if (fragment) {
          var top = doc.childNodes;
          for (var i = 0; i < top.length; i++) {
            var n = top[i];
            if (n.nodeType === 10) continue;
            if (n === doc.documentElement) {
              for (var j = 0; j < n.childNodes.length; j++) {
                var c = n.childNodes[j];
                var name = c.nodeType === 1 ? c.tagName.toLowerCase() : '';
                if (name === 'head' || name === 'body') {
                  for (var k = 0; k < c.childNodes.length; k++) serializeNode(c.childNodes[k], mode, 0, indent, parts);
                } else {
                  serializeNode(c, mode, 0, indent, parts);
                }
              }
            } else {
              serializeNode(n, mode, 0, indent, parts);
            }
          }
        } else {
          var nodes = doc.childNodes;
          for (var m = 0; m < nodes.length; m++) {
            if (nodes[m].nodeType === 10) continue;
            serializeNode(nodes[m], mode, 0, indent, parts);
          }
        }

        var out = parts.join('');
        return (mode === 'minify') ? wsTrim(out) : out.replace(/\n+$/, '\n');
      }
      /* ── engine:end ── */

      function process(raw, mode) {
        var doc = new DOMParser().parseFromString(raw, 'text/html');
        return processDoc(doc, raw, mode, getIndent());
      }

      function run(mode) {
        clearTimeout(liveTimer);
        resetCopies();
        var raw = inputEl.value;
        if (!raw.trim()) { outputEl.value = ''; clearStatus(); return; }
        try {
          var output = process(raw, mode);
          outputEl.value = output;
          if (mode === 'minify') {
            var origBytes = new Blob([raw]).size;
            var outBytes = new Blob([output]).size;
            var pct = origBytes > 0
              ? ((origBytes - outBytes) / origBytes * 100).toFixed(1) + '%'
              : '0%';
            var sign = (outBytes <= origBytes) ? '−' : '+';
            setStatus(
              t.statusMin
                .replace('{orig}', formatBytes(origBytes))
                .replace('{out}', formatBytes(outBytes))
                .replace('{pct}', sign + pct.replace('-', '')),
              'success'
            );
          } else {
            setStatus(t.statusBeauty, 'success');
          }
          window.trackTool && window.trackTool('html_minifier', mode);
        } catch (e) {
          outputEl.value = '';
          setStatus(t.statusErr + (e && e.message ? e.message : 'Failed'), 'error');
        }
      }

      var liveTimer = null;
      inputEl.addEventListener('input', function () {
        resetCopies();
        clearTimeout(liveTimer);
        liveTimer = setTimeout(function () { run(lastMode); }, 300);
      });

      document.getElementById('hm-minify').addEventListener('click', function () {
        lastMode = 'minify';
        run('minify');
      });
      document.getElementById('hm-beautify').addEventListener('click', function () {
        lastMode = 'beautify';
        run('beautify');
      });
      indentEl.addEventListener('change', function () { run(lastMode); });

      function clearAll() {
        clearTimeout(liveTimer);
        resetCopies();
        inputEl.value = ''; outputEl.value = ''; clearStatus();
      }
      document.getElementById('hm-clear').addEventListener('click', clearAll);
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var wrap = document.querySelector('.hm-wrap');
        if (!wrap || !wrap.contains(document.activeElement)) return;
        e.preventDefault();
        inputEl.focus();
        clearAll();
      });

      function wireCopy(btn, source) {
        var state = { btn: btn, request: 0, timer: null };
        copyStates.push(state);
        btn.addEventListener('click', function () {
          var text = source.value;
          if (!text) return;
          var request = ++state.request;
          clearTimeout(state.timer);
          btn.textContent = t.copy;
          btn.classList.remove('copied');
          function failed() {
            if (request !== state.request || source.value !== text) return;
            btn.textContent = t.copyFailed;
          }
          function done() {
            if (request !== state.request || source.value !== text) return;
            btn.textContent = t.copied;
