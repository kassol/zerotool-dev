    msgFormulaRisk: '有 {n} 个值以 = + - @、Tab 或换行开头，表格软件可能把它们当公式执行。数据来自他人时请开启公式防护。',
    msgFormulaGuarded: '已对 {n} 个值加公式防护。',
  },
  ja: {
    empty: "JSON 配列を入力するかサンプルを読み込むと、CSV に変換します。",
    options: "その他の CSV 設定",
    tips: {
      input: "JSON 配列を入力します。入力停止から 300 ミリ秒後に変換し、設定の変更は即時反映します。無効な JSON では出力を消去します。",
      delimiter: "列をカンマ、セミコロン、タブで区切ります。選択した区切り文字、引用符、改行を含むフィールドは自動で引用符で囲みます。",
      flatten: "オンでは空でないネストしたオブジェクトをドットパス列に展開します。オフでは JSON テキストにします。配列と空のオブジェクトは 1 列に保持します。",
      header: "全行のキーの和集合を先頭行のヘッダーにします。欠けている値は空のフィールドになります。",
