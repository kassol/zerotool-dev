const L = STRINGS[lang];
---

<div
  class="jtc-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-msg-rows={L.msgRows}
  data-msg-one-row={L.msgOneRow}
  data-msg-empty-array={L.msgEmptyArray}
  data-msg-not-array={L.msgNotArray}
  data-msg-too-deep={L.msgTooDeep}
  data-err-json={L.errJson}
  data-err-json-at={L.errJsonAt}
  data-json-parse={JSON.stringify(L.jsonParse)}
  data-msg-formula-risk={L.msgFormulaRisk}
  data-msg-formula-guarded={L.msgFormulaGuarded}
>
  <div class="jtc-config">
    <div class="jtc-config-row">
      <div class="jtc-control-label"><span id="jtc-delimiter-label">{L.delimiter}</span><Toggletip id="jtc-tip-delimiter" lang={lang} about={L.delimiter}>{L.tips.delimiter}</Toggletip></div>
      <div class="jtc-tabs zt-segmented" id="jtc-del-tabs" role="group" aria-labelledby="jtc-delimiter-label">
        <button type="button" class="jtc-tab active" aria-pressed="true" data-del=",">{L.delComma}</button>
        <button type="button" class="jtc-tab" aria-pressed="false" data-del=";">{L.delSemicolon}</button>
        <button type="button" class="jtc-tab" aria-pressed="false" data-del={'\t'}>{L.delTab}</button>
      </div>
    </div>
  </div>
  <details id="jtc-options" class="jtc-options">
    <summary>{L.options}</summary>
    <div class="jtc-config jtc-secondary">
    <div class="jtc-config-row">
      <div class="jtc-control-label"><span id="jtc-flatten-label">{L.flatten}</span><Toggletip id="jtc-tip-flatten" lang={lang} about={L.flatten}>{L.tips.flatten}</Toggletip></div>
      <div class="jtc-tabs zt-segmented" id="jtc-flatten-tabs" role="group" aria-labelledby="jtc-flatten-label">
        <button type="button" class="jtc-tab active" aria-pressed="true" data-flatten="true">{L.on}</button>
        <button type="button" class="jtc-tab" aria-pressed="false" data-flatten="false">{L.off}</button>
      </div>
    </div>
    <div class="jtc-config-row">
      <div class="jtc-control-label"><span id="jtc-header-label">{L.header}</span><Toggletip id="jtc-tip-header" lang={lang} about={L.header}>{L.tips.header}</Toggletip></div>
      <div class="jtc-tabs zt-segmented" id="jtc-header-tabs" role="group" aria-labelledby="jtc-header-label">
        <button type="button" class="jtc-tab active" aria-pressed="true" data-header="true">{L.on}</button>
        <button type="button" class="jtc-tab" aria-pressed="false" data-header="false">{L.off}</button>
      </div>
    </div>
    <div class="jtc-config-row">
      <div class="jtc-control-label"><span id="jtc-formula-label">{L.formula}</span><Toggletip id="jtc-tip-formula" lang={lang} about={L.formula}>{L.tips.formula}</Toggletip></div>
      <div class="jtc-tabs zt-segmented" id="jtc-guard-tabs" role="group" aria-labelledby="jtc-formula-label">
        <button type="button" class="jtc-tab active" aria-pressed="true" data-guard="off">{L.guardOff}</button>
        <button type="button" class="jtc-tab" aria-pressed="false" data-guard="quote">{L.guardQuote}</button>
        <button type="button" class="jtc-tab" aria-pressed="false" data-guard="tab">{L.guardTab}</button>
      </div>
    </div>
    <div class="jtc-config-row">
      <div class="jtc-control-label"><span id="jtc-bom-label">{L.bom}</span><Toggletip id="jtc-tip-bom" lang={lang} about={L.bom}>{L.tips.bom}</Toggletip></div>
      <div class="jtc-tabs zt-segmented" id="jtc-bom-tabs" role="group" aria-labelledby="jtc-bom-label">
        <button type="button" class="jtc-tab active" aria-pressed="true" data-bom="true">{L.on}</button>
        <button type="button" class="jtc-tab" aria-pressed="false" data-bom="false">{L.off}</button>
      </div>
    </div>
  </div>
  </details>

  <div class="jtc-actions">
    <div class="jtc-control-label"><button id="jtc-example" class="btn-ghost" type="button">{L.example}</button><Toggletip id="jtc-tip-example" lang={lang} about={L.example}>{L.tips.example}</Toggletip></div>
    <div class="jtc-control-label"><button id="jtc-clear" class="btn-ghost" type="button">{L.clear}</button><Toggletip id="jtc-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip></div>
  </div>
  <div id="jtc-status" class="jtc-status" aria-live="polite"></div>

  <div class="jtc-panels zt-io">
    <div class="jtc-panel zt-io-pane">
      <div class="jtc-panel-header"><div class="jtc-control-label"><label for="jtc-input">{L.jsonInput}</label><Toggletip id="jtc-tip-input" lang={lang} about={L.jsonInput}>{L.tips.input}</Toggletip></div></div>
      <textarea id="jtc-input" class="zt-io-fill" spellcheck="false" placeholder='[{"id": 1, "name": "Alice"}]'></textarea>
    </div>
    <div class="jtc-panel jtc-output-pane zt-io-pane">
      <div class="jtc-panel-header">
        <span id="jtc-output-label">{L.csvOutput}</span>
        <div class="jtc-panel-actions">
          <div class="jtc-control-label"><button id="jtc-download" class="btn-ghost" type="button">{L.download}</button><Toggletip id="jtc-tip-download" lang={lang} about={L.download}>{L.tips.download}</Toggletip></div>
          <div class="jtc-control-label"><button id="jtc-copy" class="btn-ghost" type="button">{L.copy}</button><Toggletip id="jtc-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip></div>
        </div>
      </div>
      <p class="jtc-empty zt-io-fill">{L.empty}</p>
      <textarea id="jtc-output" class="jtc-output zt-io-fill" data-empty="true" tabindex="0" aria-labelledby="jtc-output-label" spellcheck="false" readonly wrap="off"></textarea>
    </div>
  </div>

  <script>
    (function () {
      var wrap = document.querySelector('.jtc-wrap');
      if (!wrap) return;

      var COPY = wrap.dataset.copy || 'Copy';
      var COPIED = wrap.dataset.copied || 'Copied!';
      var COPY_FAILED = wrap.dataset.copyFailed || 'Copy failed';
      var MSG_ROWS = wrap.dataset.msgRows || '{n} rows converted';
      var MSG_ONE_ROW = wrap.dataset.msgOneRow || '1 row converted';
      var MSG_EMPTY = wrap.dataset.msgEmptyArray || 'Empty array — nothing to convert';
      var MSG_NOT_ARRAY = wrap.dataset.msgNotArray || 'Input must be a JSON array of objects';
      var MSG_TOO_DEEP = wrap.dataset.msgTooDeep || 'The JSON is nested too deeply to convert in this browser (the call stack ran out). Nothing was converted.';
      var ERR_JSON = wrap.dataset.errJson || 'This is not valid JSON.';
      var ERR_JSON_AT = wrap.dataset.errJsonAt || 'This is not valid JSON: line {line}, column {col}, {reason}.';
      var JSON_PARSE: Record<string, string> = {};
      try { JSON_PARSE = JSON.parse(wrap.dataset.jsonParse || '{}'); } catch (e) {}
      var MSG_FORMULA_RISK = wrap.dataset.msgFormulaRisk || '';
      var MSG_FORMULA_GUARDED = wrap.dataset.msgFormulaGuarded || '';

      var inputEl = document.getElementById('jtc-input') as HTMLTextAreaElement;
      var outputEl = document.getElementById('jtc-output') as HTMLTextAreaElement;
      var statusEl = document.getElementById('jtc-status');
      var copyBtn = document.getElementById('jtc-copy')!;
      var copyRevision = 0;
      var copyTimer: ReturnType<typeof setTimeout> | null = null;

      function resetCopy() {
        copyRevision++;
        clearTimeout(copyTimer!);
        copyBtn.textContent = COPY;
      }

      var delimiter = ',';
      var flatten = true;
      var includeHeader = true;
      var guard = 'off';
      var addBom = true;

      var EXAMPLE = JSON.stringify([
        { id: 1, name: 'Alice', address: { city: 'NY', zip: '10001' } },
        { id: 2, name: 'Bob', address: { city: 'LA', zip: '90001' } },
      ], null, 2);

      function wireTabs(containerId: string, prop: string, setter: (v: string) => void) {
        var tabs = wrap!.querySelectorAll('#' + containerId + ' .jtc-tab');
        for (var i = 0; i < tabs.length; i++) {
          (function (tab) {
            tab.addEventListener('click', function () {
              for (var j = 0; j < tabs.length; j++) { tabs[j].classList.remove('active'); tabs[j].setAttribute('aria-pressed', 'false'); }
              tab.classList.add('active');
              tab.setAttribute('aria-pressed', 'true');
              setter((tab as HTMLElement).dataset[prop] || '');
              convert();
              trackChange();
            });
          })(tabs[i]);
        }
      }

      wireTabs('jtc-del-tabs', 'del', function (v) { delimiter = v; });
      wireTabs('jtc-flatten-tabs', 'flatten', function (v) { flatten = v === 'true'; });
      wireTabs('jtc-header-tabs', 'header', function (v) { includeHeader = v === 'true'; });
      wireTabs('jtc-guard-tabs', 'guard', function (v) { guard = v; });
      wireTabs('jtc-bom-tabs', 'bom', function (v) { addBom = v === 'true'; });

      function setStatus(msg: string, isError: boolean, isWarn?: boolean) {
        statusEl!.textContent = msg;
        statusEl!.className = 'jtc-status ' + (isError ? 'error' : isWarn ? 'warn' : 'success');
      }

      /* ── engine:start ── */
      // Strings that a spreadsheet may run as a formula (OWASP CSV Injection): = + - @, Tab, CR,
      // LF, and the full-width ＝＋－＠ that Japanese spreadsheets also accept. Same set as the
      // CSV mode of String Escape.
      var FORMULA_START = /^[=+\-@\t\r\n\uFF1D\uFF0B\uFF0D\uFF20]/;

      function flattenObject(obj, prefix) {
        var result = {};
        var keys = Object.keys(obj);
        for (var i = 0; i < keys.length; i++) {
          var k = keys[i];
          var val = obj[k];
          var fullKey = prefix ? prefix + '.' + k : k;
          if (val !== null && typeof val === 'object' && !Array.isArray(val) && Object.keys(val).length > 0) {
            var sub = flattenObject(val, fullKey);
            var subKeys = Object.keys(sub);
            for (var j = 0; j < subKeys.length; j++) result[subKeys[j]] = sub[subKeys[j]];
          } else {
            // Arrays and empty objects stay in one column as JSON text ([] / {})
            result[fullKey] = val;
          }
        }
        return result;
      }

      function toRows(parsed, flatten) {
        return parsed.map(function (item) {
          if (item === null || typeof item !== 'object' || Array.isArray(item)) return { value: item };
          return flatten ? flattenObject(item, '') : item;
        });
      }

      // guard: 'off' | 'quote' (' prefix) | 'tab' (Tab prefix). Only JSON strings are guarded:
      // numbers, booleans and JSON text are data, not text typed by a person.
      function csvField(val, del, guard, stats) {
        if (val === null || val === undefined) return '';
        var s = typeof val === 'object' ? JSON.stringify(val) : String(val);
        var force = false;
        if (typeof val === 'string' && FORMULA_START.test(s)) {
          stats.formulaCells++;
          if (guard === 'quote' || guard === 'tab') {
            s = (guard === 'tab' ? '\t' : "'") + s;
            force = true;
          }
        }
        if (force || s.indexOf(del) !== -1 || s.indexOf('"') !== -1 || s.indexOf('\n') !== -1 || s.indexOf('\r') !== -1) {
          return '"' + s.replace(/"/g, '""') + '"';
        }
        return s;
      }

      function buildCsv(rows, del, withHeader, guard) {
        var stats = { formulaCells: 0 };
        var headers = [];
        var seen = Object.create(null);
        for (var i = 0; i < rows.length; i++) {
          var keys = Object.keys(rows[i]);
          for (var j = 0; j < keys.length; j++) {
            if (!seen[keys[j]]) { seen[keys[j]] = true; headers.push(keys[j]); }
          }
        }
        var lines = [];
        if (withHeader) lines.push(headers.map(function (h) { return csvField(h, del, guard, stats); }).join(del));
        for (var r = 0; r < rows.length; r++) {
          var row = rows[r];
          lines.push(headers.map(function (h) {
            return csvField(Object.prototype.hasOwnProperty.call(row, h) ? row[h] : undefined, del, guard, stats);
          }).join(del));
        }
        return { csv: lines.join('\n'), formulaCells: stats.formulaCells };
      }

      // Excel on Windows reads a double-clicked CSV as UTF-8 only when it starts with a BOM
      function withBom(text, on) {
        if (!on || text.charCodeAt(0) === 0xFEFF) return text;
        return '\uFEFF' + text;
      }
      /* ── engine:end ── */

      /* ── json-reason:start ── */
      // Why the input is not JSON, in the page language, without the browser's English message.
      // lineCol and jsonSyntaxError are copied verbatim from json-formatter-engine.js (the test
      // compares the source); jsonSyntaxError runs only after JSON.parse has failed. The tool parses
      // the trimmed text, so the leading whitespace is added back to count lines from the text box.
      function lineCol(text, offset) {
        var line = 1, last = -1;
        for (var i = text.indexOf('\n'); i !== -1 && i < offset; i = text.indexOf('\n', i + 1)) { line++; last = i; }
        return { line: line, col: offset - last };
      }
      function jsonSyntaxError(text) {
        var i = 0, n = text.length;
        var SMART = '\u201c\u201d\u2018\u2019\u300c\u300d';
        var WIDE = '\u3000\uff1a\uff0c\uff5b\uff5d\uff3b\uff3d\uff02';
        function fail(code, at, ch) { throw { jsonErr: true, code: code, offset: at === undefined ? i : at, ch: ch }; }
        function special(c) {
          if (SMART.indexOf(c) >= 0) fail('smartQuote', i, c);
          if (WIDE.indexOf(c) >= 0) fail('fullWidth', i, c);
        }
        function ws() {
          while (i < n) {
            var c = text[i];
            if (c === ' ' || c === '\t' || c === '\n' || c === '\r') { i++; continue; }
            if (c === '/' && (text[i + 1] === '/' || text[i + 1] === '*')) fail('comment');
            if (c === '#') fail('comment');
            break;
          }
        }
        var NUM = /-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?/y;
        var WORD = /[A-Za-z_$][\w$]*/y;
        function str() {
          var s = i; i++;
          while (i < n) {
            var c = text.charCodeAt(i);
            if (c === 34) { i++; return; }
            if (c === 92) {
              var e = text[i + 1];
              if (e !== undefined && '"\\/bfnrt'.indexOf(e) >= 0) { i += 2; continue; }
              if (e === 'u' && /^[0-9a-fA-F]{4}$/.test(text.substr(i + 2, 4))) { i += 6; continue; }
              fail('badEscape');
            }
            if (c < 0x20) fail('controlChar');
            i++;
          }
          fail('unterminatedString', s);
        }
        function num() {
          NUM.lastIndex = i;
          var m = NUM.exec(text);
          if (!m || m[0] === '-' || m[0] === '') fail('badNumber');
          i += m[0].length;
          if (i < n && /[0-9.eE]/.test(text[i])) fail('badNumber');
        }
        function startsValue(c) { return c === '{' || c === '[' || c === '"' || c === '-' || (c >= '0' && c <= '9') || c === 't' || c === 'f' || c === 'n'; }
        function value(depth) {
          if (depth > 3000) fail('unexpectedChar');
          ws();
          if (i >= n) fail('unexpectedEnd');
          var c = text[i];
          if (c === '{') return obj(depth);
          if (c === '[') return arr(depth);
          if (c === '"') return str();
          if (c === "'") fail('singleQuote');
          special(c);
          if (c === '-' || (c >= '0' && c <= '9')) return num();
          if (c === '+' || c === '.') fail('badNumber');
          WORD.lastIndex = i;
          var m = WORD.exec(text);
          if (m) {
            if (m[0] === 'true' || m[0] === 'false' || m[0] === 'null') { i += m[0].length; return; }
            if (m[0] === 'NaN' || m[0] === 'Infinity') fail('badNumber');
            fail('badLiteral');
          }
          fail('unexpectedChar', i, c);
        }
        function obj(depth) {
          i++; ws();
          if (text[i] === '}') { i++; return; }
          for (;;) {
            ws();
            if (i >= n) fail('unexpectedEnd');
            var c = text[i];
            if (c === "'") fail('singleQuote');
            special(c);
            if (c !== '"') { if (/[A-Za-z_$0-9]/.test(c)) fail('unquotedKey'); fail('unexpectedChar', i, c); }
            str(); ws();
            if (i >= n) fail('unexpectedEnd');
            if (text[i] !== ':') { special(text[i]); fail('missingColon'); }
            i++;
            value(depth + 1); ws();
            if (i >= n) fail('unexpectedEnd');
            c = text[i];
            if (c === ',') { var comma = i; i++; ws(); if (text[i] === '}') fail('trailingComma', comma); continue; }
            if (c === '}') { i++; return; }
            special(c);
            if (c === '"' || /[A-Za-z_$]/.test(c)) fail('missingComma');
            fail('unexpectedChar', i, c);
          }
        }
        function arr(depth) {
          i++; ws();
          if (text[i] === ']') { i++; return; }
          for (;;) {
            value(depth + 1); ws();
            if (i >= n) fail('unexpectedEnd');
            var c = text[i];
            if (c === ',') { var comma = i; i++; ws(); if (text[i] === ']') fail('trailingComma', comma); continue; }
            if (c === ']') { i++; return; }
            special(c);
            if (startsValue(c)) fail('missingComma');
            fail('unexpectedChar', i, c);
          }
        }
        try {
          ws();
          if (i >= n) return { code: 'empty', offset: 0 };
          value(0);
          ws();
          if (i < n) fail('extraData');
          return null;
        } catch (e) {
          if (e && e.jsonErr) return { code: e.code, offset: e.offset, ch: e.ch };
          throw e;
        }
      }
      function jsonErrorText(value) {
        var e = jsonSyntaxError(value.trim());
        if (!e) return ERR_JSON;
        var at = lineCol(value, value.length - value.trimStart().length + e.offset);
        var reason = String(JSON_PARSE[e.code] || JSON_PARSE.unexpectedChar || e.code).replace('{ch}', function () { return e.ch == null ? '' : e.ch; });
        return ERR_JSON_AT.replace(/\{(line|col|reason)\}/g, function (m, k) { return k === 'line' ? String(at.line) : k === 'col' ? String(at.col) : reason; });
      }
      /* ── json-reason:end ── */

      // A stack overflow while walking very deep JSON: RangeError "Maximum call stack size exceeded" in Chrome
      // and Safari, InternalError "too much recursion" in Firefox (MDN: "Too much recursion").
      function isTooDeep(e: unknown) {
        var err = e as { name?: string; message?: string } | null;
        return !!err && (err.name === 'RangeError' || err.name === 'InternalError') && /call stack|recursion/i.test(String(err.message));
      }

      function convert() {
        clearTimeout(_liveTimer!);
        resetCopy();
        inputEl.classList.remove('error');
        var raw = inputEl.value.trim();
        if (!raw) {
          outputEl.value = '';
          outputEl.dataset.empty = 'true';
          statusEl!.textContent = '';
          statusEl!.className = 'jtc-status';
          return;
        }

        var parsed: unknown;
        try {
          parsed = JSON.parse(raw);
        } catch (e: unknown) {
          inputEl.classList.add('error');
          outputEl.value = '';
          outputEl.dataset.empty = 'true';
          setStatus(jsonErrorText(inputEl.value), true);
          return;
        }

        inputEl.classList.remove('error');

        if (!Array.isArray(parsed)) {
          outputEl.value = '';
          outputEl.dataset.empty = 'true';
          setStatus(MSG_NOT_ARRAY, true);
          return;
        }

        if (parsed.length === 0) {
          outputEl.value = '';
          outputEl.dataset.empty = 'true';
          setStatus(MSG_EMPTY, true);
          return;
        }

        var rows, result;
        try {
          rows = toRows(parsed, flatten);
          result = buildCsv(rows, delimiter, includeHeader, guard);
        } catch (e: unknown) {
          if (!isTooDeep(e)) throw e;
          outputEl.value = '';
          outputEl.dataset.empty = 'true';
          setStatus(MSG_TOO_DEEP, true);
          return;
        }
        outputEl.value = result.csv;
        outputEl.dataset.empty = String(!result.csv);
        var msg = rows.length === 1 ? MSG_ONE_ROW : MSG_ROWS.replace('{n}', String(rows.length));
        if (result.formulaCells > 0) {
          var note = (guard === 'off' ? MSG_FORMULA_RISK : MSG_FORMULA_GUARDED).replace('{n}', String(result.formulaCells));
          setStatus(msg + ' · ' + note, false, guard === 'off');
        } else {
          setStatus(msg, false);
        }
      }

      /* Analytics: one event per committed change (input change event, option click, Example), not on load or per typing pause.
         Clicking the active option or Example again changes nothing, so the same input and options are sent once. */
      var lastTracked: string | null = null;
      function trackChange() {
        if (!outputEl.value) return;
        var key = [inputEl.value, delimiter, flatten, includeHeader, guard, addBom].join('\u0000');
        if (key === lastTracked) return;
        lastTracked = key;
        window.trackTool && window.trackTool('json-to-csv', 'convert');
      }

      var _liveTimer: ReturnType<typeof setTimeout> | null = null;
      inputEl.addEventListener('input', function () {
        resetCopy();
        clearTimeout(_liveTimer!);
        _liveTimer = setTimeout(convert, 300);
      });
      inputEl.addEventListener('change', function () {
        convert();
        trackChange();
      });

      document.getElementById('jtc-example')!.addEventListener('click', function () {
        inputEl.value = EXAMPLE;
        inputEl.classList.remove('error');
        convert();
        trackChange();
      });

      function clearAll() {
        clearTimeout(_liveTimer!);
        lastTracked = null;
        resetCopy();
        inputEl.value = '';
        outputEl.value = '';
        outputEl.dataset.empty = 'true';
        inputEl.classList.remove('error');
        statusEl!.textContent = '';
        statusEl!.className = 'jtc-status';
        inputEl.focus();
      }
      document.getElementById('jtc-clear')!.addEventListener('click', clearAll);
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
          e.preventDefault();
          clearAll();
        }
      });

      copyBtn.addEventListener('click', function () {
        var text = outputEl.value;
        if (!text) return;
        resetCopy();
        var revision = copyRevision;
        function failed() {
          if (revision === copyRevision) copyBtn.textContent = COPY_FAILED;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            copyBtn.textContent = COPIED;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = COPY;
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });

      document.getElementById('jtc-download')!.addEventListener('click', function () {
        var text = outputEl.value;
        if (!text) return;
        var blob = new Blob([withBom(text, addBom)], { type: 'text/csv;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'export.csv';
        a.click();
        URL.revokeObjectURL(url);
      });

      inputEl.value = EXAMPLE;
      convert();
    })();
  </script>
</div>

<style>
  .jtc-wrap { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; gap: 0.75rem; }
  .jtc-config, .jtc-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .jtc-config-row, .jtc-control-label { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .jtc-config-row { font-size: 0.85rem; color: var(--color-text-secondary); }
  .jtc-tabs { flex: none; }
  .jtc-tab { padding: 0.35rem 0.6rem; font-size: 0.78rem; border: 0; border-radius: 999px; background: transparent; color: var(--color-text-secondary); cursor: pointer; }
  .jtc-tab.active { background: var(--color-text); color: var(--color-bg); }
  .jtc-tab:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jtc-panel-header { flex-wrap: wrap; display: flex; align-items: center; justify-content: space-between; min-height: 44px; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .jtc-panel textarea, .jtc-output { width: 100%; min-width: 0; font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.5; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-secondary); color: var(--color-text); }
  .jtc-panel textarea { resize: none; overflow: auto; }
  .jtc-panel textarea:focus { outline: none; border-color: var(--color-primary); }
  .jtc-panel textarea.error { border-color: #c0392b; }
  .jtc-output { margin: 0; overflow: auto; white-space: pre; }
  .jtc-output:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jtc-empty { display: none; margin: 0; padding: 2rem; align-items: center; justify-content: center; text-align: center; color: var(--color-text-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .jtc-output-pane:has(#jtc-output[data-empty="true"]) .jtc-output { display: none; }
  .jtc-output-pane:has(#jtc-output[data-empty="true"]) .jtc-empty { display: flex; }
  .jtc-status { font-size: 0.85rem; line-height: 1.4; height: 2.4rem; flex: none; overflow: auto; overflow-wrap: anywhere; }
  .jtc-status.success { color: #057a55; }
  .jtc-status.error { color: #c0392b; }
  .jtc-status.warn { color: #b45309; }
  .jtc-options { flex: none; }
  .jtc-options summary { cursor: pointer; font-size: 0.85rem; color: var(--color-text-secondary); min-height: 36px; display: list-item; }
  .jtc-secondary { padding: 0.5rem 0; }
  .jtc-panel-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 860px) {
    .jtc-wrap { gap: 0.5rem; }
    .jtc-status { height: 6rem; }
    .jtc-config-row { flex-wrap: wrap; }
    #jtc-input { height: 144px; min-height: 144px; flex: none; }
    .jtc-output { height: 22rem; flex: none; min-height: 160px; }
