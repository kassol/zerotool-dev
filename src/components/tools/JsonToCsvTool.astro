      download: "按当前 UTF-8 BOM 设置，将完整 CSV 保存为 export.csv。输出为空时不下载。",
    },
    jsonInput: 'JSON 输入',
    csvOutput: 'CSV 输出',
    example: '示例',
    clear: '清空',
