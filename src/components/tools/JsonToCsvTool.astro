---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: {
    empty: "Enter a JSON array or load the example to generate CSV.",
    options: "More CSV options",
    tips: {
      input: "Enter a JSON array. Conversion runs 300 ms after typing stops; option changes apply immediately. Invalid JSON clears the output.",
      delimiter: "Separate columns with a comma, semicolon or tab. Fields containing the chosen delimiter, quotes or line breaks are quoted automatically.",
      flatten: "On expands non-empty nested objects to dot-path columns. Off keeps each nested object as JSON text. Arrays and empty objects stay in one column.",
      header: "Include the union of keys from every row as the first line. Missing values become empty fields.",
      formula: "Off leaves risky strings unchanged. Quote or Tab prefix protects matching strings and headers, then quotes the CSV field. Numeric values are unchanged.",
      bom: "Add a UTF-8 BOM to downloaded files for Excel. The displayed and copied CSV never includes this added BOM.",
      example: "Replace the input with two user records containing nested addresses, then convert with the current options.",
      clear: "Clear JSON, CSV and status while keeping all five options. Ctrl/⌘+L in this tool also clears the result.",
      copy: "Copy the complete displayed CSV without an added BOM. Empty output is not copied.",
      download: "Save the complete CSV as export.csv using the current UTF-8 BOM setting. Empty output is not downloaded.",
