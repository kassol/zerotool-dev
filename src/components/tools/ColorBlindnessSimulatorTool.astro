const T = STRINGS[lang] ?? STRINGS.en;
const { tips: TIPS, ...CLIENT_T } = T;
const TYPES = ['protanopia', 'deuteranopia', 'tritanopia', 'protanomaly', 'deuteranomaly', 'tritanomaly', 'achromatopsia', 'achromatomaly'] as const;
const DEFAULT_COLORS = {
  en: 'Success: #2E7D32\nWarning: #ED6C02\nError: #D32F2F\nInfo: #0288D1',
  zh: '成功: #2E7D32\n警告: #ED6C02\n错误: #D32F2F\n提示: #0288D1',
  ja: '成功: #2E7D32\n警告: #ED6C02\nエラー: #D32F2F\n情報: #0288D1',
  ko: '성공: #2E7D32\n경고: #ED6C02\n오류: #D32F2F\n정보: #0288D1',
}[lang] ?? '';
---

<div class="cbs-wrap" id="cbs-wrap">
  <div class="cbs-control">
  <div class="cbs-tabs zt-segmented" role="group" aria-label={T.modeAria}>
    <button class="cbs-tab" id="cbs-tab-image" type="button" data-mode="image" aria-pressed="true">{T.tabImage}</button>
    <button class="cbs-tab" id="cbs-tab-colors" type="button" data-mode="colors" aria-pressed="false">{T.tabColors}</button>
  </div>
  <Toggletip id="cbs-tip-mode" lang={lang} about={T.modeAria}>{TIPS.mode}</Toggletip>
  </div>

  <div class="cbs-panel" id="cbs-image-panel">
    <div class="cbs-drop" id="cbs-drop" data-active={T.dropActive}>
      <div class="cbs-actions">
        <div class="cbs-control"><button class="btn-primary" id="cbs-open" type="button">{T.open}</button><Toggletip id="cbs-tip-open" lang={lang} about={T.open}>{TIPS.open}</Toggletip></div>
        <div class="cbs-control cbs-capture-action"><button class="btn-secondary" id="cbs-capture" type="button" hidden>{T.capture}</button><Toggletip id="cbs-tip-capture" lang={lang} about={T.capture}>{TIPS.capture}</Toggletip></div>
        <div class="cbs-control"><button class="btn-ghost" id="cbs-sample" type="button">{T.sample}</button><Toggletip id="cbs-tip-sample" lang={lang} about={T.sample}>{TIPS.sample}</Toggletip></div>
      </div>
      <p class="cbs-hint">{T.dropHintShort}</p>
      <input id="cbs-file" type="file" accept="image/*,.svg,.avif,.webp" class="cbs-file" tabindex="-1" aria-hidden="true" />
    </div>
  </div>

  <div class="cbs-panel" id="cbs-colors-panel" hidden>
    <div class="cbs-control"><label class="tool-label" for="cbs-colors">{T.colorsLabel}</label><Toggletip id="cbs-tip-colors" lang={lang} about={T.tabColors}>{TIPS.colors}</Toggletip></div>
    <textarea id="cbs-colors" class="tool-textarea cbs-colors" rows="5" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder={T.colorsPlaceholder}>{DEFAULT_COLORS}</textarea>
  </div>

  <div class="cbs-controls">
    <div class="cbs-control">
    <label class="cbs-severity">
      <span class="cbs-ctl-label">{T.severityShort}</span>
      <input id="cbs-severity" type="range" min="1" max="9" step="1" value="6" aria-label={T.severity} />
      <output id="cbs-severity-out" for="cbs-severity">0.6</output>
    </label>
    <Toggletip id="cbs-tip-severity" lang={lang} about={T.severityShort}>{TIPS.severity}</Toggletip>
    </div>
    <div class="cbs-viewctl" id="cbs-viewctl">
      <div class="cbs-control"><div class="cbs-seg zt-segmented" role="group" aria-label={T.view}>
        <button type="button" class="cbs-seg-btn" data-view="all" aria-pressed="true">{T.viewAll}</button>
        <button type="button" class="cbs-seg-btn" data-view="compare" aria-pressed="false">{T.viewCompare}</button>
      </div><Toggletip id="cbs-tip-view" lang={lang} about={T.view}>{TIPS.view}</Toggletip></div>
      <div class="cbs-compare-type" id="cbs-compare-type-wrap" hidden>
      <label class="cbs-control">
        <span class="cbs-ctl-label">{T.compareWith}</span>
        <select id="cbs-compare-type" class="cbs-select">
          {TYPES.map((t) => <option value={t}>{T[t]}</option>)}
        </select>
      </label><Toggletip id="cbs-tip-compare" lang={lang} about={T.compareWith}>{TIPS.compare}</Toggletip>
      </div>
      <span class="cbs-control cbs-export-help"><span>{T.download}</span><Toggletip id="cbs-tip-download" lang={lang} about={T.download}>{TIPS.download}</Toggletip></span>
    </div>
  </div>

  <p id="cbs-status" class="cbs-status" role="status" aria-live="polite"></p>

  <div class="cbs-grid" id="cbs-grid">
    <figure class="cbs-card cbs-card-original" data-type="original">
      <figcaption class="cbs-card-head"><span class="cbs-card-label">{T.original}</span></figcaption>
      <canvas class="cbs-card-canvas" id="cbs-canvas-original" width="1" height="1"></canvas>
    </figure>
    {TYPES.map((t) => (
      <figure class="cbs-card" data-type={t}>
        <figcaption class="cbs-card-head">
          <span class="cbs-card-label">{T[t]}</span>
          <span class="cbs-card-sub">{T[`${t}Sub`]}</span>
        </figcaption>
        <canvas class="cbs-card-canvas" id={`cbs-canvas-${t}`} width="1" height="1"></canvas>
        <button class="btn-copy cbs-dl" type="button" data-type={t}>{T.download}</button>
      </figure>
    ))}
  </div>

  <div class="cbs-compare" id="cbs-compare" hidden>
    <figure class="cbs-compare-fig">
      <figcaption class="cbs-card-head"><span class="cbs-card-label">{T.original}</span></figcaption>
      <canvas class="cbs-compare-canvas" id="cbs-compare-original" width="1" height="1"></canvas>
    </figure>
    <figure class="cbs-compare-fig">
      <figcaption class="cbs-card-head"><span class="cbs-card-label" id="cbs-compare-label"></span><button class="btn-copy cbs-dl" type="button" id="cbs-compare-dl">{T.download}</button></figcaption>
      <canvas class="cbs-compare-canvas" id="cbs-compare-sim" width="1" height="1"></canvas>
    </figure>
  </div>

  <div class="cbs-table-wrap" id="cbs-table-wrap" hidden>
    <table class="cbs-table" id="cbs-table"></table>
  </div>
  <div class="cbs-image-note"><p class="cbs-imginfo" id="cbs-imginfo" hidden></p></div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
