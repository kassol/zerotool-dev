---
// CronParserTool — cron expression parser and scheduler widget
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
// strings:start
const STRINGS = {
  en: { cronExpr: 'Cron Expression', parse: 'Parse', fMinute: 'minute', fHour: 'hour', fDay: 'day', fMonth: 'month', fWeekday: 'weekday', presets: 'Presets:', pEveryMinute: 'Every minute', pEveryHour: 'Every hour', pDailyMidnight: 'Daily midnight', pWeekdays9am: 'Weekdays 9am', pWeeklySunday: 'Weekly Sunday', pMonthly1st: 'Monthly 1st', pEvery5min: 'Every 5 min', pYearlyJan1: 'Yearly Jan 1st', errEmpty: 'Please enter a cron expression.', errFields: 'Invalid: expected 5 fields, got {n}.', errInvalid: 'Invalid expression — check each field range.', errStep: 'Not valid: "{token}" in the {field} field. A step must follow * or a range, for example */10 or 5-59/10.', errUnsupported: 'Not supported: "{token}" in the {field} field. This tool checks standard 5-field cron only; #, L, W and ? are extensions from Quartz and similar schedulers.', valid: 'Valid expression.', nextRuns: 'Next 10 scheduled runs (local time):', noRuns: 'No run time found: no real date matches these fields (for example, February 30).',
    results: "Schedule details",
    explanation: "Explanation",
    fields: "Field values",
    runs: "Run times",
    emptyResult: "Parse a cron expression to see its explanation, field values and next run times.",
    tips: {
      input: "Enter five fields in order: minute, hour, day of month, month and weekday. Seconds and @ shortcuts are not supported. The page opens with 0 9 * * 1-5 already parsed.",
      parse: "Click Parse or press Enter in the input to apply the expression. Ctrl+Enter (⌘+Enter on Mac) also parses it. Editing alone does not update the result. Ctrl+L (⌘+L) inside this tool clears the input, result and status.",
