      explanation: "The explanation is generated in English on every language version. Month and weekday names in the field values also remain in English.",
      fields: "The breakdown shows each field expression and its first 12 matching values. An ellipsis marks additional values. Month and weekday numbers use English names; weekday 7 remains 7 in this display.",
      runs: "The list shows the next 10 runs in your browser’s local time zone, starting after the current minute. Compare that zone with the scheduler’s zone. There is no time zone selector or show-more option.",
    },
  },
  zh: { cronExpr: 'Cron 表达式', parse: '解析', fMinute: '分钟', fHour: '小时', fDay: '日', fMonth: '月', fWeekday: '星期', presets: '预设：', pEveryMinute: '每分钟', pEveryHour: '每小时', pDailyMidnight: '每天午夜', pWeekdays9am: '工作日 9 点', pWeeklySunday: '每周日', pMonthly1st: '每月 1 日', pEvery5min: '每 5 分钟', pYearlyJan1: '每年 1 月 1 日', errEmpty: '请输入 cron 表达式。', errFields: '无效：需要 5 个字段，当前 {n} 个。', errInvalid: '表达式无效 — 请检查各字段范围。', errStep: '无效：{field}字段中的「{token}」。步长只能跟在 * 或范围后面，例如 */10 或 5-59/10。', errUnsupported: '不支持：{field}字段中的「{token}」。本工具只解析标准 5 字段 cron；#、L、W、? 是 Quartz 等调度器的扩展语法。', valid: '表达式有效。', nextRuns: '接下来 10 次执行时间（本地时间）：', noRuns: '找不到执行时间：没有真实日期符合这些字段（例如 2 月 30 日）。',
    results: "计划详情",
    explanation: "英文说明",
    fields: "字段值",
    runs: "执行时间",
    emptyResult: "解析 Cron 表达式后，这里显示英文说明、字段值和下次执行时间。",
    tips: {
      input: "按顺序输入五个字段：分钟、小时、日、月、星期。不支持秒字段和 @ 快捷写法。页面打开时已解析 0 9 * * 1-5。",
      parse: "点击「解析」或在输入框按 Enter 应用表达式，Ctrl+Enter（Mac 为 ⌘+Enter）也可解析。只编辑输入不会更新结果。焦点在工具内时，Ctrl+L（⌘+L）清空输入、结果和状态。",
      presets: "展开「预设」并选择八种计划之一。每个预设都会替换表达式并立即解析。",
      explanation: "所有语言版本都生成英文说明句；字段值中的月份和星期名称也保留英文。",
      fields: "逐字段显示表达式及前 12 个匹配值，更多值以省略号表示。月份和星期数字使用英文名称；星期 7 在此处仍显示为 7。",
      runs: "列表从当前分钟之后开始，按浏览器本地时区显示接下来 10 次执行时间。请与实际调度器的时区核对。没有时区选择器或查看更多选项。",
    },
  },
  ja: { cronExpr: 'cron 式', parse: '解析', fMinute: '分', fHour: '時', fDay: '日', fMonth: '月', fWeekday: '曜日', presets: 'プリセット：', pEveryMinute: '毎分', pEveryHour: '毎時', pDailyMidnight: '毎日 0 時', pWeekdays9am: '平日 9 時', pWeeklySunday: '毎週日曜', pMonthly1st: '毎月 1 日', pEvery5min: '5 分ごと', pYearlyJan1: '毎年 1 月 1 日', errEmpty: 'cron 式を入力してください。', errFields: '無効：5 フィールドが必要です（現在 {n} 個）。', errInvalid: '無効な式 — 各フィールドの範囲を確認してください。', errStep: '無効：{field}フィールドの「{token}」。ステップは * か範囲の後にだけ書けます（例：*/10、5-59/10）。', errUnsupported: '未対応：{field}フィールドの「{token}」。このツールは標準の 5 フィールド cron のみ解析します。#・L・W・? は Quartz などのスケジューラの拡張構文です。', valid: '有効な式です。', nextRuns: '次の 10 回の実行時刻（ローカル時間）：', noRuns: '実行時刻が見つかりません：この条件に合う実在の日付がありません（例：2 月 30 日）。',
    results: "スケジュールの詳細",
    explanation: "英語の説明",
    fields: "フィールド値",
    runs: "実行時刻",
    emptyResult: "cron 式を解析すると、説明、フィールド値、次の実行時刻を表示します。",
    tips: {
      input: "分、時、日、月、曜日の順に 5 フィールドを入力します。秒フィールドや @ 短縮表記には対応しません。ページを開くと 0 9 * * 1-5 が解析済みです。",
      parse: "「解析」を押すか、入力欄で Enter を押して式を適用します。Ctrl+Enter（Mac は ⌘+Enter）でも解析できます。編集だけでは結果は更新されません。ツール内で Ctrl+L（⌘+L）を押すと入力、結果、状態を消去します。",
      presets: "「プリセット」を開いて 8 種類の予定から選びます。選ぶと式を置き換え、すぐに解析します。",
      explanation: "説明文はどの言語版でも英語です。フィールド値の月名と曜日名も英語で表示します。",
      fields: "各フィールドの式と、一致する値の先頭 12 件を表示します。残りは省略記号で示します。月と曜日の数値は英語名で表示しますが、曜日の 7 はこの欄では 7 のままです。",
      runs: "現在の分より後の実行時刻を、ブラウザーのローカルタイムゾーンで 10 回分表示します。実際のスケジューラのタイムゾーンと照合してください。タイムゾーン選択や追加表示はありません。",
    },
  },
  ko: { cronExpr: 'Cron 표현식', parse: '파싱', fMinute: '분', fHour: '시', fDay: '일', fMonth: '월', fWeekday: '요일', presets: '프리셋:', pEveryMinute: '매분', pEveryHour: '매시', pDailyMidnight: '매일 자정', pWeekdays9am: '평일 오전 9시', pWeeklySunday: '매주 일요일', pMonthly1st: '매월 1일', pEvery5min: '5분마다', pYearlyJan1: '매년 1월 1일', errEmpty: 'cron 표현식을 입력하세요.', errFields: '유효하지 않음: 5개 필드가 필요합니다 (현재 {n}개).', errInvalid: '잘못된 표현식 — 각 필드 범위를 확인하세요.', errStep: '유효하지 않음: {field} 필드의 "{token}". 스텝은 * 또는 범위 뒤에만 쓸 수 있습니다(예: */10, 5-59/10).', errUnsupported: '지원하지 않음: {field} 필드의 "{token}". 이 도구는 표준 5필드 cron만 해석합니다. #, L, W, ?는 Quartz 등 스케줄러의 확장 문법입니다.', valid: '유효한 표현식입니다.', nextRuns: '다음 10번 실행 시간 (현지 시간):', noRuns: '실행 시간을 찾을 수 없습니다: 이 조건에 맞는 실제 날짜가 없습니다(예: 2월 30일).',
    results: "일정 상세",
    explanation: "영어 설명",
    fields: "필드 값",
    runs: "실행 시각",
    emptyResult: "Cron 표현식을 파싱하면 설명, 필드 값과 다음 실행 시각을 표시합니다.",
    tips: {
      input: "분, 시, 일, 월, 요일 순서로 5개 필드를 입력하세요. 초 필드와 @ 단축 표기는 지원하지 않습니다. 페이지를 열면 0 9 * * 1-5가 이미 파싱되어 있습니다.",
      parse: "「파싱」을 클릭하거나 입력창에서 Enter를 눌러 표현식을 적용하세요. Ctrl+Enter(Mac은 ⌘+Enter)로도 파싱합니다. 입력만 바꾸면 결과는 그대로입니다. 도구 안에서 Ctrl+L(⌘+L)을 누르면 입력, 결과와 상태를 지웁니다.",
      presets: "「프리셋」을 열고 8가지 일정 중 하나를 선택하세요. 선택하면 표현식을 바꾸고 즉시 파싱합니다.",
      explanation: "모든 언어 버전에서 설명문은 영어로 생성됩니다. 필드 값의 월 이름과 요일 이름도 영어로 표시합니다.",
      fields: "각 필드의 표현식과 일치하는 처음 12개 값을 표시합니다. 나머지는 줄임표로 나타냅니다. 월과 요일 숫자는 영어 이름을 사용하지만 요일 7은 이 영역에서 7로 유지됩니다.",
      runs: "현재 분 이후의 실행 시각 10개를 브라우저의 현지 시간대로 표시합니다. 실제 스케줄러의 시간대와 비교하세요. 시간대 선택이나 더 보기 옵션은 없습니다.",
    },
  },
};
// strings:end
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---
<div class="cron-wrap">
  <div class="cron-input-row">
    <div class="cron-heading"><label for="cron-input">{T.cronExpr}</label><Toggletip id="cron-tip-input" lang={lang} about={T.cronExpr}>{TIPS.input}</Toggletip></div>
    <div class="cron-input-group">
      <input type="text" id="cron-input" class="tool-input" placeholder="* * * * *" spellcheck="false" autocomplete="off" value="0 9 * * 1-5" />
      <button id="cron-parse" type="button" class="btn-primary">{T.parse}</button>
      <Toggletip id="cron-tip-parse" lang={lang} about={T.parse}>{TIPS.parse}</Toggletip>
    </div>
    <div class="cron-field-labels"><span>{T.fMinute}</span><span>{T.fHour}</span><span>{T.fDay}</span><span>{T.fMonth}</span><span>{T.fWeekday}</span></div>
  </div>
  <div class="cron-preset-row">
    <details class="cron-preset-details" id="cron-preset-details">
      <summary>{T.presets}</summary>
      <div class="cron-presets">
        <button type="button" class="btn-preset" data-expr="* * * * *">{T.pEveryMinute}</button>
        <button type="button" class="btn-preset" data-expr="0 * * * *">{T.pEveryHour}</button>
        <button type="button" class="btn-preset" data-expr="0 0 * * *">{T.pDailyMidnight}</button>
        <button type="button" class="btn-preset" data-expr="0 9 * * 1-5">{T.pWeekdays9am}</button>
        <button type="button" class="btn-preset" data-expr="0 0 * * 0">{T.pWeeklySunday}</button>
        <button type="button" class="btn-preset" data-expr="0 0 1 * *">{T.pMonthly1st}</button>
        <button type="button" class="btn-preset" data-expr="*/5 * * * *">{T.pEvery5min}</button>
        <button type="button" class="btn-preset" data-expr="0 0 1 1 *">{T.pYearlyJan1}</button>
      </div>
    </details>
    <Toggletip id="cron-tip-presets" lang={lang} about={T.presets}>{TIPS.presets}</Toggletip>
  </div>
  <div id="cron-status" class="cron-status" role="status" aria-live="polite" tabindex="0"></div>
  <div class="cron-result-section">
    <p class="cron-empty" id="cron-empty">{T.emptyResult}</p>
    <div class="cron-result-head">
      <div class="cron-heading"><span>{T.explanation}</span><Toggletip id="cron-tip-explanation" lang={lang} about={T.explanation}>{TIPS.explanation}</Toggletip></div>
      <div class="cron-heading"><span>{T.fields}</span><Toggletip id="cron-tip-fields" lang={lang} about={T.fields}>{TIPS.fields}</Toggletip></div>
      <div class="cron-heading"><span>{T.runs}</span><Toggletip id="cron-tip-runs" lang={lang} about={T.runs}>{TIPS.runs}</Toggletip></div>
    </div>
    <div id="cron-results" class="cron-results" tabindex="0" role="region" aria-label={T.results}></div>
  </div>

  <script is:inline define:vars={{ S: CLIENT_T }}>
    (function () {
      var t = S;

      /* ── engine:start ── */
      var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
      var WDAYS = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
      var WDAY_ABBR = ['sun','mon','tue','wed','thu','fri','sat'];
      var MONTH_ABBR = ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'];

      function replaceNames(s, names, offset) {
        return s.toLowerCase().replace(new RegExp(names.join('|'), 'g'), function(m) {
          return names.indexOf(m) + offset;
        });
      }

      function parseField(field, min, max, names, nameOffset) {
        if (names) field = replaceNames(field, names, nameOffset);
        var result = [];
        var parts = field.split(',');
        for (var p = 0; p < parts.length; p++) {
          var m = /^(\*|\d+|\d+-\d+)(?:\/(\d+))?$/.exec(parts[p].trim());
          if (!m) return null;
          var part = m[1];
          var step = m[2] === undefined ? 1 : parseInt(m[2], 10);
          if (step < 1) return null;
          var lo, hi;
          if (part === '*') {
            lo = min; hi = max;
          } else if (part.indexOf('-') !== -1) {
            var rp = part.split('-');
            lo = parseInt(rp[0], 10); hi = parseInt(rp[1], 10);
          } else {
            lo = hi = parseInt(part, 10);
          }
          if (lo < min || hi > max || lo > hi) return null;
          for (var i = lo; i <= hi; i += step) result.push(i);
        }
        var seen = {};
        return result.filter(function(v) { return seen[v] ? false : (seen[v] = true); }).sort(function(a,b){return a-b;});
      }

      var FIELD_SPECS = [
        { min: 0, max: 59, names: null, offset: 0 },
        { min: 0, max: 23, names: null, offset: 0 },
        { min: 1, max: 31, names: null, offset: 0 },
        { min: 1, max: 12, names: MONTH_ABBR, offset: 1 },
        { min: 0, max: 7, names: WDAY_ABBR, offset: 0 }
      ];

      /* Quartz / cron4j extensions that standard 5-field cron rejects: 1#2, L, 5L, L-3, 15W, LW, ? */
      function unsupportedItem(field) {
        var items = field.split(',');
        for (var i = 0; i < items.length; i++) {
          var item = items[i].trim();
          if (/[#?]/.test(item) || /^(\d*L|L-\d+|\d+W|LW)$/i.test(item)) return item;
        }
        return null;
      }

      /* cronie accepts a step only after "*" or a range (src/entry.c get_range); "5/10" is an error there */
      function stepWithoutRange(field) {
        var items = field.split(',');
        for (var i = 0; i < items.length; i++) {
          var item = items[i].trim();
          var slash = item.indexOf('/');
          if (slash === -1) continue;
          var base = item.slice(0, slash);
          if (base !== '*' && base.indexOf('-') === -1) return item;
        }
        return null;
      }

      function parseCron(raw) {
        var trimmed = String(raw).trim();
        if (!trimmed) return { error: { code: 'empty' } };
        var fields = trimmed.split(/\s+/);
        if (fields.length !== 5) return { error: { code: 'fields', n: fields.length } };
        var values = [];
        for (var f = 0; f < 5; f++) {
          var token = unsupportedItem(fields[f]);
          if (token) return { error: { code: 'unsupported', token: token, field: f } };
          token = stepWithoutRange(fields[f]);
          if (token) return { error: { code: 'step', token: token, field: f } };
          var spec = FIELD_SPECS[f];
          var vals = parseField(fields[f], spec.min, spec.max, spec.names, spec.offset);
          if (!vals) return { error: { code: 'invalid', field: f } };
          values.push(vals);
        }
        return { fields: fields, values: values };
      }

      function humanizeField(expr, min, max, names, nameOffset, singular, plural) {
        if (expr === '*') return 'every ' + singular;
        var vals = parseField(expr, min, max, names, nameOffset);
        if (!vals) return expr;

        if (expr.indexOf('*/') === 0) {
          var step = parseInt(expr.slice(2));
          return 'every ' + step + ' ' + (step === 1 ? singular : plural);
        }

        if (/^\d+-\d+$/.test(expr)) {
          var parts = expr.split('-');
          var lo = parseInt(parts[0]), hi = parseInt(parts[1]);
          var loName = names ? (names[lo - nameOffset] || lo) : lo;
          var hiName = names ? (names[hi - nameOffset] || hi) : hi;
          return loName + ' through ' + hiName;
        }

        return vals.map(function(v) { return names ? (names[v - nameOffset] || v) : v; }).join(', ');
      }

      function humanizeCron(fields) {
        var min = fields[0], hr = fields[1], dom = fields[2], mon = fields[3], dow = fields[4];

        var minH = humanizeField(min, 0, 59, null, 0, 'minute', 'minutes');
        var hrH = humanizeField(hr, 0, 23, null, 0, 'hour', 'hours');
        var domH = humanizeField(dom, 1, 31, null, 0, 'day', 'days');
        var monH = humanizeField(mon, 1, 12, MONTH_ABBR, 1, 'month', 'months');
        var dowH = humanizeField(dow, 0, 7, WDAY_ABBR, 0, 'day of week', 'days of week');

        var when = '';

        if (min === '0' && hr === '0') when = 'At midnight';
        else if (/^\d+$/.test(min) && /^\d+$/.test(hr)) when = 'At ' + parseInt(hr, 10) + ':' + ('0' + parseInt(min, 10)).slice(-2);
        else if (min === '0') when = 'At ' + hrH + (hr.indexOf('*') === -1 ? ':00' : '');
        else if (hr === '*') when = 'At ' + minH + ' past every hour';
        else when = 'At ' + minH + ' past ' + hrH;

        if (dom !== '*' && dow !== '*') when += ', on ' + (/^every /.test(domH) ? '' : 'day ') + domH + ' of the month ' + (dayFieldsOr(fields) ? 'or' : 'and') + ' on ' + dowH;
        else if (dom !== '*') when += ', on ' + (/^every /.test(domH) ? '' : 'day ') + domH + ' of the month';
        else if (dow !== '*') when += ', on ' + dowH;

        if (mon !== '*') when += ', in ' + monH;

        return when;
      }

      /* cronie: a day field that starts with an asterisk, step forms included, is unrestricted. When both day
         fields are restricted, a day matching either one runs; otherwise both must match. */
      function dayFieldsOr(fields) {
        return fields[2].charAt(0) !== '*' && fields[4].charAt(0) !== '*';
      }

      /* Walks day by day and tries only the listed hours and minutes, so a match years away (Feb 29)
         costs a few thousand steps. The longest gap between two matches of any satisfiable
         expression is Feb 29 across a skipped leap year (8 years); an expression with no match
         within 9 years never matches (Feb 30). */
      var MAX_GAP_DAYS = 366 * 9;

      function nextRuns(fields, count, from) {
        var minVals = parseField(fields[0], 0, 59, null, 0);
        var hrVals = parseField(fields[1], 0, 23, null, 0);
        var domVals = parseField(fields[2], 1, 31, null, 0);
        var monVals = parseField(fields[3], 1, 12, MONTH_ABBR, 1);
        var dowVals = parseField(fields[4], 0, 7, WDAY_ABBR, 0);
        if (!minVals || !hrVals || !domVals || !monVals || !dowVals) return null;

        var domSet = {}, monSet = {}, dowSet = {};
        domVals.forEach(function(v) { domSet[v] = true; });
        monVals.forEach(function(v) { monSet[v] = true; });
        dowVals.forEach(function(v) { dowSet[v === 7 ? 0 : v] = true; });
        var either = dayFieldsOr(fields);

        var after = from ? new Date(from.getTime()) : new Date();
        after.setSeconds(0, 0);
        var threshold = after.getTime() + 60000;
        var first = new Date(threshold);
        var y0 = first.getFullYear(), m0 = first.getMonth(), d0 = first.getDate();

        var runs = [];
        var lastHit = 0;
        for (var k = 0; runs.length < count && k - lastHit <= MAX_GAP_DAYS; k++) {
          var day = new Date(y0, m0, d0 + k);
          var Y = day.getFullYear(), M = day.getMonth(), D = day.getDate();
          if (!monSet[M + 1]) continue;
          var domOk = !!domSet[D], dowOk = !!dowSet[day.getDay()];
          if (either ? !(domOk || dowOk) : !(domOk && dowOk)) continue;
          for (var h = 0; h < hrVals.length && runs.length < count; h++) {
            for (var mi = 0; mi < minVals.length && runs.length < count; mi++) {
              var t = new Date(Y, M, D, hrVals[h], minVals[mi]);
              /* local times skipped by a DST change never match (cronie crontab(5)) */
              if (t.getDate() !== D || t.getHours() !== hrVals[h] || t.getMinutes() !== minVals[mi]) continue;
              if (t.getTime() < threshold) continue;
              runs.push(t);
              lastHit = k;
            }
          }
        }
        return runs;
      }
      /* ── engine:end ── */

      function parse() {
        var raw = document.getElementById('cron-input').value.trim();
        var statusEl = document.getElementById('cron-status');
        var resultsEl = document.getElementById('cron-results');
        resultsEl.innerHTML = '';

        var parsed = parseCron(raw);
        if (parsed.error) {
          var err = parsed.error;
          var fieldNames = [t.fMinute, t.fHour, t.fDay, t.fMonth, t.fWeekday];
          if (err.code === 'empty') statusEl.textContent = t.errEmpty;
          else if (err.code === 'fields') statusEl.textContent = t.errFields.replace('{n}', err.n);
          else if (err.code === 'unsupported') statusEl.textContent = t.errUnsupported.replace('{token}', err.token).replace('{field}', fieldNames[err.field]);
          else if (err.code === 'step') statusEl.textContent = t.errStep.replace('{token}', err.token).replace('{field}', fieldNames[err.field]);
          else statusEl.textContent = t.errInvalid;
          statusEl.className = 'cron-status error';
          return;
        }

        var fields = parsed.fields;
        var mins = parsed.values[0];
        var hrs = parsed.values[1];
        var doms = parsed.values[2];
        var mons = parsed.values[3];
        var dows = parsed.values[4];

        var human = humanizeCron(fields);
        var runs = nextRuns(fields, 10);

        var html = '<div class="cron-human">' + human + '</div>';

        html += '<div class="cron-breakdown">';
        var fieldLabels = [t.fMinute || 'Minute', t.fHour || 'Hour', t.fDay || 'Day', t.fMonth || 'Month', t.fWeekday || 'Weekday'];
        // Capitalize for display
        fieldLabels = fieldLabels.map(function(l) { return l.charAt(0).toUpperCase() + l.slice(1); });
        var fieldVals = [mins, hrs, doms, mons, dows];
        var names = [null, null, null, MONTHS, WDAYS];
        var nameOff = [0, 0, 0, 1, 0];
        for (var i = 0; i < 5; i++) {
          var displayVals = fieldVals[i].map(function(v, idx) {
            if (!names[i]) return v;
            return names[i][v - nameOff[i]] || v;
          });
          html += '<div class="cron-field-row"><span class="cron-field-name">' + fieldLabels[i] + '</span><code class="cron-field-expr">' + fields[i] + '</code><span class="cron-field-vals">' + displayVals.slice(0, 12).join(', ') + (displayVals.length > 12 ? '…' : '') + '</span></div>';
        }
        html += '</div>';

        if (runs && runs.length) {
          html += '<div class="cron-next-label">' + t.nextRuns + '</div>';
          html += '<ol class="cron-next-list">';
          runs.forEach(function(d) {
            html += '<li>' + d.toLocaleString() + '</li>';
          });
          html += '</ol>';
        } else {
          html += '<div class="cron-next-label">' + t.noRuns + '</div>';
        }

        resultsEl.innerHTML = html;
        statusEl.textContent = t.valid;
        statusEl.className = 'cron-status success';
        window.trackTool && window.trackTool('cron_parser', 'parse');
      }

      document.getElementById('cron-parse').addEventListener('click', parse);

      document.getElementById('cron-input').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          e.stopPropagation();
          parse();
        }
      });

      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var wrap = document.querySelector('.cron-wrap');
        if (!wrap.contains(document.activeElement)) return;
        e.preventDefault();
        var inputEl = document.getElementById('cron-input');
        inputEl.focus();
        inputEl.value = '';
        var statusEl = document.getElementById('cron-status');
        statusEl.textContent = '';
        statusEl.className = 'cron-status';
        document.getElementById('cron-results').innerHTML = '';
      });

      document.querySelectorAll('.btn-preset').forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.getElementById('cron-input').value = btn.getAttribute('data-expr');
          parse();
        });
      });

      // Auto-parse on load
      parse();
    })();
  </script>
</div>

