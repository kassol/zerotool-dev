---
// FileHashCheckerTool — SHA-256 / SHA-1 / SHA-384 / SHA-512 / MD5 / CRC32 of local files,
// and verification against a pasted hash or checksum list (sha256sum, BSD tags, certutil,
// Get-FileHash, SRI, Base64). Files are streamed through public/vendor/file-hash-worker.js
// (one worker per algorithm, hash-wasm), so memory stays flat for any file size.
// Nothing is uploaded or stored.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

