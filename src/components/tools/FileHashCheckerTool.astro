const T = STRINGS[lang];
const ALGO_UI = [
  { id: 'SHA-256', checked: true, tag: '' },
  { id: 'SHA-1', checked: false, tag: T.legacyTag },
  { id: 'SHA-384', checked: false, tag: '' },
  { id: 'SHA-512', checked: false, tag: '' },
  { id: 'MD5', checked: false, tag: T.legacyTag },
  { id: 'CRC32', checked: false, tag: T.crcTag },
];
---

<div>
  <div class="fhc-wrap" id="fhc-wrap">
    <div id="fhc-drop" class="fhc-drop" role="button" tabindex="0" aria-label={T.dropAria}>
      <svg class="fhc-drop-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 15h6M9 18h6M11 12l-1 8M14 12l-1 8"/>
      </svg>
      <span class="fhc-drop-text">
        <span class="fhc-drop-title" data-full={T.dropTitle} data-compact={T.addMore}>{T.dropTitle}</span>
        <span class="fhc-drop-sub">{T.dropSub}</span>
      </span>
    </div>
    <input type="file" id="fhc-file" multiple hidden />
    <input type="file" id="fhc-dir" webkitdirectory multiple hidden />

    <div class="fhc-bar">
      <fieldset class="fhc-algos">
        <legend class="fhc-sr">{T.algorithms}</legend>
        {ALGO_UI.map((a) => (
          <label class="fhc-algo"><input type="checkbox" data-algo={a.id} checked={a.checked} /><span>{a.id}{a.tag && <em class="fhc-tag">{a.tag}</em>}</span></label>
        ))}
      </fieldset>
      <button type="button" id="fhc-pick-dir" class="btn-ghost btn-sm fhc-pick-dir">{T.chooseFolder}</button>
    </div>

    <ul id="fhc-list" class="fhc-list" hidden></ul>
    <p id="fhc-status" class="tool-status fhc-status" role="status" aria-live="polite"></p>

    <div id="fhc-tools" class="fhc-tools" hidden>
      <label class="fhc-upper"><input type="checkbox" id="fhc-upper" /> {T.upper}</label>
      <span class="fhc-out">
        <label for="fhc-out-algo" class="fhc-out-label">{T.listOut}</label>
        <select id="fhc-out-algo" class="tool-input fhc-out-algo"></select>
        <button type="button" id="fhc-out-copy" class="btn-copy">{T.copyList}</button>
        <button type="button" id="fhc-out-dl" class="btn-secondary btn-sm">{T.download}</button>
      </span>
      <span class="fhc-tools-end">
        <button type="button" id="fhc-stop" class="btn-secondary btn-sm" hidden>{T.stop}</button>
        <button type="button" id="fhc-clear" class="btn-ghost btn-sm">{T.clearAll}</button>
      </span>
    </div>

    <div class="fhc-verify">
      <div class="fhc-verify-head">
        <label for="fhc-expected" class="tool-label fhc-verify-label">{T.expectedLabel}</label>
