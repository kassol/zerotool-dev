        delete f.errors[algo];
        var job = { id: ++jobSeq, key: f.key, algo: algo, done: 0 };
        f.jobs[algo] = job;
        f.stopped = false;
        poolFor(algo).queue.push(job);
        if (!batch) batch = { t0: performance.now(), bytes: 0 };
        pump(algo);
      }
      function pump(algo) {
        var p = poolFor(algo);
        while (!p.job && p.queue.length) {
          var job = p.queue.shift();
          var f = byKey[job.key];
          if (!f || f.jobs[algo] !== job) continue;
          var w = startWorker(algo);
          if (!w) return;
          p.job = job;
          if (!f.t0) f.t0 = performance.now();
          w.postMessage({ id: job.id, file: f.file, algo: algo });
        }
      }
      function onMessage(algo, m) {
        var p = poolFor(algo);
        var job = p.job;
        if (!job || job.id !== m.id) return;
        var f = byKey[job.key];
        if (m.type === 'progress') { job.done = m.done; scheduleProgress(); return; }
        p.job = null;
        if (f && f.jobs[algo] === job) {
          delete f.jobs[algo];
          if (m.type === 'done') f.hashes[algo] = m.hex;
          else f.errors[algo] = { name: m.name, message: m.message };
          if (!Object.keys(f.jobs).length) f.t1 = performance.now();
          touch(f);
        }
        pump(algo);
        changed();
      }
      function busy() {
        return Object.keys(pool).some(function (a) { return pool[a].job || pool[a].queue.length; });
      }
      function stopAll(keepStatus) {
        Object.keys(pool).forEach(function (a) {
          var p = pool[a];
          if (p.job && p.w) { p.w.terminate(); p.w = null; }
          p.job = null;
          p.queue = [];
        });
        files.forEach(function (f) {
          if (Object.keys(f.jobs).length) { f.jobs = {}; f.stopped = true; touch(f); }
        });
        batch = null;
        if (!keepStatus) notice = S.stopped;
        changed();
      }
      function cancelFile(f) {
        Object.keys(f.jobs).forEach(function (a) {
          var p = poolFor(a);
          if (p.job && p.job.key === f.key) { if (p.w) p.w.terminate(); p.w = null; p.job = null; }
          p.queue = p.queue.filter(function (j) { return j.key !== f.key; });
        });
        f.jobs = {};
        Object.keys(pool).forEach(pump);
      }

      /* ── files ── */
      function addFiles(list) {
        var added = 0;
        notice = '';
        for (var i = 0; i < list.length; i++) {
          if (files.length >= MAX_FILES) { notice = fill(S.tooMany, { max: MAX_FILES }); break; }
          var item = list[i];
          var file = item.file || item;
          var path = item.path || file.webkitRelativePath || file.name || 'file';
          var f = { key: 'f' + (++keySeq), file: file, name: file.name, path: path, size: file.size, hashes: {}, jobs: {}, errors: {}, stopped: false };
          files.push(f);
          byKey[f.key] = f;
          added++;
        }
        if (!added && !notice) notice = S.emptyFolder;
        hashMissing();
        changed();
      }
      function hashMissing() {
        var algos = checkedAlgos();
        files.forEach(function (f) { algos.forEach(function (a) { if (!f.errors[a] || f.stopped) enqueue(f, a); }); });
      }
      function removeFile(key) {
        var f = byKey[key];
        if (!f) return;
        cancelFile(f);
        files = files.filter(function (x) { return x !== f; });
        delete byKey[key];
        if (cards[key]) { cards[key].li.remove(); delete cards[key]; }
        changed();
      }
      function clearAll() {
        stopAll(true);
        files = [];
        byKey = {};
        cards = {};
        listEl.textContent = '';
        notice = '';
        changed();
      }

      // Folder drops: walk FileSystemEntry trees; keep the relative path for list matching.
      function readEntries(entry, prefix, out) {
        return new Promise(function (resolve) {
          if (entry.isFile) {
            entry.file(function (file) { out.push({ file: file, path: prefix + file.name }); resolve(); }, function () { resolve(); });
          } else if (entry.isDirectory) {
            var reader = entry.createReader();
            var all = [];
            (function next() {
              reader.readEntries(function (batchEntries) {
                if (!batchEntries.length) {
                  Promise.all(all.map(function (e) { return readEntries(e, prefix + entry.name + '/', out); })).then(resolve);
                  return;
                }
                all = all.concat(Array.prototype.slice.call(batchEntries));
                next();
              }, function () { resolve(); });
            })();
          } else resolve();
        });
      }
      function handleDrop(dt) {
        var items = dt.items ? Array.prototype.slice.call(dt.items) : [];
        var entries = items.map(function (it) { return it.kind === 'file' && it.webkitGetAsEntry ? it.webkitGetAsEntry() : null; });
        if (entries.some(function (e) { return e && e.isDirectory; })) {
          var out = [];
          Promise.all(entries.map(function (e, i) { return e ? readEntries(e, '', out) : Promise.resolve(); })).then(function () {
            out.sort(function (a, b) { return a.path < b.path ? -1 : a.path > b.path ? 1 : 0; });
            addFiles(out);
          });
        } else if (dt.files && dt.files.length) {
          addFiles(dt.files);
        }
      }

      /* ── checksum lists ── */
      function loadList(file) {
        if (file.size > MAX_LIST_BYTES) { notice = fill(S.listTooBig, { file: file.name }); changed(); return; }
        file.text().then(function (text) {
          listName = file.name;
          expectedEl.value = text;
          reparse();
          notice = fill(S.listLoaded, { file: file.name, entries: plural(S.entries, parsed.entries.length, pageLang) }) + (notice ? ' ' + notice : '');
          changed();
        });
      }
      function reparse() {
        parsed = parseExpected(expectedEl.value, listName);
        var turned = [];
        parsed.entries.forEach(function (e) {
          var box = algoBoxes.filter(function (b) { return b.getAttribute('data-algo') === e.algo; })[0];
          if (box && !box.checked) { box.checked = true; turned.push(e.algo); }
        });
        notice = '';
        if (turned.length) { notice = fill(S.autoAlgo, { algo: turned.join(', ') }); hashMissing(); }
        files.forEach(touch);
        changed();
      }

      /* ── rendering ── */
      function touch(f) { f.dirty = true; }
      // Progress messages only move the bars; everything else re-renders cards and verification.
      var needFull = true;
      function schedule() {
        if (rafPending) return;
        rafPending = true;
        requestAnimationFrame(function () { rafPending = false; var full = needFull; needFull = false; render(full); });
      }
      function changed() { needFull = true; schedule(); }
      function scheduleProgress() { schedule(); }

      function progressOf(f) {
        var algos = Object.keys(f.jobs);
        if (!algos.length) return null;
        var total = 0, done = 0;
        checkedAlgos().forEach(function (a) {
          total += f.size;
          if (f.hashes[a]) done += f.size;
          else if (f.jobs[a]) done += f.jobs[a].done;
        });
        return total ? done / total : 0;
      }

      function buildCard(f) {
        var li = el('li', 'fhc-file');
        var head = el('div', 'fhc-file-head');
        var name = el('span', 'fhc-file-name', f.path);
        var size = el('span', 'fhc-file-size', formatBytes(f.size, pageLang));
        var badge = el('span', 'fhc-badge');
        var rm = el('button', 'fhc-remove', '\u00d7');
        rm.type = 'button';
        rm.setAttribute('aria-label', fill(S.remove, { name: f.path }));
        rm.setAttribute('data-remove', f.key);
        head.appendChild(name);
        head.appendChild(size);
        head.appendChild(badge);
        head.appendChild(rm);
        var prog = el('div', 'fhc-progress');
        var bar = el('div', 'fhc-progress-bar');
        bar.setAttribute('role', 'progressbar');
        bar.setAttribute('aria-valuemin', '0');
        bar.setAttribute('aria-valuemax', '100');
        bar.setAttribute('aria-label', f.path);
        var fillEl = el('span', 'fhc-progress-fill');
        bar.appendChild(fillEl);
        var ptext = el('span', 'fhc-progress-text');
        prog.appendChild(bar);
        prog.appendChild(ptext);
        var rows = el('div', 'fhc-rows');
        var notes = el('div', 'fhc-notes');
        li.appendChild(head);
        li.appendChild(prog);
        li.appendChild(rows);
        li.appendChild(notes);
        listEl.appendChild(li);
        return { li: li, badge: badge, prog: prog, bar: bar, fill: fillEl, ptext: ptext, rows: rows, notes: notes };
      }

      function renderRows(f, c) {
        c.rows.textContent = '';
        checkedAlgos().forEach(function (a) {
          var row = el('div', 'fhc-row');
          var lab = el('span', 'fhc-row-label', a);
          row.appendChild(lab);
          if (f.hashes[a]) {
            var code = el('code', 'fhc-row-value', show(f.hashes[a]));
            row.appendChild(code);
            var btn = el('button', 'btn-copy fhc-copy', S.copy);
            btn.type = 'button';
            btn.setAttribute('data-copy', f.key + '|' + a);
            btn.setAttribute('aria-label', S.copy + ' ' + a);
            row.appendChild(btn);
          } else if (f.errors[a]) {
            var err = f.errors[a];
            var msg = err.name === 'Worker' ? S.errWorker
              : (err.name === 'NotReadableError' || err.name === 'NotFoundError' || /changed while/.test(err.message)) ? S.errRead
              : fill(S.errOther, { message: err.message });
            row.appendChild(el('span', 'fhc-row-error', msg));
            row.classList.add('is-error');
          } else if (f.stopped) {
            row.appendChild(el('span', 'fhc-row-wait', S.stoppedFile));
          } else {
            row.appendChild(el('span', 'fhc-row-wait', S.waiting));
          }
          c.rows.appendChild(row);
        });
        if (f.stopped && !Object.keys(f.jobs).length) {
          var retry = el('button', 'btn-secondary btn-sm fhc-retry', S.retry);
          retry.type = 'button';
          retry.setAttribute('data-retry', f.key);
          c.rows.appendChild(retry);
        }
      }

      function renderVerdict(f, c, v) {
        c.notes.textContent = '';
        var st = v ? v.status : 'none';
        var badgeText = { ok: S.badgeOk, fail: S.badgeFail, pending: S.badgePending, nolist: S.badgeNoList, nomatch: S.badgeNoMatch }[st] || '';
        c.badge.textContent = badgeText ? (st === 'ok' ? '\u2713 ' : st === 'fail' ? '\u2717 ' : '') + badgeText : '';
        c.badge.className = 'fhc-badge' + (badgeText ? ' is-' + st : '');
        c.li.classList.toggle('is-ok', st === 'ok');
        c.li.classList.toggle('is-fail', st === 'fail');
        if (!v) return;
        v.notes.forEach(function (n) {
          if (n.code === 'pending') return;
          var p;
          if (n.code === 'nomatch') { c.notes.appendChild(el('p', 'fhc-note', fill(S.noMatch, n))); return; }
          if (n.code.indexOf('ok') === 0) { c.notes.appendChild(el('p', 'fhc-note is-ok', fill(S[n.code], n))); return; }
          p = el('p', 'fhc-note is-fail', fill(S[n.code], n));
          c.notes.appendChild(p);
          var cmp = el('div', 'fhc-compare');
          var pos = n.pos - 1;
          [[S.expected, n.expected], [S.actual, n.got]].forEach(function (pair) {
            var line = el('div', 'fhc-compare-row');
            line.appendChild(el('span', 'fhc-compare-label', pair[0]));
            var code = el('code', 'fhc-compare-value');
            var val = show(pair[1]);
            code.appendChild(document.createTextNode(val.slice(0, pos)));
            code.appendChild(el('mark', 'fhc-diff', val.slice(pos)));
            line.appendChild(code);
            cmp.appendChild(line);
          });
          c.notes.appendChild(cmp);
          if (n.maybeOther) c.notes.appendChild(el('p', 'fhc-note', S.maybeOther));
        });
        if (v.status === 'nolist') c.notes.appendChild(el('p', 'fhc-note', S.noEntry));
      }

      function render(full) {
        var algos = checkedAlgos();
        listEl.hidden = !files.length;
        toolsEl.hidden = !files.length;
        drop.classList.toggle('is-compact', files.length > 0);
        dropTitle.textContent = files.length ? dropTitle.getAttribute('data-compact') : dropTitle.getAttribute('data-full');

        var v = full && parsed.entries.length ? verify(parsed, files) : null;

        files.forEach(function (f) {
          var c = cards[f.key] || (cards[f.key] = buildCard(f));
          var prog = progressOf(f);
          c.prog.hidden = prog === null;
          if (prog !== null) {
            var pct = Math.floor(prog * 100);
            c.fill.style.width = (prog * 100).toFixed(1) + '%';
            c.bar.setAttribute('aria-valuenow', String(pct));
            var el2 = (performance.now() - (f.t0 || performance.now())) / 1000;
            var doneBytes = prog * f.size;
            if (prog > 0 && el2 > 0.3) {
              c.ptext.textContent = fill(S.progress, { pct: pct, rate: formatBytes(doneBytes / el2, pageLang), eta: formatDuration(el2 * (1 - prog) / prog, UNITS) });
            } else c.ptext.textContent = pct + '%';
          }
          if (!full) return;
          if (f.dirty || f.renderedAlgos !== algos.join() || f.renderedUpper !== upperEl.checked) {
            renderRows(f, c);
            f.dirty = false;
            f.renderedAlgos = algos.join();
            f.renderedUpper = upperEl.checked;
          }
          if (v) renderVerdict(f, c, v.files[f.key]);
        });

        if (!full) {
          var finishedP = files.filter(function (f) { return !Object.keys(f.jobs).length; }).length;
          if (busy()) fileStatus(fill(S.hashing, { done: Math.min(finishedP + 1, files.length), total: files.length }), '');
          return;
        }

        // checksum-file output
        var done = algos.filter(function (a) { return files.some(function (f) { return f.hashes[a]; }); });
        var cur = outAlgoEl.value;
        if (outAlgoEl.getAttribute('data-algos') !== done.join()) {
          outAlgoEl.textContent = '';
          done.forEach(function (a) { var o = el('option', '', checksumFileName(a)); o.value = a; outAlgoEl.appendChild(o); });
          if (done.indexOf(cur) >= 0) outAlgoEl.value = cur;
          outAlgoEl.setAttribute('data-algos', done.join());
        }
        outAlgoEl.disabled = outCopyEl.disabled = outDlEl.disabled = !done.length;

        // status line
        var running = busy();
        stopEl.hidden = !running;
        if (running) {
          var finished = files.filter(function (f) { return !Object.keys(f.jobs).length; }).length;
          fileStatus(fill(S.hashing, { done: Math.min(finished + 1, files.length), total: files.length }), '');
        } else if (batch) {
          var secs = (performance.now() - batch.t0) / 1000;
          var anyErr = files.some(function (f) { return Object.keys(f.errors).length; });
          fileStatus(fill(S.doneAll, { files: plural(S.files, files.length, pageLang), time: formatDuration(secs, UNITS) }) + (notice ? ' ' + notice : ''), anyErr ? 'error' : 'success');
          batch = null;
          notice = '';
        } else if (notice) {
          fileStatus(notice, '');
        } else if (!files.length) {
          fileStatus('', '');
        }

        // verification summary and problems
        verifyOutEl.textContent = '';
        if (!parsed.entries.length) files.forEach(function (f) { renderVerdict(f, cards[f.key], null); });
        parsed.problems.forEach(function (p) {
          var key = { length: 'pLength', badChar: 'pBadChar', unsupported: 'pUnsupported', label: 'pLabel', none: 'pNone' }[p.code];
          verifyOutEl.appendChild(el('p', 'fhc-problem', fill(S[key], p)));
        });
        if (v && files.length) {
          var parts = [];
          if (v.summary.ok || v.summary.fail) parts.push(fill(S.summary, v.summary));
          var sum = el('p', 'fhc-summary' + (v.summary.fail ? ' is-fail' : v.summary.ok ? ' is-ok' : ''), parts.join(''));
          if (parts.length) verifyOutEl.appendChild(sum);
          if (v.summary.missing) {
            var names = v.summary.missingNames.slice(0, 5).join(', ') + (v.summary.missingNames.length > 5 ? ', \u2026' : '');
            verifyOutEl.appendChild(el('p', 'fhc-note', fill(S.summaryMissing, { n: v.summary.missing, names: names })));
          }
          if (v.summary.bareNoMatch) verifyOutEl.appendChild(el('p', 'fhc-note is-fail', fill(S.bareNoMatch, { algo: v.summary.bareAlgo })));
        }
      }

      /* ── events ── */
      drop.addEventListener('click', function () { fileInput.click(); });
      drop.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
      });
      pickDir.addEventListener('click', function () { dirInput.click(); });
      fileInput.addEventListener('change', function () { if (fileInput.files && fileInput.files.length) addFiles(fileInput.files); fileInput.value = ''; });
      dirInput.addEventListener('change', function () { if (dirInput.files && dirInput.files.length) addFiles(dirInput.files); else { notice = S.emptyFolder; changed(); } dirInput.value = ''; });

      wrap.addEventListener('dragover', function (e) {
        if (!e.dataTransfer || Array.prototype.indexOf.call(e.dataTransfer.types || [], 'Files') < 0) return;
        e.preventDefault();
        var onList = e.target === expectedEl;
        drop.classList.toggle('drag-over', !onList);
        expectedEl.classList.toggle('drag-over', onList);
      });
      wrap.addEventListener('dragleave', function (e) {
        if (!wrap.contains(e.relatedTarget)) { drop.classList.remove('drag-over'); expectedEl.classList.remove('drag-over'); }
      });
      wrap.addEventListener('drop', function (e) {
        if (!e.dataTransfer || !e.dataTransfer.files || !e.dataTransfer.files.length) return;
        e.preventDefault();
        drop.classList.remove('drag-over');
        expectedEl.classList.remove('drag-over');
        if (e.target === expectedEl) loadList(e.dataTransfer.files[0]);
        else handleDrop(e.dataTransfer);
      });

      algoBoxes.forEach(function (b) {
        b.addEventListener('change', function () {
          if (b.checked) hashMissing();
          else {
            var a = b.getAttribute('data-algo');
            var p = poolFor(a);
            if (p.job && p.w) { p.w.terminate(); p.w = null; }
            p.job = null;
            p.queue = [];
            files.forEach(function (f) { delete f.jobs[a]; touch(f); });
          }
          changed();
        });
      });
      upperEl.addEventListener('change', changed);

      listEl.addEventListener('click', function (e) {
        var t = e.target.closest('button');
        if (!t) return;
        if (t.hasAttribute('data-remove')) { removeFile(t.getAttribute('data-remove')); return; }
        if (t.hasAttribute('data-retry')) { var f = byKey[t.getAttribute('data-retry')]; if (f) { f.stopped = false; checkedAlgos().forEach(function (a) { enqueue(f, a); }); touch(f); changed(); } return; }
        if (t.hasAttribute('data-copy')) {
          var parts = t.getAttribute('data-copy').split('|');
          var ff = byKey[parts[0]];
          if (ff && ff.hashes[parts[1]]) copyText(show(ff.hashes[parts[1]]), t);
        }
      });
      function copyText(text, btn) {
        navigator.clipboard.writeText(text).then(function () {
          var prev = btn.textContent;
          btn.textContent = S.copied;
          btn.classList.add('copied');
          setTimeout(function () { btn.textContent = prev; btn.classList.remove('copied'); }, 1500);
        }, function () { fileStatus(S.copyFailed, 'error'); });
      }
      outCopyEl.addEventListener('click', function () {
        var a = outAlgoEl.value;
        if (a) copyText(checksumLines(files, a, upperEl.checked), outCopyEl);
      });
      outDlEl.addEventListener('click', function () {
        var a = outAlgoEl.value;
        if (!a) return;
        var url = URL.createObjectURL(new Blob([checksumLines(files, a, upperEl.checked)], { type: 'text/plain' }));
        var link = document.createElement('a');
        link.href = url;
        link.download = checksumFileName(a);
        document.body.appendChild(link);
        link.click();
        link.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      });
      stopEl.addEventListener('click', function () { stopAll(false); });
      clearEl.addEventListener('click', clearAll);

      var parseTimer = 0;
      expectedEl.addEventListener('input', function () {
        listName = null;
        clearTimeout(parseTimer);
        parseTimer = setTimeout(reparse, 150);
      });
      openListEl.addEventListener('click', function () { listFileEl.click(); });
      listFileEl.addEventListener('change', function () { if (listFileEl.files && listFileEl.files[0]) loadList(listFileEl.files[0]); listFileEl.value = ''; });

      // ToolLayout's Ctrl/Cmd+L clears text inputs; also drop the files and the parsed list.
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
          setTimeout(function () { listName = null; clearAll(); reparse(); }, 0);
        }
      });

      render();
    })();
  </script>
</div>

<style is:global>
  .fhc-wrap { display: flex; flex-direction: column; gap: 0.85rem; min-width: 0; }
  .fhc-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .fhc-drop {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding: 1.6rem 1.25rem;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    cursor: pointer;
    text-align: left;
    transition: border-color var(--transition-fast), background var(--transition-fast);
    outline: none;
  }
  .fhc-drop:hover,
  .fhc-drop:focus-visible,
  .fhc-drop.drag-over { border-color: var(--color-primary); background: var(--color-surface); }
  .fhc-drop:focus-visible { box-shadow: 0 0 0 3px color-mix(in oklch, var(--color-primary) 25%, transparent); }
  .fhc-drop-icon { color: var(--color-text-muted); flex-shrink: 0; }
  .fhc-drop-text { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .fhc-drop-title { font-size: 0.95rem; font-weight: 650; color: var(--color-text); }
  .fhc-drop-sub { font-size: 0.8rem; color: var(--color-text-muted); }
  .fhc-drop.is-compact { padding: 0.55rem 1rem; justify-content: flex-start; min-height: 44px; }
  .fhc-drop.is-compact .fhc-drop-icon { width: 20px; height: 20px; }
  .fhc-drop.is-compact .fhc-drop-sub { display: none; }

  .fhc-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; }
  .fhc-algos { display: flex; flex-wrap: wrap; gap: 0.4rem; border: 0; padding: 0; margin: 0; min-width: 0; flex: 1; }
  .fhc-algo {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
    font-size: 0.84rem;
    font-weight: 650;
    color: var(--color-text);
    cursor: pointer;
  }
  .fhc-algo:has(input:checked) { box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-primary) 55%, transparent); background: var(--color-surface); }
