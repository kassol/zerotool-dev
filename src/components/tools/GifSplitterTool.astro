---
// GifSplitterTool — decodes an animated GIF in the browser (hand-written
// GIF87a/89a parser + LZW decoder), composites every frame by its disposal
// method, and exports frames as PNG/JPG, a STORED ZIP, or a sprite sheet + JSON.
// No upload. Only export preferences are persisted (policy: preference).
---

<div>
  <div class="gs-wrap" id="gs-wrap">
    <div id="gs-drop" class="gs-drop" role="button" tabindex="0" aria-label="Select a GIF file" data-i18n-aria="dropAria">
      <div class="gs-drop-inner">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
        </svg>
        <p data-i18n="dropHint">Drop a GIF here, or <strong>click to select</strong></p>
        <p class="gs-hint" data-i18n="pasteHint">You can also paste a copied GIF file with Ctrl/Cmd+V</p>
        <p class="gs-hint" data-i18n="formatsHint">Animated or static GIF (GIF87a / GIF89a)</p>
      </div>
      <input type="file" id="gs-file" accept="image/gif,.gif" class="gs-file-input" tabindex="-1" aria-label="Select a GIF file" data-i18n-aria="dropAria" />
    </div>

    <progress id="gs-progress" class="gs-progress" max="1" value="0" hidden></progress>

    <div id="gs-limit" class="gs-limit" hidden>
      <p id="gs-limit-msg" class="gs-limit-msg"></p>
      <div class="gs-limit-cmd-row">
        <code id="gs-limit-cmd" class="gs-limit-cmd">ffmpeg -i input.gif -fps_mode passthrough frame-%03d.png</code>
        <button type="button" id="gs-limit-copy" class="btn-copy" data-i18n="copyCommand">Copy command</button>
      </div>
    </div>

    <div id="gs-workspace" class="gs-workspace" hidden>
      <dl class="gs-info" id="gs-info">
        <div class="gs-info-item"><dt data-i18n="infoSize">Size</dt><dd id="gs-info-size"></dd></div>
        <div class="gs-info-item"><dt data-i18n="infoFrames">Frames</dt><dd id="gs-info-frames"></dd></div>
        <div class="gs-info-item"><dt data-i18n="infoDuration">Duration</dt><dd id="gs-info-duration"></dd></div>
        <div class="gs-info-item"><dt data-i18n="infoLoop">Repeats after first play</dt><dd id="gs-info-loop"></dd></div>
        <div class="gs-info-item"><dt data-i18n="infoFile">File size</dt><dd id="gs-info-file"></dd></div>
      </dl>

      <div class="gs-select">
        <div class="gs-select-row">
          <span id="gs-selected-count" class="gs-selected-count" aria-live="polite"></span>
          <button type="button" id="gs-select-all" class="btn-ghost" data-i18n="selectAll">Select all</button>
          <button type="button" id="gs-select-none" class="btn-ghost" data-i18n="selectNone">Select none</button>
        </div>
        <div class="gs-range-row">
          <label for="gs-from" data-i18n="rangeFrom">Frames</label>
          <input type="number" id="gs-from" class="tool-input gs-num" min="1" value="1" inputmode="numeric" />
          <label for="gs-to" data-i18n="rangeTo">to</label>
          <input type="number" id="gs-to" class="tool-input gs-num" min="1" value="1" inputmode="numeric" />
          <label for="gs-step" data-i18n="rangeStep">every</label>
          <input type="number" id="gs-step" class="tool-input gs-num" min="1" value="1" inputmode="numeric" />
          <button type="button" id="gs-range-apply" class="btn-secondary" data-i18n="rangeApply">Select these</button>
        </div>
      </div>

      <div id="gs-grid" class="gs-grid" role="list" aria-label="Frames" data-i18n-aria="gridAria"></div>

      <section class="gs-panel">
        <h2 class="gs-panel-title" data-i18n="exportTitle">Export frames</h2>
        <div class="gs-export-row">
          <label class="gs-field">
            <span class="tool-label" data-i18n="formatLabel">Format</span>
            <select id="gs-format" class="tool-input gs-select-input">
              <option value="png">PNG</option>
              <option value="jpg">JPG</option>
            </select>
          </label>
          <div id="gs-jpg-opts" class="gs-jpg-opts" hidden>
            <label for="gs-quality" class="gs-quality-label">
              <span data-i18n="qualityLabel">JPG quality</span> <strong id="gs-quality-val">92</strong>
            </label>
            <input type="range" id="gs-quality" min="50" max="100" step="1" value="92" />
            <label class="gs-field gs-bg-field">
              <span class="tool-label" data-i18n="bgLabel">Background for transparent areas</span>
              <input type="color" id="gs-bg" value="#ffffff" />
            </label>
          </div>
        </div>
        <div class="gs-actions">
          <button type="button" id="gs-zip" class="btn-primary">Download ZIP</button>
          <button type="button" id="gs-reset" class="btn-ghost" data-i18n="reset">Open another GIF</button>
        </div>
      </section>

      <section class="gs-panel">
        <h2 class="gs-panel-title" data-i18n="spriteTitle">Sprite sheet</h2>
        <div class="gs-sprite-row">
          <label class="gs-field">
            <span class="tool-label" data-i18n="columnsLabel">Columns</span>
            <input type="number" id="gs-columns" class="tool-input gs-num" min="1" value="8" inputmode="numeric" />
          </label>
          <label class="gs-field">
            <span class="tool-label" data-i18n="spacingLabel">Spacing (px)</span>
            <input type="number" id="gs-spacing" class="tool-input gs-num" min="0" value="0" inputmode="numeric" />
          </label>
          <button type="button" id="gs-sprite-build" class="btn-secondary" data-i18n="buildSprite">Build sprite sheet</button>
        </div>
        <div id="gs-sprite-out" class="gs-sprite-out" hidden>
          <p id="gs-sprite-meta" class="gs-sprite-meta"></p>
          <div class="gs-sprite-preview"><img id="gs-sprite-img" alt="Sprite sheet preview" data-i18n-alt="spriteAlt" /></div>
          <div class="gs-actions">
            <button type="button" id="gs-sprite-png" class="btn-secondary" data-i18n="downloadPng">Download PNG</button>
            <button type="button" id="gs-sprite-json-dl" class="btn-secondary" data-i18n="downloadJson">Download JSON</button>
            <button type="button" id="gs-sprite-copy" class="btn-copy" data-i18n="copyJson">Copy JSON</button>
          </div>
          <textarea id="gs-sprite-json" class="tool-textarea gs-json" rows="8" readonly aria-label="Sprite sheet JSON" data-i18n-aria="jsonAria"></textarea>
        </div>
      </section>
    </div>

    <div id="gs-status" class="tool-status" aria-live="polite"></div>
  </div>

