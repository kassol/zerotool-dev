---
// NatoPhoneticAlphabetTool — text → NATO phonetic alphabet codes
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  en: {
    labelInput:'Text', labelOutput:'NATO Codes', clear:'Clear', copy:'Copy', copied:'Copied!', copyFail:'Could not copy. Try again or copy the output manually.', modeLabel:'Output Mode', modeWord:'Word', modeTable:'Table', placeholder:'Hello', outputPlaceholder:'Hotel Echo Lima Lima Oscar', thChar:'Char', thCode:'NATO Code', converted:'Converted {n} character{s}.', unknown:'[?]', space:'(space)',
    empty: 'Enter text to see NATO code words or a character table.',
    tips: {
      input: 'Text converts automatically 0.2 seconds after your last edit. A–Z and digits have codes; full-width forms are normalized. Spaces become / in Word mode. Punctuation, line breaks and other characters without codes become [?].',
      mode: 'Word shows space-separated code words. Table shows one row per typed character and keeps the original character; spaces use the localized space label. Switching modes does not change the input.',
      clear: 'Clear empties the text, both result formats and the status. Ctrl+L (⌘+L on Mac) does the same when focus is inside this tool; the selected mode stays the same.',
      copy: 'Copy uses the selected mode: space-separated code words in Word, or one character = code pair per line in Table. Digits are converted individually, with 9 written as Niner.',
    },
  },
  zh: {
    labelInput:'文本', labelOutput:'NATO 音标', clear:'清除', copy:'复制', copied:'已复制！', copyFail:'复制失败。请重试，或选中输出后手动复制。', modeLabel:'输出模式', modeWord:'单词', modeTable:'表格', placeholder:'Hello', outputPlaceholder:'Hotel Echo Lima Lima Oscar', thChar:'字符', thCode:'NATO 代号', converted:'已转换 {n} 个字符。', unknown:'[?]', space:'（空格）',
    empty: '输入文本后，这里会显示 NATO 代号或逐字符表格。',
    tips: {
      input: '停止输入 0.2 秒后自动转换。A–Z 和数字有对应代号，全角形式会规范化。单词模式中空格变为 /。标点、换行和其他没有代号的字符显示为 [?]。',
      mode: '「单词」用空格分隔代号。「表格」每个输入字符占一行，并保留原字符；空格使用当前语言的空格标签。切换模式不会修改输入。',
      clear: '「清除」清空文本、两种结果和状态。焦点在工具内时，Ctrl+L（Mac 为 ⌘+L）执行相同操作；所选模式保留。',
      copy: '按当前模式复制：「单词」复制空格分隔的代号；「表格」每行复制一组「字符 = 代号」。数字逐位转换，9 写作 Niner。',
    },
  },
  ja: {
    labelInput:'テキスト', labelOutput:'NATO コード', clear:'クリア', copy:'コピー', copied:'コピー済み！', copyFail:'コピーできませんでした。再試行するか、出力を選択して手動でコピーしてください。', modeLabel:'出力モード', modeWord:'単語', modeTable:'テーブル', placeholder:'Hello', outputPlaceholder:'Hotel Echo Lima Lima Oscar', thChar:'文字', thCode:'NATOコード', converted:'{n} 文字を変換しました。', unknown:'[?]', space:'（スペース）',
    empty: 'テキストを入力すると、NATO コードまたは文字別の表を表示します。',
    tips: {
      input: '入力を止めてから 0.2 秒後に自動変換します。A–Z と数字に対応し、全角は正規化します。単語モードでは空白が / になります。記号、改行などコードのない文字は [?] になります。',
      mode: '「単語」はコードを空白で区切って表示します。「テーブル」は入力した文字をそのまま 1 行ずつ表示し、空白には現在の言語のラベルを使います。切り替えても入力は変わりません。',
      clear: '「クリア」はテキスト、両方の結果、ステータスを空にします。ツール内にフォーカスがあるときは Ctrl+L（Mac は ⌘+L）も同じ操作です。選択したモードは維持します。',
      copy: '選択中のモードでコピーします。「単語」は空白で区切ったコード、「テーブル」は 1 行に 1 組の「文字 = コード」です。数字は 1 桁ずつ変換し、9 は Niner と書きます。',
    },
  },
  ko: {
    labelInput:'텍스트', labelOutput:'NATO 코드', clear:'지우기', copy:'복사', copied:'복사됨!', copyFail:'복사하지 못했습니다. 다시 시도하거나 출력을 선택하여 직접 복사하세요.', modeLabel:'출력 모드', modeWord:'단어', modeTable:'표', placeholder:'Hello', outputPlaceholder:'Hotel Echo Lima Lima Oscar', thChar:'문자', thCode:'NATO 코드', converted:'{n}자를 변환했습니다.', unknown:'[?]', space:'(공백)',
    empty: '텍스트를 입력하면 NATO 코드 또는 문자별 표가 여기에 표시됩니다.',
    tips: {
      input: '입력을 멈춘 뒤 0.2초 후 자동으로 변환합니다. A–Z와 숫자에 코드가 있으며 전각 문자는 정규화합니다. 단어 모드에서 공백은 /가 됩니다. 문장 부호, 줄바꿈 등 코드가 없는 문자는 [?]로 표시됩니다.',
      mode: '「단어」는 코드를 공백으로 구분합니다. 「표」는 입력 문자마다 한 행을 만들고 원래 문자를 유지하며, 공백에는 현재 언어의 공백 이름을 사용합니다. 모드를 바꿔도 입력은 바뀌지 않습니다.',
      clear: '「지우기」는 텍스트, 두 결과 형식과 상태를 비웁니다. 도구 안에 포커스가 있으면 Ctrl+L(Mac은 ⌘+L)도 같은 작업을 합니다. 선택한 모드는 유지됩니다.',
      copy: '선택한 모드로 복사합니다. 「단어」는 공백으로 구분한 코드이며, 「표」는 한 줄에 하나의 「문자 = 코드」 쌍입니다. 숫자는 한 자리씩 변환하고 9는 Niner로 표시합니다.',
    },
  },
} as const;
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="nato-wrap">
  <div class="nato-options">
    <span class="nato-mode-group">
      <span id="nato-mode-label" class="nato-opt-label">{T.modeLabel}</span>
      <span class="nato-mode-btns zt-segmented" role="group" aria-labelledby="nato-mode-label">
        <button class="nato-mode-btn active" data-mode="word" type="button" aria-pressed="true">{T.modeWord}</button>
        <button class="nato-mode-btn" data-mode="table" type="button" aria-pressed="false">{T.modeTable}</button>
      </span>
      <Toggletip id="nato-tip-mode" lang={lang} about={T.modeLabel}>{TIPS.mode}</Toggletip>
    </span>
    <span class="nato-clear">
      <button id="nato-clear" class="btn-ghost" type="button">{T.clear}</button>
      <Toggletip id="nato-tip-clear" lang={lang} about={T.clear}>{TIPS.clear}</Toggletip>
    </span>
  </div>
  <div id="nato-status" class="tool-status nato-status" role="status" aria-live="polite"></div>
  <div class="nato-panels zt-io">
    <div class="nato-panel zt-io-pane">
      <div class="nato-head">
        <label for="nato-input" class="nato-label">{T.labelInput}</label>
        <Toggletip id="nato-tip-input" lang={lang} about={T.labelInput} wide>{TIPS.input}</Toggletip>
      </div>
      <textarea id="nato-input" class="tool-textarea nato-box zt-io-fill" spellcheck="false" placeholder={T.placeholder}></textarea>
    </div>
    <div id="nato-result-pane" class="nato-panel nato-result-pane zt-io-pane" data-empty="true">
      <div class="nato-head">
        <span id="nato-result-label" class="nato-label">{T.labelOutput}</span>
        <span class="nato-copy">
          <button id="nato-copy" class="btn-copy" type="button">{T.copy}</button>
          <Toggletip id="nato-tip-copy" lang={lang} about={T.copy}>{TIPS.copy}</Toggletip>
        </span>
      </div>
      <p class="nato-empty zt-io-fill">{T.empty}</p>
      <textarea id="nato-output" class="tool-textarea nato-box zt-io-fill" readonly spellcheck="false" aria-labelledby="nato-result-label" placeholder={T.outputPlaceholder}></textarea>
      <div id="nato-table-wrap" class="nato-table-wrap zt-io-fill" tabindex="0" role="region" aria-labelledby="nato-result-label" hidden>
        <table id="nato-table" class="nato-table">
          <thead><tr><th>{T.thChar}</th><th>{T.thCode}</th></tr></thead>
          <tbody id="nato-table-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      /* ── engine:start ── */
      // ICAO Annex 10 spellings (Alfa, Juliett), also used by NATO and Japan's 無線局運用規則 別表第五号.
      var NATO = {
        A:'Alfa', B:'Bravo', C:'Charlie', D:'Delta', E:'Echo', F:'Foxtrot',
        G:'Golf', H:'Hotel', I:'India', J:'Juliett', K:'Kilo', L:'Lima',
        M:'Mike', N:'November', O:'Oscar', P:'Papa', Q:'Quebec', R:'Romeo',
        S:'Sierra', T:'Tango', U:'Uniform', V:'Victor', W:'Whiskey',
        X:'X-ray', Y:'Yankee', Z:'Zulu',
        '0':'Zero', '1':'One', '2':'Two', '3':'Three', '4':'Four',
        '5':'Five', '6':'Six', '7':'Seven', '8':'Eight', '9':'Niner'
      };

      // Full-width letters, digits and spaces (ＡＢＣ１２３, U+3000) are matched after NFKC.
      function convert(text, unknown, spaceLabel) {
        var rows = [];
        var codes = [];
        var chars = 0;
        Array.from(text).forEach(function (ch) {
          var key = ch.normalize('NFKC').toUpperCase();
          if (key === ' ') {
            rows.push({ ch: spaceLabel, code: '—' });
            codes.push('/');
            return;
          }
          chars++;
          var code = Object.prototype.hasOwnProperty.call(NATO, key) ? NATO[key] : unknown;
          rows.push({ ch: ch, code: code });
          codes.push(code);
        });
        return { rows: rows, codes: codes, chars: chars };
      }
      /* ── engine:end ── */

      var inputEl   = document.getElementById('nato-input');
      var outputEl  = document.getElementById('nato-output');
      var resultPane = document.getElementById('nato-result-pane');
      var statusEl  = document.getElementById('nato-status');
      var tableWrap = document.getElementById('nato-table-wrap');
      var tableBody = document.getElementById('nato-table-body');
      var copyBtn   = document.getElementById('nato-copy');
      var currentMode = 'word';
      var copyRevision = 0;
      var copyTimer = null;
      var copyError = false;
      var renderedStatus = '';

      function charMsg(n) {
        return t.converted.replace('{n}', n).replace('{s}', n === 1 ? '' : 's');
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        if (copyError) statusEl.textContent = renderedStatus;
        copyError = false;
      }

      function render() {
        invalidateCopy();
        var text = inputEl.value;
        resultPane.setAttribute('data-empty', text ? 'false' : 'true');
        if (!text) {
          outputEl.value = '';
          tableBody.innerHTML = '';
          statusEl.textContent = renderedStatus = '';
          return;
        }
        var result = convert(text, t.unknown, t.space);
        outputEl.value = result.codes.join(' ');

        tableBody.innerHTML = '';
        result.rows.forEach(function(row) {
          var tr = document.createElement('tr');
          var td1 = document.createElement('td');
          td1.className = 'nato-char';
          td1.textContent = row.ch;
          var td2 = document.createElement('td');
          td2.textContent = row.code;
          tr.appendChild(td1);
          tr.appendChild(td2);
          tableBody.appendChild(tr);
        });

        statusEl.textContent = renderedStatus = charMsg(result.chars);
      }

      /* mode toggle */
      document.querySelectorAll('.nato-mode-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          invalidateCopy();
          document.querySelectorAll('.nato-mode-btn').forEach(function(b) {
            b.classList.remove('active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          currentMode = btn.getAttribute('data-mode');
          if (currentMode === 'table') {
            outputEl.hidden = true;
            tableWrap.hidden = false;
          } else {
            outputEl.hidden = false;
            tableWrap.hidden = true;
          }
        });
      });

      /* realtime */
      var _timer = null;
      inputEl.addEventListener('input', function() {
        invalidateCopy();
        clearTimeout(_timer);
        _timer = setTimeout(render, 200);
      });

      /* Analytics: one event per committed change (focus leaves after an edit), once per
         distinct nonblank text, not after every pause in typing. */
      var trackedText = null;
      inputEl.addEventListener('change', function() {
        var text = inputEl.value;
        if (!text.trim() || text === trackedText) return;
        trackedText = text;
        window.trackTool && window.trackTool('nato_phonetic_alphabet', 'convert');
      });

      function clearAll() {
        clearTimeout(_timer);
        trackedText = null;
        inputEl.value = '';
        render();
      }

      document.getElementById('nato-clear').addEventListener('click', clearAll);
      document.addEventListener('keydown', function(e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var root = document.querySelector('.nato-wrap');
        if (root && root.contains(document.activeElement)) clearAll();
      });

      copyBtn.addEventListener('click', function() {
        var text = currentMode === 'table'
          ? Array.from(tableBody.querySelectorAll('tr')).map(function(tr) {
              return tr.cells[0].textContent + ' = ' + tr.cells[1].textContent;
            }).join('\n')
          : outputEl.value;
        if (!text) return;
        invalidateCopy();
        var revision = copyRevision;
        function done() {
          if (revision !== copyRevision) return;
          copyBtn.textContent = t.copied;
          copyTimer = setTimeout(function() {
            if (revision === copyRevision) copyBtn.textContent = t.copy;
          }, 1500);
        }
        function failed() {
          if (revision !== copyRevision) return;
          statusEl.textContent = t.copyFail;
          copyError = true;
        }
        // Clipboard API first; when it is missing, throws or rejects, a hidden textarea and
        // execCommand('copy') (same as MarkdownLinterTool.astro); both failing shows copyFail.
        // A copy that is no longer current does not fall back.
        function fallback() {
          if (revision !== copyRevision) return;
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          var ok = false;
          try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
          document.body.removeChild(ta);
          // select() moved focus to the textarea; give it back to the button (keyboard users).
          copyBtn.focus();
          if (ok) done(); else failed();
        }
        var pending;
        try { pending = navigator.clipboard && navigator.clipboard.writeText ? navigator.clipboard.writeText(text) : null; }
        catch (e) { pending = null; }
        if (pending) Promise.resolve(pending).then(done, fallback);
        else fallback();
      });
    })();
  </script>
</div>

<style>
  .nato-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-height: 0; min-width: 0; }
  .nato-options, .nato-mode-group { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
  .nato-clear, .nato-copy { display: inline-flex; align-items: center; gap: 0.25rem; margin-left: auto; }
  .nato-label, .nato-opt-label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .nato-mode-btns { padding: 3px; background: var(--color-bg-secondary); }
  .nato-mode-btn { min-height: 32px; padding: 0.25rem 0.65rem; border: 0; border-radius: var(--radius-pill); background: transparent; color: var(--color-text-secondary); cursor: pointer; }
  .nato-mode-btn:hover { color: var(--color-primary); }
  .nato-mode-btn.active { background: var(--color-surface); color: var(--color-primary); box-shadow: var(--shadow-subtle); }
  .nato-mode-btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 1px; }
  .nato-status { flex: none; height: 3rem; overflow: auto; overflow-wrap: anywhere; }
  .nato-head { display: flex; align-items: center; gap: 0.25rem; min-height: 32px; }
  .nato-box { font-family: var(--font-mono); line-height: 1.6; overflow: auto; }
  .nato-panel textarea[hidden] { display: none; }
  .nato-table-wrap[hidden] { display: none; }
  .nato-empty { display: grid; place-items: center; margin: 0; padding: 1rem; text-align: center; color: var(--color-text-muted); border: 1px dashed var(--color-border); border-radius: var(--radius-md); }
  .nato-result-pane[data-empty="false"] .nato-empty,
  .nato-result-pane[data-empty="true"] .nato-box,
  .nato-result-pane[data-empty="true"] .nato-table-wrap { display: none; }
  .nato-table-wrap { overflow: auto; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .nato-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .nato-table th, .nato-table :global(td) { padding: 0.5rem 0.75rem; text-align: left; border-bottom: 1px solid var(--color-border); }
  .nato-table th { background: var(--color-bg-secondary); font-weight: 600; color: var(--color-text-secondary); font-size: 0.8rem; }
  .nato-table :global(tr:last-child td) { border-bottom: none; }
  .nato-table :global(tr:hover td) { background: var(--color-bg-secondary); }
  .nato-table :global(.nato-char) { font-family: var(--font-mono); font-weight: 600; color: var(--color-primary); }
  @media (max-width: 860px) {
    .nato-box, .nato-table-wrap { height: 180px; }
    .nato-result-pane[data-empty="true"] { display: none; }
  }
  @media (max-width: 640px) {
    .nato-options { gap: 0.4rem; }
    .nato-mode-btn, .nato-clear .btn-ghost, .nato-copy .btn-copy { min-height: 44px; }
    .nato-box { height: 140px; }
    .nato-table-wrap { height: 180px; }
  }
</style>
