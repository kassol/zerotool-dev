        return;
      }
      var sp = splitInput(text, mode, { split: splitEl.checked });
      if ((sp.kind === 'netscape' || sp.setCookies.length) && !ensurePsl()) {
        setStatus(S.pslLoading, 'info');
        simBox.hidden = true;
        current = null;
        return;
