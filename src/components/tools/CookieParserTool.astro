          current.jarSource = rs.analyses;
          var c = { stored: 0, delete: 0, rejected: 0, unknown: 0 };
          rs.analyses.forEach(function (a) { c[a.verdict]++; });
          msgs.push(fmt(plural(S.statusSet, rs.analyses.length), { stored: c.stored, del: c.delete, rejected: c.rejected }));
          if (c.unknown) msgs.push(fmt(S.unknownCount, { n: c.unknown }) + '.');
