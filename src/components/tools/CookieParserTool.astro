      if (current.cookie) out.push('Cookie: ' + redactCookieHeader(current.cookie.pairs, mode).text);
      if (current.set) current.set.forEach(function (a) { out.push('Set-Cookie: ' + redactSetCookie(a.parsed, mode).text); });
      return out.join('\n');
