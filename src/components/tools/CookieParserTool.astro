    var bOut = $('ck-b-out'), bDel = $('ck-b-del'), bIssues = $('ck-b-issues');
    function buildForm() {
      var exMs = null;
      if (bf.expires.value) { var t = Date.parse(bf.expires.value + 'Z'); exMs = isNaN(t) ? null : t; }
      return {
        name: bf.name.value.trim(), value: bf.value.value, encode: bf.encode.checked, domain: bf.domain.value.trim(), path: bf.path.value.trim(),
        lifetime: bf.lifetime.value, maxAge: bf.maxAge.value.trim(), expiresMs: exMs, secure: bf.secure.checked, httpOnly: bf.httpOnly.checked,
        sameSite: bf.sameSite.value, partitioned: bf.partitioned.checked, priority: bf.priority.value
      };
    }
    function buildRender() {
      var f = buildForm();
      bf.maxAge.disabled = f.lifetime !== 'max-age';
      bf.expires.disabled = f.lifetime !== 'expires';
      bIssues.textContent = '';
      if (!f.name && !f.value) { bOut.textContent = ''; bDel.textContent = ''; return; }
      if (f.domain) ensurePsl();
      var b = buildSetCookie(f);
      bOut.textContent = 'Set-Cookie: ' + b.line;
      bDel.textContent = 'Set-Cookie: ' + b.deleteLine;
      var a = analyzeSetCookie(parseSetCookie(b.line), { now: Date.now(), url: parseUrl(simResp.value).url });
      var list = [];
      a.reject.forEach(function (r) { list.push({ sev: 'error', text: fmt(S.reject[r.code] || r.code, r.vars) }); });
      a.issues.forEach(function (it) { if (it.code !== 'domainWide') list.push({ sev: it.sev, text: issueText(it) }); });
      if (f.name && !isToken(f.name)) list.unshift({ sev: 'error', text: fmt(S.issues.nameNotToken, { ch: firstNonToken(f.name) }) });
      if (!f.encode && cookieOctetIssue(f.value)) list.push({ sev: 'warn', text: S.buildEncodeHint });
      list.sort(function (x, y) { return sevRank(x.sev) - sevRank(y.sev); });
      list.forEach(function (it) { bIssues.appendChild(el('li', 'ck-iss ck-iss-' + it.sev, it.text)); });
    }
    function fillBuilder(a) {
