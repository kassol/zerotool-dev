    copyJsonBtn.addEventListener('click', function () {
      if (!current) { setStatus(S.statusEmpty, 'info'); return; }
      copyText(jsonText(), copyJsonBtn);
      if (window.trackTool) window.trackTool('cookie-parser', 'copy_json');
    });
    copyRedBtn.addEventListener('click', function () {
      if (!current) { setStatus(S.statusEmpty, 'info'); return; }
      copyText(redactedText(), copyRedBtn);
      if (window.trackTool) window.trackTool('cookie-parser', 'copy_redacted');
    });

    modeBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        mode = b.getAttribute('data-mode');
        modeBtns.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        render(false);
      });
    });
    inputEl.addEventListener('input', function () { render(false); });
    [decodeEl, splitEl, jsonFmtEl].forEach(function (x) { x.addEventListener('change', function () { render(false); }); });
    simResp.addEventListener('input', function () { render(false); });
    [simReq, simCtx].forEach(function (x) { x.addEventListener('input', runSim); x.addEventListener('change', runSim); });
    // A failed import() stays failed for this document (HTML module map), so a retry needs a reload.
    inputEl.addEventListener('focus', ensurePsl, { once: true });
    $('ck-ex-cookie').addEventListener('click', function () {
      inputEl.value = S.exampleCookie; simResp.value = ''; simReq.value = '';
      setMode('auto'); render(true);
    });
    $('ck-ex-set').addEventListener('click', function () {
      inputEl.value = S.exampleSet; simResp.value = S.exampleRespUrl; simReq.value = S.exampleReqUrl;
      simBox.open = true;
      setMode('auto'); render(true);
    });
    $('ck-clear').addEventListener('click', function () {
      inputEl.value = ''; simResp.value = ''; simReq.value = '';
      render(false); inputEl.focus();
    });
    function setMode(m) { mode = m; modeBtns.forEach(function (x) { x.setAttribute('aria-pressed', x.getAttribute('data-mode') === m ? 'true' : 'false'); }); }
    /* ToolLayout clears text inputs on Ctrl/⌘+L; re-render once it has. */
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L')) setTimeout(function () { render(false); buildRender(); }, 0);
    });

    // ---- builder ----
    var bf = {
      name: $('ck-b-name'), value: $('ck-b-value'), encode: $('ck-b-encode'), domain: $('ck-b-domain'), path: $('ck-b-path'),
      lifetime: $('ck-b-life'), maxAge: $('ck-b-maxage'), expires: $('ck-b-expires'), secure: $('ck-b-secure'), httpOnly: $('ck-b-httponly'),
      sameSite: $('ck-b-samesite'), partitioned: $('ck-b-partitioned'), priority: $('ck-b-priority')
