    function copyText(text, btn) {
      function done(ok) {
        if (!btn) return;
        var label = btn.getAttribute('data-label') || btn.textContent;
        btn.setAttribute('data-label', label);
        btn.textContent = ok ? S.copied : S.copyFailed;
        setTimeout(function () { btn.textContent = label; }, 1500);
