    function jsonText() {
      if (!current) return '';
      var decodeOn = decodeEl.checked;
      if (current.netscape) return JSON.stringify(current.netscape.map(function (e) {
        return { name: e.name, value: decodeOn ? decodeValue(e.value).text : e.value, domain: e.domain, hostOnly: e.hostOnly, path: e.path, secure: e.secure, httpOnly: e.httpOnly, expires: e.expiresMs ? new Date(e.expiresMs).toISOString() : null, session: e.session };
      }), null, 2);
      var parts = [];
      if (current.cookie) parts.push(cookiesToJson(current.cookie.pairs, jsonFmtEl.value, decodeOn));
      if (current.set) parts.push(setCookiesToJson(current.set, decodeOn));
      return parts.join('\n');
    }
    function redactedText() {
      if (!current) return '';
      var mode = redactEl.value, out = [];
      if (current.netscape) {
        return current.split.netscape.length ? inputEl.value.split(/\r\n|\r|\n/).map(function (line) {
          var f = line.split('\t');
          if (f.length === 7 && (line[0] !== '#' || /^#HttpOnly_/.test(line))) { if (shouldRedact(f[5], f[6], mode)) f[6] = REDACTED; return f.join('\t'); }
          return line;
        }).join('\n') : '';
