    }
    Object.keys(bf).forEach(function (k) { bf[k].addEventListener('input', buildRender); bf[k].addEventListener('change', buildRender); });
    $('ck-b-copy').addEventListener('click', function () { if (bOut.textContent) copyText(bOut.textContent, $('ck-b-copy')); });
    $('ck-b-copy-del').addEventListener('click', function () { if (bDel.textContent) copyText(bDel.textContent, $('ck-b-copy-del')); });
    buildRender();
    if (inputEl.value) render(false);
  })();
</script>

