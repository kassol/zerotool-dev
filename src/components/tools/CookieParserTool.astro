const T = STRINGS[lang] ?? STRINGS.en;
const { tips: TIPS, ...CLIENT_T } = T;
---
<div class="ck-wrap" id="ck-wrap">
  <div class="ck-top">
    <div class="ck-mode-row">
      <div class="ck-modes" role="group" aria-label={T.readAs}>
        <button type="button" class="ck-mode" data-mode="auto" aria-pressed="true">{T.modeAuto}</button>
        <button type="button" class="ck-mode" data-mode="cookie" aria-pressed="false">{T.modeCookie}</button>
        <button type="button" class="ck-mode" data-mode="set-cookie" aria-pressed="false">{T.modeSet}</button>
      </div>
      <Toggletip id="ck-tip-mode" lang={lang} about={T.readAs}>{TIPS.mode}</Toggletip>
    </div>
    <div class="ck-top-btns">
      <button id="ck-ex-cookie" class="btn-ghost btn-sm" type="button">{T.exCookie}</button>
      <button id="ck-ex-set" class="btn-ghost btn-sm" type="button">{T.exSet}</button>
      <button id="ck-clear" class="btn-ghost btn-sm" type="button">{T.clear}</button>
    </div>
  </div>
  <details class="ck-box ck-options">
    <summary>{T.optsTitle}</summary>
    <div class="ck-opts">
      <div class="ck-option"><label class="ck-check"><input id="ck-decode" type="checkbox" checked /> {T.optDecode}</label><Toggletip id="ck-tip-decode" lang={lang} about={T.optDecode}>{TIPS.decode}</Toggletip></div>
      <div class="ck-option"><label class="ck-check"><input id="ck-split" type="checkbox" checked /> {T.optSplit}</label><Toggletip id="ck-tip-split" lang={lang} about={T.optSplit}>{TIPS.split}</Toggletip></div>
      <div class="ck-field"><div class="ck-label-row"><label class="tool-label" for="ck-json-format">{T.optJson}</label><Toggletip id="ck-tip-json" lang={lang} about={T.optJson}>{TIPS.json}</Toggletip></div>
        <select id="ck-json-format" class="tool-input">
          <option value="object">{T.optJsonObject}</option>
          <option value="array">{T.optJsonArray}</option>
        </select>
      </div>
      <div class="ck-field"><div class="ck-label-row"><label class="tool-label" for="ck-redact-mode">{T.optRedact}</label><Toggletip id="ck-tip-redact" lang={lang} about={T.optRedact}>{TIPS.redact}</Toggletip></div>
        <select id="ck-redact-mode" class="tool-input">
          <option value="all">{T.optRedactAll}</option>
          <option value="sensitive">{T.optRedactSensitive}</option>
        </select>
      </div>
    </div>
  </details>
  <p id="ck-status" class="tool-status none" role="status" aria-live="polite">{T.statusEmpty}</p>
  <div class="ck-input-pane">
    <div class="ck-label-row"><label class="tool-label" for="ck-input">{T.inputLabel}</label><Toggletip id="ck-tip-input" lang={lang} about={T.inputLabel}>{TIPS.input}</Toggletip></div>
    <textarea
      id="ck-input"
      class="tool-textarea ck-input"
      rows="5"
      spellcheck="false"
      autocapitalize="off"
      autocorrect="off"
      autocomplete="off"
      data-1p-ignore
      data-lpignore="true"
      placeholder={T.placeholder}
    ></textarea>
  </div>
  <section class="ck-results" aria-labelledby="ck-result-label">
    <div class="ck-result-head">
      <div class="ck-label-row"><span id="ck-result-label" class="tool-label">{T.resultLabel}</span><Toggletip id="ck-tip-results" lang={lang} about={T.resultLabel}>{TIPS.results}</Toggletip></div>
      <div class="ck-bar">
        <button id="ck-copy-json" class="btn-copy" type="button">{T.copyJson}</button>
        <button id="ck-copy-redacted" class="btn-copy" type="button">{T.copyRedacted}</button>
      </div>
    </div>
    <div class="ck-result-scroll" tabindex="0" role="region" aria-label={T.resultLabel}>
      <ul id="ck-notes" class="ck-notes"></ul>
      <div id="ck-out" class="ck-out"></div>
    </div>
  </section>

  <div class="ck-secondary">
    <details id="ck-sim" class="ck-box" hidden>
      <summary>{T.simTitle}</summary>
      <div class="ck-sim-grid">
        <div class="ck-label-row"><label class="tool-label" for="ck-resp-url">{T.respUrl}</label><Toggletip id="ck-tip-simulation" lang={lang} about={T.respUrl}>{TIPS.simulation}</Toggletip></div>
        <input id="ck-resp-url" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder={T.respPlaceholder} />
        <label class="tool-label" for="ck-req-url">{T.reqUrl}</label>
        <input id="ck-req-url" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder={T.reqPlaceholder} />
        <label class="tool-label" for="ck-ctx">{T.ctxLabel}</label>
        <select id="ck-ctx" class="tool-input">
          <option value="same-site">{T.ctx['same-site']}</option>
          <option value="cross-top">{T.ctx['cross-top']}</option>
          <option value="cross-sub">{T.ctx['cross-sub']}</option>
        </select>
      </div>
      <div id="ck-sim-out" class="ck-sim-out" aria-live="polite"></div>
    </details>

    <details id="ck-build" class="ck-box">
      <summary>{T.buildTitle}</summary>
      <div class="ck-build-grid">
        <label class="ck-field"><span class="tool-label">{T.bName}</span><input id="ck-b-name" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" value="session" /></label>
        <label class="ck-field"><span class="tool-label">{T.bValue}</span><input id="ck-b-value" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" value="abc123" /></label>
        <label class="ck-check ck-span"><input id="ck-b-encode" type="checkbox" /> {T.bEncode}</label>
        <label class="ck-field"><span class="tool-label">{T.bDomain}</span><input id="ck-b-domain" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" /></label>
        <label class="ck-field"><span class="tool-label">{T.bPath}</span><input id="ck-b-path" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" value="/" /></label>
        <label class="ck-field"><span class="tool-label">{T.bLife}</span>
          <select id="ck-b-life" class="tool-input">
            <option value="session">{T.bLifeSession}</option>
            <option value="max-age" selected>{T.bLifeMaxAge}</option>
            <option value="expires">{T.bLifeExpires}</option>
          </select>
        </label>
        <label class="ck-field"><span class="tool-label">{T.bLifeMaxAge}</span><input id="ck-b-maxage" class="tool-input" type="text" inputmode="numeric" value="3600" /></label>
        <label class="ck-field"><span class="tool-label">{T.bLifeExpires}</span><input id="ck-b-expires" class="tool-input" type="datetime-local" /></label>
        <label class="ck-field"><span class="tool-label">{T.bSameSite}</span>
          <select id="ck-b-samesite" class="tool-input">
            <option value="Lax" selected>Lax</option>
            <option value="Strict">Strict</option>
            <option value="None">None</option>
            <option value="">{T.bSameSiteUnset}</option>
          </select>
        </label>
        <label class="ck-field"><span class="tool-label">{T.bPriority}</span>
          <select id="ck-b-priority" class="tool-input">
            <option value="">{T.bPriorityUnset}</option>
            <option value="Low">Low</option>
            <option value="Medium">Medium</option>
            <option value="High">High</option>
          </select>
        </label>
        <div class="ck-checks ck-span">
