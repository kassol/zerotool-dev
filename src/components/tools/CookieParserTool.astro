      current = { kind: sp.kind, split: sp };
      sp.notes.forEach(function (n) { notesEl.appendChild(el('li', 'ck-note', fmt(S.notes[n.code], n.vars))); });
      var msgs = [];
      if (sp.kind === 'netscape') {
        var ns = renderNetscape(sp.netscape);
        outEl.appendChild(ns.section);
        current.netscape = ns.entries;
        current.jarSource = ns.entries;
        msgs.push(fmt(S.statusNs, { n: ns.entries.length }));
      } else {
        if (sp.cookieLines.length) {
          var rc = renderCookie(sp.cookieLines);
