---
// No props needed — tool widget is language-independent
---

<div>
  <div class="tcase-wrap">
    <div class="tcase-row">
      <label for="tcase-input" data-i18n="inputText">Input Text</label>
      <textarea
        id="tcase-input"
        data-i18n-ph="inputPlaceholder"
        placeholder="Enter your text here..."
        rows="4"
        spellcheck="false"
      ></textarea>
    </div>

    <div class="tcase-cases" id="tcase-cases">
      {/* Populated by JS */}
    </div>
  </div>

  <script is:inline>
    (function () {
      var STRINGS = {
        en: { inputText: 'Input Text', inputPlaceholder: 'Enter your text here...', copy: 'Copy', copied: 'Copied!', copyFailed: 'Copy failed' },
        zh: { inputText: '输入文本', inputPlaceholder: '在此输入文本...', copy: '复制', copied: '已复制！', copyFailed: '复制失败' },
        ja: { inputText: '入力テキスト', inputPlaceholder: 'テキストを入力してください...', copy: 'コピー', copied: 'コピー済み！', copyFailed: 'コピーに失敗' },
        ko: { inputText: '입력 텍스트', inputPlaceholder: '텍스트를 입력하세요...', copy: '복사', copied: '복사됨!', copyFailed: '복사 실패' }
      };

      var pageLang = (document.documentElement.lang || 'en').slice(0, 2);
      var t = STRINGS[pageLang] || STRINGS.en;
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n'); if (t[key]) el.textContent = t[key];
      });
      document.querySelectorAll('[data-i18n-ph]').forEach(function(el) {
        var key = el.getAttribute('data-i18n-ph'); if (t[key]) el.placeholder = t[key];
      });

      var inputEl = document.getElementById('tcase-input');
      var casesEl = document.getElementById('tcase-cases');
      var copyStates = [];

      /* ── engine:start ── */
      // Word splitting follows change-case v5 split() with separateNumbers: break at
      // lower→Upper, at ACRONYM→Word (XMLHttp → XML Http), at letter↔digit, and at any run
      // of characters that are not letters, marks or digits. Apostrophes are removed first,
      // as lodash words() does, so "don't" stays one word. Letters keep their accents.
      function splitWords(s) {
        return s
          .replace(/['\u2019]/g, '')
          .replace(/([\p{Ll}\p{N}]\p{M}*)(\p{Lu})/gu, '$1\0$2')
          .replace(/(\p{Lu}\p{M}*)(\p{Lu}\p{M}*\p{Ll})/gu, '$1\0$2')
          .replace(/(\p{L}\p{M}*)(\p{N})/gu, '$1\0$2')
          .replace(/(\p{N})(\p{L})/gu, '$1\0$2')
          .replace(/[^\p{L}\p{M}\p{N}]+/gu, '\0')
          .split('\0')
          .filter(function (w) { return w !== ''; });
      }

      function capitalize(w) {
        var first = String.fromCodePoint(w.codePointAt(0));
        return first.toUpperCase() + w.slice(first.length).toLowerCase();
      }

      var converters = [
        {
          id: 'upper',
          label: 'UPPER CASE',
          fn: function (s) { return s.toUpperCase(); },
        },
        {
          id: 'lower',
          label: 'lower case',
          fn: function (s) { return s.toLowerCase(); },
        },
        {
          id: 'title',
          label: 'Title Case',
          fn: function (s) {
            return s.replace(/[\p{L}\p{N}]\S*/gu, capitalize);
          },
        },
        {
          id: 'sentence',
          label: 'Sentence case',
          fn: function (s) {
            return s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();
          },
        },
        {
          id: 'camel',
          label: 'camelCase',
          fn: function (s) {
            return splitWords(s).map(function (w, i) {
              return i === 0 ? w.toLowerCase() : capitalize(w);
            }).join('');
          },
        },
        {
          id: 'pascal',
          label: 'PascalCase',
          fn: function (s) {
            return splitWords(s).map(capitalize).join('');
          },
        },
        {
          id: 'kebab',
          label: 'kebab-case',
          fn: function (s) {
            return splitWords(s).join('-').toLowerCase();
          },
        },
        {
          id: 'snake',
          label: 'snake_case',
          fn: function (s) {
            return splitWords(s).join('_').toLowerCase();
          },
        },
        {
          id: 'constant',
          label: 'CONSTANT_CASE',
          fn: function (s) {
            return splitWords(s).join('_').toUpperCase();
          },
        },
      ];
      /* ── engine:end ── */

      function invalidateCopy() {
        copyStates.forEach(function (state) {
          state.revision++;
          clearTimeout(state.timer);
          state.button.textContent = t.copy;
        });
      }

      // Build output rows
      converters.forEach(function (c) {
        var row = document.createElement('div');
        row.className = 'tcase-output-row';

        var lbl = document.createElement('span');
        lbl.className = 'tcase-case-label';
        lbl.textContent = c.label;

        var out = document.createElement('input');
        out.type = 'text';
        out.id = 'tcase-out-' + c.id;
        out.readOnly = true;
        out.className = 'tcase-case-output';
        out.placeholder = c.fn('hello world');

        var btn = document.createElement('button');
        btn.className = 'btn-copy';
        btn.textContent = t.copy;
        var copyState = { button: btn, revision: 0, timer: 0 };
        copyStates.push(copyState);
        btn.addEventListener('click', function () {
          if (!out.value) return;
          var revision = ++copyState.revision;
          clearTimeout(copyState.timer);
          btn.textContent = t.copy;
          function failed() {
            if (revision === copyState.revision) btn.textContent = t.copyFailed;
          }
          try {
            navigator.clipboard.writeText(out.value).then(function () {
              if (revision !== copyState.revision) return;
              btn.textContent = t.copied;
              copyState.timer = setTimeout(function () {
                if (revision === copyState.revision) btn.textContent = t.copy;
              }, 1500);
            }, failed);
          } catch (e) { failed(); }
          window.trackTool && window.trackTool('text_case', 'copy_' + c.id);
        });

        row.appendChild(lbl);
        row.appendChild(out);
        row.appendChild(btn);
        casesEl.appendChild(row);
      });

      function convert(text) {
        converters.forEach(function (c) {
          document.getElementById('tcase-out-' + c.id).value = text ? c.fn(text) : '';
        });
      }

      inputEl.addEventListener('input', function () {
        invalidateCopy();
        convert(inputEl.value);
      });
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var widget = document.querySelector('.tool-widget');
        if (widget && document.activeElement && widget.contains(document.activeElement)) invalidateCopy();
      });
    })();
  </script>
</div>

<style is:global>
  .tcase-wrap { display: flex; flex-direction: column; gap: 1rem; }

  .tcase-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tcase-row label {
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 760;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .tcase-row textarea {
    width: 100%;
    min-height: 160px;
    font-family: var(--font-sans);
    font-size: 1rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    resize: vertical;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    line-height: 1.6;
  }

  .tcase-row textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    background: var(--color-surface);
    box-shadow: 0 0 0 4px var(--color-primary-light);
  }

  .tcase-cases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
    gap: 0.8rem;
  }

  .tcase-output-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.65rem;
    align-items: start;
    min-height: 112px;
    border-radius: var(--radius-md);
    background: var(--color-bg-secondary);
    padding: 0.85rem;
    box-shadow: inset 0 0 0 1px var(--color-border-soft);
  }

  .tcase-case-label {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    overflow: hidden;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 760;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tcase-case-output {
    grid-column: 1 / -1;
    grid-row: 2;
    width: 100%;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    min-width: 0;
  }

  .tcase-output-row .btn-copy {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    align-self: center;
    min-width: 72px;
  }

  @media (max-width: 500px) {
    .tcase-cases {
      grid-template-columns: 1fr;
    }
  }
</style>
