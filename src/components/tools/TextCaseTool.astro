---
import Toggletip from '../Toggletip.astro';
interface Props { lang?: string; }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  "en": {
    "inputText": "Input Text",
    "inputPlaceholder": "Enter your text here...",
    "output": "Case variants",
    "empty": "Enter text to see all nine case variants.",
    "copy": "Copy",
    "copied": "Copied!",
    "copyFailed": "Copy failed",
    "tips": {
      "input": "All nine variants update as you type. Delete the input or press Ctrl/⌘+L while focus is inside the tool to clear the results.",
      "upper": "Uppercases letters with the browser’s default Unicode rules and keeps spaces and punctuation. For example, café becomes CAFÉ and ß becomes SS.",
      "lower": "Lowercases letters with the browser’s default Unicode rules and keeps spaces and punctuation. Language-specific casing rules are not applied.",
      "title": "hello WORLD becomes Hello World; userLoginCount becomes Userlogincount. Spaces and punctuation stay in place. Short words such as of and the are capitalized too.",
      "sentence": "Capitalizes the start of the whole input and lowercases the rest. Later sentences and proper nouns are not detected: first. SECOND becomes First. second.",
      "camel": "Splits words at case changes, letter–digit boundaries and separators, then joins them with a lowercase first word. Acronyms are recased: parseHTML becomes parseHtml.",
      "pascal": "Splits words, capitalizes each word and joins them without separators. Apostrophes are removed before splitting: don’t stop becomes DontStop. Accents are retained.",
      "kebab": "Joins split words in lowercase with hyphens. Accents stay: café au lait becomes café-au-lait. Letters and digits split: base64Encode becomes base-64-encode.",
      "snake": "Joins split words in lowercase with underscores. Spaces, punctuation and line breaks separate words, so a multi-line list becomes one identifier.",
      "constant": "Joins split words in uppercase with underscores. Uses default Unicode casing: Straße becomes STRASSE. Case changes and letter–digit boundaries also split words.",
      "copy": "Copy copies the full nonempty result in this row. If copying fails, select the result and copy it manually."
    }
  },
  "zh": {
    "inputText": "输入文本",
    "inputPlaceholder": "在此输入文本...",
    "output": "大小写结果",
    "empty": "输入文本后显示九种格式的结果。",
    "copy": "复制",
    "copied": "已复制！",
    "copyFailed": "复制失败",
    "tips": {
      "input": "九种格式随输入同步更新。删除输入，或在工具内聚焦时按 Ctrl/⌘+L，即可清空结果。",
      "upper": "按浏览器默认 Unicode 规则将字母变为大写，保留空格与标点。例如 café 变成 CAFÉ，ß 变成 SS。",
      "lower": "按浏览器默认 Unicode 规则将字母变为小写，保留空格与标点。不按特定语言的大小写规则处理。",
      "title": "hello WORLD 变成 Hello World；userLoginCount 变成 Userlogincount。保留空格与标点，of、the 等短词也会首字母大写。",
      "sentence": "只将整段输入的开头变为大写，其余变为小写，不识别后续句子或专有名词：first. SECOND 变成 First. second。",
      "camel": "按大小写变化、字母与数字边界及分隔符拆词，首词小写后连接。缩写会重新调整大小写：parseHTML 变成 parseHtml。",
      "pascal": "拆词后将每词首字母大写并直接连接。拆词前删除撇号：don’t stop 变成 DontStop。重音保留。",
      "kebab": "将拆出的词小写后用短横线连接。重音保留：café au lait 变成 café-au-lait。字母与数字会拆开：base64Encode 变成 base-64-encode。",
      "snake": "将拆出的词小写后用下划线连接。空格、标点和换行都用于拆词，因此多行列表会合成一个标识符。",
      "constant": "将拆出的词大写后用下划线连接。使用默认 Unicode 大小写规则：Straße 变成 STRASSE。大小写变化及字母与数字边界也会拆词。",
      "copy": "复制按钮复制本行完整的非空结果。复制失败时，可选中结果手动复制。"
    }
  },
  "ja": {
    "inputText": "入力テキスト",
    "inputPlaceholder": "テキストを入力してください...",
    "output": "ケース変換結果",
    "empty": "テキストを入力すると9形式の結果が表示されます。",
    "copy": "コピー",
    "copied": "コピー済み！",
    "copyFailed": "コピーに失敗",
    "tips": {
      "input": "入力と同時に9形式の結果が更新されます。入力を削除するか、ツール内にフォーカスがある状態で Ctrl/⌘+L を押すと結果を消去できます。",
      "upper": "ブラウザ既定の Unicode 規則で大文字に変換し、スペースと句読点を保ちます。café は CAFÉ、ß は SS になります。",
      "lower": "ブラウザ既定の Unicode 規則で小文字に変換し、スペースと句読点を保ちます。言語固有の大小文字規則は使いません。",
      "title": "hello WORLD は Hello World、userLoginCount は Userlogincount になります。スペースと句読点を保ち、of や the などの短い語も先頭を大文字にします。",
      "sentence": "入力全体の先頭を大文字にし、残りを小文字にします。後続の文や固有名詞は判別しません。first. SECOND は First. second になります。",
      "camel": "大小文字の変化、文字と数字の境界、区切りで単語を分け、最初の語を小文字にして連結します。略語も変換され、parseHTML は parseHtml になります。",
      "pascal": "分割した各単語の先頭を大文字にして区切りなしで連結します。分割前にアポストロフィを除去するため、don’t stop は DontStop になります。アクセントは保ちます。",
      "kebab": "分割した単語を小文字にしてハイフンで連結します。café au lait は café-au-lait となり、アクセントを保ちます。文字と数字を分けるため、base64Encode は base-64-encode になります。",
      "snake": "分割した単語を小文字にしてアンダースコアで連結します。スペース、句読点、改行も区切りとなるため、複数行のリストは1つの識別子になります。",
      "constant": "分割した単語を大文字にしてアンダースコアで連結します。既定の Unicode 規則により Straße は STRASSE になります。大小文字の変化と文字・数字の境界でも分割します。",
      "copy": "コピーは、この行の空でない結果を全文コピーします。失敗した場合は結果を選択して手動でコピーしてください。"
    }
  },
  "ko": {
    "inputText": "입력 텍스트",
    "inputPlaceholder": "텍스트를 입력하세요...",
    "output": "케이스 변환 결과",
    "empty": "텍스트를 입력하면 9가지 형식의 결과가 표시됩니다.",
    "copy": "복사",
    "copied": "복사됨!",
    "copyFailed": "복사 실패",
    "tips": {
      "input": "입력과 동시에 9가지 형식이 갱신됩니다. 입력을 지우거나 도구 안에 포커스가 있을 때 Ctrl/⌘+L을 누르면 결과가 지워집니다.",
      "upper": "브라우저 기본 Unicode 규칙으로 대문자로 바꾸고 공백과 문장 부호를 유지합니다. café는 CAFÉ, ß는 SS가 됩니다.",
      "lower": "브라우저 기본 Unicode 규칙으로 소문자로 바꾸고 공백과 문장 부호를 유지합니다. 언어별 대소문자 규칙은 적용하지 않습니다.",
      "title": "hello WORLD는 Hello World, userLoginCount는 Userlogincount가 됩니다. 공백과 문장 부호를 유지하며 of, the 같은 짧은 단어도 첫 글자를 대문자로 바꿉니다.",
      "sentence": "입력 전체의 첫 부분을 대문자로 바꾸고 나머지는 소문자로 바꿉니다. 뒤의 문장이나 고유 명사는 인식하지 않습니다. first. SECOND는 First. second가 됩니다.",
      "camel": "대소문자 변화, 문자와 숫자의 경계, 구분자에서 단어를 나누고 첫 단어를 소문자로 하여 연결합니다. 약어도 바뀌므로 parseHTML은 parseHtml이 됩니다.",
      "pascal": "나눈 각 단어의 첫 글자를 대문자로 바꾸고 구분자 없이 연결합니다. 나누기 전에 아포스트로피를 제거하므로 don’t stop은 DontStop이 됩니다. 악센트는 유지합니다.",
      "kebab": "나눈 단어를 소문자로 바꾸고 하이픈으로 연결합니다. café au lait는 café-au-lait가 되어 악센트가 유지됩니다. 문자와 숫자는 분리되어 base64Encode는 base-64-encode가 됩니다.",
      "snake": "나눈 단어를 소문자로 바꾸고 밑줄로 연결합니다. 공백, 문장 부호, 줄바꿈도 구분자이므로 여러 줄의 목록이 하나의 식별자가 됩니다.",
      "constant": "나눈 단어를 대문자로 바꾸고 밑줄로 연결합니다. 기본 Unicode 규칙으로 Straße는 STRASSE가 됩니다. 대소문자 변화와 문자·숫자 경계에서도 단어를 나눕니다.",
      "copy": "복사는 이 행의 비어 있지 않은 결과 전체를 복사합니다. 실패하면 결과를 선택하여 직접 복사하세요."
    }
  }
} as const;
const FORMATS = [
  {
    "id": "upper",
    "label": "UPPER CASE"
  },
  {
    "id": "lower",
    "label": "lower case"
  },
  {
    "id": "title",
    "label": "Title Case"
  },
  {
    "id": "sentence",
    "label": "Sentence case"
  },
  {
    "id": "camel",
    "label": "camelCase"
  },
  {
    "id": "pascal",
    "label": "PascalCase"
  },
  {
    "id": "kebab",
    "label": "kebab-case"
  },
  {
    "id": "snake",
    "label": "snake_case"
  },
  {
    "id": "constant",
    "label": "CONSTANT_CASE"
  }
] as const;
const T = STRINGS[lang as keyof typeof STRINGS] || STRINGS.en;
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="tcase-wrap">
  <div class="tcase-panels zt-io">
    <div class="tcase-row zt-io-pane">
      <div class="tcase-head">
        <label for="tcase-input">{T.inputText}</label>
        <Toggletip id="tcase-tip-input" lang={lang} about={T.inputText}>{TIPS.input}</Toggletip>
      </div>
      <textarea id="tcase-input" class="tool-textarea tcase-input zt-io-fill" placeholder={T.inputPlaceholder} rows="4" spellcheck="false"></textarea>
    </div>
    <div class="tcase-results zt-io-pane" id="tcase-results" data-empty="true">
      <div class="tcase-head"><span>{T.output}</span></div>
      <div class="tcase-empty zt-io-fill">{T.empty}</div>
      <div class="tcase-cases zt-io-fill" id="tcase-cases">
        {FORMATS.map(({ id, label }) => (
          <div class="tcase-output-row" id={`tcase-row-${id}`}>
            <div class="tcase-case-heading">
              <label class="tcase-case-label" for={`tcase-out-${id}`}>{label}</label>
              <Toggletip id={`tcase-tip-${id}`} lang={lang} about={label}><p>{TIPS[id]}</p><p>{TIPS.copy}</p></Toggletip>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var inputEl = document.getElementById('tcase-input');
      var resultsEl = document.getElementById('tcase-results');
      var copyStates = [];

      /* ── engine:start ── */
      // Word splitting follows change-case v5 split() with separateNumbers: break at
      // lower→Upper, at ACRONYM→Word (XMLHttp → XML Http), at letter↔digit, and at any run
      // of characters that are not letters, marks or digits. Apostrophes are removed first,
      // as lodash words() does, so "don't" stays one word. Letters keep their accents.
      function splitWords(s) {
        return s
          .replace(/['\u2019]/g, '')
          .replace(/([\p{Ll}\p{N}]\p{M}*)(\p{Lu})/gu, '$1\0$2')
          .replace(/(\p{Lu}\p{M}*)(\p{Lu}\p{M}*\p{Ll})/gu, '$1\0$2')
          .replace(/(\p{L}\p{M}*)(\p{N})/gu, '$1\0$2')
          .replace(/(\p{N})(\p{L})/gu, '$1\0$2')
          .replace(/[^\p{L}\p{M}\p{N}]+/gu, '\0')
          .split('\0')
          .filter(function (w) { return w !== ''; });
      }

      function capitalize(w) {
        var first = String.fromCodePoint(w.codePointAt(0));
        return first.toUpperCase() + w.slice(first.length).toLowerCase();
      }

      var converters = [
        {
          id: 'upper',
          label: 'UPPER CASE',
          fn: function (s) { return s.toUpperCase(); },
        },
        {
          id: 'lower',
          label: 'lower case',
          fn: function (s) { return s.toLowerCase(); },
        },
        {
          id: 'title',
          label: 'Title Case',
          fn: function (s) {
            return s.replace(/[\p{L}\p{N}]\S*/gu, capitalize);
          },
        },
        {
          id: 'sentence',
          label: 'Sentence case',
          fn: function (s) {
            return s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();
          },
        },
        {
          id: 'camel',
          label: 'camelCase',
          fn: function (s) {
            return splitWords(s).map(function (w, i) {
              return i === 0 ? w.toLowerCase() : capitalize(w);
            }).join('');
          },
        },
        {
          id: 'pascal',
          label: 'PascalCase',
          fn: function (s) {
            return splitWords(s).map(capitalize).join('');
          },
        },
        {
          id: 'kebab',
          label: 'kebab-case',
          fn: function (s) {
            return splitWords(s).join('-').toLowerCase();
          },
        },
        {
          id: 'snake',
          label: 'snake_case',
          fn: function (s) {
            return splitWords(s).join('_').toLowerCase();
          },
        },
        {
          id: 'constant',
          label: 'CONSTANT_CASE',
          fn: function (s) {
            return splitWords(s).join('_').toUpperCase();
          },
        },
      ];
      /* ── engine:end ── */

      function invalidateCopy() {
        copyStates.forEach(function (state) {
          state.revision++;
          clearTimeout(state.timer);
          state.button.textContent = t.copy;
        });
      }

      // Build output rows
      converters.forEach(function (c) {
        var row = document.getElementById('tcase-row-' + c.id);

        var out = document.createElement('input');
        out.type = 'text';
        out.id = 'tcase-out-' + c.id;
        out.readOnly = true;
        out.className = 'tcase-case-output';
        out.placeholder = c.fn('hello world');

        var btn = document.createElement('button');
        btn.className = 'btn-copy';
        btn.textContent = t.copy;
        var copyState = { button: btn, revision: 0, timer: 0 };
        copyStates.push(copyState);
        btn.addEventListener('click', function () {
          if (!out.value) return;
          var revision = ++copyState.revision;
          clearTimeout(copyState.timer);
          btn.textContent = t.copy;
          function failed() {
            if (revision === copyState.revision) btn.textContent = t.copyFailed;
          }
          try {
            navigator.clipboard.writeText(out.value).then(function () {
              if (revision !== copyState.revision) return;
              btn.textContent = t.copied;
              copyState.timer = setTimeout(function () {
                if (revision === copyState.revision) btn.textContent = t.copy;
              }, 1500);
            }, failed);
          } catch (e) { failed(); }
          window.trackTool && window.trackTool('text_case', 'copy_' + c.id);
        });

        row.appendChild(out);
        row.appendChild(btn);
      });

      function convert(text) {
        resultsEl.setAttribute('data-empty', String(!text));
        converters.forEach(function (c) {
          document.getElementById('tcase-out-' + c.id).value = text ? c.fn(text) : '';
        });
      }

      inputEl.addEventListener('input', function () {
        invalidateCopy();
        convert(inputEl.value);
      });
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var widget = document.querySelector('.tool-widget');
        if (widget && document.activeElement && widget.contains(document.activeElement)) {
          invalidateCopy();
          resultsEl.setAttribute('data-empty', 'true');
        }
      });
    })();
  </script>
</div>

<style is:global>
  .tcase-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .tcase-wrap [hidden] { display: none !important; }
  .tcase-wrap .tcase-panels { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
  .tcase-head { display: flex; align-items: center; gap: 0.4rem; min-height: 32px; font-size: 0.85rem; font-weight: 600; }
  .tcase-input { width: 100%; overflow: auto; font-family: var(--font-sans); font-size: 1rem; line-height: 1.6; }
  .tcase-empty { display: flex; align-items: center; justify-content: center; padding: 1rem; color: var(--color-text-secondary); text-align: center; }
  .tcase-results[data-empty="false"] .tcase-empty, .tcase-results[data-empty="true"] .tcase-cases { display: none; }
  .tcase-cases { overflow: auto; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .tcase-output-row { display: grid; grid-template-columns: minmax(0, 1fr) 7.5rem; gap: 0.4rem 0.6rem; align-items: center; min-width: 0; padding: 0.65rem; border-bottom: 1px solid var(--color-border-soft); }
  .tcase-output-row:last-child { border-bottom: 0; }
  .tcase-case-heading { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
  .tcase-case-label { min-width: 0; overflow-wrap: anywhere; color: var(--color-primary); font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; line-height: 1.3; }
  .tcase-case-output { grid-column: 1 / -1; grid-row: 2; width: 100%; min-width: 0; min-height: 44px; padding: 0.5rem 0.65rem; font-family: var(--font-mono); font-size: 0.85rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-secondary); color: var(--color-text); }
  .tcase-case-output:focus { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .tcase-output-row .btn-copy { grid-column: 2; grid-row: 1; width: 7.5rem; min-width: 0; justify-self: end; white-space: nowrap; }
  @media (max-width: 860px) {
    .tcase-wrap .tcase-panels { grid-template-columns: minmax(0, 1fr); }
    .tcase-results[data-empty="true"] { display: none; }
    .tcase-input { height: 160px; }
    .tcase-cases { height: 400px; resize: none; }
  }
  @media (max-width: 640px) {
    .tcase-head { min-height: 28px; }
    .tcase-input { height: 120px; }
    .tcase-cases { height: 360px; }
    .tcase-output-row { padding: 0.5rem; gap: 0.35rem 0.5rem; }
    .tcase-output-row .btn-copy { min-height: 44px; padding-inline: 0.35rem; font-size: 0.78rem; }
  }
</style>
