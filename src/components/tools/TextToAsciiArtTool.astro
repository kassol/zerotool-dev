const { tips: TIPS, ...CLIENT_T } = T;
const L = { ...CLIENT_T, lang };
---
<div class="taa-wrap">
  <div class="taa-body">
    <div class="taa-rail zt-rail">
      <div class="taa-field taa-text-field">
        <div class="taa-label-row"><label class="tool-label" for="taa-input">{T.labelText}</label><Toggletip id="taa-tip-input" lang={lang} about={T.labelText}>{TIPS.input}</Toggletip></div>
        <textarea id="taa-input" class="tool-textarea taa-input" rows="2" spellcheck="false" autocomplete="off">{T.defaultText}</textarea>
      </div>
      <div class="taa-field">
        <div class="taa-label-row"><label class="tool-label" for="taa-font">{T.labelFont}</label><Toggletip id="taa-tip-font" lang={lang} about={T.labelFont} wide>{TIPS.font}</Toggletip></div>
        <select id="taa-font" class="tool-input taa-select">{FONT_NAMES.map((f) => <option value={f}>{f}</option>)}</select>
        <button id="taa-preview-all" class="btn-ghost" type="button" aria-expanded="false" aria-controls="taa-gallery">{T.previewAll}</button>
      </div>
      <div class="taa-field">
        <div class="taa-label-row"><span class="tool-label">{T.exportLabel}</span><Toggletip id="taa-tip-export" lang={lang} about={T.exportLabel} wide>{TIPS.export}</Toggletip></div>
        <div class="taa-actions">
          <button id="taa-copy" class="btn-copy" type="button" disabled>{T.copy}</button>
          <button id="taa-download-txt" class="btn-secondary" type="button" disabled>{T.downloadTxt}</button>
          <button id="taa-download-png" class="btn-secondary" type="button" disabled>{T.downloadPng}</button>
        </div>
      </div>
      <div id="taa-status" class="tool-status taa-status" role="status" aria-live="polite"></div>
      <details class="taa-details">
        <summary>{T.moreOptions}</summary>
        <div class="taa-options">
          <div class="taa-field">
            <div class="taa-label-row"><label class="tool-label" for="taa-layout">{T.labelLayout}</label><Toggletip id="taa-tip-layout" lang={lang} about={T.labelLayout}>{TIPS.layout}</Toggletip></div>
            <select id="taa-layout" class="tool-input taa-select">{Object.entries(T.layouts).map(([v, label]) => <option value={v}>{label}</option>)}</select>
          </div>
          <div class="taa-field">
            <div class="taa-label-row"><label class="tool-label" for="taa-width">{T.labelWidth}</label><Toggletip id="taa-tip-width" lang={lang} about={T.labelWidth}>{TIPS.width}</Toggletip></div>
            <select id="taa-width" class="tool-input taa-select">{WIDTHS.map((w) => <option value={String(w)}>{w ? T.widthCols.replace('{n}', String(w)) : T.widthNone}</option>)}</select>
          </div>
          <div class="taa-field taa-wide">
            <div class="taa-label-row"><label class="tool-label" for="taa-format">{T.copyAs}</label><Toggletip id="taa-tip-format" lang={lang} about={T.copyAs}>{TIPS.format}</Toggletip></div>
            <select id="taa-format" class="tool-input taa-format">{Object.entries(T.formats).map(([v, label]) => <option value={v}>{label}</option>)}</select>
          </div>
          <div class="taa-label-row taa-wide"><label class="taa-check"><input id="taa-trim" type="checkbox" checked /> {T.trim}</label><Toggletip id="taa-tip-trim" lang={lang} about={T.trim}>{TIPS.trim}</Toggletip></div>
        </div>
      </details>
      <details class="taa-details">
        <summary>{T.commandDetails}</summary>
        <div id="taa-command" class="taa-command" hidden>
          <div class="taa-label-row"><p class="taa-command-label">{T.commandLabel}</p><Toggletip id="taa-tip-command" lang={lang} about={T.commandDetails}>{TIPS.command}</Toggletip></div>
          <div class="taa-command-row">
            <code id="taa-command-text" class="taa-command-text"></code>
            <button id="taa-copy-command" class="btn-copy" type="button">{T.copyCommand}</button>
          </div>
          <p id="taa-command-file" class="taa-command-file" hidden>{T.commandFile} <a id="taa-command-file-link" href="#" download></a></p>
        </div>
      </details>
    </div>
    <div class="taa-preview">
      <div class="taa-output-box" id="taa-output-box">
        <div class="taa-output-header"><span class="taa-output-label">{T.outputLabel} <span id="taa-size" class="taa-size"></span></span></div>
        <pre id="taa-output" class="taa-output" tabindex="0" aria-live="polite" data-empty={T.previewEmpty}></pre>
        <p id="taa-skipped" class="taa-note" role="status" hidden></p>
      </div>
      <div id="taa-gallery" class="taa-gallery" hidden></div>
    </div>
  </div>

  <script is:inline define:vars={{ S: L, FONT_NAMES }}>
  (function () {
    /* ── engine:start ── */
    // FIGlet renderer ported from figlet 2.2.5 (figlet.c: readfont, readfontchar, smushem,
    // smushamt, addchar, putstring, splitline and the word-break loop in main), so the output
    // matches the `figlet` command character for character. figlet.c is BSD-3-Clause,
    // Copyright (C) 1991-2012 Glenn Chappell, Ian Chai, John Cowan, Christiaan Keet and
    // Claudio Matsuoka. Left-to-right fonts only; input is read as Unicode code points, as
    // `figlet -C utf8` does.
    var SM_EQUAL = 1, SM_LOWLINE = 2, SM_HIERARCHY = 4, SM_PAIR = 8, SM_BIGX = 16;
    var SM_HARDBLANK = 32, SM_KERN = 64, SM_SMUSH = 128;
    var DEUTSCH = [196, 214, 220, 228, 246, 252, 223];
    var MAX_INPUT = 2000;

    // C sscanf "%li" (strtol base 0): optional sign, 0x hex, leading 0 octal, else decimal.
    function scanLong(s) {
      var m = /^[ \t\n\v\f\r]*([+-]?)(0[xX][0-9a-fA-F]+|0[0-7]*|[1-9][0-9]*)/.exec(s);
      if (!m) return null;
      var body = m[2], v;
      if (/^0[xX]/.test(body)) v = parseInt(body.slice(2), 16);
      else if (body.length > 1 && body[0] === '0') v = parseInt(body.slice(1), 8);
      else v = parseInt(body, 10);
      return m[1] === '-' ? -v : v;
    }

    function parseFont(data) {
      // myfgets() returns NULL for a last line without a line terminator, so drop it.
      var lines = String(data).split(/\r\n|\r|\n/);
      lines.pop();
      var pos = 0;
      function next() { return pos < lines.length ? lines[pos++] : null; }
      var first = next();
      if (first === null || first.slice(0, 4) !== 'flf2') throw new Error('not-flf');
      var rest = first.slice(4);
      var hardblank = rest.charAt(1);
      var ints = [], tail = rest.slice(2), m;
      while ((m = /^[ \t\n\v\f\r]*([+-]?[0-9]+)/.exec(tail))) { ints.push(parseInt(m[1], 10)); tail = tail.slice(m[0].length); }
      var numsread = rest.length >= 2 ? 1 + (ints.length >= 1 ? 1 : 0) + Math.max(0, Math.min(ints.length, 7) - 2) : 0;
      if (numsread < 5) throw new Error('not-flf');
      var height = Math.max(1, ints[0]);
      var smush = ints[3], cmtlines = ints[4];
      var direction = ints.length >= 6 ? ints[5] : 0;
      var smush2;
      if (ints.length >= 7) smush2 = ints[6];
      else if (smush === 0) smush2 = SM_KERN;
      else if (smush < 0) smush2 = 0;
      else smush2 = (smush & 31) | SM_SMUSH;
      for (var i = 0; i < cmtlines; i++) next();
      var chars = new Map();
      var empty = [];
      for (var r = 0; r < height; r++) empty.push('');
      chars.set(0, empty);
      function readChar() {
        var rows = [];
        for (var row = 0; row < height; row++) {
          var line = next();
          if (line === null) line = '';
          var k = line.length - 1;
          while (k >= 0 && /[ \t\n\v\f\r]/.test(line[k])) k--;
          if (k >= 0) {
            var endchar = line[k];
            while (k >= 0 && line[k] === endchar) k--;
          }
          rows.push(line.slice(0, k + 1));
        }
        return rows;
      }
      for (var ord = 32; ord <= 126; ord++) chars.set(ord, readChar());
      for (var d = 0; d < DEUTSCH.length; d++) chars.set(DEUTSCH[d], readChar());
      for (;;) {
        var tag = next();
        if (tag === null) break;
        var code = scanLong(tag);
        if (code === null) break;
        chars.set(code, readChar());
      }
      return { hardblank: hardblank, height: height, smush2: smush2, direction: direction, chars: chars };
    }

    // Horizontal layout → figlet option: default (font), full (-W), fitted (-k),
    // smush (-S: font rules, forced on) and overlap (-o: universal overlapping).
    function smushModeFor(font, layout) {
      if (layout === 'full') return 0;
      if (layout === 'fitted') return SM_KERN;
      if (layout === 'smush') return SM_SMUSH | font.smush2;
      if (layout === 'overlap') return SM_SMUSH;
      return font.smush2;
    }

    // C figlet's input filter: tab → space, \n \v \f \r → line break, other C0 controls and
    // DEL are dropped.
    function inputCodes(text) {
      var out = [];
      for (var ch of String(text)) {
        var c = ch.codePointAt(0);
        if (c === 9 || c === 32) c = 32;
        else if (c >= 10 && c <= 13) c = 10;
        if ((c > 0 && c < 32 && c !== 10) || c === 127) continue;
        out.push(c);
      }
      return out;
    }

    // width: figlet -w (0 = no limit). Returns the output lines without the trailing newline.
    function renderFiglet(font, text, options) {
      options = options || {};
      var smushmode = smushModeFor(font, options.layout || 'default');
      var outputwidth = options.width > 0 ? Math.floor(options.width) : Infinity;
      var outlinelenlimit = outputwidth - 1;
      var inchrlinelenlimit = outputwidth * 4 + 100;
      var hardblank = font.hardblank, charheight = font.height, chars = font.chars;
      var outputline = [], outlinelen = 0, inchrline = [];
      var currchar = null, currcharwidth = 0, previouscharwidth = 0;
      var result = [];

      function at(s, i) { return i < s.length ? s[i] : '\0'; }
      function clearline() {
        outputline = [];
        for (var i = 0; i < charheight; i++) outputline.push('');
        outlinelen = 0;
        inchrline = [];
      }
      function getletter(c) {
        currchar = chars.has(c) ? chars.get(c) : chars.get(0);
        previouscharwidth = currcharwidth;
        currcharwidth = currchar[0].length;
      }
      function smushem(lch, rch) {
        if (lch === ' ') return rch;
        if (rch === ' ') return lch;
        if (previouscharwidth < 2 || currcharwidth < 2) return '\0';
        if ((smushmode & SM_SMUSH) === 0) return '\0';
        if ((smushmode & 63) === 0) {
          if (lch === hardblank) return rch;
          if (rch === hardblank) return lch;
          return rch;
        }
        if (smushmode & SM_HARDBLANK) {
          if (lch === hardblank && rch === hardblank) return lch;
        }
        if (lch === hardblank || rch === hardblank) return '\0';
        if (smushmode & SM_EQUAL) {
          if (lch === rch) return lch;
        }
        if (smushmode & SM_LOWLINE) {
          if (lch === '_' && '|/\\[]{}()<>'.indexOf(rch) >= 0) return rch;
          if (rch === '_' && '|/\\[]{}()<>'.indexOf(lch) >= 0) return lch;
        }
        if (smushmode & SM_HIERARCHY) {
          if (lch === '|' && '/\\[]{}()<>'.indexOf(rch) >= 0) return rch;
          if (rch === '|' && '/\\[]{}()<>'.indexOf(lch) >= 0) return lch;
          if ('/\\'.indexOf(lch) >= 0 && '[]{}()<>'.indexOf(rch) >= 0) return rch;
          if ('/\\'.indexOf(rch) >= 0 && '[]{}()<>'.indexOf(lch) >= 0) return lch;
          if ('[]'.indexOf(lch) >= 0 && '{}()<>'.indexOf(rch) >= 0) return rch;
          if ('[]'.indexOf(rch) >= 0 && '{}()<>'.indexOf(lch) >= 0) return lch;
          if ('{}'.indexOf(lch) >= 0 && '()<>'.indexOf(rch) >= 0) return rch;
          if ('{}'.indexOf(rch) >= 0 && '()<>'.indexOf(lch) >= 0) return lch;
          if ('()'.indexOf(lch) >= 0 && '<>'.indexOf(rch) >= 0) return rch;
          if ('()'.indexOf(rch) >= 0 && '<>'.indexOf(lch) >= 0) return lch;
        }
        if (smushmode & SM_PAIR) {
          if (lch === '[' && rch === ']') return '|';
          if (rch === '[' && lch === ']') return '|';
          if (lch === '{' && rch === '}') return '|';
          if (rch === '{' && lch === '}') return '|';
          if (lch === '(' && rch === ')') return '|';
          if (rch === '(' && lch === ')') return '|';
        }
        if (smushmode & SM_BIGX) {
          if (lch === '/' && rch === '\\') return '|';
          if (rch === '/' && lch === '\\') return 'Y';
          if (lch === '>' && rch === '<') return 'X';
        }
        return '\0';
      }
      function smushamt() {
        if ((smushmode & (SM_SMUSH | SM_KERN)) === 0) return 0;
        var maxsmush = currcharwidth;
        for (var row = 0; row < charheight; row++) {
          var line = outputline[row], cur = currchar[row];
          var linebd = line.length, ch1 = at(line, linebd);
          while (linebd > 0 && (ch1 === '\0' || ch1 === ' ')) { linebd--; ch1 = at(line, linebd); }
          var charbd = 0, ch2 = at(cur, 0);
          while (ch2 === ' ') { charbd++; ch2 = at(cur, charbd); }
          var amt = charbd + outlinelen - 1 - linebd;
          if (ch1 === '\0' || ch1 === ' ') amt++;
          else if (ch2 !== '\0') { if (smushem(ch1, ch2) !== '\0') amt++; }
          if (amt < maxsmush) maxsmush = amt;
        }
        return maxsmush;
      }
      function addchar(c) {
        getletter(c);
        var smushamount = smushamt();
        if (outlinelen + currcharwidth - smushamount > outlinelenlimit || inchrline.length + 1 > inchrlinelenlimit) return false;
        for (var row = 0; row < charheight; row++) {
          var line = outputline[row], cur = currchar[row];
          for (var k = 0; k < smushamount; k++) {
            var column = outlinelen - smushamount + k;
            if (column < 0) column = 0;
            // C writes into a NUL-terminated buffer: a '\0' result ends the string there.
            if (column < line.length) {
              var s = smushem(line[column], at(cur, k));
              line = s === '\0' ? line.slice(0, column) : line.slice(0, column) + s + line.slice(column + 1);
            }
          }
          outputline[row] = line + cur.slice(smushamount);
        }
        outlinelen = outputline[0].length;
        inchrline.push(c);
        return true;
      }
      function putstring(s) {
        var len = s.length;
        if (outputwidth > 1 && len > outputwidth - 1) len = outputwidth - 1;
        var out = '';
        for (var i = 0; i < len; i++) out += s[i] === hardblank ? ' ' : s[i];
        result.push(out);
      }
      function printline() {
        for (var i = 0; i < charheight; i++) putstring(outputline[i]);
        clearline();
      }
      function splitline() {
        var i, gotspace = false, lastspace = inchrline.length - 1;
        for (i = inchrline.length - 1; i >= 0; i--) {
          if (!gotspace && inchrline[i] === 32) { gotspace = true; lastspace = i; }
          if (gotspace && inchrline[i] !== 32) break;
        }
        var part1 = inchrline.slice(0, i + 1);
        var part2 = inchrline.slice(lastspace + 1);
        clearline();
        for (i = 0; i < part1.length; i++) addchar(part1[i]);
        printline();
        for (i = 0; i < part2.length; i++) addchar(part2[i]);
      }

      clearline();
      var wordbreakmode = 0;
      var codes = inputCodes(text);
      for (var n = 0; n < codes.length; n++) {
        var c = codes[n], notAdded;
        do {
          notAdded = false;
          if (wordbreakmode === -1) {
            if (c === 32) break;
            if (c === 10) { wordbreakmode = 0; break; }
            wordbreakmode = 0;
          }
          if (c === 10) {
            printline();
            wordbreakmode = 0;
          } else if (addchar(c)) {
            if (c !== 32) wordbreakmode = wordbreakmode >= 2 ? 3 : 1;
            else wordbreakmode = wordbreakmode > 0 ? 2 : 0;
          } else if (outlinelen === 0) {
            for (var i2 = 0; i2 < charheight; i2++) putstring(currchar[i2]);
            wordbreakmode = -1;
          } else if (c === 32) {
            if (wordbreakmode === 2) splitline(); else printline();
            wordbreakmode = -1;
          } else {
            if (wordbreakmode >= 2) splitline(); else printline();
            wordbreakmode = wordbreakmode === 3 ? 1 : 0;
            notAdded = true;
          }
        } while (notAdded);
      }
      if (outlinelen !== 0) printline();
      return result;
    }

    // Characters that draw nothing: not in the font (figlet inserts an empty glyph), a glyph
    // whose rows are all empty (3D-ASCII has these for ( ) { } _ and others), or a control
    // character that figlet drops. Each code point once, in input order. Tab (a space) and
    // line breaks are not listed.
    function unsupportedChars(text, font) {
      var out = [];
      for (var ch of String(text)) {
        var c = ch.codePointAt(0);
        if (c === 9 || (c >= 10 && c <= 13)) continue;
        var dropped = (c > 0 && c < 32) || c === 127;
        var rows = font.chars.has(c) ? font.chars.get(c) : null;
        var blank = !rows || rows.every(function (row) { return row === ''; });
        if ((dropped || blank) && out.indexOf(ch) === -1) out.push(ch);
      }
      return out;
    }

    // Whitespace, control and format characters are invisible, so write them as U+XXXX.
    function skippedMessage(template, fontName, chars) {
      var shown = chars.map(function (ch) {
        if (!/^[\s\p{C}]$/u.test(ch)) return ch;
        return 'U+' + ch.codePointAt(0).toString(16).toUpperCase().padStart(4, '0');
      });
      return template.replace('{font}', fontName).replace('{chars}', shown.join(' '));
    }

    function fill(template, values) {
      return template.replace(/\{(\w+)\}/g, function (m, k) {
        return Object.prototype.hasOwnProperty.call(values, k) ? String(values[k]) : m;
      });
    }

    // trim: drop trailing spaces on each line and blank lines at the start and end.
    function formatOutput(lines, format, trim) {
      var ls = lines.slice();
      if (trim) {
        ls = ls.map(function (l) { return l.replace(/ +$/, ''); });
        while (ls.length && ls[ls.length - 1] === '') ls.pop();
        while (ls.length && ls[0] === '') ls.shift();
      }
      var body = ls.join('\n');
      if (format === 'markdown') {
        var run = 0;
        (body.match(/`+/g) || []).forEach(function (r) { if (r.length > run) run = r.length; });
        var fence = '`'.repeat(Math.max(3, run + 1));
        return fence + '\n' + body + '\n' + fence;
      }
      if (format === 'hash' || format === 'slash') {
        var mark = format === 'hash' ? '#' : '//';
        return ls.map(function (l) { return l === '' ? mark : mark + ' ' + l; }).join('\n');
      }
      if (format === 'heredoc') {
        var delim = 'EOF', n = 1;
        while (ls.indexOf(delim) >= 0) delim = 'EOF' + (++n);
        return "cat <<'" + delim + "'\n" + body + '\n' + delim;
      }
      return body;
    }

    // Fonts whose glyphs equal the files in the figlet 2.2.5 distribution (checked glyph by
    // glyph), except the code points listed. Shadow here is patorjk's 2007 revision with a
    // wider space; Doom and 3D-ASCII are not in the distribution.
    var DIST_FONTS = { Banner: 'banner', Big: 'big', Block: 'block', Lean: 'lean', Mini: 'mini', Script: 'script', Slant: 'slant', Small: 'small', Standard: 'standard' };
    var DIST_DIFFERS = { Standard: [0x0CA0] };

    function shellQuote(s) { return "'" + s.replace(/'/g, "'\\''") + "'"; }

    // The figlet command that prints the same lines. With no width limit, -w is large enough
    // for the widest line and for figlet's limit of 4 × width + 100 input characters per line.
    function figletCommand(fontName, layout, width, text, lines) {
      if (text === '') return null;
      var parts = ['figlet'];
      if (/[^\x00-\x7f]/.test(text)) parts.push('-C', 'utf8');
      var differs = (DIST_DIFFERS[fontName] || []).some(function (c) { return text.indexOf(String.fromCodePoint(c)) >= 0; });
      var useFile = !DIST_FONTS[fontName] || differs;
      parts.push('-f', useFile ? './' + fontName + '.flf' : DIST_FONTS[fontName]);
      var flag = { full: '-W', fitted: '-k', smush: '-S', overlap: '-o' }[layout];
      if (flag) parts.push(flag);
      var w = width;
      if (!(w > 0)) {
        var widest = 0, perLine = 0, count = 0;
        lines.forEach(function (l) { if (l.length > widest) widest = l.length; });
        inputCodes(text).forEach(function (c) {
          if (c === 10) count = 0; else if (++count > perLine) perLine = count;
        });
        w = Math.max(80, widest + 1, Math.ceil((perLine - 100) / 4));
      }
      if (w !== 80) parts.push('-w', String(w));
      if (text.charAt(0) === '-') parts.push('--');
      parts.push(shellQuote(text));
      return { command: parts.join(' '), fontFile: useFile ? fontName + '.flf' : null };
    }

    function downloadBase(text, fontName) {
      var base = String(text).normalize('NFKD').replace(/[^\x00-\x7f]/g, '').toLowerCase()
        .replace(/[^a-z0-9]+/g, '-').replace(/^-+/, '').slice(0, 40).replace(/-+$/, '');
      return (base || 'ascii-art') + '-' + fontName.toLowerCase();
    }

    // PNG: 14px monospace, 17px lines, 16px padding. 2x when it fits; canvas kept within
    // 16,384 px per side and 16,777,216 px in area (the iOS Safari limit).
    function imageLayout(cols, rows, charWidth) {
      var width = Math.ceil(cols * charWidth + 32), height = rows * 17 + 32;
      function fits(s) { return width * s <= 16384 && height * s <= 16384 && width * height * s * s <= 16777216; }
      if (fits(2)) return { width: width, height: height, scale: 2 };
      if (fits(1)) return { width: width, height: height, scale: 1 };
      return null;
    }
    /* ── engine:end ── */

    var input = document.getElementById('taa-input');
    var fontSel = document.getElementById('taa-font');
    var layoutSel = document.getElementById('taa-layout');
    var widthSel = document.getElementById('taa-width');
    var formatSel = document.getElementById('taa-format');
    var trimBox = document.getElementById('taa-trim');
    var outputEl = document.getElementById('taa-output');
    var outputBox = document.getElementById('taa-output-box');
    var sizeEl = document.getElementById('taa-size');
    var skippedEl = document.getElementById('taa-skipped');
    var statusEl = document.getElementById('taa-status');
    var copyBtn = document.getElementById('taa-copy');
    var txtBtn = document.getElementById('taa-download-txt');
    var pngBtn = document.getElementById('taa-download-png');
    var previewBtn = document.getElementById('taa-preview-all');
    var gallery = document.getElementById('taa-gallery');
    var commandBox = document.getElementById('taa-command');
    var commandText = document.getElementById('taa-command-text');
    var commandFile = document.getElementById('taa-command-file');
    var commandFileLink = document.getElementById('taa-command-file-link');
    var copyCommandBtn = document.getElementById('taa-copy-command');

    var fontCache = {};
    function loadFont(name) {
      if (!fontCache[name]) {
        var p = fetch('/figlet-fonts/' + encodeURIComponent(name) + '.flf').then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.text();
        }).then(parseFont);
        fontCache[name] = p;
        p.catch(function () { if (fontCache[name] === p) delete fontCache[name]; });
      }
      return fontCache[name];
    }

    function failReason(err) {
      var msg = err && err.message ? err.message : '';
      if (/^HTTP \d+$/.test(msg)) return msg;
      return msg === 'not-flf' ? S.badFont : S.networkError;
    }
    function count(pair, n) { return fill(pair[n === 1 ? 0 : 1], { n: n }); }
    function options() { return { layout: layoutSel.value, width: Number(widthSel.value) }; }

    function setStatus(msg, kind, retry) {
      statusEl.textContent = msg;
      statusEl.className = 'tool-status taa-status' + (kind ? ' ' + kind : '');
      if (retry) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'btn-copy taa-retry';
        b.textContent = S.retry;
        b.addEventListener('click', render);
        statusEl.appendChild(document.createTextNode(' '));
        statusEl.appendChild(b);
      }
    }

    var current = null; // { lines, text, font }
    function setOutput(state) {
      current = state;
      var has = !!(state && state.lines.length);
      var shown = has ? formatOutput(state.lines, 'plain', trimBox.checked) : '';
      outputEl.textContent = shown;
      var rows = shown ? shown.split('\n') : [];
      var cols = rows.reduce(function (m, l) { return Math.max(m, l.length); }, 0);
      sizeEl.textContent = rows.length ? '· ' + count(S.lines, rows.length) + ' × ' + count(S.cols, cols) : '';
      copyBtn.disabled = txtBtn.disabled = pngBtn.disabled = !has || !shown.trim();
      if (state && state.font) {
        var chars = unsupportedChars(state.text, state.font);
        skippedEl.hidden = chars.length === 0;
        skippedEl.textContent = chars.length ? skippedMessage(S.skipped, state.fontName, chars) : '';
      } else {
        skippedEl.hidden = true;
        skippedEl.textContent = '';
      }
      var cmd = has ? figletCommand(state.fontName, state.layout, state.width, state.text, state.lines) : null;
      commandBox.hidden = !cmd;
      if (cmd) {
        commandText.textContent = cmd.command;
        commandFile.hidden = !cmd.fontFile;
        if (cmd.fontFile) {
          commandFileLink.textContent = cmd.fontFile;
          commandFileLink.href = '/figlet-fonts/' + encodeURIComponent(cmd.fontFile);
        }
      }
    }

    var generation = 0;
    var galleryGeneration = 0;
    function render() {
      var my = ++generation;
      var text = input.value;
      var fontName = fontSel.value;
      var o = options();
      if (!text.trim()) { setOutput(null); setStatus(S.empty, 'none'); if (!gallery.hidden) renderGallery(); return; }
      var n = Array.from(text).length;
      if (n > MAX_INPUT) { setOutput(null); setStatus(fill(S.tooLong, { n: n, max: MAX_INPUT }), 'error'); return; }
      var timer = setTimeout(function () { if (my === generation) setStatus(fill(S.loading, { font: fontName }), 'none'); }, 150);
      loadFont(fontName).then(function (font) {
        clearTimeout(timer);
        if (my !== generation) return;
        setOutput({ lines: renderFiglet(font, text, o), text: text, font: font, fontName: fontName, layout: o.layout, width: o.width });
        setStatus('', '');
      }, function (err) {
        clearTimeout(timer);
        if (my !== generation) return;
        setOutput(null);
        setStatus(fill(S.loadError, { font: fontName, reason: failReason(err) }), 'error', true);
      });
      if (!gallery.hidden) renderGallery();
    }

    function renderGallery() {
      var my = ++galleryGeneration;
      var text = input.value, o = options();
      FONT_NAMES.forEach(function (name) {
        var card = gallery.querySelector('[data-font="' + name + '"]');
        var pre = card.querySelector('pre');
        var useBtn = card.querySelector('button');
        var isCurrent = name === fontSel.value;
        useBtn.textContent = isCurrent ? S.currentFont : fill(S.useFont, { font: name });
        useBtn.disabled = isCurrent;
        if (!text.trim() || Array.from(text).length > MAX_INPUT) { pre.textContent = ''; return; }
        loadFont(name).then(function (font) {
          if (my !== galleryGeneration) return;
          pre.textContent = formatOutput(renderFiglet(font, text, o), 'plain', trimBox.checked);
        }, function (err) {
          if (my !== galleryGeneration) return;
          pre.textContent = fill(S.loadError, { font: name, reason: failReason(err) });
        });
      });
    }
    function buildGallery() {
      FONT_NAMES.forEach(function (name) {
        var card = document.createElement('section');
        card.className = 'taa-card';
        card.setAttribute('data-font', name);
        var head = document.createElement('div');
        head.className = 'taa-card-head';
        var title = document.createElement('h3');
        title.className = 'taa-card-title';
        title.textContent = name;
        var use = document.createElement('button');
        use.type = 'button';
        use.className = 'btn-copy';
        use.addEventListener('click', function () {
          fontSel.value = name;
          render();
          trackGenerate();
          outputBox.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        });
        head.appendChild(title);
        head.appendChild(use);
        var pre = document.createElement('pre');
        pre.className = 'taa-card-pre';
        card.appendChild(head);
        card.appendChild(pre);
        gallery.appendChild(card);
      });
    }

    /* Analytics: one event per committed action (change events, Use, copy, download), none
       on load and none for input events while typing. */
    function track(action) { if (window.trackTool) window.trackTool('text_to_ascii_art', action); }
    function trackGenerate() { if (input.value.trim()) track('generate'); }

    var debounce = null;
    input.addEventListener('input', function () {
      clearTimeout(debounce);
      debounce = setTimeout(render, 120);
    });
    input.addEventListener('change', trackGenerate);
    [fontSel, layoutSel, widthSel].forEach(function (el) { el.addEventListener('change', function () { render(); trackGenerate(); }); });
    trimBox.addEventListener('change', function () { setOutput(current); if (!gallery.hidden) renderGallery(); trackGenerate(); });

    // The site-wide Ctrl/⌘+L clears the text box without an input event.
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L')) setTimeout(render, 0);
    });

    function flash(btn, label) {
      btn.textContent = S.copied;
      setTimeout(function () { btn.textContent = label; }, 1500);
    }
    // Clipboard API first; when it is missing or rejects, a hidden textarea and
    // execCommand('copy') (same as ColorPaletteGeneratorTool.astro); both failing shows copyFailed.
    function copyText(text, btn, label) {
      function fallback() {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.body.removeChild(ta);
        // select() moved focus to the textarea; give it back to the button (keyboard users).
        if (btn && btn.focus) btn.focus();
        return ok;
      }
      var done = navigator.clipboard && navigator.clipboard.writeText
        ? navigator.clipboard.writeText(text).then(function () { return true; }, function () { return fallback(); })
        : Promise.resolve(fallback());
      done.then(function (ok) {
        if (ok) { flash(btn, label); track('copy'); } else setStatus(S.copyFailed, 'error');
      });
    }
    copyBtn.addEventListener('click', function () {
      if (!current) return;
      copyText(formatOutput(current.lines, formatSel.value, trimBox.checked), copyBtn, S.copy);
    });
    copyCommandBtn.addEventListener('click', function () { copyText(commandText.textContent, copyCommandBtn, S.copyCommand); });

    function save(blob, name) {
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = name;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    }
    txtBtn.addEventListener('click', function () {
      if (!current) return;
      save(new Blob([formatOutput(current.lines, 'plain', trimBox.checked) + '\n'], { type: 'text/plain;charset=utf-8' }), downloadBase(current.text, current.fontName) + '.txt');
      track('download');
    });
    pngBtn.addEventListener('click', function () {
      if (!current) return;
      var filename = downloadBase(current.text, current.fontName) + '.png';
      var rows = formatOutput(current.lines, 'plain', trimBox.checked).split('\n');
      var cols = rows.reduce(function (m, l) { return Math.max(m, l.length); }, 0);
      var style = getComputedStyle(outputEl);
      var family = style.fontFamily;
      var canvas = document.createElement('canvas');
      var ctx = canvas.getContext('2d');
      ctx.font = '14px ' + family;
      var cw = ctx.measureText('M').width;
      var size = imageLayout(cols, rows.length, cw);
      if (!size) { setStatus(S.pngTooLarge, 'error'); return; }
      canvas.width = size.width * size.scale;
      canvas.height = size.height * size.scale;
      ctx.scale(size.scale, size.scale);
      ctx.fillStyle = getComputedStyle(outputBox).backgroundColor || '#ffffff';
      ctx.fillRect(0, 0, size.width, size.height);
      ctx.font = '14px ' + family;
      ctx.textBaseline = 'top';
      ctx.fillStyle = style.color;
      // One cell per character keeps the grid even when the fallback font is not monospaced.
      rows.forEach(function (line, y) {
        for (var x = 0; x < line.length; x++) {
          if (line[x] !== ' ') ctx.fillText(line[x], 16 + x * cw, 16 + y * 17 + 1);
        }
      });
      canvas.toBlob(function (blob) {
        if (blob) { save(blob, filename); track('download'); }
        else setStatus(S.pngTooLarge, 'error');
      }, 'image/png');
    });

    previewBtn.addEventListener('click', function () {
      var open = gallery.hidden;
      if (open && !gallery.firstChild) buildGallery();
      gallery.hidden = !open;
      previewBtn.setAttribute('aria-expanded', String(open));
      previewBtn.textContent = open ? S.hidePreviews : S.previewAll;
      if (open) renderGallery();
    });

    render();
  })();
  </script>
</div>

