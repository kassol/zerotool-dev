  </script>
</div>

<style>
  .jjp-wrap { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; gap: 0.75rem; }
  .jjp-config { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .jjp-name-field { display: flex; flex-direction: column; gap: 0.25rem; width: 18rem; max-width: 100%; }
  .jjp-control-label { display: flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .jjp-config label { font-size: 0.85rem; color: var(--color-text-secondary); display: flex; align-items: center; gap: 0.4rem; }
  .jjp-name-field input {
    min-height: 44px; width: 100%; padding: 0.4rem 0.6rem; font-size: 0.85rem;
    font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg); color: var(--color-text);
  }
  .jjp-name-field input:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jjp-panel-header { display: flex; justify-content: space-between; align-items: center; min-height: 44px; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .jjp-panel textarea, .jjp-output {
    width: 100%; min-width: 0; font-family: var(--font-mono); font-size: 0.82rem; padding: 0.75rem;
    border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    background: var(--color-bg-secondary); color: var(--color-text); line-height: 1.5;
  }
  .jjp-panel textarea { transition: border-color 0.15s; }
  .jjp-panel textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }
  .jjp-panel textarea.error { border-color: #c0392b; }
  .jjp-output { margin: 0; overflow: auto; white-space: pre; }
  .jjp-output:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .jjp-empty { display: none; margin: 0; padding: 2rem; align-items: center; justify-content: center; text-align: center; color: var(--color-text-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .jjp-output-pane:has(#jjp-output-code:empty) .jjp-output { display: none; }
  .jjp-output-pane:has(#jjp-output-code:empty) .jjp-empty { display: flex; }
  .jjp-actions { display: flex; gap: 0.5rem 1rem; flex-wrap: wrap; }
  .jjp-status { font-size: 0.85rem; line-height: 1.4; height: 2.8rem; flex: none; overflow: auto; overflow-wrap: anywhere; }
  .jjp-status.success { color: #057a55; }
  .jjp-status.error { color: #c0392b; }
  .jjp-actions button, .jjp-panel-header button { min-height: 44px; }
  .jjp-output-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
  @media (max-width: 860px) {
    .jjp-wrap { gap: 0.5rem; }
    .jjp-name-field { width: 100%; flex-direction: row; align-items: center; gap: 0.5rem; }
    .jjp-name-field .jjp-control-label { flex: 1; }
    .jjp-name-field input { width: 45%; flex: none; }
    .jjp-actions button, .jjp-panel-header button { min-height: 44px; }
    .jjp-panel textarea { height: 144px; min-height: 144px; }
    .jjp-output { height: 22rem; min-height: 160px; resize: none; }
    .jjp-output-pane:has(#jjp-output-code:empty) { display: none; }
  }
  @media (max-width: 640px) {
    .jjp-status { height: 3.6rem; }
    .jjp-panel-header { flex-wrap: wrap; }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .jjp-status.success { color: #34d399; }
    :global(:root:not([data-theme="light"])) .jjp-status.error { color: #f87171; }
    :global(:root:not([data-theme="light"])) .jjp-panel textarea.error { border-color: #f87171; }
  }
  :global([data-theme="dark"]) .jjp-status.success { color: #34d399; }
  :global([data-theme="dark"]) .jjp-status.error { color: #f87171; }
