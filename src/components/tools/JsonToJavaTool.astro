---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const STRINGS = {
  en: {
    empty: "Enter JSON or load the example to generate Java.",
    tips: {
      "input": "Enter valid JSON without comments or trailing commas. Generation runs 300 ms after typing stops; invalid JSON clears the output and shows an error.",
      "rootName": "A blank name uses RootObject. Changing the name generates again after 300 ms.",
      "annotation": "Choose None, Jackson, Gson or Lombok (@Data). Changing the annotation generates again immediately.",
      "example": "Replace JSON with a sample containing nested objects, arrays and null, then generate immediately with the current settings.",
      "clear": "Clear JSON, output and status. Keep the root name and the selected mode. Ctrl/⌘+L with focus in the tool also clears the root name.",
      "copy": "Copy the complete displayed Java output. Empty output is not copied."
    },
    rootName: 'Root class name',
    annotation: 'Annotation',
    jsonInput: 'JSON Input',
    javaOutput: 'Java Output',
    example: 'Example',
    clear: 'Clear',
    copy: 'Copy',
    copied: 'Copied!',
    copyFailed: 'Copy failed. Please copy the output manually.',
    msgInvalidJson: 'Invalid JSON: ',
    msgGenerated: 'Generated.',
    msgGenOne: 'Generated 1 class.',
    msgGenMany: 'Generated {n} classes.',
    annNone: 'None',
    annJackson: 'Jackson',
    annGson: 'Gson',
    annLombok: 'Lombok (@Data)',
  },
  zh: {
    empty: "输入 JSON 或载入示例以生成 Java。",
    tips: {
      "input": "输入合法 JSON，不能带注释或末尾逗号。停止输入 300 毫秒后自动生成；JSON 无效时会清空输出并显示错误。",
      "rootName": "留空时使用 RootObject。修改名称后，等待 300 毫秒自动生成。",
      "annotation": "选择无注解、Jackson、Gson 或 Lombok (@Data)，切换后立即重新生成。",
      "example": "用含嵌套对象、数组和 null 的示例替换 JSON，并按当前设置立即生成。",
      "clear": "清空 JSON、输出和状态，保留根名和所选模式。在工具内按 Ctrl/⌘+L 还会清空根名。",
      "copy": "复制当前显示的完整 Java 输出。输出为空时不复制。"
    },
    rootName: '根类名称',
    annotation: '注解',
    jsonInput: 'JSON 输入',
    javaOutput: 'Java 输出',
    example: '示例',
    clear: '清空',
    copy: '复制',
    copied: '已复制！',
    copyFailed: '复制失败，请手动复制输出。',
    msgInvalidJson: 'JSON 格式错误：',
    msgGenerated: '已生成。',
    msgGenOne: '已生成 1 个类。',
    msgGenMany: '已生成 {n} 个类。',
    annNone: '无注解',
    annJackson: 'Jackson',
    annGson: 'Gson',
    annLombok: 'Lombok (@Data)',
  },
  ja: {
    empty: "JSON を入力するかサンプルを読み込むと、Java を生成します。",
    tips: {
      "input": "コメントや末尾のカンマを含まない有効な JSON を入力します。入力を止めてから 300 ミリ秒後に生成します。無効な JSON では出力を消去し、エラーを表示します。",
      "rootName": "空欄では RootObject を使います。名前を変更すると、300 ミリ秒後に再生成します。",
      "annotation": "なし、Jackson、Gson、Lombok (@Data) から選択します。アノテーションを変えると、すぐに再生成します。",
      "example": "JSON を、ネストされたオブジェクト、配列、null を含むサンプルに置き換え、現在の設定ですぐに生成します。",
      "clear": "JSON、出力、ステータスを消去し、ルート名と選択したモードを保持します。ツール内で Ctrl/⌘+L を押すとルート名も消去します。",
      "copy": "表示中の Java 出力を全文コピーします。出力が空の場合はコピーしません。"
    },
    rootName: 'ルートクラス名',
    annotation: 'アノテーション',
    jsonInput: 'JSON 入力',
    javaOutput: 'Java 出力',
    example: 'サンプル',
    clear: 'クリア',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyFailed: 'コピーに失敗しました。出力を手動でコピーしてください。',
    msgInvalidJson: '無効なJSON：',
    msgGenerated: '生成しました。',
    msgGenOne: '1 個のクラスを生成しました。',
    msgGenMany: '{n} 個のクラスを生成しました。',
    annNone: 'なし',
    annJackson: 'Jackson',
    annGson: 'Gson',
    annLombok: 'Lombok (@Data)',
  },
  ko: {
    empty: "JSON을 입력하거나 예시를 불러와 Java 코드를 생성하세요.",
    tips: {
      "input": "주석이나 끝 쉼표가 없는 유효한 JSON을 입력하세요. 입력을 멈춘 뒤 300밀리초 후 생성합니다. JSON이 잘못되면 출력을 지우고 오류를 표시합니다.",
      "rootName": "비워 두면 RootObject를 사용합니다. 이름을 바꾸면 300밀리초 후 다시 생성합니다.",
      "annotation": "없음, Jackson, Gson, Lombok (@Data) 중에서 선택하세요. 어노테이션을 바꾸면 즉시 다시 생성합니다.",
      "example": "JSON을 중첩 객체, 배열, null이 포함된 예시로 바꾸고 현재 설정으로 즉시 생성합니다.",
      "clear": "JSON, 출력, 상태를 지우고 루트 이름과 선택한 모드는 유지합니다. 도구 안에서 Ctrl/⌘+L을 누르면 루트 이름도 지웁니다.",
      "copy": "현재 표시된 Java 출력 전체를 복사합니다. 출력이 비어 있으면 복사하지 않습니다."
    },
    rootName: '루트 클래스 이름',
    annotation: '어노테이션',
    jsonInput: 'JSON 입력',
    javaOutput: 'Java 출력',
    example: '예시',
    clear: '지우기',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: '복사하지 못했습니다. 출력을 직접 복사하세요.',
    msgInvalidJson: '잘못된 JSON: ',
    msgGenerated: '생성 완료.',
    msgGenOne: '클래스 1개를 생성했습니다.',
    msgGenMany: '클래스 {n}개를 생성했습니다.',
    annNone: '없음',
    annJackson: 'Jackson',
    annGson: 'Gson',
    annLombok: 'Lombok (@Data)',
  },
};

const L = STRINGS[lang];
---

<div
  class="jjp-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-msg-invalid-json={L.msgInvalidJson}
  data-msg-generated={L.msgGenerated}
  data-msg-gen-one={L.msgGenOne}
  data-msg-gen-many={L.msgGenMany}
>
  <div class="jjp-config">
    <div class="jjp-name-field">
      <div class="jjp-control-label">
        <label for="jjp-root-name">{L.rootName}</label>
        <Toggletip id="jjp-tip-root-name" lang={lang} about={L.rootName}>{L.tips.rootName}</Toggletip>
      </div>
      <input id="jjp-root-name" type="text" value="RootObject" spellcheck="false" />
    </div>
    <div class="jjp-option-field">
      <div class="jjp-control-label"><span id="jjp-mode-label">{L.annotation}</span><Toggletip id="jjp-tip-annotation" lang={lang} about={L.annotation}>{L.tips.annotation}</Toggletip></div>
      <div class="jjp-tabs zt-segmented" role="group" aria-labelledby="jjp-mode-label" id="jjp-ann-tabs">
        <button type="button" class="jjp-tab active" aria-pressed="true" data-ann="none">{L.annNone}</button>
        <button type="button" class="jjp-tab" aria-pressed="false" data-ann="jackson">{L.annJackson}</button>
        <button type="button" class="jjp-tab" aria-pressed="false" data-ann="gson">{L.annGson}</button>
        <button type="button" class="jjp-tab" aria-pressed="false" data-ann="lombok">{L.annLombok}</button>
      </div>
    </div>
  </div>
  <div class="jjp-actions">
    <div class="jjp-control-label">
      <button id="jjp-example" class="btn-ghost" type="button">{L.example}</button>
      <Toggletip id="jjp-tip-example" lang={lang} about={L.example}>{L.tips.example}</Toggletip>
    </div>
    <div class="jjp-control-label">
      <button id="jjp-clear" class="btn-ghost" type="button">{L.clear}</button>
      <Toggletip id="jjp-tip-clear" lang={lang} about={L.clear}>{L.tips.clear}</Toggletip>
    </div>
  </div>
  <div id="jjp-status" class="jjp-status" aria-live="polite"></div>
  <div class="jjp-panels zt-io">
    <div class="jjp-panel zt-io-pane">
      <div class="jjp-panel-header">
        <div class="jjp-control-label">
          <label for="jjp-input">{L.jsonInput}</label>
          <Toggletip id="jjp-tip-input" lang={lang} about={L.jsonInput}>{L.tips.input}</Toggletip>
        </div>
      </div>
      <textarea id="jjp-input" class="zt-io-fill" placeholder='{"name": "Alice", "age": 30}' spellcheck="false"></textarea>
    </div>
    <div class="jjp-panel jjp-output-pane zt-io-pane">
      <div class="jjp-panel-header">
        <span id="jjp-output-label">{L.javaOutput}</span>
        <div class="jjp-output-actions">
    <div class="jjp-control-label">
      <button id="jjp-copy" class="btn-ghost" type="button">{L.copy}</button>
      <Toggletip id="jjp-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip>
    </div>
        </div>
      </div>
      <p class="jjp-empty zt-io-fill">{L.empty}</p>
      <pre id="jjp-output" class="jjp-output zt-io-fill" tabindex="0" aria-labelledby="jjp-output-label"><code id="jjp-output-code"></code></pre>
    </div>
  </div>

  <script>
    import hljs from 'highlight.js/lib/core';
    import java from 'highlight.js/lib/languages/java';
    hljs.registerLanguage('java', java);

    (function () {
      var wrap = document.querySelector('.jjp-wrap');

      var COPY = wrap ? wrap.dataset.copy : 'Copy';
      var COPIED = wrap ? wrap.dataset.copied : 'Copied!';
      var COPY_FAILED = wrap ? wrap.dataset.copyFailed : 'Copy failed. Please copy the output manually.';
      var MSG_INVALID = wrap ? wrap.dataset.msgInvalidJson : 'Invalid JSON: ';
      var MSG_GENERATED = wrap ? wrap.dataset.msgGenerated : 'Generated.';
      var MSG_GEN_ONE = wrap ? wrap.dataset.msgGenOne : 'Generated 1 class.';
      var MSG_GEN_MANY = wrap ? wrap.dataset.msgGenMany : 'Generated {n} classes.';

      var inputEl = document.getElementById('jjp-input');
      var outputCodeEl = document.getElementById('jjp-output-code');
      var statusEl = document.getElementById('jjp-status');
      var rootNameEl = document.getElementById('jjp-root-name');
      var copyBtn = document.getElementById('jjp-copy');
      var copyRevision = 0;
      var copyTimer = null;
      var copyFailure = false;

      var currentAnn = 'none';

      var EXAMPLE = JSON.stringify({
        id: 1,
        name: "Alice",
        is_active: true,
        score: 9.5,
        tags: ["java", "json"],
        address: {
          city: "London",
          zip_code: "EC1A 1BB"
        },
        friends: [
          { id: 2, name: "Bob" },
          { id: 3, name: "Carol" }
        ],
        metadata: null
      }, null, 2);

      var tabs = wrap ? wrap.querySelectorAll('.jjp-tab') : [];
      for (var ti = 0; ti < tabs.length; ti++) {
        (function (tab) {
          tab.addEventListener('click', function () {
            for (var j = 0; j < tabs.length; j++) {
              tabs[j].classList.remove('active');
              tabs[j].setAttribute('aria-pressed', 'false');
            }
            tab.classList.add('active');
            tab.setAttribute('aria-pressed', 'true');
            currentAnn = tab.dataset.ann;
            convert();
          });
        })(tabs[ti]);
      }

      function setStatus(msg, isError) {
        copyFailure = false;
        statusEl.textContent = msg;
        statusEl.className = 'jjp-status ' + (isError ? 'error' : 'success');
      }
      function clearStatus() {
        copyFailure = false;
        statusEl.textContent = '';
        statusEl.className = 'jjp-status';
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        if (copyFailure) clearStatus();
      }

      /* ── engine:start ── */
      function toPascalCase(str) {
        var name = String(str)
          .replace(/[^a-zA-Z0-9]+(.)/g, function (_, ch) { return ch.toUpperCase(); })
          .replace(/[^a-zA-Z0-9_$]/g, '')
          .replace(/^(.)/, function (_, ch) { return ch.toUpperCase(); });
        if (!/^[A-Za-z_$]/.test(name)) name = 'T' + name;
        return javaIdentifier(name);
      }

      function toCamelCase(str) {
        var pascal = toPascalCase(str);
        return pascal.charAt(0).toLowerCase() + pascal.slice(1);
      }

      function capitalize(str) {
        return str.charAt(0).toUpperCase() + str.slice(1);
      }

      // Include literals and restricted type names, so every generated declaration compiles.
      var JAVA_RESERVED = ('abstract assert boolean break byte case catch char class const continue default do double else enum extends final finally float for goto if implements import instanceof int interface long native new package private protected public return short static strictfp super switch synchronized this throw throws transient try void volatile while true false null _ var yield record sealed permits').split(' ');
      var JAVA_TYPES = ['Object', 'String', 'List', 'Integer', 'Long', 'Double', 'Boolean', 'Data', 'JsonProperty', 'JsonAlias', 'SerializedName'];
      function javaIdentifier(name) {
        return JAVA_RESERVED.indexOf(name) === -1 ? name : name + 'Value';
      }
      function javaString(value) {
        var escapes = { '"': '\\"', '\\': '\\\\', '\n': '\\n', '\r': '\\r', '\t': '\\t', '\b': '\\b', '\f': '\\f' };
        return '"' + value.replace(/["\\\x00-\x1f\x7f]/g, function (ch) {
          return escapes[ch] || '\\' + ('00' + ch.charCodeAt(0).toString(8)).slice(-3);
        }) + '"';
      }

      function boxPrimitive(t) {
        if (t === 'int') return 'Integer';
        if (t === 'long') return 'Long';
        if (t === 'double') return 'Double';
        if (t === 'boolean') return 'Boolean';
        return t;
      }

      function inferJavaType(value, key, state, parent) {
        if (value === null) return 'Object';
        if (typeof value === 'boolean') return 'boolean';
        if (typeof value === 'number') {
          if (!Number.isInteger(value)) return 'double';
          return (value > 2147483647 || value < -2147483648) ? 'long' : 'int';
        }
        if (typeof value === 'string') return 'String';

        if (Array.isArray(value)) {
          if (value.length === 0) return 'List<Object>';
          var objectItems = [];
          var primitiveTypes = [];
          for (var i = 0; i < value.length; i++) {
            var item = value[i];
            if (item !== null && typeof item === 'object' && !Array.isArray(item)) {
              objectItems.push(item);
            } else {
              var t = inferJavaType(item, key + 'Item', state, parent);
              if (primitiveTypes.indexOf(t) === -1) primitiveTypes.push(t);
            }
          }
          if (objectItems.length > 0) {
            var itemClassName = mergeJavaObjects(objectItems, toPascalCase(key) + 'Item', parent, state);
            if (primitiveTypes.indexOf(itemClassName) === -1) primitiveTypes.push(itemClassName);
          }
          var elType = boxPrimitive(primitiveTypes.length === 0 ? 'Object' : mergeTypes(primitiveTypes));
          return 'List<' + elType + '>';
        }

        if (typeof value === 'object') {
          return mergeJavaObjects([value], toPascalCase(key), parent, state);
        }

        return 'Object';
      }

      // Several sample values for one field: int, long and double widen to the widest of them
      // (9.5 and 20 → double); any other mix stays Object.
      function mergeTypes(types) {
        if (types.length === 1) return types[0];
        var numeric = ['int', 'long', 'double'];
        for (var i = 0; i < types.length; i++) if (numeric.indexOf(types[i]) === -1) return 'Object';
        if (types.indexOf('double') !== -1) return 'double';
        return types.indexOf('long') !== -1 ? 'long' : 'int';
      }

      function buildClass(obj, name, classes) {
        return mergeObjectsToClass([obj], name, classes);
      }

      function mergeObjectsToClass(objects, name, classes) {
        name = toPascalCase(name);
        if (JAVA_TYPES.indexOf(name) !== -1) name += 'Value';
        var state = { list: [], byName: Object.create(null), reserved: Object.create(null) };
        state.reserved[name] = true;
        JAVA_TYPES.forEach(function (type) { state.reserved[type] = true; });
        mergeJavaObjects(objects, name, '', state, name);
        state.list.forEach(function (slot) {
          Object.defineProperty(classes, slot.name, { value: slot.fields, enumerable: true, configurable: true });
        });
        return name;
      }

      // Same base name and field structure reuse a declaration. Different structures use the
      // parent prefix, then a numeric suffix, like the TypeScript / Go / Kotlin generators.
      function mergeJavaObjects(objects, base, parent, state, fixedName) {
        var slot = { name: null, base: base, sig: null, fields: null };
        state.list.push(slot);
        var context = fixedName || base;
        var allKeys = Object.create(null);
        for (var i = 0; i < objects.length; i++) {
          var ks = Object.keys(objects[i]);
          for (var j = 0; j < ks.length; j++) {
            if (!allKeys[ks[j]]) allKeys[ks[j]] = [];
            allKeys[ks[j]].push(objects[i][ks[j]]);
          }
        }

        var fields = [];
        var usedFields = Object.create(null);
        var usedMethods = Object.create(null);
        var keyList = Object.keys(allKeys);
        for (var ki = 0; ki < keyList.length; ki++) {
          var k = keyList[ki];
          var values = allKeys[k];
          var types = [];
          if (values.every(function (v) { return v !== null && typeof v === 'object' && !Array.isArray(v); })) {
            types.push(mergeJavaObjects(values, toPascalCase(k), context, state));
          } else if (values.every(Array.isArray)) {
            types.push(inferJavaType([].concat.apply([], values), k, state, context));
          } else {
            for (var oi = 0; oi < values.length; oi++) {
              var t = inferJavaType(values[oi], k, state, context);
              if (types.indexOf(t) === -1) types.push(t);
            }
          }
          var type = mergeTypes(types);
          var fieldBase = javaIdentifier(toCamelCase(k));
          var fieldName = fieldBase;
          for (var suffix = 2; usedFields[fieldName] || usedMethods[capitalize(fieldName)]; suffix++) fieldName = fieldBase + suffix;
          usedFields[fieldName] = true;
          usedMethods[capitalize(fieldName)] = true;
          fields.push({ key: k, fieldName: fieldName, type: type });
        }
        var sig = JSON.stringify(fields.map(function (f) { return [f.key, f.type]; }).sort(function (a, b) { return a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0; }));
        if (!fixedName) {
          for (var si = 0; si < state.list.length; si++) {
            var other = state.list[si];
            if (other !== slot && other.base === base && other.sig === sig) {
              state.list.splice(state.list.indexOf(slot), 1);
              return other.name;
            }
          }
        }
        var candidates = [base, parent + base];
        var name = fixedName || null;
        for (var ci = 0; ci < candidates.length && !name; ci++) {
          if (!state.byName[candidates[ci]] && !state.reserved[candidates[ci]]) name = candidates[ci];
        }
        for (var n = 2; !name; n++) {
          if (!state.byName[base + n] && !state.reserved[base + n]) name = base + n;
        }
        slot.name = name; slot.sig = sig; slot.fields = fields;
        state.byName[name] = slot;
        return name;
      }

      function hasListType(classes) {
        var names = Object.keys(classes);
        for (var i = 0; i < names.length; i++) {
          var fields = classes[names[i]];
          if (!fields) continue;
          for (var j = 0; j < fields.length; j++) {
            if (fields[j].type && fields[j].type.indexOf('List<') === 0) return true;
          }
        }
        return false;
      }

      // Jackson names a getter / setter property by lower-casing the leading capitals after
      // get / is / set (getURL → "url", getAB → "ab"). When that differs from the field name, the
      // accessors form a second property, so they need the same explicit name as the field.
      function jacksonAccessorName(fieldName) {
        var cap = capitalize(fieldName);
        var i = 0;
        while (i < cap.length && /[A-Z]/.test(cap.charAt(i))) i++;
        return cap.slice(0, i).toLowerCase() + cap.slice(i);
      }
      function jacksonAccessorsNeedName(field) {
        return field.key !== '' && jacksonAccessorName(field.fieldName) !== field.fieldName;
      }
      function needsJackson(field) {
        return field.key === '' || field.fieldName !== field.key || jacksonAccessorsNeedName(field);
      }

      function renderGetterSetter(field, mode) {
        var f = field.fieldName;
        var t = field.type;
        var cap = capitalize(f);
        var getterName = (t === 'boolean') ? 'is' + cap : 'get' + cap;
        var note = (mode === 'jackson' && jacksonAccessorsNeedName(field)) ? '    @JsonProperty(' + javaString(field.key) + ')\n' : '';
        return (
          note +
          '    public ' + t + ' ' + getterName + '() {\n' +
          '        return ' + f + ';\n' +
          '    }\n' +
          '\n' +
          note +
          '    public void set' + cap + '(' + t + ' ' + f + ') {\n' +
          '        this.' + f + ' = ' + f + ';\n' +
          '    }'
        );
      }

      function renderClass(name, fields, mode) {
        if (!fields) return '';
        var lines = [];

        if (mode === 'lombok') lines.push('@Data');
        lines.push('public class ' + name + ' {');

        for (var i = 0; i < fields.length; i++) {
          var f = fields[i];
          if (mode === 'jackson' && f.key === '') {
            // @JsonProperty("") means "use the default name", so Jackson can read "" only as an alias.
            lines.push('    // Jackson reads the empty key "" but writes this field as "' + f.fieldName + '"');
            lines.push('    @JsonAlias("")');
          } else if (mode === 'jackson' && needsJackson(f)) {
            lines.push('    @JsonProperty(' + javaString(f.key) + ')');
          } else if (mode === 'gson' && f.fieldName !== f.key) {
            lines.push('    @SerializedName(' + javaString(f.key) + ')');
          }
          lines.push('    private ' + f.type + ' ' + f.fieldName + ';');
        }

        if (mode !== 'lombok' && fields.length > 0) {
          lines.push('');
          for (var i = 0; i < fields.length; i++) {
            lines.push(renderGetterSetter(fields[i], mode));
            if (i < fields.length - 1) lines.push('');
          }
        }

        lines.push('}');
        return lines.join('\n');
      }

      function renderClasses(classes, mode) {
        var names = Object.keys(classes);
        var importLines = [];

        if (hasListType(classes)) importLines.push('import java.util.List;');

        if (mode === 'jackson') {
          var needAlias = false, needProperty = false;
          for (var i = 0; i < names.length; i++) {
            var flds = classes[names[i]] || [];
            for (var j = 0; j < flds.length; j++) {
              if (flds[j].key === '') needAlias = true;
              else if (needsJackson(flds[j])) needProperty = true;
            }
          }
          if (needAlias) importLines.push('import com.fasterxml.jackson.annotation.JsonAlias;');
          if (needProperty) importLines.push('import com.fasterxml.jackson.annotation.JsonProperty;');
        } else if (mode === 'gson') {
          var need = false;
          outer: for (var i = 0; i < names.length; i++) {
            var flds = classes[names[i]];
            if (!flds) continue;
            for (var j = 0; j < flds.length; j++) {
              if (flds[j].fieldName !== flds[j].key) { need = true; break outer; }
            }
          }
          if (need) importLines.push('import com.google.gson.annotations.SerializedName;');
        } else if (mode === 'lombok') {
          importLines.push('import lombok.Data;');
        }

        var blocks = [];
        for (var i = 0; i < names.length; i++) {
          var rendered = renderClass(names[i], classes[names[i]], mode);
          if (rendered) blocks.push(rendered);
        }

        var result = importLines.length > 0 ? importLines.join('\n') + '\n\n' : '';
        result += blocks.join('\n\n');
        return result;
      }
      /* ── engine:end ── */

      // No output (empty or invalid input): nothing stale stays on screen and Copy is off.
      function clearOutput() {
        outputCodeEl.textContent = '';
        outputCodeEl.removeAttribute('data-highlighted');
        outputCodeEl.className = '';
        copyBtn.disabled = true;
      }
      function showOutput(text) {
        outputCodeEl.textContent = text;
        outputCodeEl.removeAttribute('data-highlighted');
        outputCodeEl.className = 'language-java';
        hljs.highlightElement(outputCodeEl);
        copyBtn.disabled = false;
      }

      function convert() {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = null;
        var raw = inputEl.value.trim();
        if (!raw) { inputEl.classList.remove('error'); clearStatus(); clearOutput(); return; }
        inputEl.classList.remove('error');

        var parsed;
        try {
          parsed = JSON.parse(raw);
        } catch (e) {
          inputEl.classList.add('error');
          clearOutput();
          setStatus(MSG_INVALID + e.message, true);
          return;
        }

        inputEl.classList.remove('error');
        var rootName = rootNameEl.value.trim() || 'RootObject';
        var classes = {};

        if (parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed)) {
          buildClass(parsed, rootName, classes);
        } else if (Array.isArray(parsed)) {
          var objectItems = parsed.filter(function (v) {
            return v !== null && typeof v === 'object' && !Array.isArray(v);
          });
          if (objectItems.length > 0) {
            mergeObjectsToClass(objectItems, rootName, classes);
          } else {
            showOutput('// Array of primitives — no class to generate');
            setStatus(MSG_GENERATED, false);
            window.trackTool && window.trackTool('json-to-java-pojo', 'generate');
            return;
          }
        } else {
          showOutput('// Primitive value — no class to generate');
          setStatus(MSG_GENERATED, false);
          window.trackTool && window.trackTool('json-to-java-pojo', 'generate');
          return;
        }

        showOutput(renderClasses(classes, currentAnn));
        var count = Object.keys(classes).length;
        var msg = count === 1 ? MSG_GEN_ONE : MSG_GEN_MANY.replace('{n}', count);
        setStatus(msg, false);
        window.trackTool && window.trackTool('json-to-java-pojo', 'generate');
      }

      var _liveTimer = null;
      inputEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = setTimeout(convert, 300);
      });
      rootNameEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = setTimeout(convert, 300);
      });

      document.getElementById('jjp-example').addEventListener('click', function () {
        inputEl.value = EXAMPLE;
        inputEl.classList.remove('error');
        clearStatus();
        convert();
      });

      document.getElementById('jjp-clear').addEventListener('click', function () {
        invalidateCopy();
        clearTimeout(_liveTimer);
        _liveTimer = null;
        inputEl.value = '';
        clearOutput();
        inputEl.classList.remove('error');
        clearStatus();
      });
      // ToolLayout's Ctrl/Cmd+L empties the fields without input events; drop the stale output too.
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l' || !wrap.contains(document.activeElement)) return;
        e.preventDefault();
        inputEl.focus();
        document.getElementById('jjp-clear').click();
      });

      copyBtn.addEventListener('click', function () {
        var text = outputCodeEl.textContent;
        if (!text || copyBtn.disabled) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyTimer = null;
        copyBtn.textContent = COPY;
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(COPY_FAILED, true);
          copyFailure = true;
        }
        try {
          navigator.clipboard.writeText(text).then(function () {
            if (revision !== copyRevision) return;
            if (copyFailure) clearStatus();
            copyBtn.textContent = COPIED;
            copyTimer = setTimeout(function () {
              if (revision === copyRevision) copyBtn.textContent = COPY;
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
      });

      // seed sample data on mount
      inputEl.value = EXAMPLE;
      convert();
    })();
  </script>
</div>

