const L = STRINGS[lang];
const { tips: TIPS, ...CLIENT_L } = L;
const colors = [{ key: 'bg', value: '#ffffff' }, { key: 'border', value: '#ffffff' }, { key: 'shadow', value: '#000000' }, { key: 'text', value: '#111111' }, { key: 'fallback', value: '#ffffff' }];
const ranges = [
  { key: 'alpha', value: 15, max: 100, unit: '%' }, { key: 'blur', value: 12, max: 40, unit: 'px' },
  { key: 'saturation', value: 180, max: 200, unit: '%' }, { key: 'borderAlpha', value: 30, max: 100, unit: '%' },
  { key: 'borderWidth', value: 1, max: 4, step: 0.5, unit: 'px' }, { key: 'radius', value: 16, max: 40, unit: 'px' },
  { key: 'shadowAlpha', value: 20, max: 60, unit: '%' },
];
---
<div class="gsg-wrap">
  <div class="gsg-body">
    <div class="gsg-rail zt-rail">
      <div class="gsg-primary">
  <div class="gsg-controls">
    {colors.slice(0, 1).map(({ key, value }) => <div class="gsg-field" data-field={key}>
      <div class="gsg-label-row"><label class="tool-label" for={`gsg-${key}`}>{L[key as keyof typeof L]}</label><Toggletip id={`gsg-tip-${key}`} lang={lang} about={L[key as keyof typeof L]}>{TIPS.bg}</Toggletip></div>
      <div class="gsg-color-row">
        <input class="gsg-swatch" type="color" value={value} data-color={key} aria-label={L[key as keyof typeof L]} />
        <input class="tool-input" type="text" id={`gsg-${key}`} value={value} data-hex={key} spellcheck="false" autocomplete="off" aria-describedby="gsg-status" />
      </div>
    </div>)}
    {ranges.slice(0, 3).map(({ key, value, max, step, unit }) => <div class="gsg-field" data-field={key}>
      <div class="gsg-label-row"><label class="tool-label" for={`gsg-${key}`}>{L[key as keyof typeof L]} <output id={`gsg-${key}-val`}>{value}{unit}</output></label><Toggletip id={`gsg-tip-${key}`} lang={lang} about={L[key as keyof typeof L]}>{TIPS[key as keyof typeof TIPS]}</Toggletip></div>
      <input type="range" id={`gsg-${key}`} data-range={key} data-unit={unit} min="0" max={max} step={step || 1} value={value} />
    </div>)}
  </div>
    <div class="gsg-output-header">
      <label for="gsg-format" class="tool-label">{L.output}</label>
      <select id="gsg-format" class="tool-input"><option value="css">CSS</option><option value="tailwind">{L.tailwind}</option></select>
      <Toggletip id="gsg-tip-output" lang={lang} about={L.output}>{TIPS.output}</Toggletip>
      <button id="gsg-copy" class="btn-copy" type="button">{L.copy}</button>
    </div>
      </div>
      <div class="gsg-secondary">
    <details class="gsg-options"><summary>{L.advanced}<Toggletip id="gsg-tip-advanced" lang={lang} about={L.advanced} wide>{TIPS.advanced}</Toggletip></summary><div class="gsg-controls">
      {colors.slice(1).map(({ key, value }) => <div class="gsg-field" data-field={key}>
        <label class="tool-label" for={`gsg-${key}`}>{L[key as keyof typeof L]}</label>
        <div class="gsg-color-row">
          <input class="gsg-swatch" type="color" value={value} data-color={key} aria-label={L[key as keyof typeof L]} />
          <input class="tool-input" type="text" id={`gsg-${key}`} value={value} data-hex={key} spellcheck="false" autocomplete="off" aria-describedby="gsg-status" />
        </div>
      </div>)}
      {ranges.slice(3).map(({ key, value, max, step, unit }) => <div class="gsg-field" data-field={key}>
        <label class="tool-label" for={`gsg-${key}`}>{L[key as keyof typeof L]} <output id={`gsg-${key}-val`}>{value}{unit}</output></label>
        <input type="range" id={`gsg-${key}`} data-range={key} data-unit={unit} min="0" max={max} step={step || 1} value={value} />
      </div>)}
    </div></details>    <div class="gsg-background">
      <div class="gsg-label-row"><label for="gsg-preset" class="tool-label">{L.background}</label><Toggletip id="gsg-tip-background" lang={lang} about={L.background} wide>{TIPS.background}</Toggletip></div>
      <select id="gsg-preset" class="tool-input">{['sunset', 'ocean', 'forest', 'night', 'aurora'].map(key => <option value={key}>{L[key as keyof typeof L]}</option>)}</select>
      <button id="gsg-image" type="button" class="btn-secondary">{L.image}</button><input id="gsg-file" type="file" accept="image/*" hidden />
      <button id="gsg-reset" type="button" class="btn-ghost">{L.reset}</button>
    </div>
    <p class="gsg-note">{L.imageLocal}</p>
    <details class="gsg-code-details"><summary>CSS / Tailwind v4</summary><pre class="gsg-pre"><code id="gsg-code"></code></pre></details>      </div>
    </div>
    <div class="gsg-preview-section">
    <div class="gsg-toolbar">
      <label class="gsg-off"><input id="gsg-opaque" type="checkbox" />{L.opaque}</label>
      <label class="gsg-state-label tool-label" for="gsg-state">{L.state}</label>
      <select id="gsg-state" class="tool-input"><option value="normal">{L.normal}</option><option value="unsupported">{L.unsupported}</option><option value="reduced">{L.reduced}</option></select>
      <Toggletip id="gsg-tip-state" lang={lang} about={L.state}>{TIPS.state}</Toggletip>
    </div>
    <p id="gsg-status" class="tool-status" role="status"></p>    <div id="gsg-preview-canvas" class="gsg-preview-canvas">
      <p class="gsg-empty">{L.empty}</p>
      <canvas id="gsg-scene" aria-hidden="true"></canvas>
      <div id="gsg-card" class="gsg-card"><strong>{L.title}</strong><span>{L.subtitle}</span></div>
    </div>
    <div class="gsg-contrast"><div class="gsg-label-row"><strong>{L.contrast}</strong><Toggletip id="gsg-tip-contrast" lang={lang} about={L.contrast}>{TIPS.contrast}</Toggletip></div><div id="gsg-contrast-values"></div><p class="gsg-note">{L.scope}</p></div>
    </div>
  </div>
  <script is:inline define:vars={{ L: CLIENT_L }}>
    (function () {
      // engine:start
      function parseColor(input) {
        var value = input.normalize('NFKC').trim().replace(/^#/, '');
