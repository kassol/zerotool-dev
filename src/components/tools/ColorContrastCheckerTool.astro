    aa: 'AA',
    aaa: 'AAA',
    pass: '合格',
    fail: '不合格',
    nA: '—',
    suggestionTitle: '修正案（本文 AA 4.5 : 1 達成）',
    suggestionLine: '色相と彩度を保ち、前景の明度を調整：',
    apply: '修正案を適用',
    copyFixed: 'HEX をコピー',
    invalidHex: '不正な HEX カラー',
    noAlpha: '透明度には対応していません。不透明な 3 桁または 6 桁の HEX を入力してください。',
    sampleText: 'いろはにほへと The quick brown fox 0123456789',
    copied: 'コピーしました！',
    copyFailed: 'コピーに失敗しました。再試行するか、修正案の HEX を手動でコピーしてください。',
    empty: "有効な2色を入力するとコントラストをプレビューできます。",
    tips: {
      "fg": "# の有無を問わず3桁または6桁の16進数を入力するか、カラーコントロールを使います。入力途中は直前のプレビューを保持し、無効な色や透明度付きの色では結果を消去します。Ctrl/⌘+L は両方のテキストと結果を消去し、ネイティブの色を保持します。",
      "bg": "HEX 入力またはカラーコントロールで背景を設定します。比率と丸めた HEX 修正案はブラウザー内で計算します。",
      "swap": "直前の有効な前景と背景を交換します。テキストとカラーコントロールも交換した色を表示します。",
      "ratio": "比率は小数2桁で切り捨てます。本文の AA/AAA は4.5/7、大きな文字は3/4.5、UI の AA は3です。UI の AAA 目標はありません。",
      "apply": "本文 AA が不合格のとき表示します。丸めた HEX 修正案を前景に適用します。比率は表示する8ビット色で測り、探索では黒または白に戻る場合があります。",
      "copy": "修正案の HEX 全体をコピーします。有効な入力と表示中の修正案が必要です。失敗時は再試行するか、HEX を手動でコピーします。"
    },
  },
  ko: {
    foreground: '전경색',
    background: '배경색',
    swapAria: '전경과 배경 교환',
    contrastRatio: '대비비',
    bodyText: '본문',
    bodyHint: '< 24px 또는 < 18.66px 굵게',
    largeText: '큰 글자',
    largeHint: '≥ 18.66px 굵게 또는 ≥ 24px',
    uiComponent: 'UI 구성요소 · 그래픽',
    uiHint: '테두리, 아이콘, 포커스 링 (WCAG 1.4.11)',
    aa: 'AA',
    aaa: 'AAA',
    pass: '통과',
    fail: '실패',
    nA: '—',
    suggestionTitle: '수정 제안 (본문 AA 4.5 : 1 통과)',
    suggestionLine: '색상과 채도를 유지하고 전경 명도를 조정:',
    apply: '제안 적용',
    copyFixed: 'HEX 복사',
    invalidHex: '잘못된 HEX 색상',
    noAlpha: '투명도는 지원하지 않습니다. 불투명한 3자리 또는 6자리 HEX를 입력하세요.',
    sampleText: '동해 물과 백두산이 The quick brown fox 0123456789',
    copied: '복사됨!',
    copyFailed: '복사에 실패했습니다. 다시 시도하거나 제안 HEX를 직접 복사하세요.',
    empty: "유효한 두 색을 입력하면 대비를 미리 봅니다.",
    tips: {
      "fg": "# 유무와 관계없이 3자리 또는 6자리 HEX를 입력하거나 색상 컨트롤을 사용합니다. 입력 중에는 최근 유효한 미리보기를 유지하고, 잘못된 색이나 투명도가 있는 색이면 결과를 지웁니다. Ctrl/⌘+L은 두 텍스트와 결과를 지우고 기본 색상 컨트롤을 유지합니다.",
      "bg": "HEX 텍스트 또는 색상 컨트롤로 배경을 설정합니다. 대비비와 반올림한 HEX 제안은 브라우저에서 계산합니다.",
      "swap": "최근 유효한 전경과 배경을 교환합니다. 텍스트와 기본 색상 컨트롤도 교환한 색을 표시합니다.",
      "ratio": "비율은 소수 둘째 자리에서 잘라 표시합니다. 본문 AA/AAA 기준은 4.5/7, 큰 글자는 3/4.5, UI AA는 3입니다. UI AAA 기준은 없습니다.",
      "apply": "본문 AA가 실패하면 표시합니다. 반올림한 HEX 제안을 전경에 적용하며 표시된 8비트 색으로 대비비를 측정합니다. 검색은 검정이나 흰색으로 돌아갈 수 있습니다.",
      "copy": "제안 HEX 전체를 복사합니다. 제안이 표시되고 입력 색이 유효할 때 사용할 수 있습니다. 실패하면 재시도하거나 HEX를 직접 복사합니다."
    },
  },
};

// strings:end
const L = STRINGS[lang] ?? STRINGS.en;
---

<div
  class="ccc-wrap"
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-invalid-hex={L.invalidHex}
  data-no-alpha={L.noAlpha}
  data-pass={L.pass}
  data-fail={L.fail}
>
  <div class="ccc-body">
    <aside class="ccc-rail zt-rail">
      <div class="ccc-swap-row">
    <button id="ccc-swap" class="ccc-swap-btn" type="button" aria-label={L.swapAria}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M16 3l4 4-4 4"/>
        <path d="M20 7H4"/>
        <path d="M8 21l-4-4 4-4"/>
        <path d="M4 17h16"/>
      </svg>
    </button><Toggletip id="ccc-tip-swap" lang={lang} about={L.swapAria}>{L.tips.swap}</Toggletip>
      </div>
  <div class="ccc-inputs">
    <div class="ccc-color-cell">
      <div class="ccc-label-row"><label class="ccc-label" for="ccc-fg-hex">{L.foreground}</label><Toggletip id="ccc-tip-fg" lang={lang} about={L.foreground}>{L.tips.fg}</Toggletip></div>
      <div class="ccc-color-input">
        <input id="ccc-fg-picker" class="ccc-picker" type="color" value="#1f2937" aria-label={L.foreground} />
        <div class="ccc-hex-wrap">
          <input
            id="ccc-fg-hex"
            class="ccc-hex-input"
            type="text"
            value="#1f2937"
            maxlength="16"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="ccc-fg-error"
          />
          <span id="ccc-fg-error" class="ccc-hex-error" role="alert" aria-live="polite"></span>
        </div>
      </div>
    </div>



    <div class="ccc-color-cell">
      <div class="ccc-label-row"><label class="ccc-label" for="ccc-bg-hex">{L.background}</label><Toggletip id="ccc-tip-bg" lang={lang} about={L.background}>{L.tips.bg}</Toggletip></div>
      <div class="ccc-color-input">
        <input id="ccc-bg-picker" class="ccc-picker" type="color" value="#f9fafb" aria-label={L.background} />
        <div class="ccc-hex-wrap">
          <input
            id="ccc-bg-hex"
            class="ccc-hex-input"
            type="text"
            value="#f9fafb"
            maxlength="16"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="ccc-bg-error"
          />
          <span id="ccc-bg-error" class="ccc-hex-error" role="alert" aria-live="polite"></span>
        </div>
      </div>
    </div>
  </div>
      <p id="ccc-copy-status" class="tool-status none" role="status" aria-live="polite"></p>
  <div id="ccc-suggestion" class="ccc-suggestion" hidden>
    <div class="ccc-suggestion-title">{L.suggestionTitle}</div>
    <div class="ccc-suggestion-body">
      <span class="ccc-suggestion-line">{L.suggestionLine}</span>
      <span id="ccc-suggestion-swatch" class="ccc-suggestion-swatch" aria-hidden="true"></span>
      <span id="ccc-suggestion-hex" class="ccc-suggestion-hex"></span>
      <span id="ccc-suggestion-ratio" class="ccc-suggestion-ratio"></span>
    </div>
    <div class="ccc-suggestion-actions">
      <span class="ccc-action"><button id="ccc-apply-btn" class="btn-primary" type="button">{L.apply}</button><Toggletip id="ccc-tip-apply" lang={lang} about={L.apply}>{L.tips.apply}</Toggletip></span>
      <span class="ccc-action"><button id="ccc-copy-fixed" class="btn-copy" type="button">{L.copyFixed}</button><Toggletip id="ccc-tip-copy" lang={lang} about={L.copyFixed}>{L.tips.copy}</Toggletip></span>
    </div>
  </div>
    </aside>
    <div id="ccc-result" class="ccc-result" data-empty="false">
      <p id="ccc-empty" class="ccc-empty" hidden>{L.empty}</p>
      <div id="ccc-result-content" class="ccc-result-content">
  <div id="ccc-preview" class="ccc-preview" aria-live="polite">
    <span class="ccc-preview-large">{L.sampleText}</span>
    <span class="ccc-preview-small">{L.sampleText}</span>
  </div>

  <div class="ccc-summary">
    <div class="ccc-ratio-card">
      <div class="ccc-label-row"><span class="ccc-ratio-label">{L.contrastRatio}</span><Toggletip id="ccc-tip-ratio" lang={lang} about={L.contrastRatio}>{L.tips.ratio}</Toggletip></div>
      <div class="ccc-ratio-row">
        <span id="ccc-ratio-value" class="ccc-ratio-value">—</span>
        <span id="ccc-ratio-headline" class="ccc-ratio-headline"></span>
      </div>
    </div>

    <div class="ccc-status-grid">
      <div class="ccc-status-card">
        <div class="ccc-status-title">{L.bodyText}</div>
        <div class="ccc-status-hint">{L.bodyHint}</div>
        <div class="ccc-status-row">
          <span class="ccc-status-tag">{L.aa}</span>
          <span id="ccc-body-aa" class="ccc-status-result"></span>
        </div>
        <div class="ccc-status-row">
          <span class="ccc-status-tag">{L.aaa}</span>
          <span id="ccc-body-aaa" class="ccc-status-result"></span>
        </div>
      </div>

      <div class="ccc-status-card">
        <div class="ccc-status-title">{L.largeText}</div>
        <div class="ccc-status-hint">{L.largeHint}</div>
        <div class="ccc-status-row">
          <span class="ccc-status-tag">{L.aa}</span>
          <span id="ccc-large-aa" class="ccc-status-result"></span>
        </div>
        <div class="ccc-status-row">
          <span class="ccc-status-tag">{L.aaa}</span>
          <span id="ccc-large-aaa" class="ccc-status-result"></span>
        </div>
      </div>

      <div class="ccc-status-card">
        <div class="ccc-status-title">{L.uiComponent}</div>
        <div class="ccc-status-hint">{L.uiHint}</div>
        <div class="ccc-status-row">
          <span class="ccc-status-tag">{L.aa}</span>
          <span id="ccc-ui-aa" class="ccc-status-result"></span>
        </div>
        <div class="ccc-status-row">
          <span class="ccc-status-tag">{L.aaa}</span>
          <span class="ccc-status-result ccc-status-na">{L.nA}</span>
        </div>
      </div>
    </div>
  </div>
      </div>
    </div>
  </div>

  <script is:inline>
  (function () {
    var wrap = document.currentScript
      ? document.currentScript.closest('.ccc-wrap')
      : document.querySelector('.ccc-wrap');

    var COPIED  = wrap.dataset.copied;
    var COPY_FAILED = wrap.dataset.copyFailed;
    var INVALID = wrap.dataset.invalidHex;
    var NO_ALPHA = wrap.dataset.noAlpha;
    var PASS    = wrap.dataset.pass;
    var FAIL    = wrap.dataset.fail;

    var fgPicker = document.getElementById('ccc-fg-picker');
    var bgPicker = document.getElementById('ccc-bg-picker');
    var fgInput  = document.getElementById('ccc-fg-hex');
    var bgInput  = document.getElementById('ccc-bg-hex');
    var fgErr    = document.getElementById('ccc-fg-error');
    var bgErr    = document.getElementById('ccc-bg-error');
    var swapBtn  = document.getElementById('ccc-swap');
    var preview  = document.getElementById('ccc-preview');
    var ratioVal = document.getElementById('ccc-ratio-value');
    var ratioHL  = document.getElementById('ccc-ratio-headline');
    var bodyAA   = document.getElementById('ccc-body-aa');
    var bodyAAA  = document.getElementById('ccc-body-aaa');
    var largeAA  = document.getElementById('ccc-large-aa');
    var largeAAA = document.getElementById('ccc-large-aaa');
    var uiAA     = document.getElementById('ccc-ui-aa');
    var sugWrap  = document.getElementById('ccc-suggestion');
    var sugSw    = document.getElementById('ccc-suggestion-swatch');
    var sugHex   = document.getElementById('ccc-suggestion-hex');
    var sugRatio = document.getElementById('ccc-suggestion-ratio');
    var applyBtn = document.getElementById('ccc-apply-btn');
    var copyFix  = document.getElementById('ccc-copy-fixed');
    var copyStatus = document.getElementById('ccc-copy-status');
    var resultPane = document.getElementById('ccc-result');
    var resultContent = document.getElementById('ccc-result-content');
    var emptyEl = document.getElementById('ccc-empty');
    var COPY_LABEL = copyFix.textContent;
    var copyRequest = 0;
    var copyTimer = 0;

    function resetCopyFeedback() {
      copyRequest++;
      clearTimeout(copyTimer);
      copyTimer = 0;
      copyFix.textContent = COPY_LABEL;
      copyFix.classList.remove('copied');
      copyStatus.textContent = '';
      copyStatus.className = 'tool-status none';
    }

    function clearSuggestion() {
      sugWrap.hidden = true;
      applyBtn.dataset.hex = '';
      copyFix.dataset.hex = '';
      sugSw.style.background = '';
      sugHex.textContent = '';
      sugRatio.textContent = '';
      applyBtn.disabled = true;
      copyFix.disabled = true;
    }

    function suggestionHex(button) {
      var hex = button.dataset.hex;
      if (sugWrap.hidden || !isValidHex(hex)
        || !isValidHex(normalizeHex(readText(fgInput.value))) || !isValidHex(normalizeHex(readText(bgInput.value)))) return '';
      return hex;
    }

    function refreshSuggestionActions() {
      applyBtn.disabled = !suggestionHex(applyBtn);
      copyFix.disabled = !suggestionHex(copyFix);
    }

    /* Clear the ratio, badges, preview and suggestion; the input fields stay as they are. */
    function clearResult() {
      resultPane.dataset.empty = 'true';
      resultContent.hidden = true;
      emptyEl.hidden = false;
      resetCopyFeedback();
      preview.style.backgroundColor = '';
      preview.style.color = '';
      preview.hidden = true;
      ratioVal.textContent = '';
      ratioHL.textContent = '';
      ratioHL.className = 'ccc-ratio-headline';
      [bodyAA, bodyAAA, largeAA, largeAAA, uiAA].forEach(function(el) {
        el.textContent = '';
        el.className = 'ccc-status-result';
      });
      clearSuggestion();
      swapBtn.disabled = true;
    }

    function clearTool() {
      clearResult();
      fg = ''; bg = '';
      fgInput.value = ''; bgInput.value = '';
      fgInput.classList.remove('ccc-error');
      bgInput.classList.remove('ccc-error');
      fgErr.textContent = ''; bgErr.textContent = '';
    }

    var fg = '#1f2937';
    var bg = '#f9fafb';

    /* ── engine:start ── */
    /* ── Hex utilities ── */
    function normalizeHex(s) {
      s = (s || '').trim();
      if (!s) return '';
      if (!s.startsWith('#')) s = '#' + s;
      if (/^#[0-9a-fA-F]{3}$/.test(s)) {
        s = '#' + s[1] + s[1] + s[2] + s[2] + s[3] + s[3];
      }
      return s.toLowerCase();
    }
    function isValidHex(s) {
      return /^#[0-9a-fA-F]{6}$/.test(s);
    }
    function hexToRgb(hex) {
      return {
        r: parseInt(hex.slice(1, 3), 16),
        g: parseInt(hex.slice(3, 5), 16),
        b: parseInt(hex.slice(5, 7), 16),
      };
    }
    function rgbToHex(r, g, b) {
      function clamp(v) { return Math.max(0, Math.min(255, Math.round(v))); }
      return '#' + [clamp(r), clamp(g), clamp(b)].map(function (v) {
        return ('0' + v.toString(16)).slice(-2);
      }).join('');
    }

    /* ── WCAG 2 contrast ── */
    function srgbToLin(c) {
      c /= 255;
      return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
    }
    function linToSrgb(c) {
      var v = c <= 0.0031308 ? 12.92 * c : 1.055 * Math.pow(c, 1 / 2.4) - 0.055;
      return v * 255;
    }
    /* ITU-R BT.709 sRGB luminance weights (referenced by WCAG 2.x). */
    var R_LUM = 0.2126, G_LUM = 0.7152, B_LUM = 0.0722;
    function relLum(rgb) {
      return R_LUM * srgbToLin(rgb.r) + G_LUM * srgbToLin(rgb.g) + B_LUM * srgbToLin(rgb.b);
    }
    function contrast(c1, c2) {
      var l1 = relLum(c1), l2 = relLum(c2);
      var hi = Math.max(l1, l2), lo = Math.min(l1, l2);
      return (hi + 0.05) / (lo + 0.05);
    }

    /* ── OKLCH (CSS Color 4 / Björn Ottosson) for hue-preserving fix ── */
    function rgbToOklab(rgb) {
      var r = srgbToLin(rgb.r);
      var g = srgbToLin(rgb.g);
      var b = srgbToLin(rgb.b);
      var l_ = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
      var m_ = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
      var s_ = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
      return {
        L: 0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
        a: 1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
        b: 0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_,
      };
    }
    function oklabToRgb(lab) {
      var l_ = lab.L + 0.3963377774 * lab.a + 0.2158037573 * lab.b;
      var m_ = lab.L - 0.1055613458 * lab.a - 0.0638541728 * lab.b;
      var s_ = lab.L - 0.0894841775 * lab.a - 1.2914855480 * lab.b;
      var l = l_ * l_ * l_;
      var m = m_ * m_ * m_;
      var s = s_ * s_ * s_;
      return {
        r: linToSrgb( 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s),
        g: linToSrgb(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s),
        b: linToSrgb(-0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s),
      };
    }
    function rgbToOklch(rgb) {
      var lab = rgbToOklab(rgb);
      return {
        L: lab.L,
        C: Math.sqrt(lab.a * lab.a + lab.b * lab.b),
        h: Math.atan2(lab.b, lab.a),
      };
    }
    function oklchToRgb(lch) {
      return oklabToRgb({ L: lch.L, a: lch.C * Math.cos(lch.h), b: lch.C * Math.sin(lch.h) });
    }
    function clampRgb(rgb) {
      return {
        r: Math.max(0, Math.min(255, rgb.r)),
        g: Math.max(0, Math.min(255, rgb.g)),
        b: Math.max(0, Math.min(255, rgb.b)),
      };
    }

    /* WCAG compares the exact ratio with the threshold (Understanding 1.4.3:
       4.499:1 does not meet 4.5:1), so the display truncates instead of rounding. */
    function formatRatio(r) {
      return (Math.floor(r * 100 + 1e-9) / 100).toFixed(2);
    }
    function roundRgb(rgb) {
      var c = clampRgb(rgb);
      return { r: Math.round(c.r), g: Math.round(c.g), b: Math.round(c.b) };
    }

    /* Suggestion: keep hue & chroma, search lightness for target ratio.
       Tries both directions (lower/raise L) and picks the one that succeeds.
       Every trial is rounded to the 8-bit colour that will be shown and copied,
       and the ratio is measured on that rounded colour, so the suggestion
       passes as a hex value. Clamping out-of-gamut colours can make the ratio
       non-monotonic in L, so after bisection the result is checked again and,
       if needed, L is stepped further until the rounded colour passes.
       BISECTION_ITERS = 22 resolves L to ~2.4e-7, far below one 8-bit step. */
    var BISECTION_ITERS = 22;
    var WALK_STEP = 1 / 512;
    function suggestFix(fgRgb, bgRgb, target) {
      var fgLch = rgbToOklch(fgRgb);
      var directions = [-1, 1];
      var best = null;
      function at(L) { return roundRgb(oklchToRgb({ L: L, C: fgLch.C, h: fgLch.h })); }

      for (var d = 0; d < directions.length; d++) {
        var dir = directions[d];
        var startL = fgLch.L;
        var endL = dir < 0 ? 0 : 1;
        var lo = startL, hi = endL;

        // Bisect: find smallest L delta from start that meets target.
        for (var i = 0; i < BISECTION_ITERS; i++) {
          var mid = (lo + hi) / 2;
          if (contrast(at(mid), bgRgb) >= target) {
            hi = mid;
          } else {
            lo = mid;
          }
        }

        var finalL = hi;
        var finalRgb = at(finalL);
        var actualRatio = contrast(finalRgb, bgRgb);
        while (actualRatio < target && finalL !== endL) {
          finalL = dir < 0 ? Math.max(0, finalL - WALK_STEP) : Math.min(1, finalL + WALK_STEP);
          finalRgb = at(finalL);
          actualRatio = contrast(finalRgb, bgRgb);
        }
        if (actualRatio >= target) {
          var deltaL = Math.abs(finalL - startL);
          if (!best || deltaL < best.deltaL) {
            best = { rgb: finalRgb, ratio: actualRatio, deltaL: deltaL };
          }
        }
      }

      if (!best) {
        var black = { r: 0, g: 0, b: 0 };
        var white = { r: 255, g: 255, b: 255 };
        var rb = contrast(black, bgRgb);
        var rw = contrast(white, bgRgb);
        best = rb > rw ? { rgb: black, ratio: rb } : { rgb: white, ratio: rw };
      }
      return best;
    }

    /* ── engine:end ── */

    /* ── DOM update ── */
    function setStatus(el, ratio, threshold) {
      if (ratio >= threshold) {
        el.textContent = PASS;
        el.className = 'ccc-status-result ccc-pass';
      } else {
        el.textContent = FAIL;
        el.className = 'ccc-status-result ccc-fail';
      }
    }

    function update() {
      if (!isValidHex(fg) || !isValidHex(bg)) return;
      var fgRgb = hexToRgb(fg);
      var bgRgb = hexToRgb(bg);
      var ratio = contrast(fgRgb, bgRgb);

      preview.style.backgroundColor = bg;
      preview.style.color = fg;

      ratioVal.textContent = formatRatio(ratio) + ' : 1';

      var headline = ratio >= 7 ? 'AAA' : ratio >= 4.5 ? 'AA' : null;
      if (headline) {
        ratioHL.textContent = headline;
        ratioHL.className = 'ccc-ratio-headline ccc-ratio-pass';
      } else {
        ratioHL.textContent = FAIL;
        ratioHL.className = 'ccc-ratio-headline ccc-ratio-fail';
      }

      setStatus(bodyAA,   ratio, 4.5);
      setStatus(bodyAAA,  ratio, 7);
      setStatus(largeAA,  ratio, 3);
      setStatus(largeAAA, ratio, 4.5);
      setStatus(uiAA,     ratio, 3);

      preview.hidden = false;
      resultPane.dataset.empty = 'false';
      resultContent.hidden = false;
      emptyEl.hidden = true;
      swapBtn.disabled = false;

      if (ratio < 4.5) {
        var fix = suggestFix(fgRgb, bgRgb, 4.5);
        var hex = rgbToHex(fix.rgb.r, fix.rgb.g, fix.rgb.b);
        sugSw.style.background = hex;
        sugHex.textContent = hex.toUpperCase();
        sugRatio.textContent = '→ ' + formatRatio(fix.ratio) + ' : 1';
        sugWrap.hidden = false;
        applyBtn.dataset.hex = hex;
        copyFix.dataset.hex = hex;
      } else {
        clearSuggestion();
      }
      refreshSuggestionActions();
    }

    /* ── Wiring ── */
    /* Text as the HEX fields read it: NFKC turns IME full-width input (＃１Ｆ２９３７) into ASCII. */
    function readText(value) {
      return String(value || '').normalize('NFKC');
    }

    /* Message for text that is not a valid colour, or '' when there is nothing to report yet.
       While typing (not committed), 1-5 or 7 hex digits and fewer than 3 other characters are
       partial input; on change they are judged. 4 and 8 hex digits are an alpha channel. */
    function judge(text, committed) {
      var body = text.trim().replace(/^#/, '');
      if (!body) return '';
      if (/^[0-9a-fA-F]+$/.test(body)) {
        if (body.length === 8) return NO_ALPHA;
        if (!committed && (body.length < 6 || body.length === 7)) return '';
        return body.length === 4 ? NO_ALPHA : INVALID;
      }
      return !committed && body.length < 3 ? '' : INVALID;
    }

    function setSide(side, value, source, committed) {
      resetCopyFeedback();
      var text = readText(value);
      var v = normalizeHex(text);
      var picker = side === 'fg' ? fgPicker : bgPicker;
      var input  = side === 'fg' ? fgInput  : bgInput;
      var errEl  = side === 'fg' ? fgErr    : bgErr;

      if (isValidHex(v)) {
        if (side === 'fg') fg = v; else bg = v;
        if (source !== 'picker') picker.value = v;
        if (source !== 'input')  input.value = v.toUpperCase();
        input.classList.remove('ccc-error');
        errEl.textContent = '';
        update();
      } else if (source === 'input' && judge(text, committed)) {
        /* An invalid colour clears the old result instead of leaving it on screen. */
        input.classList.add('ccc-error');
        errEl.textContent = judge(text, committed);
        if (side === 'fg') fg = ''; else bg = '';
        clearResult();
      } else if (source === 'input') {
        input.classList.remove('ccc-error');
        errEl.textContent = '';
      }
      refreshSuggestionActions();
    }

    fgPicker.addEventListener('input', function () { setSide('fg', fgPicker.value, 'picker'); });
    bgPicker.addEventListener('input', function () { setSide('bg', bgPicker.value, 'picker'); });
    fgInput.addEventListener('input',  function () { setSide('fg', fgInput.value,  'input');  });
    bgInput.addEventListener('input',  function () { setSide('bg', bgInput.value,  'input');  });

    /* Analytics: one event per committed change (as in css-triangle-generator), not per input event. */
    function trackCheck() {
      if (isValidHex(fg) && isValidHex(bg)) window.trackTool && window.trackTool('color-contrast-checker', 'check');
    }
    fgPicker.addEventListener('change', trackCheck);
    bgPicker.addEventListener('change', trackCheck);
    fgInput.addEventListener('change', function () {
      if (isValidHex(normalizeHex(readText(fgInput.value)))) trackCheck(); else setSide('fg', fgInput.value, 'input', true);
    });
    bgInput.addEventListener('change', function () {
      if (isValidHex(normalizeHex(readText(bgInput.value)))) trackCheck(); else setSide('bg', bgInput.value, 'input', true);
    });

    swapBtn.addEventListener('click', function () {
      if (!isValidHex(fg) || !isValidHex(bg)) return;
      resetCopyFeedback();
      var oldFg = fg, oldBg = bg;
      fg = oldBg; bg = oldFg;
      fgPicker.value = fg; bgPicker.value = bg;
      fgInput.value  = fg.toUpperCase();
      bgInput.value  = bg.toUpperCase();
      fgInput.classList.remove('ccc-error');
      bgInput.classList.remove('ccc-error');
      fgErr.textContent = '';
      bgErr.textContent = '';
      update();
      window.trackTool && window.trackTool('color-contrast-checker', 'swap');
    });

    applyBtn.addEventListener('click', function () {
      var hex = suggestionHex(applyBtn);
      if (!hex) return;
      resetCopyFeedback();
      fg = hex.toLowerCase();
      fgPicker.value = fg;
      fgInput.value  = fg.toUpperCase();
      fgInput.classList.remove('ccc-error');
      fgErr.textContent = '';
      update();
      window.trackTool && window.trackTool('color-contrast-checker', 'apply');
    });

    copyFix.addEventListener('click', function () {
      var hex = suggestionHex(copyFix);
      if (!hex) return;
      resetCopyFeedback();
      var request = copyRequest;
      var text = hex.toUpperCase();
      /* Hidden textarea + execCommand('copy') when the Clipboard API is missing, throws or
         rejects (as in color-palette-generator); focus returns to the Copy button. */
      function fallback() {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.body.removeChild(ta);
        copyFix.focus();
        if (!ok) throw new Error('copy fallback failed');
      }
      var task;
      try {
        task = navigator.clipboard
          ? navigator.clipboard.writeText(text)
          : Promise.reject(new Error('clipboard unavailable'));
      } catch (error) {
        task = Promise.reject(error);
      }
      task.catch(function (error) {
        if (request !== copyRequest) throw error;
        fallback();
      }).then(function () {
        if (request !== copyRequest) return;
        copyFix.textContent = COPIED;
        copyFix.classList.add('copied');
        copyTimer = setTimeout(function () {
          if (request !== copyRequest) return;
          copyTimer = 0;
          copyFix.textContent = COPY_LABEL;
          copyFix.classList.remove('copied');
        }, 1400);
        window.trackTool && window.trackTool('color-contrast-checker', 'copy_fix');
      }).catch(function () {
        if (request !== copyRequest) return;
        copyStatus.textContent = COPY_FAILED;
        copyStatus.className = 'tool-status error';
      });
    });

    document.addEventListener('keydown', function(event) {
      if (!(event.ctrlKey || event.metaKey) || event.key.toLowerCase() !== 'l') return;
      if (!document.activeElement || !wrap.contains(document.activeElement)) return;
      event.preventDefault();
      clearTool();
    });

    fgInput.value = fg.toUpperCase();
    bgInput.value = bg.toUpperCase();
    update();
  })();
  </script>
</div>

