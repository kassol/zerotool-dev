// (OpenAI o200k_base / cl100k_base, DeepSeek V4) and estimate API cost from official prices.
// Vocabularies are loaded on demand as separate chunks; text never leaves the page.
interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;

