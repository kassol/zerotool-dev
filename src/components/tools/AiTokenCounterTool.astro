const SAMPLES = {
  en: [
    'You are a senior engineer reviewing a pull request that adds a Redis read-through cache in front of a Postgres analytics database.',
    '',
    'The cache uses a 60-second TTL on every aggregate query. The author expects p99 latency to fall from 1200 ms to under 50 ms for a dashboard that serves 12k requests per minute.',
    '',
    'List the two highest-risk failure modes, say whether 60 seconds suits a financial reporting dashboard, and name one metric to add before merging. Keep each item under 80 words.',
  ].join('\n'),
  zh: [
    '你是一名资深后端工程师，正在评审一个合并请求：在 PostgreSQL 分析库前面加一层 Redis 读穿缓存。',
    '',
    '所有聚合查询的缓存时间都是 60 秒。作者预计看板接口的 p99 延迟会从 1200 毫秒降到 50 毫秒以下，高峰期每分钟 1.2 万次请求。',
    '',
    '请列出两个风险最高的故障场景，判断 60 秒是否适合财务报表看板，并给出合并前应加的一项监控指标。每条不超过 80 字。',
  ].join('\n'),
  ja: [
    'あなたはシニアエンジニアとして、PostgreSQL の分析用 DB の前に Redis のリードスルーキャッシュを追加するプルリクエストをレビューしています。',
    '',
    '集計クエリはすべて 60 秒でキャッシュされます。作成者は、ピーク時に毎分 1.2 万リクエストを受けるダッシュボードの p99 レイテンシが 1200 ms から 50 ms 未満に下がると見込んでいます。',
    '',
    'リスクの高い障害パターンを 2 つ挙げ、60 秒が財務レポートのダッシュボードに適切か判断し、マージ前に追加すべき監視指標を 1 つ示してください。各項目は 80 字以内で。',
  ].join('\n'),
  ko: [
    '당신은 PostgreSQL 분석 DB 앞에 Redis 리드스루 캐시를 추가하는 풀 리퀘스트를 검토하는 시니어 엔지니어입니다.',
    '',
    '모든 집계 쿼리는 60초 동안 캐시됩니다. 작성자는 피크 시 분당 1.2만 건의 요청을 받는 대시보드의 p99 지연 시간이 1200ms에서 50ms 미만으로 줄어든다고 예상합니다.',
    '',
    '위험이 가장 큰 장애 시나리오 두 가지를 들고, 60초가 재무 보고 대시보드에 적절한지 판단하고, 병합 전에 추가할 모니터링 지표 하나를 제시하세요. 각 항목은 80자 이내로 작성하세요.',
  ].join('\n'),
};
/* ── strings:end ── */

const L = (STRINGS as Record<string, typeof STRINGS.en>)[lang] || STRINGS.en;
const sample = (SAMPLES as Record<string, string>)[lang] || SAMPLES.en;
---

<div class="atc-wrap" data-lang={lang} data-strings={JSON.stringify(L)} data-sample={sample}>
  <div class="atc-input-head">
    <label for="atc-input" class="tool-label atc-input-label">{L.inputLabel}</label>
    <div class="atc-actions">
      <button id="atc-sample" class="btn-ghost" type="button">{L.sample}</button>
      <label class="btn-ghost atc-open">
        {L.openFile}
        <input type="file" id="atc-file" class="atc-sr" accept=".txt,.md,.markdown,.json,.jsonl,.csv,.tsv,.yaml,.yml,.xml,.html,.js,.ts,.py,.go,.rs,.java,.c,.cpp,.h,.sql,.log,text/*" />
      </label>
      <button id="atc-clear" class="btn-ghost" type="button">{L.clear}</button>
    </div>
  </div>
  <textarea
    id="atc-input"
    class="tool-textarea atc-input"
    rows="6"
    spellcheck="false"
    autocapitalize="off"
    autocorrect="off"
    placeholder={L.placeholder}
  ></textarea>
  <div class="atc-stats" aria-live="polite">
    <span><strong id="atc-chars">0</strong> {L.statChars}</span>
    <span><strong id="atc-bytes">0</strong> {L.statBytes}</span>
    <span><strong id="atc-words">0</strong> {L.statWords}</span>
    <span><strong id="atc-lines">0</strong> {L.statLines}</span>
  </div>

  <div class="atc-cards">
    <article class="atc-card" data-enc="o200k">
      <header class="atc-card-head">
        <h3 class="atc-card-title">o200k_base</h3>
        <span class="atc-tag atc-tag--exact">{L.exact}</span>
      </header>
      <p class="atc-card-count"><span class="atc-num" id="atc-n-o200k">—</span> <span class="atc-unit">{L.tokens}</span></p>
      <p class="atc-card-ratio" id="atc-r-o200k"></p>
      <p class="atc-card-models">{L.o200kModels}</p>
    </article>
    <article class="atc-card" data-enc="deepseek">
      <header class="atc-card-head">
        <h3 class="atc-card-title">DeepSeek V4</h3>
        <span class="atc-tag atc-tag--exact">{L.exact}</span>
      </header>
      <p class="atc-card-count"><span class="atc-num" id="atc-n-deepseek">—</span> <span class="atc-unit">{L.tokens}</span></p>
      <p class="atc-card-ratio" id="atc-r-deepseek"></p>
      <button type="button" class="btn-secondary atc-load" data-load="deepseek" hidden></button>
      <p class="atc-card-models">{L.deepseekModels}</p>
    </article>
    <article class="atc-card" data-enc="cl100k">
      <header class="atc-card-head">
        <h3 class="atc-card-title">cl100k_base</h3>
        <span class="atc-tag atc-tag--exact">{L.exact}</span>
      </header>
      <p class="atc-card-count"><span class="atc-num" id="atc-n-cl100k">—</span> <span class="atc-unit">{L.tokens}</span></p>
      <p class="atc-card-ratio" id="atc-r-cl100k"></p>
      <button type="button" class="btn-secondary atc-load" data-load="cl100k" hidden></button>
      <p class="atc-card-models">{L.cl100kModels}</p>
    </article>
    <article class="atc-card atc-card--other">
      <header class="atc-card-head">
        <h3 class="atc-card-title">{L.otherTitle}</h3>
        <span class="atc-tag atc-tag--other">{L.notLocal}</span>
      </header>
      <p class="atc-card-models">{L.otherBody}</p>
    </article>
  </div>
  <p id="atc-status" class="atc-status" role="status" aria-live="polite">{L.idle}</p>

  <section class="atc-cost" aria-labelledby="atc-cost-h">
    <div class="atc-cost-head">
      <h2 id="atc-cost-h" class="atc-h2">{L.costHeading}</h2>
      <label class="atc-out">
        <span>{L.outputLabel}</span>
        <input id="atc-out" type="number" class="tool-input atc-out-input" min="0" step="1" value="1000" inputmode="numeric" />
      </label>
    </div>
    <div class="atc-table-wrap">
      <table class="atc-table">
        <thead>
          <tr>
            <th scope="col">{L.colModel}</th>
            <th scope="col" class="atc-r">{L.colTokens}</th>
            <th scope="col" class="atc-r">{L.colContext}</th>
            <th scope="col" class="atc-r">{L.colInput}</th>
            <th scope="col" class="atc-r">{L.colOutput}</th>
            <th scope="col" class="atc-r">{L.colTotal}</th>
          </tr>
        </thead>
        <tbody id="atc-tbody"></tbody>
      </table>
    </div>
    <p class="atc-note">{L.refNote}</p>
    <p class="atc-note" id="atc-price-note"></p>
  </section>

  <section class="atc-viz" aria-labelledby="atc-viz-h">
    <div class="atc-viz-head">
      <h2 id="atc-viz-h" class="atc-h2">{L.vizHeading}</h2>
      <label class="atc-viz-opt">
        <span>{L.vizTokenizer}</span>
        <select id="atc-viz-enc" class="tool-input atc-viz-select">
          <option value="o200k">o200k_base</option>
          <option value="deepseek">DeepSeek V4</option>
          <option value="cl100k">cl100k_base</option>
        </select>
      </label>
      <label class="atc-viz-opt atc-viz-check">
        <input type="checkbox" id="atc-viz-ids" />
        <span>{L.vizShowIds}</span>
      </label>
    </div>
    <p class="atc-note">{L.vizHint}</p>
    <p class="atc-note" id="atc-viz-meta"></p>
    <div id="atc-viz" class="atc-viz-body"></div>
  </section>

  <div class="atc-foot">
    <button id="atc-copy" class="btn-secondary" type="button">{L.copyStats}</button>
  </div>
</div>

<script>
  /* ── engine:start ── */
  // Unicode White_Space (PropList.txt). OpenAI's tiktoken (Rust regex) and Hugging Face tokenizers
  // (Oniguruma) both read \s as this set; JavaScript's \s adds U+FEFF and leaves out U+0085, so a
  // byte-order mark or NEL would split differently. Rewriting \s and \S makes the browser regex
  // match the reference implementations.
  var WHITE_SPACE = '\\t-\\r \\x85\\xA0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000';

  function unicodeWhiteSpace(pattern) {
    var out = '';
    var inClass = false;
    for (var i = 0; i < pattern.length; i++) {
      var ch = pattern[i];
      if (ch === '\\') {
        var nx = pattern[i + 1];
        if (nx === 's') { out += inClass ? WHITE_SPACE : '[' + WHITE_SPACE + ']'; i++; continue; }
        if (nx === 'S') {
          if (inClass) throw new Error('\\S inside a character class is not supported');
          out += '[^' + WHITE_SPACE + ']';
          i++;
          continue;
        }
        out += ch + (nx === undefined ? '' : nx);
        i++;
        continue;
      }
      if (ch === '[' && !inClass) inClass = true;
      else if (ch === ']' && inClass) inClass = false;
      out += ch;
    }
    return out;
  }

  function base64ToBytes(b64) {
    var bin = atob(b64);
    var out = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
    return out;
  }

  // Min-heap of (rank, position) pairs; ties go to the lower position. Both tiktoken and
  // tokenizers merge the lowest-ranked pair first and, among equal ranks, the leftmost one.
  function createHeap() {
    var r = []; var p = []; var e = [];
    function less(i, j) { return r[i] < r[j] || (r[i] === r[j] && p[i] < p[j]); }
    function swap(i, j) {
      var t = r[i]; r[i] = r[j]; r[j] = t;
      t = p[i]; p[i] = p[j]; p[j] = t;
      t = e[i]; e[i] = e[j]; e[j] = t;
    }
    return {
      size: function () { return r.length; },
      push: function (rank, pos, extra) {
        r.push(rank); p.push(pos); e.push(extra);
        var i = r.length - 1;
        while (i > 0) {
          var pa = (i - 1) >> 1;
          if (!less(i, pa)) break;
          swap(i, pa); i = pa;
        }
      },
      pop: function () {
        var top = [r[0], p[0], e[0]];
        var last = r.length - 1;
        swap(0, last);
        r.pop(); p.pop(); e.pop();
        var i = 0; var n = r.length;
        for (;;) {
          var c = 2 * i + 1;
          if (c >= n) break;
          if (c + 1 < n && less(c + 1, c)) c++;
          if (!less(c, i)) break;
          swap(c, i); i = c;
        }
        return top;
      },
    };
  }

  // tiktoken encodings (o200k_base, cl100k_base). Same algorithm as tiktoken's byte_pair_encode:
  // a regex piece that is itself a token stays whole; otherwise merge the adjacent pair whose
  // concatenation has the lowest rank until no pair is a token. js-tiktoken implements this with a
  // linear scan per merge, which takes minutes on a 20,000-character run of CJK text; the heap keeps
  // it O(n log n).
  function createTiktokenEncoding(name, ranks) {
    var rankOf = new Map();
    var bytesOf = [];
    var lines = ranks.bpe_ranks.split('\n');
    for (var li = 0; li < lines.length; li++) {
      if (!lines[li]) continue;
      var parts = lines[li].split(' ');
      var offset = parseInt(parts[1], 10);
      for (var k = 2; k < parts.length; k++) {
        var bin = atob(parts[k]);
        rankOf.set(bin, offset + k - 2);
        var bytes = new Uint8Array(bin.length);
        for (var b = 0; b < bin.length; b++) bytes[b] = bin.charCodeAt(b);
        bytesOf[offset + k - 2] = bytes;
      }
    }
    var pattern = new RegExp(unicodeWhiteSpace(ranks.pat_str), 'gu');
    var encoder = new TextEncoder();

    function latin1(bytes) {
      var s = '';
      for (var i = 0; i < bytes.length; i += 4096) s += String.fromCharCode.apply(null, bytes.subarray(i, i + 4096));
      return s;
    }

    function merge(s, out) {
      var n = s.length;
      var whole = rankOf.get(s);
      if (whole !== undefined) { out.push(whole); return; }
      var next = new Int32Array(n); var prev = new Int32Array(n); var alive = new Uint8Array(n);
      for (var i = 0; i < n; i++) { next[i] = i + 1 < n ? i + 1 : -1; prev[i] = i - 1; alive[i] = 1; }
      var endOf = function (i) { return next[i] < 0 ? n : next[i]; };
      var heap = createHeap();
      for (var j = 0; j + 1 < n; j++) {
        var r = rankOf.get(s.slice(j, j + 2));
        if (r !== undefined) heap.push(r, j, j + 2);
      }
      while (heap.size()) {
        var top = heap.pop();
        var a = top[1];
        if (!alive[a] || next[a] < 0) continue;
        var q = next[a];
        if (endOf(q) !== top[2]) continue;
        alive[q] = 0;
        next[a] = next[q];
        if (next[q] >= 0) prev[next[q]] = a;
        var pa = prev[a];
        if (pa >= 0) {
          var r1 = rankOf.get(s.slice(pa, endOf(a)));
          if (r1 !== undefined) heap.push(r1, pa, endOf(a));
        }
        if (next[a] >= 0) {
          var r2 = rankOf.get(s.slice(a, endOf(next[a])));
          if (r2 !== undefined) heap.push(r2, a, endOf(next[a]));
        }
      }
      for (var x = 0; x >= 0; x = next[x]) out.push(rankOf.get(s.slice(x, endOf(x))));
    }

    return {
      name: name,
      // Special tokens such as <|endoftext|> are counted as ordinary text, like tiktoken's
      // encode_ordinary. The API treats them as text in user content.
      pieces: function (text) {
        pattern.lastIndex = 0;
        return text.match(pattern) || [];
      },
      encodePiece: function (piece, out) { merge(latin1(encoder.encode(piece)), out); },
      tokenBytes: function (id) { return bytesOf[id] || new Uint8Array(0); },
    };
  }

  // DeepSeek V4 (Hugging Face tokenizers format): added tokens are matched first, then three
  // "Isolated" regex splits run in sequence, then byte-level BPE applies merges by merge rank.
  // The data module is generated from DeepSeek's official tokenizer.json by
  // scripts/build-deepseek-tokenizer.mjs.
  function createHfBpeEncoding(name, mod) {
    var raw = base64ToBytes(mod.DATA);
    var read = function (i) { return (raw[i * 3] << 16) | (raw[i * 3 + 1] << 8) | raw[i * 3 + 2]; };
    var byteIds = new Int32Array(256);
    for (var b = 0; b < 256; b++) byteIds[b] = read(b);
    var count = mod.MERGE_COUNT;
    var first = mod.FIRST_MERGE_ID;
    var left = new Int32Array(count);
    var right = new Int32Array(count);
    var SHIFT = 1 << 21;
    if (mod.VOCAB_SIZE > SHIFT) throw new Error('vocabulary too large for the pair key');
    var pairRank = new Map();
    for (var i = 0; i < count; i++) {
      left[i] = read(256 + i * 2);
      right[i] = read(256 + i * 2 + 1);
      pairRank.set(left[i] * SHIFT + right[i], i);
    }
    var byteOfId = new Map();
    for (var bb = 0; bb < 256; bb++) byteOfId.set(byteIds[bb], bb);
    var addedText = new Map();
    var added = mod.ADDED_TOKENS.slice().sort(function (x, y) { return y[1].length - x[1].length; });
    var firstChars = new Set();
    added.forEach(function (a) { firstChars.add(a[1][0]); addedText.set(a[0], a[1]); });
    var splitters = mod.SPLIT_PATTERNS.map(function (p) { return new RegExp(unicodeWhiteSpace(p), 'gu'); });
    var encoder = new TextEncoder();
    var bytesCache = new Map();

    function splitAll(pieces, re) {
      var out = [];
      for (var i = 0; i < pieces.length; i++) {
        var piece = pieces[i];
        re.lastIndex = 0;
        var last = 0; var m;
        while ((m = re.exec(piece)) !== null) {
          if (m[0].length === 0) { re.lastIndex++; continue; }
          if (m.index > last) out.push(piece.slice(last, m.index));
          out.push(m[0]);
          last = m.index + m[0].length;
        }
        if (last < piece.length) out.push(piece.slice(last));
      }
      return out;
    }

    function merge(bytes, out) {
      var n = bytes.length;
      if (n === 1) { out.push(byteIds[bytes[0]]); return; }
      var ids = new Int32Array(n); var next = new Int32Array(n); var prev = new Int32Array(n); var alive = new Uint8Array(n);
      for (var i = 0; i < n; i++) { ids[i] = byteIds[bytes[i]]; next[i] = i + 1 < n ? i + 1 : -1; prev[i] = i - 1; alive[i] = 1; }
      var heap = createHeap();
      for (var j = 0; j + 1 < n; j++) {
        var r = pairRank.get(ids[j] * SHIFT + ids[j + 1]);
        if (r !== undefined) heap.push(r, j, 0);
      }
      while (heap.size()) {
        var top = heap.pop();
        var rank = top[0]; var a = top[1];
        if (!alive[a]) continue;
        var q = next[a];
        if (q < 0 || left[rank] !== ids[a] || right[rank] !== ids[q]) continue;
        ids[a] = first + rank;
        alive[q] = 0;
        next[a] = next[q];
        if (next[q] >= 0) prev[next[q]] = a;
        var pa = prev[a];
        if (pa >= 0) {
          var r1 = pairRank.get(ids[pa] * SHIFT + ids[a]);
          if (r1 !== undefined) heap.push(r1, pa, 0);
        }
        if (next[a] >= 0) {
          var r2 = pairRank.get(ids[a] * SHIFT + ids[next[a]]);
          if (r2 !== undefined) heap.push(r2, a, 0);
        }
      }
      for (var x = 0; x >= 0; x = next[x]) out.push(ids[x]);
    }

    function plainPieces(text, out) {
      var pieces = [text];
      for (var s = 0; s < splitters.length; s++) pieces = splitAll(pieces, splitters[s]);
      for (var i = 0; i < pieces.length; i++) out.push(pieces[i]);
    }

    function tokenBytes(id) {
      var hit = bytesCache.get(id);
      if (hit) return hit;
      var result;
      if (addedText.has(id)) result = encoder.encode(addedText.get(id));
      else if (byteOfId.has(id)) result = new Uint8Array([byteOfId.get(id)]);
      else if (id >= first && id < first + count) {
        var l = tokenBytes(left[id - first]); var rr = tokenBytes(right[id - first]);
        result = new Uint8Array(l.length + rr.length);
        result.set(l, 0); result.set(rr, l.length);
      } else result = new Uint8Array(0);
      bytesCache.set(id, result);
      return result;
    }

    return {
      name: name,
      // Pieces are strings, except added tokens (such as <｜User｜>), which are their token id.
      // The official tokenizer.json recognises them inside the text, so they count as 1 token.
      pieces: function (text) {
        var out = [];
        var start = 0;
        var i = 0;
        while (i < text.length) {
          if (firstChars.has(text[i])) {
            var hit = null;
            for (var k = 0; k < added.length; k++) {
              if (text.startsWith(added[k][1], i)) { hit = added[k]; break; }
            }
            if (hit) {
              if (i > start) plainPieces(text.slice(start, i), out);
              out.push(hit[0]);
              i += hit[1].length;
              start = i;
              continue;
            }
          }
          i++;
        }
        if (start < text.length) plainPieces(text.slice(start), out);
        return out;
      },
      encodePiece: function (piece, out) {
        if (typeof piece === 'number') { out.push(piece); return; }
        merge(encoder.encode(piece), out);
      },
      tokenBytes: tokenBytes,
    };
  }

  // Encode everything at once (tests, small inputs). The page uses encodeSteps() instead.
  function encodeAll(enc, text) {
    var pieces = enc.pieces(text);
    var out = [];
    for (var i = 0; i < pieces.length; i++) enc.encodePiece(pieces[i], out);
    return out;
  }

  // Encode in slices so a large input does not block the page: returns a function that encodes up
  // to `budgetMs` of work and reports { done, ids, progress }.
  function encodeSteps(enc, text, now) {
    var pieces = enc.pieces(text);
    var ids = [];
    var i = 0;
    var cache = new Map();
    return function step(budgetMs) {
      var t0 = now();
      while (i < pieces.length) {
        var piece = pieces[i++];
        if (typeof piece === 'string' && piece.length <= 32) {
          var hit = cache.get(piece);
          if (!hit) { hit = []; enc.encodePiece(piece, hit); if (cache.size < 100000) cache.set(piece, hit); }
          for (var k = 0; k < hit.length; k++) ids.push(hit[k]);
        } else {
          enc.encodePiece(piece, ids);
        }
        if ((i & 255) === 0 && now() - t0 > budgetMs) break;
      }
      return { done: i >= pieces.length, ids: ids, progress: pieces.length ? i / pieces.length : 1 };
    };
  }

  var wordSegmenter = null;
  function textStats(text) {
    var chars = 0;
    for (var _c of text) chars++;
    var bytes = new TextEncoder().encode(text).length;
    var words = 0;
    if (text) {
      if (typeof Intl !== 'undefined' && Intl.Segmenter) {
        if (!wordSegmenter) wordSegmenter = new Intl.Segmenter(undefined, { granularity: 'word' });
        for (var seg of wordSegmenter.segment(text)) if (seg.isWordLike) words++;
      } else {
        var m = text.match(/\S+/g);
        words = m ? m.length : 0;
      }
    }
    var lines = text ? text.split(/\r\n|\r|\n/).length : 0;
    return { chars: chars, bytes: bytes, words: words, lines: lines };
  }

  // Prices: USD per 1M tokens, standard tier, uncached input. Checked 2026-10-01 on
  // developers.openai.com/api/docs/pricing, platform.claude.com/docs/en/about-claude/pricing,
  // ai.google.dev/gemini-api/docs/pricing and api-docs.deepseek.com/quick_start/pricing (USD) /
  // api-docs.deepseek.com/zh-cn/quick_start/pricing (CNY). Context: input limit from each model page.
  // enc: the tokenizer that gives this model's exact count; ref: no local tokenizer, use o200k as a
  // reference. long: price for the whole request when input tokens exceed `over`.
  var PRICES_CHECKED = '2026-10-01';
  var PRICE_SOURCES = [
    ['OpenAI', 'https://developers.openai.com/api/docs/pricing'],
    ['Anthropic', 'https://platform.claude.com/docs/en/about-claude/pricing'],
    ['Google', 'https://ai.google.dev/gemini-api/docs/pricing'],
    ['DeepSeek', 'https://api-docs.deepseek.com/quick_start/pricing'],
  ];
  var MODELS = [
    { id: 'gpt-6-sol', provider: 'OpenAI', enc: 'ref', input: 2, output: 10, limit: 922000, long: { over: 272000, input: 4, output: 15 } },
    { id: 'gpt-6-luna', provider: 'OpenAI', enc: 'ref', input: 0.1, output: 0.5, limit: 922000, long: { over: 272000, input: 0.2, output: 0.75 } },
    { id: 'gpt-5.5', provider: 'OpenAI', enc: 'o200k', input: 5, output: 30, limit: 1050000, long: { over: 272000, input: 10, output: 45 } },
    { id: 'gpt-5.4-mini', provider: 'OpenAI', enc: 'o200k', input: 0.75, output: 4.5, limit: 272000 },
    { id: 'gpt-4.1', provider: 'OpenAI', enc: 'o200k', input: 2, output: 8, limit: 1047576 },
    { id: 'gpt-4o', provider: 'OpenAI', enc: 'o200k', input: 2.5, output: 10, limit: 128000 },
    { id: 'text-embedding-3-small', provider: 'OpenAI', enc: 'cl100k', input: 0.02, output: null, limit: 8192 },
    { id: 'claude-opus-5-5', provider: 'Anthropic', enc: 'ref', input: 4, output: 20, limit: 1000000 },
    { id: 'claude-sonnet-5-5', provider: 'Anthropic', enc: 'ref', input: 2, output: 10, limit: 1000000 },
    { id: 'claude-haiku-4-5', provider: 'Anthropic', enc: 'ref', input: 1, output: 5, limit: 200000 },
    { id: 'gemini-3.8-flash', provider: 'Google', enc: 'ref', input: 0.75, output: 3.75, limit: 1048576 },
    { id: 'gemini-3.1-pro-preview', provider: 'Google', enc: 'ref', input: 2, output: 12, limit: 1048576, long: { over: 200000, input: 4, output: 18 } },
    { id: 'deepseek-flash', provider: 'DeepSeek', enc: 'deepseek', input: 0.3, output: 1.2, limit: 1000000, offPeak: 0.5, cny: { input: 2, output: 8 } },
    { id: 'deepseek-v4-pro', provider: 'DeepSeek', enc: 'deepseek', input: 1.32, output: 3.96, limit: 1000000, offPeak: 0.5, cny: { input: 9, output: 27 } },
  ];

  // Cost of one request. Returns null parts when the model has no output price.
  function costFor(model, inputTokens, outputTokens, currency) {
    var rate = currency === 'CNY' && model.cny ? model.cny : model;
    var inRate = rate.input;
    var outRate = rate.output;
    var longApplied = false;
    if (model.long && inputTokens > model.long.over && currency !== 'CNY') {
      inRate = model.long.input; outRate = model.long.output; longApplied = true;
    }
    var input = inputTokens * inRate / 1e6;
    var output = outRate == null ? null : outputTokens * outRate / 1e6;
    return { input: input, output: output, total: input + (output || 0), long: longApplied, over: inputTokens > model.limit };
  }

  // Money with at most 4 significant digits (the inputs are exact; the prices are not finer than
  // that), and never in exponent form.
  function formatMoney(value, symbol) {
    if (value == null) return '—';
    if (value === 0) return symbol + '0';
    if (value < 0.000001) return '<' + symbol + '0.000001';
    var digits = value >= 1 ? 2 : Math.min(8, Math.max(2, 3 - Math.floor(Math.log10(value))));
    var f = Math.pow(10, digits);
    // Scale by (1 + 1e-12) so binary rounding (3.045 is stored as 3.04499…) rounds half up.
    var rounded = Math.round(value * f * (1 + 1e-12)) / f;
    return symbol + rounded.toFixed(digits).replace(/(\.\d*?[1-9])0+$/, '$1').replace(/\.0+$/, '');
  }

  function formatPercent(part, whole) {
    if (!whole) return '—';
    var p = part / whole * 100;
    if (p === 0) return '0%';
    if (p < 0.01) return '<0.01%';
    return (p < 10 ? p.toFixed(2) : p < 100 ? p.toFixed(1) : p.toFixed(0)) + '%';
  }

  // How a token shows in the token view: its text when its bytes are complete UTF-8, otherwise the
  // bytes in hex inside ⟨⟩ (a character split across tokens, common for CJK and emoji in cl100k).
  var strictDecoder = null;
  function tokenLabel(bytes) {
    if (!strictDecoder) strictDecoder = new TextDecoder('utf-8', { fatal: true });
    try {
      var s = strictDecoder.decode(bytes);
      return { text: s.replace(/ /g, '\u00B7').replace(/\r/g, '\u240D').replace(/\n/g, '\u21B5').replace(/\t/g, '\u2192'), partial: false };
    } catch (e) {
      var hex = [];
      for (var i = 0; i < bytes.length; i++) hex.push(bytes[i].toString(16).padStart(2, '0'));
      return { text: '\u27E8' + hex.join(' ') + '\u27E9', partial: true };
    }
  }

  function fill(template, values) {
    return template.replace(/\{(\w+)\}/g, function (m, k) { return values[k] != null ? String(values[k]) : m; });
  }
  /* ── engine:end ── */

  const SLUG = 'ai-token-counter';
  const MAX_FILE = 20 * 1024 * 1024;
  const VIZ_LIMIT = 2000;
  const SIZE_LABEL: Record<string, string> = { cl100k: '0.4 MB', deepseek: '0.5 MB', o200k: '0.9 MB' };
  const NAMES: Record<string, string> = { o200k: 'o200k_base', cl100k: 'cl100k_base', deepseek: 'DeepSeek V4' };

  const wrap = document.querySelector('.atc-wrap') as HTMLElement;
  const S = JSON.parse(wrap.dataset.strings || '{}');
  const lang = wrap.dataset.lang || 'en';
  const numberFmt = new Intl.NumberFormat(lang === 'en' ? 'en-US' : lang);
  const input = document.getElementById('atc-input') as HTMLTextAreaElement;
  const statusEl = document.getElementById('atc-status') as HTMLElement;
  const tbody = document.getElementById('atc-tbody') as HTMLElement;
  const outInput = document.getElementById('atc-out') as HTMLInputElement;
  const vizEl = document.getElementById('atc-viz') as HTMLElement;
  const vizMeta = document.getElementById('atc-viz-meta') as HTMLElement;
  const vizEnc = document.getElementById('atc-viz-enc') as HTMLSelectElement;
  const vizIds = document.getElementById('atc-viz-ids') as HTMLInputElement;
  const copyBtn = document.getElementById('atc-copy') as HTMLButtonElement;
  const fileInput = document.getElementById('atc-file') as HTMLInputElement;

  type Enc = { name: string; pieces: (t: string) => any[]; encodePiece: (p: any, out: number[]) => void; tokenBytes: (id: number) => Uint8Array };
  const encodings: Record<string, Enc | null> = { o200k: null, cl100k: null, deepseek: null };
  const loading: Record<string, Promise<Enc> | null> = { o200k: null, cl100k: null, deepseek: null };
  const failed: Record<string, string | null> = { o200k: null, cl100k: null, deepseek: null };
  const wanted: Record<string, boolean> = { o200k: true, cl100k: false, deepseek: false };
  const results: Record<string, number[] | null> = { o200k: null, cl100k: null, deepseek: null };
  let lastStats = { chars: 0, bytes: 0, words: 0, lines: 0 };
  let generation = 0;

  function load(key: string): Promise<Enc> {
    if (encodings[key]) return Promise.resolve(encodings[key] as Enc);
    if (loading[key]) return loading[key] as Promise<Enc>;
    failed[key] = null;
    const p = (async () => {
      let enc: Enc;
      if (key === 'o200k') {
        const ranks = (await import('js-tiktoken/ranks/o200k_base')).default;
        enc = createTiktokenEncoding('o200k_base', ranks);
      } else if (key === 'cl100k') {
        const ranks = (await import('js-tiktoken/ranks/cl100k_base')).default;
        enc = createTiktokenEncoding('cl100k_base', ranks);
      } else {
        const mod = await import('../../data/deepseek-v4-tokenizer.mjs');
        enc = createHfBpeEncoding('DeepSeek V4', mod);
      }
      encodings[key] = enc;
      return enc;
    })();
    loading[key] = p;
    p.catch((e) => { failed[key] = e && e.message ? e.message : String(e); loading[key] = null; renderCards(); });
    return p;
  }

  function persist() {
    window.ztPersist?.save?.(SLUG, {
      text: input.value,
      cl100k: wanted.cl100k,
      deepseek: wanted.deepseek,
      out: outInput.value,
      viz: vizEnc.value,
      ids: vizIds.checked,
    });
  }

  function setStatus(text: string, kind = '') {
    statusEl.textContent = text;
    statusEl.dataset.kind = kind;
  }

  function renderCards() {
    for (const key of ['o200k', 'cl100k', 'deepseek']) {
      const numEl = document.getElementById('atc-n-' + key) as HTMLElement;
      const ratioEl = document.getElementById('atc-r-' + key) as HTMLElement;
      const btn = wrap.querySelector(`[data-load="${key}"]`) as HTMLButtonElement | null;
      const ids = results[key];
      numEl.textContent = ids ? numberFmt.format(ids.length) : '—';
      ratioEl.textContent = ids && ids.length && lastStats.chars ? fill(S.charsPerToken, { n: (lastStats.chars / ids.length).toFixed(2) }) : '';
      if (btn) {
        const show = !wanted[key] || !!failed[key];
        btn.hidden = !show;
        if (failed[key]) btn.textContent = S.retry;
        else btn.textContent = fill(S.loadTokenizer, { size: SIZE_LABEL[key] });
        btn.disabled = !!loading[key] && !failed[key];
      }
    }
  }

  function countFor(model: any): { n: number | null; ref: boolean } {
    if (model.enc === 'ref') return { n: results.o200k ? results.o200k.length : null, ref: true };
    const ids = results[model.enc];
    return { n: ids ? ids.length : null, ref: false };
  }

  function cell(text: string, cls = 'atc-r') {
    const td = document.createElement('td');
    td.className = cls;
    td.textContent = text;
    return td;
  }

  function renderTable() {
    const out = Math.max(0, Math.floor(Number(outInput.value) || 0));
    tbody.textContent = '';
    for (const m of MODELS) {
      const tr = document.createElement('tr');
      const th = document.createElement('th');
      th.scope = 'row';
      const name = document.createElement('span');
      name.className = 'atc-model';
      name.textContent = m.id;
      const prov = document.createElement('span');
      prov.className = 'atc-prov';
      prov.textContent = m.provider + ' · ' + (m.enc === 'ref' ? S.notLocal : NAMES[m.enc]);
      th.append(name, prov);
      tr.append(th);
      const { n, ref } = countFor(m);
      if (n == null) {
        const td = cell(fill(S.needsTokenizer, { name: NAMES[m.enc === 'ref' ? 'o200k' : m.enc] }), 'atc-r atc-muted');
        td.colSpan = 5;
        tr.append(td);
        tbody.append(tr);
        continue;
      }
      const mark = ref ? S.refMark + ' ' : '';
      tr.append(cell(mark + numberFmt.format(n)));
      const ctx = cell(formatPercent(n, m.limit));
      const c = costFor(m, n, out, 'USD');
      if (c.over) {
        ctx.classList.add('atc-warn');
        ctx.title = fill(S.overLimit, { limit: numberFmt.format(m.limit) });
        ctx.textContent += ' ⚠';
      }
      tr.append(ctx);
      const inCell = cell(mark + formatMoney(c.input, '$'));
      const outCell = cell(c.output == null ? '—' : mark + formatMoney(c.output, '$'));
      const totalCell = cell(mark + formatMoney(c.total, '$'));
      if (c.long && m.long) {
        totalCell.title = fill(S.longContext, { limit: numberFmt.format(m.long.over), price: '$' + m.long.input + ' / $' + m.long.output });
        totalCell.textContent += ' *';
      }
      if (m.offPeak) {
        const sub = document.createElement('span');
        sub.className = 'atc-sub';
        sub.textContent = fill(S.offPeak, { cost: formatMoney(c.total * m.offPeak, '$') });
        totalCell.append(sub);
        if (lang === 'zh' && m.cny) {
          const cny = costFor(m, n, out, 'CNY');
          const sub2 = document.createElement('span');
          sub2.className = 'atc-sub';
          sub2.textContent = formatMoney(cny.total, '¥') + ' / ' + fill(S.offPeak, { cost: formatMoney(cny.total * m.offPeak, '¥') });
          totalCell.append(sub2);
        }
      }
      tr.append(inCell, outCell, totalCell);
      tbody.append(tr);
    }
  }

  function renderPriceNote() {
    const el = document.getElementById('atc-price-note') as HTMLElement;
    el.textContent = '';
    const parts = fill(S.priceNote, { date: PRICES_CHECKED, links: '\u0000' }).split('\u0000');
    el.append(parts[0]);
    PRICE_SOURCES.forEach(([label, href], i) => {
      const a = document.createElement('a');
      a.href = href;
      a.textContent = label;
      a.rel = 'noopener';
      a.target = '_blank';
      el.append(a);
      if (i < PRICE_SOURCES.length - 1) el.append(', ');
    });
    el.append(parts[1] || '');
  }

  function renderViz() {
    const key = vizEnc.value;
    const enc = encodings[key];
    const ids = results[key];
    vizEl.textContent = '';
    if (!enc || !ids) {
      vizMeta.textContent = wanted[key] ? '' : fill(S.needsTokenizer, { name: NAMES[key] });
      return;
    }
    if (!ids.length) { vizMeta.textContent = S.vizEmpty; return; }
    const shown = Math.min(ids.length, VIZ_LIMIT);
    vizMeta.textContent = ids.length > shown ? fill(S.vizMore, { shown: numberFmt.format(shown), total: numberFmt.format(ids.length) }) : '';
    const frag = document.createDocumentFragment();
    const showIds = vizIds.checked;
    for (let i = 0; i < shown; i++) {
      const id = ids[i];
      const label = tokenLabel(enc.tokenBytes(id));
      const span = document.createElement('span');
      span.className = 'atc-chip' + (label.partial ? ' atc-chip--partial' : '');
      span.style.setProperty('--atc-h', String((id * 37) % 360));
      span.title = 'id ' + id;
      span.textContent = showIds ? label.text + ' ' + id : label.text;
      frag.append(span);
    }
    vizEl.append(frag);
  }

  function renderAll() {
    renderCards();
    renderTable();
    renderViz();
  }

  async function run() {
    const gen = ++generation;
    const text = input.value;
    lastStats = textStats(text);
    (document.getElementById('atc-chars') as HTMLElement).textContent = numberFmt.format(lastStats.chars);
    (document.getElementById('atc-bytes') as HTMLElement).textContent = numberFmt.format(lastStats.bytes);
    (document.getElementById('atc-words') as HTMLElement).textContent = numberFmt.format(lastStats.words);
    (document.getElementById('atc-lines') as HTMLElement).textContent = numberFmt.format(lastStats.lines);
    if (!text) {
      results.o200k = results.cl100k = results.deepseek = null;
      setStatus(S.idle);
      renderAll();
      return;
    }
    const keys = ['o200k', 'deepseek', 'cl100k'].filter((k) => wanted[k]);
    let loadingShown = false;
    for (const key of keys) {
      if (!encodings[key]) {
        if (!loadingShown) { setStatus(S.loading); loadingShown = true; }
        try { await load(key); } catch (e: any) {
          if (gen !== generation) return;
          setStatus(fill(S.loadFailed, { name: NAMES[key], msg: e && e.message ? e.message : String(e) }), 'error');
          continue;
        }
        if (gen !== generation) return;
      }
    }
    const tCount = performance.now();
    const big = text.length > 200000;
    if (big) setStatus(S.largeInput);
    const fresh: Record<string, number[] | null> = { o200k: null, cl100k: null, deepseek: null };
    for (const key of keys) {
      const enc = encodings[key];
      if (!enc) continue;
      const step = encodeSteps(enc, text, () => performance.now());
      for (;;) {
        const r = step(big ? 30 : 1e9);
        if (r.done) { fresh[key] = r.ids; break; }
        setStatus(fill(S.counting, { pct: Math.floor(r.progress * 100) }));
        await new Promise((res) => setTimeout(res, 0));
        if (gen !== generation) return;
      }
    }
    if (gen !== generation) return;
    for (const key of ['o200k', 'cl100k', 'deepseek']) results[key] = fresh[key];
    setStatus(fill(S.done, { chars: numberFmt.format(lastStats.chars), ms: Math.max(1, Math.round(performance.now() - tCount)) }));
    renderAll();
  }

  let timer = 0;
  function schedule(delay = 120) {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => { void run(); persist(); }, delay);
  }

  input.addEventListener('input', () => {
    schedule(input.value.length > 200000 ? 400 : 120);
    if (window.trackTool) window.trackTool(SLUG, 'count');
  });
  outInput.addEventListener('input', () => { renderTable(); persist(); });
  vizEnc.addEventListener('change', () => {
    const key = vizEnc.value;
    if (!wanted[key]) { wanted[key] = true; schedule(0); } else renderViz();
    persist();
  });
  vizIds.addEventListener('change', () => { renderViz(); persist(); });

  wrap.querySelectorAll<HTMLButtonElement>('[data-load]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.load as string;
      wanted[key] = true;
      failed[key] = null;
      renderCards();
      schedule(0);
      if (window.trackTool) window.trackTool(SLUG, 'load-' + key);
    });
  });

  (document.getElementById('atc-sample') as HTMLButtonElement).addEventListener('click', () => {
    input.value = wrap.dataset.sample || '';
    schedule(0);
    if (window.trackTool) window.trackTool(SLUG, 'sample');
  });

  (document.getElementById('atc-clear') as HTMLButtonElement).addEventListener('click', () => {
    input.value = '';
    window.ztPersist?.clear?.(SLUG);
    schedule(0);
    input.focus();
  });

  // The page-wide Ctrl/Cmd+L shortcut empties the textarea without an input event.
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L')) window.setTimeout(() => schedule(0), 0);
  });

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files && fileInput.files[0];
    fileInput.value = '';
    if (!file) return;
    if (file.size > MAX_FILE) {
      setStatus(fill(S.fileTooBig, { size: (file.size / 1048576).toFixed(1) + ' MB', max: '20 MB' }), 'error');
      return;
    }
    try {
      const buf = await file.arrayBuffer();
      input.value = new TextDecoder('utf-8', { fatal: true }).decode(buf);
      schedule(0);
      if (window.trackTool) window.trackTool(SLUG, 'file');
    } catch (_) {
      setStatus(S.fileNotText, 'error');
    }
  });

  copyBtn.addEventListener('click', async () => {
    const lines = [S.statsTitle + ' — ' + numberFmt.format(lastStats.chars) + ' ' + S.statChars + ', ' + numberFmt.format(lastStats.bytes) + ' ' + S.statBytes];
    for (const key of ['o200k', 'deepseek', 'cl100k']) {
      if (results[key]) lines.push(NAMES[key] + ': ' + numberFmt.format((results[key] as number[]).length) + ' ' + S.tokens);
    }
    lines.push(fill(S.statsPrices, { date: PRICES_CHECKED }));
    const textOut = lines.join('\n');
    const original = copyBtn.textContent;
    try {
      await navigator.clipboard.writeText(textOut);
      copyBtn.textContent = S.copied;
      window.setTimeout(() => { copyBtn.textContent = original; }, 1400);
      if (window.trackTool) window.trackTool(SLUG, 'copy-stats');
    } catch (_) {
      setStatus(S.copyFailed, 'error');
    }
  });

  // Boot
  const saved = window.ztPersist?.load?.(SLUG) || {};
  if (typeof saved.text === 'string') input.value = saved.text;
  if (saved.cl100k) wanted.cl100k = true;
  if (saved.deepseek) wanted.deepseek = true;
  if (saved.out != null && saved.out !== '') outInput.value = String(saved.out);
  if (saved.viz && ['o200k', 'cl100k', 'deepseek'].includes(saved.viz)) vizEnc.value = saved.viz;
  if (saved.ids) vizIds.checked = true;
  renderPriceNote();
  renderAll();
  if (input.value) void run();
  else {
    const warm = () => { void load('o200k').then(renderCards, () => {}); };
    if (typeof (window as any).requestIdleCallback === 'function') (window as any).requestIdleCallback(warm, { timeout: 3000 });
    else window.setTimeout(warm, 800);
  }
</script>

