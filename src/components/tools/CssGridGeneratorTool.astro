---
import Toggletip from '../Toggletip.astro';
// CssGridGeneratorTool — visual CSS Grid layout builder
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: {
    columns: 'Columns',
    rows: 'Rows',
    columnGap: 'Column Gap',
    rowGap: 'Row Gap',
    templateColumns: 'grid-template-columns',
    templateRows: 'grid-template-rows',
    preview: 'Preview',
    outputLabel: 'Generated CSS',
    copy: 'Copy',
    copied: 'Copied!',
    copyFailed: "Copy failed",
    options: "Custom templates",
    empty: "Adjust a control to preview the grid.",
    tips: {"columns": "Set 1–12 columns. Changing the count rebuilds the cells and replaces the column template with repeat(N, 1fr).", "rows": "Set 1–8 rows. Changing the count rebuilds the cells and replaces the row template with repeat(N, 1fr).", "columnGap": "Enter a CSS length such as 24px, 1.5rem or 2%. An empty field uses 1rem; typed values are copied without validation.", "rowGap": "Set the row spacing. The preview gap writes the row gap before the column gap. An empty field uses 1rem.", "templateColumns": "Enter a custom column template after setting the count. Gap changes retain it; changing Columns replaces it. The preview always contains Columns × Rows cells.", "templateRows": "Enter a custom row template after setting the count. Gap changes retain it; changing Rows replaces it. Templates are copied as typed.", "copy": "Copy the complete .container rule with its five declarations. Ctrl/⌘+L clears text, CSS and preview while keeping counts. Retry a failed copy or select the CSS manually."},
  },
  zh: {
    columns: '列数',
    rows: '行数',
    columnGap: '列间距',
    rowGap: '行间距',
    templateColumns: 'grid-template-columns',
    templateRows: 'grid-template-rows',
    preview: '预览',
    outputLabel: '生成的 CSS',
    copy: '复制',
    copied: '已复制！',
    copyFailed: "复制失败",
    options: "自定义模板",
    empty: "调整控件即可预览网格。",
    tips: {"columns": "设置 1–12 列。修改列数会重建单元格，并将列模板改为 repeat(N, 1fr)。", "rows": "设置 1–8 行。修改行数会重建单元格，并将行模板改为 repeat(N, 1fr)。", "columnGap": "输入 24px、1.5rem 或 2% 等 CSS 长度。空值使用 1rem；输入值不经校验，按原样复制。", "rowGap": "设置行间距。预览的 gap 先写行间距，再写列间距。空值使用 1rem。", "templateColumns": "先设置列数，再输入自定义列模板。修改间距会保留模板，修改列数会替换它。预览始终绘制列数×行数个单元格。", "templateRows": "先设置行数，再输入自定义行模板。修改间距会保留模板，修改行数会替换它。模板按输入原样复制。", "copy": "复制含五条声明的完整 .container 规则。Ctrl/⌘+L 清空文本、CSS 和预览，保留数量。复制失败时可重试或手动选中 CSS。"},
  },
  ja: {
    columns: '列数',
    rows: '行数',
    columnGap: '列ギャップ',
    rowGap: '行ギャップ',
    templateColumns: 'grid-template-columns',
    templateRows: 'grid-template-rows',
    preview: 'プレビュー',
    outputLabel: '生成された CSS',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyFailed: "コピーに失敗しました",
    options: "カスタムテンプレート",
    empty: "コントロールを調整するとグリッドをプレビューできます。",
    tips: {"columns": "列数を1〜12に設定します。変更するとセルを再作成し、列テンプレートを repeat(N, 1fr) に置き換えます。", "rows": "行数を1〜8に設定します。変更するとセルを再作成し、行テンプレートを repeat(N, 1fr) に置き換えます。", "columnGap": "24px、1.5rem、2% などの CSS 長さを入力します。空欄は1remになり、入力値は検証せずそのままコピーします。", "rowGap": "行間を設定します。プレビューの gap は行間、列間の順で書かれます。空欄は1remになります。", "templateColumns": "列数を設定してからカスタム列テンプレートを入力します。ギャップ変更では保持し、列数変更では置き換えます。セル数は常に列数×行数です。", "templateRows": "行数を設定してからカスタム行テンプレートを入力します。ギャップ変更では保持し、行数変更では置き換えます。入力どおりにコピーします。", "copy": "5宣言を含む完全な .container ルールをコピーします。Ctrl/⌘+L はテキスト、CSS、プレビューを消去し、数量を保持します。失敗したら再試行するか CSS を選択してください。"},
  },
  ko: {
    columns: '열 수',
    rows: '행 수',
    columnGap: '열 간격',
    rowGap: '행 간격',
    templateColumns: 'grid-template-columns',
    templateRows: 'grid-template-rows',
    preview: '미리보기',
    outputLabel: '생성된 CSS',
    copy: '복사',
    copied: '복사됨!',
    copyFailed: "복사 실패",
    options: "사용자 지정 템플릿",
    empty: "컨트롤을 조정하면 그리드를 미리 볼 수 있습니다.",
    tips: {"columns": "열 수를1~12로 설정하세요. 변경하면 셀을 다시 만들고 열 템플릿을 repeat(N, 1fr)로 바꿉니다.", "rows": "행 수를1~8로 설정하세요. 변경하면 셀을 다시 만들고 행 템플릿을 repeat(N, 1fr)로 바꿉니다.", "columnGap": "24px, 1.5rem, 2% 같은 CSS 길이를 입력하세요. 빈 값은1rem이며 입력값은 검증 없이 그대로 복사됩니다.", "rowGap": "행 간격을 설정하세요. 미리보기의 gap은 행 간격, 열 간격 순서입니다. 빈 값은1rem입니다.", "templateColumns": "열 수를 설정한 뒤 사용자 지정 열 템플릿을 입력하세요. 간격을 바꾸면 유지되고 열 수를 바꾸면 교체됩니다. 셀 수는 항상 열 수×행 수입니다.", "templateRows": "행 수를 설정한 뒤 사용자 지정 행 템플릿을 입력하세요. 간격을 바꾸면 유지되고 행 수를 바꾸면 교체됩니다. 입력한 대로 복사됩니다.", "copy": "다섯 선언이 있는 전체 .container 규칙을 복사하세요. Ctrl/⌘+L은 텍스트, CSS, 미리보기를 지우고 수는 유지합니다. 실패하면 다시 시도하거나 CSS를 선택하세요."},
  },
};

// strings:end
const L = STRINGS[lang] ?? STRINGS.en;
---

<div
  class="cgg-wrap"
  data-copy={L.copy}
  data-copied={L.copied}
  data-copy-failed={L.copyFailed}
  data-label-preview={L.preview}
>
  <div class="cgg-body">
    <div class="cgg-rail zt-rail">
      <div class="cgg-controls">
<div class="cgg-field">
      <div class="cgg-field-header"><label class="cgg-label" for="cgg-cols">{L.columns}</label><Toggletip id="cgg-tip-columns" lang={lang} about={L.columns}>{L.tips.columns}</Toggletip></div>
      <input id="cgg-cols" class="cgg-num-input" type="number" min="1" max="12" value="3" />
    </div>
<div class="cgg-field">
      <div class="cgg-field-header"><label class="cgg-label" for="cgg-rows">{L.rows}</label><Toggletip id="cgg-tip-rows" lang={lang} about={L.rows}>{L.tips.rows}</Toggletip></div>
      <input id="cgg-rows" class="cgg-num-input" type="number" min="1" max="8" value="2" />
    </div>
<div class="cgg-field">
      <div class="cgg-field-header"><label class="cgg-label" for="cgg-col-gap">{L.columnGap}</label><Toggletip id="cgg-tip-columnGap" lang={lang} about={L.columnGap}>{L.tips.columnGap}</Toggletip></div>
      <input id="cgg-col-gap" class="cgg-text-input" type="text" value="1rem" spellcheck="false" autocomplete="off" />
    </div>
<div class="cgg-field">
      <div class="cgg-field-header"><label class="cgg-label" for="cgg-row-gap">{L.rowGap}</label><Toggletip id="cgg-tip-rowGap" lang={lang} about={L.rowGap}>{L.tips.rowGap}</Toggletip></div>
      <input id="cgg-row-gap" class="cgg-text-input" type="text" value="1rem" spellcheck="false" autocomplete="off" />
    </div>
      </div>
      <details class="cgg-options"><summary>{L.options}</summary><div class="cgg-secondary"><div class="cgg-field cgg-field-wide">
      <div class="cgg-field-header"><label class="cgg-label" for="cgg-tmpl-cols">{L.templateColumns}</label><Toggletip id="cgg-tip-templateColumns" lang={lang} about={L.templateColumns}>{L.tips.templateColumns}</Toggletip></div>
      <input id="cgg-tmpl-cols" class="cgg-text-input" type="text" value="repeat(3, 1fr)" spellcheck="false" autocomplete="off" />
    </div><div class="cgg-field cgg-field-wide">
      <div class="cgg-field-header"><label class="cgg-label" for="cgg-tmpl-rows">{L.templateRows}</label><Toggletip id="cgg-tip-templateRows" lang={lang} about={L.templateRows}>{L.tips.templateRows}</Toggletip></div>
      <input id="cgg-tmpl-rows" class="cgg-text-input" type="text" value="repeat(2, 1fr)" spellcheck="false" autocomplete="off" />
    </div></div></details>
      <div class="cgg-section">
        <div class="cgg-output-header"><div class="cgg-output-label"><span class="cgg-section-label">{L.outputLabel}</span><Toggletip id="cgg-tip-copy" lang={lang} about={L.copy}>{L.tips.copy}</Toggletip></div><button id="cgg-copy" class="btn-copy" type="button">{L.copy}</button></div>
        <p id="cgg-status" class="tool-status" role="status"></p>
        <pre id="cgg-pre" class="cgg-pre" tabindex="0" role="region" aria-label={L.outputLabel}><code id="cgg-code" class="cgg-code"></code></pre>
      </div>
    </div>
    <div id="cgg-result" class="cgg-section cgg-result" data-empty="false"><span class="cgg-section-label">{L.preview}</span><p id="cgg-empty" class="cgg-empty" hidden>{L.empty}</p><div id="cgg-preview" class="cgg-preview"></div></div>
  </div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.cgg-wrap')
        : document.querySelector('.cgg-wrap');

      var COPY_LABEL   = wrap.dataset.copy;
      var COPY_FAILED_LABEL = wrap.dataset.copyFailed;
      var COPIED_LABEL = wrap.dataset.copied;

      var colsEl     = document.getElementById('cgg-cols');
      var rowsEl     = document.getElementById('cgg-rows');
      var colGapEl   = document.getElementById('cgg-col-gap');
      var rowGapEl   = document.getElementById('cgg-row-gap');
      var tmplColsEl = document.getElementById('cgg-tmpl-cols');
      var tmplRowsEl = document.getElementById('cgg-tmpl-rows');
      var previewEl  = document.getElementById('cgg-preview');
      var codeEl     = document.getElementById('cgg-code');
      var copyBtn    = document.getElementById('cgg-copy');
      var statusEl = document.getElementById('cgg-status');
      var resultEl = document.getElementById('cgg-result');
      var emptyEl = document.getElementById('cgg-empty');

      var CELL_COLORS = [
        '#bfdbfe','#bbf7d0','#fde68a','#fecaca',
        '#ddd6fe','#fed7aa','#a7f3d0','#e9d5ff',
        '#fef08a','#bae6fd','#d9f99d','#fecdd3',
      ];

      /* ── engine:start ── */
      // Every value is escaped before it is wrapped in highlight spans; the template fields are
      // free text, and the old regex highlighter put them into innerHTML as written.
      function escHtml(v) {
        return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
      function highlightCss(decls) {
        return '<span class="cgg-hl-sel">.container</span> <span class="cgg-hl-brace">{</span>\n' +
          decls.map(function (d) {
            return '  <span class="cgg-hl-prop">' + escHtml(d[0]) + '</span>: <span class="cgg-hl-val">' + escHtml(d[1]) +
              '</span><span class="cgg-hl-semi">;</span>';
          }).join('\n') +
          '\n<span class="cgg-hl-brace">}</span>';
      }
      /* ── engine:end ── */

      function update() {
        var cols    = Math.max(1, Math.min(12, parseInt(colsEl.value) || 3));
        var rows    = Math.max(1, Math.min(8,  parseInt(rowsEl.value) || 2));
        var colGap  = colGapEl.value.trim()   || '1rem';
        var rowGap  = rowGapEl.value.trim()   || '1rem';

        /* Sync template inputs if user hasn't manually overridden */
        if (tmplColsEl.dataset.manual !== '1') {
          tmplColsEl.value = 'repeat(' + cols + ', 1fr)';
        }
        if (tmplRowsEl.dataset.manual !== '1') {
          tmplRowsEl.value = 'repeat(' + rows + ', 1fr)';
        }

        var tmplCols = tmplColsEl.value.trim() || 'repeat(' + cols + ', 1fr)';
        var tmplRows = tmplRowsEl.value.trim() || 'repeat(' + rows + ', 1fr)';

        /* Build preview */
        previewEl.innerHTML = '';
        previewEl.style.display         = 'grid';
        previewEl.style.gridTemplateColumns = tmplCols;
        previewEl.style.gridTemplateRows    = tmplRows;
        previewEl.style.gap = rowGap + ' ' + colGap;

        var total = cols * rows;
        for (var i = 0; i < total; i++) {
          var cell = document.createElement('div');
          cell.className = 'cgg-cell';
          cell.style.background = CELL_COLORS[i % CELL_COLORS.length];
          previewEl.appendChild(cell);
        }

        /* Build CSS output */
        codeEl.innerHTML = highlightCss([
          ['display', 'grid'],
          ['grid-template-columns', tmplCols],
          ['grid-template-rows', tmplRows],
          ['column-gap', colGap],
          ['row-gap', rowGap],
        ]);

        window.trackTool && window.trackTool('css-grid-generator', 'generate');
      }

      var copyRequest = 0;
      var copyTimer = 0;
      function resetCopyFeedback() {
        copyRequest++;
        if (copyTimer) clearTimeout(copyTimer);
        copyTimer = 0;
        copyBtn.textContent = COPY_LABEL;
        copyBtn.classList.remove('copied');
        statusEl.textContent = '';
      }
      function refresh(event) {
        resetCopyFeedback();
        update();
        copyBtn.disabled = !codeEl.textContent;
        resultEl.dataset.empty = 'false';
        emptyEl.hidden = true;
        previewEl.hidden = false;
        if (event && window.matchMedia('(max-width: 640px)').matches) resultEl.scrollIntoView({ block: 'nearest' });
      }
      document.addEventListener('keydown', function (event) {
        if (!(event.ctrlKey || event.metaKey) || event.key.toLowerCase() !== 'l' || !wrap.contains(document.activeElement)) return;
        event.preventDefault();
        resetCopyFeedback();
        wrap.querySelectorAll('input[type="text"]').forEach(function (el) { el.value = ''; });
        codeEl.innerHTML = '';
        copyBtn.disabled = true;
        resultEl.dataset.empty = 'true';
        emptyEl.hidden = false;
        previewEl.hidden = true;
        previewEl.innerHTML = '';
        previewEl.style.display = '';
        previewEl.style.gridTemplateColumns = '';
        previewEl.style.gridTemplateRows = '';
        previewEl.style.gap = '';
      });


      colsEl.addEventListener('input', function () {
        tmplColsEl.dataset.manual = '';
        refresh(true);
      });
      rowsEl.addEventListener('input', function () {
        tmplRowsEl.dataset.manual = '';
        refresh(true);
      });
      colGapEl.addEventListener('input', refresh);
      rowGapEl.addEventListener('input', refresh);
      tmplColsEl.addEventListener('input', function () {
        tmplColsEl.dataset.manual = '1';
        refresh(true);
      });
      tmplRowsEl.addEventListener('input', function () {
        tmplRowsEl.dataset.manual = '1';
        refresh(true);
      });

      copyBtn.addEventListener('click', async function () {
        var text = codeEl.textContent;
        if (!text) return;
        resetCopyFeedback();
        var request = copyRequest;
        try {
          await navigator.clipboard.writeText(text);
          if (request !== copyRequest) return;
          copyBtn.textContent = COPIED_LABEL;
          copyTimer = setTimeout(function () {
            if (request !== copyRequest) return;
            copyTimer = 0;
            copyBtn.textContent = COPY_LABEL;
          }, 1500);
          window.trackTool && window.trackTool('css-grid-generator', 'copy');
        } catch (_) {
          if (request !== copyRequest) return;
          copyBtn.textContent = COPY_FAILED_LABEL;
          statusEl.textContent = COPY_FAILED_LABEL;
        }
      });

      refresh();
    })();
  </script>
</div>

<style>
  .cgg-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .cgg-body { display: grid; grid-template-columns: clamp(270px, 24vw, 320px) minmax(0, 1fr); gap: 1.5rem; flex: 1 1 0; min-height: 0; }
  .cgg-rail { overflow: auto; padding-right: 0.3rem; }
  .cgg-field-header, .cgg-output-label { display: flex; align-items: center; gap: 0.35rem; min-width: 0; }
  .cgg-field-header label { flex: 1; min-width: 0; }
  .cgg-options summary { cursor: pointer; padding: 0.5rem 0; min-height: 44px; font-size: 0.85rem; font-weight: 600; }
  .cgg-secondary { display: grid; gap: 0.5rem; }
  #cgg-copy { min-width: 0; height: 44px; white-space: normal; line-height: 1.2; }
  #cgg-status { height: 2.8em; flex: none; margin: 0; overflow: auto; }
  .cgg-result { min-width: 0; min-height: 0; }
  .cgg-empty { color: var(--color-text-muted); font-size: 0.9rem; }
  .cgg-preview[hidden], .cgg-empty[hidden] { display: none; }
  .cgg-wrap :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }

  /* Controls grid */
  .cgg-controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .cgg-field { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .cgg-field-wide { grid-column: auto; }

  .cgg-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
  }

  .cgg-num-input,
  .cgg-text-input {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    width: 100%;
    box-sizing: border-box;
  }

  .cgg-num-input:focus,
  .cgg-text-input:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  /* Section */
  .cgg-section { display: flex; flex-direction: column; gap: 0.4rem; }

  .cgg-section-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .cgg-output-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.5rem;
    align-items: center;
  }

  /* Preview */
  .cgg-preview {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    background: var(--color-bg-secondary);
    flex: 1 1 0;
    min-height: 220px;
    overflow: auto;
  }

  .cgg-wrap :global(.cgg-cell) {
    border-radius: 4px;
    min-height: 60px;
  }

  /* Code output */
  .cgg-pre {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    overflow: auto;
    max-height: 10rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .cgg-code { font-family: inherit; }

  .cgg-wrap :global(.cgg-hl-sel)   { color: #7c3aed; font-weight: 600; }
  .cgg-wrap :global(.cgg-hl-brace) { color: var(--color-text-secondary); }
  .cgg-wrap :global(.cgg-hl-prop)  { color: #0369a1; }
  .cgg-wrap :global(.cgg-hl-val)   { color: #057a55; }
  .cgg-wrap :global(.cgg-hl-semi)  { color: var(--color-text-secondary); }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .cgg-wrap :global(.cgg-hl-sel)  { color: #a78bfa; }
    :global(:root:not([data-theme="light"])) .cgg-wrap :global(.cgg-hl-prop) { color: #38bdf8; }
    :global(:root:not([data-theme="light"])) .cgg-wrap :global(.cgg-hl-val)  { color: #34d399; }
  }
  :global([data-theme="dark"]) .cgg-wrap :global(.cgg-hl-sel)  { color: #a78bfa; }
  :global([data-theme="dark"]) .cgg-wrap :global(.cgg-hl-prop) { color: #38bdf8; }
  :global([data-theme="dark"]) .cgg-wrap :global(.cgg-hl-val)  { color: #34d399; }

  @media (max-width: 860px) {
    .cgg-body { display: flex; flex-direction: column; flex: none; gap: 0.5rem; }
    .cgg-rail { overflow: visible; padding-right: 0; gap: 0.5rem; }
    .cgg-preview { height: 180px; min-height: 0; flex: none; }
    .cgg-result[data-empty="true"] { display: none; }
    .cgg-pre { height: 5rem; max-height: 5rem; }
  }
  @media (max-width: 640px) {
    .cgg-controls { gap: 0.3rem 0.65rem; }
    .cgg-num-input, .cgg-text-input { min-height: 44px; }
    .cgg-preview { height: 160px; }
    .cgg-pre { height: 3.8rem; max-height: 3.8rem; padding: 0.45rem 0.65rem; }
  }
</style>
