const L = STRINGS[lang];
const PREFIX_OPTIONS = ['$2b$', '$2y$', '$2a$'];
const COSTS = Array.from({ length: 28 }, (_, i) => i + 4);
---
<div class="bcg-wrap">
  <div class="bcg-tabs" role="tablist">
    <button type="button" class="bcg-tab is-active" id="bcg-tab-gen" role="tab" aria-selected="true" aria-controls="bcg-gen">{L.tabGen}</button>
    <button type="button" class="bcg-tab" id="bcg-tab-ver" role="tab" aria-selected="false" aria-controls="bcg-ver">{L.tabVer}</button>
  </div>

  <section class="bcg-panel" id="bcg-gen" role="tabpanel" aria-labelledby="bcg-tab-gen">
    <div class="bcg-field">
      <label class="tool-label" for="bcg-gen-pw">{L.password}</label>
      <input id="bcg-gen-pw" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" placeholder={L.passwordPh} />
      <p id="bcg-gen-meta" class="bcg-meta"></p>
    </div>
    <ul id="bcg-gen-issues" class="bcg-issues" hidden></ul>
    <div class="bcg-opts">
      <div class="bcg-field bcg-field--prefix">
        <label class="tool-label" for="bcg-prefix">{L.prefix}</label>
        <select id="bcg-prefix" class="tool-input">
          {PREFIX_OPTIONS.map((p) => <option value={p} selected={p === '$2b$'}>{L['opt_' + p]}</option>)}
        </select>
      </div>
      <div class="bcg-field bcg-field--cost">
        <label class="tool-label" for="bcg-cost">{L.cost}</label>
        <select id="bcg-cost" class="tool-input">
          {COSTS.map((c) => <option value={c} selected={c === 12}>{c}</option>)}
        </select>
      </div>
      <button id="bcg-gen-btn" class="btn-primary bcg-main-btn" type="button">{L.generate}</button>
    </div>
    <div class="bcg-status-row">
      <p id="bcg-gen-status" class="tool-status none" role="status" aria-live="polite"></p>
      <button id="bcg-gen-cancel" class="btn-secondary btn-sm" type="button" hidden>{L.cancel}</button>
    </div>
    <div id="bcg-gen-out" class="bcg-out" hidden>
      <div class="bcg-hash-row">
        <code id="bcg-gen-hash" class="bcg-hash"></code>
        <button id="bcg-gen-copy" class="btn-copy" type="button">{L.copy}</button>
      </div>
      <dl id="bcg-gen-parts" class="bcg-parts"></dl>
    </div>
    <p id="bcg-prefix-note" class="bcg-note"></p>
  </section>

  <section class="bcg-panel" id="bcg-ver" role="tabpanel" aria-labelledby="bcg-tab-ver" hidden>
    <div class="bcg-field">
      <div class="bcg-label-row">
        <label class="tool-label" for="bcg-ver-hash">{L.hashLabel}</label>
        <button id="bcg-ver-example" class="btn-ghost btn-sm" type="button">{L.example}</button>
      </div>
      <input id="bcg-ver-hash" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" placeholder={L.hashPh} />
    </div>
    <div id="bcg-ver-parse" class="bcg-parse" aria-live="polite"></div>
    <div class="bcg-field">
      <label class="tool-label" for="bcg-ver-pw">{L.password}</label>
      <input id="bcg-ver-pw" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" placeholder={L.verPwPh} />
      <p id="bcg-ver-meta" class="bcg-meta"></p>
    </div>
    <ul id="bcg-ver-issues" class="bcg-issues" hidden></ul>
    <div class="bcg-actions">
      <button id="bcg-ver-btn" class="bcg-main-btn" type="button">{L.verify}</button>
      <button id="bcg-ver-cancel" class="btn-secondary" type="button" hidden>{L.cancel}</button>
    </div>
    <p id="bcg-ver-status" class="tool-status none" role="status" aria-live="polite"></p>
    <div id="bcg-ver-result" class="bcg-result" hidden></div>
    <div id="bcg-ver-variants" class="bcg-variants" hidden></div>
  </section>

  <p class="bcg-privacy">{L.privacy}</p>
</div>

<script is:inline define:vars={{ S: L, WORKER_URL }}>
  (function () {
    /* ── engine:start ── */
    var B64 = './ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    var PREFIXES = ['$2b$', '$2y$', '$2a$'];
    var COST_MIN = 4, COST_MAX = 31;

    function utf8Bytes(s) { return new TextEncoder().encode(s); }

    // bcrypt's own Base64: alphabet ./A-Za-z0-9, no padding (OpenBSD encode_base64).
    function bcEncode(bytes) {
      var out = '', i = 0, n = bytes.length, c1, c2;
      while (i < n) {
        c1 = bytes[i++];
        out += B64[(c1 >> 2) & 0x3f];
        c1 = (c1 & 0x03) << 4;
        if (i >= n) { out += B64[c1 & 0x3f]; break; }
        c2 = bytes[i++];
        c1 |= (c2 >> 4) & 0x0f;
        out += B64[c1 & 0x3f];
        c1 = (c2 & 0x0f) << 2;
        if (i >= n) { out += B64[c1 & 0x3f]; break; }
        c2 = bytes[i++];
        c1 |= (c2 >> 6) & 0x03;
        out += B64[c1 & 0x3f];
        out += B64[c2 & 0x3f];
      }
      return out;
    }

    // Decodes the first n bytes; padding bits in the last character are dropped.
    function bcDecode(str, n) {
      var out = new Uint8Array(n), o = 0, i = 0, c1, c2, c3, c4;
      function v(ch) { var k = B64.indexOf(ch); if (k < 0) throw new Error('bad char'); return k; }
      while (o < n && i < str.length - 1) {
        c1 = v(str[i++]); c2 = v(str[i++]);
        out[o++] = ((c1 << 2) | ((c2 & 0x30) >> 4)) & 0xff;
        if (o >= n || i >= str.length) break;
        c3 = v(str[i++]);
        out[o++] = (((c2 & 0x0f) << 4) | ((c3 & 0x3c) >> 2)) & 0xff;
        if (o >= n || i >= str.length) break;
        c4 = v(str[i++]);
        out[o++] = (((c3 & 0x03) << 6) | c4) & 0xff;
      }
      return out;
    }

    function randomSaltBody() { var b = new Uint8Array(16); crypto.getRandomValues(b); return bcEncode(b); }
    function pad2(n) { return (n < 10 ? '0' : '') + n; }
    function makeSalt(prefix, cost, body) {
      if (PREFIXES.indexOf(prefix) < 0) throw new Error('prefix');
      if (!(cost >= COST_MIN && cost <= COST_MAX && Math.floor(cost) === cost)) throw new Error('cost');
      return prefix + pad2(cost) + '$' + body;
    }

    function cutAt72(pw) {
      var used = 0, kept = '', split = '';
      for (var ch of pw) {
        var b = utf8Bytes(ch).length;
        if (used + b > 72) { if (used < 72) split = ch; break; }
        used += b; kept += ch;
      }
      return { kept: kept, used: used, split: split };
    }

    function tailOf(s, n) { var a = Array.from(s); return (a.length > n ? '…' : '') + a.slice(-n).join(''); }

    function checkPassword(pw) {
      var bytes = utf8Bytes(pw).length, issues = [];
      if (!pw.length) issues.push({ level: 'warn', code: 'empty' });
      if (bytes > 72) {
        var c = cutAt72(pw);
        issues.push({ level: 'warn', code: 'over72', vars: { bytes: bytes, tail: tailOf(c.kept, 12) } });
        if (c.split) issues.push({ level: 'warn', code: 'split', vars: { ch: c.split } });
      }
      if (pw.indexOf('\u0000') >= 0) issues.push({ level: 'warn', code: 'nul' });
      if (/^\s|\s$/.test(pw)) issues.push({ level: 'info', code: 'space' });
      return { chars: Array.from(pw).length, bytes: bytes, issues: issues };
    }

    var OTHER_SCHEMES = [
      [/^\$argon2(id|i|d)\$/, 'argon2'], [/^\$scrypt\$|^\$7\$/, 'scrypt'], [/^\$y\$/, 'yescrypt'],
      [/^\$6\$/, 'sha512crypt'], [/^\$5\$/, 'sha256crypt'], [/^\$apr1\$/, 'apr1'], [/^\$1\$/, 'md5crypt'],
      [/^\$[PH]\$/, 'phpass'], [/^pbkdf2_sha\d+\$/, 'pbkdf2'], [/^\{S?SHA\}/i, 'ldap'],
    ];
    var HEX_ALGOS = { 32: 'MD5', 40: 'SHA-1', 64: 'SHA-256', 128: 'SHA-512' };

    function detectOtherScheme(h) {
      for (var i = 0; i < OTHER_SCHEMES.length; i++) if (OTHER_SCHEMES[i][0].test(h)) return { scheme: OTHER_SCHEMES[i][1] };
      if (/^[0-9a-f]+$/i.test(h) && HEX_ALGOS[h.length]) return { scheme: 'hex', vars: { bits: h.length * 4, algo: HEX_ALGOS[h.length] } };
      return null;
    }

    // Strips the wrappers a bcrypt hash usually arrives in when it is copied from a config,
    // a database dump or another framework's storage format.
    function normalizeHashInput(raw) {
      var s = String(raw), t = s.trim(), notes = [], prehash = null, m;
      if (t && t !== s) notes.push({ code: 'trim' });
      if ((m = /^(["'`])(.*)\1$/.exec(t))) { t = m[2].trim(); notes.push({ code: 'quotes' }); }
      if (/\\\$/.test(t)) { t = t.replace(/\\\$/g, '$'); notes.push({ code: 'backslash' }); }
      if ((m = /^([^\s:${]+):(.+)$/.exec(t)) && /^[$\\{]/.test(m[2])) { t = m[2]; notes.push({ code: 'htpasswd', vars: { user: m[1] } }); }
      if ((m = /^\{([A-Za-z0-9_-]+)\}/.exec(t))) {
        if (m[1].toLowerCase() === 'bcrypt') { t = t.slice(m[0].length); notes.push({ code: 'spring' }); }
        else if (!/^S?SHA$/i.test(m[1])) return { hash: t, notes: notes, prehash: null, spring: m[1] };
      }
      if (/^bcrypt_sha256\$/.test(t)) { t = t.slice(14); prehash = 'sha256'; notes.push({ code: 'djangoSha' }); }
      else if (/^bcrypt\$/.test(t)) { t = t.slice(7); notes.push({ code: 'django' }); }
      if (/^\$\$2/.test(t)) { t = t.replace(/\$\$/g, '$'); notes.push({ code: 'dollar' }); }
      return { hash: t, notes: notes, prehash: prehash };
    }

    function parseHash(raw) {
      var n = normalizeHashInput(raw), h = n.hash;
      var res = { ok: false, input: h, notes: n.notes, prehash: n.prehash };
      function fail(code, pos, vars) { res.error = { code: code, pos: pos, vars: vars || {} }; return res; }
      if (n.spring) return fail('springOther', 0, { id: '{' + n.spring + '}' });
      if (!h) return fail('empty', 0);
      var other = detectOtherScheme(h);
      if (other) return fail('notBcrypt', 0, { scheme: other.scheme, schemeVars: other.vars || {} });
      var cps = Array.from(h);
      if (cps[0] !== '$') return fail('prefix', 1, { ch: cps[0] });
      if (cps[1] !== '2') return fail('prefix', 2, { ch: cps[1] || '' });
      var i, minor;
      if (cps[2] === '$') { minor = ''; i = 3; }
      else {
        minor = cps[2] || '';
        if (!/^[abxy]$/.test(minor)) return fail('minor', 3, { ch: minor });
        if (cps[3] !== '$') return fail('sep', 4, { ch: cps[3] || '' });
        i = 4;
      }
      var cc = (cps[i] || '') + (cps[i + 1] || '');
      if (!/^\d\d$/.test(cc)) return fail('cost', i + 1, { pos2: i + 2, got: cc });
      var cost = Number(cc);
      if (cost < COST_MIN || cost > COST_MAX) return fail('costRange', i + 1, { cost: cc });
      if (cps[i + 2] !== '$') return fail('sep', i + 3, { ch: cps[i + 2] || '' });
      var start = i + 3, want = start + 53;
      for (var k = start; k < cps.length; k++) if (B64.indexOf(cps[k]) < 0) return fail('char', k + 1, { ch: cps[k] });
      if (cps.length !== want) return fail(cps.length < want ? 'short' : 'long', cps.length, { want: want, got: cps.length });
      var header = h.slice(0, start), salt = h.slice(start, start + 22), sum = h.slice(start + 22);
      var cSalt = bcEncode(bcDecode(salt, 16)), cSum = bcEncode(bcDecode(sum, 23));
      res.ok = true;
      res.hash = h; res.header = header; res.prefix = header.slice(0, i); res.minor = minor; res.cost = cost;
      res.salt = salt; res.checksum = sum; res.canonicalSalt = cSalt; res.canonicalSum = cSum;
      res.canonical = header + cSalt + cSum;
      res.nonCanonicalSalt = cSalt !== salt; res.nonCanonicalSum = cSum !== sum;
      return res;
    }

    function hashNotes(p) {
      var out = [];
      if (p.minor === 'x') out.push({ code: '2x' });
      if (p.minor === '') out.push({ code: '2' });
      if (p.nonCanonicalSalt) out.push({ code: 'ncSalt', vars: { ch: p.salt.slice(-1), fix: p.canonicalSalt.slice(-1) } });
      if (p.nonCanonicalSum) out.push({ code: 'ncSum', vars: { ch: p.checksum.slice(-1), fix: p.canonicalSum.slice(-1) } });
      if (p.prefix === '$2y$' || p.prefix === '$2a$' || p.prefix === '$2b$') out.push({ code: 'lib_' + p.prefix });
      return out;
    }

    // The salt string handed to bcryptjs, or the reason it cannot be checked here.
    function verifySalt(p, password) {
      var tail = pad2(p.cost) + '$' + p.canonicalSalt;
      if (p.minor === 'x') {
        if (/^[\x00-\x7f]*$/.test(password)) return { salt: '$2a$' + tail };
        return { unsupported: '2x' };
      }
      return { salt: p.header.slice(0, p.header.length - 3) + tail };
    }

    function judge(p, computed) { return computed.slice(-31) === p.canonicalSum; }

    function prefixVariants(p) {
      if (['a', 'b', 'y'].indexOf(p.minor) < 0) return null;
      var tail = p.canonical.slice(4), out = {};
      ['$2a$', '$2b$', '$2y$'].forEach(function (x) { out[x] = x + tail; });
      return out;
    }

    async function sha256Hex(str) {
      var d = new Uint8Array(await crypto.subtle.digest('SHA-256', utf8Bytes(str)));
      return Array.from(d, function (b) { return (b < 16 ? '0' : '') + b.toString(16); }).join('');
    }

    async function passwordFor(p, password) { return p.prehash === 'sha256' ? sha256Hex(password) : password; }

    function estimateMs(cost, bench) { return bench.ms * Math.pow(2, cost - bench.cost); }

    function splitDuration(ms) {
      if (ms < 1000) return { unit: 'ms', n: String(Math.max(1, Math.round(ms))) };
      if (ms < 60000) return { unit: 's', n: (ms < 10000 ? (ms / 1000).toFixed(1) : String(Math.round(ms / 1000))) };
      if (ms < 3600000) return { unit: 'min', n: String(Math.round(ms / 60000)) };
      return { unit: 'h', n: String(Math.round(ms / 3600000)) };
    }

    // One worker per caller; messages are matched by id so overlapping calls each get their own answer.
    function createClient(factory) {
      var worker = null, seq = 0, pending = {};
      function rejectAll(err) {
        Object.keys(pending).forEach(function (id) { var p = pending[id]; delete pending[id]; p.reject(err); });
      }
      function ensure() {
        if (worker) return worker;
        worker = factory();
        worker.onmessage = function (e) {
          var m = e.data || {}, p = pending[m.id];
          if (!p) return;
          if (m.type === 'progress') { if (p.progress) p.progress(m.p); return; }
          delete pending[m.id];
          if (m.type === 'error') p.reject(new Error(m.message)); else p.resolve(m);
        };
        worker.onerror = function (e) {
          if (e && e.preventDefault) e.preventDefault();
          try { worker.terminate(); } catch (x) { /* already gone */ }
          worker = null;
          rejectAll(new Error((e && e.message) || 'worker error'));
        };
        return worker;
      }
      return {
        run: function (msg, progress) {
          return new Promise(function (resolve, reject) {
            var id = ++seq;
            pending[id] = { resolve: resolve, reject: reject, progress: progress };
            var m = {}; for (var k in msg) m[k] = msg[k]; m.id = id;
            try { ensure().postMessage(m); } catch (err) { delete pending[id]; reject(err); }
          });
        },
        cancel: function () {
          if (worker) { try { worker.terminate(); } catch (x) { /* ignore */ } worker = null; }
          var e = new Error('cancelled'); e.cancelled = true; rejectAll(e);
        },
        size: function () { return Object.keys(pending).length; },
      };
    }
    /* ── engine:end ── */

    function $(id) { return document.getElementById(id); }
    function fill(tpl, vars) {
      return String(tpl).replace(/\{(\w+)\}/g, function (m, k) { return vars && Object.prototype.hasOwnProperty.call(vars, k) ? vars[k] : m; });
    }
    function fmtTime(ms) { var d = splitDuration(ms); return fill(S[d.unit], { n: d.n }); }
    function setStatus(el, text, kind) { el.textContent = text || ''; el.className = 'tool-status ' + (kind || 'none'); }
    function renderList(el, items) {
      el.textContent = '';
      items.forEach(function (it) {
        var li = document.createElement('li');
        li.className = 'bcg-issue bcg-issue--' + (it.level || 'info');
        li.textContent = it.text;
        el.appendChild(li);
      });
      el.hidden = !items.length;
    }
    function issueText(i) { return fill(S['issue_' + i.code], i.vars || {}); }
    function noteText(i) { return fill(S['note_' + i.code], i.vars || {}); }

    var factory = function () { return new Worker(WORKER_URL); };
    var genClient = createClient(factory), verClient = createClient(factory);
    var bench = null;

    // ── tabs ──
    var tabs = { gen: $('bcg-tab-gen'), ver: $('bcg-tab-ver') };
    var panels = { gen: $('bcg-gen'), ver: $('bcg-ver') };
    var mainBtns = { gen: $('bcg-gen-btn'), ver: $('bcg-ver-btn') };
    function showTab(name) {
      Object.keys(tabs).forEach(function (k) {
        var on = k === name;
        tabs[k].classList.toggle('is-active', on);
        tabs[k].setAttribute('aria-selected', on ? 'true' : 'false');
        tabs[k].tabIndex = on ? 0 : -1;
        panels[k].hidden = !on;
        // The site-wide Ctrl/⌘+Enter clicks the first .btn-primary in the widget.
        mainBtns[k].classList.toggle('btn-primary', on);
      });
    }
    Object.keys(tabs).forEach(function (k) {
      tabs[k].addEventListener('click', function () { showTab(k); });
      tabs[k].addEventListener('keydown', function (e) {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        var next = k === 'gen' ? 'ver' : 'gen';
        showTab(next); tabs[next].focus(); e.preventDefault();
      });
    });
    showTab('gen');

    function copyText(text, btn, statusEl) {
      if (!text) return;
      var done = function () { btn.textContent = S.copied; setTimeout(function () { btn.textContent = S.copy; }, 1500); };
      var fallback = function () {
        var ta = document.createElement('textarea');
        ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.body.removeChild(ta);
        if (ok) done(); else setStatus(statusEl, S.copyFail, 'error');
      };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fallback);
      else fallback();
    }

    function renderParts(dl, p) {
      dl.textContent = '';
      var rows = [
        [S.partPrefix, p.prefix, 'pre'],
        [S.partCost, p.cost + ' · ' + fill(S.costRounds, { cost: p.cost, rounds: Math.pow(2, p.cost).toLocaleString() }), 'cost'],
        [S.partSalt, p.salt, 'salt'],
        [S.partSum, p.checksum, 'sum'],
      ];
      rows.forEach(function (r) {
        var dt = document.createElement('dt'); dt.textContent = r[0];
        var dd = document.createElement('dd'); dd.className = 'bcg-seg bcg-seg--' + r[2]; dd.textContent = r[1];
        dl.appendChild(dt); dl.appendChild(dd);
      });
    }

    function renderHash(code, p) {
      code.textContent = '';
      [[p.header.slice(0, p.prefix.length), 'pre'], [p.header.slice(p.prefix.length), 'cost'], [p.salt, 'salt'], [p.checksum, 'sum']].forEach(function (seg) {
        var span = document.createElement('span'); span.className = 'bcg-seg bcg-seg--' + seg[1]; span.textContent = seg[0];
        code.appendChild(span);
      });
    }

    // ── speed ──
    function benchmark() {
      return genClient.run({ type: 'bench', cost: 8 }).then(function (r) {
        if (!bench) bench = { cost: 8, ms: r.ms };
        updateEstimate();
        renderParse();
      }, function () { /* the estimate stays hidden; hashing reports its own errors */ });
    }

    // ── generate ──
    var genPw = $('bcg-gen-pw'), prefixSel = $('bcg-prefix'), costSel = $('bcg-cost');
    var genBtn = $('bcg-gen-btn'), genCancel = $('bcg-gen-cancel'), genStatus = $('bcg-gen-status');
    var genOut = $('bcg-gen-out'), genHash = $('bcg-gen-hash'), genParts = $('bcg-gen-parts');
    var genBusy = false;

    function updateGenPw() {
      var r = checkPassword(genPw.value);
      $('bcg-gen-meta').textContent = genPw.value ? fill(S.meta, { chars: r.chars, bytes: r.bytes }) : '';
      renderList($('bcg-gen-issues'), genPw.value ? r.issues.map(function (i) { return { level: i.level, text: issueText(i) }; }) : []);
    }
    function updateEstimate() {
      if (genBusy) return;
      if (!bench) { setStatus(genStatus, S.estimating, 'none'); return; }
      var cost = Number(costSel.value);
      setStatus(genStatus, fill(S.estimate, { cost: cost, time: fmtTime(estimateMs(cost, bench)) }), 'none');
    }
    function updatePrefixNote() { $('bcg-prefix-note').textContent = S['note_' + prefixSel.value]; }

    async function generate() {
      if (genBusy) return;
      var pw = genPw.value;
      if (!pw) { setStatus(genStatus, S.needPassword, 'error'); genPw.focus(); return; }
      var cost = Number(costSel.value), salt = makeSalt(prefixSel.value, cost, randomSaltBody());
      genBusy = true; genBtn.disabled = true; genCancel.hidden = false;
      setStatus(genStatus, fill(S.working, { pct: 0 }), 'info');
      try {
        var r = await genClient.run({ type: 'hash', password: pw, salt: salt }, function (p) {
          setStatus(genStatus, fill(S.working, { pct: Math.round(p * 100) }), 'info');
        });
        bench = { cost: cost, ms: r.ms };
        var parsed = parseHash(r.hash);
        renderHash(genHash, parsed);
        renderParts(genParts, parsed);
        genOut.hidden = false;
        genBusy = false;
        setStatus(genStatus, fill(S.done, { time: fmtTime(r.ms), cost: cost }), 'success');
        if (window.trackTool) window.trackTool('bcrypt-generator', 'generate');
      } catch (err) {
        genBusy = false;
        if (err && err.cancelled) setStatus(genStatus, S.cancelled, 'none');
        else setStatus(genStatus, fill(S.workerFail, { msg: (err && err.message) || String(err) }), 'error');
      } finally {
        genBusy = false; genBtn.disabled = false; genCancel.hidden = true;
      }
    }

    genPw.addEventListener('input', function () { updateGenPw(); });
    genPw.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.metaKey && !e.ctrlKey && !e.isComposing) { e.preventDefault(); generate(); }
    });
    costSel.addEventListener('change', updateEstimate);
    prefixSel.addEventListener('change', updatePrefixNote);
    genBtn.addEventListener('click', generate);
    genCancel.addEventListener('click', function () { genClient.cancel(); });
    $('bcg-gen-copy').addEventListener('click', function () { copyText(genHash.textContent, $('bcg-gen-copy'), genStatus); });

    // ── verify ──
    var verHash = $('bcg-ver-hash'), verPw = $('bcg-ver-pw'), verBtn = $('bcg-ver-btn'), verCancel = $('bcg-ver-cancel');
    var verStatus = $('bcg-ver-status'), verResult = $('bcg-ver-result'), verVariants = $('bcg-ver-variants'), parseBox = $('bcg-ver-parse');
    var verBusy = false;

    function renderParse() {
      var raw = verHash.value;
      parseBox.textContent = '';
      if (!raw.trim()) return null;
      var p = parseHash(raw);
      var notes = p.notes.slice();
      if (p.ok) {
        var dl = document.createElement('dl'); dl.className = 'bcg-parts';
        renderParts(dl, p); parseBox.appendChild(dl);
        notes = notes.concat(hashNotes(p));
        if (bench) notes.push({ code: 'costTime', vars: { cost: p.cost, time: fmtTime(estimateMs(p.cost, bench)) } });
      } else {
        var e = p.error, vars = {};
        for (var k in e.vars) vars[k] = e.vars[k];
        vars.pos = e.pos;
        if (e.code === 'notBcrypt') vars.scheme = fill(S['scheme_' + e.vars.scheme], e.vars.schemeVars);
        var msg = document.createElement('p'); msg.className = 'bcg-err';
        msg.textContent = fill(S['err_' + e.code], vars);
        parseBox.appendChild(msg);
        if (e.pos > 0 && ['prefix', 'minor', 'sep', 'char', 'cost', 'costRange'].indexOf(e.code) >= 0) {
          var cps = Array.from(p.input), at = e.pos - 1, len = e.code === 'cost' || e.code === 'costRange' ? 2 : 1;
          var code = document.createElement('code'); code.className = 'bcg-mark-line';
          code.appendChild(document.createTextNode(cps.slice(0, at).join('')));
          var mark = document.createElement('mark'); mark.textContent = cps.slice(at, at + len).join('') || ' ';
          code.appendChild(mark);
          code.appendChild(document.createTextNode(cps.slice(at + len).join('')));
          parseBox.appendChild(code);
        }
      }
      if (notes.length) {
        var ul = document.createElement('ul'); ul.className = 'bcg-issues';
        renderList(ul, notes.map(function (n) { return { level: 'info', text: noteText(n) }; }));
        parseBox.appendChild(ul);
      }
      return p;
    }

    function updateVerPw() {
      var r = checkPassword(verPw.value);
      $('bcg-ver-meta').textContent = verPw.value ? fill(S.meta, { chars: r.chars, bytes: r.bytes }) : '';
      renderList($('bcg-ver-issues'), r.issues.filter(function (i) { return i.code !== 'empty' || verPw.value; }).map(function (i) { return { level: i.level, text: issueText(i) }; }));
    }

    function clearVerResult() { verResult.hidden = true; verResult.textContent = ''; verVariants.hidden = true; verVariants.textContent = ''; }

    function addCopyRow(box, label, value) {
      var row = document.createElement('div'); row.className = 'bcg-variant';
      var lab = document.createElement('span'); lab.className = 'bcg-variant-label'; lab.textContent = label;
      var code = document.createElement('code'); code.className = 'bcg-hash'; code.textContent = value;
      var btn = document.createElement('button'); btn.type = 'button'; btn.className = 'btn-copy'; btn.textContent = S.copy;
      btn.addEventListener('click', function () { copyText(value, btn, verStatus); });
      row.appendChild(lab); row.appendChild(code); row.appendChild(btn); box.appendChild(row);
    }

    function showVariants(p) {
      verVariants.textContent = '';
      if (p.nonCanonicalSalt || p.nonCanonicalSum) addCopyRow(verVariants, S.canonical, p.canonical);
      var v = prefixVariants(p);
      if (v) {
        var h = document.createElement('p'); h.className = 'bcg-variants-title'; h.textContent = S.variants;
        verVariants.appendChild(h);
        Object.keys(v).forEach(function (k) { if (k !== p.prefix) addCopyRow(verVariants, k, v[k]); });
        var hint = document.createElement('p'); hint.className = 'bcg-variants-hint'; hint.textContent = S.variantsHint;
        verVariants.appendChild(hint);
      }
      verVariants.hidden = !verVariants.childNodes.length;
    }

    async function verify() {
      if (verBusy) return;
      clearVerResult();
      var p = renderParse();
      if (!p) { setStatus(verStatus, S.needHash, 'error'); verHash.focus(); return; }
      if (!p.ok) { setStatus(verStatus, '', 'none'); return; }
      var pw = verPw.value;
      var plan = verifySalt(p, pw);
      if (plan.unsupported) { verResult.className = 'bcg-result is-unknown'; verResult.textContent = S.res_unsupported2x; verResult.hidden = false; return; }
      verBusy = true; verBtn.disabled = true; verCancel.hidden = false;
      setStatus(verStatus, fill(S.working, { pct: 0 }), 'info');
      try {
        var input = await passwordFor(p, pw);
        var r = await verClient.run({ type: 'hash', password: input, salt: plan.salt }, function (x) {
          setStatus(verStatus, fill(S.working, { pct: Math.round(x * 100) }), 'info');
        });
        if (!bench || p.cost >= bench.cost) bench = { cost: p.cost, ms: r.ms };
        var ok = judge(p, r.hash), nc = p.nonCanonicalSalt || p.nonCanonicalSum;
        var lines = [ok ? (nc ? S.res_matchNc : S.res_match) : S.res_noMatch];
        if (utf8Bytes(input).length > 72) lines.push(S.res_72);
        verResult.className = 'bcg-result ' + (ok ? (nc ? 'is-warn' : 'is-match') : 'is-nomatch');
        verResult.textContent = '';
        lines.forEach(function (t, i) { var el = document.createElement(i ? 'p' : 'strong'); el.textContent = t; verResult.appendChild(el); });
        verResult.hidden = false;
        showVariants(p);
        setStatus(verStatus, fill(S.done, { time: fmtTime(r.ms), cost: p.cost }), 'none');
        if (window.trackTool) window.trackTool('bcrypt-generator', 'verify');
      } catch (err) {
        if (err && err.cancelled) setStatus(verStatus, S.cancelled, 'none');
        else setStatus(verStatus, fill(S.workerFail, { msg: (err && err.message) || String(err) }), 'error');
      } finally {
        verBusy = false; verBtn.disabled = false; verCancel.hidden = true;
      }
    }

    verHash.addEventListener('input', function () { clearVerResult(); setStatus(verStatus, ''); renderParse(); });
    verPw.addEventListener('input', function () { clearVerResult(); updateVerPw(); });
    [verHash, verPw].forEach(function (el) {
      el.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.metaKey && !e.ctrlKey && !e.isComposing) { e.preventDefault(); verify(); }
      });
    });
    verBtn.addEventListener('click', verify);
    verCancel.addEventListener('click', function () { verClient.cancel(); });
    $('bcg-ver-example').addEventListener('click', function () {
      // Spring Security reference, "Password Storage Format": the stored value for "password".
      verHash.value = '{bcrypt}$2a$10$dXJ3SW6G7P50lGmMkkmwe.20cQQubK3.HZWzG3YB1tlRy.fqvM/BG';
      verPw.value = 'password';
      clearVerResult(); renderParse(); updateVerPw();
      verify();
    });

    // The site-wide Ctrl/⌘+L empties every text field in the widget; reset what depends on them.
    document.addEventListener('keydown', function (e) {
      if (!(e.metaKey || e.ctrlKey) || (e.key !== 'l' && e.key !== 'L')) return;
      var widget = document.querySelector('.tool-widget');
      if (!widget || !widget.contains(document.activeElement)) return;
      setTimeout(function () {
        genOut.hidden = true; genHash.textContent = ''; updateGenPw(); updateEstimate();
        clearVerResult(); renderParse(); updateVerPw(); setStatus(verStatus, '');
      }, 0);
    });

    updateGenPw();
    updatePrefixNote();
    updateEstimate();
    benchmark();
  })();
</script>

<style>
