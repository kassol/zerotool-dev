---
import { createHash } from 'node:crypto';
import workerSource from '../../../public/vendor/bcrypt-worker.js?raw';

const WORKER_URL = '/vendor/bcrypt-worker.js?v=' + createHash('sha256').update(workerSource).digest('hex').slice(0, 16);

// Bcrypt Generator & Checker — bcrypt hashes made and checked in a Web Worker in the browser.
// Engine (between engine:start / engine:end) is tested by scripts/test-bcrypt-generator.mjs,
// together with public/vendor/bcrypt-worker.js and the cross-library fixture.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

