---
import Toggletip from '../Toggletip.astro';
// RsaKeyGeneratorTool — generates RSA key pairs using Web Crypto API (runs in the browser)
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const labels = {
  en: {
    copyFailed: 'Copy failed. Try again.',
    badge: 'Your keys never leave this browser',
    keySize: 'Key Size',
    algorithm: 'Algorithm',
    format: 'Format',
    generate: 'Generate Key Pair',
    generating: 'Generating…',
    publicKey: 'Public Key',
    privateKey: 'Private Key',
    keepSecret: 'Keep secret',
    copy: 'Copy',
    copied: 'Copied!',
    download: 'Download',
    msgGenerating: 'Generating {bits}-bit key pair…',
    msgSuccess: 'Key pair generated successfully.',
    msgError: 'Error: ',
  },
  zh: {
    copyFailed: '复制失败，请重试。',
    badge: '密钥不会离开浏览器',
    keySize: '密钥长度',
    algorithm: '算法',
    format: '格式',
    generate: '生成密钥对',
    generating: '生成中…',
    publicKey: '公钥',
    privateKey: '私钥',
    keepSecret: '请妥善保管',
    copy: '复制',
    copied: '已复制！',
    download: '下载',
    msgGenerating: '正在生成 {bits} 位密钥对…',
    msgSuccess: '密钥对已生成。',
    msgError: '错误：',
  },
  ja: {
    copyFailed: 'コピーに失敗しました。再試行してください。',
    badge: '鍵はこのブラウザ外に出ません',
    keySize: '鍵のサイズ',
    algorithm: 'アルゴリズム',
    format: 'フォーマット',
    generate: '鍵ペアを生成',
    generating: '生成中…',
    publicKey: '公開鍵',
    privateKey: '秘密鍵',
    keepSecret: '秘密を保持',
    copy: 'コピー',
    copied: 'コピーしました！',
    download: 'ダウンロード',
    msgGenerating: '{bits}ビット鍵ペアを生成中…',
    msgSuccess: '鍵ペアが生成されました。',
    msgError: 'エラー：',
  },
  ko: {
    copyFailed: '복사하지 못했습니다. 다시 시도하세요.',
    badge: '키는 이 브라우저를 벗어나지 않습니다',
    keySize: '키 크기',
    algorithm: '알고리즘',
    format: '형식',
    generate: '키 쌍 생성',
    generating: '생성 중…',
    publicKey: '공개키',
    privateKey: '개인키',
    keepSecret: '비밀 유지',
    copy: '복사',
    copied: '복사됨!',
    download: '다운로드',
    msgGenerating: '{bits}비트 키 쌍 생성 중…',
    msgSuccess: '키 쌍이 생성되었습니다.',
    msgError: '오류: ',
  },
};

// strings:start
const STRINGS = {
  "en": {
    "empty": "Generate a key pair to view its public and private keys.",
    "tips": {
      "generate": "Generate uses the selected options. Ctrl or Command + L clears both outputs and ignores earlier completion.",
      "size": "Choose 2048 or 4096 bits. Generate reads the current size when clicked.",
      "algorithm": "RSA-OAEP uses encrypt/decrypt; RSASSA-PKCS1-v1_5 uses sign/verify. Both use SHA-256 and public exponent 65537.",
      "format": "PEM exports public SPKI and private PKCS8. JWK exports each key as formatted JSON.",
      "public": "Copy or Download uses the complete generated public key and its generated format, even after changing Format.",
      "private": "Keep the private key secret. Copy or Download uses the complete generated private key and its generated format."
    }
  },
  "zh": {
    "empty": "生成密钥对后，这里显示公钥和私钥。",
    "tips": {
      "generate": "生成按所选设置执行。Ctrl 或 Command + L 清除两个结果，并使旧任务迟到完成失效。",
      "size": "选择 2048 或 4096 位。点击生成时读取所选长度。",
      "algorithm": "RSA-OAEP 用于加密/解密；RSASSA-PKCS1-v1_5 用于签名/验证。两者都使用 SHA-256，公钥指数为 65537。",
      "format": "PEM 公钥使用 SPKI，私钥使用 PKCS8；JWK 把每个密钥导出为格式化 JSON。",
      "public": "复制或下载完整的已生成公钥，使用生成时的格式，之后切换格式不会改变下载后缀。",
      "private": "请妥善保管私钥。复制或下载完整的已生成私钥，并使用生成时的格式。"
    }
  },
  "ja": {
    "empty": "鍵ペアを生成すると、ここに公開鍵と秘密鍵を表示します。",
    "tips": {
      "generate": "生成は選択した設定を使います。Ctrl または Command + L は両方の結果を消し、古い処理の遅い完了を無効にします。",
      "size": "2048 または 4096 ビットを選びます。生成を押した時点のサイズを使います。",
      "algorithm": "RSA-OAEP は暗号化/復号、RSASSA-PKCS1-v1_5 は署名/検証用です。どちらも SHA-256 と公開指数 65537 を使います。",
      "format": "PEM は公開鍵を SPKI、秘密鍵を PKCS8 で出力します。JWK は各鍵を整形済み JSON にします。",
      "public": "コピーまたはダウンロードは生成した公開鍵の全内容と生成時の形式を使い、後の形式変更に影響されません。",
      "private": "秘密鍵は安全に保管してください。コピーまたはダウンロードは生成した秘密鍵の全内容と生成時の形式を使います。"
    }
  },
  "ko": {
    "empty": "키 쌍을 생성하면 여기에 공개키와 개인키가 표시됩니다.",
    "tips": {
      "generate": "생성은 선택한 설정을 사용합니다. Ctrl 또는 Command + L은 두 결과를 지우고 이전 작업의 늦은 완료를 무효화합니다.",
      "size": "2048 또는 4096비트를 선택하세요. 생성 버튼을 누를 때 선택한 크기를 읽습니다.",
      "algorithm": "RSA-OAEP는 암호화/복호화, RSASSA-PKCS1-v1_5는 서명/검증용입니다. 둘 다 SHA-256과 공개 지수 65537을 사용합니다.",
      "format": "PEM은 공개키를 SPKI, 개인키를 PKCS8로 내보내며 JWK는 각 키를 들여쓰기 JSON으로 내보냅니다.",
      "public": "복사나 다운로드는 생성된 공개키 전체와 생성 시 형식을 사용합니다. 이후 형식 변경은 확장자를 바꾸지 않습니다.",
      "private": "개인키를 안전하게 보관하세요. 복사나 다운로드는 생성된 개인키 전체와 생성 시 형식을 사용합니다."
    }
  }
};
// strings:end
const U = STRINGS[lang];

const L = labels[lang];
---
<div
  class="rkg-wrap"
  data-generate={L.generate}
  data-generating={L.generating}
  data-copy={L.copy}
  data-copy-failed={L.copyFailed}
  data-copied={L.copied}
  data-msg-generating={L.msgGenerating}
  data-msg-success={L.msgSuccess}
  data-msg-error={L.msgError}
>
  <div class="rkg-main">
    <aside class="rkg-rail zt-rail">
  {/* Privacy badge */}
  <div class="rkg-badge">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
    {L.badge}
  </div>

  {/* Options row */}
  <div class="rkg-options">
    <div class="rkg-opt">
      <div class="rkg-label-row"><label for="rkg-keysize">{L.keySize}</label><Toggletip id="rkg-tip-size" lang={lang} about={L.keySize}>{U.tips.size}</Toggletip></div>
      <select id="rkg-keysize">
        <option value="2048" selected>2048-bit</option>
        <option value="4096">4096-bit</option>
      </select>
    </div>
    <div class="rkg-opt">
      <div class="rkg-label-row"><label for="rkg-algo">{L.algorithm}</label><Toggletip id="rkg-tip-algorithm" lang={lang} about={L.algorithm}>{U.tips.algorithm}</Toggletip></div>
      <select id="rkg-algo">
        <option value="RSA-OAEP" selected>RSA-OAEP (encryption)</option>
        <option value="RSASSA-PKCS1-v1_5">RSASSA-PKCS1-v1_5 (signing)</option>
      </select>
    </div>
    <div class="rkg-opt">
      <div class="rkg-label-row"><label for="rkg-format">{L.format}</label><Toggletip id="rkg-tip-format" lang={lang} about={L.format}>{U.tips.format}</Toggletip></div>
      <select id="rkg-format">
        <option value="pem" selected>PEM</option>
        <option value="jwk">JWK</option>
      </select>
    </div>
  </div>

  <div class="rkg-actions">
    <button id="rkg-generate" class="btn-primary">{L.generate}</button><Toggletip id="rkg-tip-generate" lang={lang} about={L.generate}>{U.tips.generate}</Toggletip>
  </div>

  <div id="rkg-status" class="rkg-status" aria-live="polite"></div>

    </aside>
    <div class="rkg-results">
      <p class="rkg-empty">{U.empty}</p>
  {/* Public Key */}
  <div class="rkg-key-block" id="rkg-pub-block" style="display:none">
    <div class="rkg-key-label">
      <div class="rkg-label-row"><span>{L.publicKey}</span><Toggletip id="rkg-tip-public" lang={lang} about={L.publicKey}>{U.tips.public}</Toggletip></div>
      <div class="rkg-key-actions">
        <button id="rkg-pub-copy" class="btn-copy" type="button">{L.copy}</button>
        <button id="rkg-pub-dl" class="btn-secondary" type="button">{L.download}</button>
      </div>
    </div>
    <textarea id="rkg-pub-out" class="rkg-output" readonly spellcheck="false" rows="8"></textarea>
  </div>

  {/* Private Key */}
  <div class="rkg-key-block" id="rkg-priv-block" style="display:none">
    <div class="rkg-key-label">
      <div class="rkg-label-row"><span>{L.privateKey} <span class="rkg-private-tag">{L.keepSecret}</span></span><Toggletip id="rkg-tip-private" lang={lang} about={L.privateKey}>{U.tips.private}</Toggletip></div>
      <div class="rkg-key-actions">
        <button id="rkg-priv-copy" class="btn-copy" type="button">{L.copy}</button>
        <button id="rkg-priv-dl" class="btn-secondary" type="button">{L.download}</button>
      </div>
    </div>
    <textarea id="rkg-priv-out" class="rkg-output" readonly spellcheck="false" rows="12"></textarea>
  </div>

    </div>
  </div>

  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.rkg-wrap')
        : document.querySelector('.rkg-wrap');

      var GENERATE = wrap ? wrap.dataset.generate : 'Generate Key Pair';
      var GENERATING = wrap ? wrap.dataset.generating : 'Generating…';
      var COPY = wrap ? wrap.dataset.copy : 'Copy';
      var COPIED = wrap ? wrap.dataset.copied : 'Copied!';
      var COPY_FAILED = wrap.dataset.copyFailed;
      var MSG_GENERATING = wrap ? wrap.dataset.msgGenerating : 'Generating {bits}-bit key pair…';
      var MSG_SUCCESS = wrap ? wrap.dataset.msgSuccess : 'Key pair generated successfully.';
      var MSG_ERROR = wrap ? wrap.dataset.msgError : 'Error: ';

      var statusEl = document.getElementById('rkg-status');
      var pubBlock = document.getElementById('rkg-pub-block');
      var privBlock = document.getElementById('rkg-priv-block');
      var pubOut = document.getElementById('rkg-pub-out');
      var privOut = document.getElementById('rkg-priv-out');

      function setStatus(msg, isError) {
        statusEl.textContent = msg;
        statusEl.className = 'rkg-status ' + (isError ? 'error' : 'success');
      }

      function ab2b64(buf) {
        var bytes = new Uint8Array(buf);
        var binary = '';
        var chunk = 8192;
        for (var i = 0; i < bytes.length; i += chunk) {
          binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
        }
        return btoa(binary);
      }

      function wrapPem(b64, label) {
        var lines = b64.match(/.{1,64}/g) || [];
        return '-----BEGIN ' + label + '-----\n' + lines.join('\n') + '\n-----END ' + label + '-----';
      }

      function download(filename, content) {
        var blob = new Blob([content], { type: 'text/plain' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename;
        a.click();
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      }

      var copyStates = new Map();
      function resetCopy(btn, label) {
        var previous = copyStates.get(btn);
        if (previous) clearTimeout(previous.timer);
        var state = { timer: null };
        copyStates.set(btn, state);
        btn.textContent = label;
        return state;
      }
      function copyText(btn, text, label, copied, delay) {
        if (!text || btn.disabled) return;
        var state = resetCopy(btn, label);
        function current() { return copyStates.get(btn) === state; }
        function failed() { if (current()) btn.textContent = COPY_FAILED; }
        try {
          if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') { failed(); return; }
          Promise.resolve(navigator.clipboard.writeText(text)).then(function () {
            if (!current()) return;
            btn.textContent = copied;
            state.timer = setTimeout(function () { if (current()) btn.textContent = label; }, delay);
          }, failed);
        } catch (e) { failed(); }
      }
      var generationVersion = 0;
      var generatedFormat = null;
      var pubCopy = document.getElementById('rkg-pub-copy');
      var privCopy = document.getElementById('rkg-priv-copy');
      var pubDownload = document.getElementById('rkg-pub-dl');
      var privDownload = document.getElementById('rkg-priv-dl');
      function clearResults() {
        pubOut.value = '';
        privOut.value = '';
        pubBlock.style.display = 'none';
        privBlock.style.display = 'none';
        generatedFormat = null;
        resetCopy(pubCopy, COPY);
        resetCopy(privCopy, COPY);
        pubCopy.disabled = privCopy.disabled = pubDownload.disabled = privDownload.disabled = true;
      }
      clearResults();
      document.getElementById('rkg-generate').addEventListener('click', async function () {
        var version = ++generationVersion;
        clearResults();
        var keysize = parseInt(document.getElementById('rkg-keysize').value);
        var algo = document.getElementById('rkg-algo').value;
        var format = document.getElementById('rkg-format').value;

        var btn = this;
        btn.disabled = true;
        btn.textContent = GENERATING;
        setStatus(MSG_GENERATING.replace('{bits}', keysize), false);
        statusEl.className = 'rkg-status';
        pubBlock.style.display = 'none';
        privBlock.style.display = 'none';

        try {
          var hashAlgo = 'SHA-256';
          var usages;
          if (algo === 'RSA-OAEP') {
            usages = ['encrypt', 'decrypt'];
          } else {
            usages = ['sign', 'verify'];
          }

          var keyPair = await crypto.subtle.generateKey(
            { name: algo, modulusLength: keysize, publicExponent: new Uint8Array([1, 0, 1]), hash: hashAlgo },
            true,
            usages
          );
          if (version !== generationVersion) return;

          var pubText, privText;

          if (format === 'pem') {
            var pubDer = await crypto.subtle.exportKey('spki', keyPair.publicKey);
            if (version !== generationVersion) return;
            var privDer = await crypto.subtle.exportKey('pkcs8', keyPair.privateKey);
            if (version !== generationVersion) return;
            pubText = wrapPem(ab2b64(pubDer), 'PUBLIC KEY');
            privText = wrapPem(ab2b64(privDer), 'PRIVATE KEY');
          } else {
            var pubJwk = await crypto.subtle.exportKey('jwk', keyPair.publicKey);
            if (version !== generationVersion) return;
            var privJwk = await crypto.subtle.exportKey('jwk', keyPair.privateKey);
            if (version !== generationVersion) return;
            pubText = JSON.stringify(pubJwk, null, 2);
            privText = JSON.stringify(privJwk, null, 2);
          }

          generatedFormat = format;
          pubCopy.disabled = privCopy.disabled = pubDownload.disabled = privDownload.disabled = false;
          pubOut.value = pubText;
          privOut.value = privText;
          pubBlock.style.display = '';
          privBlock.style.display = '';
          setStatus(MSG_SUCCESS, false);

          window.trackTool && window.trackTool('rsa-key-generator', 'generate');
        } catch (e) {
          if (version !== generationVersion) return;
          setStatus(MSG_ERROR + e.message, true);
        } finally {
          if (version !== generationVersion) return;
          btn.disabled = false;
          btn.textContent = GENERATE;
        }
      });

      document.getElementById('rkg-pub-copy').addEventListener('click', function () {
        copyText(this, pubOut.value, COPY, COPIED, 1500);
      });

      document.getElementById('rkg-priv-copy').addEventListener('click', function () {
        copyText(this, privOut.value, COPY, COPIED, 1500);
      });

      document.getElementById('rkg-pub-dl').addEventListener('click', function () {
        var fmt = generatedFormat;
        if (!fmt) return;
        download('public-key.' + (fmt === 'pem' ? 'pem' : 'json'), pubOut.value);
      });

      document.getElementById('rkg-priv-dl').addEventListener('click', function () {
        var fmt = generatedFormat;
        if (!fmt) return;
        download('private-key.' + (fmt === 'pem' ? 'pem' : 'json'), privOut.value);
      });
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l') return;
        var tool = document.querySelector('.rkg-wrap');
        if (!tool || !tool.contains(document.activeElement)) return;
        generationVersion++;
        clearResults();
        statusEl.textContent = '';
        statusEl.className = 'rkg-status';
        var btn = document.getElementById('rkg-generate');
        btn.disabled = false;
        btn.textContent = GENERATE;
      });
    })();
  </script>
</div>

<style>
  .rkg-wrap { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; }

  .rkg-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #057a55;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    align-self: flex-start;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .rkg-badge { color: #34d399; background: #064e3b22; border-color: #065f4622; }
  }
  [data-theme="dark"] .rkg-badge { color: #34d399; background: #064e3b22; border-color: #065f4622; }

  .rkg-options {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .rkg-opt {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .rkg-opt label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .rkg-opt select {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    font-size: 0.88rem;
  }

  .rkg-actions { display: flex; gap: 0.5rem; }

  .rkg-status { font-size: 0.85rem; min-height: 1.2rem; }
  .rkg-status.success { color: #057a55; }
  .rkg-status.error { color: #c0392b; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .rkg-status.success { color: #34d399; }
    :root:not([data-theme="light"]) .rkg-status.error { color: #f87171; }
  }
  [data-theme="dark"] .rkg-status.success { color: #34d399; }
  [data-theme="dark"] .rkg-status.error { color: #f87171; }

  .rkg-key-block { display: flex; flex-direction: column; gap: 0.4rem; }

  .rkg-key-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .rkg-key-actions { display: flex; gap: 0.4rem; }

  .rkg-private-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: #b45309;
    background: #fef3c7;
    border: 1px solid #fde68a;
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    margin-left: 0.5rem;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .rkg-private-tag { color: #fbbf24; background: #78350f22; border-color: #92400e22; }
  }
  [data-theme="dark"] .rkg-private-tag { color: #fbbf24; background: #78350f22; border-color: #92400e22; }

  .rkg-output {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    resize: vertical;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    word-break: break-all;
  }

  .rkg-output:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .rkg-main { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 1rem; flex: 1 1 0; min-width: 0; min-height: 0; }
  .rkg-rail { overflow: auto; gap: 0.65rem; }
  .rkg-options { flex-direction: column; gap: 0.75rem; }
  .rkg-opt { min-width: 0; }
  .rkg-label-row { display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem; }
  .rkg-opt select { width: 100%; min-width: 0; }
  .rkg-actions { align-items: center; }
  .rkg-status { flex: none; min-height: 2.8em; line-height: 1.4; }
  .rkg-results { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; overflow: hidden; }
