---
import Toggletip from '../Toggletip.astro';
// TomlJsonTool — bidirectional TOML ↔ JSON converter (smol-toml, bundled from npm).
// Values the target cannot hold as written stop the conversion with their JSON Pointer paths:
// TOML inf / nan going to JSON, TOML date-times and times with more than millisecond precision,
// JSON null going to TOML, JSON integers outside ±(2^53 − 1) and JSON numbers that overflow
// (conversion-fidelity.js). The old output is cleared and its copy button disabled. -0.0 is
// written as -0.0 both ways; the JSON integer -0 is the integer 0.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  en: { copy: 'Copy', copied: 'Copied!', copyFailed: 'Copy failed. Try again.', clear: 'Clear', msgTomlToJson: 'Converted TOML to JSON.', msgJsonToToml: 'Converted JSON to TOML.', msgInvalidToml: 'Invalid TOML', msgInvalidJson: 'Invalid JSON', msgError: 'Error', tips: {
    toml: "Paste TOML here. After 0.3 seconds without typing, the JSON pane updates with two-space indentation. Values JSON cannot preserve stop conversion; the status names the affected fields.",
    json: "Paste a JSON object here. After 0.3 seconds without typing, the TOML pane updates. Null values and numbers that cannot be preserved stop conversion.",
    copyToml: "Copies all current text in the TOML pane, including your edits. An empty pane cannot be copied.",
    copyJson: "Copies all current text in the JSON pane, including your edits. An empty pane cannot be copied.",
    clear: "Clears both panes, the status and pending conversion. Ctrl+L (⌘+L on Mac) does the same while focus is inside this tool.",
  } },
  zh: { copy: '复制', copied: '已复制！', copyFailed: '复制失败，请重试。', clear: '清除', msgTomlToJson: '已将 TOML 转换为 JSON。', msgJsonToToml: '已将 JSON 转换为 TOML。', msgInvalidToml: '无效 TOML', msgInvalidJson: '无效 JSON', msgError: '错误', tips: {
    toml: "在此粘贴 TOML。停止输入 0.3 秒后，JSON 面板会更新并使用两个空格缩进。遇到 JSON 无法原样保存的值时会停止转换，状态行会指出对应字段。",
    json: "在此粘贴 JSON 对象。停止输入 0.3 秒后，TOML 面板会更新。null 或无法原样保存的数字会停止转换。",
    copyToml: "复制 TOML 面板当前的全部文本，包括您编辑的内容。面板为空时无法复制。",
    copyJson: "复制 JSON 面板当前的全部文本，包括您编辑的内容。面板为空时无法复制。",
    clear: "清空两个面板、状态和等待执行的转换。焦点在工具内时，Ctrl+L（Mac 为 ⌘+L）也会清空。",
  } },
  ja: { copy: 'コピー', copied: 'コピー済み！', copyFailed: 'コピーできませんでした。もう一度お試しください。', clear: 'クリア', msgTomlToJson: 'TOML を JSON に変換しました。', msgJsonToToml: 'JSON を TOML に変換しました。', msgInvalidToml: '無効な TOML', msgInvalidJson: '無効な JSON', msgError: 'エラー', tips: {
    toml: "TOML を貼り付けます。入力を止めて0.3秒後に、JSON 欄がスペース2個のインデントで更新されます。JSON で元の値を保てない場合は変換を止め、対象フィールドをステータスに表示します。",
    json: "JSON オブジェクトを貼り付けます。入力を止めて0.3秒後に TOML 欄が更新されます。null や元の値を保てない数値があると変換を止めます。",
    copyToml: "TOML 欄の現在のテキストを、編集内容も含めてすべてコピーします。空の欄はコピーできません。",
    copyJson: "JSON 欄の現在のテキストを、編集内容も含めてすべてコピーします。空の欄はコピーできません。",
    clear: "両方の欄、ステータス、待機中の変換をクリアします。ツール内にフォーカスがある場合は Ctrl+L（Mac は ⌘+L）でもクリアできます。",
  } },
  ko: { copy: '복사', copied: '복사됨!', copyFailed: '복사하지 못했습니다. 다시 시도하세요.', clear: '지우기', msgTomlToJson: 'TOML을 JSON으로 변환했습니다.', msgJsonToToml: 'JSON을 TOML로 변환했습니다.', msgInvalidToml: '유효하지 않은 TOML', msgInvalidJson: '유효하지 않은 JSON', msgError: '오류', tips: {
    toml: "TOML을 붙여 넣으세요. 입력을 멈추고 0.3초 뒤 JSON 칸이 공백 두 개 들여쓰기로 갱신됩니다. JSON에 원래 값을 담을 수 없으면 변환을 멈추고 상태에 해당 필드를 표시합니다.",
    json: "JSON 객체를 붙여 넣으세요. 입력을 멈추고 0.3초 뒤 TOML 칸이 갱신됩니다. null이나 원래 값을 보존할 수 없는 숫자가 있으면 변환을 멈춥니다.",
    copyToml: "직접 편집한 내용을 포함하여 TOML 칸의 현재 텍스트 전체를 복사합니다. 빈 칸은 복사할 수 없습니다.",
    copyJson: "직접 편집한 내용을 포함하여 JSON 칸의 현재 텍스트 전체를 복사합니다. 빈 칸은 복사할 수 없습니다.",
    clear: "두 칸과 상태를 지우고 대기 중인 변환을 취소합니다. 도구 안에 포커스가 있을 때 Ctrl+L(Mac은 ⌘+L)로도 지울 수 있습니다.",
  } },
};
// strings:end
const T = STRINGS[lang] || STRINGS.en;
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="tj-wrap" data-lang={lang} data-strings={JSON.stringify(CLIENT_T)}>
  <div class="tj-toolbar">
    <button id="tj-clear" class="btn-ghost" type="button">{T.clear}</button>
    <Toggletip id="tj-tip-clear" about={T.clear} lang={lang}>{TIPS.clear}</Toggletip>
  </div>

  <div id="tj-status" class="tj-status" aria-live="polite"></div>

  <div class="tj-panels zt-io">
    <div class="tj-panel zt-io-pane">
      <div class="tj-head">
        <div class="tj-control">
          <label for="tj-toml">TOML</label>
          <Toggletip id="tj-tip-toml" about="TOML" lang={lang}>{TIPS.toml}</Toggletip>
        </div>
        <div class="tj-control">
          <button id="tj-copy-toml" class="btn-copy" type="button" disabled>{T.copy}</button>
          <Toggletip id="tj-tip-copy-toml" about={T.copy + ' TOML'} lang={lang}>{TIPS.copyToml}</Toggletip>
        </div>
      </div>
      <textarea
        id="tj-toml"
        class="tool-textarea tj-box zt-io-fill"
        placeholder={'[database]\nhost = "localhost"\nport = 5432\nenabled = true'}
        spellcheck="false"
      ></textarea>
    </div>
    <div class="tj-panel zt-io-pane">
      <div class="tj-head">
        <div class="tj-control">
          <label for="tj-json">JSON</label>
          <Toggletip id="tj-tip-json" about="JSON" lang={lang}>{TIPS.json}</Toggletip>
        </div>
        <div class="tj-control">
          <button id="tj-copy-json" class="btn-copy" type="button" disabled>{T.copy}</button>
          <Toggletip id="tj-tip-copy-json" about={T.copy + ' JSON'} lang={lang}>{TIPS.copyJson}</Toggletip>
        </div>
      </div>
      <textarea
        id="tj-json"
        class="tool-textarea tj-box zt-io-fill"
        placeholder='{"database":{"host":"localhost","port":5432,"enabled":true}}'
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <script>
    import { parse, stringify } from 'smol-toml';
    import { parseJsonExact, findLosses, formatLosses, markTomlTimes, stringifyJson } from './conversion-fidelity.js';

    const tomlEl = document.getElementById('tj-toml') as HTMLTextAreaElement;
    const jsonEl = document.getElementById('tj-json') as HTMLTextAreaElement;
    const statusEl = document.getElementById('tj-status') as HTMLElement;
    const copyTomlBtn = document.getElementById('tj-copy-toml') as HTMLButtonElement;
    const copyJsonBtn = document.getElementById('tj-copy-json') as HTMLButtonElement;
    const tjWrap = document.querySelector('.tj-wrap') as HTMLElement;
    const S = JSON.parse(tjWrap.dataset.strings || '{}');
    const LANG = tjWrap.dataset.lang || 'en';

    type Result = { ok: true; text: string } | { ok: false; message: string };

    function tomlToJson(raw: string): Result {
      let data: any;
      try { data = markTomlTimes(raw, parse, parse(raw)); }
      catch (e: any) { return { ok: false, message: S.msgInvalidToml + ': ' + (e?.message || String(e)) }; }
      const found = findLosses(data, 'json');
      if (found.count) return { ok: false, message: formatLosses(found, 'JSON', LANG) };
      return { ok: true, text: stringifyJson(found.value, 2) };
    }

    function jsonToToml(raw: string): Result {
      let data: any;
      try { data = parseJsonExact(raw); }
      catch (e: any) { return { ok: false, message: S.msgInvalidJson + ': ' + (e?.message || String(e)) }; }
      const found = findLosses(data, 'toml');
      if (found.count) return { ok: false, message: formatLosses(found, 'TOML', LANG) };
      try { return { ok: true, text: stringify(found.value) }; }
      catch (e: any) { return { ok: false, message: S.msgError + ': ' + (e?.message || String(e)) }; }
    }

    function syncCopy() {
      copyTomlBtn.disabled = !tomlEl.value;
      copyJsonBtn.disabled = !jsonEl.value;
    }

    function setStatus(msg: string, isError: boolean) {
      copyErrorOwner = null;
      statusEl.textContent = msg;
      statusEl.className = 'tj-status ' + (isError ? 'error' : 'success');
    }

    function clearStatus() {
      copyErrorOwner = null;
      statusEl.textContent = '';
      statusEl.className = 'tj-status';
    }

    let copyRevision = 0;
    let copyErrorOwner: HTMLButtonElement | null = null;
    const copyStates = [copyTomlBtn, copyJsonBtn].map(btn => ({ btn, request: 0, timer: null as ReturnType<typeof setTimeout> | null }));

    function invalidateCopies() {
      copyRevision++;
      copyErrorOwner = null;
      copyStates.forEach(state => {
        if (state.timer) clearTimeout(state.timer);
        state.timer = null;
        state.btn.textContent = S.copy;
      });
    }

    function cancelQueued() {
      if (_tjTomlTimer) clearTimeout(_tjTomlTimer);
      if (_tjJsonTimer) clearTimeout(_tjJsonTimer);
      _tjTomlTimer = _tjJsonTimer = null;
    }

    /* Runs one direction; a failed conversion clears the output so a stale result cannot be copied. */
    function run(fromEl: HTMLTextAreaElement, toEl: HTMLTextAreaElement, convert: (raw: string) => Result, okMsg: string): boolean {
      cancelQueued();
      invalidateCopies();
      const raw = fromEl.value.trim();
      if (!raw) { toEl.value = ''; clearStatus(); syncCopy(); return false; }
      const r = convert(raw);
      if (r.ok) { toEl.value = r.text; setStatus(okMsg, false); }
      else { toEl.value = ''; setStatus(r.message, true); }
      syncCopy();
      return r.ok;
    }
    const runToml = () => run(tomlEl, jsonEl, tomlToJson, S.msgTomlToJson);
    const runJson = () => run(jsonEl, tomlEl, jsonToToml, S.msgJsonToToml);

    /* ── Real-time conversion (debounced 300ms) ── */
    let _tjTomlTimer: ReturnType<typeof setTimeout> | null = null;
    tomlEl.addEventListener('input', () => {
      cancelQueued();
      invalidateCopies();
      syncCopy();
      _tjTomlTimer = setTimeout(runToml, 300);
    });

    let _tjJsonTimer: ReturnType<typeof setTimeout> | null = null;
    jsonEl.addEventListener('input', () => {
      cancelQueued();
      invalidateCopies();
      syncCopy();
      _tjJsonTimer = setTimeout(runJson, 300);
    });

    function clearAll() {
      cancelQueued();
      invalidateCopies();
      tomlEl.value = '';
      jsonEl.value = '';
      clearStatus();
      syncCopy();
      tomlEl.focus();
    }
    document.getElementById('tj-clear')!.addEventListener('click', clearAll);

    /* ── Copy buttons ── */
    function copyFrom(el: HTMLTextAreaElement, btn: HTMLButtonElement) {
      if (!el.value || btn.disabled) return;
      const state = copyStates[btn === copyTomlBtn ? 0 : 1];
      const request = ++state.request;
      const revision = copyRevision;
      const text = el.value;
      if (state.timer) clearTimeout(state.timer);
      state.timer = null;
      btn.textContent = S.copy;
      const current = () => revision === copyRevision && request === state.request && el.value === text && !btn.disabled;
      const failed = () => {
        if (!current()) return;
        setStatus(S.copyFailed, true);
        copyErrorOwner = btn;
      };
      const done = () => {
        if (!current()) return;
        if (copyErrorOwner === btn && statusEl.textContent === S.copyFailed) clearStatus();
        btn.textContent = S.copied;
        state.timer = setTimeout(() => { if (current()) btn.textContent = S.copy; }, 1500);
      };
      try {
        if (!navigator.clipboard?.writeText) { failed(); return; }
        navigator.clipboard.writeText(text).then(done, failed);
      } catch { failed(); }
    }
    copyTomlBtn.addEventListener('click', () => copyFrom(tomlEl, copyTomlBtn));
    copyJsonBtn.addEventListener('click', () => copyFrom(jsonEl, copyJsonBtn));

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && tjWrap.contains(document.activeElement)) {
        e.preventDefault();
        clearAll();
      }
    });

    /* ── Page load ── Astro bundles this script as a module, which runs only after the page is
       parsed. Text typed (or restored by the browser) before then had no input listener, so
       convert it once now: the focused panel first, else the TOML panel, else the JSON panel. */
    const focused = document.activeElement;
    if (focused === jsonEl && jsonEl.value.trim()) runJson();
    else if (tomlEl.value.trim()) runToml();
    else if (jsonEl.value.trim()) runJson();
  </script>
</div>

<style>
  .tj-wrap { display: flex; flex-direction: column; gap: 0.6rem; min-width: 0; min-height: 0; }
  .tj-toolbar { display: flex; align-items: center; gap: 0.4rem; flex: none; }
  .tj-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; min-height: 32px; }
  .tj-control { display: flex; align-items: center; gap: 0.25rem; min-width: 0; }
  .tj-head label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }
  .tj-box { min-width: 0; overflow: auto; tab-size: 2; }
  .tj-status { height: 2.6rem; min-height: 2.6rem; flex: none; overflow: auto; overflow-wrap: anywhere; font-size: 0.85rem; line-height: 1.5; color: var(--color-text-secondary); }
  .tj-status.success { color: var(--color-success); }
  .tj-status.error { color: var(--color-danger); }

  @media (max-width: 860px) {
    .tj-box { height: 180px; }
    .tj-status { height: 3.25rem; min-height: 3.25rem; }
  }
  @media (max-width: 640px) {
    .tj-wrap { gap: 0.5rem; }
    .tj-head { min-height: 44px; }
    .tj-box { height: 120px; }
  }
</style>
