// SHA-256 from crypto.subtle. The page never writes the verifier to storage or to the URL
// (persistence policy `disabled` in src/data/persistence.ts) and makes no network requests.
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

