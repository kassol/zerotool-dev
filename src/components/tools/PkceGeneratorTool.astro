const L = STRINGS[lang];
---
<div class="pkce-wrap">
  <div class="pkce-controls">
    <button id="pkce-generate" class="btn-primary" type="button">{L.generate}</button>
    <label class="pkce-len">
      <span class="pkce-len-label">{L.length}</span>
      <input id="pkce-length" class="tool-input" type="number" min="43" max="128" step="1" value="43" inputmode="numeric" aria-label={L.lengthAria} />
    </label>
    <div class="pkce-methods" role="radiogroup" aria-label={L.methodAria}>
      <label class="pkce-method pkce-method--active"><input type="radio" name="pkce-method" value="S256" checked /><span>S256</span></label>
      <label class="pkce-method"><input type="radio" name="pkce-method" value="plain" /><span>plain</span></label>
    </div>
  </div>

  <div class="pkce-block">
    <div class="pkce-head">
      <label class="pkce-name" for="pkce-verifier">code_verifier</label>
      <span id="pkce-meta" class="pkce-meta"></span>
      <button id="pkce-copy-verifier" class="btn-copy" type="button">{L.copy}</button>
    </div>
    <textarea
      id="pkce-verifier"
      class="tool-textarea pkce-verifier"
      rows="2"
      spellcheck="false"
      autocapitalize="off"
      autocorrect="off"
      autocomplete="off"
      placeholder={L.verifierPlaceholder}
    ></textarea>
    <p id="pkce-verifier-status" class="tool-status error" role="status" aria-live="polite" hidden></p>
  </div>

  <div class="pkce-block pkce-result">
    <div class="pkce-head">
      <span id="pkce-challenge-label" class="pkce-name">code_challenge (S256)</span>
      <button id="pkce-copy-challenge" class="btn-copy" type="button">{L.copy}</button>
    </div>
    <code id="pkce-challenge" class="pkce-challenge" aria-labelledby="pkce-challenge-label">—</code>
    <p id="pkce-method-status" class="tool-status info" role="status" aria-live="polite" hidden></p>
  </div>

  <details class="pkce-details">
    <summary><span>{L.compareTitle}</span><span class="pkce-tip">{L.compareHint}</span></summary>
    <div class="pkce-details-body">
      <label class="tool-label" for="pkce-compare">{L.compareLabel}</label>
      <input id="pkce-compare" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" placeholder={L.comparePlaceholder} />
      <p id="pkce-compare-status" class="tool-status none" role="status" aria-live="polite"></p>
    </div>
  </details>

  <details class="pkce-details">
    <summary><span>{L.authTitle}</span><span class="pkce-tip">{L.authHint}</span></summary>
    <div class="pkce-details-body">
      <div class="pkce-field">
        <label class="tool-label" for="pkce-endpoint">{L.endpointLabel}</label>
        <input id="pkce-endpoint" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" value="https://auth.example.com/authorize" />
      </div>
      <div class="pkce-grid">
        <div class="pkce-field">
          <label class="tool-label" for="pkce-client-id">client_id</label>
          <input id="pkce-client-id" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" value="YOUR_CLIENT_ID" />
        </div>
        <div class="pkce-field">
          <label class="tool-label" for="pkce-redirect">redirect_uri</label>
          <input id="pkce-redirect" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" value="https://app.example.com/callback" />
        </div>
        <div class="pkce-field">
          <label class="tool-label" for="pkce-scope">scope</label>
          <input id="pkce-scope" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" value="openid profile" />
        </div>
        <div class="pkce-field">
          <label class="tool-label" for="pkce-state">state</label>
          <input id="pkce-state" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" />
        </div>
        <div class="pkce-field" id="pkce-nonce-field">
          <label class="tool-label" for="pkce-nonce">nonce</label>
          <input id="pkce-nonce" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" />
        </div>
      </div>
      <p class="pkce-note">{L.stateNote}</p>
      <div class="pkce-out">
        <code id="pkce-authurl" class="pkce-out-text">—</code>
        <button id="pkce-copy-authurl" class="btn-copy" type="button">{L.copy}</button>
      </div>
      <p id="pkce-auth-status" class="tool-status error" role="status" aria-live="polite" hidden></p>
    </div>
  </details>

  <details class="pkce-details">
    <summary><span>{L.tokenTitle}</span><span class="pkce-tip">{L.tokenHint}</span></summary>
    <div class="pkce-details-body">
      <div class="pkce-grid">
        <div class="pkce-field">
          <label class="tool-label" for="pkce-token-endpoint">{L.tokenEndpointLabel}</label>
          <input id="pkce-token-endpoint" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" value="https://auth.example.com/token" />
        </div>
        <div class="pkce-field">
          <label class="tool-label" for="pkce-code">{L.codeLabel}</label>
          <input id="pkce-code" class="tool-input" type="text" spellcheck="false" autocapitalize="off" autocorrect="off" autocomplete="off" value="AUTHORIZATION_CODE" />
        </div>
      </div>
      <div class="pkce-out">
        <pre id="pkce-curl" class="pkce-out-text">—</pre>
        <button id="pkce-copy-curl" class="btn-copy" type="button">{L.copy}</button>
      </div>
    </div>
  </details>

  <p class="pkce-privacy">{L.privacy}</p>
</div>

<script is:inline define:vars={{ S: L }}>
  (function () {
    /* ── engine:start ── */
    var MIN_LEN = 43;
    var MAX_LEN = 128;
    var UNRESERVED_CHAR = /^[A-Za-z0-9\-._~]$/;

    function base64url(bytes) {
      var bin = '';
      for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    function base64urlDecode(s) {
      if (!/^[A-Za-z0-9_-]+$/.test(s) || s.length % 4 === 1) return null;
      var b64 = s.replace(/-/g, '+').replace(/_/g, '/');
      while (b64.length % 4) b64 += '=';
      var bin = atob(b64);
      var out = new Uint8Array(bin.length);
      for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
      return out;
    }

    // Fewest random bytes whose base64url encoding reaches `len` characters.
    // 43 → 32 bytes, the recipe of RFC 7636 §4.1 and §7.1.
    function bytesForLength(len) {
      return Math.floor(3 * (len - 1) / 4) + 1;
    }

    // Each kept base64url character carries 6 random bits; a full 32-byte
    // encoding (43 characters) carries the 256 bits of the bytes.
    function entropyBits(len) {
      return Math.min(8 * bytesForLength(len), 6 * len);
    }

    function generateVerifier(len, fill) {
      var bytes = new Uint8Array(bytesForLength(len));
      fill(bytes);
      return base64url(bytes).slice(0, len);
    }

    function randomToken(byteCount, fill) {
      var bytes = new Uint8Array(byteCount);
      fill(bytes);
      return base64url(bytes);
    }

    // { code: 'ok' | 'empty' | 'char' | 'short' | 'long', value, len, ch, pos, hint }
    function validateVerifier(raw) {
      var value = String(raw || '').trim();
      var chars = Array.from(value);
      var res = { code: 'ok', value: value, len: chars.length, ch: '', pos: 0, hint: '' };
      if (!value) { res.code = 'empty'; return res; }
      for (var i = 0; i < chars.length; i++) {
        var c = chars[i];
        if (UNRESERVED_CHAR.test(c)) continue;
        res.code = 'char';
        res.ch = c;
        res.pos = i + 1;
        if (c === '+' || c === '/' || c === '=') res.hint = 'base64';
        else if (/\s/.test(c)) res.hint = 'space';
        else if (c.charCodeAt(0) > 0x7e) res.hint = 'nonascii';
        return res;
      }
      if (chars.length < MIN_LEN) res.code = 'short';
      else if (chars.length > MAX_LEN) res.code = 'long';
      return res;
    }

    async function sha256(bytes) {
      if (!globalThis.crypto || !crypto.subtle) throw new Error('subtle-unavailable');
      return new Uint8Array(await crypto.subtle.digest('SHA-256', bytes));
    }

    function ascii(s) {
      var out = new Uint8Array(s.length);
      for (var i = 0; i < s.length; i++) out[i] = s.charCodeAt(i);
      return out;
    }

    // RFC 7636 §4.2. `verifier` must already be valid (ASCII only).
    async function computeChallenge(verifier, method) {
      if (method === 'plain') return verifier;
      return base64url(await sha256(ascii(verifier)));
    }

    // Classify a pasted code_challenge against the verifier: the usual ways a
    // client builds the challenge wrong.
    async function diagnoseChallenge(verifier, given, method) {
      var g = String(given || '').trim();
      var digest = await sha256(ascii(verifier));
      var s256 = base64url(digest);
      var expected = method === 'plain' ? verifier : s256;
      var res = { code: 'mismatch', expected: expected };
      if (!g) { res.code = 'empty'; return res; }
      if (g === expected) { res.code = 'match'; return res; }
      if (method === 'plain') {
        if (g === s256) res.code = 's256';
        return res;
      }
      if (g.replace(/=+$/, '') === s256) { res.code = 'padding'; return res; }
      var std = btoa(String.fromCharCode.apply(null, digest));
      if (g === std || g === std.replace(/=+$/, '')) { res.code = 'base64'; return res; }
      var hex = '';
      for (var i = 0; i < digest.length; i++) hex += (digest[i] < 16 ? '0' : '') + digest[i].toString(16);
      if (g.toLowerCase() === hex) { res.code = 'hex'; return res; }
      if (g === verifier) { res.code = 'plain'; return res; }
      var raw = base64urlDecode(verifier);
      if (raw && base64url(await sha256(raw)) === g) { res.code = 'rawBytes'; return res; }
      return res;
    }

    // { url } or { error: 'endpoint' | 'fragment' }. Parameters go through
    // URLSearchParams (application/x-www-form-urlencoded, RFC 6749 Appendix B);
    // existing query parameters with the same names are replaced.
    function buildAuthUrl(o) {
      var endpoint = String(o.endpoint || '').trim();
      var u;
      try { u = new URL(endpoint); } catch (e) { return { error: 'endpoint' }; }
      if (u.protocol !== 'https:' && u.protocol !== 'http:') return { error: 'endpoint' };
      if (endpoint.indexOf('#') !== -1) return { error: 'fragment' };
      var scope = String(o.scope || '').trim();
      var openid = scope.split(/\s+/).indexOf('openid') !== -1;
      var params = [
        ['response_type', 'code'],
        ['client_id', o.clientId],
        ['redirect_uri', o.redirectUri],
        ['scope', scope],
        ['state', o.state],
        ['nonce', openid ? o.nonce : ''],
        ['code_challenge', o.challenge],
        ['code_challenge_method', o.method],
      ];
      params.forEach(function (p) { u.searchParams.delete(p[0]); });
      params.forEach(function (p) {
        var v = String(p[1] || '').trim();
        if (v) u.searchParams.append(p[0], v);
      });
      return { url: u.toString() };
    }

    // POSIX single quotes: a'b becomes 'a'\''b'.
    function shQuote(s) {
      return "'" + String(s).replace(/'/g, "'\\''") + "'";
    }

    // RFC 6749 §4.1.3 + RFC 7636 §4.5. The method only matters at /authorize;
    // the token request always carries the verifier itself.
    function buildCurl(o) {
      var body = new URLSearchParams();
      body.set('grant_type', 'authorization_code');
      body.set('code', String(o.code || '').trim() || 'AUTHORIZATION_CODE');
      var redirect = String(o.redirectUri || '').trim();
      if (redirect) body.set('redirect_uri', redirect);
      var clientId = String(o.clientId || '').trim();
      if (clientId) body.set('client_id', clientId);
      body.set('code_verifier', o.verifier);
      return [
        'curl -X POST ' + shQuote(String(o.tokenEndpoint || '').trim()) + ' \\',
        "  -H 'Content-Type: application/x-www-form-urlencoded' \\",
        '  --data ' + shQuote(body.toString()),
      ].join('\n');
    }
    /* ── engine:end ── */

    var $ = function (id) { return document.getElementById(id); };
    var wrap = document.querySelector('.pkce-wrap');
    var generateBtn = $('pkce-generate');
    var lengthEl = $('pkce-length');
    var verifierEl = $('pkce-verifier');
    var metaEl = $('pkce-meta');
    var verifierStatus = $('pkce-verifier-status');
    var challengeLabel = $('pkce-challenge-label');
    var challengeEl = $('pkce-challenge');
    var methodStatus = $('pkce-method-status');
    var compareEl = $('pkce-compare');
    var compareStatus = $('pkce-compare-status');
    var endpointEl = $('pkce-endpoint');
    var clientIdEl = $('pkce-client-id');
    var redirectEl = $('pkce-redirect');
    var scopeEl = $('pkce-scope');
    var stateEl = $('pkce-state');
    var nonceEl = $('pkce-nonce');
    var nonceField = $('pkce-nonce-field');
    var authUrlEl = $('pkce-authurl');
    var authStatus = $('pkce-auth-status');
    var tokenEndpointEl = $('pkce-token-endpoint');
    var codeEl = $('pkce-code');
    var curlEl = $('pkce-curl');
    var methodInputs = wrap.querySelectorAll('input[name="pkce-method"]');

    var fill = function (u8) { return crypto.getRandomValues(u8); };
    var method = 'S256';
    var generated = null;
    var generatedBits = 0;
    var seq = 0;

    function fmt(s, o) {
      return String(s).replace(/\{(\w+)\}/g, function (m, k) { return Object.prototype.hasOwnProperty.call(o, k) ? o[k] : m; });
    }

    function show(el, msg, kind) {
      el.textContent = msg || '';
      if (kind) el.className = 'tool-status ' + kind;
      el.hidden = !msg;
    }

    function verifierError(r) {
      if (r.code === 'empty') return S.errEmpty;
      if (r.code === 'short') return fmt(S.errShort, { len: r.len });
      if (r.code === 'long') return fmt(S.errLong, { len: r.len });
      var msg = fmt(S.errChar, { pos: r.pos, ch: r.hint === 'space' ? '␠' : r.ch });
      if (r.hint === 'base64') msg += ' ' + S.hintBase64;
      else if (r.hint === 'space') msg += ' ' + S.hintSpace;
      else if (r.hint === 'nonascii') msg += ' ' + S.hintNonascii;
      return msg;
    }

    function clearOutputs() {
      challengeEl.textContent = '—';
      authUrlEl.textContent = '—';
      curlEl.textContent = '—';
      show(methodStatus, '');
      show(compareStatus, '');
      show(authStatus, '');
    }

    function readLength() {
      var n = Number(lengthEl.value);
      return Number.isInteger(n) && n >= MIN_LEN && n <= MAX_LEN ? n : null;
    }

    async function recompute() {
      var my = ++seq;
      var r = validateVerifier(verifierEl.value);
      var meta = fmt(S.chars, { n: r.len });
      if (r.code === 'ok' && generated === r.value) meta += ' · ' + fmt(S.bits, { bits: generatedBits });
      metaEl.textContent = r.len ? meta : '';
      challengeLabel.textContent = fmt(S.challengeLabel, { method: method });
      nonceField.hidden = String(scopeEl.value).trim().split(/\s+/).indexOf('openid') === -1;

      if (r.code !== 'ok') {
        show(verifierStatus, verifierError(r), 'error');
        clearOutputs();
        return;
      }
      show(verifierStatus, '');

      var challenge;
      try {
        challenge = await computeChallenge(r.value, method);
      } catch (e) {
        if (my !== seq) return;
        clearOutputs();
        show(methodStatus, S.errSubtle, 'error');
        return;
      }
      if (my !== seq) return;

      challengeEl.textContent = challenge;
      show(methodStatus, method === 'plain' ? S.plainWarn : '', 'info');

      var auth = buildAuthUrl({
        endpoint: endpointEl.value, clientId: clientIdEl.value, redirectUri: redirectEl.value,
        scope: scopeEl.value, state: stateEl.value, nonce: nonceEl.value,
        challenge: challenge, method: method,
      });
      authUrlEl.textContent = auth.url || '—';
      show(authStatus, auth.error === 'fragment' ? S.errFragment : auth.error ? S.errEndpoint : '', 'error');

      curlEl.textContent = buildCurl({
        tokenEndpoint: tokenEndpointEl.value, code: codeEl.value, redirectUri: redirectEl.value,
        clientId: clientIdEl.value, verifier: r.value,
      });

      if (!compareEl.value.trim()) { show(compareStatus, ''); return; }
      var d = await diagnoseChallenge(r.value, compareEl.value, method);
      if (my !== seq) return;
      var key = { match: 'cmpMatch', padding: 'cmpPadding', base64: 'cmpBase64', hex: 'cmpHex', plain: 'cmpPlain', rawBytes: 'cmpRawBytes', s256: 'cmpS256', mismatch: 'cmpMismatch' }[d.code];
      show(compareStatus, key ? fmt(S[key], { expected: d.expected }) : '', d.code === 'match' ? 'success' : 'error');
    }

    function generate() {
      var len = readLength();
      if (len === null) {
        show(verifierStatus, S.errLength, 'error');
        return;
      }
      var v = generateVerifier(len, fill);
      generated = v;
      generatedBits = entropyBits(len);
      verifierEl.value = v;
      stateEl.value = randomToken(24, fill);
      nonceEl.value = randomToken(24, fill);
      recompute();
    }

    function attachCopy(btn, read) {
      btn.addEventListener('click', function () {
        var val = read();
        if (!val || val === '—' || !navigator.clipboard) return;
        navigator.clipboard.writeText(val).then(function () {
          btn.textContent = S.copied;
          btn.classList.add('copied');
          setTimeout(function () {
            btn.textContent = S.copy;
            btn.classList.remove('copied');
          }, 1500);
        }).catch(function () {});
      });
    }

    attachCopy($('pkce-copy-verifier'), function () { return verifierEl.value.trim(); });
    attachCopy($('pkce-copy-challenge'), function () { return challengeEl.textContent; });
    attachCopy($('pkce-copy-authurl'), function () { return authUrlEl.textContent; });
    attachCopy($('pkce-copy-curl'), function () { return curlEl.textContent; });

    generateBtn.addEventListener('click', function () {
      generate();
      if (window.trackTool) window.trackTool('pkce-generator', 'generate');
    });
    lengthEl.addEventListener('change', function () {
      if (readLength() === null) show(verifierStatus, S.errLength, 'error');
      else generate();
    });
    verifierEl.addEventListener('input', recompute);
    methodInputs.forEach(function (input) {
      input.addEventListener('change', function () {
        method = input.value;
        methodInputs.forEach(function (i) { i.parentElement.classList.toggle('pkce-method--active', i.checked); });
        recompute();
      });
    });
    [compareEl, endpointEl, clientIdEl, redirectEl, scopeEl, stateEl, nonceEl, tokenEndpointEl, codeEl].forEach(function (el) {
      el.addEventListener('input', recompute);
    });

    // The site-wide Ctrl/⌘+L shortcut empties text fields without input events.
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'l' || e.key === 'L') && wrap.contains(document.activeElement)) {
        setTimeout(function () { generated = null; recompute(); }, 0);
      }
    });

    generate();
  })();
</script>

