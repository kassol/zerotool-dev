---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

/* ── strings:start ── */
const STRINGS = {
  "en": {
    "imagesLabel": "Images",
    "modeLabel": "Conversion direction",
    "selectFiles": "Select image files",
    "tips": {
      "mode": "Choose PNG / JPG / GIF → WebP or WebP → PNG before selecting files. Changing direction does not change existing results; select the files again to use the new direction.",
