    },
    "clear": "Clear",
    "downloadAll": "Download All",
    "download": "Download",
    "converting": "Converting…",
    "qualityLabel": "Quality: ",
    "hintTo": "Supports PNG, JPG, GIF",
    "hintFrom": "Supports WebP",
    "dropText": "Drop images here, or ",
    "dropAction": "click to select",
    "errFormat": "Not a supported format (PNG/JPG/GIF)",
    "errNotWebp": "Not a WebP file",
    "errFailed": "Conversion failed (canvas.toBlob returned null)",
    "errEncoder": "This browser cannot encode {want} (it returned {got}). Try Chrome, Edge or Firefox.",
    "errLoad": "Failed to load image",
    "unknownType": "an unknown type",
    "statusOk": "{n} file(s) converted",
    "statusFail": ", {n} failed"
  },
  "zh": {
    "imagesLabel": "图片",
    "modeLabel": "转换方向",
    "selectFiles": "选择图片文件",
