const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---

<div class="hha-wrap">
  <div class="hha-actions">
    <span class="hha-control">
      <button id="hha-analyze" class="btn-primary" type="button">{T.analyze}</button>
      <Toggletip id="hha-tip-analyze" lang={lang} about={T.analyze}>{TIPS.analyze}</Toggletip>
    </span>
    <span class="hha-control">
      <select id="hha-example" class="hha-example-select" aria-label={T.exampleLabel}>
        <option value="">{T.exampleLabel}</option>
        <option value="response-secure">{T.exResponseSecure}</option>
        <option value="response-basic">{T.exResponseBasic}</option>
        <option value="request-auth">{T.exRequestAuth}</option>
        <option value="cors-preflight">{T.exCorsPreflight}</option>
      </select>
      <Toggletip id="hha-tip-example" lang={lang} about={T.exampleLabel}>{TIPS.example}</Toggletip>
    </span>
    <span class="hha-control">
      <button id="hha-clear" class="btn-ghost" type="button">{T.clear}</button>
      <Toggletip id="hha-tip-clear" lang={lang} about={T.clear}>{TIPS.clear}</Toggletip>
    </span>
    <span class="hha-control">
      <button id="hha-copy-json" class="btn-secondary" type="button">{T.copyJson}</button>
      <Toggletip id="hha-tip-copy" lang={lang} about={T.copyJson}>{TIPS.copy}</Toggletip>
    </span>
  </div>
  <div id="hha-status" class="tool-status" aria-live="polite"></div>
  <div class="hha-input-section">
    <div class="hha-label-row">
      <label for="hha-input" class="tool-label">{T.rawHeaders}</label>
      <Toggletip id="hha-tip-input" lang={lang} about={T.rawHeaders}>{TIPS.input}</Toggletip>
    </div>
    <textarea
      id="hha-input"
      class="tool-textarea"
      rows="8"
      spellcheck="false"
      placeholder={"HTTP/1.1 200 OK\nContent-Type: application/json\nStrict-Transport-Security: max-age=63072000; includeSubDomains\nCache-Control: no-store"}
    ></textarea>
  </div>
  <p class="hha-empty">{T.emptyResult}</p>
  <div id="hha-result" class="hha-result" hidden>
    <div class="hha-summary">
      <span class="hha-summary-pill" id="hha-summary-type"></span>
      <span class="hha-summary-pill" id="hha-summary-status"></span>
      <span class="hha-summary-pill" id="hha-summary-count"></span>
      <span class="hha-summary-pill" id="hha-summary-security"></span>
    </div>
    <div class="hha-view-row">
      <span class="hha-control">
        <span class="tool-label">{T.views}</span>
        <Toggletip id="hha-tip-views" lang={lang} about={T.views}>{TIPS.views}</Toggletip>
      </span>
      <div class="hha-tabs" role="tablist" aria-label={T.views}>
        <button class="hha-tab hha-tab-active" id="hha-tab-cat" role="tab">{T.tabCategorized}</button>
        <button class="hha-tab" id="hha-tab-raw" role="tab">{T.tabRaw}</button>
        <button class="hha-tab" id="hha-tab-json" role="tab">{T.tabJson}</button>
      </div>
    </div>
    <div id="hha-panel-cat" class="hha-panel" tabindex="0" aria-label={T.tabCategorized}></div>
    <div id="hha-panel-raw" class="hha-panel" tabindex="0" aria-label={T.tabRaw} hidden><pre id="hha-raw-output" class="hha-pre"></pre></div>
    <div id="hha-panel-json" class="hha-panel" tabindex="0" aria-label={T.tabJson} hidden><pre id="hha-json-output" class="hha-pre"></pre></div>
  </div>
  <p class="hha-privacy">{T.privacyNote}</p>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      // Header dictionary — 88 entries. category mapped to localized labels.
      var HEADER_DB = {
        // Security
        'strict-transport-security': { cat: 'security', desc: 'Forces HTTPS for the specified duration. Protects against protocol downgrade and cookie hijacking.' },
        'content-security-policy': { cat: 'security', desc: 'Whitelists allowed sources for scripts, styles, images. Primary XSS mitigation.' },
        'content-security-policy-report-only': { cat: 'security', desc: 'CSP in monitor mode — violations are reported but not blocked.' },
        'x-frame-options': { cat: 'security', desc: 'Controls whether the page can be framed. DENY/SAMEORIGIN prevents clickjacking. Superseded by CSP frame-ancestors.' },
        'x-content-type-options': { cat: 'security', desc: 'nosniff disables MIME-type sniffing. Stops browsers from interpreting files as a different type.' },
        'referrer-policy': { cat: 'security', desc: 'Controls how much referrer info is shared with cross-origin requests.' },
        'permissions-policy': { cat: 'security', desc: 'Restricts browser features (camera, geolocation, etc.) per origin. Replaces Feature-Policy.' },
        'feature-policy': { cat: 'security', desc: 'Deprecated. Use Permissions-Policy instead.' },
        'cross-origin-opener-policy': { cat: 'security', desc: 'Isolates the document\'s browsing context group. Required for SharedArrayBuffer.' },
        'cross-origin-embedder-policy': { cat: 'security', desc: 'Restricts subresources to those that grant permission. Pairs with COOP for cross-origin isolation.' },
        'cross-origin-resource-policy': { cat: 'security', desc: 'Limits which origins can load this resource. Mitigates Spectre-style attacks.' },
