        ':method': { type: 'request', desc: 'Request method, in place of the HTTP/1.1 request line (RFC 9113 §8.3.1).' },
        ':scheme': { type: 'request', desc: 'Scheme of the target URI, such as https (RFC 9113 §8.3.1).' },
        ':authority': { type: 'request', desc: 'Host and optional port of the target URI; replaces Host (RFC 9113 §8.3.1).' },
