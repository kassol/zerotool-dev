---
<div class="qrd-wrap" id="qrd-wrap">
  <div class="qrd-inputs" id="qrd-inputs">
    <div class="qrd-pick-row">
      <div id="qrd-dropzone" class="qrd-dropzone" tabindex="0" role="button" aria-label={T.dropAria}>
        <svg class="qrd-dz-icon" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>
        <p class="qrd-dz-hint qrd-dz-full">{T.dropHint}</p>
        <p class="qrd-dz-hint qrd-dz-compact">{T.dropHintCompact}</p>
        <p class="qrd-dz-sub">{T.dropSub}</p>
        <input type="file" id="qrd-file" accept="image/*" hidden />
      </div>
      <button type="button" id="qrd-camera" class="btn-secondary qrd-camera-btn" aria-label={T.camera}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
        <span>{T.camera}</span>
      </button>
    </div>

    <div id="qrd-url-row" class="qrd-url-row">
      <label class="qrd-url-label" for="qrd-url-input">{T.urlLabel}</label>
      <div class="qrd-url-input-group">
        <input type="url" id="qrd-url-input" class="tool-input qrd-url-input" placeholder={T.urlPlaceholder} autocomplete="off" spellcheck="false" />
        <button type="button" id="qrd-url-decode" class="btn-primary">{T.urlDecodeBtn}</button>
      </div>
    </div>
  </div>

  <div id="qrd-status" class="tool-status qrd-status" role="status" aria-live="polite"></div>

  <div id="qrd-camera-view" class="qrd-camera-view" hidden>
    <video id="qrd-video" class="qrd-video" playsinline muted></video>
    <p class="qrd-camera-hint">{T.cameraHint}</p>
    <button type="button" id="qrd-camera-stop" class="btn-secondary">{T.cameraStop}</button>
  </div>

  <div id="qrd-result-area" class="qrd-result-area" hidden>
    <div id="qrd-results" class="qrd-results"></div>
    <div class="qrd-preview-col">
      <canvas id="qrd-preview" class="qrd-preview" role="img" aria-label={T.previewAlt}></canvas>
      <button type="button" id="qrd-clear" class="btn-ghost btn-sm">{T.clear}</button>
    </div>
  </div>

  <p class="qrd-crosslink">
    <span>{T.crosslinkText}</span>
    <a href={generatorHref}>{T.crosslinkLink}</a>
  </p>

  <script is:inline define:vars={{ t: T, pageLang: lang }}>
    (function () {
