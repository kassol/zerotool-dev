    "convertedToCsv": "已将 {n} 行转换为 CSV。",
    "errorPrefix": "错误：",
    "parseTypes": "推断数字和布尔值",
    "emptyNull": "空字段 → null",
    "renamedHeaders": "表头有重名，已改名：{list}。",
    "addedKeys": "部分行的字段比表头多，已补上这些键：{cols}。",
    "errNeedRows": "CSV 至少需要一行表头和一行数据。",
    "errNotArray": "JSON 必须是对象数组。",
    "errEmptyArray": "JSON 数组为空。",
    "errItem": "第 {n} 项必须是对象。",
