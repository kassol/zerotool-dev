---
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

// strings:start
const STRINGS = {
  "en": {
    "copy": "Copy",
    "copied": "Copied!",
    "copyFailed": "Copy failed",
    "clear": "Clear",
    "convertedToJson": "Converted {n} row{s} to JSON.",
    "convertedToCsv": "Converted {n} row{s} to CSV.",
    "errorPrefix": "Error: ",
    "parseTypes": "Parse numbers & booleans",
    "emptyNull": "Empty → null",
    "renamedHeaders": "Duplicate header names were renamed: {list}.",
    "addedKeys": "Some rows have more fields than the header, so these keys were added: {cols}.",
    "errNeedRows": "CSV must have at least a header row and one data row.",
    "errNotArray": "JSON must be an array of objects.",
    "errEmptyArray": "JSON array is empty.",
    "errItem": "Item {n} must be a plain object.",
    "errUnclosed": "A quoted field that starts on line {line} is never closed. Add the closing \" or remove the opening one.",
    "numbersAsText": "This browser cannot keep these numbers exactly, so they were written as text: {list}.",
    "tips": {
      "csv": "Paste comma-separated CSV with a header and at least one data row. After 0.3 seconds without typing, JSON updates. Quoted commas, line breaks and doubled quotes are supported.",
      "json": "Paste a non-empty array of JSON objects. After 0.3 seconds without typing, CSV updates. Nested objects become dot-path columns; arrays and empty objects are written as JSON text.",
