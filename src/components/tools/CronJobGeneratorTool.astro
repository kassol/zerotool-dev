const EXTRA_STRINGS = {
  "en": {
    "options": "Edit fields",
    "empty": "Enter a valid expression to see its description and scheduled runs."
  },
  "zh": {
    "options": "编辑字段",
    "empty": "输入合法表达式，查看说明和执行时间。"
  },
  "ja": {
    "options": "フィールドを編集",
    "empty": "有効な式を入力すると、説明と実行日時が表示されます。"
  },
  "ko": {
    "options": "필드 편집",
    "empty": "유효한 표현식을 입력하면 설명과 실행 시간이 표시됩니다."
  }
};
const STRINGS = Object.fromEntries(Object.keys(labels).map(code => [code, {
  ...labels[code], ...CLIENT_STRINGS[code], ...EXTRA_STRINGS[code], tips: TIP_STRINGS[code],
}]));
// strings:end
const L = STRINGS[lang] ?? STRINGS.en;
const CLIENT_T = Object.fromEntries(['copy', 'copied', 'copyFailed', 'nextLabelUtc', 'nextLabelLocal', 'exprErrorLen', 'exprErrorVal', 'exprErrorField', 'fieldMinute', 'fieldHour', 'fieldDay', 'fieldMonth', 'fieldWeekday'].map(key => [key, L[key]]));
const chipHtml = (count, offset, names = []) => Array.from({ length: count }, (_, i) => `<button type="button" class="cjg-chip${i === 0 ? ' active' : ''}" data-val="${i + offset}" aria-pressed="${i === 0}">${names.length ? names[i] : i + offset}</button>`).join('');
const CHIP_HTML = { hour: chipHtml(24, 0), day: chipHtml(31, 1), month: chipHtml(12, 1, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec'.split(',')), weekday: chipHtml(7, 0, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat'.split(',')) };
---
<div class="cjg-wrap">
  <div class="cjg-main">
    <div class="cjg-rail zt-rail">
      <div class="cjg-output-row">
        <div class="cjg-label-row"><label class="cjg-output-label" for="cjg-expr">{L.outputLabel}</label><Toggletip id="cjg-tip-expression" about={L.outputLabel} lang={lang}>{L.tips.expression}</Toggletip></div>
        <div class="cjg-expr-wrap">
          <input id="cjg-expr" type="text" class="cjg-expr-input" spellcheck="false" autocomplete="off" value="* * * * *" />
          <button id="cjg-copy" type="button" class="cjg-btn-copy" data-copy={L.copy} data-copied={L.copied}>{L.copy}</button>
          <Toggletip id="cjg-tip-copy" about={L.copy} lang={lang}>{L.tips.copy}</Toggletip>
        </div>
      </div>
      <div class="cjg-tz-row">
        <div class="cjg-tz-toggle zt-segmented" role="group" aria-label={L.nextLabelUtc}>
          <button type="button" class="cjg-tz-btn active" data-tz="utc">{L.tzUtc}</button>
          <button type="button" class="cjg-tz-btn" data-tz="local">{L.tzLocal}</button>
        </div>
        <Toggletip id="cjg-tip-timezone" about={L.tzLocal} lang={lang}>{L.tips.timezone}</Toggletip>
      </div>
      <div class="cjg-status" role="status" aria-live="polite"><div id="cjg-error" class="cjg-error-msg hidden"></div></div>
      <details class="cjg-options">
        <summary><span>{L.presets}</span><Toggletip id="cjg-tip-presets" about={L.presets} lang={lang}>{L.tips.presets}</Toggletip></summary>
        <div class="cjg-presets">
    <button class="cjg-btn-preset" data-expr="* * * * *">{L.pEveryMinute}</button>
    <button class="cjg-btn-preset" data-expr="0 * * * *">{L.pEveryHour}</button>
    <button class="cjg-btn-preset" data-expr="0 0 * * *">{L.pDailyMidnight}</button>
    <button class="cjg-btn-preset" data-expr="0 9 * * 1-5">{L.pWeekdays9am}</button>
    <button class="cjg-btn-preset" data-expr="0 0 * * 0">{L.pWeeklySunday}</button>
    <button class="cjg-btn-preset" data-expr="0 0 1 * *">{L.pMonthly1st}</button>
    <button class="cjg-btn-preset" data-expr="*/5 * * * *">{L.pEvery5min}</button>
    <button class="cjg-btn-preset" data-expr="0 0 1 1 *">{L.pYearlyJan1}</button>
  </div>

      </details>
      <details class="cjg-options">
        <summary>{L.options}</summary>
        <div class="cjg-fields">

    {/* Minute */}
    <div class="cjg-field" data-field="minute" data-min="0" data-max="59">
      <div class="cjg-field-header">
        <span class="cjg-field-label">
          <span>{L.fieldMinute}</span>
          <span class="cjg-field-range">{L.fieldMinuteRange}</span>
            <Toggletip id="cjg-tip-minute" about={L.fieldMinute} lang={lang}>{L.tips.minute}</Toggletip>
        </span>
        <div class="cjg-modes" role="group">
          <button class="cjg-mode-btn active" data-mode="every">{L.modeEvery}</button>
          <button class="cjg-mode-btn" data-mode="step">{L.modeStep}</button>
          <button class="cjg-mode-btn" data-mode="range">{L.modeRange}</button>
          <button class="cjg-mode-btn" data-mode="specific">{L.modeSpecific}</button>
        </div>
      </div>
      <div class="cjg-field-body">
        <div class="cjg-mode-panel" data-panel="every"><span class="cjg-expr-badge">*</span></div>
        <div class="cjg-mode-panel hidden" data-panel="step">
          <label class="cjg-inline-label" for="cjg-minute-step">{L.stepLabel}</label>
          <input type="number" id="cjg-minute-step" class="cjg-num" data-role="step" min="1" max="59" value="5" />
          <span class="cjg-expr-badge cjg-preview">*/5</span>
        </div>
        <div class="cjg-mode-panel hidden" data-panel="range">
          <label class="cjg-inline-label" for="cjg-minute-from">{L.rangeFrom}</label>
          <input type="number" id="cjg-minute-from" class="cjg-num" data-role="from" min="0" max="59" value="0" />
          <label class="cjg-inline-label" for="cjg-minute-to">{L.rangeTo}</label>
          <input type="number" id="cjg-minute-to" class="cjg-num" data-role="to" min="0" max="59" value="30" />
          <span class="cjg-expr-badge cjg-preview">0-30</span>
        </div>
        <div class="cjg-mode-panel hidden" data-panel="specific">
          <input type="text" class="cjg-text" data-role="values" placeholder="0,15,30,45" value="0,15,30,45" />
          <span class="cjg-expr-badge cjg-preview">0,15,30,45</span>
        </div>
      </div>
    </div>

    {/* Hour */}
    <div class="cjg-field" data-field="hour" data-min="0" data-max="23">
      <div class="cjg-field-header">
        <span class="cjg-field-label">
          <span>{L.fieldHour}</span>
          <span class="cjg-field-range">{L.fieldHourRange}</span>
            <Toggletip id="cjg-tip-hour" about={L.fieldHour} lang={lang}>{L.tips.hour}</Toggletip>
        </span>
        <div class="cjg-modes" role="group">
          <button class="cjg-mode-btn active" data-mode="every">{L.modeEvery}</button>
          <button class="cjg-mode-btn" data-mode="step">{L.modeStep}</button>
