        <div class="cjg-mode-panel hidden" data-panel="step">
          <label class="cjg-inline-label" for="cjg-weekday-step">{L.stepLabel}</label>
          <input type="number" id="cjg-weekday-step" class="cjg-num" data-role="step" min="1" max="6" value="2" />
          <span class="cjg-expr-badge cjg-preview">*/2</span>
