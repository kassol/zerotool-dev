          <label class="cjg-inline-label" for="cjg-weekday-from">{L.rangeFrom}</label>
          <input type="number" id="cjg-weekday-from" class="cjg-num" data-role="from" min="0" max="6" value="1" />
          <label class="cjg-inline-label" for="cjg-weekday-to">{L.rangeTo}</label>
          <input type="number" id="cjg-weekday-to" class="cjg-num" data-role="to" min="0" max="6" value="5" />
