    ja: { exprErrorField: '{field}：「{value}」は無効です。{min}〜{max} の数字と *、-、/、カンマを使ってください。', presets: 'プリセット：', fieldMinute: '分', fieldHour: '時', fieldDay: '日', fieldMonth: '月', fieldWeekday: '曜日', modeEvery: '毎', modeStep: 'N ごと', modeRange: '範囲', modeSpecific: '指定', stepLabel: 'ステップ：', rangeFrom: '開始', rangeTo: '終了', outputLabel: 'Cron 式', copy: 'コピー', copied: 'コピー済み！', descLabel: '説明', nextLabelUtc: '次の 10 回の実行時刻（UTC）', nextLabelLocal: '次の 10 回の実行時刻（{tz}）', tzUtc: 'UTC', tzLocal: 'ローカル', pEveryMinute: '毎分', pEveryHour: '毎時', pDailyMidnight: '毎日 0 時', pWeekdays9am: '平日 9 時', pWeeklySunday: '毎週日曜', pMonthly1st: '毎月 1 日', pEvery5min: '5 分ごと', pYearlyJan1: '毎年 1 月 1 日', exprErrorLen: '5つのフィールドが必要です：分 時 日 月 曜日', exprErrorVal: 'Cron 式が無効です', copyFailed: 'コピーに失敗しました' },
    ko: { exprErrorField: '{field}: "{value}"은(는) 올바르지 않습니다. {min}~{max} 숫자와 *, -, /, 쉼표를 쓰세요.', presets: '프리셋:', fieldMinute: '분', fieldHour: '시', fieldDay: '일', fieldMonth: '월', fieldWeekday: '요일', modeEvery: '매', modeStep: 'N마다', modeRange: '범위', modeSpecific: '지정', stepLabel: '단계:', rangeFrom: '시작', rangeTo: '끝', outputLabel: 'Cron 표현식', copy: '복사', copied: '복사됨!', descLabel: '설명', nextLabelUtc: '다음 10번 실행 시간 (UTC)', nextLabelLocal: '다음 10번 실행 시간 ({tz})', tzUtc: 'UTC', tzLocal: '현지', pEveryMinute: '매분', pEveryHour: '매시', pDailyMidnight: '매일 자정', pWeekdays9am: '평일 오전 9시', pWeeklySunday: '매주 일요일', pMonthly1st: '매월 1일', pEvery5min: '5분마다', pYearlyJan1: '매년 1월 1일', exprErrorLen: '5개의 필드가 필요합니다: 분 시 일 월 요일', exprErrorVal: 'Cron 표현식이 올바르지 않습니다', copyFailed: '복사 실패' }
