          <div class="cjg-chips" data-count="7" data-offset="0" data-names="Sun,Mon,Tue,Wed,Thu,Fri,Sat" set:html={CHIP_HTML.weekday}></div>
          <span class="cjg-expr-badge cjg-preview">1</span>
        </div>
      </div>
    </div>

  </div>{/* /.cjg-fields */}
      </details>
    </div>
    <div id="cjg-result" class="cjg-output" data-empty="true">
      <p id="cjg-empty" class="cjg-empty">{L.empty}</p>
      <div id="cjg-result-content" class="cjg-result-content" hidden>
        <div class="cjg-desc-row"><span class="cjg-desc-label">{L.descLabel}</span><span id="cjg-desc" class="cjg-desc-text"></span></div>
        <div class="cjg-next-section"><span id="cjg-next-label" class="cjg-next-label">{L.nextLabelUtc}</span><ol id="cjg-next-list" class="cjg-next-list"></ol></div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ CLIENT_T }}>
(function () {
  var t = CLIENT_T;

  // Timezone state — default UTC
  var useUtc = true;
  var localTzName = Intl.DateTimeFormat().resolvedOptions().timeZone;
  if (window.ztPersist) {
    var _tzPref = (window.ztPersist.load('cron-job-generator') || {}).tz;
    if (_tzPref === 'local') useUtc = false;
  }

  // Associate each field's step/from/to input with its preceding inline label (accessible name)
  document.querySelectorAll('.cjg-field').forEach(function (field) {
    field.querySelectorAll('.cjg-mode-panel input.cjg-num').forEach(function (input) {
      var label = input.previousElementSibling;
      if (!label || !label.classList.contains('cjg-inline-label')) return;
      var id = 'cjg-' + field.getAttribute('data-field') + '-' + input.getAttribute('data-role');
      input.id = id;
      label.setAttribute('for', id);
    });
  });

  var copyBtn = document.getElementById('cjg-copy');
  if (copyBtn) {
    copyBtn.textContent = t.copy;
    copyBtn.setAttribute('data-copy', t.copy);
    copyBtn.setAttribute('data-copied', t.copied);
  }

  var copyVersion = 0;
  var copyTimeout;
  function resetCopy() {
    copyVersion++;
    clearTimeout(copyTimeout);
    copyBtn.textContent = t.copy;
  }


  function refreshResult(scroll) {
    var ready = !!document.getElementById('cjg-desc').textContent;
    var result = document.getElementById('cjg-result');
    result.setAttribute('data-empty', ready ? 'false' : 'true');
    document.getElementById('cjg-empty').hidden = ready;
    document.getElementById('cjg-result-content').hidden = !ready;
    if (ready && scroll && typeof window.matchMedia === 'function' && window.matchMedia('(max-width: 860px)').matches) {
      requestAnimationFrame(function () { if (result.getAttribute('data-empty') === 'false') result.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); });
    }
  }

  // Chip toggle
  document.querySelectorAll('.cjg-chips').forEach(function (container) {
    container.addEventListener('click', function (e) {
      var chip = e.target.closest('.cjg-chip');
      if (!chip) return;
      var pressed = chip.getAttribute('aria-pressed') === 'true';
      // Prevent deselecting the last chip
      var activeChips = container.querySelectorAll('.cjg-chip.active');
      if (pressed && activeChips.length <= 1) return;
      chip.setAttribute('aria-pressed', pressed ? 'false' : 'true');
      chip.classList.toggle('active', !pressed);
      updateFieldPreview(container.closest('.cjg-field'));
      rebuildExpression();
      trackUpdate();
    });
  });

  // Mode switching
  document.querySelectorAll('.cjg-field').forEach(function (field) {
    field.querySelectorAll('.cjg-mode-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var mode = btn.getAttribute('data-mode');
        field.querySelectorAll('.cjg-mode-btn').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        field.querySelectorAll('.cjg-mode-panel').forEach(function (panel) {
          panel.classList.toggle('hidden', panel.getAttribute('data-panel') !== mode);
        });
        updateFieldPreview(field);
        rebuildExpression();
        trackUpdate();
      });
    });
  });

  // Input change → preview + expression
  document.querySelectorAll('.cjg-field .cjg-num, .cjg-field .cjg-text').forEach(function (input) {
    input.addEventListener('input', function () {
      updateFieldPreview(input.closest('.cjg-field'));
      rebuildExpression();
    });
    input.addEventListener('change', trackUpdate);
  });

  function getActiveMode(field) {
    var btn = field.querySelector('.cjg-mode-btn.active');
    return btn ? btn.getAttribute('data-mode') : 'every';
  }

  function getFieldExpr(field) {
    var mode = getActiveMode(field);
    var min = parseInt(field.getAttribute('data-min') || '0');
    var max = parseInt(field.getAttribute('data-max') || '59');

    if (mode === 'every') return '*';

    if (mode === 'step') {
      var stepInput = field.querySelector('[data-role="step"]');
      var step = stepInput ? parseInt(stepInput.value) : 1;
      if (isNaN(step) || step < 1) step = 1;
      if (step > max) step = max;
      return '*/' + step;
    }

    if (mode === 'range') {
      var fromInput = field.querySelector('[data-role="from"]');
      var toInput = field.querySelector('[data-role="to"]');
      var from = fromInput ? parseInt(fromInput.value) : min;
      var to = toInput ? parseInt(toInput.value) : max;
      if (isNaN(from) || from < min) from = min;
      if (isNaN(to) || to > max) to = max;
      if (from > to) { var tmp = from; from = to; to = tmp; }
      if (from === min && to === max) return '*';
      return from + '-' + to;
    }

    if (mode === 'specific') {
      var chips = field.querySelectorAll('.cjg-chip.active');
      if (chips.length > 0) {
        var vals = [];
        chips.forEach(function (c) { vals.push(parseInt(c.getAttribute('data-val'))); });
        vals.sort(function (a, b) { return a - b; });
        // If all selected
        var total = field.querySelectorAll('.cjg-chip').length;
        if (chips.length === total) return '*';
        return vals.join(',');
      }
      var textInput = field.querySelector('[data-role="values"]');
      if (textInput) {
        var raw = textInput.value.trim();
        if (!raw) return '*';
        return raw;
      }
      return '*';
    }

    return '*';
  }

  function updateFieldPreview(field) {
    if (!field) return;
    var mode = getActiveMode(field);
    var expr = getFieldExpr(field);
    var preview = field.querySelector('.cjg-mode-panel:not(.hidden) .cjg-preview');
    if (preview) preview.textContent = expr;

    // Sync chip preview for specific mode
    if (mode === 'specific') {
      var chipsPreview = field.querySelector('[data-panel="specific"] .cjg-preview');
      if (chipsPreview) chipsPreview.textContent = expr;
    }
  }

  function rebuildExpression() {
    var fields = ['minute', 'hour', 'day', 'month', 'weekday'];
    var parts = [];
    fields.forEach(function (name) {
      var field = document.querySelector('.cjg-field[data-field="' + name + '"]');
      parts.push(field ? getFieldExpr(field) : '*');
    });
    var expr = parts.join(' ');
    var exprInput = document.getElementById('cjg-expr');
    if (exprInput && !isUserEditing) exprInput.value = expr;
    resetCopy();
    copyBtn.disabled = !exprInput || !exprInput.value.trim();
    // The Minute box is free text: check what it produced before describing it
    var checked = checkExpression(expr);
    if (checked.error) { showExprError(fieldErrorText(checked)); return; }
    if (!isUserEditing) clearExprError();
    updateDescription(parts);
    updateNextRuns(parts);
    refreshResult(true);
    saveState(expr);
  }

  // One analytics event per committed change (click, or change event of a text or number box),
  // and only when the expression is valid. Load and input events send nothing.
  function trackUpdate() {
    var exprInput = document.getElementById('cjg-expr');
    if (exprInput && !checkExpression(exprInput.value).error) window.trackTool && window.trackTool('cron_job_generator', 'update');
  }

  /* ── engine:start ── */
  // ---------- Description / Humanizer ----------
  var MONTHS_EN = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  var WDAYS_EN = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  var MONTH_ABBR = ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'];
  var WDAY_ABBR = ['sun','mon','tue','wed','thu','fri','sat'];

  function replaceNames(s, names, offset) {
    return s.toLowerCase().replace(new RegExp(names.join('|'), 'g'), function (m) {
      return names.indexOf(m) + offset;
    });
  }

  // Whole decimal numbers only: parseInt would read 1.5, 5abc and the Quartz form 1#2 as 1 or 5
  function toInt(s) {
    return /^\d+$/.test(s) ? Number(s) : NaN;
  }

  function parseField(field, min, max, names, nameOffset) {
    if (names) field = replaceNames(field, names, nameOffset);
    var result = [];
    var parts = field.split(',');
    for (var p = 0; p < parts.length; p++) {
      var part = parts[p].trim();
      var step = 1;
      if (part.indexOf('/') !== -1) {
        var sp = part.split('/');
        if (sp.length !== 2) return null;
        step = toInt(sp[1]);
        if (isNaN(step) || step < 1) return null;
        part = sp[0];
        // cronie get_range: a step needs * or a range before it (5/10 is an error)
        if (part !== '*' && part.indexOf('-') === -1) return null;
      }
      var lo, hi;
      if (part === '*') { lo = min; hi = max; }
      else if (part.indexOf('-') !== -1) {
        var rp = part.split('-');
        if (rp.length !== 2) return null;
        lo = toInt(rp[0]); hi = toInt(rp[1]);
        if (isNaN(lo) || isNaN(hi)) return null;
      } else {
        var v = toInt(part);
        if (isNaN(v)) return null;
        lo = hi = v;
      }
      if (lo < min || hi > max || lo > hi) return null;
      for (var i = lo; i <= hi; i += step) result.push(i);
    }
    var seen = {};
    return result.filter(function (v) { return seen[v] ? false : (seen[v] = true); }).sort(function (a, b) { return a - b; });
  }

  // names: abbreviations accepted in the field; labels: the words shown in the description
  function humanizeField(expr, min, max, names, nameOffset, singular, plural, labels) {
    if (expr === '*') return 'every ' + singular;
    var vals = parseField(expr, min, max, names, nameOffset);
    if (!vals) return expr;
    var shown = labels || names;
    if (expr.indexOf('*/') === 0) {
      var step = parseInt(expr.slice(2));
      return 'every ' + step + ' ' + (step === 1 ? singular : plural);
    }
    if (/^\d+-\d+$/.test(expr)) {
      var rp2 = expr.split('-');
      var lo2 = parseInt(rp2[0]), hi2 = parseInt(rp2[1]);
      var loName = shown ? (shown[lo2 - nameOffset] || lo2) : lo2;
      var hiName = shown ? (shown[hi2 - nameOffset] || hi2) : hi2;
      return loName + ' through ' + hiName;
    }
    return vals.map(function (v) { return shown ? (shown[v - nameOffset] || v) : v; }).join(', ');
  }

  function humanizeCron(fields) {
    var min = fields[0], hr = fields[1], dom = fields[2], mon = fields[3], dow = fields[4];
    var minH = humanizeField(min, 0, 59, null, 0, 'minute', 'minutes');
    var hrH = humanizeField(hr, 0, 23, null, 0, 'hour', 'hours');
    var domH = humanizeField(dom, 1, 31, null, 0, 'day', 'days');
    var monH = humanizeField(mon, 1, 12, MONTH_ABBR, 1, 'month', 'months', MONTHS_EN);
    var dowH = humanizeField(dow, 0, 7, WDAY_ABBR, 0, 'day of week', 'days of week', WDAYS_EN.concat('Sunday'));

    var when = '';
    if (min === '0' && hr === '0') when = 'At midnight';
    else if (min === '0') when = 'At ' + hrH + (hr.indexOf('*') === -1 ? ':00' : '');
    else if (hr === '*') when = 'At ' + minH + ' past every hour';
    else when = 'At ' + minH + ' past ' + hrH;

    if (dom !== '*' && dow !== '*') {
      // cronie: a field that starts with * does not restrict, so the other one alone decides
      when += (dom.charAt(0) !== '*' && dow.charAt(0) !== '*')
        ? ', on day ' + domH + ' of the month or on ' + dowH
        : ', on day ' + domH + ' of the month and on ' + dowH;
    }
    else if (dom !== '*') when += ', on day ' + domH + ' of the month';
    else if (dow !== '*') when += ', on ' + dowH;
    if (mon !== '*') when += ', in ' + monH;
    return when;
  }

  function updateDescription(fields) {
    var desc = document.getElementById('cjg-desc');
    if (!desc) return;
    try {
      var human = humanizeCron(fields);
      desc.textContent = human;
    } catch (e) {
      desc.textContent = '';
    }
  }

  // ---------- Next Runs ----------
  // Returns the first value in sorted arr strictly greater than val,
  // or null if none (caller must wrap to the next cycle).
  function nextAbove(arr, val) {
    for (var i = 0; i < arr.length; i++) {
      if (arr[i] > val) return arr[i];
    }
    return null;
  }

  // Runs are computed in UTC or in the browser's time zone, the same zone the list is shown in
  function nextRuns(fields, count, utc, from) {
    var minVals = parseField(fields[0], 0, 59, null, 0);
    var hrVals = parseField(fields[1], 0, 23, null, 0);
    var domVals = parseField(fields[2], 1, 31, null, 0);
    var monVals = parseField(fields[3], 1, 12, MONTH_ABBR, 1);
    var dowVals = parseField(fields[4], 0, 7, WDAY_ABBR, 0);
    if (dowVals) dowVals = dowVals.map(function (v) { return v === 7 ? 0 : v; });
    var dowSet = dowVals ? {} : null;
    if (dowVals) dowVals.forEach(function (v) { dowSet[v] = true; });
    if (!minVals || !hrVals || !domVals || !monVals) return null;
    // cronie (DOM_STAR / DOW_STAR): when neither day field starts with *, a day matches if
    // either field matches; otherwise both must match.
    var posixOr = fields[2].charAt(0) !== '*' && fields[4].charAt(0) !== '*' && dowSet !== null;
    function mk(y, m, day, h, mi) {
      return utc ? new Date(Date.UTC(y, m, day, h, mi, 0)) : new Date(y, m, day, h, mi, 0);
    }
    var runs = [];
    var d = new Date(from === undefined ? Date.now() : from);
    d.setSeconds(0, 0);
    d = new Date(d.getTime() + 60000);
    var limit = 100000;
    while (runs.length < count && limit-- > 0) {
      var yr = utc ? d.getUTCFullYear() : d.getFullYear();
      var mo = utc ? d.getUTCMonth() : d.getMonth();
      var mon = mo + 1;
      var dom = utc ? d.getUTCDate() : d.getDate();
      var dow = utc ? d.getUTCDay() : d.getDay();
      var hr = utc ? d.getUTCHours() : d.getHours();
      var min = utc ? d.getUTCMinutes() : d.getMinutes();
      if (monVals.indexOf(mon) === -1) {
        var nm = nextAbove(monVals, mon);
        d = nm !== null
          ? mk(yr, nm - 1, 1, 0, 0)
          : mk(yr + 1, monVals[0] - 1, 1, 0, 0);
        continue;
      }
      var domOk = domVals.indexOf(dom) !== -1;
      var dowOk = !dowSet || dowSet[dow];
      var dayOk = posixOr ? (domOk || dowOk) : (domOk && dowOk);
      if (!dayOk) {
        var nd = (!posixOr && fields[2] !== '*') ? nextAbove(domVals, dom) : null;
        d = nd !== null
          ? mk(yr, mo, nd, 0, 0)
          : mk(yr, mo, dom + 1, 0, 0);
        continue;
      }
      if (hrVals.indexOf(hr) === -1) {
        var nh = nextAbove(hrVals, hr);
        d = nh !== null
          ? mk(yr, mo, dom, nh, 0)
          : mk(yr, mo, dom + 1, 0, 0);
        continue;
      }
      if (minVals.indexOf(min) === -1) {
        var nmin = nextAbove(minVals, min);
        d = nmin !== null
          ? mk(yr, mo, dom, hr, nmin)
          : mk(yr, mo, dom, hr + 1, 0);
        continue;
      }
      runs.push(new Date(d));
      d = new Date(d.getTime() + 60000);
    }
    return runs;
  }

  // cronie crontab(5): day of week 0–7, where 0 and 7 are both Sunday
  var FIELD_BOUNDS = [[0,59],[0,23],[1,31],[1,12],[0,7]];
  var FIELD_NAMES = [null, null, null, MONTH_ABBR, WDAY_ABBR];
  var FIELD_OFFSETS = [0, 0, 0, 1, 0];

  // Returns the five fields, or the first problem: { error: 'len' } or { error: 'val', field, value }
  function checkExpression(text) {
    var parts = String(text).trim().split(/\s+/);
    if (parts.length !== 5) return { error: 'len' };
    for (var i = 0; i < 5; i++) {
      if (!parseField(parts[i], FIELD_BOUNDS[i][0], FIELD_BOUNDS[i][1], FIELD_NAMES[i], FIELD_OFFSETS[i])) {
        return { error: 'val', field: i, value: parts[i] };
      }
    }
    return { parts: parts };
  }
  /* ── engine:end ── */

  function updateNextRuns(fields) {
    var list = document.getElementById('cjg-next-list');
    if (!list) return;
    var runs = nextRuns(fields, 10, useUtc);
    if (!runs || !runs.length) { list.innerHTML = ''; return; }
    var html = '';
    runs.forEach(function (d) {
      var str = useUtc
        ? d.toISOString().slice(0, 16).replace('T', ' ') + ' UTC'
        : d.toLocaleString() + ' (' + localTzName + ')';
      html += '<li>' + str + '</li>';
    });
    list.innerHTML = html;
  }

  function updateNextLabel() {
    var el = document.getElementById('cjg-next-label');
    if (!el) return;
    el.textContent = useUtc
      ? t.nextLabelUtc
      : t.nextLabelLocal.replace('{tz}', localTzName);
  }

  // ---------- Preset loading ----------
  function loadPreset(expr) {
    var parts = expr.trim().split(/\s+/);
    if (parts.length !== 5) return;
    var fieldNames = ['minute', 'hour', 'day', 'month', 'weekday'];
    var fieldMins = [0, 0, 1, 1, 0];
    var fieldMaxs = [59, 23, 31, 12, 7];
    var fieldNames2 = [null, null, null, MONTH_ABBR, WDAY_ABBR];
    var fieldOffsets = [0, 0, 0, 1, 0];

    for (var i = 0; i < 5; i++) {
      var field = document.querySelector('.cjg-field[data-field="' + fieldNames[i] + '"]');
      if (!field) continue;
      var part = parts[i];
      var mode;

      if (part === '*') {
        mode = 'every';
      } else if (/^\*\/\d+$/.test(part)) {
        mode = 'step';
        var step = parseInt(part.slice(2));
        var stepInput = field.querySelector('[data-role="step"]');
        if (stepInput) stepInput.value = step;
      } else if (/^\d+-\d+$/.test(part) && !(i === 4 && /(^|-)7$/.test(part))) {
        // a weekday range ending in 7 (Sunday) is shown as chips; the range inputs stop at 6
        mode = 'range';
        var rp = part.split('-');
        var fromInput = field.querySelector('[data-role="from"]');
        var toInput = field.querySelector('[data-role="to"]');
        if (fromInput) fromInput.value = rp[0];
        if (toInput) toInput.value = rp[1];
      } else {
        mode = 'specific';
        // Parse values and set chips/text
        var chips = field.querySelectorAll('.cjg-chip');
        if (chips.length > 0) {
          // Deselect all
          chips.forEach(function (c) { c.classList.remove('active'); c.setAttribute('aria-pressed', 'false'); });
          // Parse and select matching
          var vals = parseField(part, fieldMins[i], fieldMaxs[i], fieldNames2[i], fieldOffsets[i]);
          if (vals && i === 4) vals = vals.map(function (v) { return v === 7 ? 0 : v; });
          if (vals) {
            vals.forEach(function (v) {
              var chip = field.querySelector('.cjg-chip[data-val="' + v + '"]');
              if (chip) { chip.classList.add('active'); chip.setAttribute('aria-pressed', 'true'); }
            });
          }
          // Ensure at least one selected
          var anyActive = field.querySelector('.cjg-chip.active');
          if (!anyActive && chips.length > 0) {
            chips[0].classList.add('active'); chips[0].setAttribute('aria-pressed', 'true');
          }
        } else {
          var textInput = field.querySelector('[data-role="values"]');
          if (textInput) textInput.value = part;
        }
      }

      // Switch to mode
      field.querySelectorAll('.cjg-mode-btn').forEach(function (b) { b.classList.remove('active'); });
      var modeBtn = field.querySelector('.cjg-mode-btn[data-mode="' + mode + '"]');
      if (modeBtn) modeBtn.classList.add('active');
      field.querySelectorAll('.cjg-mode-panel').forEach(function (panel) {
        panel.classList.toggle('hidden', panel.getAttribute('data-panel') !== mode);
      });
      updateFieldPreview(field);
    }
    rebuildExpression();
  }

  // Preset buttons
  document.querySelectorAll('.cjg-btn-preset').forEach(function (btn) {
    btn.addEventListener('click', function () {
      loadPreset(btn.getAttribute('data-expr'));
      trackUpdate();
    });
  });

  // Bidirectional parsing: user edits #cjg-expr → sync Advanced fields
  var isUserEditing = false;

  function saveState(expr) {
    if (!window.ztPersist) return;
    var prev = window.ztPersist.load('cron-job-generator') || {};
    prev.expression = expr;
    window.ztPersist.save('cron-job-generator', prev);
  }

  function loadState() {
    if (!window.ztPersist) return null;
    var data = window.ztPersist.load('cron-job-generator') || {};
    if (typeof data.expression === 'string' && data.expression.trim().split(/\s+/).length === 5) {
      return data.expression.trim();
    }
    return null;
  }

  function showExprError(msg) {
    var inp = document.getElementById('cjg-expr');
    var err = document.getElementById('cjg-error');
    if (inp) inp.classList.add('cjg-expr-error');
    if (err) { err.textContent = msg; err.classList.remove('hidden'); }
    var list = document.getElementById('cjg-next-list');
    if (list) list.innerHTML = '';
    var desc = document.getElementById('cjg-desc');
    if (desc) desc.textContent = '';
    refreshResult();
  }

  function fieldErrorText(checked) {
    var label = [t.fieldMinute, t.fieldHour, t.fieldDay, t.fieldMonth, t.fieldWeekday][checked.field];
    var b = FIELD_BOUNDS[checked.field];
    return t.exprErrorField.replace('{field}', label).replace('{value}', checked.value).replace('{min}', b[0]).replace('{max}', b[1]);
  }

  function clearExprError() {
    var inp = document.getElementById('cjg-expr');
    var err = document.getElementById('cjg-error');
    if (inp) inp.classList.remove('cjg-expr-error');
    if (err) { err.textContent = ''; err.classList.add('hidden'); }
  }

  document.getElementById('cjg-expr').addEventListener('input', function () {
    resetCopy();
    copyBtn.disabled = !this.value.trim();
    var val = this.value.trim();
    var checked = checkExpression(val);
    if (checked.error === 'len') {
      showExprError(t.exprErrorLen || 'Expected 5 fields: minute hour day month weekday');
      return;
    }
    if (checked.error) {
      showExprError(fieldErrorText(checked));
      return;
    }
    val = checked.parts.join(' ');
    clearExprError();
    isUserEditing = true;
    loadPreset(val);
    isUserEditing = false;
    saveState(val);
  });
  document.getElementById('cjg-expr').addEventListener('change', trackUpdate);

  // Copy
  copyBtn.addEventListener('click', function () {
    var input = document.getElementById('cjg-expr');
    var val = input.value;
    if (!val.trim() || copyBtn.disabled) return;
    resetCopy();
    var request = copyVersion;
    function current() { return request === copyVersion && input.value === val; }
    function failed() { if (current()) copyBtn.textContent = t.copyFailed; }
    try {
      if (!navigator.clipboard || !navigator.clipboard.writeText) failed();
      else navigator.clipboard.writeText(val).then(function () {
        if (!current()) return;
        copyBtn.textContent = t.copied;
        copyTimeout = setTimeout(function () { if (current()) copyBtn.textContent = t.copy; }, 1800);
      }, failed);
    } catch (e) { failed(); }
    window.trackTool && window.trackTool('cron_job_generator', 'copy');
  });

  document.addEventListener('keydown', function(e) {
    if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
    var root = document.querySelector('.cjg-wrap');
    if (!root || !root.contains(document.activeElement)) return;
    root.querySelectorAll('textarea, input[type="text"]').forEach(function(el) { el.value = ''; });
    resetCopy();
    copyBtn.disabled = true;
    clearExprError();
    document.getElementById('cjg-desc').textContent = '';
    document.getElementById('cjg-next-list').innerHTML = '';
    root.querySelectorAll('.cjg-field').forEach(updateFieldPreview);
    refreshResult();
  });

  // Timezone toggle
  document.querySelectorAll('.cjg-tz-btn').forEach(function (btn) {
    var tz = btn.getAttribute('data-tz');
    btn.classList.toggle('active', (tz === 'utc') === useUtc);
    btn.addEventListener('click', function () {
      useUtc = tz === 'utc';
      document.querySelectorAll('.cjg-tz-btn').forEach(function (b) {
        b.classList.toggle('active', b.getAttribute('data-tz') === (useUtc ? 'utc' : 'local'));
      });
      updateNextLabel();
      rebuildExpression();
      trackUpdate();
      if (window.ztPersist) {
        var _cronPrev = window.ztPersist.load('cron-job-generator') || {};
        _cronPrev.tz = useUtc ? 'utc' : 'local';
        window.ztPersist.save('cron-job-generator', _cronPrev);
      }
    });
  });

  // Initialize all field previews
  updateNextLabel();
  document.querySelectorAll('.cjg-field').forEach(function (field) {
    updateFieldPreview(field);
  });

  // Load persisted state or fall back to default preset (triggers rebuildExpression internally)
  var savedExpr = loadState();
  loadPreset(savedExpr || '0 9 * * 1-5');
})();
</script>

<style is:global>
