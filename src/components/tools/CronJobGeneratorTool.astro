    :root:not([data-theme="light"]) .cjg-expr-badge { border-color: #4b5e8a; }
    :root:not([data-theme="light"]) .cjg-chip { border-color: #3a4a6a; }
    :root:not([data-theme="light"]) .cjg-expr-input.cjg-expr-error { border-color: #f87171; }
    :root:not([data-theme="light"]) .cjg-error-msg { color: #f87171; }
