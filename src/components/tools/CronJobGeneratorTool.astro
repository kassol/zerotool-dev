    en: { exprErrorField: '{field}: "{value}" is not valid. Use numbers from {min} to {max}, *, -, / and commas.', presets: 'Presets:', fieldMinute: 'Minute', fieldHour: 'Hour', fieldDay: 'Day', fieldMonth: 'Month', fieldWeekday: 'Weekday', modeEvery: 'Every', modeStep: 'Every N', modeRange: 'Range', modeSpecific: 'Specific', stepLabel: 'Step:', rangeFrom: 'From', rangeTo: 'To', outputLabel: 'Cron Expression', copy: 'Copy', copied: 'Copied!', descLabel: 'Description', nextLabelUtc: 'Next 10 scheduled runs (UTC)', nextLabelLocal: 'Next 10 scheduled runs ({tz})', tzUtc: 'UTC', tzLocal: 'Local', pEveryMinute: 'Every minute', pEveryHour: 'Every hour', pDailyMidnight: 'Daily midnight', pWeekdays9am: 'Weekdays 9 AM', pWeeklySunday: 'Weekly Sunday', pMonthly1st: 'Monthly 1st', pEvery5min: 'Every 5 min', pYearlyJan1: 'Yearly Jan 1', exprErrorLen: 'Expected 5 fields: minute hour day month weekday', exprErrorVal: 'Invalid cron expression', copyFailed: 'Copy failed' },
