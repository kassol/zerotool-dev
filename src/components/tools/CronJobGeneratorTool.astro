          <label class="cjg-inline-label" for="cjg-day-to">{L.rangeTo}</label>
          <input type="number" id="cjg-day-to" class="cjg-num" data-role="to" min="1" max="31" value="15" />
          <span class="cjg-expr-badge cjg-preview">1-15</span>
