          <label class="cjg-inline-label" for="cjg-month-from">{L.rangeFrom}</label>
          <input type="number" id="cjg-month-from" class="cjg-num" data-role="from" min="1" max="12" value="1" />
          <label class="cjg-inline-label" for="cjg-month-to">{L.rangeTo}</label>
          <input type="number" id="cjg-month-to" class="cjg-num" data-role="to" min="1" max="12" value="6" />
