---
import Toggletip from '../Toggletip.astro';
// NanoIdGeneratorTool — Nano ID generator with custom alphabet and size (uses nanoid 3.x vendor)
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;

const labels = {
  en: {
    copyFailed: 'Copy failed. Try again.',
    generate: 'Generate',
    batchLabel: 'Batch Count',
    sizeLabel: 'Size',
    alphabetLabel: 'Alphabet',
    alphabetUrlSafe: 'URL-safe (default)',
    alphabetAlphanumeric: 'Alphanumeric',
    alphabetNumbers: 'Numbers only',
    alphabetHex: 'Lowercase hex',
    alphabetCustom: 'Custom…',
    customAlphabetLabel: 'Custom Alphabet',
    customAlphabetPlaceholder: 'Enter characters…',
    customAlphabetTooShort: 'Alphabet must have at least 2 characters',
    copy: 'Copy',
    copied: 'Copied!',
    copyAll: 'Copy All',
    copyAllDone: 'Copied!',
    clear: 'Clear',
    colId: 'Nano ID',
    colAlphabet: 'Alphabet',
    colSize: 'Size',
  },
  zh: {
    copyFailed: '复制失败，请重试。',
    generate: '生成',
    batchLabel: '批量数量',
    sizeLabel: '长度',
    alphabetLabel: '字符集',
    alphabetUrlSafe: 'URL 安全（默认）',
    alphabetAlphanumeric: '字母数字',
    alphabetNumbers: '纯数字',
    alphabetHex: '十六进制小写',
    alphabetCustom: '自定义…',
    customAlphabetLabel: '自定义字符集',
    customAlphabetPlaceholder: '输入字符…',
    customAlphabetTooShort: '字符集至少需要 2 个字符',
    copy: '复制',
    copied: '已复制！',
    copyAll: '复制全部',
    copyAllDone: '已复制！',
    clear: '清空',
    colId: 'Nano ID',
    colAlphabet: '字符集',
    colSize: '长度',
  },
  ja: {
    copyFailed: 'コピーに失敗しました。再試行してください。',
    generate: '生成',
    batchLabel: 'バッチ数',
    sizeLabel: 'サイズ',
    alphabetLabel: 'アルファベット',
    alphabetUrlSafe: 'URLセーフ（デフォルト）',
    alphabetAlphanumeric: '英数字',
    alphabetNumbers: '数字のみ',
    alphabetHex: '16進数小文字',
    alphabetCustom: 'カスタム…',
    customAlphabetLabel: 'カスタムアルファベット',
    customAlphabetPlaceholder: '文字を入力…',
    customAlphabetTooShort: 'アルファベットは2文字以上必要です',
    copy: 'コピー',
    copied: 'コピーしました！',
    copyAll: 'すべてコピー',
    copyAllDone: 'コピーしました！',
    clear: 'クリア',
    colId: 'Nano ID',
    colAlphabet: 'アルファベット',
    colSize: 'サイズ',
  },
  ko: {
    copyFailed: '복사하지 못했습니다. 다시 시도하세요.',
    generate: '생성',
    batchLabel: '일괄 수',
    sizeLabel: '크기',
    alphabetLabel: '알파벳',
    alphabetUrlSafe: 'URL 안전 (기본)',
    alphabetAlphanumeric: '영숫자',
    alphabetNumbers: '숫자만',
    alphabetHex: '소문자 16진수',
    alphabetCustom: '사용자 정의…',
    customAlphabetLabel: '사용자 정의 알파벳',
    customAlphabetPlaceholder: '문자 입력…',
    customAlphabetTooShort: '알파벳은 최소 2자 이상이어야 합니다',
    copy: '복사',
    copied: '복사됨!',
    copyAll: '모두 복사',
    copyAllDone: '복사됨!',
    clear: '지우기',
    colId: 'Nano ID',
    colAlphabet: '알파벳',
    colSize: '크기',
  },
};

// strings:start
const STRINGS = {
  "en": {
    "empty": "Generate Nano IDs to view and copy the list.",
    "tips": {
      "generate": "Generate replaces the list using the selected count, size and alphabet. Options take effect on the next Generate.",
      "count": "Generate keeps Batch Count between 1 and 100. An empty value uses 1.",
      "size": "Generate keeps Size between 1 and 128. Empty or 0 uses 21. With a custom alphabet, size counts Unicode code points.",
      "alphabet": "Choose URL-safe, Alphanumeric, Numbers only, Lowercase hex or Custom. Selecting a preset only changes the options.",
      "custom": "Custom splits the input by Unicode code point and removes duplicates. At least two distinct symbols are required; a joined emoji can contain several code points.",
      "copy": "Copy All copies the full list with one ID per line. Each row Copy copies that complete ID.",
      "clear": "Clear removes the generated list and error. Ctrl or Command + L also clears the custom alphabet text; count, size and preset stay selected."
    }
  },
  "zh": {
    "empty": "生成 Nano ID 后，这里显示可复制的列表。",
    "tips": {
      "generate": "生成按所选数量、长度和字符集替换列表，设置在下次点击生成时生效。",
      "count": "批量数量限制为 1–100，留空使用 1。",
      "size": "长度限制为 1–128，留空或 0 使用 21。自定义字符集按 Unicode 码点计数。",
      "alphabet": "选择 URL 安全、字母数字、纯数字、十六进制小写或自定义，切换预设只改变设置。",
      "custom": "自定义输入按 Unicode 码点拆分并去重，至少需要两个不同符号；组合表情可能包含多个码点。",
      "copy": "复制全部按每行一个 ID 复制完整列表，单行复制会复制该 ID 的全部内容。",
      "clear": "清空移除生成列表和错误。Ctrl 或 Command + L 还清除自定义字符集文本，保留数量、长度和所选预设。"
    }
  },
  "ja": {
    "empty": "Nano ID を生成すると、ここにコピー可能なリストを表示します。",
    "tips": {
      "generate": "生成は選択した数、サイズ、アルファベットでリストを更新します。設定は次の生成で反映されます。",
      "count": "バッチ数を 1〜100 に収めます。空欄は 1 として扱います。",
      "size": "サイズを 1〜128 に収めます。空欄と 0 は 21 になります。カスタムでは Unicode コードポイント数を使います。",
      "alphabet": "URLセーフ、英数字、数字のみ、16進数小文字、カスタムから選びます。選択だけでは生成しません。",
      "custom": "カスタムは Unicode コードポイントで分割し、重複を除きます。異なる記号が 2 つ以上必要です。合成絵文字は複数コードポイントの場合があります。",
      "copy": "すべてコピーは 1 行 1 ID で全リストをコピーします。各行のコピーはその ID の全内容をコピーします。",
      "clear": "クリアは生成リストとエラーを消します。Ctrl または Command + L はカスタムの文字も消し、数、サイズ、選択を保持します。"
    }
  },
  "ko": {
    "empty": "Nano ID를 생성하면 여기에 복사할 목록이 표시됩니다.",
    "tips": {
      "generate": "생성은 선택한 개수, 크기, 알파벳으로 목록을 갱신합니다. 설정은 다음 생성에 반영됩니다.",
      "count": "일괄 수를 1–100으로 제한합니다. 빈 값은 1을 사용합니다.",
      "size": "크기를 1–128로 제한합니다. 빈 값과 0은 21을 사용합니다. 사용자 정의 알파벳의 크기는 Unicode 코드 포인트 수입니다.",
      "alphabet": "URL 안전, 영숫자, 숫자만, 소문자 16진수, 사용자 정의 중 선택하세요. 선택만으로 생성하지 않습니다.",
      "custom": "사용자 정의 입력을 Unicode 코드 포인트로 나누고 중복을 제거합니다. 서로 다른 기호가 두 개 이상 필요합니다. 조합 이모지는 여러 코드 포인트일 수 있습니다.",
      "copy": "모두 복사는 전체 목록을 한 줄에 ID 하나씩 복사합니다. 각 행의 복사는 해당 ID 전체를 복사합니다.",
      "clear": "지우기는 생성 목록과 오류를 지웁니다. Ctrl 또는 Command + L은 사용자 정의 문자도 지우고 개수, 크기, 선택한 프리셋을 유지합니다."
    }
  }
};
// strings:end
const U = STRINGS[lang];

const L = labels[lang] ?? labels['en'];
---

<div
  class="nanoid-wrap"
  data-copy={L.copy}
  data-copy-failed={L.copyFailed}
  data-copied={L.copied}
  data-copy-all={L.copyAll}
  data-copy-all-done={L.copyAllDone}
  data-col-id={L.colId}
  data-col-alphabet={L.colAlphabet}
  data-col-size={L.colSize}
  data-too-short={L.customAlphabetTooShort}
>
  <div class="nanoid-main">
    <aside class="nanoid-rail zt-rail">
  {/* Controls */}
  <div class="nanoid-controls">
    <div class="nanoid-row">
      <div class="nanoid-label-row"><label class="nanoid-label" for="nanoid-count">{L.batchLabel}</label><Toggletip id="nanoid-tip-count" lang={lang} about={L.batchLabel}>{U.tips.count}</Toggletip></div>
      <input id="nanoid-count" class="nanoid-num-input" type="number" min="1" max="100" value="1" />
    </div>
    <div class="nanoid-row">
      <div class="nanoid-label-row"><label class="nanoid-label" for="nanoid-size">{L.sizeLabel}</label><Toggletip id="nanoid-tip-size" lang={lang} about={L.sizeLabel}>{U.tips.size}</Toggletip></div>
      <input id="nanoid-size" class="nanoid-num-input" type="number" min="1" max="128" value="21" />
    </div>
    <div class="nanoid-row">
      <div class="nanoid-label-row"><label class="nanoid-label" for="nanoid-alphabet">{L.alphabetLabel}</label><Toggletip id="nanoid-tip-alphabet" lang={lang} about={L.alphabetLabel}>{U.tips.alphabet}</Toggletip></div>
      <select id="nanoid-alphabet" class="nanoid-select">
        <option value="url-safe">{L.alphabetUrlSafe}</option>
        <option value="alphanumeric">{L.alphabetAlphanumeric}</option>
        <option value="numbers">{L.alphabetNumbers}</option>
        <option value="hex">{L.alphabetHex}</option>
        <option value="custom">{L.alphabetCustom}</option>
      </select>
    </div>
    <div id="nanoid-custom-row" class="nanoid-row" style="display:none;">
      <div class="nanoid-label-row"><label class="nanoid-label" for="nanoid-custom-alphabet">{L.customAlphabetLabel}</label><Toggletip id="nanoid-tip-custom" lang={lang} about={L.customAlphabetLabel}>{U.tips.custom}</Toggletip></div>
      <input
        id="nanoid-custom-alphabet"
        class="nanoid-text-input"
        type="text"
        placeholder={L.customAlphabetPlaceholder}
        spellcheck="false"
        autocomplete="off"
        maxlength="4096"
      />
    </div>
  </div>

  <div class="nanoid-btn-row">
    <button id="nanoid-generate" class="btn-primary" type="button">{L.generate}</button><Toggletip id="nanoid-tip-generate" lang={lang} about={L.generate}>{U.tips.generate}</Toggletip>
    <button id="nanoid-copy-all" class="btn-copy" type="button" disabled>{L.copyAll}</button><Toggletip id="nanoid-tip-copy" lang={lang} about={L.copyAll}>{U.tips.copy}</Toggletip>
    <button id="nanoid-clear" class="btn-ghost" type="button" disabled>{L.clear}</button><Toggletip id="nanoid-tip-clear" lang={lang} about={L.clear}>{U.tips.clear}</Toggletip>
  </div>
      <div class="nanoid-status" aria-live="polite"><div class="nanoid-err" id="nanoid-err" style="display:none;"></div></div>
    </aside>
    <div class="nanoid-result-pane">
      <p class="nanoid-empty">{U.empty}</p>
  <div id="nanoid-results" class="nanoid-results" style="display:none;">
    <table class="nanoid-table">
      <thead>
        <tr>
          <th class="nanoid-th-id">{L.colId}</th>
          <th class="nanoid-th-act"></th>
        </tr>
      </thead>
      <tbody id="nanoid-tbody"></tbody>
    </table>
  </div>
    </div>
  </div>

  <script src="/vendor/nanoid.min.js" is:inline></script>
  <script is:inline>
    (function () {
      var wrap = document.currentScript
        ? document.currentScript.closest('.nanoid-wrap')
        : document.querySelector('.nanoid-wrap');

      var COPY_LABEL     = wrap.dataset.copy;
      var COPIED_LABEL   = wrap.dataset.copied;
      var COPY_ALL_LABEL = wrap.dataset.copyAll;
      var COPY_ALL_DONE  = wrap.dataset.copyAllDone;
      var COPY_FAILED    = wrap.dataset.copyFailed;
      var TOO_SHORT      = wrap.dataset.tooShort;

      var countEl      = document.getElementById('nanoid-count');
      var sizeEl       = document.getElementById('nanoid-size');
      var alphabetEl   = document.getElementById('nanoid-alphabet');
      var customRow    = document.getElementById('nanoid-custom-row');
      var customAlphaEl = document.getElementById('nanoid-custom-alphabet');
      var genBtn       = document.getElementById('nanoid-generate');
      var copyAllBtn   = document.getElementById('nanoid-copy-all');
      var clearBtn     = document.getElementById('nanoid-clear');
      var resultsEl    = document.getElementById('nanoid-results');
      var tbodyEl      = document.getElementById('nanoid-tbody');
      var errEl        = document.getElementById('nanoid-err');

      var PRESETS = {
        'url-safe':     'useandom-26T198340PX75pxJACKVERYMINDBUSHWOLF_GQZbfghjklqvwyzrict',
        'alphanumeric': 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789',
        'numbers':      '0123456789',
        'hex':          '0123456789abcdef',
      };

      /* ── Alphabet selector ── */
      alphabetEl.addEventListener('change', function () {
        customRow.style.display = alphabetEl.value === 'custom' ? '' : 'none';
      });

      /* ── engine:start ── */
      // Custom alphabets are split into code points, so an emoji is one symbol (nanoid's
      // customAlphabet works per UTF-16 code unit and would emit half of one), and may have more
      // than 256 symbols. Each symbol takes a 32-bit random value; values at or above the largest
      // multiple of the alphabet size are discarded, so there is no modulo bias.
      function alphabetSymbols(text) {
        var seen = {};
        var out = [];
        Array.from(text).forEach(function (c) {
          if (!Object.prototype.hasOwnProperty.call(seen, c)) { seen[c] = true; out.push(c); }
        });
        return out;
      }

      function randomId(symbols, size, rand) {
        var n = symbols.length;
        var limit = Math.floor(4294967296 / n) * n;
        var out = '';
        var got = 0;
        while (got < size) {
          var buf = rand(Math.min(16384, Math.max(16, size - got + 8)));
          for (var i = 0; i < buf.length && got < size; i++) {
            if (buf[i] >= limit) continue;
            out += symbols[buf[i] % n];
            got++;
          }
        }
        return out;
      }
      /* ── engine:end ── */

      var copyStates = new Map();
      function resetCopy(btn, label) {
        var previous = copyStates.get(btn);
        if (previous) clearTimeout(previous.timer);
        var state = { timer: null };
        copyStates.set(btn, state);
        btn.textContent = label;
        return state;
      }
      function copyText(btn, text, label, copied, delay, action) {
        if (!text || btn.disabled) return;
        var state = resetCopy(btn, label);
        function current() { return copyStates.get(btn) === state; }
        function failed() { if (current()) btn.textContent = COPY_FAILED; }
        try {
          if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') { failed(); return; }
          Promise.resolve(navigator.clipboard.writeText(text)).then(function () {
            if (!current()) return;
            btn.textContent = copied;
            state.timer = setTimeout(function () { if (current()) btn.textContent = label; }, delay);
            if (action) window.trackTool && window.trackTool('nano-id-generator', action);
          }, failed);
        } catch (e) { failed(); }
      }
      function resetCopies() {
        copyStates.forEach(function (state, btn) {
          clearTimeout(state.timer);
          btn.textContent = btn === copyAllBtn ? COPY_ALL_LABEL : COPY_LABEL;
        });
        copyStates.clear();
        copyAllBtn.textContent = COPY_ALL_LABEL;
      }

      /* ── Generate ── */
      function getAlphabet() {
        var preset = alphabetEl.value;
        if (preset === 'custom') return alphabetSymbols(customAlphaEl.value);
        return PRESETS[preset] || PRESETS['url-safe'];
      }

      function cryptoRand(n) { return crypto.getRandomValues(new Uint32Array(n)); }

      function showError(msg) {
        errEl.textContent = msg;
        errEl.style.display = '';
      }

      function hideError() {
        errEl.style.display = 'none';
        errEl.textContent = '';
      }

      var generated = [];

      genBtn.addEventListener('click', function () {
        clearResults();
        hideError();
        var count = Math.max(1, Math.min(100, parseInt(countEl.value) || 1));
        var size  = Math.max(1, Math.min(128, parseInt(sizeEl.value) || 21));
        var alpha = getAlphabet();

        if (alpha.length < 2) {
          showError(TOO_SHORT);
          return;
        }

        var gen = Array.isArray(alpha)
          ? function () { return randomId(alpha, size, cryptoRand); }
          : alpha === PRESETS['url-safe']
            ? function () { return window.__nanoid.nanoid(size); }
            : window.__nanoid.customAlphabet(alpha, size);

        var newItems = [];
        for (var i = 0; i < count; i++) {
          newItems.push(gen());
        }
        generated = newItems;

        tbodyEl.innerHTML = '';
        generated.forEach(function (id) {
          tbodyEl.appendChild(buildRow(id));
        });
        resultsEl.style.display = '';
        copyAllBtn.disabled = false;
        clearBtn.disabled = false;
        window.trackTool && window.trackTool('nano-id-generator', 'generate');
      });

      /* ── Build row ── */
      function buildRow(id) {
        var tr = document.createElement('tr');
        tr.className = 'nanoid-tr';

        var tdId = document.createElement('td');
        tdId.className = 'nanoid-td nanoid-td-id';
        tdId.textContent = id;
        tr.appendChild(tdId);

        var tdAct = document.createElement('td');
        tdAct.className = 'nanoid-td nanoid-td-act';
        var copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'nanoid-copy-btn btn-ghost';
        copyBtn.textContent = COPY_LABEL;
        copyBtn.addEventListener('click', function () {
          copyText(copyBtn, id, COPY_LABEL, COPIED_LABEL, 1200, 'copy_single');
        });
        tdAct.appendChild(copyBtn);
        tr.appendChild(tdAct);

        return tr;
      }

      /* ── Copy All ── */
      copyAllBtn.addEventListener('click', function () {
        var text = generated.join('\n');
        copyText(copyAllBtn, text, COPY_ALL_LABEL, COPY_ALL_DONE, 1500, 'copy_all');
      });

      /* ── Clear ── */
      function clearResults() {
        resetCopies();
        generated = [];
        tbodyEl.innerHTML = '';
        resultsEl.style.display = 'none';
        copyAllBtn.disabled = true;
        clearBtn.disabled = true;
        hideError();
      }
      clearBtn.addEventListener('click', clearResults);
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'l') return;
        var tool = document.querySelector('.nanoid-wrap');
        if (!tool || !tool.contains(document.activeElement)) return;
        clearResults();
        customAlphaEl.value = '';
      });
    })();
  </script>
</div>

<style>
  .nanoid-wrap { display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; min-height: 0; }

  /* ── Controls ── */
  .nanoid-controls { display: flex; flex-direction: column; gap: 0.75rem; }

  .nanoid-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .nanoid-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
    min-width: 110px;
  }

  .nanoid-num-input {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    width: 80px;
    text-align: center;
  }

  .nanoid-num-input:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .nanoid-select {
    font-family: var(--font-sans, inherit);
    font-size: 0.85rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    min-width: 180px;
  }

  .nanoid-select:focus { outline: none; border-color: var(--color-primary); }

  .nanoid-text-input {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    width: 100%;
    max-width: 340px;
    letter-spacing: 0.03em;
  }

  .nanoid-text-input:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  /* ── Error ── */
  .nanoid-err {
    font-size: 0.82rem;
    color: #c0392b;
    padding: 0.4rem 0;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .nanoid-err { color: #fca5a5; }
  }
  [data-theme="dark"] .nanoid-err { color: #fca5a5; }

  /* ── Button row ── */
  .nanoid-btn-row { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }

  /* ── Results table ── */
  .nanoid-results {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .nanoid-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }

  .nanoid-table thead tr {
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .nanoid-table th {
    padding: 0.45rem 0.75rem;
    text-align: left;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
