---
import Toggletip from '../Toggletip.astro';
interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  en: {
    results: "Text statistics",
    emptyResult: "Enter text to see its counts and estimated reading and speaking time.",
    tips: {
      input: "Counts update as you type; no run button is needed. Ctrl+L (⌘+L on Mac) clears the input and all counts while focus is inside this tool.",
      characters: "Characters counts JavaScript UTF-16 code units, including spaces and line breaks. Most emoji use more than one code unit.",
      charsNoSpaces: "This counts UTF-16 code units after removing all JavaScript whitespace, including spaces, tabs and line breaks.",
      words: "Words are groups of non-whitespace characters separated by whitespace. A hyphenated term or URL is one word; a Chinese or Japanese paragraph without spaces is also one word.",
      sentences: "Sentences use the browser’s Intl.Segmenter with Unicode sentence boundaries. Punctuation and line breaks matter; abbreviations can produce counts that differ from a word processor.",
      paragraphs: "Paragraphs are nonempty blocks separated by blank lines. A single line break inside a block does not start another paragraph.",
      readingTime: "Reading time uses the word count divided by 200 words per minute. This is a rough English-text estimate. Nonzero times below one minute display < 1 min; longer times round up to whole minutes.",
      speakingTime: "Speaking time uses the word count divided by 130 words per minute. This is a rough English-text estimate. Times round up to minutes and split into hours at 60 minutes.",
    },
    inputText: 'Input Text', inputPlaceholder: 'Type or paste your text here...',
    characters: 'Characters', charsNoSpaces: 'Characters (no spaces)',
    words: 'Words', sentences: 'Sentences', paragraphs: 'Paragraphs',
    readingTime: 'Reading Time', speakingTime: 'Speaking Time'
  },
  zh: {
    results: "文本统计",
    emptyResult: "输入文本后，这里显示各项计数与预估阅读、朗读时间。",
    tips: {
      input: "输入时实时计数，无需运行按钮。焦点在工具内时，Ctrl+L（Mac 为 ⌘+L）清空输入与所有计数。",
      characters: "字符数按 JavaScript UTF-16 代码单元计算，包含空格和换行。多数表情使用多个代码单元。",
      charsNoSpaces: "移除 JavaScript 识别的全部空白字符后，再计算 UTF-16 代码单元，包括移除空格、制表符和换行。",
      words: "单词按空白分隔的非空白片段计数。带连字符的词或 URL 算一个；没有空格的中文或日文段落也算一个。",
      sentences: "句子使用浏览器 Intl.Segmenter 的 Unicode 句子边界。标点和换行影响结果，缩写可能使计数与文字处理软件不同。",
      paragraphs: "段落是由空行分隔的非空文本块。同一块内的单次换行不会另起一段。",
      readingTime: "阅读时间按单词数除以每分钟 200 词计算，是针对英语文本的粗略估计。非零且不足一分钟时显示 < 1 min，较长时间向上取整到分钟。",
      speakingTime: "朗读时间按单词数除以每分钟 130 词计算，是针对英语文本的粗略估计。时间向上取整到分钟，满 60 分钟后拆成小时和分钟。",
    },
    inputText: '输入文本', inputPlaceholder: '在此输入或粘贴文本...',
    characters: '字符数', charsNoSpaces: '字符数（不含空格）',
    words: '单词数', sentences: '句子数', paragraphs: '段落数',
    readingTime: '阅读时间', speakingTime: '朗读时间'
  },
  ja: {
    results: "テキストの統計",
    emptyResult: "テキストを入力すると、各カウントと読書・スピーキング時間の目安を表示します。",
    tips: {
      input: "入力すると即座にカウントします。実行ボタンは不要です。ツール内にフォーカスがあれば Ctrl+L（Mac は ⌘+L）で入力と全カウントを消去します。",
      characters: "文字数は JavaScript の UTF-16 コード単位で数え、空白や改行も含みます。多くの絵文字は複数のコード単位を使います。",
      charsNoSpaces: "空白、タブ、改行など JavaScript が認識する空白文字をすべて除き、残りの UTF-16 コード単位を数えます。",
      words: "空白で区切られた文字列を単語として数えます。ハイフン付きの語や URL は 1 語です。空白のない日本語や中国語の段落も 1 語になります。",
      sentences: "ブラウザーの Intl.Segmenter と Unicode の文区切り規則を使います。句読点と改行が結果に影響し、略語の扱いでワープロと異なる場合があります。",
      paragraphs: "空行で区切られた空でないテキストのまとまりを段落として数えます。まとまりの中の改行 1 つでは段落を増やしません。",
      readingTime: "単語数を毎分 200 語で割った英語向けの目安です。0 より大きく 1 分未満なら < 1 min と表示し、それ以上は分単位で切り上げます。",
      speakingTime: "単語数を毎分 130 語で割った英語向けの目安です。分単位で切り上げ、60 分以上は時間と分に分けて表示します。",
    },
    inputText: '入力テキスト', inputPlaceholder: 'テキストを入力または貼り付け...',
    characters: '文字数', charsNoSpaces: '文字数（空白除く）',
    words: '単語数', sentences: '文の数', paragraphs: '段落数',
    readingTime: '読書時間', speakingTime: 'スピーキング時間'
  },
  ko: {
    results: "텍스트 통계",
    emptyResult: "텍스트를 입력하면 개수와 예상 읽기·말하기 시간을 표시합니다.",
    tips: {
      input: "입력하는 즉시 계산하므로 실행 버튼이 필요하지 않습니다. 도구 안에 포커스가 있으면 Ctrl+L(Mac은 ⌘+L)로 입력과 모든 개수를 지웁니다.",
      characters: "문자 수는 JavaScript UTF-16 코드 단위로 계산하며 공백과 줄바꿈도 포함합니다. 대부분의 이모지는 여러 코드 단위를 사용합니다.",
      charsNoSpaces: "공백, 탭, 줄바꿈 등 JavaScript가 인식하는 모든 공백 문자를 제거하고 남은 UTF-16 코드 단위를 셉니다.",
      words: "공백으로 구분된 비공백 문자열을 단어로 셉니다. 하이픈이 있는 단어나 URL은 하나이며, 공백 없는 중국어·일본어 문단도 하나입니다.",
      sentences: "브라우저의 Intl.Segmenter와 Unicode 문장 경계를 사용합니다. 문장 부호와 줄바꿈이 결과에 영향을 주며, 약어 때문에 워드 프로세서와 개수가 다를 수 있습니다.",
      paragraphs: "빈 줄로 구분된 비어 있지 않은 텍스트 블록을 단락으로 셉니다. 블록 안의 한 번의 줄바꿈은 새 단락으로 세지 않습니다.",
      readingTime: "단어 수를 분당 200단어로 나눈 영어 텍스트 기준의 대략적인 시간입니다. 0보다 크고 1분 미만이면 < 1 min을 표시하며 더 긴 시간은 분 단위로 올림합니다.",
      speakingTime: "단어 수를 분당 130단어로 나눈 영어 텍스트 기준의 대략적인 시간입니다. 분 단위로 올림하고 60분 이상이면 시간과 분으로 나눠 표시합니다.",
    },
    inputText: '입력 텍스트', inputPlaceholder: '텍스트를 입력하거나 붙여넣으세요...',
    characters: '문자 수', charsNoSpaces: '문자 수 (공백 제외)',
    words: '단어 수', sentences: '문장 수', paragraphs: '단락 수',
    readingTime: '읽기 시간', speakingTime: '말하기 시간'
  }
};
const T = STRINGS[lang];
---

<div class="wc-wrap" data-empty="true">
  <div class="wc-row">
    <div class="wc-heading"><label for="wc-input">{T.inputText}</label><Toggletip id="wc-tip-input" lang={lang} about={T.inputText}>{T.tips.input}</Toggletip></div>
    <textarea id="wc-input" class="tool-textarea" placeholder={T.inputPlaceholder} spellcheck="false"></textarea>
  </div>
  <div class="wc-results" id="wc-results" tabindex="0" role="region" aria-label={T.results}>
    <p class="wc-empty">{T.emptyResult}</p>
    <div class="wc-stats" id="wc-stats" role="status" aria-live="polite" aria-atomic="true">
      <div class="wc-stat">
        <span class="wc-stat-value" id="wc-chars">0</span>
        <div class="wc-stat-label"><span>{T.characters}</span><Toggletip id="wc-tip-chars" lang={lang} about={T.characters}>{T.tips.characters}</Toggletip></div>
      </div>
      <div class="wc-stat">
        <span class="wc-stat-value" id="wc-chars-no-spaces">0</span>
        <div class="wc-stat-label"><span>{T.charsNoSpaces}</span><Toggletip id="wc-tip-chars-no-spaces" lang={lang} about={T.charsNoSpaces}>{T.tips.charsNoSpaces}</Toggletip></div>
      </div>
      <div class="wc-stat">
        <span class="wc-stat-value" id="wc-words">0</span>
        <div class="wc-stat-label"><span>{T.words}</span><Toggletip id="wc-tip-words" lang={lang} about={T.words}>{T.tips.words}</Toggletip></div>
      </div>
      <div class="wc-stat">
        <span class="wc-stat-value" id="wc-sentences">0</span>
        <div class="wc-stat-label"><span>{T.sentences}</span><Toggletip id="wc-tip-sentences" lang={lang} about={T.sentences}>{T.tips.sentences}</Toggletip></div>
      </div>
      <div class="wc-stat">
        <span class="wc-stat-value" id="wc-paragraphs">0</span>
        <div class="wc-stat-label"><span>{T.paragraphs}</span><Toggletip id="wc-tip-paragraphs" lang={lang} about={T.paragraphs}>{T.tips.paragraphs}</Toggletip></div>
      </div>
      <div class="wc-stat">
        <span class="wc-stat-value" id="wc-read-time">0 min</span>
        <div class="wc-stat-label"><span>{T.readingTime}</span><Toggletip id="wc-tip-read-time" lang={lang} about={T.readingTime}>{T.tips.readingTime}</Toggletip></div>
      </div>
      <div class="wc-stat">
        <span class="wc-stat-value" id="wc-speak-time">0 min</span>
        <div class="wc-stat-label"><span>{T.speakingTime}</span><Toggletip id="wc-tip-speak-time" lang={lang} about={T.speakingTime}>{T.tips.speakingTime}</Toggletip></div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var inputEl = document.getElementById('wc-input');

      var ids = {
        chars: document.getElementById('wc-chars'),
        charsNoSpaces: document.getElementById('wc-chars-no-spaces'),
        words: document.getElementById('wc-words'),
        sentences: document.getElementById('wc-sentences'),
        paragraphs: document.getElementById('wc-paragraphs'),
        readTime: document.getElementById('wc-read-time'),
        speakTime: document.getElementById('wc-speak-time'),
      };

      /* ── engine:start ── */
      function formatTime(minutes) {
        if (minutes <= 0) return '0 min';
        if (minutes < 1) return '< 1 min';
        // Round up to whole minutes before splitting, so 119.5 gives 2 hr 0 min, not 1 hr 60 min
        var total = Math.ceil(minutes);
        if (total < 60) return total + ' min';
        return Math.floor(total / 60) + ' hr ' + (total % 60) + ' min';
      }

      function countWords(text) {
        var trimmed = text.trim();
        if (!trimmed) return 0;
        return trimmed.split(/\s+/).length;
      }

      // Unicode sentence boundaries (UAX #29) as implemented by Intl.Segmenter: covers every
      // Sentence_Terminal character (. ! ? 。 ！ ？ ｡), closing quotes and brackets,
      // "3.14", "U.S.A." and a lowercase word after a period.
      var sentenceSegmenter = new Intl.Segmenter('und', { granularity: 'sentence' });

      function countSentences(text) {
        var n = 0;
        for (var seg of sentenceSegmenter.segment(text)) {
          if (/\S/.test(seg.segment)) n++;
        }
        return n;
      }

      function countParagraphs(text) {
        var trimmed = text.trim();
        if (!trimmed) return 0;
        return trimmed.split(/\n\s*\n/).filter(function (p) {
          return p.trim().length > 0;
        }).length || (trimmed.length > 0 ? 1 : 0);
      }

      function stats(text) {
        return {
          chars: text.length,
          charsNoSpaces: text.replace(/\s/g, '').length,
          words: countWords(text),
          sentences: countSentences(text),
          paragraphs: countParagraphs(text),
        };
      }
      /* ── engine:end ── */

      function update() {
        document.querySelector('.wc-wrap').dataset.empty = String(inputEl.value.length === 0);
        var s = stats(inputEl.value);
        var words = s.words;

        ids.chars.textContent = s.chars;
        ids.charsNoSpaces.textContent = s.charsNoSpaces;
        ids.words.textContent = words;
        ids.sentences.textContent = s.sentences;
        ids.paragraphs.textContent = s.paragraphs;
        ids.readTime.textContent = words === 0 ? '0 min' : formatTime(words / 200);
        ids.speakTime.textContent = words === 0 ? '0 min' : formatTime(words / 130);

        window.trackTool && window.trackTool('word_counter', 'count');
      }

      inputEl.addEventListener('input', update);
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 'l' || e.key === 'L') && document.querySelector('.wc-wrap').contains(document.activeElement)) {
          e.preventDefault();
          inputEl.focus();
          inputEl.value = '';
          update();
        }
      });
    })();
  </script>
</div>

<style>
  .wc-wrap { display: flex; flex-direction: column; min-width: 0; min-height: 0; gap: 0.75rem; }

  .wc-row { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0; min-height: 0; gap: 0.4rem; }
  .wc-heading { display: flex; align-items: center; flex: none; min-height: 2rem; gap: 0.4rem; }
  #wc-input { flex: 1 1 0; height: 0; min-height: 0; resize: none; overflow: auto; }
  .wc-results { flex: none; min-width: 0; max-height: 18rem; overflow: auto; }
  .wc-results:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .wc-empty { margin: 0; padding: 1rem; text-align: center; color: var(--color-text-muted); }
  .wc-wrap[data-empty="true"] .wc-stats, .wc-wrap[data-empty="false"] .wc-empty { display: none; }

  .wc-row label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-secondary); }

  .wc-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
  }

  .wc-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 1rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-secondary);
    transition: border-color var(--transition-fast);
  }

  .wc-stat:hover { border-color: var(--color-primary); }

  .wc-stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    font-family: var(--font-mono);
  }

  .wc-stat-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-align: center;
  }

  @media (max-width: 860px) {
    .wc-row { flex: none; }
    #wc-input { flex: none; height: 160px; }
    .wc-results { max-height: 24rem; }
    .wc-wrap[data-empty="true"] .wc-results { display: none; }
  }
  @media (max-width: 640px) {
    .wc-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
