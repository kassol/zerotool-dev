---
// No props needed — tool widget is language-independent
---

<div>
  <div class="url-wrap">
    <div class="url-mode">
      <label>
        <input type="radio" name="urlmode" value="encode" checked /> <span data-i18n="encode">Encode</span>
      </label>
      <label>
        <input type="radio" name="urlmode" value="decode" /> <span data-i18n="decode">Decode</span>
      </label>
      <label class="url-plus">
        <input type="checkbox" id="url-plus" /> <span data-i18n="plusSpace">Space as + (form data)</span>
      </label>
    </div>

    <div class="url-row">
      <label for="url-input" id="url-input-label">Plain Text / URL</label>
      <textarea
        id="url-input"
        placeholder="Enter text or URL to encode..."
        spellcheck="false"
      ></textarea>
    </div>

    <div class="url-actions">
      <button id="url-run" class="btn-primary" data-i18n="encode">Encode</button>
      <button id="url-swap" class="btn-secondary" data-i18n="swap">Swap</button>
      <button id="url-clear" class="btn-ghost" data-i18n="clear">Clear</button>
    </div>

    <div id="url-status" class="url-status" aria-live="polite"></div>

    <div class="url-row">
      <label for="url-output" id="url-output-label">
        <span id="url-output-label-text">Encoded URL</span>
        <button id="url-copy" class="btn-copy" type="button" data-i18n="copy">Copy</button>
      </label>
      <textarea
        id="url-output"
        placeholder="Result appears here..."
        readonly
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <script is:inline>
    (function () {
      var STRINGS = {
        en: { copyFail: 'Could not copy. Please select and copy the output manually.', plusSpace: 'Space as + (form data)', errEscape: 'Position {n}: "%" must be followed by two hexadecimal digits ("{s}").', errUtf8: 'Position {n}: {s} is not valid UTF-8. Text saved in GBK, Shift_JIS or EUC-KR cannot be decoded here.', errSurrogate: 'Position {n}: a lone surrogate (half of an emoji or other character) cannot be encoded.', encode: 'Encode', decode: 'Decode', swap: 'Swap', clear: 'Clear', copy: 'Copy', copied: 'Copied!', plainUrlLabel: 'Plain Text / URL', encodedUrlLabel: 'Encoded URL', decodedUrlLabel: 'Decoded URL', encodedOk: 'Encoded.', decodedOk: 'Decoded.', encodePh: 'Enter text or URL to encode...', decodePh: 'Enter percent-encoded URL to decode...', encodedOutPh: 'Percent-encoded output appears here...', decodedOutPh: 'Decoded text appears here...' },
        zh: { copyFail: '复制失败。请选中输出内容后手动复制。', plusSpace: '空格写成 +（表单数据）', errEscape: '第 {n} 个字符：「%」后面必须是两位十六进制数字（「{s}」）。', errUtf8: '第 {n} 个字符起：{s} 不是有效的 UTF-8。GBK 等其他编码的文本无法在这里解码。', errSurrogate: '第 {n} 个字符：孤立的代理项（emoji 等字符的一半）无法编码。', encode: '编码', decode: '解码', swap: '交换', clear: '清除', copy: '复制', copied: '已复制！', plainUrlLabel: '纯文本 / URL', encodedUrlLabel: '编码后的 URL', decodedUrlLabel: '解码后的 URL', encodedOk: '已编码。', decodedOk: '已解码。', encodePh: '输入要编码的文本或 URL...', decodePh: '输入要解码的百分比编码 URL...', encodedOutPh: '百分比编码输出在这里...', decodedOutPh: '解码文本在这里...' },
        ja: { copyFail: 'コピーできませんでした。出力を選択して手動でコピーしてください。', plusSpace: 'スペースを + に（フォームデータ）', errEscape: '{n} 文字目：「%」の後には 16 進数 2 桁が必要です（「{s}」）。', errUtf8: '{n} 文字目から：{s} は有効な UTF-8 ではありません。Shift_JIS などほかの文字コードのテキストはここではデコードできません。', errSurrogate: '{n} 文字目：単独のサロゲート（絵文字などの半分）はエンコードできません。', encode: 'エンコード', decode: 'デコード', swap: '入れ替え', clear: 'クリア', copy: 'コピー', copied: 'コピー済み！', plainUrlLabel: 'プレーンテキスト / URL', encodedUrlLabel: 'エンコードされた URL', decodedUrlLabel: 'デコードされた URL', encodedOk: 'エンコードしました。', decodedOk: 'デコードしました。', encodePh: 'エンコードするテキストまたは URL を入力...', decodePh: 'デコードするパーセントエンコード URL を入力...', encodedOutPh: 'パーセントエンコード出力がここに表示されます...', decodedOutPh: 'デコードされたテキストがここに表示されます...' },
        ko: { copyFail: '복사하지 못했습니다. 출력을 선택하여 직접 복사하세요.', plusSpace: '공백을 +로 (폼 데이터)', errEscape: '{n}번째 문자: "%" 뒤에는 16진수 두 자리가 와야 합니다("{s}").', errUtf8: '{n}번째 문자부터: {s}은(는) 올바른 UTF-8이 아닙니다. EUC-KR 등 다른 인코딩의 텍스트는 여기서 디코딩할 수 없습니다.', errSurrogate: '{n}번째 문자: 짝이 없는 서로게이트(이모지 등 문자의 절반)는 인코딩할 수 없습니다.', encode: '인코딩', decode: '디코딩', swap: '교체', clear: '지우기', copy: '복사', copied: '복사됨!', plainUrlLabel: '일반 텍스트 / URL', encodedUrlLabel: '인코딩된 URL', decodedUrlLabel: '디코딩된 URL', encodedOk: '인코딩 완료.', decodedOk: '디코딩 완료.', encodePh: '인코딩할 텍스트 또는 URL을 입력...', decodePh: '디코딩할 퍼센트 인코딩 URL을 입력...', encodedOutPh: '퍼센트 인코딩 출력이 여기에 표시됩니다...', decodedOutPh: '디코딩된 텍스트가 여기에 표시됩니다...' }
      };

      var pageLang = (document.documentElement.lang || 'en').slice(0, 2);
      var t = STRINGS[pageLang] || STRINGS.en;

      document.querySelectorAll('.url-wrap [data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n'); if (t[key]) el.textContent = t[key];
      });

      var inputEl = document.getElementById('url-input');
      var outputEl = document.getElementById('url-output');
      var statusEl = document.getElementById('url-status');
      var runBtn = document.getElementById('url-run');
      var copyBtn = document.getElementById('url-copy');
      var mode = 'encode';
      var lastValidUrlOutput = '';
      var plusEl = document.getElementById('url-plus');
      var copyRevision = 0;
      var copyTimer = null;
      var copyError = false;

      /* ── engine:start ── */
      // Position as a count of characters (code points), 1-based
      function charPos(s, i) { return Array.from(s.slice(0, i)).length + 1; }

      // RFC 3986 percent-encoding (encodeURIComponent), or with plus = true the
      // application/x-www-form-urlencoded serializer of URLSearchParams (space → +, ! ' ( ) ~ encoded)
      function encodeText(val, plus) {
        var bad = /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(^|[^\uD800-\uDBFF])[\uDC00-\uDFFF]/.exec(val);
        if (bad) {
          var at = bad.index + (bad[1] ? bad[1].length : 0);
          return { error: 'surrogate', pos: charPos(val, at) };
        }
        if (plus) return { out: new URLSearchParams([['', val]]).toString().slice(1) };
        return { out: encodeURIComponent(val) };
      }

      // Same result as decodeURIComponent; with plus = true, + is a space first (form data).
      // Errors give the position of the bad % or of the byte run that is not UTF-8.
      function decodeText(val, plus) {
        var s = plus ? val.replace(/\+/g, ' ') : val;
        var out = '';
        var i = 0;
        while (i < s.length) {
          if (s[i] !== '%') { out += s[i]; i++; continue; }
          var start = i;
          var bytes = [];
          while (i < s.length && s[i] === '%') {
            var hex = s.slice(i + 1, i + 3);
            if (!/^[0-9A-Fa-f]{2}$/.test(hex)) return { error: 'escape', pos: charPos(s, i), text: s.slice(i, i + 3) };
            bytes.push(parseInt(hex, 16));
            i += 3;
          }
          try {
            out += new TextDecoder('utf-8', { fatal: true, ignoreBOM: true }).decode(new Uint8Array(bytes));
          } catch (e) {
            var run = s.slice(start, i);
            return { error: 'utf8', pos: charPos(s, start), text: run.length > 36 ? run.slice(0, 36) + '…' : run };
          }
        }
        return { out: out };
      }
      /* ── engine:end ── */

      function convert(val) {
        invalidateCopy();
        var r = mode === 'encode' ? encodeText(val, plusEl.checked) : decodeText(val, plusEl.checked);
        if (r.error) {
          var key = r.error === 'escape' ? 'errEscape' : r.error === 'utf8' ? 'errUtf8' : 'errSurrogate';
          outputEl.value = '';
          setStatus(t[key].replace('{n}', String(r.pos)).replace('{s}', r.text || ''), true);
          return false;
        }
        outputEl.value = r.out;
        lastValidUrlOutput = r.out;
        setStatus(mode === 'encode' ? t.encodedOk : t.decodedOk, false);
        return true;
      }

      function setStatus(msg, isError) {
        copyError = false;
        statusEl.textContent = msg;
        statusEl.className = 'url-status ' + (isError ? 'error' : 'success');
      }

      function clearStatus() {
        copyError = false;
        statusEl.textContent = '';
        statusEl.className = 'url-status';
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        if (copyError) clearStatus();
      }

      function clearResult() {
        invalidateCopy();
        outputEl.value = '';
        lastValidUrlOutput = '';
        clearStatus();
      }

      function updateUI() {
        if (mode === 'encode') {
          document.getElementById('url-input-label').textContent = t.plainUrlLabel;
          document.getElementById('url-output-label-text').textContent = t.encodedUrlLabel;
          runBtn.textContent = t.encode;
          inputEl.placeholder = t.encodePh;
          outputEl.placeholder = t.encodedOutPh;
        } else {
          document.getElementById('url-input-label').textContent = t.encodedUrlLabel;
          document.getElementById('url-output-label-text').textContent = t.decodedUrlLabel;
          runBtn.textContent = t.decode;
          inputEl.placeholder = t.decodePh;
          outputEl.placeholder = t.decodedOutPh;
        }
      }

      // Sync mode from actual radio state (browser may restore form state)
      var checkedRadio = document.querySelector('input[name="urlmode"]:checked');
      if (checkedRadio) mode = checkedRadio.value;
      updateUI();

      // Restore saved input
      if (window.ztPersist) {
        var _urlSaved = window.ztPersist.load('url-encode')['input'];
        if (_urlSaved) inputEl.value = _urlSaved;
      }

      // Real-time encode/decode (debounced 300ms) + save at 500ms
      var _urlLiveTimer = null;
      var _urlSaveTimer = null;
      inputEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_urlLiveTimer);
        clearTimeout(_urlSaveTimer);
        _urlLiveTimer = setTimeout(function () {
          var val = inputEl.value;
          if (!val) { clearResult(); return; }
          convert(val);
        }, 300);
        _urlSaveTimer = setTimeout(function () {
          if (window.ztPersist) window.ztPersist.save('url-encode', { input: inputEl.value });
        }, 500);
      });

      document.querySelectorAll('input[name="urlmode"]').forEach(function (r) {
        r.addEventListener('change', function () {
          clearTimeout(_urlLiveTimer);
          mode = this.value;
          updateUI();
          clearResult();
        });
      });

      runBtn.addEventListener('click', function () {
        clearTimeout(_urlLiveTimer);
        var val = inputEl.value;
        if (!val) { clearResult(); return; }
        if (convert(val)) window.trackTool && window.trackTool('url_encode', mode);
      });

      plusEl.addEventListener('change', function () {
        clearTimeout(_urlLiveTimer);
        invalidateCopy();
        if (inputEl.value) convert(inputEl.value);
        else clearResult();
      });

      document.getElementById('url-swap').addEventListener('click', function () {
        clearTimeout(_urlLiveTimer);
        clearTimeout(_urlSaveTimer);
        invalidateCopy();
        var tmp = inputEl.value;
        inputEl.value = outputEl.value;
        outputEl.value = tmp;
        mode = mode === 'encode' ? 'decode' : 'encode';
        var nextRadio = document.querySelector('input[name="urlmode"][value="' + mode + '"]');
        if (nextRadio) nextRadio.checked = true;
        updateUI();
        clearStatus();
      });

      function clearTool() {
        clearTimeout(_urlLiveTimer);
        clearTimeout(_urlSaveTimer);
        inputEl.value = '';
        clearResult();
      }

      document.getElementById('url-clear').addEventListener('click', function () {
        clearTool();
        if (window.ztPersist) window.ztPersist.clear('url-encode');
      });
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var root = document.querySelector('.url-wrap');
        if (root && root.contains(document.activeElement)) clearTool();
      });

      copyBtn.addEventListener('click', function () {
        if (!outputEl.value) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        function done() {
          if (revision !== copyRevision) return;
          if (copyError) clearStatus();
          copyBtn.textContent = t.copied;
          copyTimer = setTimeout(function () { if (revision === copyRevision) copyBtn.textContent = t.copy; }, 1500);
        }
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(t.copyFail, true);
          copyError = true;
        }
        try { navigator.clipboard.writeText(outputEl.value).then(done, failed); }
        catch (e) { failed(); }
      });
    })();
  </script>
</div>

<style>
  .url-wrap { display: flex; flex-direction: column; gap: 0.75rem; }

  .url-mode { display: flex; gap: 1.5rem; font-size: 0.95rem; }
  .url-mode { flex-wrap: wrap; }
  .url-mode label { display: flex; align-items: center; gap: 0.4rem; cursor: pointer; }
  .url-mode .url-plus { margin-left: auto; font-size: 0.85rem; color: var(--color-text-secondary); }

  .url-row { display: flex; flex-direction: column; gap: 0.4rem; }

  .url-row label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .url-row textarea {
    width: 100%;
    min-height: 120px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    resize: vertical;
    background: var(--color-bg-secondary);
    color: var(--color-text);
  }

  .url-row textarea:focus { outline: none; border-color: var(--color-primary); background: var(--color-bg); }

  .url-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .url-status { font-size: 0.85rem; min-height: 1.2rem; }
  .url-status.success { color: #057a55; }
  .url-status.error { color: #c0392b; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .url-status.success { color: #34d399; }
    :root:not([data-theme="light"]) .url-status.error { color: #f87171; }
  }
  [data-theme="dark"] .url-status.success { color: #34d399; }
  [data-theme="dark"] .url-status.error { color: #f87171; }
</style>
