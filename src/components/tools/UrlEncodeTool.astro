---
import Toggletip from '../Toggletip.astro';

interface Props { lang?: 'en' | 'zh' | 'ja' | 'ko' }
const { lang = 'en' } = Astro.props;
const STRINGS = {
  "en": {
    "copyFail": "Could not copy. Please select and copy the output manually.",
    "plusSpace": "Space as + (form data)",
    "errEscape": "Position {n}: \"%\" must be followed by two hexadecimal digits (\"{s}\").",
    "errUtf8": "Position {n}: {s} is not valid UTF-8. Text saved in GBK, Shift_JIS or EUC-KR cannot be decoded here.",
    "errSurrogate": "Position {n}: a lone surrogate (half of an emoji or other character) cannot be encoded.",
    "encode": "Encode",
    "decode": "Decode",
    "swap": "Swap",
    "clear": "Clear",
    "copy": "Copy",
    "copied": "Copied!",
    "plainUrlLabel": "Plain Text / URL",
    "encodedUrlLabel": "Encoded URL",
    "decodedUrlLabel": "Decoded URL",
    "encodedOk": "Encoded.",
    "decodedOk": "Decoded.",
    "encodePh": "Enter text or URL to encode...",
    "decodePh": "Enter percent-encoded URL to decode...",
    "encodedOutPh": "Percent-encoded output appears here...",
    "decodedOutPh": "Decoded text appears here...",
    "modeLabel": "Direction",
    "tips": {
      "mode": "Encode percent-encodes one URL component with encodeURIComponent. It also encodes URL separators such as : / ? & = #. Decode reads UTF-8 percent-encoded bytes. Changing direction converts the current input immediately.",
      "input": "Results update 300 ms after typing stops. A lone UTF-16 surrogate cannot be encoded. Decoding reports the position of a malformed % escape or invalid UTF-8 bytes; GBK, Shift_JIS and EUC-KR are not supported. The last input is saved in this browser after 500 ms.",
      "plus": "With Space as + on, encoding uses URLSearchParams form encoding: a b+c becomes a+b%2Bc, and ! apostrophe ( ) ~ are encoded too. Decoding reads + as a space. With it off, spaces become %20 and a literal + stays + when decoded.",
      "swap": "Swap exchanges the two boxes and switches direction. It cancels a queued conversion and leaves the exchanged values in place. Editing the input or changing an option converts again.",
      "clear": "Clear empties both boxes and the status, cancels queued conversion and saving, and removes the saved input. Ctrl/⌘+L does the same while focus is in the tool. Direction and the form-data option stay selected.",
      "copy": "Copy copies the current output in full. If copying fails, select the output and copy it manually."
    }
  },
  "zh": {
    "copyFail": "复制失败。请选中输出内容后手动复制。",
    "plusSpace": "空格写成 +（表单数据）",
    "errEscape": "第 {n} 个字符：「%」后面必须是两位十六进制数字（「{s}」）。",
    "errUtf8": "第 {n} 个字符起：{s} 不是有效的 UTF-8。GBK 等其他编码的文本无法在这里解码。",
    "errSurrogate": "第 {n} 个字符：孤立的代理项（emoji 等字符的一半）无法编码。",
    "encode": "编码",
    "decode": "解码",
    "swap": "交换",
    "clear": "清除",
    "copy": "复制",
    "copied": "已复制！",
    "plainUrlLabel": "纯文本 / URL",
