      "swap": "「交换」对调两个框的内容并切换方向。它取消排队的转换，保留交换后的值。编辑输入或改变选项会再次转换。",
      "clear": "「清除」清空两个框和状态，取消排队的转换与保存，并删除已保存的输入。焦点在工具内时，Ctrl/⌘+L 执行相同操作。方向和表单数据选项保持不变。",
      "copy": "「复制」复制当前完整输出。复制失败时，请选中输出后手动复制。"
    }
  },
  "ja": {
    "copyFail": "コピーできませんでした。出力を選択して手動でコピーしてください。",
    "plusSpace": "スペースを + に（フォームデータ）",
    "errEscape": "{n} 文字目：「%」の後には 16 進数 2 桁が必要です（「{s}」）。",
    "errUtf8": "{n} 文字目から：{s} は有効な UTF-8 ではありません。Shift_JIS などほかの文字コードのテキストはここではデコードできません。",
    "errSurrogate": "{n} 文字目：単独のサロゲート（絵文字などの半分）はエンコードできません。",
    "encode": "エンコード",
    "decode": "デコード",
    "swap": "入れ替え",
    "clear": "クリア",
    "copy": "コピー",
    "copied": "コピー済み！",
    "plainUrlLabel": "プレーンテキスト / URL",
    "encodedUrlLabel": "エンコードされた URL",
    "decodedUrlLabel": "デコードされた URL",
    "encodedOk": "エンコードしました。",
    "decodedOk": "デコードしました。",
    "encodePh": "エンコードするテキストまたは URL を入力...",
    "decodePh": "デコードするパーセントエンコード URL を入力...",
    "encodedOutPh": "パーセントエンコード出力がここに表示されます...",
    "decodedOutPh": "デコードされたテキストがここに表示されます...",
    "modeLabel": "変換方向",
    "tips": {
      "mode": "エンコードは encodeURIComponent で URL の一部分を処理し、: / ? & = # などの区切り文字も変換します。デコードは UTF-8 のパーセントエンコードを読みます。方向を変えると現在の入力をすぐに変換します。",
      "input": "入力が止まってから300ミリ秒後に結果を更新します。単独の UTF-16 サロゲートはエンコードできません。デコードでは不正な % エスケープや UTF-8 バイトの位置を示します。GBK、Shift_JIS、EUC-KR には対応しません。最後の入力は500ミリ秒後にこのブラウザーへ保存します。",
      "plus": "「スペースを + に」を有効にすると URLSearchParams のフォーム形式を使います。a b+c は a+b%2Bc になり、! アポストロフィ ( ) ~ も変換します。デコードでは + を空白として読みます。無効時は空白を %20 にし、デコードした + はそのままです。",
      "swap": "「入れ替え」は両欄の内容と変換方向を入れ替えます。待機中の変換を中止し、入れ替えた値を保ちます。入力を編集するか設定を変えると再変換します。",
      "clear": "「クリア」は両欄とステータスを消し、待機中の変換と保存を中止し、保存済みの入力を削除します。ツール内にフォーカスがあれば Ctrl/⌘+L でも同じ操作ができます。変換方向とフォーム形式の設定は保ちます。",
      "copy": "「コピー」は現在の出力をすべてコピーします。失敗した場合は出力を選択して手動でコピーしてください。"
    }
  },
  "ko": {
    "copyFail": "복사하지 못했습니다. 출력을 선택하여 직접 복사하세요.",
    "plusSpace": "공백을 +로 (폼 데이터)",
    "errEscape": "{n}번째 문자: \"%\" 뒤에는 16진수 두 자리가 와야 합니다(\"{s}\").",
    "errUtf8": "{n}번째 문자부터: {s}은(는) 올바른 UTF-8이 아닙니다. EUC-KR 등 다른 인코딩의 텍스트는 여기서 디코딩할 수 없습니다.",
    "errSurrogate": "{n}번째 문자: 짝이 없는 서로게이트(이모지 등 문자의 절반)는 인코딩할 수 없습니다.",
    "encode": "인코딩",
    "decode": "디코딩",
    "swap": "교체",
    "clear": "지우기",
    "copy": "복사",
    "copied": "복사됨!",
    "plainUrlLabel": "일반 텍스트 / URL",
    "encodedUrlLabel": "인코딩된 URL",
    "decodedUrlLabel": "디코딩된 URL",
    "encodedOk": "인코딩 완료.",
    "decodedOk": "디코딩 완료.",
    "encodePh": "인코딩할 텍스트 또는 URL을 입력...",
    "decodePh": "디코딩할 퍼센트 인코딩 URL을 입력...",
    "encodedOutPh": "퍼센트 인코딩 출력이 여기에 표시됩니다...",
    "decodedOutPh": "디코딩된 텍스트가 여기에 표시됩니다...",
    "modeLabel": "변환 방향",
    "tips": {
      "mode": "인코딩은 encodeURIComponent로 URL 구성 요소 하나를 처리하며 : / ? & = # 같은 구분자도 인코딩합니다. 디코딩은 UTF-8 퍼센트 인코딩 바이트를 읽습니다. 방향을 바꾸면 현재 입력을 즉시 변환합니다.",
      "input": "입력을 멈춘 뒤 300밀리초 후 결과를 갱신합니다. 짝이 없는 UTF-16 서로게이트는 인코딩할 수 없습니다. 디코딩 중 잘못된 % 이스케이프나 UTF-8 바이트의 위치를 표시합니다. GBK, Shift_JIS, EUC-KR은 지원하지 않습니다. 마지막 입력은 500밀리초 후 이 브라우저에 저장합니다.",
      "plus": "공백을 +로 옵션을 켜면 URLSearchParams 폼 인코딩을 사용합니다. a b+c는 a+b%2Bc가 되며 ! 작은따옴표 ( ) ~도 인코딩합니다. 디코딩은 +를 공백으로 읽습니다. 옵션을 끄면 공백은 %20이 되고 디코딩에서 +는 그대로 유지됩니다.",
      "swap": "교체는 두 입력란의 내용과 방향을 바꿉니다. 대기 중인 변환을 취소하고 교체된 값을 유지합니다. 입력을 편집하거나 옵션을 바꾸면 다시 변환합니다.",
      "clear": "지우기는 두 입력란과 상태를 비우고 대기 중인 변환과 저장을 취소하며 저장된 입력을 삭제합니다. 도구에 초점이 있을 때 Ctrl/⌘+L로도 같은 작업을 합니다. 방향과 폼 데이터 옵션은 유지합니다.",
      "copy": "복사는 현재 출력 전체를 복사합니다. 실패하면 출력을 선택하여 직접 복사하세요."
    }
  }
} as const;
const T = STRINGS[lang];
const { tips: TIPS, ...CLIENT_T } = T;
---
<div class="url-wrap">
  <div class="url-controls">
    <div class="url-option">
      <div class="url-mode zt-segmented" role="radiogroup" aria-label={T.modeLabel}>
        <label><input type="radio" name="urlmode" value="encode" checked /><span>{T.encode}</span></label>
        <label><input type="radio" name="urlmode" value="decode" /><span>{T.decode}</span></label>
      </div>
      <Toggletip id="url-tip-mode" about={T.modeLabel} lang={lang} wide>{TIPS.mode}</Toggletip>
    </div>
    <div class="url-option url-plus-option">
      <label for="url-plus"><input type="checkbox" id="url-plus" /><span>{T.plusSpace}</span></label>
      <Toggletip id="url-tip-plus" about={T.plusSpace} lang={lang} wide>{TIPS.plus}</Toggletip>
    </div>
    <div class="url-actions">
      <div class="url-option"><button id="url-swap" class="btn-secondary" type="button">{T.swap}</button><Toggletip id="url-tip-swap" about={T.swap} lang={lang}>{TIPS.swap}</Toggletip></div>
      <div class="url-option"><button id="url-clear" class="btn-ghost" type="button">{T.clear}</button><Toggletip id="url-tip-clear" about={T.clear} lang={lang}>{TIPS.clear}</Toggletip></div>
    </div>
  </div>
  <div id="url-status" class="url-status" aria-live="polite"></div>
  <div class="url-panels zt-io">
    <div class="url-row zt-io-pane">
      <div class="url-head"><label for="url-input" id="url-input-label">{T.plainUrlLabel}</label><Toggletip id="url-tip-input" about={T.plainUrlLabel} lang={lang} wide>{TIPS.input}</Toggletip></div>
      <textarea id="url-input" class="tool-textarea url-box zt-io-fill" placeholder={T.encodePh} spellcheck="false"></textarea>
    </div>
    <div id="url-output-row" class="url-row url-output-row zt-io-pane" data-empty="true">
      <div class="url-head">
        <label for="url-output" id="url-output-label"><span id="url-output-label-text">{T.encodedUrlLabel}</span></label>
        <div class="url-option url-copy-controls"><button id="url-copy" class="btn-copy" type="button">{T.copy}</button><Toggletip id="url-tip-copy" about={T.copy} lang={lang}>{TIPS.copy}</Toggletip></div>
      </div>
      <textarea id="url-output" class="tool-textarea url-box zt-io-fill" placeholder={T.encodedOutPh} readonly spellcheck="false"></textarea>
    </div>
  </div>

  <script is:inline define:vars={{ t: CLIENT_T }}>
    (function () {
      var inputEl = document.getElementById('url-input');
      var outputEl = document.getElementById('url-output');
      var statusEl = document.getElementById('url-status');
      var copyBtn = document.getElementById('url-copy');
      var mode = 'encode';
      var lastValidUrlOutput = '';
      var plusEl = document.getElementById('url-plus');
      var copyRevision = 0;
      var copyTimer = null;
      var copyError = false;

      /* ── engine:start ── */
      // Position as a count of characters (code points), 1-based
      function charPos(s, i) { return Array.from(s.slice(0, i)).length + 1; }

      // RFC 3986 percent-encoding (encodeURIComponent), or with plus = true the
      // application/x-www-form-urlencoded serializer of URLSearchParams (space → +, ! ' ( ) ~ encoded)
      function encodeText(val, plus) {
        var bad = /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(^|[^\uD800-\uDBFF])[\uDC00-\uDFFF]/.exec(val);
        if (bad) {
          var at = bad.index + (bad[1] ? bad[1].length : 0);
          return { error: 'surrogate', pos: charPos(val, at) };
        }
        if (plus) return { out: new URLSearchParams([['', val]]).toString().slice(1) };
        return { out: encodeURIComponent(val) };
      }

      // Same result as decodeURIComponent; with plus = true, + is a space first (form data).
      // Errors give the position of the bad % or of the byte run that is not UTF-8.
      function decodeText(val, plus) {
        var s = plus ? val.replace(/\+/g, ' ') : val;
        var out = '';
        var i = 0;
        while (i < s.length) {
          if (s[i] !== '%') { out += s[i]; i++; continue; }
          var start = i;
          var bytes = [];
          while (i < s.length && s[i] === '%') {
            var hex = s.slice(i + 1, i + 3);
            if (!/^[0-9A-Fa-f]{2}$/.test(hex)) return { error: 'escape', pos: charPos(s, i), text: s.slice(i, i + 3) };
            bytes.push(parseInt(hex, 16));
            i += 3;
          }
          try {
            out += new TextDecoder('utf-8', { fatal: true, ignoreBOM: true }).decode(new Uint8Array(bytes));
          } catch (e) {
            var run = s.slice(start, i);
            return { error: 'utf8', pos: charPos(s, start), text: run.length > 36 ? run.slice(0, 36) + '…' : run };
          }
        }
        return { out: out };
      }
      /* ── engine:end ── */

      function convert(val) {
        invalidateCopy();
        var r = mode === 'encode' ? encodeText(val, plusEl.checked) : decodeText(val, plusEl.checked);
        if (r.error) {
          var key = r.error === 'escape' ? 'errEscape' : r.error === 'utf8' ? 'errUtf8' : 'errSurrogate';
          outputEl.value = '';
          setStatus(t[key].replace('{n}', String(r.pos)).replace('{s}', r.text || ''), true);
          return false;
        }
        outputEl.value = r.out;
        lastValidUrlOutput = r.out;
        setStatus(mode === 'encode' ? t.encodedOk : t.decodedOk, false);
        return true;
      }

      function updateOutputState() {
        document.getElementById('url-output-row').setAttribute('data-empty', String(!outputEl.value));
      }

      function setStatus(msg, isError) {
        updateOutputState();
        copyError = false;
        statusEl.textContent = msg;
        statusEl.className = 'url-status ' + (isError ? 'error' : 'success');
      }

      function clearStatus() {
        updateOutputState();
        copyError = false;
        statusEl.textContent = '';
        statusEl.className = 'url-status';
      }

      function invalidateCopy() {
        copyRevision++;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        if (copyError) clearStatus();
      }

      function clearResult() {
        invalidateCopy();
        outputEl.value = '';
        lastValidUrlOutput = '';
        clearStatus();
      }

      function updateUI() {
        if (mode === 'encode') {
          document.getElementById('url-input-label').textContent = t.plainUrlLabel;
          document.getElementById('url-output-label-text').textContent = t.encodedUrlLabel;
          inputEl.placeholder = t.encodePh;
          outputEl.placeholder = t.encodedOutPh;
        } else {
          document.getElementById('url-input-label').textContent = t.encodedUrlLabel;
          document.getElementById('url-output-label-text').textContent = t.decodedUrlLabel;
          inputEl.placeholder = t.decodePh;
          outputEl.placeholder = t.decodedOutPh;
        }
      }

      // Sync mode from actual radio state (browser may restore form state)
      var checkedRadio = document.querySelector('input[name="urlmode"]:checked');
      if (checkedRadio) mode = checkedRadio.value;
      updateUI();

      // Restore saved input
      if (window.ztPersist) {
        var _urlSaved = window.ztPersist.load('url-encode')['input'];
        if (_urlSaved) { inputEl.value = _urlSaved; convert(_urlSaved); }
      }

      // Real-time encode/decode (debounced 300ms) + save at 500ms
      var _urlLiveTimer = null;
      var _urlSaveTimer = null;
      inputEl.addEventListener('input', function () {
        invalidateCopy();
        clearTimeout(_urlLiveTimer);
        clearTimeout(_urlSaveTimer);
        _urlLiveTimer = setTimeout(function () {
          var val = inputEl.value;
          if (!val) { clearResult(); return; }
          convert(val);
        }, 300);
        _urlSaveTimer = setTimeout(function () {
          if (window.ztPersist) window.ztPersist.save('url-encode', { input: inputEl.value });
        }, 500);
      });

      document.querySelectorAll('input[name="urlmode"]').forEach(function (r) {
        r.addEventListener('change', function () {
          clearTimeout(_urlLiveTimer);
          mode = this.value;
          updateUI();
          if (inputEl.value) convert(inputEl.value);
          else clearResult();
        });
      });

      plusEl.addEventListener('change', function () {
        clearTimeout(_urlLiveTimer);
        invalidateCopy();
        if (inputEl.value) convert(inputEl.value);
        else clearResult();
      });

      document.getElementById('url-swap').addEventListener('click', function () {
        clearTimeout(_urlLiveTimer);
        clearTimeout(_urlSaveTimer);
        invalidateCopy();
        var tmp = inputEl.value;
        inputEl.value = outputEl.value;
        outputEl.value = tmp;
        mode = mode === 'encode' ? 'decode' : 'encode';
        var nextRadio = document.querySelector('input[name="urlmode"][value="' + mode + '"]');
        if (nextRadio) nextRadio.checked = true;
        updateUI();
        clearStatus();
      });

      function clearTool() {
        clearTimeout(_urlLiveTimer);
        clearTimeout(_urlSaveTimer);
        inputEl.value = '';
        clearResult();
      }

      document.getElementById('url-clear').addEventListener('click', function () {
        clearTool();
        if (window.ztPersist) window.ztPersist.clear('url-encode');
      });
      document.addEventListener('keydown', function (e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var root = document.querySelector('.url-wrap');
        if (root && root.contains(document.activeElement)) clearTool();
      });

      copyBtn.addEventListener('click', function () {
        if (!outputEl.value) return;
        var revision = ++copyRevision;
        clearTimeout(copyTimer);
        copyBtn.textContent = t.copy;
        function done() {
          if (revision !== copyRevision) return;
          if (copyError) clearStatus();
          copyBtn.textContent = t.copied;
          copyTimer = setTimeout(function () { if (revision === copyRevision) copyBtn.textContent = t.copy; }, 1500);
        }
        function failed() {
          if (revision !== copyRevision) return;
          setStatus(t.copyFail, true);
          copyError = true;
        }
        try { navigator.clipboard.writeText(outputEl.value).then(done, failed); }
        catch (e) { failed(); }
      });
    })();
  </script>
</div>

<style>
  .url-wrap { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; min-height: 0; }
  .url-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 0.9rem; flex: none; }
