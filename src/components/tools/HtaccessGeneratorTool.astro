---
import Toggletip from "../Toggletip.astro";
interface Props { lang?: string; }
const { lang = "en" } = Astro.props;
// strings:start
const STRINGS = {
        en: { forceHttps: 'Force HTTPS', forceHttpsDesc: 'Redirect all HTTP traffic to HTTPS', wwwRedirect: 'WWW Redirect', wwwRedirectDesc: 'Enforce consistent www / non-www domain', forceWww: 'Force www', removeWww: 'Remove www', dirIndex: 'Directory Index', dirIndexDesc: 'Set default files served for a directory', defaultFiles: 'Default files (space-separated)', browserCaching: 'Browser Caching', browserCachingDesc: 'Set cache expiry for common file types', security: 'Security', securityDesc: 'Disable directory listing and protect sensitive files', disableDirBrowse: 'Disable directory browsing', hideHtaccess: 'Hide .htaccess file', hideEnvFiles: 'Hide .env files', addXssHeaders: 'Add XSS & clickjacking headers', customRedirect: 'Custom Redirect', customRedirectDesc: 'Redirect a specific path to another URL', fromPath: 'From path', toUrl: 'To URL', type: 'Type', copy: 'Copy', copied: 'Copied!', copyFailed: 'Copy failed' },
        zh: { forceHttps: '强制 HTTPS', forceHttpsDesc: '将所有 HTTP 流量重定向到 HTTPS', wwwRedirect: 'WWW 重定向', wwwRedirectDesc: '强制统一 www / 非 www 域名', forceWww: '强制 www', removeWww: '去除 www', dirIndex: '目录索引', dirIndexDesc: '设置目录默认文件', defaultFiles: '默认文件（空格分隔）', browserCaching: '浏览器缓存', browserCachingDesc: '设置常见文件类型的缓存过期时间', security: '安全', securityDesc: '禁用目录列表并保护敏感文件', disableDirBrowse: '禁用目录浏览', hideHtaccess: '隐藏 .htaccess 文件', hideEnvFiles: '隐藏 .env 文件', addXssHeaders: '添加 XSS 和点击劫持防护头', customRedirect: '自定义重定向', customRedirectDesc: '将特定路径重定向到另一个 URL', fromPath: '来源路径', toUrl: '目标 URL', type: '类型', copy: '复制', copied: '已复制！', copyFailed: '复制失败' },
        ja: { forceHttps: 'HTTPS 強制', forceHttpsDesc: 'すべての HTTP トラフィックを HTTPS にリダイレクト', wwwRedirect: 'WWW リダイレクト', wwwRedirectDesc: 'www / 非 www ドメインを統一', forceWww: 'www を強制', removeWww: 'www を削除', dirIndex: 'ディレクトリインデックス', dirIndexDesc: 'ディレクトリのデフォルトファイルを設定', defaultFiles: 'デフォルトファイル（スペース区切り）', browserCaching: 'ブラウザキャッシュ', browserCachingDesc: '一般的なファイルタイプのキャッシュ有効期限を設定', security: 'セキュリティ', securityDesc: 'ディレクトリ一覧を無効化し機密ファイルを保護', disableDirBrowse: 'ディレクトリ閲覧を無効化', hideHtaccess: '.htaccess ファイルを隠す', hideEnvFiles: '.env ファイルを隠す', addXssHeaders: 'XSS・クリックジャッキング防止ヘッダーを追加', customRedirect: 'カスタムリダイレクト', customRedirectDesc: '特定のパスを別の URL にリダイレクト', fromPath: 'リダイレクト元', toUrl: 'リダイレクト先 URL', type: '種類', copy: 'コピー', copied: 'コピー済み！', copyFailed: 'コピーに失敗しました' },
        ko: { forceHttps: 'HTTPS 강제', forceHttpsDesc: '모든 HTTP 트래픽을 HTTPS로 리다이렉트', wwwRedirect: 'WWW 리다이렉트', wwwRedirectDesc: 'www / 비 www 도메인 통일', forceWww: 'www 강제', removeWww: 'www 제거', dirIndex: '디렉토리 인덱스', dirIndexDesc: '디렉토리 기본 파일 설정', defaultFiles: '기본 파일 (공백 구분)', browserCaching: '브라우저 캐싱', browserCachingDesc: '일반적인 파일 형식의 캐시 만료 설정', security: '보안', securityDesc: '디렉토리 목록 비활성화 및 민감한 파일 보호', disableDirBrowse: '디렉토리 탐색 비활성화', hideHtaccess: '.htaccess 파일 숨기기', hideEnvFiles: '.env 파일 숨기기', addXssHeaders: 'XSS 및 클릭재킹 방지 헤더 추가', customRedirect: '사용자 정의 리다이렉트', customRedirectDesc: '특정 경로를 다른 URL로 리다이렉트', fromPath: '원본 경로', toUrl: '대상 URL', type: '유형', copy: '복사', copied: '복사됨!', copyFailed: '복사 실패' }
      };
Object.assign(STRINGS.en, {"options": "Options", "images": "Images (jpg, png, gif, svg, webp)", "cacheCss": "CSS & JavaScript", "fonts": "Fonts (woff, woff2, ttf, eot)", "oneWeek": "1 week", "oneMonth": "1 month", "threeMonths": "3 months", "sixMonths": "6 months", "oneYear": "1 year", "permanent": "301 Permanent", "temporary": "302 Temporary", "empty": "Choose an option to preview the configuration.", "tips": {"https": "Adds a 301 redirect to HTTPS on the same host when the HTTPS variable is off.", "www": "Adds or removes www and always redirects to HTTPS.", "index": "Lists default files in order. An empty value, or one with spaces only, uses index.php index.html.", "cache": "Uses the selected expiry for each listed image, CSS, JavaScript or font MIME type.", "security": "Protects exact .htaccess and .env names. The header option sets X-XSS-Protection to 0.", "redirect": "Adds one Redirect directive when both paths contain text. The selected status is 301 or 302.", "copy": "Copies the complete current output. Copy is disabled when no configuration option produces a rule."}});
Object.assign(STRINGS.zh, {"options": "选项", "images": "图片（jpg、png、gif、svg、webp）", "cacheCss": "CSS 与 JavaScript", "fonts": "字体（woff、woff2、ttf、eot）", "oneWeek": "1 周", "oneMonth": "1 个月", "threeMonths": "3 个月", "sixMonths": "6 个月", "oneYear": "1 年", "permanent": "301 永久重定向", "temporary": "302 临时重定向", "empty": "选择配置选项后预览配置。", "tips": {"https": "HTTPS 变量为 off 时，添加跳转到同一主机 HTTPS 的 301 规则。", "www": "添加或去除 www，目标地址始终使用 HTTPS。", "index": "按顺序列出默认文件。为空或只有空格时使用 index.php index.html。", "cache": "为列出的图片、CSS、JavaScript 或字体 MIME 类型使用所选缓存时长。", "security": "保护文件名恰为 .htaccess 和 .env 的文件。响应头选项将 X-XSS-Protection 设为 0。", "redirect": "两个路径均有文本时添加一条 Redirect 指令，状态由 301 或 302 选项决定。", "copy": "复制当前完整输出。没有配置选项产生规则时禁用复制。"}});
Object.assign(STRINGS.ja, {"options": "オプション", "images": "画像（jpg、png、gif、svg、webp）", "cacheCss": "CSS と JavaScript", "fonts": "フォント（woff、woff2、ttf、eot）", "oneWeek": "1 週間", "oneMonth": "1 か月", "threeMonths": "3 か月", "sixMonths": "6 か月", "oneYear": "1 年", "permanent": "301 恒久リダイレクト", "temporary": "302 一時リダイレクト", "empty": "設定項目を選ぶと設定をプレビューできます。", "tips": {"https": "HTTPS 変数が off の場合、同じホストの HTTPS へ 301 リダイレクトする規則を追加します。", "www": "www を追加または削除し、常に HTTPS へリダイレクトします。", "index": "デフォルトファイルを順に指定します。空欄または空白だけの場合は index.php index.html を使用します。", "cache": "表示された画像、CSS、JavaScript、フォントの MIME 型に選択した有効期間を設定します。", "security": "名前が .htaccess と .env に一致するファイルを保護します。ヘッダー設定は X-XSS-Protection を 0 にします。", "redirect": "両方のパスにテキストがある場合、Redirect 指令を一つ追加します。状態は 301 または 302 です。", "copy": "現在の出力全体をコピーします。規則を生成する設定がない場合、コピーは無効になります。"}});
Object.assign(STRINGS.ko, {"options": "옵션", "images": "이미지 (jpg, png, gif, svg, webp)", "cacheCss": "CSS 및 JavaScript", "fonts": "글꼴 (woff, woff2, ttf, eot)", "oneWeek": "1주", "oneMonth": "1개월", "threeMonths": "3개월", "sixMonths": "6개월", "oneYear": "1년", "permanent": "301 영구 리디렉션", "temporary": "302 임시 리디렉션", "empty": "설정 항목을 선택하면 설정을 미리 볼 수 있습니다.", "tips": {"https": "HTTPS 변수가 off일 때 같은 호스트의 HTTPS로 301 리디렉션하는 규칙을 추가합니다.", "www": "www를 추가하거나 제거하며 항상 HTTPS로 리디렉션합니다.", "index": "기본 파일을 순서대로 지정합니다. 비어 있거나 공백뿐이면 index.php index.html을 사용합니다.", "cache": "나열된 이미지, CSS, JavaScript 또는 글꼴 MIME 유형에 선택한 만료 기간을 적용합니다.", "security": ".htaccess와 .env라는 정확한 파일 이름을 보호합니다. 헤더 옵션은 X-XSS-Protection을 0으로 설정합니다.", "redirect": "두 경로에 텍스트가 있으면 Redirect 지시문 하나를 추가합니다. 선택한 상태는 301 또는 302입니다.", "copy": "현재 출력 전체를 복사합니다. 규칙을 만드는 설정이 없으면 복사가 비활성화됩니다."}});
// strings:end
const L = STRINGS[lang] || STRINGS.en;
const CLIENT_T = { copy: L.copy, copied: L.copied, copyFailed: L.copyFailed };
---
<div class="hta-wrap" data-empty="false" data-strings={JSON.stringify(CLIENT_T)}>
  <div class="hta-main">
    <aside class="hta-controls zt-rail">
      <div class="hta-actions">
        <button id="hta-copy" class="btn-copy">{L.copy}</button>
        <Toggletip id="hta-tip-copy" lang={lang} about={L.copy} >{L.tips.copy}</Toggletip>
      </div>
      <div id="hta-status" class="hta-status" aria-live="polite"></div>
      <div class="hta-section">
        <div class="hta-toggle-row">
      <label class="hta-toggle">
        <input type="checkbox" id="hta-https" checked />
        <span class="hta-toggle-label">{L.forceHttps}</span>
        <span class="hta-toggle-desc">{L.forceHttpsDesc}</span>
      </label>
          <Toggletip id="hta-tip-https" lang={lang} about={L.forceHttps} >{L.tips.https}</Toggletip>
        </div>
      </div>
      <div class="hta-section">
        <div class="hta-toggle-row">
      <label class="hta-toggle">
        <input type="checkbox" id="hta-www-enable" />
        <span class="hta-toggle-label">{L.wwwRedirect}</span>
        <span class="hta-toggle-desc">{L.wwwRedirectDesc}</span>
      </label>
          <Toggletip id="hta-tip-www" lang={lang} about={L.wwwRedirect} >{L.tips.www}</Toggletip>
        </div>
      </div>
      <div class="hta-section">
        <div class="hta-toggle-row">
      <label class="hta-toggle">
        <input type="checkbox" id="hta-index-enable" checked />
        <span class="hta-toggle-label">{L.dirIndex}</span>
        <span class="hta-toggle-desc">{L.dirIndexDesc}</span>
      </label>
          <Toggletip id="hta-tip-index" lang={lang} about={L.dirIndex} >{L.tips.index}</Toggletip>
        </div>
      </div>
      <div class="hta-section">
        <div class="hta-toggle-row">
      <label class="hta-toggle">
        <input type="checkbox" id="hta-cache-enable" checked />
        <span class="hta-toggle-label">{L.browserCaching}</span>
        <span class="hta-toggle-desc">{L.browserCachingDesc}</span>
      </label>
          <Toggletip id="hta-tip-cache" lang={lang} about={L.browserCaching} >{L.tips.cache}</Toggletip>
        </div>
      </div>
      <div class="hta-section">
        <div class="hta-toggle-row">
      <label class="hta-toggle">
        <input type="checkbox" id="hta-security-enable" checked />
        <span class="hta-toggle-label">{L.security}</span>
        <span class="hta-toggle-desc">{L.securityDesc}</span>
      </label>
          <Toggletip id="hta-tip-security" lang={lang} about={L.security} >{L.tips.security}</Toggletip>
        </div>
      </div>
      <div class="hta-section">
        <div class="hta-toggle-row">
      <label class="hta-toggle">
        <input type="checkbox" id="hta-redir-enable" />
        <span class="hta-toggle-label">{L.customRedirect}</span>
        <span class="hta-toggle-desc">{L.customRedirectDesc}</span>
      </label>
          <Toggletip id="hta-tip-redirect" lang={lang} about={L.customRedirect} >{L.tips.redirect}</Toggletip>
        </div>
      </div>
      <details class="hta-options">
        <summary>{L.options}</summary>
      <div class="hta-sub" id="hta-www-sub">
        <label class="hta-radio">
          <input type="radio" name="hta-www" value="add" checked /> <span>{L.forceWww}</span>
        </label>
        <label class="hta-radio">
          <input type="radio" name="hta-www" value="remove" /> <span>{L.removeWww}</span>
        </label>
      </div>
      <div class="hta-sub" id="hta-index-sub">
        <label class="hta-field-label" for="hta-index-files">{L.defaultFiles}</label>
        <input
          type="text"
          id="hta-index-files"
          value="index.php index.html index.htm"
          spellcheck="false"
          class="hta-input"
        />
      </div>
      <div class="hta-sub hta-cache-grid" id="hta-cache-sub">
        <div class="hta-cache-row">
          <span class="hta-cache-type" id="hta-cache-images-label">{L.images}</span>
          <select id="hta-cache-images" class="hta-select" aria-labelledby="hta-cache-images-label">
            <option value="1 month">{L.oneMonth}</option>
            <option value="3 months">{L.threeMonths}</option>
            <option value="6 months">{L.sixMonths}</option>
            <option value="1 year" selected>{L.oneYear}</option>
          </select>
        </div>
        <div class="hta-cache-row">
          <span class="hta-cache-type" id="hta-cache-css-label">{L.cacheCss}</span>
          <select id="hta-cache-css" class="hta-select" aria-labelledby="hta-cache-css-label">
            <option value="1 week">{L.oneWeek}</option>
            <option value="1 month" selected>{L.oneMonth}</option>
            <option value="3 months">{L.threeMonths}</option>
            <option value="1 year">{L.oneYear}</option>
          </select>
        </div>
        <div class="hta-cache-row">
          <span class="hta-cache-type" id="hta-cache-fonts-label">{L.fonts}</span>
          <select id="hta-cache-fonts" class="hta-select" aria-labelledby="hta-cache-fonts-label">
            <option value="1 month">{L.oneMonth}</option>
            <option value="3 months">{L.threeMonths}</option>
            <option value="1 year" selected>{L.oneYear}</option>
          </select>
        </div>
      </div>
      <div class="hta-sub" id="hta-security-sub">
        <label class="hta-check">
          <input type="checkbox" id="hta-sec-dirlisting" checked /> <span>{L.disableDirBrowse}</span>
        </label>
        <label class="hta-check">
          <input type="checkbox" id="hta-sec-htaccess" checked /> <span>{L.hideHtaccess}</span>
        </label>
        <label class="hta-check">
          <input type="checkbox" id="hta-sec-envfiles" checked /> <span>{L.hideEnvFiles}</span>
        </label>
        <label class="hta-check">
          <input type="checkbox" id="hta-sec-xss" /> <span>{L.addXssHeaders}</span>
        </label>
      </div>
      <div class="hta-sub hta-redir-fields" id="hta-redir-sub">
        <div class="hta-redir-row">
          <div class="hta-field">
            <label class="hta-field-label" for="hta-redir-from">{L.fromPath}</label>
            <input type="text" id="hta-redir-from" placeholder="/old-page" class="hta-input" spellcheck="false" />
          </div>
          <div class="hta-field">
            <label class="hta-field-label" for="hta-redir-to">{L.toUrl}</label>
            <input type="text" id="hta-redir-to" placeholder="https://example.com/new-page" class="hta-input" spellcheck="false" />
          </div>
          <div class="hta-field hta-field-sm">
            <label class="hta-field-label" for="hta-redir-type">{L.type}</label>
            <select id="hta-redir-type" class="hta-select">
              <option value="301" selected>{L.permanent}</option>
              <option value="302">{L.temporary}</option>
            </select>
          </div>
        </div>
      </div>
      </details>
    </aside>
    <section class="hta-result">
      <div class="hta-output-wrap">
        <div class="hta-output-header"><span class="hta-output-title">.htaccess</span></div>
        <pre id="hta-output" class="hta-output"></pre>
        <p class="hta-empty">{L.empty}</p>
      </div>
    </section>
  </div>
</div>

  <script is:inline>
    (function () {
      var root = document.querySelector('.hta-wrap');
      var t = JSON.parse(root.dataset.strings);

      var els = {
        https:         document.getElementById('hta-https'),
        wwwEnable:     document.getElementById('hta-www-enable'),
        wwwSub:        document.getElementById('hta-www-sub'),
        indexEnable:   document.getElementById('hta-index-enable'),
        indexSub:      document.getElementById('hta-index-sub'),
        indexFiles:    document.getElementById('hta-index-files'),
        cacheEnable:   document.getElementById('hta-cache-enable'),
        cacheSub:      document.getElementById('hta-cache-sub'),
        cacheImages:   document.getElementById('hta-cache-images'),
        cacheCss:      document.getElementById('hta-cache-css'),
        cacheFonts:    document.getElementById('hta-cache-fonts'),
        secEnable:     document.getElementById('hta-security-enable'),
        secSub:        document.getElementById('hta-security-sub'),
        secDirListing: document.getElementById('hta-sec-dirlisting'),
        secHtaccess:   document.getElementById('hta-sec-htaccess'),
        secEnvFiles:   document.getElementById('hta-sec-envfiles'),
        secXss:        document.getElementById('hta-sec-xss'),
        redirEnable:   document.getElementById('hta-redir-enable'),
        redirSub:      document.getElementById('hta-redir-sub'),
        redirFrom:     document.getElementById('hta-redir-from'),
        redirTo:       document.getElementById('hta-redir-to'),
        redirType:     document.getElementById('hta-redir-type'),
        output:        document.getElementById('hta-output'),
        copyBtn:       document.getElementById('hta-copy'),
        status:        document.getElementById('hta-status'),
      };

      function wwwMode() {
        var radios = document.querySelectorAll('input[name="hta-www"]');
        for (var i = 0; i < radios.length; i++) {
          if (radios[i].checked) return radios[i].value;
        }
        return 'add';
      }

      /* ── engine:start ── */
      function lines() {
        var out = [];

        // HTTPS redirect
        if (els.https.checked) {
          out.push('# Force HTTPS');
          out.push('<IfModule mod_rewrite.c>');
          out.push('  RewriteEngine On');
          out.push('  RewriteCond %{HTTPS} off');
          out.push('  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]');
          out.push('</IfModule>');
        }

        // WWW
        if (els.wwwEnable.checked) {
          var mode = wwwMode();
          out.push('');
          if (mode === 'add') {
            out.push('# Force www');
            out.push('<IfModule mod_rewrite.c>');
            out.push('  RewriteEngine On');
            out.push('  RewriteCond %{HTTP_HOST} !^www\\. [NC]');
            out.push('  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]');
            out.push('</IfModule>');
          } else {
            out.push('# Remove www');
            out.push('<IfModule mod_rewrite.c>');
            out.push('  RewriteEngine On');
            out.push('  RewriteCond %{HTTP_HOST} ^www\\.(.+)$ [NC]');
            out.push('  RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]');
            out.push('</IfModule>');
          }
        }

        // Directory Index
        if (els.indexEnable.checked) {
          var files = (els.indexFiles.value || 'index.php index.html').trim();
          out.push('');
          out.push('# Directory Index');
          out.push('DirectoryIndex ' + files);
        }

        // Caching
        if (els.cacheEnable.checked) {
          out.push('');
          out.push('# Browser Caching');
          out.push('<IfModule mod_expires.c>');
          out.push('  ExpiresActive On');
          out.push('  ExpiresByType image/jpeg "access plus ' + els.cacheImages.value + '"');
          out.push('  ExpiresByType image/png "access plus ' + els.cacheImages.value + '"');
          out.push('  ExpiresByType image/gif "access plus ' + els.cacheImages.value + '"');
          out.push('  ExpiresByType image/svg+xml "access plus ' + els.cacheImages.value + '"');
          out.push('  ExpiresByType image/webp "access plus ' + els.cacheImages.value + '"');
          out.push('  ExpiresByType text/css "access plus ' + els.cacheCss.value + '"');
          out.push('  ExpiresByType application/javascript "access plus ' + els.cacheCss.value + '"');
          out.push('  ExpiresByType text/javascript "access plus ' + els.cacheCss.value + '"');
          out.push('  ExpiresByType font/woff "access plus ' + els.cacheFonts.value + '"');
          out.push('  ExpiresByType font/woff2 "access plus ' + els.cacheFonts.value + '"');
          // Apache 2.4 mime.types maps .ttf to font/ttf (RFC 8081); older configs use application/x-font-ttf.
          out.push('  ExpiresByType font/ttf "access plus ' + els.cacheFonts.value + '"');
          out.push('  ExpiresByType application/x-font-ttf "access plus ' + els.cacheFonts.value + '"');
          out.push('  ExpiresByType application/vnd.ms-fontobject "access plus ' + els.cacheFonts.value + '"');
          out.push('</IfModule>');
        }

        // Security
        if (els.secEnable.checked) {
          var hasAny = els.secDirListing.checked || els.secHtaccess.checked ||
                       els.secEnvFiles.checked || els.secXss.checked;
          if (hasAny) {
            out.push('');
            out.push('# Security');
          }
          if (els.secDirListing.checked) {
            out.push('Options -Indexes');
          }
          if (els.secHtaccess.checked) {
            out.push('<Files ".htaccess">');
            out.push('  Require all denied');
            out.push('</Files>');
          }
          if (els.secEnvFiles.checked) {
            out.push('<Files ".env">');
            out.push('  Require all denied');
            out.push('</Files>');
          }
          if (els.secXss.checked) {
            out.push('<IfModule mod_headers.c>');
            out.push('  Header always set X-Content-Type-Options "nosniff"');
            out.push('  Header always set X-Frame-Options "SAMEORIGIN"');
            // OWASP HTTP Headers Cheat Sheet and MDN: send 0; the old XSS auditor could be abused.
            out.push('  Header always set X-XSS-Protection "0"');
            out.push('  Header always set Referrer-Policy "strict-origin-when-cross-origin"');
            out.push('</IfModule>');
          }
        }

        // Custom Redirect
        if (els.redirEnable.checked) {
          var from = (els.redirFrom.value || '').trim();
          var to   = (els.redirTo.value   || '').trim();
          if (from && to) {
            out.push('');
            out.push('# Custom Redirect');
            out.push('Redirect ' + els.redirType.value + ' ' + from + ' ' + to);
          }
        }

        // Trim leading blank line
        if (out.length && out[0] === '') out.shift();

        return out.join('\n');
      }

      /* ── engine:end ── */

      var copyVersion = 0;
      var copyTimer;
      function resetCopy() {
        copyVersion++;
        clearTimeout(copyTimer);
        els.copyBtn.textContent = t.copy;
        els.copyBtn.classList.remove('copied');
      }

      // Runs the engine with checked copies of the free-text fields; the fields keep what was typed.
      // Default files: spaces only count as empty, so the engine writes its documented fallback
      // (index.php index.html) instead of a DirectoryIndex line without file names.
      function checkedLines() {
        var indexField = els.indexFiles;
        els.indexFiles = { value: indexField.value.trim() };
        try { return lines(); }
        finally { els.indexFiles = indexField; }
      }

      function generate() {
        root.dataset.empty = 'false';
        resetCopy();
        var result = checkedLines();
        els.output.textContent = result || '# (no options selected)';
        els.copyBtn.disabled = !result;
      }

      function onToggleChange(enableEl, subEl) {
        enableEl.addEventListener('change', function () {
          subEl.style.display = enableEl.checked ? '' : 'none';
          generate();
        });
        // init
        subEl.style.display = enableEl.checked ? '' : 'none';
      }

      onToggleChange(els.wwwEnable,   els.wwwSub);
      onToggleChange(els.indexEnable, els.indexSub);
      onToggleChange(els.cacheEnable, els.cacheSub);
      onToggleChange(els.secEnable,   els.secSub);
      onToggleChange(els.redirEnable, els.redirSub);

      // Attach all change listeners
      var inputs = document.querySelectorAll(
        '#hta-https, #hta-www-enable, input[name="hta-www"], ' +
        '#hta-index-enable, #hta-index-files, ' +
        '#hta-cache-enable, #hta-cache-images, #hta-cache-css, #hta-cache-fonts, ' +
        '#hta-security-enable, #hta-sec-dirlisting, #hta-sec-htaccess, #hta-sec-envfiles, #hta-sec-xss, ' +
        '#hta-redir-enable, #hta-redir-from, #hta-redir-to, #hta-redir-type'
      );
      inputs.forEach(function (el) {
        el.addEventListener('change', generate);
        if (el.tagName === 'INPUT' && (el.type === 'text' || el.type === 'url')) {
          el.addEventListener('input', generate);
        }
      });

      els.copyBtn.addEventListener('click', function () {
        var text = els.output.textContent;
        if (!text || els.copyBtn.disabled) return;
        resetCopy();
        var request = copyVersion;
        function current() { return request === copyVersion && els.output.textContent === text; }
        function failed() { if (current()) els.copyBtn.textContent = t.copyFailed; }
        try {
          if (!navigator.clipboard || !navigator.clipboard.writeText) failed();
          else navigator.clipboard.writeText(text).then(function () {
            if (!current()) return;
            els.copyBtn.textContent = t.copied;
            els.copyBtn.classList.add('copied');
            copyTimer = setTimeout(function () {
              if (!current()) return;
              els.copyBtn.textContent = t.copy;
              els.copyBtn.classList.remove('copied');
            }, 1500);
          }, failed);
        } catch (e) { failed(); }
        window.trackTool && window.trackTool('htaccess-generator', 'generate');
      });

      document.addEventListener('keydown', function(e) {
        if (!(e.ctrlKey || e.metaKey) || (e.key !== 'l' && e.key !== 'L')) return;
        var root = document.querySelector('.hta-wrap');
        if (!root || !root.contains(document.activeElement)) return;
        root.querySelectorAll('textarea, input[type="text"], input[type="url"]').forEach(function(el) { el.value = ''; });
        root.dataset.empty = 'true';
        els.output.textContent = '';
        els.status.textContent = '';
        resetCopy();
        els.copyBtn.disabled = true;
      });

      // Initial render
      generate();
    })();
  </script>

